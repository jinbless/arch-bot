        ctx:LotoNotApplied ctx:Machine ctx:MaterialHandling ctx:MeatGrinding
        ctx:MeatSlicer ctx:MedicationHandling ctx:NailChemical ctx:NailGun
        ctx:NearbyWorkerProximity ctx:NightSolo ctx:NightSoloWork ctx:NoiseExposure
        ctx:NoiseWork ctx:ObstructedViewCarrying ctx:OilDrain ctx:Other
        ctx:OutdoorPlayEquipment ctx:OvenOperation ctx:OverloadedContainer ctx:OverloadedHandcart
        ctx:PackageSorting ctx:Painting ctx:PaintingWoodwork ctx:Passage
        ctx:PathogenWork ctx:PesticideSpray ctx:PetBathing ctx:PlateMaking
        ctx:PoolArea ctx:PowerRackSafetyPin ctx:PowerTool ctx:PpeMgmt
        ctx:PressureVessel ctx:PressMachine ctx:PrintingPress ctx:RadiationWork
        ctx:RadiationXray ctx:Rail ctx:RecyclingSort ctx:RescueDelay
        ctx:RestroomChemical ctx:Robot ctx:RollerMachine ctx:RopeAccess
        ctx:RopeAnomalyUndetected ctx:SafetyDeviceBypass ctx:SafetyMgmt ctx:Sanding
        ctx:Sawing ctx:Scaffold ctx:ScaffoldWork ctx:ScrewGrinder
        ctx:SecurityInadequacy ctx:ServingFloor ctx:SharpsDisposal ctx:ShelfStocking
