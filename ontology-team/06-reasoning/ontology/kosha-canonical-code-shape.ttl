        ctx:FireDetectionFailure ctx:FireDetectorDisabled ctx:FireEvacuation ctx:FireExplosionWork
        ctx:FireExtinguisherDefective ctx:FirstAidFailure ctx:FishCutting ctx:FloorMachine
        ctx:FloralArrangement ctx:FlourHandling ctx:FoldingMachine ctx:FoodPrep
        ctx:ForkliftOperation ctx:FreezerWork ctx:FreeWeightZone ctx:FuelDispensing
