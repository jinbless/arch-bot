# Phase 5 가드레일 — 위험축 코드 IRI ∈ KOSHA-22 정본 어휘 SHACL shape.
# 자동 생성(SSOT 파생) — 수동 편집 금지. 재생성: scripts/gen_canonical_code_shape.py
# SSOT: shared/reference/canonical-code-vocabulary.json  (accident 181 / agent 84 / work_context 222 = 487)
# 검증: scripts/validate_canonical_codes.py --gate  (pyshacl)
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://cashtoss.info/ontology/shape#> .
@prefix haz: <https://cashtoss.info/ontology/risk/hazard#> .
@prefix agent: <https://cashtoss.info/ontology/risk/agent#> .
@prefix ctx: <https://cashtoss.info/ontology/risk/context#> .
@prefix sr: <https://cashtoss.info/ontology/sr#> .
@prefix guide: <https://cashtoss.info/ontology/guide#> .

# === accident_type (181) — sr:addressesAccidentType, guide:addressesHazard ===
shape:CanonicalAccidentTypeCode a sh:NodeShape ;
    sh:targetObjectsOf sr:addressesAccidentType ;
    sh:targetObjectsOf guide:addressesHazard ;
    sh:nodeKind sh:IRI ;
    sh:in (
        haz:AnimalBite haz:AnimalInjury haz:ArcBurn haz:BladeLaceration
        haz:Burn haz:BurnFromAccidentalCustomerContact haz:BurnFromFallingHotContents haz:CartTipover
        haz:CaughtIn haz:CaughtInConfinedSpace haz:ChairTipoverFall haz:ChemicalAbsorptionThroughSkin
        haz:ChemicalAccidentDueToImproperDetergentUse haz:ChemicalBurn haz:ChemicalBurnFromStrongAcid haz:ChemicalBurnFromStrongAcidToEye
        haz:ChemicalDetergentInhalation haz:ChemicalExplosion haz:ChemicalExposure haz:ChemicalEyeAndAirwayInjury
        haz:ChemicalIngestion haz:ChemicalInhalation haz:ChemicalIrritation haz:ChemicalReactionExplosion
        haz:ChemicalResidualInhalation haz:ChemicalSkinBurn haz:ChemicalSkinIrritation haz:ChemicalVaporExposure
        haz:ChemicalVaporInhalation haz:ChemicalVaporInhalationUnconsciousness haz:ChildChemicalExposure haz:ChildCut
        haz:ChildElectricShock haz:ChildSlipAndFall haz:ChildStabbing haz:ChloramineGasInhalationPoisoning
        haz:ChlorineGasInhalationPoisoning haz:ColdBurn haz:ColdExposure haz:Collapse
        haz:Collision haz:CompressionInjury haz:ConfinedSpaceAsphyxia haz:ContainerBreakageDuringCollection
        haz:Crush haz:CrushedByMachineOrObject haz:CrushedOverturned haz:Cut
        haz:CuttingBladeContactWhileOperating haz:CutDueToGloveFailure haz:CutLaceration haz:CytotoxicExposure
        haz:DetergentInhalationPoisoning haz:DriverEntanglement haz:Drowning haz:DustExplosion
        haz:ElectricalAccidentDueToPowerInstability haz:ElectricShock haz:ElectricShockDueToInsulationDamage haz:Entanglement
        haz:Ergonomic haz:ErgonomicStrain haz:Explosion haz:ExtremeColdBurn
        haz:EyeChemicalInjury haz:EyeForeignBody haz:EyeVisionDamage haz:Fall
        haz:FallingChemicalContainer haz:FallingFromWires haz:FallingObject haz:FallDueToStrongWind
        haz:FallFromAnkerFailure haz:FallFromHeight haz:FallFromKnotSlip haz:FallFromLadder
        haz:FallFromLossOfBalance haz:FallFromRopeFrictionBreakage haz:FallOnGround haz:FertilizerDustInhalation
        haz:FingerAmputation haz:FingerInjury haz:FireAndExplosion haz:FireFromOutletOverload
        haz:FireInjury haz:FireSpread haz:FoodContamination haz:FootCrushInjury
        haz:Fracture haz:FuelFire haz:FuelGasExplosion haz:FuelIgnitionExplosion
        haz:FuelLeakVaporInhalation haz:FuelTankFire haz:FuelVaporIgnitionByStaticDischarge haz:GasLeak
        haz:GasLeakAtNight haz:GasPoisoning haz:GlassLaceration haz:GondolaOverturnFall
        haz:GradualMinorFuelLeakage haz:HandcartOverturn haz:HandBurn haz:HeavyEquipmentOverturn
        haz:HeavyLifting haz:HighPressureGasLeakage haz:HighPressureRelease haz:HighTemperatureBurn
        haz:HotObjectMultipleFalling haz:HotSteamBurn haz:HydrocarbonVaporInhalationPoisoning haz:IgnitionOfFlammableGas
        haz:InfantSafetyAccident haz:Infection haz:InhalationOfChemicalDust haz:KnifeSlipCut
        haz:LabelMisidentificationAccident haz:Laceration haz:LandfillSlopeCollapse haz:LoadCollapse
        haz:LockerTipover haz:LossOfBalance haz:LossOfControlPolisher haz:MachineCollisionInjury
        haz:MachineFallingCollisionInjury haz:MedicalEmergency haz:MercuryPoisoning haz:NarcoticDermalAbsorption
        haz:OffSiteTraffic haz:OtherAccident haz:OvercrowdingEvacuationDelay haz:OverloadFire
        haz:OxygenDeficiency haz:PalmLaceration haz:PatientFall haz:PesticideAbsorptionThroughSkin
        haz:PesticideEyeContact haz:PesticideInhalationPoisoning haz:Posture haz:PressureVesselExplosion
        haz:PruningShearLaceration haz:PtoEntanglement haz:Puncture haz:Repetitive
        haz:ResidualCleanerExposure haz:ResidualHeatBurn haz:RopeBreakFall haz:RotatingHookEntanglement
        haz:RotatingPartInjury haz:ScaffoldCollapse haz:Scratch haz:SharpObjectInjury
        haz:ShelfCollapse haz:SkinBurn haz:SkinContact haz:SkinEyeContactChemicalInjury
        haz:SkinIrritation haz:SkinPenetration haz:Slip haz:SlipTrip
        haz:SoilCollapse haz:SpontaneousCombustionOfAbsorbentPad haz:SportsEventInjury haz:StairTrip
        haz:SteamBurn haz:StruckBy haz:StruckByIceFragment haz:StruckBySharpObject
        haz:TempExtremeContact haz:ThresherBladeCut haz:ToxicGasInhalation haz:ToxicGasPoisoning
        haz:TractorTipover haz:TrafficAccident haz:TrashBinFire haz:TrayContactInjury
        haz:TvFalling haz:Unclassified haz:UserFall haz:Violence
        haz:WorkplaceTraffic
    ) ;
    sh:message "사고유형(KOSHA-22) 코드 IRI는 KOSHA-22 정본 181개 안에만 허용됩니다 (legacy/UPPER/오타 fragment = 드리프트)." ;
    sh:severity sh:Violation .

# === hazardous_agent (84) — sr:addressesAgent, guide:guideAddressesAgent ===
shape:CanonicalHazardousAgentCode a sh:NodeShape ;
    sh:targetObjectsOf sr:addressesAgent ;
    sh:targetObjectsOf guide:guideAddressesAgent ;
    sh:nodeKind sh:IRI ;
    sh:in (
        agent:AcrylateResinSkinContact agent:AirlessResidualPressure agent:ArcFlash agent:AsbestosDust
        agent:Benzene agent:BiogasMethane agent:Biological agent:BloodbornePathogen
        agent:CapacitorResidualVoltage agent:Chemical agent:ChlorineAmmoniaReaction agent:ColdFloor
        agent:ConcentratedAlkali agent:ContaminatedFilterParticulateMold agent:Corrosion agent:CryogenicAgent
        agent:DefectiveHandle agent:DefectiveSterilePackaging agent:DegradedDeveloperSolution agent:DentalXrayRepeatedExposure
        agent:DentalXRay agent:DistributionBoard agent:Dust agent:EarphoneNoise
        agent:ElectricalOverload agent:Electricity agent:ElectricityWaterContact agent:ElevatorPitToxicGas
        agent:ExposedOutlet agent:ExtremeColdEnvironment agent:ExtremeColdSurface agent:FemaleExposureLimitExceeded
        agent:Fire agent:FormaldehydeSkinContact agent:FragranceVapor agent:FuelSaturatedAbsorbent
        agent:GasolineMicroLeakage agent:GasolineVapor agent:GlutaraldehydeVapor agent:HeatCold
        agent:HighHeat agent:HighPressureAirDust agent:HighTemperatureEnvironment agent:HighTemperatureSteam
        agent:HotEquipment agent:HotParts agent:HotSurface agent:HotTray
        agent:HotWater agent:InfectiousMedicalWaste agent:KaraokeNoise agent:KaraokeRoomNoise
        agent:LackOfVaccination agent:LeachateHazardousSubstance agent:LeadPaintDust agent:MercuryAmalgamVapor
        agent:MislabeledDetergent agent:MixedDetergentGas agent:Noise agent:Noise105Db
        agent:ProlongedColdExposure agent:ProlongedExposureToColdEnvironment agent:RadiantHeat agent:Radiation
        agent:RadiationExposure agent:RadiationExposureDuringPregnancy agent:RepeatedExtremeColdExposure agent:RepeatedRadiationExposure
        agent:ResidualCombustionGas agent:ResidualPesticide agent:ResidualRotation agent:RopeKink
        agent:ScatteredRadiation agent:SmallQuantityGasoline agent:SolventVapor agent:StaticElectricity
        agent:StrongAcidDescaler agent:TobaccoSmoke agent:Toxic agent:TwistedWire
        agent:UltravioletRadiation agent:UnknownAgent agent:UvLampResidualHeat agent:WaterBasedPaintMist
    ) ;
    sh:message "위험인자 코드 IRI는 KOSHA-22 정본 84개 안에만 허용됩니다 (legacy/UPPER/오타 fragment = 드리프트)." ;
    sh:severity sh:Violation .

