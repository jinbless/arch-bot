# Phase G Sprint G.2 — guide:GuideUsageProfile class + properties
# Generated: 2026-05-18
#
# Purpose: serving-validation-shapes-v3.ttl:20에 `sh:targetClass guide:GuideUsageProfile`
# SHACL shape이 있으나 OWL TBox class 자체가 미정의되어 있던 모순 해결.
# PG `guide_usage_profiles` table (16 cols)과 매핑되는 정형 ontology layer.
#
# Phase G.2: 본 patch + PG materialization → guide_domain_profile.py가 PG primary 사용
# Phase G 후: ontology (이 patch) = source of truth, PG materialized table = surface representation

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix guide: <https://cashtoss.info/ontology/guide#> .
@prefix industry: <https://cashtoss.info/ontology/industry#> .


### Class definition

guide:GuideUsageProfile a owl:Class ;
    rdfs:label "Guide Usage Profile"@en , "Guide 사용 프로필"@ko ;
    rdfs:comment "1:1 profile annotating a guide:KoshaGuide with usage context. 어떤 산업/작업/조건에서 해당 Guide가 활용 가능한지를 정형 표현. recommendation scoring 시 mismatch penalty 결정에 사용. PG materialized: guide_usage_profiles (16 cols)."@ko .


### Core identification properties

guide:profileOfGuide a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ;
    rdfs:label "profile of guide"@en ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range guide:KoshaGuide ;
    rdfs:comment "1:1 relation. 한 Guide는 정확히 하나의 profile을 갖고, 각 profile은 정확히 하나의 Guide를 설명한다."@ko .


### Classification properties

guide:profileLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "profile level"@en , "프로필 수준"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "값 enum: 'general' (범용 적용) | 'domain_specific' (특정 산업) | 'exclusive' (단일 매우 좁은 도메인). PG 기본값 'general'."@ko .

guide:domainFamily a owl:DatatypeProperty ;
    rdfs:label "domain family"@en , "도메인 패밀리"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Guide의 main domain identifier (예: 'work_environment_measurement_analysis_COPPER'). guide_recommendation 시 도메인 매칭 키."@ko .

guide:procedureRole a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "procedure role"@en , "절차 역할"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "값 enum: 'field_control' (현장 통제) | 'measurement_analysis' (측정·분석) | 'health_screening' (건강 검진). PG 기본값 'field_control'."@ko .


### Usage context properties (JSONB arrays in PG)

guide:intendedWorkplaces a owl:DatatypeProperty ;
    rdfs:label "intended workplaces"@en , "의도된 작업장"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "JSON array of workplace labels (e.g., ['laboratory', 'construction_site']). PG: JSONB column."@ko .

guide:intendedTasks a owl:DatatypeProperty ;
    rdfs:label "intended tasks"@en , "의도된 작업"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "JSON array of task labels. PG: JSONB column."@ko .

guide:observableRequiredCues a owl:DatatypeProperty ;
    rdfs:label "observable required cues"@en , "관찰 필수 시각단서"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Vision LLM이 사진에서 발견해야 하는 시각단서 array. 누락 시 photo_unmatchable. PG: JSONB column."@ko .

guide:negativeBoundaries a owl:DatatypeProperty ;
    rdfs:label "negative boundaries"@en , "부정 경계"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Guide가 명시적으로 배제하는 context labels array. 매칭 시 hard penalty. PG: JSONB column."@ko .


### Photo matching policy properties

guide:photoMatchability a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "photo matchability"@en , "사진 매칭 가능성"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "값 enum: 'photo_actionable' (즉시 매칭) | 'photo_conditional_followup' (조건부 후속) | 'photo_unmatchable' (사진 매칭 불가)."@ko .

guide:topProcedurePolicy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "top procedure policy"@en ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "값 enum: 'allow_photo_top' (사진 top 결과 허용) | 'suppress_photo_top' (사진 top 결과 억제)."@ko .

guide:followupPolicy a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "followup policy"@en ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "값 enum: 'none' | 'explicit_context_only'."@ko .


### Metadata properties

guide:usageSummary a owl:DatatypeProperty ;
    rdfs:label "usage summary"@en , "사용 요약"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "Guide의 사용 맥락 요약 문장 (1-2줄). PG NOT NULL."@ko .

guide:reviewStatus a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "review status"@en , "검토 상태"@ko ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "값 enum: 'candidate' | 'asserted' | 'rejected' | 'needs_review'. asymmetric trust 시그널."@ko .

guide:baselineId a owl:DatatypeProperty ;
    rdfs:label "baseline id"@en ;
    rdfs:domain guide:GuideUsageProfile ;
    rdfs:range xsd:string ;
    rdfs:comment "사용된 baseline snapshot identifier (예: 'ci_broad_sr_guard4'). 재현성 추적."@ko .


### Cardinality restrictions (SHACL → OWL)

guide:GuideUsageProfile rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty guide:profileOfGuide ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ;
      rdfs:comment "각 profile은 정확히 1개의 Guide만 설명"@ko ] ,
    [ a owl:Restriction ;
      owl:onProperty guide:profileLevel ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty guide:procedureRole ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ;
      owl:onProperty guide:photoMatchability ;
      owl:cardinality "1"^^xsd:nonNegativeInteger ] .


### Inverse: guide:KoshaGuide → guide:GuideUsageProfile

guide:hasProfile a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ;
    owl:inverseOf guide:profileOfGuide ;
    rdfs:label "has profile"@en ;
    rdfs:domain guide:KoshaGuide ;
    rdfs:range guide:GuideUsageProfile ;
    rdfs:comment "guide:KoshaGuide → guide:GuideUsageProfile 역방향 navigation."@ko .


### Note

# serving-validation-shapes-v3.ttl의 GuideUsageProfileShape (line 20)이 이제 정합한
# OWL class target을 가짐. SHACL validation은 sh:property cardinality (sh:minCount/maxCount)를
# 통해 위 OWL cardinality restriction과 일치 검증 가능.
#
# Future: BFO 매핑 결정 (현재 owl:Thing의 sub). 후보:
# - bfo:Role (Guide가 특정 산업/작업 맥락에서 갖는 역할)
# - bfo:Disposition (특정 조건에서 적용되는 성향)
# 학계 정형성 요구 시 결정. 현재 PG 적재에는 영향 없음.
