# production ABox enrichment — 8 photo eval 결과 → ontology ABox instance.
#
# export_8photo_to_abox.py 산출. 실제 사진 분석 (hazard_direct_8photo_eval.json) →
# VisualObservation/RiskFeature chain. R-14/R-15 (bridge) SHACL fire 입증용.
#
# 검증 전용 — production fuseki sources 등록은 운영 정책에 따라 (현재 demo/sample).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix risk: <https://cashtoss.info/ontology/risk#> .
@prefix haz: <https://cashtoss.info/ontology/risk/hazard#> .
@prefix app: <https://cashtoss.info/ontology/app#> .
@prefix prod: <https://cashtoss.info/ontology/production#> .


### Photo 1: 고소대작업(httpswww.youtube.comwatchv=Up-7KNjVJQM).png
prod:VO_01_httpswww_youtube_comwatc a app:VisualObservation ;
    rdfs:label "photo 1: httpswww_youtube_comwatc"@ko .

prod:RF_FALL a risk:RiskFeature ;
    rdfs:label "FALL (accident_type)"@en ;
    risk:correspondsToHazard haz:Fall ;
    haz:hasHazard haz:Fall .

prod:VO_01_httpswww_youtube_comwatc risk:hasRiskFeature prod:RF_FALL .

### Photo 2: 안전대길이(httpswww.youtube.comwatchv=v37Id6TdkC4&list=
prod:VO_02_httpswww_youtube_comwatc a app:VisualObservation ;
    rdfs:label "photo 2: httpswww_youtube_comwatc"@ko .

prod:VO_02_httpswww_youtube_comwatc risk:hasRiskFeature prod:RF_FALL .
prod:RF_FALLING_OBJECT a risk:RiskFeature ;
    rdfs:label "FALLING_OBJECT (accident_type)"@en ;
    risk:correspondsToHazard haz:StruckBy ;
    haz:hasHazard haz:StruckBy .

prod:VO_02_httpswww_youtube_comwatc risk:hasRiskFeature prod:RF_FALLING_OBJECT .
prod:RF_FALL_ON_GROUND a risk:RiskFeature ;
    rdfs:label "FALL_ON_GROUND (accident_type)"@en ;
    risk:correspondsToHazard haz:Fall ;
    haz:hasHazard haz:Fall .

prod:VO_02_httpswww_youtube_comwatc risk:hasRiskFeature prod:RF_FALL_ON_GROUND .

