[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <https://cashtoss.info/ontology/law#modifies> ;
            owl:someValuesFrom <https://cashtoss.info/ontology/law#NormStatement> ] ;
    owl:intersectionOf ( <https://cashtoss.info/ontology/law#NormStatement> [ a owl:Restriction ;
                owl:hasValue <https://cashtoss.info/ontology#Exemption> ;
                owl:onProperty <https://cashtoss.info/ontology/law#hasModality> ] ) .

