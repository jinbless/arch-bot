<https://cashtoss.info/ontology/law#hasAction> a owl:DatatypeProperty ;
    rdfs:label "행위"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/law#hasLawType> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "법령 유형"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/law#Article> ;
    rdfs:range <https://cashtoss.info/ontology/law#LawType> .

<https://cashtoss.info/ontology/law#hasNormStatement> a owl:ObjectProperty ;
    rdfs:label "규범 진술문 보유"@ko ;
    owl:inverseOf <https://cashtoss.info/ontology/law#hasSourceArticle> .

<https://cashtoss.info/ontology/law#hasObject> a owl:DatatypeProperty ;
    rdfs:label "대상"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/law#hasParentStructure> a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "상위 구조"@ko .

<https://cashtoss.info/ontology/law#hasSubjectRole> a owl:ObjectProperty ;
    rdfs:label "의무 주체"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/law#NormStatement> ;
    rdfs:range <https://cashtoss.info/ontology#SubjectRole> .

<https://cashtoss.info/ontology/law#isDeleted> a owl:DatatypeProperty ;
    rdfs:label "삭제 여부"@ko ;
    rdfs:range xsd:boolean .

<https://cashtoss.info/ontology/law#modifiedBy> a owl:ObjectProperty ;
    rdfs:label "수정됨"@ko ;
    owl:inverseOf <https://cashtoss.info/ontology/law#modifies> .

<https://cashtoss.info/ontology/law#paragraphCount> a owl:DatatypeProperty ;
    rdfs:label "항 수"@ko ;
    rdfs:range xsd:integer .

<https://cashtoss.info/ontology/law#paragraphRef> a owl:DatatypeProperty ;
    rdfs:label "항 참조"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/law#structureLabel> a owl:DatatypeProperty ;
    rdfs:label "구조 라벨"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/penalty#AdministrativeFine> a owl:Class ;
    rdfs:label "과태료"@ko ;
    rdfs:subClassOf <http://www.estrellaproject.org/lkif-core/lkif-core#Prohibition>,
        <https://cashtoss.info/ontology/penalty#SanctionType> .

<https://cashtoss.info/ontology/penalty#CriminalSanction> a owl:Class ;
    rdfs:label "형사벌"@ko ;
    rdfs:subClassOf <http://www.estrellaproject.org/lkif-core/lkif-core#Prohibition>,
        <https://cashtoss.info/ontology/penalty#SanctionType> .

<https://cashtoss.info/ontology/penalty#delegatedFrom> a owl:ObjectProperty ;
    rdfs:label "위임 근거"@ko .

<https://cashtoss.info/ontology/penalty#hasCondition> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "벌칙 선택 조건"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/penalty#PenaltyRule> ;
    rdfs:range <https://cashtoss.info/ontology/penalty#PenaltyCondition> .

<https://cashtoss.info/ontology/penalty#hasPenalty> a owl:DatatypeProperty ;
    rdfs:label "벌칙 여부"@ko ;
    rdfs:range xsd:boolean .

<https://cashtoss.info/ontology/penalty#penaltyArticle> a owl:ObjectProperty ;
    rdfs:label "실제 벌칙 조문"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/penalty#PenaltyRule> ;
    rdfs:range <https://cashtoss.info/ontology/law#Article> .

<https://cashtoss.info/ontology/penalty#penaltyBasisText> a owl:DatatypeProperty ;
    rdfs:label "벌칙 근거 문구"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/penalty#PenaltyRule> ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/penalty#penaltyDescription> a owl:DatatypeProperty ;
    rdfs:label "벌칙 내용"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/penalty#requiresAccidentOutcome> a owl:ObjectProperty ;
    rdfs:label "요구 사고 결과"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/penalty#PenaltyCondition> ;
    rdfs:range <https://cashtoss.info/ontology/penalty#AccidentOutcome> .

<https://cashtoss.info/ontology/penalty#requiresSubjectRole> a owl:ObjectProperty ;
    rdfs:label "요구 주체 역할"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/penalty#PenaltyCondition> ;
    rdfs:range <https://cashtoss.info/ontology#SubjectRole> .

<https://cashtoss.info/ontology/penalty#severityScore> a owl:DatatypeProperty ;
    rdfs:label "심각도 점수"@ko ;
    rdfs:range xsd:integer .

<https://cashtoss.info/ontology/penalty#violatedArticle> a owl:ObjectProperty ;
    rdfs:label "위반 조문"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/penalty#PenaltyRule> ;
    rdfs:range <https://cashtoss.info/ontology/law#Article> .

