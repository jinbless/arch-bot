    rdfs:domain <https://cashtoss.info/ontology/risk/situation#VisualTrigger> ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/risk/situation#validFrom> a owl:DatatypeProperty ;
    rdfs:label "유효 시작일 (법령 시행일)"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/risk/situation#SituationalHazardPattern> ;
    rdfs:range xsd:date .

<https://cashtoss.info/ontology/risk/situation#validUntil> a owl:DatatypeProperty ;
    rdfs:label "유효 종료일 (deprecate 시점)"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/risk/situation#SituationalHazardPattern> ;
    rdfs:range xsd:date .

<https://cashtoss.info/ontology/sr#addressesAccidentType> a owl:ObjectProperty ;
    rdfs:label "대응 사고유형"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/sr#SafetyRequirement> ;
    rdfs:range <https://cashtoss.info/ontology/risk/hazard#AccidentType> ;
