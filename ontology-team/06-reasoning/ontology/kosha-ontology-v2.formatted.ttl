    rdfs:domain <https://cashtoss.info/ontology/risk/situation#SituationalHazardPattern> ;
    owl:propertyChainAxiom ( <https://cashtoss.info/ontology/risk/situation#appliesSR> <https://cashtoss.info/ontology/sr#derivedFromNS> <https://cashtoss.info/ontology/penalty#hasPenaltyRule> <https://cashtoss.info/ontology/penalty#hasSanction> ) .

