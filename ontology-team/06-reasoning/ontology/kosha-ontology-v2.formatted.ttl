@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cashtoss.info/ontology> a owl:Ontology ;
    rdfs:label "KOSHA 산업안전보건 온톨로지"@ko ;
    rdfs:comment "산업안전보건기준에관한규칙(RULE) + KOSHA 가이드 기반 온톨로지. Pipe-A(법령 NS/SR) + Pipe-B(가이드 CI/DT/WP/ES/DR) 통합. OWL 2 DL."@ko ;
    owl:imports <http://purl.obolibrary.org/obo/bfo.owl>,
        <http://purl.obolibrary.org/obo/ro.owl>,
        <http://www.estrellaproject.org/lkif-core/lkif-core.owl>,
        <http://www.w3.org/ns/prov-o-20130430>,
        sosa: ;
    owl:versionInfo "2.0.0" .

<https://cashtoss.info/ontology#BuildingOwner> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#DutyHolder> ;
    rdfs:label "건축물·설비 소유주/임차인"@ko .

<https://cashtoss.info/ontology#Contractor> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#DutyHolder> ;
    rdfs:label "수급인"@ko .

<https://cashtoss.info/ontology#DeliveryBroker> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#DutyHolder> ;
    rdfs:label "물건 수거·배달 중개자"@ko .

<https://cashtoss.info/ontology#Driver> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#ProtectedPerson> ;
    rdfs:label "운전자"@ko .

<https://cashtoss.info/ontology#Employer> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#DutyHolder> ;
    rdfs:label "사업주"@ko .

<https://cashtoss.info/ontology#ExcavationDriver> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#ProtectedPerson> ;
    rdfs:label "굴착기계등의 운전자"@ko .

<https://cashtoss.info/ontology#FireWatcher> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#DutyHolder> ;
    rdfs:label "화재감시자"@ko .

<https://cashtoss.info/ontology#GovernmentOfficial> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#RegulatoryAuthority> ;
    rdfs:label "고용노동부장관"@ko .

<https://cashtoss.info/ontology#SpecialEmployer> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#DutyHolder> ;
    rdfs:label "특수형태근로종사자 노무제공받는 자"@ko .

<https://cashtoss.info/ontology#SpecialWorker> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#ProtectedPerson> ;
    rdfs:label "특수형태근로종사자"@ko .

<https://cashtoss.info/ontology#Supervisor> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#DutyHolder> ;
    rdfs:label "감시인"@ko .

<https://cashtoss.info/ontology#Worker> a owl:NamedIndividual,
        <https://cashtoss.info/ontology#ProtectedPerson> ;
    rdfs:label "근로자"@ko .

<https://cashtoss.info/ontology#broaderAgent> a owl:ObjectProperty ;
    rdfs:label "상위 유해인자 (custom broader)"@ko ;
    rdfs:comment "SKOS broader 대용. Individual 간 hierarchy를 표현 (Class subClassOf는 OWL 구조 위반)."@ko ;
    rdfs:domain <https://cashtoss.info/ontology/risk/agent#HazardousAgent> ;
    rdfs:range <https://cashtoss.info/ontology/risk/agent#HazardousAgent> .

<https://cashtoss.info/ontology#coApplicable> a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "공동 적용"@ko .

<https://cashtoss.info/ontology#exemptedBy> a owl:ObjectProperty ;
    rdfs:label "면제 근거"@ko .

<https://cashtoss.info/ontology#identifier> a owl:DatatypeProperty ;
    rdfs:label "식별자"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology#text> a owl:DatatypeProperty ;
    rdfs:label "텍스트"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology#title> a owl:DatatypeProperty ;
    rdfs:label "제목"@ko ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/app#AssessmentReport> a owl:Class ;
    rdfs:label "사업주 안내 결과"@ko ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003>,
        <http://www.estrellaproject.org/lkif-core/lkif-core#Norm> .

<https://cashtoss.info/ontology/app#basedOnObservation> a owl:ObjectProperty ;
    rdfs:label "근거 관찰"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/app#HazardFinding> ;
    rdfs:range <https://cashtoss.info/ontology/app#VisualObservation> .

<https://cashtoss.info/ontology/app#citesRequirement> a owl:ObjectProperty ;
    rdfs:label "인용 안전요구사항"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/app#CorrectiveAction> ;
    rdfs:range <https://cashtoss.info/ontology/sr#SafetyRequirement> .

<https://cashtoss.info/ontology/app#confidence> a owl:DatatypeProperty ;
    rdfs:label "관찰 신뢰도"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/app#VisualObservation> ;
    rdfs:range xsd:decimal .

<https://cashtoss.info/ontology/app#fileName> a owl:DatatypeProperty ;
    rdfs:label "파일명"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/app#UploadedPhoto> ;
    rdfs:range xsd:string .

<https://cashtoss.info/ontology/app#forAction> a owl:ObjectProperty ;
    rdfs:label "대상 개선 조치"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/app#ActionRecommendation> ;
    rdfs:range <https://cashtoss.info/ontology/app#CorrectiveAction> .

<https://cashtoss.info/ontology/app#guidedBy> a owl:ObjectProperty ;
    rdfs:label "개선 조치 참고 가이드"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/app#CorrectiveAction> ;
    rdfs:range <https://cashtoss.info/ontology/guide#KoshaGuide> .

<https://cashtoss.info/ontology/app#hasAction> a owl:ObjectProperty ;
