    rdfs:label "적용 조문"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/sr#SafetyRequirement> ;
    rdfs:range <https://cashtoss.info/ontology/law#Article> ;
    owl:propertyChainAxiom ( <https://cashtoss.info/ontology/sr#derivedFromNS> <https://cashtoss.info/ontology/law#hasSourceArticle> ) .

<https://cashtoss.info/ontology/sr#guidedBy> a owl:ObjectProperty ;
    rdfs:label "관련 가이드"@ko ;
    rdfs:domain <https://cashtoss.info/ontology/sr#SafetyRequirement> ;
    rdfs:range <https://cashtoss.info/ontology/guide#KoshaGuide> ;
    owl:propertyChainAxiom ( <https://cashtoss.info/ontology/sr#hasChecklistItem> <https://cashtoss.info/ontology/guide#isChecklistItemOf> ) .

<https://cashtoss.info/ontology/sr#hasBindingForce> a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "구속력"@ko .

<https://cashtoss.info/ontology/sr#hasRequirementType> a owl:FunctionalProperty,
