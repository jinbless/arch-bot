# Phase B (Axiom 100% Sprint) — Tier 2 alethic chain SWRL formal serialization.
#
# kosha-rules-v2.swrl pseudo-code (L95-113) → OWL/RDF SWRL syntax (Pellet/Openllet native).
# Phase A pattern (kosha-rules-r2-r4-swrl.ttl) 답습.
#
# 정형 대상 (4개): R-10, R-11, R-12, R-13
#
# R-09 정형 SKIP 사유:
#   원본 의사코드: observedIn(?obs, ?p) ← Photo(?p) ∧ hasVisualCue(?p, ?cue) ∧ VisualObservation(?obs)
#
#   1. Photo 클래스가 ontology TBox에 미정의 — Phase B 범위에서 신규 클래스 추가하면 ABox
#      (kosha-instances.ttl)에 Photo individual도 함께 등록해야 fire 가능. 그러나 사진은
#      현재 PG에 저장되며 ontology ABox에 photo URI까지 등록하지 않는 설계 결정.
#   2. app:hasVisualCue의 domain은 app:VisualObservation (kosha-ontology-v2.formatted.ttl L170-173)
#      이므로 의사코드의 `hasVisualCue(?p, ?cue)` (?p가 Photo)는 domain violation.
#   3. SWRL head는 existing individual 사이의 관계만 표현 가능 — VisualObservation의 신규 생성을
#      의도하는 R-09는 SWRL의 표현력을 넘는다.
#
#   → R-09는 SHACL CONSTRUCT 또는 SPARQL UPDATE로 데이터 변환 단계에서 처리 (Phase E 부근에서
#     R-27 SHACL fallback과 함께 재검토). Phase B에서는 정형 SKIP + 본 사유 기록.
#
# Pattern (Phase A 답습):
#   - swrlb:notEqual 회피 (Pellet "unsafe variable" 에러) — DL-safe pattern only
#   - 같은 SWRL Variable URI를 모든 rule에서 재사용 (스코프는 rule 단위)

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .

@prefix risk: <https://cashtoss.info/ontology/risk#> .
@prefix haz: <https://cashtoss.info/ontology/risk/hazard#> .
@prefix ctx: <https://cashtoss.info/ontology/risk/context#> .
@prefix app: <https://cashtoss.info/ontology/app#> .
@prefix guide: <https://cashtoss.info/ontology/guide#> .
@prefix kr: <https://cashtoss.info/ontology/swrl-rules#> .


### R-10: VisualObservation → RiskFeature (alethic chain entry)
# 시각 관찰에 나타난 단서(cue)를 근거로 위험 특징(RiskFeature)을 도출.
# Pseudocode:
#   VisualObservation(?obs) ∧ hasVisualCue(?obs, ?cue) ∧
#   RiskFeature(?rf) ∧ indicatesByCue(?rf, ?cue)
#     → hasRiskFeature(?obs, ?rf)
#
# Note: 의사코드의 `observesVisualCue`는 별칭 — 실제 ontology에선 app:hasVisualCue 사용.

kr:R10_HasRiskFeatureRule a swrl:Imp ;
    rdfs:label "R-10: hasRiskFeature 추론 (cue ↔ RiskFeature alignment)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate app:VisualObservation ;
          swrl:argument1 kr:x_obs ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate risk:RiskFeature ;
          swrl:argument1 kr:x_rf ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate app:hasVisualCue ;
          swrl:argument1 kr:x_obs ;
          swrl:argument2 kr:x_cue ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:indicatesByCue ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_cue ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:hasRiskFeature ;
          swrl:argument1 kr:x_obs ;
          swrl:argument2 kr:x_rf ]
    ) .


### R-11: RiskFeature → Hazard (corresponds → hasHazard inference)
# 위험 특징이 어떤 hazard 유형에 대응되는지를 명시 hazard link로 promote.
# Pseudocode:
#   RiskFeature(?rf) ∧ Hazard(?hazd) ∧ correspondsToHazard(?rf, ?hazd)
#     → hasHazard(?rf, ?hazd)

kr:R11_HasHazardRule a swrl:Imp ;
    rdfs:label "R-11: hasHazard 추론 (RiskFeature → Hazard)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate risk:RiskFeature ;
          swrl:argument1 kr:x_rf ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate haz:Hazard ;
          swrl:argument1 kr:x_hazd ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:correspondsToHazard ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_hazd ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate haz:hasHazard ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_hazd ]
    ) .


### R-12: RiskFeature → Equipment (compatible spec chain)
# 위험 특징이 특정 장비 스펙과 호환되면, 그 스펙을 가지는 장비에도 적용.
# Pseudocode:
#   RiskFeature(?rf) ∧ Equipment(?eq) ∧ EquipmentSpec(?spec) ∧
#   equipmentHasSpec(?eq, ?spec) ∧ compatibleWithSpec(?rf, ?spec)
#     → appliesToEquipment(?rf, ?eq)

kr:R12_AppliesToEquipmentRule a swrl:Imp ;
    rdfs:label "R-12: appliesToEquipment 추론 (RiskFeature × EquipmentSpec chain)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate risk:RiskFeature ;
          swrl:argument1 kr:x_rf ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate guide:Equipment ;
          swrl:argument1 kr:x_eq ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate guide:EquipmentSpec ;
          swrl:argument1 kr:x_spec ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate guide:equipmentHasSpec ;
          swrl:argument1 kr:x_eq ;
          swrl:argument2 kr:x_spec ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:compatibleWithSpec ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_spec ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:appliesToEquipment ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_eq ]
    ) .


### R-13: SituationMatch × WorkProcess → TemporalStage
# 상황 매칭(SituationMatch)이 어떤 WorkProcess에 매칭되면, 그 프로세스의 시간 단계가
# 곧 SituationMatch의 시간 단계.
# Pseudocode:
#   SituationMatch(?sm) ∧ WorkProcess(?wp) ∧
#   matchesProcess(?sm, ?wp) ∧ temporalStageForProcess(?wp, ?ts)
#     → hasTemporalStage(?sm, ?ts)
#
# Note: app:hasTemporalStage는 risk/situation#hasTemporalStage(domain SituationalHazardPattern)
# 와 별개 (domain SituationMatch).

kr:R13_HasTemporalStageRule a swrl:Imp ;
    rdfs:label "R-13: hasTemporalStage 추론 (SituationMatch × WorkProcess → TemporalStage)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate app:SituationMatch ;
          swrl:argument1 kr:x_sm ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate guide:WorkProcess ;
          swrl:argument1 kr:x_wp ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate app:matchesProcess ;
          swrl:argument1 kr:x_sm ;
          swrl:argument2 kr:x_wp ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate app:temporalStageForProcess ;
          swrl:argument1 kr:x_wp ;
          swrl:argument2 kr:x_ts ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate app:hasTemporalStage ;
          swrl:argument1 kr:x_sm ;
          swrl:argument2 kr:x_ts ]
    ) .


### SWRL Variable declarations

kr:x_obs a swrl:Variable .
kr:x_rf a swrl:Variable .
kr:x_cue a swrl:Variable .
kr:x_hazd a swrl:Variable .
kr:x_eq a swrl:Variable .
kr:x_spec a swrl:Variable .
kr:x_sm a swrl:Variable .
kr:x_wp a swrl:Variable .
kr:x_ts a swrl:Variable .
