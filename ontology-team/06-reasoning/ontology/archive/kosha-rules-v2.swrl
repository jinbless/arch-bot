# KOSHA 온톨로지 SWRL 추론 규칙 v2
# Pipe-A + Pipe-B + 옵션C SubjectRole
# Openllet/Pellet 추론 엔진 또는 SPARQL CONSTRUCT로 실행 가능

# ═══════════════════════════════════════════════════════════
# Pipe-A 추론 규칙 (R-1 ~ R-4)
# ═══════════════════════════════════════════════════════════

# R-1: 단서조항 면제 추론 (exemptedBy)
# EXEMPTION 모달리티인 NS가 OBLIGATION NS를 modifies하면,
# 해당 OBLIGATION NS는 exemptedBy 관계를 가진다.
#
# NormStatement(?ns1) ∧ hasModality(?ns1, Obligation) ∧
# NormStatement(?ns2) ∧ hasModality(?ns2, Exemption) ∧
# modifies(?ns2, ?ns1)
#   → exemptedBy(?ns1, ?ns2)

# R-2: 동일 조문 기반 SR 공동 적용 (coApplicable)
# 같은 Article에 근거하는 서로 다른 SR은 공동 적용 관계이다.
#
# SafetyRequirement(?sr1) ∧ SafetyRequirement(?sr2) ∧
# appliesToArticle(?sr1, ?art) ∧ appliesToArticle(?sr2, ?art) ∧
# DifferentFrom(?sr1, ?sr2)
#   → coApplicable(?sr1, ?sr2)

# R-3: 제재 심각도 자동 분류 (highSeverityPenalty)
# 심각도 점수가 5 이상인 제재는 고위험으로 분류한다.
#
# SanctionType(?san) ∧ severityScore(?san, ?score) ∧
# swrlb:greaterThanOrEqual(?score, 5)
#   → highSeverity(?san, true)

# R-4: SR 간 위험 의존성 추론
# 같은 위험 유형을 다루는 SR 중, 같은 조문에 근거한 것은 의존 관계이다.
#
# SafetyRequirement(?sr1) ∧ SafetyRequirement(?sr2) ∧
# addressesHazard(?sr1, ?haz) ∧ addressesHazard(?sr2, ?haz) ∧
# appliesToArticle(?sr1, ?art) ∧ appliesToArticle(?sr2, ?art) ∧
# DifferentFrom(?sr1, ?sr2)
#   → dependsOn(?sr1, ?sr2)

# ═══════════════════════════════════════════════════════════
# Pipe-B 추론 규칙 (R-5 ~ R-6)
# ═══════════════════════════════════════════════════════════

# R-5: CI→SR basedOn inverse 추론
# CI가 SR에 basedOnSR 관계를 가지면,
# SR은 해당 CI에 hasChecklistItem 관계를 가진다.
# (OWL에서 owl:inverseOf로 선언됨, Openllet이 자동 추론)
#
# ChecklistItem(?ci) ∧ basedOnSR(?ci, ?sr)
#   → hasChecklistItem(?sr, ?ci)

# R-6: 가이드 상호참조 대칭 추론
# Guide A가 Guide B를 참조하면, B도 A를 참조한다.
# (OWL에서 owl:SymmetricProperty로 선언됨, Openllet이 자동 추론)
#
# KoshaGuide(?g1) ∧ KoshaGuide(?g2) ∧ referencesGuide(?g1, ?g2)
#   → referencesGuide(?g2, ?g1)

# ═══════════════════════════════════════════════════════════
# 옵션C SubjectRole 추론 규칙 (R-7 ~ R-8)
# ═══════════════════════════════════════════════════════════

# R-7: SubjectRole 계층 추론
# Employer, Supervisor 등은 DutyHolder의 인스턴스이고,
# DutyHolder는 SubjectRole의 하위 클래스이므로,
# Employer는 SubjectRole이기도 하다.
# (OWL에서 rdfs:subClassOf로 선언됨, Openllet이 자동 추론)
#
# DutyHolder(?x) → SubjectRole(?x)
# ProtectedPerson(?x) → SubjectRole(?x)
# RegulatoryAuthority(?x) → SubjectRole(?x)

# R-8: DutyHolder/ProtectedPerson disjoint 검증
# 의무이행주체와 보호대상은 겹치지 않는다.
# 만약 한 인스턴스가 양쪽에 동시 속하면 inconsistency 발생.
# (OWL에서 owl:disjointWith로 선언됨, Openllet이 자동 검증)
#
# DutyHolder(?x) ∧ ProtectedPerson(?x) → ⊥ (모순)

# ═══════════════════════════════════════════════════════════
# OWL 공리 (kosha-ontology.owl에 포함됨, 참고용)
# ═══════════════════════════════════════════════════════════
#
# PA-1: hasNormStatement = inverseOf(hasSourceArticle)
# PA-2: hasSafetyRequirement = inverseOf(derivedFromNS)
# PA-3: modifiedBy = inverseOf(modifies)
# PA-4: appliesToArticle = propertyChain(derivedFromNS, hasSourceArticle)
# PA-5: hasChec


# --- v2 신규 rule (Phase E Step 3b 자동 생성) ---

# R-09: 사진 관찰로부터 시각 관찰 도출(VisualObservationFromPhoto) (alethic_inference)
# 업로드된 사진에 포함된 시각 단서로부터 관찰 객체(VisualObservation)를 생성/연결하는 기초 연계 규칙. (도메인 데이터에 따라 hasVisualCue/VisualObservation의 사용 방식을 맞추어 구현)
observedIn(?obs, ?p) ← Photo(?p) AND hasVisualCue(?p, ?cue) AND VisualObservation(?obs)

# R-10: 시각 관찰에서 위험 특징 식별(RiskFeatureFromVisualObservation) (alethic_inference)
# VisualObservation에 나타난 단서(cue)를 근거로 위험 특징(RiskFeature)을 도출한다.
risk:hasRiskFeature(?obs, ?rf) ← VisualObservation(?obs) AND observesVisualCue(?obs, ?cue) AND risk:RiskFeature(?rf) AND risk:indicatesByCue(?rf, ?cue)

# R-11: 위험 특징으로부터 위험 유형(Hazard) 추정(HazardFromRiskFeature) (alethic_inference)
# 위험 특징이 어떤 유해/위험 유형(hazard)에 대응되는지 매핑한다.
haz:hasHazard(?rf, ?hazd) ← risk:RiskFeature(?rf) AND haz:Hazard(?hazd) AND risk:correspondsToHazard(?rf, ?hazd)

# R-12: 장비/스펙 기반 위험 특징 정합성 연결(RiskFeatureAlignedWithEquipmentSpec) (alethic_inference)
# 위험 특징이 특정 장비 스펙/구성에 대해 성립함을 연결한다.
risk:appliesToEquipment(?rf, ?eq) ← risk:RiskFeature(?rf) AND Equipment(?eq) AND EquipmentSpec(?spec) AND equipmentHasSpec(?eq, ?spec) AND risk:compatibleWithSpec(?rf, ?spec)

# R-13: 작업 프로세스-상황 매칭으로 위험 상황 단계 추정(TemporalStageFromSituationMatch) (alethic_inference)
# 사진/상황 매칭 결과(SituationMatch)에서 작업 프로세스에 해당하는 시간 단계(TemporalStage)를 추정한다.
app:hasTemporalStage(?sm, ?ts) ← app:SituationMatch(?sm) AND WorkProcess(?wp) AND app:matchesProcess(?sm, ?wp) AND app:temporalStageForProcess(?wp, ?ts)

# R-14: 위험 특징 관찰이 위험을 관찰로 연결(ObservedInHazard) (bridge_inference)
# VisualObservation→RiskFeature→Hazard 흐름에서, 해당 위험이 관찰되었음을 bridge로 연결(개념적 연결). 실제 구현 시 observedIn 주체 인자를 온톨로지에 맞추어 정렬 필요.
Bridge:observedIn(?rfObs, ?hazd) ← VisualObservation(?vobs) AND risk:hasRiskFeature(?vobs, ?rf) AND haz:Hazard(?hazd) AND haz:hasHazard(?rf, ?hazd) AND Bridge:observedIn(?rfObs, ?hazd)

# R-15: 위험 특징에서 적용 가능한 SR 선택(AppliesSRFromHazard) (bridge_inference)
# 관찰된 위험 유형(hazard)에 대해 위험을 다루는 안전요건(SR)을 연결한다.
Bridge:appliesTo(?sr, ?hazd) ← risk:RiskFeature(?rf) AND haz:Hazard(?hazd) AND haz:hasHazard(?rf, ?hazd) AND sr:SafetyRequirement(?sr) AND sr:addressesHazard(?sr, ?hazd)

# R-16: 관찰 기반으로 SR 적용 문맥(ObservedIn) 연결(ObservedContextForSR) (bridge_inference)
# 같은 관찰 문맥(ctx)에서 특정 hazard가 관찰되었고, 그 hazard를 다루는 SR을 해당 문맥에 적용되도록 bridge한다.
Bridge:observedIn(?sr, ?ctx) ← sr:SafetyRequirement(?sr) AND core:observedIn(?obs, ?ctx) AND VisualObservation(?obs) AND risk:hasRiskFeature(?obs, ?rf) AND haz:hasHazard(?rf, ?hazd) AND sr:addressesHazard(?sr, ?hazd)

# R-17: 장비/작업 매칭으로 SR 적용 대상 장비 확정(EquipmentScopeForSR) (bridge_inference)
# 관찰된 위험 특징이 특정 장비에 대응되고, SR이 해당 장비에 적용됨을 확정한다.
Bridge:appliesTo(?sr, ?eq) ← sr:SafetyRequirement(?sr) AND Equipment(?eq) AND risk:appliesToEquipment(?rf, ?eq) AND risk:RiskFeature(?rf) AND VisualObservation(?vobs) AND risk:hasRiskFeature(?vobs, ?rf) AND sr:appliesToEquipment(?sr, ?eq)

# R-18: HazardFinding의 판정 상태가 SR 적용 조건에 반영(StatusConditionToSR) (bridge_inference)
# HazardFinding의 판정 상태가 SR의 적용 조건(문맥 cond)에 반영되도록 연결한다(메타데이터 cond를 만드는 방식은 데이터 구조에 맞춰 조정).
Bridge:appliesTo(?sr, ?cond) ← app:HazardFinding(?hf) AND app:FindingStatus(?hf) AND app:hasFindingStatus(?hf, ?st) AND sr:SafetyRequirement(?sr) AND sr:requiresFindingStatus(?sr, ?st) AND Bridge:appliesTo(?sr, ?cond)

# R-19: SR에 대응되는 적용 법조문 추론(ArticleLinkForSR) (deontic_inference)
# 이미 sr:basedOnArticle이 존재하는 경우, 명시적 링크를 강화(정규화)한다. (온톨로지에서 property명 상이 시 head/body 속성만 치환)
law:appliesArticle(?sr, ?art) ← sr:SafetyRequirement(?sr) AND sr:basedOnArticle(?sr, ?art)

# R-20: 법조문 기반 SR의 의무 모달리티 확정(ObligationModalityForSR) (deontic_inference)
# NormStatement(ns)가 SR로부터 도출되며, 그 모달리티를 의무(Obligation)로 연결한다.
core:hasModality(?ns, core:Obligation) ← sr:SafetyRequirement(?sr) AND law:NormStatement(?ns) AND law:groundedBySR(?ns, ?sr)

# R-21: NormStatement의 주어진 안전요건(SR)에서 제재 규칙 후보 연결(PenaltyCandidate) (deontic_inference)
# PenaltyRule이 어떤 NormStatement에 적용되는지 연결(명시 관계가 없을 경우 펜 규칙 지식모델에 따라 보강).
pen:penalizesNorm(?penRule, ?ns) ← pen:PenaltyRule(?penRule) AND law:NormStatement(?ns) AND pen:appliesToNormStatement(?penRule, ?ns)

# R-22: NormStatement가 특정 법(Article) 소속임을 연결(InDeonticByArticle) (deontic_inference)
# NormStatement가 근거하는 SR을 통해 Article 소속을 확정한다.
law:hasArticle(?ns, ?art) ← law:NormStatement(?ns) AND sr:SafetyRequirement(?sr) AND sr:basedOnArticle(?sr, ?art) AND law:groundedBySR(?ns, ?sr)

# R-23: SR 적용 위반에서 의무 위반으로 연결되는 NormStatement 준비(BridgeToViolationPrereq) (deontic_inference)
# 위반 체인 단계에서 사용될 수 있도록, 의무 모달리티의 NormStatement를 위반 후보로 표지(실제 property/개체는 사용 온톨로지에 맞추어 수정 필요).
violatesObligation:?ns ← law:NormStatement(?ns) AND core:hasModality(?ns, core:Obligation) AND sr:SafetyRequirement(?sr) AND law:groundedBySR(?ns, ?sr)

# R-24: SR 위반 추론: 관찰된 hazard에 대한 SR이 적용되나 준수 징표 부재(ViolationSRFromNoncompliance) (violation_chain)
# 관찰에서 비준수 정황(Noncompliance)이 확인되고, 그 hazard에 적용되는 SR이 존재하면 SR 위반으로 연결. (Noncompliance 관련 클래스/속성은 데이터에 맞게 조정)
core:hasViolation(?obs, ?sr) ← VisualObservation(?obs) AND Bridge:appliesTo(?sr, ?hazd) AND haz:hasHazard(?rf, ?hazd) AND risk:hasRiskFeature(?obs, ?rf) AND sr:SafetyRequirement(?sr) AND app:Noncompliance(?nc) AND app:indicatesNoncompliance(?nc, ?obs)

# R-25: SR 위반 → 위반된 NormStatement 도출(ViolationNSFromViolatedSR) (violation_chain)
# SR 위반을 근거로 그 SR을 근거로 하는 NormStatement를 ‘의무 위반’ 대상으로 연결한다.
Bridge:violatesObligation(?agent, ?ns) ← core:hasViolation(?obs, ?sr) AND law:NormStatement(?ns) AND law:groundedBySR(?ns, ?sr) AND agent:Worker(?agent)

# R-26: 위험 특징/관찰 기반으로 직접 위반 연결(ViolationFromRiskFeature) (violation_chain)
# 관찰된 위험 특징과 적용되는 SR을 거쳐 NormStatement 위반을 문맥(ctx) 단위로 연결한다.
core:hasViolation(?ctx, ?ns) ← VisualObservation(?obs) AND Bridge:observedIn(?sr, ?ctx) AND risk:hasRiskFeature(?obs, ?rf) AND haz:hasHazard(?rf, ?hazd) AND sr:SafetyRequirement(?sr) AND sr:addressesHazard(?sr, ?hazd) AND law:NormStatement(?ns) AND law:groundedBySR(?ns, ?sr) AND app:Noncompliance(?nc) AND app:indicatesNoncompliance(?nc, ?obs)

# R-27: 준수/면제 관계가 없는 의무 NormStatement만 위반으로 확정(ExcludeExempted) (violation_chain)
# 면제(exemption)가 의무를 modifies 하는 경우 위반 확정이 억제되어야 하는 논리이나, SWRL은 일반적으로 부정 조건을 표현하기 어렵다. 본 규칙은 ‘면제 후보 존재’ 시 위반 플래그를 유지/조정해야 하는 형태로 구현(엔진/데이터 모델에 따라 별도 규칙 분리 권장).
Bridge:violatesObligation(?agent, ?ns) ← Bridge:violatesObligation(?agent, ?ns) AND core:hasModality(?ns, core:Obligation) AND law:NormStatement(?exNs) AND core:hasModality(?exNs, core:Exemption) AND law:modifies(?exNs, ?ns)

# R-28: 위반된 NormStatement에 대한 제재 규칙 활성화(PenaltyRuleFromNS) (penalty_chain)
# 의무 위반이 확인된 NormStatement에 연결된 제재 규칙을 제재 노출 문맥에 적용한다.
pen:appliesPenaltyRule(?ctx, ?penRule) ← Bridge:violatesObligation(?agent, ?ns) AND pen:PenaltyRule(?penRule) AND pen:penalizesNorm(?penRule, ?ns) AND app:PenaltyExposure(?ctx)

# R-29: 제재 심각도에 따른 제재 레벨 라벨링(HighSeverityPenaltyToExposure) (penalty_chain)
# 제재 심각도 점수 5 이상이면 해당 제재 노출(ctx)을 HighSeverity로 라벨링한다.
app:hasPenaltyLevel(?ctx, app:HighSeverity) ← app:PenaltyExposure(?ctx) AND pen:PenaltyRule(?penRule) AND pen:appliesToExposure(?penRule, ?ctx) AND pen:severityScore(?penRule, ?score) AND swrlb:greaterThanOrEqual(?score, 5)

# R-30: 제재 규칙으로부터 실제 제재 항목(제재 결과) 도출(PenaltyResultFromPenaltyRule) (penalty_chain)
# PenaltyRule이 어떤 제재 결과(pr)로 귀결되는지 연결한다.
app:hasPenaltyResult(?ctx, ?pr) ← pen:PenaltyRule(?penRule) AND pen:resultsIn(?penRule, ?pr) AND pen:appliesPenaltyRule(?ctx, ?penRule)
