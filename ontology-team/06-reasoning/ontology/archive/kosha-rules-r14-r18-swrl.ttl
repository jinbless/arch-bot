# Phase C (Axiom 100% Sprint) — Tier 3 SWRL bridge chain.
#
# kosha-rules-v2.swrl pseudo-code (L115-133) → OWL/RDF SWRL.
# Phase A/B pattern 답습 (DL-safe, no swrlb:notEqual).
#
# 정형 대상 (5개): R-14 (보정), R-15, R-16, R-17, R-18 (보정)
#
# 의사코드 결함 보정:
#   - R-14 원본: head Bridge:observedIn(?rfObs, ?hazd) + body 동일 atom (self-ref) → ill-formed.
#     보정: head bridge:observedIn(?vobs, ?hazd) — VisualObservation이 Hazard에 관찰됨.
#         body의 self-ref atom 제거.
#   - R-18 원본: head Bridge:appliesTo(?sr, ?cond) + body 동일 atom (self-ref) + FindingStatus(?hf)
#     class atom mismatch (?hf는 HazardFinding이지 FindingStatus 아님) → ill-formed.
#     보정: head bridge:appliesTo(?sr, ?hf), body class atom FindingStatus(?st)로 수정,
#         self-ref atom 제거.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .

@prefix risk: <https://cashtoss.info/ontology/risk#> .
@prefix haz: <https://cashtoss.info/ontology/risk/hazard#> .
@prefix ctx: <https://cashtoss.info/ontology/risk/context#> .
@prefix app: <https://cashtoss.info/ontology/app#> .
@prefix sr: <https://cashtoss.info/ontology/sr#> .
@prefix guide: <https://cashtoss.info/ontology/guide#> .
@prefix core: <https://cashtoss.info/ontology#> .
@prefix bridge: <https://cashtoss.info/ontology/bridge#> .
@prefix kr: <https://cashtoss.info/ontology/swrl-rules#> .


### R-14: VisualObservation → Hazard via RiskFeature chain
# Boosted: VO observes RF which corresponds to Hazard → bridge:observedIn(VO, Hazard)
# 보정: 원본 self-ref body atom 제거, head를 VO→Hazard로 명시.
#
# body: VisualObservation(?vobs) ∧ hasRiskFeature(?vobs, ?rf) ∧ Hazard(?hazd) ∧
#       hasHazard(?rf, ?hazd)
# head: bridge:observedIn(?vobs, ?hazd)

kr:R14_VOBridgeObservedInRule a swrl:Imp ;
    rdfs:label "R-14: bridge:observedIn (VO→Hazard via RF chain, 보정)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate app:VisualObservation ;
          swrl:argument1 kr:x_vobs ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate haz:Hazard ;
          swrl:argument1 kr:x_hazd ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:hasRiskFeature ;
          swrl:argument1 kr:x_vobs ;
          swrl:argument2 kr:x_rf ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate haz:hasHazard ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_hazd ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate bridge:observedIn ;
          swrl:argument1 kr:x_vobs ;
          swrl:argument2 kr:x_hazd ]
    ) .


### R-15: SR ↔ Hazard via RiskFeature
# RF has Hazard ∧ SR addresses Hazard → SR applies to Hazard.
# body: RiskFeature(?rf) ∧ Hazard(?hazd) ∧ hasHazard(?rf,?hazd) ∧
#       SafetyRequirement(?sr) ∧ addressesHazard(?sr,?hazd)
# head: bridge:appliesTo(?sr, ?hazd)

kr:R15_SRBridgeAppliesToHazardRule a swrl:Imp ;
    rdfs:label "R-15: bridge:appliesTo (SR→Hazard via addressesHazard)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate risk:RiskFeature ;
          swrl:argument1 kr:x_rf ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate haz:Hazard ;
          swrl:argument1 kr:x_hazd ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate sr:SafetyRequirement ;
          swrl:argument1 kr:x_sr ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate haz:hasHazard ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_hazd ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate sr:addressesHazard ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_hazd ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate bridge:appliesTo ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_hazd ]
    ) .


### R-16: SR ↔ WorkContext via VO chain
# SR addresses hazard that is observed in some VO in ctx.
# body: SafetyRequirement(?sr) ∧ VisualObservation(?obs) ∧ core:observedIn(?obs, ?ctx) ∧
#       hasRiskFeature(?obs, ?rf) ∧ hasHazard(?rf, ?hazd) ∧ addressesHazard(?sr, ?hazd)
# head: bridge:observedIn(?sr, ?ctx)

kr:R16_SRBridgeObservedInRule a swrl:Imp ;
    rdfs:label "R-16: bridge:observedIn (SR→Ctx via VO chain)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate sr:SafetyRequirement ;
          swrl:argument1 kr:x_sr ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate app:VisualObservation ;
          swrl:argument1 kr:x_vobs ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate core:observedIn ;
          swrl:argument1 kr:x_vobs ;
          swrl:argument2 kr:x_ctx ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:hasRiskFeature ;
          swrl:argument1 kr:x_vobs ;
          swrl:argument2 kr:x_rf ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate haz:hasHazard ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_hazd ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate sr:addressesHazard ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_hazd ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate bridge:observedIn ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_ctx ]
    ) .


### R-17: SR ↔ Equipment via VO/RF chain + direct mapping
# 원본 의사코드: body에 head atom sr:appliesToEquipment(?sr, ?eq) 포함 → semantic equivalence.
# 즉 SR-Equipment 직접 매핑 + VO/RF chain 모두 성립할 때 bridge link 도출.
# body: SafetyRequirement(?sr) ∧ Equipment(?eq) ∧ RiskFeature(?rf) ∧ VisualObservation(?vobs) ∧
#       hasRiskFeature(?vobs, ?rf) ∧ appliesToEquipment(?rf, ?eq) ∧
#       sr:appliesToEquipment(?sr, ?eq)
# head: bridge:appliesTo(?sr, ?eq)

kr:R17_SRBridgeAppliesToEquipmentRule a swrl:Imp ;
    rdfs:label "R-17: bridge:appliesTo (SR→Equipment via VO/RF chain + direct map)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate sr:SafetyRequirement ;
          swrl:argument1 kr:x_sr ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate guide:Equipment ;
          swrl:argument1 kr:x_eq ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate risk:RiskFeature ;
          swrl:argument1 kr:x_rf ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate app:VisualObservation ;
          swrl:argument1 kr:x_vobs ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:hasRiskFeature ;
          swrl:argument1 kr:x_vobs ;
          swrl:argument2 kr:x_rf ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate risk:appliesToEquipment ;
          swrl:argument1 kr:x_rf ;
          swrl:argument2 kr:x_eq ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate sr:appliesToEquipment ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_eq ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate bridge:appliesTo ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_eq ]
    ) .


### R-18: SR ↔ HazardFinding via requiresFindingStatus (보정)
# 원본 self-ref body 제거 + FindingStatus class atom을 ?st로 수정.
# body: HazardFinding(?hf) ∧ FindingStatus(?st) ∧ hasFindingStatus(?hf, ?st) ∧
#       SafetyRequirement(?sr) ∧ requiresFindingStatus(?sr, ?st)
# head: bridge:appliesTo(?sr, ?hf)

kr:R18_SRBridgeAppliesToFindingRule a swrl:Imp ;
    rdfs:label "R-18: bridge:appliesTo (SR→HazardFinding via status, 보정)"@ko ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:classPredicate app:HazardFinding ;
          swrl:argument1 kr:x_hf ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate app:FindingStatus ;
          swrl:argument1 kr:x_st ]
        [ a swrl:ClassAtom ;
          swrl:classPredicate sr:SafetyRequirement ;
          swrl:argument1 kr:x_sr ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate app:hasFindingStatus ;
          swrl:argument1 kr:x_hf ;
          swrl:argument2 kr:x_st ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate sr:requiresFindingStatus ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_st ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:propertyPredicate bridge:appliesTo ;
          swrl:argument1 kr:x_sr ;
          swrl:argument2 kr:x_hf ]
    ) .


### SWRL Variable declarations

kr:x_sr a swrl:Variable .
kr:x_vobs a swrl:Variable .
kr:x_rf a swrl:Variable .
kr:x_hazd a swrl:Variable .
kr:x_eq a swrl:Variable .
kr:x_hf a swrl:Variable .
kr:x_st a swrl:Variable .
kr:x_ctx a swrl:Variable .
