    {
      "preAssignedId": "SR-ERGONOMIC-001",
      "articleCode": "제657조",
      "title": "유해요인 조사",
      "section": "편3 보건기준 > 장12 근골격계부담작업으로 인한 건강장해의 예방 > 절2 유해요인 조사 및 개선 등",
      "category": "ERGONOMIC",
      "nsGroup": [
        {
          "identifier": "NS-RULE657-0",
          "paragraphRef": "제657조 제1항",
          "text": "사업주는 근로자가 근골격계부담작업을 하는 경우에 3년마다 다음 각 호의 사항에 대한 유해요인조사를 하여야 한다.",
          "hasModality": "OBLIGATION",
          "hasSubjectRole": "사업주",
          "hasAction": "3년마다 유해요인조사를 하여야 한다",
          "hasObject": "설비ㆍ작업공정ㆍ작업량ㆍ작업속도 등 작업장 상황, 작업시간ㆍ작업자세ㆍ작업방법 등 작업조건, 근골격계질환 징후와 증상 유무",
          "hasCondition": {
            "conditionType": "QUALITATIVE",
            "text": "근로자가 근골격계부담작업을 하는 경우"
          }
        },
        {
          "identifier": "NS-RULE657-1",
          "paragraphRef": "제657조 제1항 단서",
          "text": "다만, 신설되는 사업장의 경우에는 신설일부터 1년 이내에 최초의 유해요인 조사를 하여야 한다.",
          "hasModality": "OBLIGATION",
          "hasSubjectRole": "사업주",
          "hasAction": "신설일부터 1년 이내에 최초의 유해요인 조사를 하여야 한다",
          "hasObject": "유해요인 조사(최초)",
          "hasCondition": {
            "conditionType": "QUALITATIVE",
            "text": "신설되는 사업장의 경우"
          }
        },
        {
          "identifier": "NS-RULE657-2",
          "paragraphRef": "제657조 제2항",
          "text": "사업주는 다음 각 호의 어느 하나에 해당하는 사유가 발생하였을 경우에 제1항에도 불구하고 1개월 이내에 조사대상 및 조사방법 등을 검토하여 유해요인 조사를 해야 한다.",
          "hasModality": "OBLIGATION",
          "hasSubjectRole": "사업주",
          "hasAction": "1개월 이내에 조사대상 및 조사방법 등을 검토하여 유해요인 조사를 해야 한다",
          "hasObject": "유해요인 조사(수시)",
          "hasCondition": {
            "conditionType": "CAUSAL",
            "text": "근골격계질환자 발생 또는 업무상 질병 인정, 새로운 작업ㆍ설비 도입, 업무량ㆍ작업공정 등 작업환경 변경 사유가 발생하였을 경우"
          }
        },
        {
          "identifier": "NS-RULE657-4",
          "paragraphRef": "제657조 제3항",
          "text": "사업주는 유해요인 조사에 근로자 대표 또는 해당 작업 근로자를 참여시켜야 한다.",
          "hasModality": "OBLIGATION",
          "hasSubjectRole": "사업주",
          "hasAction": "참여시켜야 한다",
          "hasObject": "유해요인 조사에 근로자 대표 또는 해당 작업 근로자 참여",
          "hasCondition": null
        }
      ],
      "exemptionNS": [
        {
          "identifier": "NS-RULE657-3",
          "text": "다만, 제1호에 해당하는 경우로서 해당 근골격계질환에 대하여 최근 1년 이내에 유해요인 조사를 하고 그 결과를 반영하여 제659조에 따른 작업환경 개선에 필요한 조치를 한 경우는 제외한다.",
          "hasModificationLink": {
            "modificationType": "EXCEPTION",
            "modifiesNS": "NS-RULE657-2"
          }
        }
      ],
      "quantitativeConditions": [],
      "hasSanction": {
        "criminal": {
          "violation_employer": {
            "law": "산업안전보건법 제168조 제1호 (제39조 경유)",
            "penalty": "5년 이하의 징역 또는 5천만원 이하의 벌금"
          },
          "violation_contractor": {
            "law": "산업안전보건법 제169조 제1호 (제63조 경유)",
            "penalty": "3년 이하의 징역 또는 3천만원 이하의 벌금"
          },
          "death": {
            "law": "산업안전보건법 제167조 (제39조 위반 + 사망)",
            "penalty": "7년 이하의 징역 또는 1억원 이하의 벌금"
          },
          "seriousAccident": {
            "law": "중대재해 처벌 등에 관한 법률 제6조",
            "death": "1년 이상의 징역 또는 10억원 이하의 벌금",
            "injury": "7년 이하의 징역 또는 1억원 이하의 벌금"
          }
        },
        "administrative": null
      }
