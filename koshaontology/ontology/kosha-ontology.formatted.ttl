she:appliesPenalty a owl:ObjectProperty ;
    rdfs:label "적용되는 벌칙 (PA-12 chain 결과)"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    owl:propertyChainAxiom ( she:appliesSR sr:derivedFromNS pen:hasPenaltyRule pen:hasSanction ) .

she:hasAccidentType a owl:ObjectProperty ;
    rdfs:label "사고 유형"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range haz:AccidentType ;
    rdfs:subPropertyOf risk:hasFeature .

she:hasAgentState a owl:ObjectProperty ;
    rdfs:label "작업자 상태"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range ctx:AgentState ;
    rdfs:subPropertyOf risk:hasFeature .

she:hasEnvironmental a owl:ObjectProperty ;
    rdfs:label "환경 요인"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range ctx:EnvironmentalFactor ;
    rdfs:subPropertyOf risk:hasFeature .

she:hasHazardousAgent a owl:ObjectProperty ;
    rdfs:label "유해 인자"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range agent:HazardousAgent ;
    rdfs:subPropertyOf risk:hasFeature .

she:hasPPEState a owl:ObjectProperty ;
    rdfs:label "보호구 상태"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range ctx:PPEState ;
    rdfs:subPropertyOf risk:hasFeature .

she:hasTemporalStage a owl:ObjectProperty ;
    rdfs:label "시간 단계"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range ctx:TemporalStage ;
    rdfs:subPropertyOf risk:hasFeature .

she:hasVisualTrigger a owl:ObjectProperty ;
    rdfs:label "시각 트리거"@ko ;
    rdfs:comment "사진 관찰에서 SHE 패턴 매칭에 사용할 수 있는 재사용 가능한 시각 단서."@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range she:VisualTrigger .

she:hasWorkActivity a owl:ObjectProperty ;
    rdfs:label "작업 활동"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range ctx:WorkActivity ;
    rdfs:subPropertyOf risk:hasFeature .

she:hasWorkContext a owl:ObjectProperty ;
    rdfs:label "작업 맥락"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range ctx:WorkContext ;
    rdfs:subPropertyOf risk:hasFeature .

she:relatedChecklistCue a owl:ObjectProperty ;
    rdfs:label "관련 체크리스트 단서"@ko ;
    rdfs:comment "SHE 매칭에 보조 단서로 쓰는 체크리스트 항목. 최종 조치 본체가 아니라 검색 색인/근거 조각이다."@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range guide:ChecklistItem .

she:relatedGuide a owl:ObjectProperty ;
    rdfs:label "관련 KOSHA 가이드"@ko ;
    rdfs:comment "SHE에 대응하는 개선 절차의 1순위 지식원."@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range guide:KoshaGuide .

she:supersededBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "대체된 SHE (supersession chain)"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range she:SituationalHazardPattern .

she:triggerPattern a owl:DatatypeProperty ;
    rdfs:label "시각 트리거 패턴"@ko ;
    rdfs:domain she:VisualTrigger ;
    rdfs:range xsd:string .

she:triggerText a owl:DatatypeProperty ;
    rdfs:label "시각 트리거 문구"@ko ;
    rdfs:domain she:VisualTrigger ;
    rdfs:range xsd:string .

she:validFrom a owl:DatatypeProperty ;
    rdfs:label "유효 시작일 (법령 시행일)"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range xsd:date .

she:validUntil a owl:DatatypeProperty ;
    rdfs:label "유효 종료일 (deprecate 시점)"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range xsd:date .

sr:addressesAccidentType a owl:ObjectProperty ;
    rdfs:label "대응 사고유형"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range haz:AccidentType ;
    rdfs:subPropertyOf sr:addressesFeature .

sr:addressesAgent a owl:ObjectProperty ;
    rdfs:label "대응 유해인자"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range agent:HazardousAgent ;
    rdfs:subPropertyOf sr:addressesFeature .

sr:addressesHazard a owl:ObjectProperty ;
    rdfs:label "대응 위험"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range haz:Hazard ;
    rdfs:subPropertyOf sr:addressesFeature .

sr:appliesToArticle a owl:ObjectProperty ;
    rdfs:label "적용 조문"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range law:Article ;
    owl:propertyChainAxiom ( sr:derivedFromNS law:hasSourceArticle ) .

sr:guidedBy a owl:ObjectProperty ;
    rdfs:label "관련 가이드"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range guide:KoshaGuide ;
    owl:propertyChainAxiom ( sr:hasChecklistItem guide:isChecklistItemOf ) .

sr:hasBindingForce a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "구속력"@ko .

sr:hasRequirementType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "요구사항 유형"@ko .

sr:hasSafetyRequirement a owl:ObjectProperty ;
    rdfs:label "안전요구사항 보유"@ko ;
    owl:inverseOf sr:derivedFromNS .

sr:inWorkContext a owl:ObjectProperty ;
    rdfs:label "작업맥락"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range ctx:WorkContext ;
    rdfs:subPropertyOf sr:addressesFeature .

sr:violatedIn a owl:ObjectProperty ;
    rdfs:label "위반될 수 있는 상황"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range she:SituationalHazardPattern ;
    owl:inverseOf she:appliesSR .

core:Definition a owl:NamedIndividual,
        core:Modality ;
    rdfs:label "정의"@ko .

core:Informative a owl:NamedIndividual,
        core:BindingForce ;
    rdfs:label "정보"@ko .

core:Mandatory a owl:NamedIndividual,
        core:BindingForce ;
    rdfs:label "필수"@ko .

core:Obligation a owl:NamedIndividual,
        core:Modality ;
    rdfs:label "의무"@ko .

core:Permission a owl:NamedIndividual,
        core:Modality ;
    rdfs:label "허용"@ko .

core:Prohibition a owl:NamedIndividual,
        core:Modality ;
    rdfs:label "금지"@ko .

core:Recommended a owl:NamedIndividual,
        core:BindingForce ;
    rdfs:label "권고"@ko .

core:RegulatoryAuthority a owl:Class ;
    rdfs:label "규제기관"@ko ;
    rdfs:subClassOf core:SubjectRole .

app:ConditionalPenaltyExposure a owl:NamedIndividual,
        app:PenaltyExposureStatus ;
    rdfs:label "조건부 벌칙 노출"@ko .

app:ConfirmedFinding a owl:NamedIndividual,
        app:FindingStatus ;
    rdfs:label "확인됨"@ko .

app:CorrectiveActionPlan a owl:Class ;
    rdfs:label "조치 계획"@ko .

app:DirectPenaltyExposure a owl:NamedIndividual,
        app:PenaltyExposureStatus ;
    rdfs:label "직접 벌칙 노출"@ko .

app:NeedsClarificationFinding a owl:NamedIndividual,
        app:FindingStatus ;
    rdfs:label "확인 필요"@ko .

app:NoPenaltyExposure a owl:NamedIndividual,
        app:PenaltyExposureStatus ;
    rdfs:label "벌칙 노출 없음"@ko .

app:NotDeterminedFinding a owl:NamedIndividual,
        app:FindingStatus ;
    rdfs:label "판단 불가"@ko .

app:SuspectedFinding a owl:NamedIndividual,
        app:FindingStatus ;
    rdfs:label "의심"@ko .

guide:basedOnSR a owl:ObjectProperty ;
    rdfs:label "SR 기반"@ko ;
    rdfs:domain guide:ChecklistItem ;
    rdfs:range sr:SafetyRequirement .

guide:hasChecklistItem a owl:ObjectProperty ;
    rdfs:label "점검항목 보유"@ko .

guide:isChecklistItemOf a owl:ObjectProperty ;
    rdfs:label "소속 가이드"@ko ;
    rdfs:domain guide:ChecklistItem ;
    rdfs:range guide:KoshaGuide ;
    owl:inverseOf guide:hasChecklistItem .

law:hasModality a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "모달리티"@ko ;
    rdfs:domain law:NormStatement ;
    rdfs:range core:Modality .

pen:Death a owl:NamedIndividual,
        pen:AccidentOutcome ;
    rdfs:label "사망"@ko .

pen:SeriousAccident a owl:NamedIndividual,
        pen:AccidentOutcome ;
    rdfs:label "중대재해"@ko .

pen:SimpleViolation a owl:NamedIndividual,
        pen:AccidentOutcome ;
    rdfs:label "단순 위반"@ko .

pen:hasPenaltyRule a owl:ObjectProperty ;
    rdfs:label "벌칙 적용 규칙"@ko ;
    rdfs:domain law:NormStatement ;
    rdfs:range pen:PenaltyRule ;
    owl:inverseOf pen:violatedNorm .

pen:hasSanction a owl:ObjectProperty ;
    rdfs:label "제재"@ko ;
    rdfs:domain pen:PenaltyRule ;
    rdfs:range pen:SanctionType .

pen:violatedNorm a owl:ObjectProperty ;
    rdfs:label "위반 대상 규범"@ko ;
    rdfs:domain pen:PenaltyRule ;
    rdfs:range law:NormStatement .

she:appliesCI a owl:ObjectProperty ;
    rdfs:label "적용되는 체크리스트 항목"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range guide:ChecklistItem .

sr:EmergencyResponse a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "비상대응"@ko .

sr:Environmental a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "환경"@ko .

sr:EquipmentStandard a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "장비 기준"@ko .

sr:ManagementSystem a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "관리 체계"@ko .

sr:PPERequirement a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "보호구"@ko .

sr:PhysicalProtection a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "물리적 보호"@ko .

sr:Procedural a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "절차적"@ko .

sr:Training a owl:NamedIndividual,
        sr:RequirementType ;
    rdfs:label "교육훈련"@ko .

sr:hasChecklistItem a owl:ObjectProperty ;
    rdfs:label "점검항목 보유"@ko ;
    owl:inverseOf guide:basedOnSR .

core:Exemption a owl:NamedIndividual,
        core:Modality ;
    rdfs:label "면제"@ko .

app:InspectionCase a owl:Class ;
    rdfs:label "분석 건"@ko .

law:hasSourceArticle a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "출처 조문"@ko ;
    rdfs:domain law:NormStatement ;
    rdfs:range law:Article .

law:modifies a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:label "수정 대상"@ko ;
    rdfs:domain law:NormStatement ;
    rdfs:range law:NormStatement .

risk:RiskPattern a owl:Class ;
    rdfs:label "위험 패턴"@ko .

she:appliesSR a owl:ObjectProperty ;
    rdfs:label "적용되는 SR"@ko ;
    rdfs:domain she:SituationalHazardPattern ;
    rdfs:range sr:SafetyRequirement .

core:BindingForce a owl:Class ;
    rdfs:label "구속력"@ko ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( core:Mandatory core:Recommended core:Informative ) ] .

app:PenaltyExposure a owl:Class ;
    rdfs:label "벌칙 노출"@ko .

app:SituationMatch a owl:Class ;
    rdfs:label "상황 매칭"@ko .

app:UploadedPhoto a owl:Class ;
    rdfs:label "업로드 사진"@ko .

app:VisualCue a owl:Class ;
    rdfs:label "시각 단서"@ko .

law:LegalEntity a owl:Class ;
    rdfs:label "법령 엔티티"@ko .

pen:PenaltyCondition a owl:Class ;
    rdfs:label "벌칙 선택 조건"@ko .

pen:SanctionType a owl:Class ;
    rdfs:label "제재 유형"@ko .

she:VisualTrigger a owl:Class ;
    rdfs:label "시각 트리거"@ko ;
    rdfs:comment "SHE 패턴 매칭에 사용할 수 있는 사진 관찰 단서."@ko .

sr:derivedFromNS a owl:ObjectProperty ;
    rdfs:label "NS에서 파생"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range law:NormStatement .

app:PenaltyExposureStatus a owl:Class ;
    rdfs:label "벌칙 노출 상태"@ko ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( app:DirectPenaltyExposure app:ConditionalPenaltyExposure app:NoPenaltyExposure ) ] .

app:VisualObservation a owl:Class ;
    rdfs:label "관찰 사실"@ko .

law:LegalStructure a owl:Class ;
    rdfs:label "법령 구조"@ko .

pen:AccidentOutcome a owl:Class ;
    rdfs:label "사고 결과"@ko ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( pen:SimpleViolation pen:Death pen:SeriousAccident ) ] .

sr:addressesFeature a owl:ObjectProperty ;
    rdfs:label "위험 특징 연결"@ko ;
    rdfs:domain sr:SafetyRequirement ;
    rdfs:range risk:RiskFeature .

core:ProtectedPerson a owl:Class ;
    rdfs:label "보호대상"@ko ;
    rdfs:subClassOf core:SubjectRole .

core:SubjectRole a owl:Class ;
    rdfs:label "의무 주체"@ko .

app:FindingStatus a owl:Class ;
    rdfs:label "판정 상태"@ko ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( app:ConfirmedFinding app:SuspectedFinding app:NeedsClarificationFinding app:NotDeterminedFinding ) ] .

law:Article a owl:Class ;
    rdfs:label "조문"@ko ;
    rdfs:subClassOf law:LegalEntity .

core:Modality a owl:Class ;
    rdfs:label "모달리티"@ko ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( core:Obligation core:Prohibition core:Permission core:Exemption core:Definition ) ] .

app:ActionRecommendation a owl:Class ;
    rdfs:label "조치 추천 항목"@ko .

app:HazardFinding a owl:Class ;
    rdfs:label "위험 판단"@ko .

guide:KoshaGuide a owl:Class ;
    rdfs:label "KOSHA 가이드"@ko .

law:LawType a owl:Class ;
    rdfs:label "법령 유형"@ko .

ctx:AgentState a owl:Class ;
    rdfs:label "작업자 상태 (agent_state)"@ko ;
    rdfs:subClassOf risk:RiskFeature .

ctx:TemporalStage a owl:Class ;
    rdfs:label "시간 단계 (temporal_stage)"@ko ;
    rdfs:subClassOf risk:RiskFeature .

core:DutyHolder a owl:Class ;
    rdfs:label "의무이행주체"@ko ;
    rdfs:subClassOf core:SubjectRole ;
    owl:disjointWith core:ProtectedPerson .

app:CorrectiveAction a owl:Class ;
    rdfs:label "개선 조치"@ko .

pen:PenaltyRule a owl:Class ;
    rdfs:label "벌칙 적용 규칙"@ko ;
    rdfs:subClassOf law:LegalEntity .

risk:hasFeature a owl:ObjectProperty ;
    rdfs:label "위험 특징 보유"@ko ;
    rdfs:domain risk:RiskPattern ;
    rdfs:range risk:RiskFeature .

sr:RequirementType a owl:Class ;
    rdfs:label "요구사항 유형"@ko ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( sr:Procedural sr:PhysicalProtection sr:EquipmentStandard sr:ManagementSystem sr:Environmental sr:PPERequirement sr:EmergencyResponse sr:Training ) ] .

guide:ChecklistItem a owl:Class ;
    rdfs:label "점검항목"@ko ;
    rdfs:comment "사진 서비스에서는 최종 개선조치 본체가 아니라 시각 단서, 검색 색인, 보조 근거로 사용한다."@ko .

law:NormStatement a owl:Class ;
    rdfs:label "규범 진술문"@ko ;
    rdfs:subClassOf law:LegalEntity .

ctx:EnvironmentalFactor a owl:Class ;
    rdfs:label "환경 요인 (environmental)"@ko ;
    rdfs:subClassOf risk:RiskFeature .

risk:RiskFeature a owl:Class ;
    rdfs:label "위험 특징"@ko ;
    rdfs:comment "SHE의 8개 feature 차원 통합 상위 클래스. she:hasFeature의 range."@ko .

ctx:WorkActivity a owl:Class ;
    rdfs:label "작업 활동 (work_activity)"@ko ;
    rdfs:subClassOf risk:RiskFeature .

haz:Hazard a owl:Class ;
    rdfs:label "위험 유형"@ko ;
    rdfs:subClassOf risk:RiskFeature .

sr:SafetyRequirement a owl:Class ;
    rdfs:label "안전요구사항"@ko .

agent:HazardousAgent a owl:Class ;
    rdfs:label "유해 인자"@ko ;
    rdfs:subClassOf risk:RiskFeature .

haz:AccidentType a owl:Class ;
    rdfs:label "사고 유형"@ko ;
    rdfs:subClassOf risk:RiskFeature .

ctx:PPEState a owl:Class ;
    rdfs:label "보호구 상태 (ppe_state)"@ko ;
    rdfs:subClassOf risk:RiskFeature .

she:SituationalHazardPattern a owl:Class ;
    rdfs:label "위험상황 패턴"@ko ;
    rdfs:comment "사진별 사건이 아니라 반복 재사용되는 위험상황 패턴. 사진 관찰 단서와 SR/KOSHA Guide를 연결하는 브릿지 역할을 한다."@ko ;
    rdfs:subClassOf risk:RiskPattern .

ctx:WorkContext a owl:Class ;
    rdfs:label "작업 맥락"@ko ;
    rdfs:subClassOf risk:RiskFeature .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty law:modifies ;
            owl:someValuesFrom law:NormStatement ] ;
    owl:intersectionOf ( law:NormStatement [ a owl:Restriction ;
                owl:hasValue core:Exemption ;
                owl:onProperty law:hasModality ] ) .

