    rdfs:label "근로자"@ko .

core:broaderAgent a owl:ObjectProperty ;
    rdfs:label "상위 유해인자 (custom broader)"@ko ;
    rdfs:comment "SKOS broader 대용. Individual 간 hierarchy를 표현 (Class subClassOf는 OWL 구조 위반)."@ko ;
    rdfs:domain agent:HazardousAgent ;
    rdfs:range agent:HazardousAgent .

