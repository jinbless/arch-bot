<https://cashtoss.info/ontology> a owl:Ontology ;
    rdfs:label "KOSHA 산업안전보건 온톨로지"@ko ;
    rdfs:comment "산업안전보건기준에관한규칙(RULE) + KOSHA 가이드 기반 온톨로지. Pipe-A(법령 NS/SR) + Pipe-B(가이드 CI/DT/WP/ES/DR) 통합. OWL 2 DL."@ko ;
    owl:versionInfo "2.0.0" .

core:BuildingOwner a owl:NamedIndividual,
        core:DutyHolder ;
    rdfs:label "건축물·설비 소유주/임차인"@ko .

core:Contractor a owl:NamedIndividual,
        core:DutyHolder ;
    rdfs:label "수급인"@ko .

core:DeliveryBroker a owl:NamedIndividual,
        core:DutyHolder ;
    rdfs:label "물건 수거·배달 중개자"@ko .

core:Driver a owl:NamedIndividual,
        core:ProtectedPerson ;
    rdfs:label "운전자"@ko .

core:Employer a owl:NamedIndividual,
        core:DutyHolder ;
    rdfs:label "사업주"@ko .

core:ExcavationDriver a owl:NamedIndividual,
        core:ProtectedPerson ;
