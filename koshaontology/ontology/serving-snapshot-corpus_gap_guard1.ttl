    app:reviewStatus "candidate"^^xsd:string ;
    app:servingAllowed true ;
    app:servingCandidateFor guide:H-138-2021 ;
    app:triggerTerm "생물안전 캐비닛·오토클레이브·검체용기"^^xsd:string .

