    app:reviewStatus "candidate"^^xsd:string ;
    app:servingAllowed true ;
    app:servingCandidateFor guide:E-G-9-2026 ;
    app:triggerTerm "잠수용 비상기체통·실린더 압력계·레귤레이터"^^xsd:string .

