app:ServingCandidate_A-147-2018_feature_001 a app:ServingCandidate ;
    app:baselineId "corpus_gap_guard1"^^xsd:string ;
    app:candidateScope "feature"^^xsd:string ;
    app:confidence 0.85 ;
    app:evidence "guideCode: A-147-2018; shortCode: A147; checklist: 분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.; checklist: 광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의해야 하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.; workProcess: 시료채취; workProcess: 시료 전처리; workProcess: 검량선 작성 및 정도관리; equipment: 10% NBD chloride 코팅 XAD-7 흡착관; equipment: 액체크로마토그래프(HPLC)"^^xsd:string ;
    app:featureCode "CHEMICAL_EXPOSURE"^^xsd:string ;
    app:legalAsserted false ;
    app:method "codex_manual_pilot"^^xsd:string ;
    app:reviewStatus "candidate"^^xsd:string ;
    app:servingAllowed true ;
    app:servingCandidateFor guide:A-147-2018 .

