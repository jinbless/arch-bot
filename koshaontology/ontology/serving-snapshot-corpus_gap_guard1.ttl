app:ServingCandidate_H-147-2021_visual_trigger_001 a app:ServingCandidate ;
    app:baselineId "corpus_gap_guard1"^^xsd:string ;
    app:candidateScope "visual_trigger"^^xsd:string ;
    app:confidence 0.84 ;
    app:evidence "guideCode: H-147-2021; title: 특별관리물질 취급 근로자의 작업환경관리 지침; checklist: 작업관리 대책을 수립할 때에는 위험성 감소 효과가 큰 수단부터 강구하는 것을 원칙으로 하며, 일반적으로 그 효과가 큰 순서는 ① 제거·대체, ② 공학적 대책, ③ 행정적 대책, ④ 개인용 보호구의 사용이다.; checklist: 특별관리물질을 대체하는 경우에는 대체 화학물질의 물질안전보건자료(Material Safety Data Sheet, MSDS) 내 2. 유해성·위험성 및 11. 독성에 관한 정보 등을 면밀히 검토해야 한다.; checklist: 특별관리물질 취급 업무에 대한 작업계획을 수립할 때에는 특별관리물질에 의한 유해·위험성 여부를 우선적으로 고려하고, 특별관리물질이 발생되는 작업공정에 대하여는 다음 내용을 포함하는 표준작업관리지침을 마련하여 작업 근로자가 준수하도록 한다.; workProcess: 작업관리 대책 수립 및 물질 대체 검토; workProcess: 작업계획 수립 및 표준작업관리지침 작성; workProcess: 특별관리물질 작업관리; workProcess: 특별안전보건 교육 실시; equipment: 특급 방진마스크; equipment: 방독마스크; equipment: 방진기능을 가지는 방독마스크"^^xsd:string ;
    app:legalAsserted false ;
    app:method "codex_manual_pilot"^^xsd:string ;
    app:reviewStatus "candidate"^^xsd:string ;
    app:servingAllowed true ;
    app:servingCandidateFor guide:H-147-2021 ;
    app:triggerTerm "특별관리물질 취급일지·표준작업관리지침"^^xsd:string .

