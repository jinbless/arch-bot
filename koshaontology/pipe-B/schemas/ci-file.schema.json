{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ci-file.schema.json",
  "title": "KOSHA Guide CI Extraction Output",
  "description": "가이드별 5종 엔티티(CI/DT/WP/ES/DR) 추출 결과",
  "type": "object",
  "required": [
    "metadata",
    "checklistItems",
    "domainTerms",
    "workProcesses",
    "equipmentSpecs",
    "documentRequirements"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["guideCode", "shortCode", "domain", "extractedAt", "extractedBy"],
      "additionalProperties": false,
      "properties": {
        "guideCode": { "type": "string", "minLength": 6 },
        "shortCode": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9]+$" },
        "domain": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
        "extractedAt": { "type": "string", "format": "date-time" },
        "extractedBy": { "type": "string", "minLength": 1 },
        "batchId": { "type": ["string", "null"] }
      }
    },
    "checklistItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "text", "bindingForce", "sourceSection"],
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^CI-[A-Z0-9]+-[0-9]+$"
          },
          "text": { "type": "string", "minLength": 1 },
          "guideContext": { "type": ["string", "null"] },
          "additionalDetail": { "type": ["string", "null"] },
          "workProcessPhase": { "type": ["string", "null"] },
          "bindingForce": {
            "type": "string",
            "enum": ["MANDATORY", "RECOMMENDED"]
          },
          "requirementType": {
            "type": ["string", "null"],
            "enum": [
              "PHYSICAL_PROTECTION", "PPE_REQUIREMENT", "PROCEDURAL",
              "TRAINING", "EQUIPMENT_STANDARD", "ENVIRONMENTAL",
              "MANAGEMENT_SYSTEM", "EMERGENCY_RESPONSE", null
            ]
          },
          "sourceSection": { "type": "string", "minLength": 1 },
          "basedOn": {
            "type": ["array", "null"],
            "items": { "type": "string", "pattern": "^SR-[A-Z_]+-[0-9]+$" },
            "description": "candidateSR 범위 내 SR ID. MANDATORY CI는 필수."
          }
        }
      }
    },
    "domainTerms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "term", "definition", "sourceSection"],
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^DT-[A-Z0-9]+-[0-9]+$"
          },
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "sourceSection": { "type": "string", "minLength": 1 },
          "relatedSR": {
            "type": ["array", "null"],
            "items": { "type": "string", "pattern": "^SR-[A-Z_]+-[0-9]+$" }
          }
        }
      }
    },
    "workProcesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "processOrder", "processName", "sourceSection"],
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^WP-[A-Z0-9]+-[0-9]+$"
          },
          "processOrder": { "type": "integer", "minimum": 1 },
          "processName": { "type": "string", "minLength": 1 },
          "safetyMeasures": { "type": ["string", "null"] },
          "requiredPPE": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceSection": { "type": "string", "minLength": 1 },
          "relatedSR": {
            "type": ["array", "null"],
            "items": { "type": "string", "pattern": "^SR-[A-Z_]+-[0-9]+$" }
          }
        }
      }
    },
    "equipmentSpecs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "equipmentName", "specifications", "sourceSection"],
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^ES-[A-Z0-9]+-[0-9]+$"
          },
          "equipmentName": { "type": "string", "minLength": 1 },
          "specifications": {
            "type": "object",
            "description": "장비 규격 정보 (자유 형식 JSONB)"
          },
          "sourceSection": { "type": "string", "minLength": 1 },
          "relatedSR": {
            "type": ["array", "null"],
            "items": { "type": "string", "pattern": "^SR-[A-Z_]+-[0-9]+$" }
          }
        }
      }
    },
    "documentRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["identifier", "documentType", "title", "sourceSection"],
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "type": "string",
            "pattern": "^DR-[A-Z0-9]+-[0-9]+$"
          },
          "documentType": {
            "type": "string",
            "enum": [
              "WORK_PLAN", "RISK_ASSESSMENT", "SAFETY_CHECKLIST",
              "MSDS", "INCIDENT_REPORT", "TRAINING_RECORD"
            ]
          },
          "title": { "type": "string", "minLength": 1 },
          "requiredSections": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1 }
          },
          "sourceSection": { "type": "string", "minLength": 1 },
          "relatedSR": {
            "type": ["array", "null"],
            "items": { "type": "string", "pattern": "^SR-[A-Z_]+-[0-9]+$" }
          }
        }
      }
    }
  }
}
