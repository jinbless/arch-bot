  "checklistItems": [
    {
      "identifier": "CI-H199-001",
      "text": "석면해체·제거작업 감리인은 석면해체·제거작업이 사업장주변석면배출허용기준 또는 「산업안전보건법」 제38조의5제1항에 따른 석면농도기준을 지키기 어렵다고 판단하면 석면 해체·제거업자에게 석면해체·제거작업의 시정, 중지, 건축물이나 설비의 철거 또는 해체중지의 조치를 요청하여야 한다",
      "guideContext": "석면해체·제거작업 감리 (법령 근거 미확인)",
      "additionalDetail": "석면안전관리법 제30조의2에 근거",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-002",
      "text": "석면해체·제거작업 감리인은 석면해체·제거업자가 작업의 중지, 시정, 설비의 철거 또는 해체중지의 조치를 요청받고도 석면해체·제거작업을 계속하는 경우에는 지방환경관서의 장과 특별자치시장·특별자치도지사·시장·군수·구청장 또는 지방고용노동관서의 장에게 보고하여야 한다",
      "guideContext": "석면해체·제거작업 감리 (법령 근거 미확인)",
      "additionalDetail": "석면안전관리법 제30조의 제4항에 근거",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-003",
      "text": "감리인은 석면해체·제거작업이 완료된 후 해당 석면조사 및 안전성 평가 등에 관한 고시에 의거 측정한 작업장의 공기 중 석면농도가 1세제곱센티미터당 0.01개 이하가 되도록 석면해체·제거 후 작업을 관리하여야 하며, 그 증명자료가 해당 지방관서로 제출되는 지를 확인하여야 한다",
      "guideContext": "석면해체·제거작업 감리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 후 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-004",
      "text": "공기 중 석면농도가 석면농도기준을 초과한 경우 감리인은 건축물이나 설비의 소유주 등이 해당 건축물이나 해체·제거작업을 위한 설비 등을 철거하거나 해체하지 않도록 해야 한다",
      "guideContext": "석면해체·제거작업 감리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-005",
      "text": "감리인은 석면해체·제거업자가 석면해체·제거작업 계획을 수립한 경우에 이를 해당 근로자에게 알리고 있는지 여부와, 작업장에 대한 석면조사 방법 및 종료일자, 석면조사 결과의 요지를 해당 근로자가 보기 쉬운 장소에 게시하고 있는지 확인하여야 한다",
      "guideContext": "석면해체·제거작업 감리",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H199-006",
      "text": "석면해체·제거작업 신고서와 대상사업장의 일치 여부를 확인하여야 한다",
      "guideContext": "석면해체·제거작업 계획서 적절성 검토 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-007",
      "text": "관할 지방고용노동지청으로부터 받은 석면해체·제거작업 신고증명서를 확인하여야 한다",
      "guideContext": "석면해체·제거작업 계획서 적절성 검토 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-008",
      "text": "석면해체·제거작업 면적이 석면해체·제거작업 감리인 배치기준에 적합한지 확인하여야 한다",
      "guideContext": "석면해체·제거작업 계획서 적절성 검토 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-009",
      "text": "석면해체·제거작업 공사일정과 투입인력의 적절성을 확인하여야 한다",
      "guideContext": "석면해체·제거작업 계획서 적절성 검토 (법령 근거 미확인)",
      "additionalDetail": "계획서에 기재된 투입인력과 실제 투입인력 일치 여부, 작업역할 배분, 예비인력 포함 여부 확인",
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-010",
      "text": "석면해체·제거작업에 필요한 장비 확보 여부를 확인하여야 한다",
      "guideContext": "석면해체·제거작업 계획서 적절성 검토 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-011",
      "text": "감리인은 석면해체·제거작업 계획서에 포함되어 있는 석면조사보고서에 대하여 석면조사보고서와 대상 사업장과의 일치, 제거되어야 할 석면함유자재의 종류와 면적, 석면지도와 실제 대상건물에서 석면함유물질의 일치, 현장사진과 실제 대상건물의 일치, 석면조사기관의 고용노동부허가, 석면해체·제거면적의 일치를 확인하여야 한다",
      "guideContext": "석면해체·제거작업 감리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H199-012",
      "text": "석면해체·제거작업장의 경고표지의 설치를 확인하여야 한다",
      "guideContext": "석면해체·제거작업 감리",
      "additionalDetail": null,
      "workProcessPhase": "석면해체·제거 준비작업",
      "bindingForce": "MANDATORY",
