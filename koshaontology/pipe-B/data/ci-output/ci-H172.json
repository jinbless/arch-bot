  "domainTerms": [
    {
      "identifier": "DT-H172-001",
      "term": "아스팔트",
      "definition": "원유를 정제하고 난 후 남은 찌꺼기 부분의 고체 또는 반고체의 흑갈색 탄화수소 화합물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H172-002",
      "term": "발암물질",
      "definition": "암을 일으키거나 그 발생을 증가시키는 물질이며, 고용노동부의 발암성 1(A, B)과 2인 물질을 용량비율 0.1% 이상 함유한 제재를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H172-003",
      "term": "다환방향족탄화수소(polycyclic aromatic hydrocarbons, PAHs)",
      "definition": "둘 이상의 벤젠 고리를 가지고 있는 탄화수소류를 말한다. 세계보건기구(WHO) 산하 국제 암 연구 센터(IARC)가 지정한 1급 발암물질인 벤젠 등 각종 발암물질과 신경 독성 물질 등 인체에 특히 해로운 유해물질을 통칭한다. 아세나프텐, 벤조피렌, 나프탈렌, 안트라센, 크리센 등이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H172-004",
      "term": "호흡용보호구",
      "definition": "콜타르 피치의 흡입으로 인한 건강장해 예방 또는 유해물질로 오염된 공기 등을 흡입함으로써 발생할 수 있는 건강장해를 예방하기 위하여 고안된 보호구를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "DT-H172-005",
      "term": "밀착도 검사(fit test)",
      "definition": "착용자의 얼굴에 호흡보호구가 효과적으로 밀착되는지 확인하기 위한 검사를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "DT-H172-006",
      "term": "프라임코우트",
      "definition": "보조기층, 입도조정 기층 등에 침투시켜 이들 층의 방수성을 높이고, 그 위에 포설하는 아스팔트 혼합물 층과의 부착을 좋게 하기 위해 보조기층 또는 기층위에 역청재료를 살포한 것을 말한다.",
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "DT-H172-007",
      "term": "택코우트",
      "definition": "아스팔트 혼합물 간이나 교량, 고가차도 등의 슬래브와 아스팔트혼합물과의 부착을 좋게 하기 위해 표면에 역청재료를 살포한 것을 말한다.",
      "sourceSection": "4",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H172-01",
      "processOrder": 1,
      "processName": "보조기층 마무리",
      "safetyMeasures": "정지LEVEL 확인, 다짐 상태 확인(들밀도시험/PROOF ROLLING), 부석·먼지·기타 이물질 제거",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-02",
      "processOrder": 2,
      "processName": "프라임코팅",
      "safetyMeasures": "포설량 75ℓ/a 준수, 기온 10℃ 이하 또는 강우 시 시공 중단, 시공 후 24시간 이상 양생, 아스팔트 디스트리뷰터 사용",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-03",
      "processOrder": 3,
      "processName": "아스팔트 기층 포설 및 다짐",
      "safetyMeasures": "대기온도 2℃ 이상일 때 시공, 7cm 두께로 1·2차 포설, 최대다짐밀도 96% 이상 되도록 다짐, 타이어 로울러로 3회 이상 프루프롤링 실시",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-04",
      "processOrder": 4,
      "processName": "택코팅",
      "safetyMeasures": "기온 5℃ 이상에서 시공, 포설량 30ℓ/a, 유화 아스팔트(RS-(C)-4 또는 RS(A)-4) 또는 킷트백아스팔트(RC-O, RC-1) 사용",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-05",
      "processOrder": 5,
      "processName": "중간층 포설",
      "safetyMeasures": "혼합물 온도 120℃ 이하가 되지 않도록 관리, 혼합물이 식기 전 포설 완료, 포설두께 6cm(구배 2%), 기준밀도 최소 96% 이상 다짐",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-06",
      "processOrder": 6,
      "processName": "다짐",
      "safetyMeasures": "이음다짐→1차다짐→2차다짐→마무리다짐 순서 준수, 이음부(가로·세로방향이음 및 구조물 접속부) 충분히 다져 밀착, 1차다짐은 로우드로울러(8t)로 2회(1왕복), 2차다짐은 타이어로울러 또는 8t 이상 머캐덤로울러 사용, 마무리다짐은 탠덤로울러 또는 머캐덤로울러 사용",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-07",
      "processOrder": 7,
      "processName": "마무리 및 검사",
      "safetyMeasures": "포장이음부 충분히 전압, 세로이음위치 15cm 이상·가로이음위치 1m 이상 확보, 1,000㎡당 1개소 이상 두께검사, 3m 직선자 측정 시 요철부 3mm 이하 확인",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-29",
      "processOrder": 8,
      "processName": "반면형 방독마스크 착용",
      "safetyMeasures": "미리 머리끈을 넉넉하게 끼운 후 머리나 목에 걸고 면체를 왼손으로 잡는다. 면체를 턱부터 집어넣고 면체가 입과 코 위에 위치하도록 한다. 목 뒤로 끈을 걸고, 끈의 길이를 조절하여 면체가 얼굴에 완전히 밀착되도록 한다. 마스크를 착용할 때마다 흡입부를 손바닥으로 막은 다음 숨을 들이마시거나 숨을 내쉬어 밀착도 자가점검을 실시한다.",
      "requiredPPE": [
        "반면형 방독마스크"
      ],
      "sourceSection": "12.2",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-H172-30",
      "processOrder": 9,
      "processName": "방독마스크 밀착도 자가 점검",
      "safetyMeasures": "배기밸브를 손으로 막거나 마개를 부착하여 막는다. 착용자는 천천히 숨을 내쉰다. 안면부의 내부가 약간 양압이 되어 마스크 안면부와 안면과의 접촉면으로 공기가 새어나가는 느낌이 없다면 밀착도는 좋은 상태이다.",
      "requiredPPE": [
        "반면형 방독마스크"
      ],
      "sourceSection": "12.2",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-H172-31",
      "processOrder": 10,
      "processName": "호흡용보호구 세척 및 소독",
      "safetyMeasures": "모든 분리 가능한 부품을 제거하고 검사한다. 연성세제 혹은 제조업체에서 추천한 세척액이 섞인 따뜻한 물을 가지고 각 부품을 세척한다. 세척하는 물은 43.3℃를 넘지 않도록 하고 염소나 산소계 표백제 등 세제를 사용하지 않는다. 깨끗하고 따뜻하며(43.3℃) 흐르는 물로 각 부품을 행군다. 깨끗하고 보풀이 없는 천이나 건조한 공기 중에서 부품을 말린다. 각 부품을 재조립한다. 모든 부분이 잘 작동되는지 테스트해 본다.",
      "requiredPPE": [],
      "sourceSection": "12.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-32",
      "processOrder": 11,
      "processName": "아스팔트 흄 흡입 시 응급처치",
      "safetyMeasures": "오염지역을 벗어나 신선한 공기가 있는 곳으로 이동시키고 호흡하지 않는 경우 인공호흡을 실시한다. 필요하다면 의사의 치료를 받도록 한다.",
      "requiredPPE": [],
      "sourceSection": "16",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-33",
      "processOrder": 12,
      "processName": "아스팔트 흄 피부 접촉 시 응급처치",
      "safetyMeasures": "오염된 의복, 신발, 장신구 등은 즉시 제거한다. 화학물질이 완전히 제거될 때까지 다량의 물을 사용하여 비누 또는 중성세제로 씻어낸다. (최소 15-20분간) 오염된 의복과 신발은 재사용 전에 철저히 건조시키고 세탁해야 한다.",
      "requiredPPE": [],
      "sourceSection": "16",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-34",
      "processOrder": 13,
      "processName": "아스팔트 흄 눈 접촉 시 응급처치",
      "safetyMeasures": "위 아래 눈꺼풀을 들어 올린 채 화학물질이 완전히 제거 될 때까지 즉시 다량의 물 또는 식염수로 눈을 씻어내도록 한다. (최소 15분동안) 의사의 치료를 받도록 한다.",
      "requiredPPE": [],
      "sourceSection": "16",
      "relatedSR": null
    },
    {
      "identifier": "WP-H172-35",
      "processOrder": 14,
      "processName": "열경련·열탈진 응급처치",
      "safetyMeasures": "지체없이 서늘한 곳에 이동시켜 체온을 떨어뜨리고 증상에 따라 수분 및 염분 등을 보충시킨다. 필요한 경우 즉시 의사의 진찰을 받는다.",
      "requiredPPE": [],
      "sourceSection": "16",
      "relatedSR": [
        "SR-HEAT-003"
      ]
    },
    {
      "identifier": "WP-H172-36",
      "processOrder": 15,
      "processName": "한랭환경 장애 응급처치",
      "safetyMeasures": "따뜻한 곳으로 이동시켜 체온을 올릴 수 있도록 조치하고 따뜻한 음료를 마시도록 한다. 필요시 의사의 진찰을 받는다.",
      "requiredPPE": [],
      "sourceSection": "16",
      "relatedSR": [
        "SR-HEAT-004"
      ]
    }
  ],
