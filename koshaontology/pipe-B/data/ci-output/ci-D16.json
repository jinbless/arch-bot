  "domainTerms": [
    {
      "identifier": "DT-D16-001",
      "term": "폭발억제장치",
      "definition": "밀폐 또는 제한된 공간을 가지는 설비 내에서 발생된 화재를 조기에 감지하여 이를 초기단계에서 억제함으로써 폭연(Deflagration)으로 인한 압력이 설비의 설계압력 이상으로 상승하는 것을 사전에 방지하여 설비 등의 파손을 예방하기 위하여 설치하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D16-002",
      "term": "억제제",
      "definition": "공정용기내에서 폭발이 시작될 때 이를 초기에 소화하여 큰 폭발로 발전하지 않도록 하기위하여 고속방출 소화용기 내에 가압된 상태로 충전된 소화약제를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D16-003",
      "term": "감지기",
      "definition": "화재를 초기단계에서 감지하여 폭발억제장치의 전원장치에 작동신호를 제공하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D16-004",
      "term": "제어기",
      "definition": "감지기로부터 수신된 신호를 분석하여 해당 고속방출소화용기에 장착된 전기기동장치를 작동시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D16-005",
      "term": "고속방출소화용기",
      "definition": "억제제가 가압 충전된 용기로서 전기적 신호에 의해 억제제를 방출하는 용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-D16-01",
      "processOrder": 1,
      "processName": "폭발억제장치 설계",
      "safetyMeasures": "폭발위험물질의 폭발특성, 방호되는 장치, 감지기술, 억제제의 종류, 설치·운전·시험절차를 포함하여 설계하고, 공정에 내재한 폭발위험의 형태와 정도를 결정하기 위해 철저한 위험 분석을 수행한다. 고속차단밸브, 공기식 이송시스템 가동정지, 폭발 방산구 등과 연동되도록 설계한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-D16-02",
      "processOrder": 2,
      "processName": "감지기 및 전기기동장치 설치",
      "safetyMeasures": "감지기는 압력증가 또는 복사에너지를 감지할 수 있는 것을 설치하고, 이물질에 의해 감지기능이 저하되지 않도록 보호한다. 전기기동장치는 최대운전온도에서도 기능에 영향이 없도록 설치하고, 제조회사의 작동 사양에 적합한 전원을 사용한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-D16-03",
      "processOrder": 3,
      "processName": "전원장치 및 감시회로 설치",
      "safetyMeasures": "전원장치에 비상전력을 공급하고, 방폭구조 전기기계·기구·배선 기준에 적합하게 설치한다. 회로의 개방, 접지·지락, 주전원 및 비상전원 이상 시 결함을 연속 검출할 수 있는 감시회로와 경보기·표시등을 설치한다.",
      "requiredPPE": [],
