  "checklistItems": [
    {
      "identifier": "CI-H83-001",
      "text": "시험계획서에는 표지, 시험개요, 시험세부계획이 포함되도록 한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "시험계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-002",
      "text": "시험책임자는 동물시험의 타당성 확인을 위하여 시험계획서 작성 후부터 시험 실시 전까지 실험동물관리위원회의 승인을 득하고, 시험번호, 시험물질, 동물종(계통), 주령, 동물 수, 도입 시 동물체중, 생산업자(공급업자) 등을 결정하고 구매 부서에 동물구입을 신청한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "동물 구입 및 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-003",
      "text": "동물관리책임자는 동물구입이 신청되면, 해당동물이 정해진 일정에 도입될 수 있도록 구매 부서에 동물구매를 신청하고, 해당동물이 사육될 동물실을 지정하여 시험동물이 GLP (Good laboratory practice) 시험에 적합하게 사육될 수 있도록 준비하고, 사육기간 중에는 사육되는 동물의 정보를 입력한 표지를 동물사육실에 부착한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "동물 구입 및 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-004",
      "text": "외부에서 공급되는 동물은 시험에 들어가기 전, 검역 등의 수입절차를 거쳐야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 구입 및 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-005",
      "text": "수입검사 결과 실험동물이 부적절한 경우 시험책임자는 개개의 동물 또는 동물 모두를 교환한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "동물 구입 및 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-006",
      "text": "실험동물을 공급 받을 때는 해당동물의 유전적 특성, 미생물성적서 등을 제공받아야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": "제공받은 동물관련 자료의 원본은 동물관리부문에서 관리하며, 신뢰성보증 부문에서는 사본을 복사하여 보관한다.",
      "workProcessPhase": "동물 구입 및 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-007",
      "text": "각 용량 군에서 상처가 없는 건강한 피부를 가진 암·수 동수의 동물을 사용한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "동물 구입 및 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-008",
      "text": "각 용량 군에는 적어도 10 마리의 동물(암컷 5 마리, 수컷 5 마리)을 사용하여야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": "암컷은 임신한 경험이 없는 동물을 사용한다.",
      "workProcessPhase": "동물 구입 및 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-009",
      "text": "동물은 개별적으로 사육해야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-010",
      "text": "시험동물실의 온도는 설치류 22±3 ℃, 토끼 20±3 ℃을 유지하고, 상대습도는 30~70 %로 하여야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": "조명은 인위적으로 조정할 경우 매 12시간 간격으로 점멸한다.",
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-011",
      "text": "순화기간 중 사용되는 동물사육실에 청소 및 소독작업을 실시한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-012",
      "text": "필요한 기자재, 사육상자대, 사육우리(cage)등의 배치상태와 사육우리의 인식 번호가 바르게 되었는지 확인한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-013",
      "text": "일반상태를 관찰하고 기록한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "사망, 활동성, 체위, 보행성, 정서, 반응성, 영양상태, 외피상황, 눈과 주변, 발·치아, 코, 피부, 기타 증상을 관찰한다.",
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-014",
      "text": "감염증이 의심되는 동물발견 시 부검장소를 최소한으로 하고, 해부장소 및 사용한 기구는 멸균 소독하며, 동물에 접촉한 사람은 소독하고 세정한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "사체에 소독 액을 분무하고, 비닐봉지에 넣어 입구를 막고 냉동고에 보관한다.",
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-015",
      "text": "동물관리책임자는 잔여동물 발생 1주일 이내에 잔여동물을 양도하여야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": "잔여동물의 용도가 1주일 이내로 결정되지 않을 경우 동물관리책임자는 잔여동물을 처분하여야 한다.",
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-016",
      "text": "동물의 생사 및 일반증상을 관찰한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "시험계획서에 따라 체중 및 섭취한 사료 및 음용수량을 측정한다.",
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-017",
      "text": "검역 및 순화가 끝나면 검역보고서를 작성하고 이를 보관한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "검역 및 순화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-018",
      "text": "군 구성 전 증상관찰에 의하여 해당시험에 부적합하다고 판단되는 동물을 미리 제외시킨다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "동물증상기록표에 제외동물의 이유를 기록한다.",
      "workProcessPhase": "군 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-019",
      "text": "체중을 기준으로 난수표등을 이용하여 무작위로 군을 구성한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "군 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-020",
      "text": "용량단계를 설정하기 위하여 최소한 3단계 범위는 되어야 하며, 시험군에 어느 일정 범위의 독성효과와 사망률이 나타나도록 적절한 간격을 두어야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": "용량단계 설정은 용량-반응곡선을 작성하는데 충분하여야 하며, 적절한 LD50가 산출될 수 있는 것이어야 한다.",
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-021",
      "text": "최소한 14일간 관찰한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "독성 반응이나 증상이 출현했을 경우, 또는 회복기간이 긴 경우는 관찰기간을 연장할 수 있다.",
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-022",
      "text": "투여개시 전에 각 투여군의 동물번호 등 시험실시에 관련되는 시험수순을 확인하여야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-023",
      "text": "각 시험군의 투여 전 실험동물의 체중을 측정하고 시험수순에서 특별한 지시가 있는 경우를 제외하고 저용량에서 고용량의 순으로 실시한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-024",
      "text": "시험물질의 현탁액 또는 용액은 시험수순에 서술되어 있는 경우를 제외하고는 투여 당일에 조제한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-025",
      "text": "시험물질을 수령할 때는 용기라벨이 완전한가를 확인한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "만약 결함이 있으면 그 라벨의 시험물질은 사용하지 말아야 하고 시험책임자와 상담한다.",
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.5",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H83-026",
      "text": "투여량 및 투여물질에 관한 표지가 투여동물의 사육상자 표지, 시험수순 및 시험실시 예정표의 일치여부가 확인되어야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.5",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H83-027",
      "text": "투여 약 24시간 전에 등 부분의 털을 전기 제모기로 깎고 면도하여 제거한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "이때 피부에 상처를 내면 투과성에 영향을 주므로 상처가 나지 않도록 주의한다.",
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-028",
      "text": "시험물질을 투여하기 위해서는 전체표면적의 10 % 범위에 해당하는 투여면적에 균일하게 투여한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "독성이 강한 물질은 도포면적을 보다 적게 하는 경우도 있으나 도포부위 전체를 가능하면 얇고 균일한 필름 상으로 넓게 피복한다.",
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-029",
      "text": "시험물질은 24시간의 노출기간 중 다공성 거즈, 비자극성 테이프를 사용하여 피부와 접촉을 유지시켜야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-030",
      "text": "동물이 시험적용 부위의 시험물질을 섭취하지 못하도록 하여야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": "시험물질의 섭식을 방지하기 위해 보조 장비를 사용할 수 있으나 완전히 구속하여서는 안 된다.",
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-031",
      "text": "노출시간 종료 후 남아있는 시험물질 및 투여부위는 물 또는 적당한 용매를 사용하여 제거한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H83-032",
      "text": "시험물질의 투여에 관계하는 모든 사람은 투여 후, 해당 양식(시험기록지)에 서명하고 날짜를 기입한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-033",
      "text": "투여 후 모든 동물의 증상관찰 등을 상세히 관찰·기록하여야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-034",
      "text": "관찰사항은 정확하고, 계통적으로 기록한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "각 동물에 대한 개개의 기록을 남겨둔다.",
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-035",
      "text": "시험물질을 투여한 후 첫날은 일정시간 간격으로 3회 이상 관찰하고, 그 후에는 적어도 매일 1회 주의 깊게 관찰해야 한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-036",
      "text": "사망된 동물이 확인되면 해부 및 냉장보존하고 쇠약 또는 빈사상태의 동물은 격리 또는 도살 처분한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": null,
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-037",
      "text": "동물의 증상은 체모, 눈 및 점막, 호흡기계, 순환기계, 자율신경 및 중추신경계, 전신운동능력 및 행동패턴을 포함하여 관찰한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "진전, 경련, 유연, 설사, 졸림, 수면 및 혼수 등의 증상 유무를 관찰한다.",
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-038",
      "text": "시험동물의 체중은 시험물질의 투여직전에 측정하며, 투여 후에는 매주 및 사망 시에 측정한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "실험 종료 때는 생존동물은 체중측정을 행한 후 도살한다.",
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-039",
      "text": "모든 동물은 부검을 실시해야 하며 육안적 병리 변화를 모두 기록해야한다.",
      "guideContext": "화학물질의 급성경피독성 시험 (법령 근거 미확인)",
      "additionalDetail": "육안적 병리소견을 나타내는 기관(Organ)에 대하여는 현미경 검사로 유용한 정보를 확보할 수 있기 때문에 현미경 검사 실시 여부를 판단한다.",
      "workProcessPhase": "병리검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H83-040",
      "text": "한쪽 성의 시험 종료 후 최소한 다른 쪽 성의 1개 군 5마리씩 각 농도군에 투여하여 다른 쪽 성의 동물이 시험물질에 대하여 특별하게 현저히 높은 감수성을 갖고 있는지 여부를 확인한다.",
      "guideContext": "화학물질의 급성경피독성 시험",
      "additionalDetail": "어느 쪽의 성이 시험물질에 보다 높은 감수성을 갖는지 충분한 정보가 얻어지는 경우에는 다른 쪽의 시험을 생략하여도 된다.",
      "workProcessPhase": "임상검사 및 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.8",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H83-001",
      "term": "급성경피독성",
      "definition": "시험물질을 피부에 1회 도말 하였을 때 짧은 시간 내에 나타나는 악영향을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-002",
      "term": "용량",
      "definition": "동물에 적용된 시험물질의 양을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-003",
      "term": "LD50",
      "definition": "1회 투여 시 시험동물의 50 %를 치사시킬 수 있는 시험물질의 용량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-004",
      "term": "용량-반응 관계",
      "definition": "규정된 영향을 보이는 시험개체의 비율과 용량과의 관계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-005",
      "term": "용량단위",
      "definition": "시험동물의 체중 당 시험물질의 중량(mg/kg)으로 표시하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-006",
      "term": "운영책임자",
      "definition": "시험기관 전반의 관리 운영에 대한 책임을 지는 자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-007",
      "term": "시험책임자",
      "definition": "해당시험에 대한 전문지식과 경험이 있는 전문가로서 시험계획, 시행, 보고서 작성등 시험전반을 책임지는 자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-008",
      "term": "시험동물관리 위원회",
      "definition": "실험동물의 적절한 사용과 관리, 동물실험과정의 윤리준수 등을 협의하는 위원회를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H83-009",
      "term": "순화",
      "definition": "사육환경조건에서 생리적으로 적응함을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H83-01",
      "processOrder": 1,
      "processName": "시험계획서 작성",
      "safetyMeasures": "시험책임자는 운영책임자로부터 지정된 직후부터 시험계획서를 작성하며, 표지, 시험개요, 시험세부계획이 포함되도록 한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H83-02",
      "processOrder": 2,
      "processName": "동물 구입 및 시험동물 선택",
      "safetyMeasures": "실험동물관리위원회의 승인을 득하고, 동물종·주령·동물 수·체중 등을 결정한다. 동물성적서(유전적 특성, 미생물성적서)를 제공받아 관리한다. 각 용량 군에는 적어도 10마리(암·수 동수)를 사용한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-H83-03",
      "processOrder": 3,
      "processName": "검역 및 순화",
      "safetyMeasures": "동물사육실 청소·소독 실시, 사육우리 배치 및 인식번호 확인, 일반상태 관찰·기록 실시. 감염증 의심 동물 발견 시 멸균 소독 조치. 순화 종료 후 검역보고서 작성·보관.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H83-04",
      "processOrder": 4,
      "processName": "군 구성",
      "safetyMeasures": "부적합 동물을 증상관찰로 사전 제외하고 이유를 기록한다. 체중 기준 난수표를 이용하여 무작위로 군을 구성한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": null
    },
    {
      "identifier": "WP-H83-05",
      "processOrder": 5,
      "processName": "시험물질 투여 준비 및 투여",
      "safetyMeasures": "투여 24시간 전 등 부분 제모(피부 손상 주의). 시험물질 용기라벨 완전성 확인. 투여량 표지 일치여부 확인. 전체표면적 10% 범위에 균일하게 투여. 24시간 다공성 거즈·비자극성 테이프로 접촉 유지. 동물의 시험물질 섭취 방지. 노출 종료 후 잔여물 제거.",
      "requiredPPE": [],
      "sourceSection": "8.5",
      "relatedSR": [
        "SR-CHEMICAL-017",
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "WP-H83-06",
      "processOrder": 6,
      "processName": "임상검사 및 관찰",
      "safetyMeasures": "투여 첫날 3회 이상 관찰, 이후 매일 1회 이상 관찰. 체모·눈·점막·호흡기계·순환기계·신경계·행동패턴 포함 관찰. 체중 매주 및 사망 시 측정. 사망동물 해부·냉장보존, 빈사동물 격리·도살. 최소 14일간 관찰.",
      "requiredPPE": [],
      "sourceSection": "8.6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H83-07",
      "processOrder": 7,
      "processName": "병리검사",
      "safetyMeasures": "모든 동물 부검 실시, 육안적 병리변화 기록. 육안적 병리소견 기관에 대해 현미경 검사 실시 여부 판단.",
      "requiredPPE": [],
      "sourceSection": "8.7",
      "relatedSR": null
    },
    {
      "identifier": "WP-H83-08",
      "processOrder": 8,
      "processName": "결과 처리 및 최종보고서 작성",
      "safetyMeasures": "각 시험군별 동물 수·사망시간·독성징후·부검소견 정리. LD50 산출(Bliss, Litchfield and Wilcoxon 등 방법). 최종보고서에 용량군별 반응성적표, LD50, 95% 신뢰한계, 병리소견 등 포함.",
      "requiredPPE": [],
      "sourceSection": "9",
      "relatedSR": null
    }
  ],
