  "equipmentSpecs": [
    {
      "identifier": "ES-M10-001",
      "equipmentName": "절단 보호용 장갑",
      "specifications": {
        "materials": "가죽, 면, 고무, PVC 코팅 면장갑, 니트릴 코팅 면장갑, 네오프린 코팅 면장갑, 라텍스 코팅 면장갑, 케블라(Kevlar) 인공 섬유",
        "selectionCriteria": "작업 환경, 화학약품 접촉 가능성, 착용 상태 업무 수행 가능 여부 고려",
        "restriction": "드릴링 장비 및 회전 부품 기기에서 사용 금지"
      },
      "sourceSection": "6.5",
      "relatedSR": null
    },
    {
      "identifier": "ES-M10-002",
