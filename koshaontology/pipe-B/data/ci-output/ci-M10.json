  "checklistItems": [
    {
      "identifier": "CI-M10-001",
      "text": "부상 발생유형 파악과 방지 대책을 제공하여야 한다.",
      "guideContext": "날카로운 모서리의 수작업 위험요인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험요인 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-002",
      "text": "이들 작업 관행을 철저히 검토하여 위험성의 수준을 파악해야 한다.",
      "guideContext": "위험성 평가가 특히 필요한 작업 (법령 근거 미확인)",
      "additionalDetail": "창고 작업, 공구 취급 작업, 프레스·전단기·강소재 작업라인, 용접작업 등 대상",
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-003",
      "text": "어떤 작업자들이 얼마 동안 위험에 처해있는지, 또한 작업의 숙련도 등 개인별 능력의 차이가 위험성에 영향을 미치는지 검토해야 한다.",
      "guideContext": "날카로운 모서리 수작업 위험성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-004",
      "text": "고려해야 변수로는 날카로운 모서리가 너무 뜨겁거나 차가운지 여부, 취급되는 물체의 무게, 신체의 어떤 부위가 가장 큰 위험에 노출되는지 등이다. 단순히 손만 위험한 것인지, 아니면 하체도 위험에 처해있는지 검토해야 한다. 또한, 환경 조건도 염두에 두어야 한다.",
      "guideContext": "날카로운 모서리 수작업 위험성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-005",
      "text": "부상의 위험이 있는 것으로 판단되는 경우, 적절한 안전 조치가 취해져야 한다.",
      "guideContext": "날카로운 모서리 수작업 안전 조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-006",
      "text": "장갑 사용은 최후의 수단으로만 고려되어야 한다.",
      "guideContext": "날카로운 모서리 수작업 안전 조치",
      "additionalDetail": "위험원 제거, 설계 변경, 덮개 등 공학적 대책을 우선 적용 후 장갑 사용",
      "workProcessPhase": "안전 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-007",
      "text": "날카로운 물품의 운송이 빈번할 경우에는 컨베이어 벨트를 설치하거나 프로세스를 자동화시킬 수 있다.",
      "guideContext": "날카로운 모서리 물품의 직접적인 취급 배제",
      "additionalDetail": null,
      "workProcessPhase": "취급 배제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-008",
      "text": "스크랩(Scrap)은 삽으로 옮기며, 부스러기(Swarf)는 공구나 브러쉬를 사용한다.",
      "guideContext": "날카로운 모서리 물품의 직접적인 취급 배제",
      "additionalDetail": null,
      "workProcessPhase": "취급 배제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-009",
      "text": "날카로운 모서리를 최소화하도록 프레스 공구를 설계할 수도 있다.",
      "guideContext": "설계를 통해 날카로운 모서리 제거",
      "additionalDetail": null,
      "workProcessPhase": "설계 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-010",
      "text": "공급업체에게 날카로운 모서리가 제거된 상태로 자재를 공급할 것을 요청할 수 있다.",
      "guideContext": "설계를 통해 날카로운 모서리 제거",
      "additionalDetail": null,
      "workProcessPhase": "설계 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-011",
      "text": "정기적으로 취급되는 물품의 경우 (특히 소형 물품) 날카로운 모서리에 패딩 또는 포장을 씌운다.",
      "guideContext": "날카로운 모서리에 덮개를 씌우거나 기타 방식으로 보호",
      "additionalDetail": null,
      "workProcessPhase": "모서리 보호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-012",
      "text": "기계 작업 시 손으로 물품을 잡는 대신 지그나 홀더를 사용한다.",
      "guideContext": "날카로운 모서리에 덮개를 씌우거나 기타 방식으로 보호",
      "additionalDetail": null,
      "workProcessPhase": "모서리 보호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-013",
      "text": "기름 또는 기타 액체를 담은 통의 경우 모서리에 커버를 씌워서 이동한다.",
      "guideContext": "날카로운 모서리에 덮개를 씌우거나 기타 방식으로 보호",
      "additionalDetail": null,
      "workProcessPhase": "모서리 보호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-014",
      "text": "개인 보호구는 작업의 성격, 작업량, 작업 환경 및 사용하는 작업자 범위 등을 고려하여 상황에 적합한 것을 사용한다.",
      "guideContext": "개인 보호구 사용",
      "additionalDetail": null,
      "workProcessPhase": "개인 보호구 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-015",
      "text": "다양한 종류의 장갑을 이용할 수 있는데, 작업 환경에 가장 적절한 것을 선정해야 한다. 그리고 작업을 하는 여러 작업자들을 고려하여 다양한 사이즈의 장갑을 구비해야 한다.",
      "guideContext": "개인 보호구 사용 (법령 근거 미확인)",
      "additionalDetail": "화학약품 접촉 가능성 시 장갑의 화학약품 내성 확인, 장갑 착용 상태 업무 수행 가능 여부 확인",
      "workProcessPhase": "개인 보호구 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-016",
      "text": "장갑은 드릴링 장비 및 기타 회전 부품을 가진 기기에서는 자칫 말려들어가기 쉬운 위험이 있다는 사실을 잊지 말아야 한다.",
      "guideContext": "개인 보호구 사용 (법령 근거 미확인)",
      "additionalDetail": "회전 기기 작업 시 장갑 착용 금지 또는 주의",
      "workProcessPhase": "개인 보호구 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-017",
      "text": "개인 보호구는 정기적으로 유지보수하며 교체해야 한다. 장갑의 내부는 청결하게 유지하며, 찢김이나 자극을 유발할 수 있는 부스러기 또는 물질이 없도록 한다.",
      "guideContext": "개인 보호구 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인 보호구 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-018",
      "text": "적절한 안전조치가 될 수 있도록 전 작업자들에게 교육 및 훈련을 실시하여야 한다.",
      "guideContext": "교육 및 감독 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-019",
      "text": "기기의 청소 및 유지보수 작업 시 날카로운 물품이체나 부스러기와 접촉할 가능성이 있다면 체계적인 작업 시스템을 세워야 한다.",
      "guideContext": "교육 및 감독 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-020",
      "text": "위험성 평가 결과, 장갑 및 기타 안전 조치의 필요가 파악되는 경우, 이들이 반드시 실행되도록 한다.",
      "guideContext": "교육 및 감독 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M10-021",
      "text": "관리자 및 감독자는 필요시 개인 보호구를 사용할 것을 장려하고 강제하도록 적극적인 노력을 실시하여야 한다.",
      "guideContext": "교육 및 감독 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    }
  ],
  "domainTerms": [
