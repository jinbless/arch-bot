  "checklistItems": [
    {
      "identifier": "CI-H45-001",
      "text": "사업주는 특수건강진단기관 담당자와 의사소통을 통해 받은 특수건강진단 유해요인 등을 명시한 '특수건강진단 요청서'(<별지 1>)를 작성해 특수건강진단기관에 제공한다.",
      "guideContext": "특수건강진단 사전조사 (법령 근거 미확인)",
      "additionalDetail": "특수건강진단기관은 사업주가 제출한 특수건강진단 요청 서류를 받아 특수건강진단 대상자 및 유해인자 등이 명시된 '특수건강진단 제안서(실시계획서)'를 작성하여 사업주에게 전달한다.",
      "workProcessPhase": "특수건강진단 요청서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H45-002",
      "text": "사업장으로부터 특수건강진단을 의뢰받았을 때에는 특수건강진단기관의 담당자는 특수건강진단 대상 유해인자(산안법 시행규칙 별표 22)를 근거로 사업주가 대상자 명단과 사업장에 대한 기본적인 정보를 작성하여 제출하도록 안내한다(<별지 1>).",
      "guideContext": "특수건강진단 사전조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "특수건강진단 의뢰 접수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H45-003",
      "text": "특수건강진단기관의 담당자는 사업장이 제출한 대상자를 유해인자별로 선정하기 위하여 최근 2회분의 작업환경측정 결과표, 지난해 특수건강진단 결과표, 물질안전보건자료(MSDS) 또는 해당 화학물질의 성분 목록이 기록된 자료, 인사기록자료, 필요시 위험성평가보고서, 안전보건진단보고서, 화학물질 사용대장 등의 자료를 요청한다.",
      "guideContext": "특수건강진단 사전조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전조사 자료 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H45-004",
      "text": "사업주는 건강검진기관 담당자와 의사소통을 통해 생산 공정 혹은 취급 과정에서 노출될 수 있는 유해요인을 파악하여, 근로자 개인별로 해당 부서/공정, 단위작업, 특수건강진단 유해요인 등을 명시한 명단을 작성해 특수건강진단기관에 제공한다(<별지 1>).",
      "guideContext": "특수건강진단 사전조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "대상자 명단 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H45-005",
      "text": "사업주는 특수건강진단기관이 요청할 경우, 대상자 명단의 적절성 확인에 필요한 최근 2회분의 작업환경측정 결과보고서, 지난해 특수건강진단(사후관리)자료, 사업장의 물질안전보건자료, 인사기록 자료(부서, 근무배치표, 근무시간 및 휴게시간 등)를 요청할 경우 해당 자료를 제공한다.",
      "guideContext": "특수건강진단 사전조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전조사 자료 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H45-006",
      "text": "사업주는 특수건강진단기관이 제출한 '특수건강진단 제안서(실시계획서)'(<별지 2>)를 확인하고 이견이 없을 경우 특수건강진단을 시행한다.",
      "guideContext": "특수건강진단 사전조사 (법령 근거 미확인)",
