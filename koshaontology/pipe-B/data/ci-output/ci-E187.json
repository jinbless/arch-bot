  "checklistItems": [
    {
      "identifier": "CI-E187-001",
      "text": "교정을 실시한 가스와 다른 가스감지가 요구되는 경우에는 대상이 되는 가스로 가스감지기를 다시 교정하여야 한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용 (법령 근거 미확인)",
      "additionalDetail": "가스 감지기는 특정 가스 또는 인화성 가스·증기의 혼합물을 대상으로 설계 및 교정되어 있으므로 다른 가스에 정확하게 응답하지 않을 수 있음",
      "workProcessPhase": "가스감지기 교정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-002",
      "text": "불활성 가스가 측정 공간(예를 들어, 용기의 내부)에 존재할 우려가 있는 경우는 100 vol%까지 가스농도를 읽을 수 있는 가스감지기((4)참조)를 사용하거나, 또는 측정 공간의 산소농도를 별도로 확인하여야 한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용 (법령 근거 미확인)",
      "additionalDetail": "접촉연소식 가스 감지기는 불활성 가스 존재 또는 산소 부족 상태에서 잘못된 결과를 표시할 우려가 있음",
      "workProcessPhase": "가스농도 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-003",
      "text": "가스감지기의 사용자는 그 사용법 및 한계에 대한 교육을 받는다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": null,
      "workProcessPhase": "가스감지기 운용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-004",
      "text": "항상 제조자의 사용 설명서를 읽고 이에 따라야 한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가스감지기 운용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-005",
      "text": "가스 감지기는 정기적으로 보수를 시행함과 동시에 그 기록을 보관한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": null,
      "workProcessPhase": "가스감지기 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-006",
      "text": "가스 감지기가 고장상태의 경우 방치하는 일이 없도록 정기적인 확인이 필요하다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": null,
      "workProcessPhase": "가스감지기 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-007",
      "text": "현장에서 사용 중에 가스 감지기의 반응에 의문이 생긴 경우, 측정 장소의 환경을 위험한 것으로 간주한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": null,
      "workProcessPhase": "가스농도 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-008",
      "text": "유기납 환경에서 사용하는 경우에는 활성탄 필터 또는 고온의 필라멘트를 넣는 등 특별한 기기를 사용한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": "접촉연소식 가스감지기의 소자 촉매부가 주변 물질에 의해 피독이 발생할 수 있으므로 특수 환경에서는 대응 기기가 필요",
      "workProcessPhase": "가스감지기 운용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-009",
      "text": "가스감지기의 사용 직전, 직후에는 기준 샘플 가스를 이용하여 가스감지기의 교정을 자주 하는 것이다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": "피독에 대한 필요 대책으로서 교정 빈도를 높임",
      "workProcessPhase": "가스감지기 교정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-010",
      "text": "밀폐된 공간 속 또는 그 입구에서 가스를 감지하면, 경보가 울리고, 보호되지 않은 기기는 차단 등의 적절한 조치를 하여야 한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": "가스터빈 설비 등 내부에 가스누출원을 수반하는 용기에 해당",
      "workProcessPhase": "가스 감지 시 비상조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-E187-011",
      "text": "제1류 위험물질의 장소 또는 제2류 위험물질의 장소는 그 환기시스템의 인입부에서 가스감지기에 의해 감시한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": null,
      "workProcessPhase": "가스감지 센서 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-012",
      "text": "가스터빈 설비 등 내부에 가스누출원을 수반하는 용기는 용기 안(환기 출구가 바람직하다.)에 가스감지기를 설치한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": null,
      "workProcessPhase": "가스감지 센서 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-013",
      "text": "센서 배치 시에는 누출 가스가 공기보다 가벼운지 무거운지(즉 누출 가스의 체류 높이)를 고려한 적정한 높이에 가스 감지기를 배치한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용",
      "additionalDetail": null,
      "workProcessPhase": "가스감지 센서 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-014",
      "text": "물리적 손상 및 과도한 진동에서도 가스 감지기를 보호할 수 있어야 한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용 (법령 근거 미확인)",
      "additionalDetail": "이상 검출에 필수적인 요소",
      "workProcessPhase": "가스감지 센서 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E187-015",
      "text": "정치형 가스감지기의 신뢰성을 유지하기 위해서는 정기점검 및 공급자의 권장 기준 가스를 이용하여 정확하고 올바른 확인을 세밀히 해나가야 한다.",
      "guideContext": "폭발위험장소에서의 가스감지기 사용 (법령 근거 미확인)",
      "additionalDetail": "정치형 가스감지 센서는 장기간 가스농도를 감지하지 못하는 경우가 있어 신뢰성 확인이 중요",
      "workProcessPhase": "정치형 가스감지기 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E187-001",
      "term": "폭발위험장소",
      "definition": "전기설비를 제조·설치·사용함에 있어 특별한 주의를 요구하는 정도의 폭발성 가스분위기가 조성되거나 조성될 우려가 있는 장소를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "DT-E187-002",
      "term": "누출원",
      "definition": "폭발성 가스분위기를 조성할 수 있는 인화성 가스, 증기, 미스트 또는 액체가 대기 중으로 누출될 우려가 있는 지점 또는 위치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E187-003",
      "term": "인화성 가스",
      "definition": "산업안전보건법 시행령 별표 13에서 정하는 바에 따라 인화한계 농도의 최저한도가 13 % 이하 또는 최고한도와 최저한도의 차가 12 % 이상인 것으로서 표준압력(101.3 ㎪) 하의 20 ℃에서 가스 상태인 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E187-004",
      "term": "인화하한값/인화상한값",
      "definition": "공기 중에서 인화성 가스, 증기 또는 미스트의 농도가 이 값 미만(LFL)/초과(UFL)에서는 폭발성 가스분위기가 조성되지 않는 한곗값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E187-005",
      "term": "가스누출감지기",
      "definition": "인화성 물질의 누출을 감지하여 그 농도를 지시하거나, 미리 설정해 놓은 농도에서 자동으로 경보가 울리도록 하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E187-006",
      "term": "인터록",
      "definition": "기기장치, 설비 및 공정에서 정상적인 운전조건이 만족되지 못하면 자동적으로 이들의 동작을 멈추게 하는 제어장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
