  "domainTerms": [
    {
      "identifier": "DT-M27-001",
      "term": "방호(Safeguarding)",
      "definition": "설계에 의해 적절히 제거되지 않거나 효과적으로 제한할 수 없는 위험요소로부터 작업자를 보호하기 위해 특정한 기계적인 방법을 이용한 안전조치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M27-002",
      "term": "비상정지(Emergency stop)",
      "definition": "위험한 공정 또는 동작을 정지하기 위해 장치의 부분 위험전원을 차단하기 위한 비상조작을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M27-003",
      "term": "가동유지(Hold to run)",
      "definition": "수동으로 버튼을 누를 때에만 기계가 작동되고 버튼을 놓으면 자동으로 정지하는 제어방식을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M27-004",
      "term": "인터록(Interlock)",
      "definition": "기계식, 전기식 또는 다른 방식의 장치나 시스템으로 특정 기계 구성요소 작동을 특정 조건에서 방지 또는 중단하는 것을 목적으로 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M27-005",
      "term": "고정식 가드(Fixed guard)",
      "definition": "가드가 특정위치에 용접 등으로 영구적으로 고정되거나 고정장치 (스크류, 너트 등)로 부착된 구조로서, 공구를 사용하지 아니하고는 가드의 제거 또는 개방이 불가능한 구조의 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M27-006",
      "term": "작업장(Work place)",
      "definition": "주어진 작업자에 대하여 작업 환경으로 둘러싸인 작업공간내의 작업장비들의 조합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M27-007",
      "term": "런다운(Rundown)",
      "definition": "스위치를 끈 후 정지까지의 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
