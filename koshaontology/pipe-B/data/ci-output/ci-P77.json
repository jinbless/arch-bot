  "checklistItems": [
    {
      "identifier": "CI-P77-001",
      "text": "원격차단밸브는 안전기준에 적합한 내화재성을 가지고 있어야 한다.",
      "guideContext": "원격차단밸브 일반사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P77-002",
      "text": "원격차단밸브를 설치하기 전에 취하여야 할 단계적 안전조치는 다음과 같다. (가) 위험물질을 보다 위험성이 적은 물질로 대체 (나) 공정지역 및 탱크에서 위험물질의 저장량을 줄임 (다) 설비에 대한 예방정비, 검사 및 테스트를 철저히 함으로써 저장물질의 손실방지 (라) 방유제 등 완화 수단",
      "guideContext": "원격차단밸브 설치 전 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "원격차단밸브 설치 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P77-003",
      "text": "신규설비를 설계할 경우는 처음부터 원격차단밸브의 설치여부를 검토하여야 한다.",
      "guideContext": "원격차단밸브 선정기준",
      "additionalDetail": null,
      "workProcessPhase": "설비 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-004",
      "text": "기존설비는 다른 방법에 의해 '위험수준을 합리적으로 실용적인 수준으로 낮출 수 있는'(As low as reasonably practical, ALARP) 경우, 다시 말하여 원격차단밸브의 설치가 현실적으로 실용적이지 않다는 것을 입증할 수 있는 경우를 제외하고는 일단 설치여부를 검토하여야 한다.",
      "guideContext": "원격차단밸브 선정기준",
      "additionalDetail": null,
      "workProcessPhase": "기존설비 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-005",
      "text": "적절한 시간 내에 타이트하게 잠글 수 있어야 한다.",
      "guideContext": "원격차단밸브 작동 요구사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-006",
      "text": "화재 또는 폭발 등 외부위험에서도 타이트한 상태를 계속적으로 유지할 수 있어야 한다.",
      "guideContext": "원격차단밸브 작동 요구사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001",
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-007",
      "text": "조작버튼은 작업자가 접근하기 용이하고, 안전한 곳에 위치하여야 한다.",
      "guideContext": "원격차단밸브 수동작동 조작버튼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밸브 수동작동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-008",
      "text": "조작버튼은 라벨링(Labelling) 표시 등 식별이 용이하여야 한다.",
      "guideContext": "원격차단밸브 수동작동 조작버튼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밸브 수동작동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-009",
      "text": "수동작동이 타당성을 가지기 위해서는 적절한 운전지침을 마련하여야 한다.",
      "guideContext": "원격차단밸브 수동작동 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밸브 수동작동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-010",
      "text": "비상탈출경로 등을 설치하여 비상사태에서 수동작동을 백업할 수 있어야 한다.",
      "guideContext": "원격차단밸브 수동작동 비상대비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밸브 수동작동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-011",
      "text": "기계적 스프링이나 가압유체 저장 등 파워를 공급하는 부분이 실패하는 경우라도 그 기능을 지속적으로 수행할 수 있어야 한다.",
      "guideContext": "밸브 작동장치(Actuator) 요구사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-012",
      "text": "밸브 작동장치의 설계는 안전 요구사항과 시스템의 특성에 부합하여야 한다.",
      "guideContext": "밸브 작동장치(Actuator) 설계",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-013",
      "text": "밸브 작동장치는 다음 사항을 고려하여 올바른 사이즈를 결정하여야 한다. (가) 조립체의 정력학적 및 동역학적 힘 (나) 이 힘을 프로세스에 적용시키는 효과 (다) 시스템에서 작동빈도 (라) 밸브 작동장치의 작동에 필요한 공기 또는 유압의 최대 및 최소범위",
      "guideContext": "밸브 작동장치(Actuator) 사이즈 결정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-014",
      "text": "밸브 작동장치와 밸브 몸체가 서로 다른 제작업자로부터 공급되는 경우 안전 요구사항을 포함하여 시스템의 완벽성에 대한 책임소재를 분명히 하여야 한다.",
      "guideContext": "밸브 작동장치(Actuator) 공급 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-015",
      "text": "유틸리티의 손실 등으로 최초의 셧다운(Shut-down)후 차단밸브를 다시 열 수 있는 능력은 안전상 매우 중요하므로, 기동파워의 백업을 마련하여야 한다.",
      "guideContext": "페일 모드(Fail mode) 안전조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-P77-016",
      "text": "완벽하게 타이트한 차단이 이루어질 수 있어야 한다.",
      "guideContext": "이중기능차단밸브 사용 시 요구사항",
      "additionalDetail": "일반적으로 공정제어용 밸브는 미세한 여닫기 동작을 취할 수 있도록 설계되어 있으므로, 타이트한 밀봉이 이루어지지 않을 수 있다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-017",
      "text": "공정제어와 비상차단의 기능은 별개로 유지하여야 한다.",
      "guideContext": "이중기능차단밸브 운영",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P77-018",
      "text": "신뢰성이 낮을수록 밸브의 검사와 테스트는 보다 자주 실시하여야 한다.",
      "guideContext": "원격차단밸브 정비, 검사 및 테스트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 및 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-019",
      "text": "위험성 평가결과와 원격차단밸브의 설치 여부에 대한 의사결정은 철저하게 문서화하여야 한다.",
      "guideContext": "평가결과 기록 (법령 근거 미확인)",
      "additionalDetail": "문서의 보존기간은 최소 10년이다.",
      "workProcessPhase": "평가결과 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "부록 1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-020",
      "text": "시간의 경과, 국부적인 환경의 변화, 기술의 진보 등은 평가결과를 변경시킬 수 있으므로, 최소한 5년 마다 위험성 평가를 다시 하여야 한다.",
      "guideContext": "평가결과의 주기적 검토 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "평가결과 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록 1-5",
      "basedOn": null
    },
    {
      "identifier": "CI-P77-021",
      "text": "인화성과 독성을 동시에 가진 물질의 경우 선택의 기준은 각각의 위험성을 독립적으로 평가하여 적용하여야 한다.",
      "guideContext": "잠재위험 확인 시 복합위험물질 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잠재위험 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록 1-1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P77-001",
      "term": "원격차단밸브",
      "definition": "위험물질을 함유하고 있는 시스템에서 누출사고가 발생하는 경우 설비를 신속하게 차단하는 것을 주목적으로 하는 밸브를 말하며, 밸브의 조작은 밸브 자체로부터 떨어진 지점에서 이루어진다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "DT-P77-002",
      "term": "이중기능차단밸브",
      "definition": "공정제어의 기능과 함께 비상차단 등의 기능을 가진 밸브를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P77-003",
      "term": "과잉유량밸브",
      "definition": "정상상태에서는 항상 열려 있지만 유량이 어느 한계를 초과하면 자동으로 닫히도록 설계되어 있는 밸브를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P77-01",
      "processOrder": 1,
      "processName": "잠재위험 확인",
      "safetyMeasures": "물질의 성질에 관한 자료를 수집하고 활용한다(독성, 인화성). 봉쇄 실패(LOC)를 일으킬 수 있는 초기사건을 확인한다. 자연적 사건(홍수, 지진)과 인적 사건(자동차충돌, 운전실수, 정비불량)을 구분하여 확인한다.",
      "requiredPPE": null,
      "sourceSection": "부록 1-1",
