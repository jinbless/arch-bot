  "checklistItems": [
    {
      "identifier": "CI-P3-001",
      "text": "소형탱크 또는 저장용기의 내용물을 비웠다고 할지라도 용기 내부에 남아있는 액체 또는 고체 잔유물에서 인화성 증기가 추가로 방출될 수 있으므로, 점화원을 발생시킬 수 있는 위험한 작업을 하기 전에 이들 잔유물을 제거하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-002",
      "text": "소형탱크 또는 저장용기에 다른 물질을 주입하기 전에, 기존의 내용물에 의한 오염 등을 예방하기 위해 잔유물을 내부에서 제거하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-003",
      "text": "저장용기의 사용목적, 저장될 신규 물질의 화학적·물리적 특성 및 알고 있거나 의심스러운 오염 물질을 고려하여 세정 절차를 선택하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-004",
      "text": "인화성 액체 또는 가스를 포함하고 있는 탱크 또는 용기를 세정하는 경우에는 세정 작업 중 일어날 수 있는 화재 및 폭발의 위험을 이해하고 있는 사람이 감독해야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-005",
      "text": "작업원은 필요한 작업을 안전하게 수행할 수 있도록 충분한 기술을 갖고 있어야 하며, 탱크 또는 용기 안와 내용물의 화재·폭발 특성을 사전에 파악해야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-006",
      "text": "압력을 받고 있는 탱크는 대기압으로 낮춘 후, 탱크 또는 용기의 내용물을 안전한 장소로 배출시켜야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-007",
      "text": "세정 작업을 시작하기 전에 니트로셀룰로오스, 피록실린용액, 질산염, 염소산염, 과염소산염, 과산화물 등은 특별한 세정작업 절차를 충분히 숙지하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-008",
      "text": "반응성이 높은 불안정한 물질을 저장하고 있는 탱크 또는 용기는 반드시 안전한 퍼지 절차를 위한 안전작업절차를 확보한 후 세정하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-009",
      "text": "6항에 따른 세정 절차를 세우고, 탱크 또는 용기에 세정작업을 위해 적합한 안전한 분위기를 유지하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-010",
      "text": "세정 후에 탱크 또는 용기 내부를 점검할 때에는 특별히 주의하여야 한다. 폭발위험장소에서 사용 가능한 방폭성능의 전등을 사용하거나, 용기 안으로 불빛을 반사하는 거울을 달아 용기 내부를 점검하여야 한다.",
      "guideContext": "소형탱크 세정작업",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P3-011",
      "text": "탱크 또는 용기 부근에서 인화성 증기가 없다는 것이 확인될 때까지 세정하고 있는 탱크 또는 용기 부근에 점화원이 될 수 있는 설비를 두어서는 안 된다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-012",
      "text": "탱크 또는 용기의 내부, 위 또는 그 근처에서 위험한 작업을 하기에 안전한 상태임을 확인하기 위해서는 가연성가스 농도측정기를 사용하여, 다음 내용을 포함하여 인화성 가스의 농도를 수시로 확인하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": "개조 또는 수리 작업을 시작하기 전, 용접·절단 또는 가열 작동을 시작하기 직전과 직후",
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-013",
      "text": "인화성 증기가 인화한계 농도 하한의 10 %를 초과하면 작업을 즉시 중단하고, 증기 방출설비를 설치하여 안전하게 제거하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-014",
      "text": "세정 작업은 개방된 상태에서 실시하여야 한다. 만일 실내에서 세정작업이 이루어져야 하는 경우에는 인화성 증기가 실내에 축적되지 않도록 충분히 퍼지하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-015",
      "text": "세정 또는 배기작동을 하기 전에 탱크 또는 용기 주변의 점화원을 차단 또는 제거해야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-016",
      "text": "근로자가 독성이나 부식성의 증기 또는 가스에 노출되지 않도록 적절한 절차를 밟아야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-017",
      "text": "탱크 또는 용기 내의 모든 내용물은 완전히 비워야 한다. 이 때 내부 파이프, 트랩 및 연결송수관에서도 액체 또는 가스를 모두 제거하여야 한다. 플러싱(Flushing)이 필요할 경우, 적합한 세정액을 선택하여 사용한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-018",
      "text": "세정작업 전에 탱크 또는 용기에 설치된 연결부와 모든 파이프는 차단시키고, 플러그는 뽑거나 폐쇄시켜야 한다. 밸브를 통해 물질이 샐 수 있으므로 이중 밸브 또는 맹관을 설치하여 차단하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-019",
      "text": "세정과 안전조치 절차의 결과로서 발생한 모든 액체, 고체 잔유물 및 증기 등을 안전하게 처리하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 전 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-020",
      "text": "용접 등 화기작업을 위해서는 완전히 물로 채운 탱크 또는 용기에서 화기 작업을 실시해야 한다. 이 경우 물을 채울 때 용기내부에 증기 공간이 생기지 않도록 용기의 위치를 적절히 조정하여 인화성 증기가 배출될 수 있도록 하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "물 퍼지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-021",
      "text": "공기를 퍼지용 가스로 사용하여 인화성 가스를 제거할 때에는 환기를 연속적으로 실시하여 안전한 공기를 유지할 수 있도록 하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기 퍼지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-022",
      "text": "충분한 크기의 개구부를 이용할 수 있는 탱크 또는 용기는 공기가 한쪽 개구부로 들어가서 다른 쪽 개구부로 빠져나올 수 있도록 퍼지하고 점화원이 없는 공기 이송장치를 부착해야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기 퍼지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-023",
      "text": "공기 이송장치를 개구부에 설치할 수 없는 곳에는 탱크 또는 용기를 통해 순환하고 밖으로 빠져나갈 수 있도록 공기를 흡입시킴으로써 퍼지하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기 퍼지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-024",
      "text": "안전한 분위기가 형성되기 전에 탱크 또는 용기 내부에 있는 공기 속에 인화성증기의 농도가 연소범위(LFL)를 형성할 수 있으므로 그 근처에서 모든 점화원을 제거하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기 퍼지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-025",
      "text": "공기 이송장치와 세정되고 있는 탱크 사이를 효과적으로 본딩한다.",
      "guideContext": "소형탱크 세정작업",
      "additionalDetail": "정전기에 의한 화재·폭발 방지를 위한 본딩 조치",
      "workProcessPhase": "공기 퍼지",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P3-026",
      "text": "연소범위를 형성하는 위험을 최소화하기 위해 탱크를 먼저 불활성 가스로 퍼지한 후 공기로 환기시켜야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불활성 가스 및 스팀 퍼지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-027",
      "text": "탱크에 스팀을 적절히 공급함으로써 인화성 증기를 퍼지 할 수 있어야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불활성 가스 및 스팀 퍼지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-028",
      "text": "작업자는 사용하고 있는 불활성 가스의 사용한계와 특징을 충분히 인지하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-029",
      "text": "산소농도는 불활성화 작업으로 실질적으로 0 %로 유지시키는 것이 좋다.",
      "guideContext": "소형탱크 세정작업",
      "additionalDetail": null,
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-030",
      "text": "불활성화를 감지하기 위한 적정 장비를 갖추어야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-031",
      "text": "불활성 가스는 탱크의 최하부까지 연장한 파이프나 호스를 사용하여 실질적으로 산소가 남아있지 않도록 탱크 안으로 들여보내야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-032",
      "text": "주입 파이프 또는 호스의 금속 부분은 탱크에 본딩시켜야 한다.",
      "guideContext": "소형탱크 세정작업",
      "additionalDetail": "정전기에 의한 화재·폭발 방지를 위한 본딩 조치",
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P3-033",
      "text": "이산화탄소를 사용할 때, 정전기 발생을 피하도록 저압을 써야 한다. 이산화탄소 소화기를 불활성가스로 대체하여 사용해서는 안 된다.",
      "guideContext": "소형탱크 세정작업",
      "additionalDetail": "정전기에 의한 화재·폭발 방지 조치",
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P3-034",
      "text": "고체 이산화탄소를 사용할 때, 신속하게 기화할 수 있도록 넓은 지역에 골고루 분산시켜야 한다. 고체 이산화탄소는 피부접촉 시 동상에 걸릴 수 있기 때문에 피부에 접촉되지 않도록 주의한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-035",
      "text": "탱크내부가 질소로 불활성화 되었을 경우, 산소 농도를 산소 측정기로 직접 측정하여야 한다. 이산화탄소가 사용되었을 경우 이산화탄소 측정기로 측정된 탱크안의 이산화탄소 농도로부터 산소 농도를 계산할 수 있다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-036",
      "text": "부분적으로 개구부가 있다면 불활성 가스를 흡입할 위험이 있다는 경고 표시를 분명하게 붙여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 내부 불활성화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-037",
      "text": "인화성 증기를 발생시킬 수 있는 액체 또는 고체 잔유물은 두꺼운 스케일이나 녹 뒤에 잔류될 수 있고, 쉽게 탐지되지 못할 수 있으므로, 세정 후 검사를 실시하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-038",
      "text": "세정 후 검사를 통하여 위험한 상태가 존재하고 있음을 확인하였을 때는 위험 작업 시 추가적인 안전조치를 취해야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-039",
      "text": "위험한 작업을 수행하는 동안 적은 양이라도 지속적으로 퍼지용 공기나 불활성 기체를 탱크 안에 주입시켜야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-040",
      "text": "스팀 세정, 화학적 세정 및 고압 물분사는 정전기 전하를 발생시킬 수 있으므로 주의하여야 한다.",
      "guideContext": "소형탱크 세정작업",
      "additionalDetail": "정전기에 의한 화재·폭발 방지 관련",
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P3-041",
      "text": "탱크 전체가 물의 끓는점 근처에서 가열되도록 응축률을 충분히 초과하여 스팀을 공급하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-042",
      "text": "용기의 모든 벽 부분(동판 및 경판)으로부터 잔유물이 증발될 수 있도록 충분히 스팀을 공급하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-043",
      "text": "세정 후 가연성 가스 측정기로 용기 안의 공기농도를 확인할 때는, 수증기가 측정기기로 들어가지 않도록 염화칼슘 또는 기타 건조제를 채운 건조관을 통해 샘플을 수집해야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": "내부건조가 용이하지 않다면, 가스를 측정하기 전에 수증기가 응축될 때까지 탱크를 냉각시키면 된다.",
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-044",
      "text": "화학 세정제를 사용할 경우 작업자의 피부나 눈에 상해를 입지 않도록 보호안경, 장갑, 기타 필수 보호복을 착용하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-045",
      "text": "인화성 증기를 제거하기 위해 환기장치를 두며, 위험한 물질이 들어가지 못하도록 조치하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": "최소한 15분 동안 최대 온도로 스팀을 계속하거나 휘발성 액체, 찌꺼기 또는 슬러지가 탱크 또는 용기의 윗부분에 나타나지 않을 때까지 계속하여야 한다.",
      "workProcessPhase": "잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-046",
      "text": "남아있는 인화성 가스 또는 증기를 흡입하지 않도록 주의하면서 탱크 내부가 깨끗한지 검사하여야 한다. 만일 탱크가 깨끗하지 않다면 세정과정을 반복하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-047",
      "text": "세정 후, 세정 절차가 효과적이었다는 것을 확인하기 위하여 각각의 탱크 내부의 인화성 증기 농도를 측정한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-048",
      "text": "탱크의 환기나 공기 퍼지 시에 인화성 증기의 방출 농도를 환기나 퍼지 작업 중 주기적으로 확인하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-049",
      "text": "환기 작업 시 또는 탱크의 시험 시 인화성 가스나 증기가 감지되면 화기 작업을 하기 전에 이 지침에서 설명한 방법 중 하나로 용기의 안전 조치와 재 세정을 하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-050",
      "text": "가연성 가스 측정기는 교정 및 검정을 마친 것을 사용하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-051",
      "text": "불활성 가스로 탱크 또는 용기를 세정할 때 가연성 가스 측정기는 정확한 측정치를 주지 못하기 때문에 산소 측정기를 사용해야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P3-052",
      "text": "불활성 가스로 퍼지되고 있는 탱크를 모니터링하기 위한 것처럼 산소 농도 시험 시에는 교정 및 검정을 마친 휴대용 산소 측정기를 사용하여야 한다.",
      "guideContext": "소형탱크 세정작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세정 확인절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P3-001",
      "term": "본딩(Bonding)",
      "definition": "2개의 전도체가 각각 전기적으로 격리되어 있는 둘 사이의 전기적 접속(금속 본딩 전선 또는 금속 대 금속 접속)을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-P3-002",
      "term": "인화성 증기(Flammable vapors)",
      "definition": "대기압, 정상온도(20 ℃)에서 기체 상태로 존재하는 물질이 공기, 산소, 기타 산화제와 적정 비율로 혼합되었을 때, 점화되거나 급속히 산화될 수 있는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P3-003",
      "term": "위험한 작업(Hazardous work)",
      "definition": "점화원의 생성과 관련된 작업으로 나화, 절단, 용접, 스파크가 생기는 전기작업, 연삭 작업, 연마작업, 드릴 작업, 대패 작업, 톱질 혹은 기타 마찰 또는 충격으로 인해 뜨거운 금속 스파크나 표면을 만들어낼 수 있는 유사 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P3-004",
      "term": "불활성 가스(Inert gas)",
      "definition": "인화성이 없고, 사용하려는 조건에서 반응성을 갖지 않는 순수한 가스를 말하며, 일반적으로 질소, 헬륨가스를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P3-005",
      "term": "불활성화(Inerting)",
      "definition": "가연성 혼합물에 불활성가스를 주입하여 인화한계 농도 하한을 벗어나도록 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P3-006",
      "term": "인화성 액체(Combustible liquid)",
      "definition": "37.8 ℃(100 ℉)이상에서 밀폐식 인화점을 갖는 액체를 말한다. \"인화성 액체\"라 함은 인화점이 60 ℃ 이하인 액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P3-007",
      "term": "퍼지(Purging)",
      "definition": "인화성가스 또는 증기에 불활성가스를 주입하여 산소 농도를 최소산소농도(MOC) 이하로 낮추는 작업을 통하여 제한된 공간에서 화염이 전파되지 않도록 하는 상태를 말하며 불활성가스로는 질소, 이산화탄소, 수증기 등이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P3-008",
      "term": "불안정(반응성) 액체(Unstable(Reactive) liquid)",
      "definition": "인화성 액체로 격렬하게 중합, 분해, 응축하거나 충격, 압력 또는 특정한 온도에서 자기 반응적인 액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
