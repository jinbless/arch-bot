  "checklistItems": [
    {
      "identifier": "CI-AG2-001",
      "text": "B구역은 미끄럼방지 조치와 함께 경사로를 설치하여야 한다.",
      "guideContext": "경사각에 따른 통로 선정",
      "additionalDetail": "A구역은 경사로 설치 권장 구역, B구역은 미끄럼방지 조치 필수",
      "workProcessPhase": "통로 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-002",
      "text": "두 지점 간에의 통로를 설치할 때는 다음 사항을 고려하여 선택하여야 한다. (가) 이용자가 가능한 최소의 노력으로 이동할 수 있도록 한다. (나) 필요에 따라 설비나 공구를 운반하기 위한 통로 또는 비상통로 등을 감안한다. (다) 이용자의 수와 이동방법을 고려한다. (라) 지면과 이동 바닥의 높이의 차이를 고려한다. (마) 가용 공간을 고려한다. (바) 설치구간의 구조를 고려한다.",
      "guideContext": "통로 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 설치 검토",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-003",
      "text": "다음의 경우 통로를 반드시 설치하여야 한다. (가) 인력에 의한 재료를 이송하고 하역할 때 (나) 작업자가 이동 중에 연속적인 관찰과 조작이 필요할 때 (다) 작업자가 이동하면서 제어가 필요할 때",
      "guideContext": "통로 설치 의무 조건",
      "additionalDetail": null,
      "workProcessPhase": "통로 설치 검토",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-004",
      "text": "통로를 설치할 때는 이용 빈도를 고려하여야 한다.",
      "guideContext": "통로 설치 시 검토사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 설치 검토",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-005",
      "text": "비상 탈출구로서의 사다리는 동시에 많은 사람이 이용할 수 없기 때문에 사다리를 전용 비상 탈출구로는 사용하지 말아야 하며 별도의 통로를 설치하여 한다.",
      "guideContext": "비상 탈출구 통로 요건",
      "additionalDetail": null,
      "workProcessPhase": "통로 설치 검토",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-006",
      "text": "사람이 통로에서 작업, 설치, 검사, 보수할 때에 위험으로부터 보호 되어야 한다.",
      "guideContext": "통로 일반 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-007",
      "text": "접촉 시 사람의 신체에 충격을 줄 수 있는 부분은 안전을 고려하여 충격을 완화할 수 있는 재료 등으로 설계하거나 제작해야 한다.",
      "guideContext": "통로 일반 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-008",
      "text": "고정, 연결, 지지 또는 휨 등의 구성요소는 원래 목적대로 사용할 수 있도록 안전하고 견고하며 안정적이어야 한다.",
      "guideContext": "통로 일반 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-009",
      "text": "모든 통로부분은 기후와 화학 작용으로 인한 영향에 내성을 갖거나 방호조치를 해야 한다.",
      "guideContext": "통로 일반 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-010",
      "text": "모든 통로부분은 내부 및 결합부에 물 등의 액체가 고이지 않도록 해야 한다.",
      "guideContext": "통로 일반 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-011",
      "text": "통로는 미끄럼방지 효과가 가능한 한 오래 지속되는 방법으로 설계·제작하여 사용해야 한다.",
      "guideContext": "통로 일반 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-012",
      "text": "근로자가 통로를 이용할 때 떨어지지 않도록 설치해야 한다.",
      "guideContext": "통로 추락 방지",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-AG2-013",
      "text": "통로에서 또는 통로에 물체가 떨어지지 않도록 방지조치를 해야 한다.",
      "guideContext": "통로 낙하물 방지",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-AG2-014",
      "text": "통로의 진입로는 위험 발생 시에 위험지역을 빨리 벗어날 수 있거나 신속한 조치를 할 수 있는 구조이어야 한다.",
      "guideContext": "통로 비상대피 구조",
      "additionalDetail": null,
      "workProcessPhase": "통로 안전 확보",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-015",
      "text": "물 등의 액체에 의한 위험을 제거하기 위하여 바닥에 배수시설을 하여야 한다.",
      "guideContext": "통로 바닥 위험 제거",
      "additionalDetail": null,
      "workProcessPhase": "통로 바닥 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-016",
      "text": "바닥의 먼지 등 기타 이물질에 의한 위험을 예방하기 위하여 어떤 다른 이물질이 축적되지 않도록 만들어져야 한다.",
      "guideContext": "통로 바닥 위험 제거",
      "additionalDetail": null,
      "workProcessPhase": "통로 바닥 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-017",
      "text": "떨어짐 및 실족 위험을 피하기 위하여, 바닥은 평탄해야 하며 걸려 넘어짐 위험을 예방하기 위해 인접한 바닥면의 높이 차이가 4 mm 이하가 되어야 한다.",
      "guideContext": "통로 바닥 위험 제거",
      "additionalDetail": null,
      "workProcessPhase": "통로 바닥 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-018",
      "text": "바닥의 개구부 구멍은 직경 35 mm 정도의 공이 통과할 수 없어야 한다.",
      "guideContext": "통로 바닥 개구부 방호",
      "additionalDetail": null,
      "workProcessPhase": "통로 바닥 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-019",
      "text": "사람이 항시 있는 장소의 개구부는 특별한 안전조치가 없는 경우 직경 20 mm의 공이 통과할 수 없어야 한다.",
      "guideContext": "통로 바닥 개구부 방호",
      "additionalDetail": null,
      "workProcessPhase": "통로 바닥 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-020",
      "text": "접촉 시 사람의 신체에 충격을 줄 수 있는, 날카로운 모서리 용접부 등이 존재해서는 안 된다.",
      "guideContext": "계단·발판사다리 일반 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-021",
      "text": "발판 끝부분과 계단참의 표면은 마찰력이 있도록 미끄럼 방지조치를 하여야 한다.",
      "guideContext": "계단·발판사다리 일반 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-022",
      "text": "지주, 고정대 및 테두리 등은 충분한 강도를 유지하여야 하며, 사용 중에 안정성이 있어야 한다.",
      "guideContext": "계단·발판사다리 일반 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-023",
      "text": "발판은 통로 폭과 발판깊이의 각 중간지점에서 1,000 mm × 1,000 mm의 면적에 대하여 500 kg(4900 N)의 하중에 견뎌야 한다.(안전율은 4 이상으로 한다)",
      "guideContext": "계단·발판사다리 일반 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-024",
      "text": "발판과 구조물의 처짐량은 \"L/300\" 또는 6 mm를 초과해서는 안 된다.",
      "guideContext": "계단·발판사다리 일반 안전요건",
      "additionalDetail": "L은 지간 길이",
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-025",
      "text": "사용재료는 주위환경에 의해 발생되는 부식에 대해 저항성이 있어야 한다.",
      "guideContext": "계단·발판사다리 일반 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-026",
      "text": "발판의 겹침(r)는 평면상의 발판일 때는 0 이상(r≥0 mm)이어야 하며 판 모양의 발판일 때는 \"r≥10 mm\" 이상이 되어야 한다.",
      "guideContext": "계단·발판사다리 일반 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-027",
      "text": "발판깊이(g)와 답단 높이(h)는 \"600≤g+2h≤660 (mm)\"의 공식에 적합하여야 한다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-028",
      "text": "동일한 계단에서의 답단 높이(h)는 모두 일정해야 한다. 단 이 높이를 일정하게 하는 것이 불가능할 경우에는 출발지점 위치에서 첫 번째 계단에 국한하여 15% 이내에서 그 간격을 줄이거나 늘려도 된다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-029",
      "text": "발판 위 머리공간 높이(e)는 발판 위에서부터 2.3 m 이상이어야 한다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-030",
      "text": "계단 폭(L)은 손잡이나 지주(세로대) 사이에서 측정하여, 1 m 이상으로 하여야 한다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-031",
      "text": "계단에 여러 사람이 동시에 통행하거나 교차되는 경우에는 그 폭은 1.2 m 이상이어야 한다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-032",
      "text": "바닥에서 3 m를 초과하는 계단에 높이 3 m 이내마다 계단참(P)을 설치하여야 한다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-033",
      "text": "계단 중간에 설치하는 계단참은 진행방향으로 길이 1.2 m 이상이 되도록 하여야 한다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-034",
      "text": "최고 상부 발판은 계단참에 접하여야 한다.",
      "guideContext": "계단 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-035",
      "text": "발판사다리의 답단 높이(h)는 250 mm 이내 이어야 한다.",
      "guideContext": "발판사다리 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-AG2-036",
      "text": "발판사다리의 발판깊이(g:계단에서의 발판깊이에 해당)는 80 mm 이상이어야 한다.",
      "guideContext": "발판사다리 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-AG2-037",
      "text": "동일한 발판사다리에서의 답단 높이(h)는 모두 일정해야 한다. 단 이 높이를 일정하게 하는 것이 불가능할 경우에는 출발지점 위치에서 첫 번째 계단에 국한하여 15% 이내에서 그 간격을 줄이거나 늘려도 된다.",
      "guideContext": "발판사다리 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-AG2-038",
      "text": "발판사다리의 발판위의 머리 공간 높이(e)는 2.3 m 이상 이어야 한다.",
      "guideContext": "발판사다리 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-AG2-039",
      "text": "발판사다리의 난간이나 세로 지지대 사이의 통로 폭은 최소한 300 mm 이상이어야 하며, 최대 800 mm 이내이어야 한다.",
      "guideContext": "발판사다리 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-AG2-040",
      "text": "발판사다리의 계단 참(또는 플랫폼)까지의 수직높이(H)는 3 m를 초과할 수 없다.",
      "guideContext": "발판사다리 안전요건",
      "additionalDetail": null,
      "workProcessPhase": "계단·발판사다리 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-AG2-041",
      "text": "근로자가 떨어질 위험성이 있는 곳에는 안전난간을 설치하여야 한다.",
      "guideContext": "안전난간 설치 의무",
      "additionalDetail": "계단참, 작업면, 발판사다리, 통로 등에 적용",
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-042",
      "text": "발끝막이판은 바닥면·발판 또는 경사로의 표면(이하 \"바닥면등\"이라 한다)으로부터 10 cm 이상의 높이를 유지하여야 하고, 발끝막이판의 틈새는 10 mm 이하로 한다.",
      "guideContext": "안전난간 발끝막이판 규격",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-043",
      "text": "상부난간대는 바닥면등으로부터 90 cm 이상 지점에 설치하고, 상부난간대를 120 cm 이하에 설치하는 경우에는 중간난간대는 상부난간대와 바닥면등의 중간에 설치하여야 하며, 120 cm 이상 지점에 설치하는 경우에는 중간난간대를 2단 이상으로 균등하게 설치하고 난간의 상하 간격은 60 cm 이하가 되도록 하여야 한다. 다만, 난간기둥 간의 간격이 25센티미터 이하인 경우에는 중간 난간대를 설치하지 않을 수 있다.",
      "guideContext": "안전난간 상부·중간난간대 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-044",
      "text": "안전난간에는 1개 이상의 중간난간대를 설치하거나 또는 다른 방법의 안전조치를 하여야 한다.",
      "guideContext": "안전난간 중간난간대",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-045",
      "text": "중간난간대 대신에 수직으로 된 지주를 설치할 경우에는 각 지주간의 간격은 180 mm를 초과하여서는 안 된다.",
      "guideContext": "안전난간 수직 지주 대체 기준",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-046",
      "text": "난간기둥은 상부난간대와 중간난간대를 견고하게 떠받칠 수 있도록 적정한 간격을 유지하여야 한다.",
      "guideContext": "안전난간 난간기둥 간격",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-047",
      "text": "연속하지 않은 안전난간의 난간기둥 사이 간격은 120 mm 이하로 설치하고, 간격이 큰 경우 안전난간의 구성요소(상부난간대, 중간난간대, 발끝막이판) 위치와 동일한 구조로 열리거나 닫히는 문을 설치하여야 한다.",
      "guideContext": "안전난간 불연속 구간 방호",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-048",
      "text": "4단 이상이거나 500 mm이상인 계단의 개방된 측면에는 계단참을 포함하여 각 층의 계단 전체에 걸쳐서 1개 이상의 안전난간을 설치하여야 한다.",
      "guideContext": "계단 안전난간 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-049",
      "text": "계단 폭이 1.2 m 이상인 경우와, 모든 발판사다리에는 2개의 안전난간이 있어야 한다.",
      "guideContext": "계단·발판사다리 안전난간 수량",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-050",
      "text": "높이가 500 mm 이상인 작업대나 계단참에는 안전난간을 설치하여야 한다.",
      "guideContext": "작업대·계단참 안전난간",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-AG2-051",
      "text": "계단측면에 공간이 있는 경우에는 폭 200 mm 이상의 측면 보강지주를 설치하여야 한다.",
      "guideContext": "계단 측면 보강",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-052",
      "text": "사업주는 계단 및 계단참을 설치하는 경우 매제곱미터당 500 kg 이상의 하중에 견딜 수 있는 강도를 가진 구조로 설치하여야 하며, 안전율은 4 이상으로 하여야 한다.",
      "guideContext": "계단 강도 기준",
      "additionalDetail": null,
      "workProcessPhase": "강도 검증",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-AG2-053",
      "text": "난간의 변형량을 측정하였을 때에 영구변형이 없이 30 mm 이내 값을 가져야 한다.",
      "guideContext": "난간 변형량 기준",
      "additionalDetail": "최소측면하중 F(min) = 300 N/m × L 적용",
      "workProcessPhase": "강도 검증",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-FALL-002"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-AG2-001",
      "term": "통로(Walkway)",
      "definition": "한 지점으로부터 다른 곳으로 움직이기 위해 사용되는 바닥면으로 본 규정 내에서 통로는 경사로, 계단, 발판사다리, 고정식 사다리로 구분된다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "DT-AG2-002",
      "term": "바닥(Floor)",
      "definition": "통로나 작업대에서 발 또는 신발과 직접 접촉하는 요소를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG2-003",
      "term": "경사로(Ramp)",
      "definition": "0°초과 20°까지의 경사각을 갖는 통로로서 별도의 수평부재가 없이 평탄한 바닥으로 이루어진 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "DT-AG2-004",
      "term": "계단(Stairway)",
      "definition": "20°초과 45°까지의 경사각을 갖는 통로로서 수평부재는 판 모양이나 평면 발판(Step)으로 이루어진 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "DT-AG2-005",
      "term": "발판사다리(Stepladder)",
      "definition": "45°초과 75°까지의 경사각을 갖는 통로로서 수평부재는 판 모양의 발판(Step)으로 이루어진 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "DT-AG2-006",
      "term": "고정식 사다리(Fixed Ladder)",
      "definition": "75°초과, 90°까지의 경사각을 갖는 통로로서 하중을 지탱하는 수평부재는 봉 모양의 디딥대로 구성된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "DT-AG2-007",
      "term": "작업대(Working platform)",
      "definition": "작동, 유지정비, 검사, 보수 등 기계류와 관계된 여러 작업에 사용되는 바닥면을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "DT-AG2-008",
      "term": "미끄럼방지(Slip resistant)",
      "definition": "바닥면의 미끄러움을 줄이기 위한 조치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG2-009",
      "term": "답단 높이(Rise)",
      "definition": "두개의 계단 발판 사이의 수직거리를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG2-010",
      "term": "계단참(Landing)",
      "definition": "계단의 끝이나 중간에 위치한 수평면 지역을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG2-011",
      "term": "발판(Step)",
      "definition": "계단이나 발판사다리를 오르내리기 위해 발 또는 신발이 직접 접촉하는 수평으로된 표면을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG2-012",
      "term": "안전율",
      "definition": "안전의 정도를 표시하는 것으로서 재료의 파괴응력(破壞應力)과 허용응력(許容應力)의 비율을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG2-013",
      "term": "상부난간대(Handrail)",
      "definition": "몸을 지지하기 위해 손으로 잡는 난간의 윗부분의 요소(부재)를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "DT-AG2-014",
      "term": "중간난간대(Kneerail)",
      "definition": "신체가 통과하지 못하도록 손잡이의 파이프 등과 평행하게 위치되는 난간의 요소(부재)를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "DT-AG2-015",
      "term": "난간기둥(Stanchion)",
      "definition": "계단이나, 작업면 등에서 안전 난간의 고정을 위해 다른 요소들(상부난간대, 중간난간대)과 연결된 수직 구조 요소(부재)를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "DT-AG2-016",
      "term": "발끝막이판(Toe-plate)",
      "definition": "물체가 떨어지는 것을 방지하기 위해 안전 난간 하단부의 막힌 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-002"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-AG2-01",
      "processOrder": 1,
      "processName": "통로 위험성 검토",
      "safetyMeasures": "떨어짐, 떨어지는 물체, 넘어짐, 과도한 육체적 피로, 기계류 위험(회전부, 왕복운동부, 방사선, 복사열, 고온, 소음, 독성물질) 등 통로에서 고려해야 할 위험성을 사전에 파악한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "WP-AG2-02",
      "processOrder": 2,
      "processName": "통로 유형 선정",
      "safetyMeasures": "경사각에 따라 경사로(0°~20°), 계단(20°~45°), 발판사다리(45°~75°), 고정식 사다리(75°~90°)를 선정한다. 바닥·지면 직접 이용 통로를 최우선 검토하고, 승강기, 경사로, 계단, 발판사다리 순으로 우선순위를 적용한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "WP-AG2-03",
