  "checklistItems": [
    {
      "identifier": "CI-T27-001",
      "text": "삭정하는 동안 조직이 건조되지 않도록 카세트가 고정액이나 물에 약간 잠긴 상태를 유지한다.",
      "guideContext": "실험동물 조직 삭정 일반 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-002",
      "text": "삭정용 칼은 예리한 것을 사용하여 자를 때 조직에 압력이 가해지지 않도록 한다.",
      "guideContext": "실험동물 조직 삭정 일반 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-003",
      "text": "보호구(보호안경, 수술용 고무장갑, 방독마스크 등)를 반드시 착용한다.",
      "guideContext": "실험동물 조직 삭정 시 포르말린 등 유해물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "삭정 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-T27-004",
      "text": "유해한 고정액(포르말린 용액 등)의 흡입을 방지하기 위해 국소배기 장치가 설치된 곳에서 작업을 한다.",
      "guideContext": "실험동물 조직 삭정 시 포르말린 흡입 방지",
      "additionalDetail": null,
      "workProcessPhase": "삭정 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-T27-005",
      "text": "삭정을 실시하기 전 부검시 작성된 기록지의 내용을 확인하고, 소견이 있을 경우 고정된 장기와 대조하여 확인한다.",
      "guideContext": "부검 소견 확인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부검 소견 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-006",
      "text": "삭정 장기의 종류와 정해진 삭정 부위 외 수정 또는 추가된 소견은 시험계획서의 지시대로 실시한다.",
      "guideContext": "부검 소견 확인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부검 소견 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-007",
      "text": "삭정을 실시하기 전 작업자는 시험계획서에서 요구하는 조직 제작 장기 목록을 확인한다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-008",
      "text": "고정병의 시험번호 및 동물번호가 카세트에 기재된 시험번호, 동물번호와 일치하는지 확인하고 삭정한 장기가 바뀌지 않도록 주의한다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-009",
      "text": "고정병에서 장기들을 꺼내 물에 헹궈 고정액을 씻어낸다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-010",
      "text": "탈회가 필요한 조직(대퇴골, 비강 등)은 탈회 용액에 침지해 조직 내 칼슘을 제거한다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-011",
      "text": "수세된 장기들을 삭정방법표<별표 1> 및 <별표 2>에 따라 삭정하여 카세트에 넣는다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-012",
      "text": "삭정방법표<별표 1> 및 <별표 2>에 정해진 삭정부위 외에 다른 부위에 병변이 있는 경우 지정된 삭정 부위와 병변 부위를 각각 삭정한다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-013",
      "text": "분실이 우려되는 작은 장기는 작은 크기의 카세트나 망사주머니를 이용한다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-014",
      "text": "삭정된 장기가 들어있는 카세트를 2차 고정을 위해 새로운 고정병에 넣는다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-015",
      "text": "삭정이 완료되면 기록지의 삭정란에 삭정일을 기록하고 서명한다.",
      "guideContext": "삭정 실시 순서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 완료",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-016",
      "text": "삭정방법표<별표 1> 및 <별표 2>에 지정된 삭정 부위에 이상 소견이 관찰되었을 때는 이상 소견이 포함되도록 삭정한다.",
      "guideContext": "이상소견 조직 제작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상소견 조직 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-017",
      "text": "삭정방법표<별표 1> 및 <별표 2>에 지정된 삭정 부위가 아닌 부위에서 이상 소견이 관찰되었을 때는 지정된 삭정 부위와 이상 소견이 관찰된 부위 모두를 삭정한다.",
      "guideContext": "이상소견 조직 제작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상소견 조직 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-018",
      "text": "육안적 이상 부위를 삭정할 때는 정상조직과의 연속성을 확인하기 위해 가능한 정상부위와 이상부위가 모두 포함되도록 한다.",
      "guideContext": "이상소견 조직 제작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상소견 조직 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-019",
      "text": "삭정하고 남은 장기는 고정병에 넣어 밀봉한 후 시험번호, 동물번호, 부검일 등을 기재한다.",
      "guideContext": "조직 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-020",
      "text": "밀봉한 후 고정액이 새는 곳이 없는지, 고정액이 부족하지 않은지 등을 살피고 빠진 동물이 없는지 확인한다.",
      "guideContext": "조직 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-021",
      "text": "고정병은 환기 시설이 있는 저장소에서 보관한다.",
      "guideContext": "포르말린 고정액 취급 시 환기 필요",
      "additionalDetail": null,
      "workProcessPhase": "보관",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-T27-022",
      "text": "삭정 장기가 들어있는 카세트는 시험번호를 부착한 고정병에 넣어 이후의 처리까지 환기 시설이 있는 저장소에서 보관한다.",
      "guideContext": "포르말린 고정액 취급 시 환기 필요",
      "additionalDetail": null,
      "workProcessPhase": "보관",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-T27-023",
      "text": "포르말린 고정액이 눈이나 피부에 묻었을 경우에는 속히 다량의 식염수나 물로 충분히 씻어낸다.",
      "guideContext": "포르말린 노출 시 응급처치",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 시 처치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-T27-024",
      "text": "포르말린 가스를 흡입하여 비점막에 통증이 있는 경우에는 코세척을 수회 반복하고, 맑은 공기가 잘 통하는 곳에서 휴식을 취한다. 증상이 심하면 병원을 방문하여 의사의 진찰을 받는다.",
      "guideContext": "포르말린 가스 흡입 시 응급처치",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 시 처치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-T27-025",
      "text": "삭정칼에 의해 상처를 입었을 경우에는 지혈한다. 상처 부위가 큰 경우 즉시 의사에게 보이고 적절한 처치를 받는다.",
      "guideContext": "삭정 작업 중 부상 시 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 시 처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-026",
      "text": "삭정 작업 전후 스트레칭 등을 실시하여 근골격계 부담을 줄이고 삭정 작업 중 손가락, 어깨 등에서 통증이 느껴질 때는 적절한 휴식을 취하여 만성적 질환으로 이어지지 않도록 한다.",
      "guideContext": "삭정 작업 근골격계 부담 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "삭정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-027",
      "text": "삭정한 조직을 분실한 경우, 남아있는 장기를 다시 삭정한다. 남아있는 장기가 없는 경우 기록지에 분실장기명과 사유를 기록한다.",
      "guideContext": "삭정 장기 분실 시 조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 시 처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-028",
      "text": "삭정한 조직이 개체 간에 혼합되었을 경우에는 원래의 조직을 재삭정한다. 재삭정이 불가능한 경우, 기록지에 장기명과 사유를 기록한다.",
      "guideContext": "삭정 장기 혼합 시 조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 시 처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-029",
      "text": "삭정시 고정 장기가 빠져있으면, 부검시 기록지를 확인하여 부검시 적출이 안된건지, 고정 과정 중 분실된 것인지 확인하고 기록지에 장기명과 사유를 기록한다.",
      "guideContext": "삭정 장기 누락 시 조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 시 처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T27-030",
      "text": "위의 내용을 포함하여 시험의 결과에 영향을 미칠 수 있는 어떠한 이상이 발생한 경우 시험책임자에게 보고하고 기록한다.",
      "guideContext": "이상 발생 시 보고 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 시 처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-T27-001",
      "term": "부검(Necropsy)",
      "definition": "사인을 밝히는 목적으로 동물 사체의 내·외부를 조사하는 것으로 장기 등을 채취해 검사하게 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T27-002",
      "term": "고정(Fixation)",
      "definition": "채취된 장기의 사후 변화나 부패를 방지하기 위해 고정액에 침지해 장기 내 미세구조의 변형을 방지하는 것이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T27-003",
      "term": "삭정(Trimming)",
      "definition": "고정액에 고정된 실험동물의 생체 조직을 일정한 크기 및 방향으로 자르는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T27-004",
      "term": "포르말린 용액",
      "definition": "조직의 고정을 위해 일반적으로 사용되는 10% 중성완충포르말린 (10% neutral buffered formalin)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T27-005",
      "term": "시험계획서",
      "definition": "해당 시험에 대한 시험 목적, 시험 방법, 범위 및 실험 계획을 규정하는 문서를 말한다.",
      "sourceSection": "3",
