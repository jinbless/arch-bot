  "checklistItems": [
    {
      "identifier": "CI-A51-001",
      "text": "비소는 발암물질이므로 안전하게 취급하여야 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 시 특별 안전보건 예방조치",
      "additionalDetail": "비소 및 그 무기화합물은 발암물질(특별관리물질)로 분류되며, 취급 시 각별한 주의가 필요하다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-003"
      ]
    },
    {
      "identifier": "CI-A51-002",
      "text": "모든 과염소산 회화작업은 흄후드에서 이루어져야 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 시 특별 안전보건 예방조치",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-A51-003",
      "text": "예방조치 방법으로 작업 중 환기상태 확인, 화학물질 취급시 적절한 보호구를 착용, 화학물질 취급 장소에서 흡연 및 취식 금지 등을 준수하고 초기증상이 나타나면 반드시 관리자에게 보고한다.",
      "guideContext": "비소 건강영향 및 예방조치",
      "additionalDetail": "노출시 주요증상으로는 호흡기 및 피부자극, 지체온 또는 발열, 혈압변화, 정서장애, 푸른빛 피부색 등이 있으며, 지속적인 노출에 의해 식욕부진, 암 등을 유발할 수 있다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-A51-004",
      "text": "작업 중 환기상태 확인",
      "guideContext": "비소 건강영향 및 예방조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-A51-005",
      "text": "화학물질 취급시 적절한 보호구를 착용",
      "guideContext": "비소 건강영향 및 예방조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-A51-006",
      "text": "화학물질 취급 장소에서 흡연 및 취식 금지",
      "guideContext": "비소 건강영향 및 예방조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-A51-007",
      "text": "초기증상이 나타나면 반드시 관리자에게 보고한다.",
      "guideContext": "비소 건강영향 및 예방조치",
      "additionalDetail": "호흡기 및 피부자극, 지체온 또는 발열, 혈압변화, 정서장애, 푸른빛 피부색 등의 초기증상 해당",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-A51-008",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": "분석에 사용하는 시약은 제조회사에서 표시하는 농도함량을 따른다.",
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-009",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 달수 있어야 하며, 화학분석 용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 달 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-010",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등 이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-011",
      "text": "시료채취매체를 이용하여 각 개인시료채취펌프를 보정한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-012",
      "text": "1~3 L/min의 정확한 유량으로 총 30~1,000 L의 공기를 채취하며, 여과지에 채취된 먼지가 총 2 mg을 넘지 않도록 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-013",
      "text": "채취가 끝난 여과지는 밀봉하여 먼지가 떨어지지 않도록 카세트를 바로 세워서 운반한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-014",
      "text": "검량선의 적정성은 제시된 분석기기의 매뉴얼을 참조하거나 상관계수가 0.99이상의 것을 사용하도록 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-015",
      "text": "회수율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": "회수율에 대한 평가는 분석자가 해야 한다. 회수율간의 차이가 크고 변이가 심하여 일정성이 없으면 원인을 찾아 교정하고 다시 실험을 실시해야 한다.",
      "workProcessPhase": "회수율 검정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-016",
      "text": "표준용액의 흡광도 변화가 ±5%를 초과했다면 교정조치를 취하고 검량선을 다시 작성하여 시료를 분석한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-017",
      "text": "모든 유리기구는 사용 전에 질산으로 씻고 증류수로 헹구어 준다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-A51-018",
      "text": "공기 중의 농도를 mg/m³으로 표시했을 때의 m³은 정상상태(NTP, Normal Temperature and Pressure : 25℃, 1기압)의 기체용적을 뜻한다. 따라서 노출기준과 비교 시는 작업환경 측정 시의 온도와 압력을 실측하여 정상상태의 농도로 환산하여야 한다.",
      "guideContext": "비소에 대한 작업환경측정·분석 기술지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A51-001",
      "term": "밀폐",
      "definition": "취급 또는 보관상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A51-002",
      "term": "밀봉",
      "definition": "취급 또는 보관상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A51-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A51-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ±10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A51-005",
      "term": "즉시",
      "definition": "시험조작 중 30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A51-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A51-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A51-008",
      "term": "회수율",
      "definition": "채취한 금속 등의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 여과지에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-A51-01",
      "processOrder": 1,
      "processName": "시료채취",
      "safetyMeasures": "시료채취매체를 이용하여 개인시료채취펌프를 보정한다. 1~3 L/min 유량으로 총 30~1,000 L 공기를 채취하며, 여과지에 채취된 먼지가 총 2 mg을 넘지 않도록 한다. 채취 완료 여과지는 밀봉하여 운반한다. 시료 세트당 2~10개의 현장 공시료를 확보한다.",
      "requiredPPE": [
        "보호구"
      ],
      "sourceSection": "I",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-A51-02",
      "processOrder": 2,
      "processName": "시료 전처리 (회화)",
      "safetyMeasures": "카세트필터 홀더를 열고 시료와 공시료를 깨끗한 비이커에 옮긴다. 회화용액(질산:황산:과염소산=3:1:1) 5 mL를 넣고 시계접시를 덮는다. 용액이 투명해질 때까지 가열판(140℃)에서 가열한다. 과염소산 회화작업은 반드시 흄후드에서 실시한다. 비소는 발암물질이므로 안전하게 취급하여야 한다.",
      "requiredPPE": [
        "보호구",
        "보안경"
      ],
      "sourceSection": "II",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-003"
      ]
    },
    {
      "identifier": "WP-A51-03",
      "processOrder": 3,
      "processName": "검량선 작성 및 정도관리",
      "safetyMeasures": "100 mL 용량플라스크에 황산 4 mL를 넣고 증류수로 희석한다. 분석범위 0.2~0.8 ug As/100 mL에서 표준용액을 제조한다. 표준용액을 공시료 및 시료와 함께 분석한다. 검량선 상관계수 0.99 이상을 확보한다. 표준용액 흡광도 변화 ±5% 초과 시 교정조치 후 검량선을 재작성한다.",
      "requiredPPE": [
        "보호구"
      ],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A51-04",
      "processOrder": 4,
      "processName": "원자흡광도계(AAS) 분석",
      "safetyMeasures": "원자흡광도계 제조사 권고에 따라 기기를 설정한다. Arsine 발생 장치 조건을 설정한다. 전처리한 시료 25 mL 중 5 mL를 Arsine 발생 플라스크에 넣고, 25 mL 증류수와 3 mL 염산을 넣어 섞는다. 수소화붕소나트륨 펠렛 또는 용액을 시료에 넣고, 기체가 불꽃 안에서 붉게 빛나기 시작하도록 한다. 수소 및 아르곤 가스 취급 시 주의한다.",
      "requiredPPE": [
        "보호구"
      ],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A51-05",
      "processOrder": 5,
      "processName": "회수율 검정",
      "safetyMeasures": "예상 시료량이 포함되도록 3가지 이상 수준 및 공시료를 각 3반복으로 시료를 만든다. 하룻밤 방치 후 시료전처리 과정과 동일하게 전처리하고 분석한다. 회수율은 최소 0.75 이상이어야 하며 0.90 이상이 바람직하다.",
      "requiredPPE": [
        "보호구"
      ],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-A51-06",
