  "domainTerms": [
    {
      "identifier": "DT-E170-001",
      "term": "PV(Photovoltaic)",
      "definition": "햇빛을 직류 전기로 바꾸어 전력을 생산하는 발전방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-002",
      "term": "PV 셀(PV cell)",
      "definition": "태양 광선과 같은 빛에 노출될 때 전기를 생성할 수 있는 기본 PV 장치로 태양광전지를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-003",
      "term": "PV 모듈(PV module)",
      "definition": "환경적으로 완전히 보호되고 상호 접속된 태양전지의 최소 조립체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-004",
      "term": "PV 스트링(PV string)",
      "definition": "PV어레이가 필요한 출력전압을 얻을 수 있도록 PV모듈이 직렬로 연결되어있는 회로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-005",
      "term": "PV 어레이(PV array)",
      "definition": "직류전원공급설비를 구성하기 위하여 PV모듈 및 기타 필요한 구성품들이 기계적 및 전기적으로 통합된 조립체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-006",
      "term": "PV 어레이 정선박스(PV array junction box)",
      "definition": "PV 어레이의 모든 PV 스트링이 전기적으로 연결되어 있고, 필요한 경우 보호 장치를 배치할 수 있는 외함을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-007",
      "term": "PV 발전기(PV generator)",
      "definition": "PV 어레이의 조립체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-008",
      "term": "PV 발전기 정선박스(PV generator junction box)",
      "definition": "PV 어레이가 전기적으로 연결되어 있고, 필요한 경우 보호장치를 배치할 수 있는 외함을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-009",
      "term": "PV 스트링 케이블(PV string cable)",
      "definition": "PV 스트링을 구성하기 위해 PV 모듈을 연결하는 케이블을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-010",
      "term": "PV 어레이 케이블(PV array cable)",
      "definition": "PV 어레이의 출력 케이블을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-011",
      "term": "PV 직류 주 케이블(PV DC main cable)",
      "definition": "PV 정선박스를 PV 인버터의 직류 단자에 연결하는 케이블을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-012",
      "term": "PV 인버터(PV inverter)",
      "definition": "직류 전압과 전류를 교류전압과 전류로 변환하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-013",
      "term": "PV 공급 케이블(PV supply cable)",
      "definition": "PV 인버터의 교류단자를 전기 설비의 배전 회로에 연결하는 케이블을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-014",
      "term": "PV 교류 모듈(PV AC module)",
      "definition": "전기 인터페이스 단자가 직류 접근이 허용되지 않고 교류전용인 통합 모듈/인버터 조립체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-015",
      "term": "PV 설비(PV installation)",
      "definition": "PV시스템의 조립된 기기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-016",
      "term": "표준 시험 조건(Standard Test Conditions：STC)",
      "definition": "PV 셀과 PV 모듈을 위해 KS C IEC 60904-3에 명시된 시험 조건을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-017",
      "term": "표준 시험 조건하의 개방회로전압(open-circuit voltage under standard test conditions Uocstc)",
      "definition": "표준 시험 조건하에서 부하가 걸리지 않는 (개방된) PV 모듈, PV 스트링, PV 어레이, PV 발전기에 흐르는 전압 또는 PV 인버터의 직류측 전압을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-018",
      "term": "표준 시험 조건하의 단락회로전류(short-circuit current under standard test conditions Iscstc)",
      "definition": "표준 시험 조건에서 PV 모듈, PV 스트링, PV 어레이 또는 PV 발전기 발생기의 단락 회로 전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-019",
      "term": "직류측(DC side)",
      "definition": "PV 셀에서부터 PV 인버터의 직류단자에 이르기까지 PV 설비의 일부를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-020",
      "term": "교류측(AC side)",
      "definition": "PV 인버터의 교류 단자에서부터 전기 설비의 PV 전원 케이블의 접속점에 이르기까지 PV 설비의 일부를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-021",
      "term": "단순 분리(simple separation)",
      "definition": "기초절연방법으로 회로와 회로사이 또는 회로와 접지사이의 분리를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E170-022",
      "term": "특별저압(ELV, Extra Low Voltage)",
      "definition": "인체에 위협을 초래하지 않을 정도의 지압을 말하며, SELV(Safety Extra Low Voltage)는 비접지 회로에 해당되며, PELV(Protective Extra Low Voltage)는 접지회로에 해당된다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E170-01",
      "processOrder": 1,
      "processName": "접지 시스템 및 감전 방지 설계",
      "safetyMeasures": "교류측과 직류측 사이에 최소한의 단순 분리 확인, 직류측 PV기기는 교류측 분리와 무관하게 충전된 것으로 간주, SELV/PELV 보호수단 사용 시 Uoc_max 직류 120V 이하 확인, 전식 방지를 위한 전기적 연결 확보",
      "requiredPPE": [],
      "sourceSection": "4.1",
      "relatedSR": [
        "SR-ELECTRIC-001",
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "WP-E170-02",
      "processOrder": 2,
      "processName": "RCD 및 보호장치 설치",
      "safetyMeasures": "비절연 인버터 설치 시 B형 RCD를 교류측에 설치, 지락전류 검출 및 동작시간 조건 충족(완만한 상승: 300 mA 이하에서 300 ms 이내, 급격한 변화: 30 mA/0.3s, 60 mA/0.15s, 150 mA/0.04s), 교류측 PV 전원 케이블에 과전류 보호장치 설치",
      "requiredPPE": [],
      "sourceSection": "4.2.2.1",
      "relatedSR": [
        "SR-ELECTRIC-004",
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "WP-E170-03",
      "processOrder": 3,
      "processName": "PV 모듈 및 전기기기 설치",
      "safetyMeasures": "PV 모듈은 KS C IEC 61215 부합 확인, 직류측 전기기기는 직류전압과 전류에 적합한 것 사용, 블로킹 다이오드는 3병렬 이상 시 설치, 정격전압은 최대개방전압의 2배 이상, 전류정격은 단락회로전류의 1.4배 이상, 모듈 설치 시 적절한 열 분산 확보",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "WP-E170-04",
      "processOrder": 4,
      "processName": "배선 시스템 설치",
      "safetyMeasures": "공칭단면적 2.5 ㎟ 이상 연동선 사용, KS C IEC 62930 적합 태양광 전용 케이블 사용, 최대개방회로전압 이상 정격전압, 난연성 전선 또는 높은 온도정격, 자외선 보호, 다연선도체 주석 처리, 전선 접속 시 나사 조임 및 장력 방지, 극성별 표시, 도전성 루프 면적 최소화",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "WP-E170-05",
      "processOrder": 5,
      "processName": "단자·커넥터 접속",
      "safetyMeasures": "단자 접속 시 기계적·전기적·화학적 안전성 확보, 풀림방지 기능 너트/나사 사용, 접점 압력 유지, 커넥터는 KS C IEC 62852 직류 정격, 동일 제조업체 동일 형식 암/수 커넥터 사용, 설치장소에 적합한 IP 등급 선정",
      "requiredPPE": [],
      "sourceSection": "5.2.3",
      "relatedSR": [
        "SR-ELECTRIC-013",
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "WP-E170-06",
      "processOrder": 6,
      "processName": "개폐장치 설치",
      "safetyMeasures": "개폐장치는 점검이나 조작 가능한 곳에 설치, PV 인버터 직류측과 교류측 분리 수단 확보, 태양전지 스트링에 단로기 필수 설치, 태양전지 어레이에 부하개폐기 필수 설치, 정선박스에 충전 상태 경고표시 부착, 풀 아웃 퓨즈는 gPV 사용 및 양극 설치, 개폐기는 최대 개방전압에서 정격 전류 차단 가능해야 함",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": [
        "SR-ELECTRIC-003",
        "SR-ELECTRIC-019"
      ]
    }
