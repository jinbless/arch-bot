  "checklistItems": [
    {
      "identifier": "CI-O1-001",
      "text": "적절한 피복아크 용접봉을 선정할 때에는 용착금속의 품질이 모재의 품질과 같도록 선정하는 것이 바람직하며 아래의 관점에서 검토하여야 한다.",
      "guideContext": "설비보수용 용접재료 선정 (법령 근거 미확인)",
      "additionalDetail": "(1) 모재의 화학성분과 전 용착금속의 화학성분 및 탄소당량, (2) 모재의 기계적 성질과 전 용착금속의 기계적 성질 (인장강도, 연신율, 충격치, 경도), (3) 모재 두께, (4) 용접자세, (5) 이음형태 및 이음형상, (6) 확산수소량의 영향 (저수소계 용접봉), (7) 용접봉의 작업성 (아크안정성, 스패터 발생, 슬래그 박리성 및 비드외관), (8) 용접봉의 용접성 (용접결함 발생정도, 내균열성 정도 등), (9) 용접봉 제조사가 제공한 용접봉의 기술 데이터",
      "workProcessPhase": "용접재료 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-O1-002",
      "text": "용접봉의 화학적 기계적 성질이 불명확한 용접재료는 KS의 각 용접봉 사양에서 요구하는 전 용착금속 시험과 용접절차 확인시험(Welding procedure qualification test) 및 제품용접시험(Production welding test)을 통하여 용접품질, 용접봉의 작업성 및 용접성을 확인한 후에 사용하여야 한다.",
      "guideContext": "설비보수용 용접재료 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접 후 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-O1-003",
      "text": "내부식성을 향상시키기 위한 덧살붙임 용접 시에는 탄소강으로부터 용착금속 성분의 희석을 방지하기 위하여 완충층(Buffer Layer)용 용접봉을 사용하고, 최종 층은 클래드 재질과 같은 재질의 용접봉을 선정하는 것을 원칙으로 한다.",
      "guideContext": "설비보수용 용접재료 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덧살붙임 용접",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-O1-004",
      "text": "동종의 모재를 용접할 때 사용되는 피복아크 용접봉의 대표적 선정기준은 별표 1과 같다.",
      "guideContext": "설비보수용 용접재료 선정",
      "additionalDetail": "(가) 동종의 탄소강 및 저합금강의 피복아크 용접봉 선정은 별표 1의 1항을 참조한다. (나) 동종의 스테인리스강의 피복아크 용접봉 선정은 별표 1의 2항을 참조한다.",
      "workProcessPhase": "동종 모재 용접",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-O1-005",
      "text": "이종의 탄소강과 합금강의 모재를 용접할 때 각 모재 조합에 사용되는 피복아크 용접봉의 대표적 선정기준은 별표 3과 같다.",
      "guideContext": "설비보수용 용접재료 선정",
      "additionalDetail": "(가) 강재의 이종모재간의 용접재료선정은 별표 3의 1항을 참조한다. (나) 니켈 및 니켈합금의 이종모재간의 용접재료 선정은 별표 3의 2항을 참조한다.",
      "workProcessPhase": "이종 모재 용접",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-O1-006",
      "text": "V 및 O는 원칙적으로 심선의 지름(이하 봉 지름이라 한다)이 5.0 mm를 초과하는 것에는 적용하지 않는다.",
      "guideContext": "설비보수용 용접재료 선정",
      "additionalDetail": "V: 수직 자세, O: 위보기 자세",
      "workProcessPhase": "용접자세 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-O1-007",
      "text": "초층 용접시 탄소강으로부터 희석을 감안하여 2층 용접이 바람직하다.",
      "guideContext": "설비보수용 용접재료 선정",
      "additionalDetail": "덧살붙임 용접(클래드 용접) 시 오스테나이트계 스테인리스강 등의 초층 용접에 해당",
      "workProcessPhase": "덧살붙임 용접",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 4",
      "basedOn": null
    },
    {
      "identifier": "CI-O1-008",
      "text": "페라이트계 스테인리스 클래드의 덧살붙임 용접 시 예열(150℃) 및 응력제거 열처리가 필요하다.",
      "guideContext": "설비보수용 용접재료 선정 (법령 근거 미확인)",
      "additionalDetail": "TP 405, 410, 430 모재에 DNiCrFe-2 또는 D 309 용접봉 사용 시 적용",
      "workProcessPhase": "덧살붙임 용접",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-O1-001",
      "term": "피복아크 용접봉",
      "definition": "금속봉(심선)에 피복제를 도포한 것으로 용접 시 전류에 의해 아크를 발생시키고 용착하여 용접하는 용접재료를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-O1-002",
      "term": "피복제",
      "definition": "아크 발생 시 아크의 안정, 보호가스의 발생, 슬래그의 생성, 합금원소의 이행 및 용접작업성 등의 역할을 하는 것으로 용접봉 심선 겉에 바르는 재료를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-O1-003",
      "term": "용착금속",
      "definition": "용접에 의해 모재 위에 옮겨 붙은 금속을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-O1-004",
      "term": "모재",
      "definition": "피복아크 용접에 의해 용접되는 금속 재료를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-O1-005",
      "term": "이종 모재의 용접",
      "definition": "화학성분이 다른 모재를 피복아크 용접에 의해 용접하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
