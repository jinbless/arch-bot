  "checklistItems": [
    {
      "identifier": "CI-H203-001",
      "text": "고객응대업무 종사자 건강보호 매뉴얼 작성에는 사업주와 근로자가 함께 참여해야 한다.",
      "guideContext": "고객응대업무 종사자 건강보호 매뉴얼 작성 기본방향 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-002",
      "text": "고객응대업무 종사자 건강보호 매뉴얼은 근로자에 대한 건강보호 활동이 지속적이고 효율적으로 추진될 수 있도록 사업장의 특성에 맞게 작성되어야 한다.",
      "guideContext": "고객응대업무 종사자 건강보호 매뉴얼 작성 기본방향 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-003",
      "text": "사업주는 고객응대업무 종사자 건강보호 매뉴얼 작성에 필요한 인력, 시설, 장비, 예산 등을 지원해야 한다.",
      "guideContext": "고객응대업무 종사자 건강보호 매뉴얼 작성 기본방향 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-004",
      "text": "사업주는 고객응대업무 종사자 건강보호 매뉴얼을 작성하기 위하여 외부 전문가 또는 전문기관의 자문을 받거나 협력체계를 마련할 수 있다.",
      "guideContext": "고객응대업무 종사자 건강보호 매뉴얼 작성 기본방향",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-005",
      "text": "고객응대업무 종사자 건강보호 매뉴얼은 사업장 내의 협력업체 근로자에게도 적용될 수 있는 내용이어야 한다.",
      "guideContext": "고객응대업무 종사자 건강보호 매뉴얼 작성 기본방향 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-006",
      "text": "사업주는 사업장 내에서 고객응대업무를 관리할 담당부서를 정하고, 담당부서가 주관이 되어 매뉴얼을 작성할 수 있도록 한다. 다만 사업장의 규모가 작아 담당부서를 정하기 어려운 경우에는 담당자만을 지정한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-007",
      "text": "사업주는 노동조합이 있는 경우는 노동조합의 의견을 청취하며, 노동조합이 구성되지 않은 경우는 근로자 대표의 의견을 청취한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-008",
      "text": "산업안전보건위원회가 구성된 사업장은 산업안전보건위원회에서 고객응대업무 종사자 건강보호 매뉴얼의 내용을 심의·의결하여야 한다.",
      "guideContext": "근로자의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-009",
      "text": "담당 부서는 고객응대업무 관리팀, 고객응대업무 종사자 건강관리팀, 고객응대업무 종사자 행정지원팀으로 구성하고, 각 팀에서 해당 업무와 관련된 내용을 매뉴얼에 제시할 수 있도록 업무를 분담하여 수행한다.",
      "guideContext": "고객응대업무 관리 담당 부서의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-010",
      "text": "고객응대업무 관리자는 고객응대업무 관리팀에 소속된 전담자를 임명하며, 3개 팀에서 작성한 내용을 취합하여 고객응대업무 종사자 건강보호 매뉴얼 작성의 실무적인 계획을 총괄하여 수립한다.",
      "guideContext": "고객응대업무 관리자의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-011",
      "text": "고객응대업무 관리자는 고객응대업무 매뉴얼 작성과 관련된 외부의 교육 훈련에 참여한다.",
      "guideContext": "고객응대업무 관리자의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-012",
      "text": "문제고객에 대한 대응절차는 사업장의 특성에 따라 달라질 수 있지만 일반적인 절차는 고객의 요구를 경청하고(경청단계), 고객의 요구사항에 대한 원인분석을 하며(원인분석단계), 고객의 요구를 해결할 수 있는 해결책을 강구하고(해결책 강구단계), 대안을 제시하며(대안제시단계), 요구사항에 대한 처리결과를 확인하여 만족여부를 파악하는 단계(사후관리단계)로 추진한다.",
      "guideContext": "상황별 응대 멘트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고객응대",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-013",
      "text": "폭언, 폭력 등이 발생했을 때 신속하게 대응할 수 있는 절차를 제시한다.",
      "guideContext": "폭언, 폭력 발생 시 대응절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭언·폭력 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-014",
      "text": "피해 근로자의 업무를 일시적으로 중단하고, 2차 처리부서나 전담 대응팀에서 대응할 수 있는 절차를 마련한다.",
      "guideContext": "폭언, 폭력 발생 시 대응절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭언·폭력 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-015",
      "text": "문제고객에 대한 대응을 위한 CCTV나 녹음 등의 증거자료를 확보할 수 있도록 하고, 피해 근로자가 요청시 이를 제공해 줄 수 있음을 규정한다.",
      "guideContext": "폭언, 폭력 발생 시 대응절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭언·폭력 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-016",
      "text": "피해 근로자가 폭언, 폭력 등의 행위를 한 고객에 대해 고소·고발·손해배상 청구 등의 법률적 조치를 하는 경우 필요한 행정적, 절차적 지원을 할 수 있음을 명시한다.",
      "guideContext": "폭언, 폭력 발생 시 대응절차",
      "additionalDetail": null,
      "workProcessPhase": "폭언·폭력 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-017",
      "text": "고객응대업무 종사자가 부당한 내용이나 무리한 요구를 하는 고객을 통제하거나 업무를 중단할 수 있는 권리가 있음을 매뉴얼에 제시한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-018",
      "text": "부당한 요구를 통제하거나 업무를 중단할 수 있는 권리가 고객응대업무 종사자에게 있음을 사전에 고객에게 안내하는 내용을 매뉴얼에 제시한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-019",
      "text": "고객으로부터 부당한 대우를 받은 경우 이를 신속하게 회사에 알려 근로자가 보호받을 수 있는 권리가 있음을 명시한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-020",
      "text": "업무의 일시적 중단이나 전환을 할 수 있는 기준이나 상황을 제시하여 고객응대업무 종사자가 신속하게 위험상황에서 벗어날 수 있도록 한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-021",
      "text": "고객응대업무 종사자가 문제유발 고객에 대한 조치의견을 제시한 경우 근로자의 의견을 최대한 반영하여 조치하여야 한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-022",
      "text": "근로자의 개인정보를 보장하며, 근로자에게 어떠한 불이익 처분도 하지 않는 내용을 명시한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-023",
      "text": "문제유발 고객에 대해 매뉴얼에 제시된 응대 멘트 내용대로 대응한 근로자에게 해고, 징계 등의 불이익 처분을 하지 않는다는 내용을 매뉴얼에 제시한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-024",
      "text": "문제 발생 시 이를 처리할 2차 대응부서나 전담 팀을 설치하고 그 내용을 매뉴얼에 제시한다.",
      "guideContext": "직장 내 지원체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.10",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-025",
      "text": "문제유발 고객에 대해 근로자가 요구한 경우 법적인 대응을 지원해 주는 근거와 절차를 제시한다.",
      "guideContext": "직장 내 지원체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.10",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-026",
      "text": "고객응대업무 종사자의 정신적 스트레스를 해소하고 신체적 피로를 감소시킬 수 있는 대책을 제시한다.",
      "guideContext": "감정손상 예방 대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.11",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-027",
      "text": "고객응대업무 종사자가 휴식을 취할 수 있는 휴게시설을 설치하고, 휴게시설을 이용할 수 있는 휴게시간을 제공하는 내용을 명시한다.",
      "guideContext": "감정손상 예방 대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.11",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-028",
      "text": "고객응대업무 종사자가 자신의 감정을 표현하거나 위로 받을 수 있는 심리상담실이나 건강관리실을 마련하고, 치료 및 상담을 지원할 수 있는 방안을 명시한다.",
      "guideContext": "감정손상 예방 대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.11",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-029",
      "text": "고객에게 폭언 등을 하지 않도록 요청하는 문구를 게시하거나, 음성을 안내하는 등의 건강장해 예방조치를 명시한다.",
      "guideContext": "감정손상 예방 대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.11",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-030",
      "text": "근로자들이 자신을 보호할 수 있는 방법을 정기적으로 교육하여 사전에 예방 할 수 있도록 한다.",
      "guideContext": "감정손상 예방 대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.11",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-031",
      "text": "사업주는 고객응대업무 매뉴얼에 제시된 내용을 준수하도록 하여야 한다.",
      "guideContext": "매뉴얼 활용방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-032",
      "text": "매뉴얼을 작성한 것에 그치지 말고, 매뉴얼의 내용을 교육하여 고객응대업무 종사자 스스로 어려운 상황에 직면했을 때 이 매뉴얼의 내용을 실질적으로 활용할 수 있도록 한다.",
      "guideContext": "매뉴얼 활용방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-033",
      "text": "고객응대업무 종사자가 수시로 매뉴얼의 내용을 확인할 수 있도록 근로자들이 잘 볼 수 있는 곳에 게시한다.",
      "guideContext": "매뉴얼 활용방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-034",
      "text": "정기적으로 매뉴얼의 내용을 검토하고, 사업장 내 업무내용이나 상황 등이 변경되었을 때 매뉴얼의 내용을 수정 보완하여 사용할 수 있도록 한다.",
      "guideContext": "매뉴얼 활용방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-035",
      "text": "완성된 매뉴얼을 근로자에게 전달하고 고객응대업무 수행 시 참고할 수 있도록 공유한다.",
      "guideContext": "매뉴얼 활용 단계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "매뉴얼 활용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-036",
      "text": "매뉴얼의 내용에 대해 근로자에 대한 교육 훈련을 실시한다.",
      "guideContext": "매뉴얼 활용 단계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "매뉴얼 활용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-037",
      "text": "고객응대업무 종사자의 애로 및 고충의 해소와 의사소통을 위한 창구 마련의 필요성을 제시한다.",
      "guideContext": "감정손상 예방 대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.11",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-038",
      "text": "고객으로부터 부당한 대우를 받은 근로자를 보호하기 위하여 휴게시간을 연장하여 제공할 수 있음을 명시한다.",
      "guideContext": "고객응대업무 종사자의 권리 보장",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-039",
      "text": "문제 발생 시 도움을 요청할 수 있는 기관명을 제시한다.",
      "guideContext": "도움 요청기관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.12",
      "basedOn": null
    },
    {
      "identifier": "CI-H203-040",
      "text": "필요시 외부 전문가 또는 전문기관에게 자문을 받을 수 있는 체계를 갖추고 이 내용을 명시한다.",
      "guideContext": "도움 요청기관",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.12",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H203-001",
      "term": "고객응대업무",
      "definition": "말투나 표정, 몸짓 등 드러나는 감정 표현을 직무의 한 부분으로 연기하기 위해 자신의 감정을 억누르고 통제하며 감정노동을 수행하는 업무를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H203-002",
      "term": "고객응대업무 종사자",
      "definition": "고객, 환자, 승객, 학생 및 민원인 등을 직접 대면하거나 음성대화매체 등을 통하여 고객을 상대하면서 상품을 판매하거나 서비스를 제공하는 업무에 종사하는 모든 직원을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H203-01",
      "processOrder": 1,
      "processName": "기획단계",
      "safetyMeasures": "고객응대업무 현황 및 주요 이슈를 파악하고, 고객응대업무에 관한 정보 수집과 분석 및 조사를 시행한다. 매뉴얼의 구성요소를 정하고, 작성 팀과 인력을 구성한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H203-02",
      "processOrder": 2,
      "processName": "작성 단계",
      "safetyMeasures": "매뉴얼의 목차를 작성하고 인력별로 역할을 분담한다. 문제상황에 따른 대응 멘트를 작성하기 위하여 고객응대업무 담당자에 대한 설문조사, 인터뷰, 면담 등을 시행할 수 있다. 분담한 내용대로 매뉴얼의 초안을 작성한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H203-03",
      "processOrder": 3,
      "processName": "검토 단계",
      "safetyMeasures": "전문가 및 실제 현장 업무 담당자가 참여하여 매뉴얼의 내용을 검토한다. 현장 근로자의 의견을 참조하여 실제 상황에 맞는 매뉴얼이 작성되었는지 검토한다. 매뉴얼 활용에 대한 적합성 및 적정성을 확인한다.",
      "requiredPPE": [],
      "sourceSection": "6.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H203-04",
      "processOrder": 4,
      "processName": "완성단계",
      "safetyMeasures": "검토 단계에서 나타난 내용을 수정 보완한다. 수정 보완된 매뉴얼을 편집하여 최종 매뉴얼을 완성한다.",
      "requiredPPE": [],
      "sourceSection": "6.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H203-05",
      "processOrder": 5,
      "processName": "활용 단계",
      "safetyMeasures": "완성된 매뉴얼을 근로자에게 전달하고 공유한다. 매뉴얼의 내용에 대해 근로자에 대한 교육 훈련을 실시한다. 매뉴얼은 근로자들이 보기 좋은 곳에 게시한다. 활용 과정에서 문제점이 발견되면 즉시 수정하여 개선한다.",
      "requiredPPE": [],
      "sourceSection": "6.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-H203-06",
      "processOrder": 6,
      "processName": "폭언·폭력 발생 시 대응절차",
      "safetyMeasures": "폭언, 폭력 등이 발생했을 때 신속하게 대응할 수 있는 절차를 마련한다. 법률적 대응 기준을 제시한다. 피해 근로자의 업무를 일시적으로 중단하고 2차 처리부서나 전담 대응팀에서 대응한다. CCTV나 녹음 등의 증거자료를 확보한다. 피해 근로자가 요청시 법률적 조치에 필요한 행정적, 절차적 지원을 한다.",
      "requiredPPE": [],
      "sourceSection": "7.8",
      "relatedSR": null
    }
  ],
