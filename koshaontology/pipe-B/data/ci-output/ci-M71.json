  "checklistItems": [
    {
      "identifier": "CI-M71-001",
      "text": "수명기간 동안 탱크를 검사하고 유지관리 하여야 한다.",
      "guideContext": "열가소성 탱크 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운전과 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-002",
      "text": "탱크에 관한 기록을 보존해야 한다. 여기에는 최초의 사용자 요구 사양, 제작자 문서 및 계산서, 설치 문서 그리고 모든 검사 기록이 포함된다.",
      "guideContext": "열가소성 탱크 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-003",
      "text": "설계 단계에서 지속 하중에 의한 치수변화와 상대적으로 낮은 유연화 온도의 영향을 고려하여야 한다.",
      "guideContext": "열가소성 탱크 재료 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설계 및 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-004",
      "text": "열가소성 물질은 좋은 전기 절연체이므로 정전기 발생이 설계 단계에서 고려되어야 한다. 이점은 점화원이 문제가 되는 탱크에 특히 중요하다.",
      "guideContext": "열가소성 탱크 재료 선정",
      "additionalDetail": null,
      "workProcessPhase": "설계 및 제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-M71-005",
      "text": "설계 단계에서 열가소성 재료와 내용물 사이의 적합성과, 사용 온도와 예상 하중의 적절성을 고려하여야 한다. 탱크의 설계수명을 정의하여야 하고, 바람, 작업자 및 눈 등에 의한 하중을 고려하여야 한다.",
      "guideContext": "열가소성 탱크 재료 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설계 및 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-006",
      "text": "검사가 용이하게 시행될 수 있도록 설계에서 고려하여야 한다. 탱크가 너무 작아 내부 검사를 위해 들어가기 어려운 경우에는 상황에 적합한 검사절차를 수립하기 위하여 모든 가능한 열화 메커니즘을 확인할 필요가 있다.",
      "guideContext": "열가소성 탱크 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설계 및 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-007",
      "text": "탱크 제작자는 설계 상세사항을 사용자에게 제공하여야 한다.",
      "guideContext": "열가소성 탱크 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설계 및 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-008",
      "text": "사용자가 제시한 요구사항, 설계 수명을 결정하기 위해 공급자에 의해 작성된 설계 계산서 그리고 탱크의 중요한 특징들은 탱크의 수명기간 동안 기본 문서로서 보존되어야 한다.",
      "guideContext": "열가소성 탱크 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설계 및 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-009",
      "text": "0℃ 이하에서 탱크를 다루거나 운반, 설치하는 경우, 제작자 권고사항에 유의하고 또한 주의하여야 한다.",
      "guideContext": "열가소성 탱크 설치 (법령 근거 미확인)",
      "additionalDetail": "열가소성 플라스틱의 경우 저온에서 충격강도가 감소할 수 있다.",
      "workProcessPhase": "탱크 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-010",
      "text": "열가소성 탱크를 내하중 콘크리트 바닥과 같이 수평이고, 부드럽고, 평평한 표면 위에 설치하여야 한다. 현장 부지는 결점이 있는지 설치 전에 검사하여야 하고, 필요하면 탱크가 설치되기 전에 수정작업을 하여야 한다.",
      "guideContext": "열가소성 탱크 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탱크 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-011",
      "text": "탱크를 안정된 기초 위에 세워야 한다. 모래 또는 아스팔트와 같은 불안정한 물질을 탱크 바닥과 기초 사이를 채우는 층의 재료로 사용하여서는 안 된다.",
      "guideContext": "열가소성 탱크 설치 (법령 근거 미확인)",
      "additionalDetail": "층의 소실은 탱크 바닥에 불균일한 응력을 유발하고, 이것이 기계적 파손이나 탱크 바닥에 화학적인 열화를 일으킬 수 있기 때문이다.",
      "workProcessPhase": "탱크 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-012",
      "text": "평평하고, 잔해가 없고, 충격의 위험으로부터 보호되는 바닥에 올바른 방향으로 탱크의 임시 보관을 하여야 한다. 바람 등에 의한 움직임을 방지하기 위하여 탱크를 고정하여야 한다.",
      "guideContext": "열가소성 탱크 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탱크 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-013",
      "text": "보관 동안 탱크의 움직임을 방지하기 위해서 물을 채울 수 있다. 이 경우 사용된 물의 무게를 탱크가 건딜 수 있는 지 확인하여야 하고, 탱크를 다시 운반하기 전에 모든 물을 제거하여야 한다. 또한 탱크에 저장물을 넣기 전에 탱크 내부를 건조시켜야 한다.",
      "guideContext": "열가소성 탱크 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탱크 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-014",
      "text": "도로 근처나 자동차가 다니는 지역에 설치된 탱크에는 적절한 충격 방지벽을 설치하여야 한다.",
      "guideContext": "열가소성 탱크 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탱크 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-015",
      "text": "설치된 탱크는 규정된 부속품을 사용하여 고정하여야 한다. 빈 탱크가 2차 차단설비 내에서 떠오를 가능성이 있는 경우 이를 방지하기 위하여 부속품을 설계하여야 한다.",
      "guideContext": "열가소성 탱크 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탱크 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-016",
      "text": "초기 설계에서 제시된, 또는 전문가에 의하여 검증되고 수정된 안전운전범위 내에서 열가소성 탱크를 운전하여야 한다.",
      "guideContext": "열가소성 탱크 운전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-017",
      "text": "탱크를 안전운전범위를 벗어나 운전하여야 하는 경우는 전문가가 일어날 수 있는 영향을 평가하고, 사용적합성(Fit for service)을 유지하고 있는지를 판단하여야 한다.",
      "guideContext": "열가소성 탱크 운전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-018",
      "text": "설치 후 사용하기 전, 전문가는 탱크 치수 측정 및 다음 사항의 확인을 위하여 검사를 행하여야 한다.",
      "guideContext": "열가소성 탱크 사용전 검사 (법령 근거 미확인)",
      "additionalDetail": "확인사항: 탱크가 요구된 표준에 맞게 제작되고 사용 목적에 맞는가, 사용온도와 하중 변수들은 적절하게 결정되었는가, 기초의 특성·고정 장비와 배관작업 하중들은 올바른가, 적당한 밸브·플러그·배수시설 등과 장치들이 설치되어 있는가",
      "workProcessPhase": "사용전 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-019",
      "text": "내부 및 외부 검사를 적절한 주기로 수행하여야 한다. 첫 번째 내부 검사는 탱크의 설계, 제작, 올바른 설치를 검증하기 위해서 특히 중요하다.",
      "guideContext": "열가소성 탱크 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-020",
      "text": "검사의 범위, 특징 및 주기는 설계 및 제작 표준, 운전 경험, 유사 탱크의 경험, 예건되는 고장 모드 그리고 고장의 결과 등을 고려하여 결정하여야 한다. 검사 요구사항은 검사 계획에서 문서화하여야 한다.",
      "guideContext": "열가소성 탱크 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-021",
      "text": "내부와 외부 검사 결과를 기록하여야 한다. 검사 보고서에는 다음 검사까지 목적에 적합하게 사용될 수 있다고 기술하거나, 또는 필요한 보수작업을 기술하여야 한다.",
      "guideContext": "열가소성 탱크 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-022",
      "text": "열가소성 탱크와 2차 차단설비에 대한 일상적인(예를 들어 매일, 매주, 매달 행하는) 육안 외부점검을 실시하고, 점검 기록을 보존하여야 한다. 이러한 점검은 건전성에 영향을 미치는 조기 징조를 확인할 수 있도록 훈련된 운전 요원이 행하여야 한다.",
      "guideContext": "열가소성 탱크 일상 점검 (법령 근거 미확인)",
      "additionalDetail": "일상적 점검으로 삽출(Weep)이나 누설이 확인된 경우 신속하게 수리한다.",
      "workProcessPhase": "일상 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-023",
      "text": "탱크 주위의 2차 차단설비에 빗물이 고여, 누출사고 시 차단용량을 감소시키지 않는지 검사하여야 한다. 2차 차단설비 내에 어떤 물질의 누출 여부도 검사하여야 한다.",
      "guideContext": "열가소성 탱크 2차 차단설비 점검",
      "additionalDetail": null,
      "workProcessPhase": "일상 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-M71-024",
      "text": "2차 차단설비에서 수위의 육안검사가 불가능한 경우에는, 수위 감시설비를 설치하고, 적어도 일주일에 한번 수위를 점검하여야 한다.",
      "guideContext": "열가소성 탱크 2차 차단설비 점검",
      "additionalDetail": null,
      "workProcessPhase": "일상 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-M71-025",
      "text": "열가소성 탱크는 처음 제작될 때 정해진 수명이 있다. 수명이 다한 경우에는 수명 연장을 위한 검사와 평가를 하거나 폐기하여야 한다.",
      "guideContext": "열가소성 탱크 수명관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-026",
      "text": "탱크의 설계수명이 알려져 있지 않은 경우에는, 잔류수명과 검사 요구사항을 결정하기 위하여 전문가가 기술적인 평가를 하여야 한다.",
      "guideContext": "열가소성 탱크 수명관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-027",
      "text": "탱크가 설계수명을 넘었다고 결론지어지면, 전문가는 가능성 있는 경년 열화를 포함한 모든 연관된 요인들을 고려하여, 검사 요구사항을 재검토하고 갱신하여야 한다.",
      "guideContext": "열가소성 탱크 수명관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-028",
      "text": "초기 사양, 제작자의 설계 문서와 계산서, 설치 후 사용되기 전의 초기 기록물, 모든 검사들의 기록 등을 각 탱크마다 보존하여야 한다.",
      "guideContext": "열가소성 탱크 기록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-029",
      "text": "외부 검사의 요구조건은 문서화 하여야 한다.",
      "guideContext": "열가소성 탱크 외부 검사 (법령 근거 미확인)",
      "additionalDetail": "탱크가 바깥에 위치한 경우, 삽출과 누출의 탐지를 쉽게 하기 위해서 건조한 날씨에서 행해지는 것이 좋다.",
      "workProcessPhase": "외부 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-030",
      "text": "검사 요구사항에는 전문가에 의하여 적절한 간격으로 수행되는 외부 검사를 포함하여야 한다.",
      "guideContext": "열가소성 탱크 외부 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "외부 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-031",
      "text": "내부 검사는 적절한 간격으로, 검사 이력과 운전 경험을 고려하여 전문가가 행하여야 한다.",
      "guideContext": "열가소성 탱크 내부 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "내부 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-032",
      "text": "탱크의 내부검사를 안전하게 하기 위하여 특별히 주의하여야 한다. 밀폐공간으로의 출입은 주의 깊게 계획되고 감독되어야 하고, 엄격한 절차에 따라 행해져야 한다.",
      "guideContext": "열가소성 탱크 내부 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "내부 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-033",
      "text": "내부 검사는 탱크에 대한 손상을 피하기 위하여 주의 깊게 하여야 한다. 검사 시 탱크 또는 연결부에 과도한 하중이 작용되지 않도록 하여야 하고, 탱크 내에서의 모든 활동은 작업자에 대한 유해와 장치의 손상을 방지하기 위하여 주의 깊게 하여야 한다.",
      "guideContext": "열가소성 탱크 내부 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "내부 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-034",
      "text": "균열 등의 결함을 찾기 위해서 비파괴검사 기술을 사용하는 경우, 사용되는 유체가 탱크 재질에 적합한지, 그리고 사용 후에 열화를 유발하지 않는지 확인하여야 한다. 또한 유체는 탱크 내용물에도 적합해야 한다.",
      "guideContext": "열가소성 탱크 내부 검사",
      "additionalDetail": null,
      "workProcessPhase": "내부 검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-M71-035",
      "text": "비파괴검사 작업자들이 적절한 자질을 가지고 있는지, 적절히 보정된 장비를 사용하는지, 적절히 작성된 절차를 따르는지 확인하여야 한다.",
      "guideContext": "열가소성 탱크 검사 기술 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-036",
      "text": "탱크의 건전성에 영향을 주는 수리 또는 구조변경은 주의 깊게 고려하여야 하고, 사용자와 전문가에 의해서 동의된 절차를 따라서 행하여야 한다.",
      "guideContext": "열가소성 탱크 수리와 구조변경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수리와 구조변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-037",
      "text": "수리 또는 구조변경이 완료된 후, 계속적인 사용과 목적에 부합하는 탱크임을 전문가가 인증하여야 한다. 미래의 검사 절차 결정을 위하여 수리 또는 구조변경에 내포된 사항들도 확인하여야 한다.",
      "guideContext": "열가소성 탱크 수리와 구조변경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수리와 구조변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-038",
      "text": "수리와 구조변경에 대한 문서를 탱크에 대한 기록과 함께 보존하여야 한다. 여기에는 재료, 기술, 제도, 시험 증명서, 그리고 수리/변형 방법을 허가한 사람에 대한 사항이 포함된다.",
      "guideContext": "열가소성 탱크 수리와 구조변경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수리와 구조변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-039",
      "text": "보관하려는 새로운 물질이나 기존 물질의 새로운 농도가 탱크 재료와 부합되는지 확인하여야 하고, 필요한 경우 탱크 내 내용물의 허용높이도 새로 결정하여야 한다.",
      "guideContext": "열가소성 탱크 사용 조건 변경",
      "additionalDetail": null,
      "workProcessPhase": "사용 조건 변경",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-M71-040",
      "text": "새로운 물질의 적합성을 검토하기 위하여 제작 시의 자료들을 검토하고 설계자 또는 제작자와 상의하여야 한다.",
      "guideContext": "열가소성 탱크 사용 조건 변경 (법령 근거 미확인)",
      "additionalDetail": "저장된 내용물의 열가소성 중합체 안으로의 침투 및 확산은 탱크의 화학적 저항성에 영향을 줄 수 있고 내용물의 오염을 가져올 수 있으며, 탱크를 열화시켜 조기 파손을 일으킬 수도 있다.",
      "workProcessPhase": "사용 조건 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-041",
      "text": "사용 조건이 초기 설계조건에서 벗어날 경우, 사용에 앞서 전문가가 조사하여야 한다. 전문가는 제작자 및 운전자와 함께 새로운 조건에서 탱크가 안전하게 사용될 수 있다는 것을 확실히 하여야 한다.",
      "guideContext": "열가소성 탱크 사용 조건 변경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사용 조건 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-042",
      "text": "중고 열가소성 탱크의 구입을 원하는 사람은 제시된 탱크가 적절한 표준에 맞게 제작되었고, 새로운 목적에 부합되는지 확인하여야 한다.",
      "guideContext": "중고 열가소성 탱크 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "중고 탱크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-043",
      "text": "중고 탱크는 사용적합성을 확인하기 위해 전문가에 의해 내부 및 외부 검사를 하여야 한다.",
      "guideContext": "중고 열가소성 탱크 (법령 근거 미확인)",
      "additionalDetail": "전문가는 초기 사양과 임무의 자세한 내용, 운전이력, 현재 사용되지 않는 탱크의 경우는 보관 상태에 대한 자세한 사항을 요구할 수 있다.",
      "workProcessPhase": "중고 탱크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-044",
      "text": "중고 탱크를 구매하거나 기존 탱크를 이전하려는 경우는 파손의 결과를 고려하여야 한다. 책임자는 파손의 리스크를 관리할 수 있는 수단과, 갑작스러운 파손의 경우 결과를 완화시킬 수 있는 적절한 수단을 확인하여야 한다.",
      "guideContext": "중고 열가소성 탱크 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "중고 탱크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-045",
      "text": "사고, 충격의 경우나 허용되는 운전한계를 벗어난 경우 또는 운전 조건의 변경 후에는 건전성의 확인을 위하여 통상적인 주기적 검사 외에 추가 검사를 할 필요가 있다.",
      "guideContext": "열가소성 탱크 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주기적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M71-046",
      "text": "일상 점검에서 열화 표시가 발견되면 전문가는 탱크가 계속적인 사용에 적합한지 평가하여야 한다. 탱크에서 사용 중 누출이 발견된 경우는 사람에 대한 위해나 환경에 대한 리스크를 없애기 위하여 신속하게 수리하고, 전문가가 원인을 조사하여야 한다.",
      "guideContext": "열가소성 탱크 외부 검사",
      "additionalDetail": null,
      "workProcessPhase": "외부 검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M71-001",
      "term": "열가소성(Thermoplastic)",
      "definition": "가열하면 연화하여 다른 모양으로 변형할 수 있는 성질을 말한다. 열을 가하면 부드럽게 되고, 어떤 모양의 물체를 누르면 그 모양대로 찍힌다. 열을 식히면 찍힌 모양대로 굳어지는데, 다시 열을 가하면 부드럽게 되어 마음대로 다른 모양으로 바꿀 수 있는 성질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M71-002",
      "term": "열화(Degradation)",
      "definition": "재료나 제품이 열 또는 빛 등의 사용 환경에 의해 그 화학적 구조에 유해한 변화를 일으키는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M71-003",
      "term": "비파괴검사(Non-destructive examination, NDE)",
      "definition": "공업재료 또는 제품을 파괴시키지 않고 내부의 상태를 검사하는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M71-004",
      "term": "크레이즈(Craze)",
      "definition": "플라스틱 등에서 변형을 많이 한 부분이 하얗게 변하는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
