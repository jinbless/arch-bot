      "specifications": {
        "components": "방호용 케이지(Roll cage) 및 안전벨트 등 안전 장비",
        "applicableVehicles": "지게차, 간이덤퍼(Compact dumper), 경사선적 및 하역트럭(Tipper lorry), 트랙터 등 전복 취약 차량"
      },
      "sourceSection": "7.8",
      "relatedSR": null
    },
    {
      "identifier": "ES-G10-002",
      "equipmentName": "후진 경고음 발생장치",
      "specifications": {
        "requirement": "충분히 소리가 크고 뚜렷하여 배경 소음과 구별될 수 있어야 한다",
        "maintenance": "제대로 작동하도록 잘 유지 및 보수"
      },
      "sourceSection": "7.4",
      "relatedSR": null
    },
    {
      "identifier": "ES-G10-003",
      "equipmentName": "후면용(Rear-view) CCTV",
      "specifications": {
        "installLocation": "차량의 후면 창문",
        "purpose": "운전자들이 차의 뒤쪽을 볼 수 있도록 함",
        "alternative": "굴절 렌즈"
      },
      "sourceSection": "7.4",
      "relatedSR": null
    },
