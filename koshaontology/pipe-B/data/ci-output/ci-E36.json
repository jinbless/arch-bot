  "checklistItems": [
    {
      "identifier": "CI-E36-001",
      "text": "작업현장을 가로지르거나 작업현장 근처에 있는 모든 가공전력선과 지중케이블의 경로를 숙지해서 접근해야 하고, 지중케이블의 보호를 위하여 그 위치를 표시하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장의 안전확보 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 안전확보 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-002",
      "text": "전력회사와의 협의를 통해 전력선 방호조치를 시행하고 전력선을 따라 운전할 때 최소한의 안전이격거리(1∼5 m)를 유지하고 전력선 아래로 통과 시 최대 안전높이를 설정하며, 작업현장에서는 이를 적절하게 표시하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장의 안전확보 계획",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 안전확보 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E36-003",
      "text": "가공전력선 부근에서 작업을 해야 하는 모든 기계는 운전자가 쉽게 확인할 수 있는 위치에 경고 표시를 해야 한다. 기계의 최대 작업 높이와 이동시의 최대 높이를 반드시 표시하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장의 안전확보 계획",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 안전확보 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E36-004",
      "text": "가공전력선 아래나 근접하여 통과하는 이동용 설비가 최소화 되도록 작업현장에서 운행계획을 편성하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장의 안전확보 계획",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 안전확보 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E36-005",
      "text": "지상과 가공전력선 사이의 안전이격거리는 일정하게 유지되어야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장의 안전확보 계획",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 안전확보 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E36-006",
      "text": "작업자는 울타리의 전압 유도를 고려하여 가공전력선과 40 m 이내에 울타리를 설치하거나 철거하기 전에는 반드시 전력회사와 협의하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장의 안전확보 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 안전확보 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-007",
      "text": "전력선과 우연히 접촉하거나 전력선에 손상이 있는 경우에는 전력회사와 협의한 후 조치를 취하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장의 안전확보 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-008",
      "text": "가공전력선이 작업현장의 진입로와 교차하여 지나가는 곳에는 전력선의 양 측에 경고표시를 하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 현장 접근 경로 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 접근 경로 안전확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-009",
      "text": "작업현장으로 출입할 때에는, 기계의 부착물이나 화물은 반드시 최대 안전 높이 이하로 유지한다.",
      "guideContext": "임업에서의 전기안전 - 현장 접근 경로",
      "additionalDetail": null,
      "workProcessPhase": "현장 접근 경로 안전확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E36-010",
      "text": "작업현장 내에서는 가공전력선을 따라 운전할 수 있도록 적절한 격벽을 설치하여 안전이격거리를 확보한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장",
      "additionalDetail": "차량접근을 허용하는 출입구가 없는 경우에는 표식나무들을 이용하여 적당한 격벽을 형성한다.",
      "workProcessPhase": "작업현장 격벽 및 지주 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E36-011",
      "text": "격벽으로부터 가공전력선까지 필요한 최소 운행 거리는 6 m를 유지한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장",
      "additionalDetail": "전력회사는 가공전력선의 전압에 따라 6 m 이상의 거리를 권할 수도 있다.",
      "workProcessPhase": "작업현장 격벽 및 지주 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E36-012",
      "text": "작업현장에서 가공전력선 아래로 통행하는 모든 지점에는 지주를 세워야 하고, 지정된 통행지점 이외로 통행하는 것을 방지하기 위하여 격벽을 설치하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 격벽 및 지주 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E36-013",
      "text": "가공전력선에 근접한 경우에는 사다리, 비계기둥, 다른 기둥이나 혹은 긴 물체를 수평으로 이동시키고, 가능한 낮게 유지한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장",
      "additionalDetail": null,
      "workProcessPhase": "작업현장 격벽 및 지주 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E36-014",
      "text": "굴착 작업을 시작하기 전에 작업자는 작업하는 곳에 지중케이블의 유무를 전력회사 또는 현장 관리자에게 지도상으로 확인하거나 위치 확인 장치를 사용하여 확인하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장",
      "additionalDetail": null,
      "workProcessPhase": "굴착 작업 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-EXCAVATION-001"
      ]
    },
    {
      "identifier": "CI-E36-015",
      "text": "지중케이블 부근에서 굴착 작업을 하는 곳에서는 반드시 케이블의 소유주(현장부지 소유자, 전력회사, 관계당국 등)와 협의하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 작업현장",
      "additionalDetail": null,
      "workProcessPhase": "굴착 작업 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-EXCAVATION-001"
      ]
    },
    {
      "identifier": "CI-E36-016",
      "text": "작업자는 현장관리자와 전력회사와의 협의 없이 가공전력선으로부터 나무높이의 2배 이내에서는 벌목작업을 해서는 안 된다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벌목작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-017",
      "text": "전력회사와 협의 없이 충전 가공전력선으로부터 나무높이의 2배 이내의 범위에 있는 나무들을 벌목해서는 안 된다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "작업기간 동안에 전력을 차단할 수 없다고 전력회사가 명시하는 경우에는 안전작업 절차를 따라야 한다.",
      "workProcessPhase": "벌목작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-018",
      "text": "기계 또는 나무가 충전 가공전력선으로부터 나무높이에 근접지역 거리를 더한 값(최소 15 m) 이내에 있다면 나무를 벌목할 수 없다. 근접지역 거리는 <표 1>을 따르며, 전력선의 전압에 따라 1 ∼ 5 m이다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벌목작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-019",
      "text": "충전부와 평행하게 벌목하거나 충전부와 떨어져서 벌목한다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벌목작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-020",
      "text": "체인톱이나 벌목과 관련된 기계 조작은 벌목교육을 받은 작업자가 수행하고, 전력선과의 접촉 방지를 위하여 전기안전교육을 받은 자를 배치하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업",
      "additionalDetail": null,
      "workProcessPhase": "벌목작업",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-ELECTRIC-017"
      ]
    },
    {
      "identifier": "CI-E36-021",
      "text": "현장과 지상조건을 평가하고 주의하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벌목작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-022",
      "text": "기상 조건을 평가하고 풍향이 벌목 방향의 제어에 영향을 미치지 않는다는 것을 확인하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벌목작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-023",
      "text": "나무높이의 2배가 되는 정상 작업의 한계와 나무높이에 근접지역 거리를 더한 값인 충전 가공전력선에 근접한 작업의 한계는 표식나무, 고가시성 테이프, 다른 적절한 표시 방법 등을 사용하여 확실하게 표시하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 벌목작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벌목작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-024",
      "text": "기계나 화물이 충전 가공전력선으로부터 나무높이에 근접지역 거리를 더한 값(최소 15 m) 이내로 들어올 경우에는 트랙터나 포워더를 작동시키지 않아야 한다.",
      "guideContext": "임업에서의 전기안전 - 목재 반출 작업",
      "additionalDetail": null,
      "workProcessPhase": "목재 반출 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E36-025",
      "text": "케이블 크레인을 사용하는 경우 가공전력선의 경로를 통과해서는 안 된다.",
      "guideContext": "임업에서의 전기안전 - 목재 반출 작업 (법령 근거 미확인)",
      "additionalDetail": "케이블 크레인과 충전 가공전력선 사이의 안전 작업 거리를 유지하고, 사용할 케이블 크레인의 종류와 안전 작업 거리는 전력회사와 협의한다.",
      "workProcessPhase": "목재 반출 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-026",
      "text": "크레인 기둥이 올려진 채로 케이블 크레인을 이동하지 않는다.",
      "guideContext": "임업에서의 전기안전 - 목재 반출 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "목재 반출 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-027",
      "text": "나무가 가공전력선으로부터 15 m 이내에 있는 경우에는 전력회사와 협의한 후에 육림을 위해 가지치기나 제거작업을 할 수 있다.",
      "guideContext": "임업에서의 전기안전 - 육림작업 (법령 근거 미확인)",
      "additionalDetail": "지상에서 육림을 위한 벌목작업은 7.1항을 따라야 한다.",
      "workProcessPhase": "육림작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-028",
      "text": "전력선을 보호하기 위한 차단기가 작동하는 사고가 발생되면 전력이 전력선으로 자동적으로 복구되거나 또는 원격통제실의 운전자에 의해 복구되어 전력선이 충전되므로 우발적인 접촉에 대하여 보고하거나, 불의에 의한 재송전이 발생되는 것을 방지하기 위해서는 전력회사와 미리 협의하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-029",
      "text": "전력회사가 전력선에 가까이 접근하거나 접촉해도 안전하다는 것을 통지할 때까지 접근하거나 접촉해서는 안 된다고 경고해야 한다.",
      "guideContext": "임업에서의 전기안전 - 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-030",
      "text": "가공전력선과 접촉하고 있는 기계의 운전자는 기계 조작이 가능한 경우 운전석에서 기계를 조작하여 모든 올려진 부분들을 낮추고, 전력선이 없는 공간으로 기계를 이동하며, 무전기나 휴대폰 등 가능한 빠른 방법으로 현장 관리자, 전력회사 등에 즉시 연락하여야 한다.",
      "guideContext": "임업에서의 전기안전 - 비상조치 (법령 근거 미확인)",
      "additionalDetail": "이동시 전력선을 절단하거나 지면으로 끌어내릴 위험성이 없어야 한다.",
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-031",
      "text": "가공전력선과 접촉하고 있는 기계의 운전자는 기계 조작이 불가능한 경우(전력선으로부터 떨어질 수 없는 경우 또는 전력선이 끊어진 경우) 운전석에서 기다리고, 무전기나 휴대폰 등으로 즉시 연락하며, 차량 밖에 있는 사람에게 접근하지 못하도록 안내하고, 전력선이 충전되지 않은 것이 확인될 때까지 운전석을 떠나지 않는다.",
      "guideContext": "임업에서의 전기안전 - 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-032",
      "text": "기계 조작이 불가능하고 화재나 다른 즉각적인 재해의 위험이 있는 경우 기계의 한 부분과 지면에 동시에 접촉을 피하면서 기계로부터 점프를 하고, 두 발을 가능한 가까이 유지하면서 지면에 내리며, 기계로부터 멀리 떨어질 때까지 두 발로 같이 토끼뜀을 계속하고, 다른 사람들에게 차량에 접근하지 말라고 경고하며, 전력선에 전력이 차단된 것을 확인하기 전까지 기계로 돌아가지 않는다.",
      "guideContext": "임업에서의 전기안전 - 비상조치 (법령 근거 미확인)",
      "additionalDetail": "무전기나 휴대폰 등 가능한 빠른 방법으로 현장 관리자, 전력회사 등에 즉시 연락하여야 한다.",
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E36-033",
      "text": "모든 차량은 전력선으로부터 안전하게 처리된 이후에 정상적인 작업으로 돌아가기 전에 적절히 동작하는지의 여부를 유자격자에 의해 확실히 점검받아야 한다.",
      "guideContext": "임업에서의 전기안전 - 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E36-001",
      "term": "가공전력선",
      "definition": "가설된 전선뿐만 아니라 전선을 지지하는 철탑, 전주 등을 포함한 공중에 가설된 전선로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E36-002",
      "term": "안전이격거리",
      "definition": "가공전선로에 접근하여 작업하는 경우 작업자 또는 작업자가 접촉할 수 있는 충전부와의 안전한 이격거리를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "DT-E36-003",
      "term": "유자격자",
      "definition": "전기설비의 시공·운전 및 기타 전기작업에 관련된 국가기술자격 및 공인자격을 보유하거나 교육을 받은 자로서 일정기간 동일업무에 종사한 사람을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E36-004",
      "term": "충전",
      "definition": "서로 다른 전압의 전원에 전기적으로 접속되어 있거나 인접된 접지면과 상당한 전위차가 있는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E36-005",
      "term": "지주",
      "definition": "가공전선로 아래 안전한 출입을 위하여 설치한 나무 또는 금속으로 된 기둥 및 말뚝을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E36-006",
      "term": "격벽",
      "definition": "노출 충전되어 있는 전선이나 기기 등에 작업자가 접촉되는 것을 막기 위한 물리적인 장애물을 말하며, 임시 또는 영구적으로 설치된다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-E36-007",
      "term": "충전부",
      "definition": "정상상태에서 전압이 인가되는 도체 또는 도전성부분을 말하며 중성선은 포함하나 보호도체는 포함하지 않는다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    }
  ],
  "workProcesses": [
