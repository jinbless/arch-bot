  "domainTerms": [
    {
      "identifier": "DT-M73-001",
      "term": "소음(Noise)",
      "definition": "공기의 진동에 의한 음파 중 인간에게 감각적으로 바람직하지 못한 소리, 즉 지나치게 강렬하여 불쾌감을 주거나 주의력을 빗나가게 하여 작업에 방해가 되는 음향을 말하는 것으로서 산업안전보건법에서는 소음성난청을 유발할 수 있는 85 dB(A) 이상의 시끄러운 소리로 정의하고 있다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "DT-M73-002",
      "term": "소음수준(Noise level)",
      "definition": "소음계로 측정한 음원 수준을 말하며 소음계에는 청감보정회로(A특성)가 들어있어 이를 통해 측정한 음압수준으로 단위는 dB, sone, phon 등이 있다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-002"
      ]
    },
    {
      "identifier": "DT-M73-003",
      "term": "데시벨(dB)",
      "definition": "음압수준을 표시하는 한 방법으로 사용하는 단위이다. 사람의 귀는 외부 자극에 비례하여 반응하지 않고 자극의 대수값에 비례하여 반응하므로 음압은 기준 음압에 대한 비를 대수값으로 변환하고, 음의 강도는 음압의 제곱에 비례하므로 음압 비의 대수값을 제곱하여 음압수준을 산출한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M73-004",
      "term": "관리수준(Action level)",
      "definition": "해당 값 이상으로 노출되는 경우 위험을 줄이기 위해 조치를 취해야 하는 소음에 대한 일일 노출량을 의미한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-005"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M73-01",
      "processOrder": 1,
      "processName": "유리병 보틀링 소음제어",
      "safetyMeasures": "유리병을 플라스틱 병으로 대체, 기계 구입 시 허용 소음수준 명시, 라인 속도를 늦추고 병의 간격을 넓힘, 충격 지점에 충격완화물질 설치, 병 컨베이어 전체 소음차폐, 마개 공급 그릇 주위에 방음벽을 제공하고 소음 감소 마운팅 설치, 직무 순환으로 작업자 노출시간 제한",
      "requiredPPE": [
        "청각 보호구"
      ],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "WP-M73-02",
      "processOrder": 2,
      "processName": "제품과 호퍼 충돌 소음제어",
      "safetyMeasures": "기계 구입 시 허용 소음수준 명시, 제품의 낙하 높이 줄이기, 팔레타이저의 이송이나 상승 시의 틈을 감소시키거나 채우기, 소음완화 강으로 만든 호퍼 사용, 호퍼 안쪽에 충격완화 물질 대기, 호퍼 바깥에 흡음재 대기, 흡음재로 보호대/패널의 안감 대기 (소음 5 dB(A) 감소 가능)",
      "requiredPPE": [
        "청각 보호구"
      ],
      "sourceSection": "6.3",
