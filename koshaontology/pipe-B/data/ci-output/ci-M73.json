        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-010",
      "text": "병 컨베이어 전체 소음차폐",
      "guideContext": "유리병 보틀링 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "유리병 보틀링",
