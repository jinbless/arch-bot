  "checklistItems": [
    {
      "identifier": "CI-M73-001",
      "text": "기계 또는 설비의 구입을 고려할 때 제조업체/공급업체로부터 소음 데이터를 제공받아야 하며, 데이터는 운전자의 위치에서의 소음수준이어야 함",
      "guideContext": "식음료 제조 사업장 소음 제어",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-002",
      "text": "시끄러운 기계/설비는 작업자가 없거나 적은 곳으로 이동",
      "guideContext": "식음료 제조 사업장 소음 제어",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-003",
      "text": "작업 구역 안에 남아있어야 하는 기계/설비는 가능하면 방음재로 둘러쌈",
      "guideContext": "식음료 제조 사업장 소음 제어",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-004",
      "text": "방음재로 둘러싸기 불가능한 곳에서는 다음의 조치로 소음을 감소시켜야 함: ① 보호대/판에 소음 흡음재를 댐 ② 방음벽 제공 ③ 호퍼 내부에 충격방지 물질을 댐 ④ 방진 기계 마운팅 설치 ⑤ 배기 장치에 소음기를 끼움 ⑥ 덜커덕 거리는 것을 멈추게 하고 마모로부터 소음을 예방하는 적절한 유지관리를 실시",
      "guideContext": "식음료 제조 사업장 소음 제어",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-005",
      "text": "소음수준이 90 dB(A)를 초과하는 구역 내에서는 작업자가 청각 보호구를 확실히 착용하도록 함",
      "guideContext": "식음료 제조 사업장 소음 제어",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M73-006",
      "text": "노출 시간은 직무 순환이나 소음 대피소(Noise refuge)의 제공으로 감소시킬 수 있음",
      "guideContext": "식음료 제조 사업장 소음 제어",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-007",
      "text": "유리병을 플라스틱 병으로 대체",
      "guideContext": "유리병 보틀링 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "유리병 보틀링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-008",
      "text": "병 사이의 영향 감소: 라인 속도를 늦추고 병의 간격을 넓힘",
      "guideContext": "유리병 보틀링 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "유리병 보틀링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M73-009",
      "text": "충격 감소: 충격 지점에 충격완화물질 설치",
      "guideContext": "유리병 보틀링 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "유리병 보틀링",
