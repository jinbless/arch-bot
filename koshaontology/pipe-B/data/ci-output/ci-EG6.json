  "domainTerms": [
    {
      "identifier": "DT-EG6-001",
      "term": "사무실",
      "definition": "중앙관리방식의 공기정화설비 등을 갖추고 근로자가 업무를 수행하는 실내공간과 그 부속시설인 휴게실, 식당, 화장실, 회의실, 강당, 보건의료시설, 복도, 계단 등의 공간을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG6-002",
      "term": "사무실 오염물질",
      "definition": "분진·가스·증기 등과 곰팡이·세균·바이러스 등 사무실의 공기중에 떠다니면서 근로자에게 건강장해를 유발할 수 있는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG6-003",
      "term": "공기정화설비 등",
      "definition": "사무실 오염물질을 바깥으로 내보내거나 바깥의 신선한 공기를 실내로 끌어들이는 급·배기장치, 오염물질을 제거 또는 감소시키는 여과제 또는 온도, 습도, 기류 등을 조절하여 공급할 수 있는 냉·난방장치, 그밖의 이에 상응하는 장치 등을 말한다",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG6-004",
      "term": "미세먼지",
      "definition": "먼지 중 입자의 지름이 10마이크로미터 이하인 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG6-005",
      "term": "초미세먼지",
      "definition": "먼지 중 입자의 지름이 2.5마이크로미터 이하인 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG6-006",
      "term": "기적",
      "definition": "사무실 바닥으로부터 4미터 이상의 공간을 제외한 총 용적에서 사무실내에 있는 설비나 기기가 점유한 용적을 뺀 공기의 체적을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
