  "checklistItems": [
    {
      "identifier": "CI-E57-001",
      "text": "차단기의 설치 시에는 다음 사항을 고려한다. (가) 온도 : -5 ℃～40 ℃ (나) 습도 : 45～85 % (다) 수증기, 유증기, 먼지, 염분, 부식성 물질이 존재하지 않는 장소",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": "차단기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E57-002",
      "text": "도체 사이에는 절연거리를 확보하고, 도체 고정은 정격토크로 체결한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": "차단기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E57-003",
      "text": "차단기는 제조공장에서 전반적인 시험 및 검사를 실시하며, 이러한 시험은 KS C 8331(산업용 배선차단기)에 따른다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E57-004",
      "text": "과전류차단기로 저압전로에 사용하는 차단기는 정격전류의 1배의 전류에서 자동적으로 동작하지 아니할 것.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": "전기설비기술기준의 판단기준 제38조 제3항 참조",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E57-005",
      "text": "과전류차단기로 저압전로에 사용하는 차단기는 정격전류의 1.25배 및 2배의 전류를 통한 경우에 <표 1>에서 정한 시간 내에 자동적으로 동작할 것.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": "전기설비기술기준의 판단기준 제38조 제3항 참조",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E57-006",
      "text": "단락보호전용 차단기는 다음 표준에 적합한 것이어야 한다. ① 정격전류의 1배의 전류에서 자동적으로 작동하지 아니할 것 ② 정정전류 값은 정격전류의 1.3배 이하일 것 ③ 정정전류 값의 1.2배의 전류를 통하였을 경우에 0.2초 이내에 자동적으로 작동할 것",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-007",
      "text": "과부하 보호장치와 단락보호 전용 차단기 또는 단락보호 전용 퓨즈를 하나의 전용함 속에 넣어 시설한 것이어야 한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-008",
      "text": "과부하 보호장치가 단락전류에 의하여 손상되기 전에 그 단락전류를 차단하는 능력을 가진 단락보호 전용 차단기 또는 단락보호 전용 퓨즈를 시설한 것이어야 한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-009",
      "text": "과부하 보호장치와 단락보호 전용 퓨즈를 조합한 장치는 단락보호 전용 퓨즈의 정격전류가 과부하 보호장치의 정정전류의 값 이하가 되도록 시설한 것이어야 한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": "그 값이 단락보호 전용 퓨즈의 표준 정격에 해당하지 아니하는 경우는 단락보호 전용 퓨즈의 정격전류가 그 값의 바로 상위의 정격이 되도록 시설한 것을 포함한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-010",
      "text": "저압전로에 시설하는 과전류차단기는 이곳을 흐르는 단락전류를 차단하는 능력을 갖는 것이어야 한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": "최대단락전류가 10 kA를 초과하는 경우 상위 차단기와의 협조 차단 가능",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E57-011",
      "text": "분전반에 설치되는 배선차단기는 정상 작동 조건에서 3시간 또는 그 이상을 사용하는 경우, 당해 정격전류의 80%를 넘지 않도록 사용하는 것이 바람직하다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": "차단기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-012",
      "text": "일반 배선차단기는 지락사고를 감지하여 이를 차단하는 기능이 없으므로 저수준의 지락사고는 차단할 수 없음을 인지하여야 한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": "차단기 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-004"
      ]
    },
    {
      "identifier": "CI-E57-013",
      "text": "차단기는 내부의 열을 정상적으로 방산할 수 있도록 외부 오염물을 깨끗하게 닦아 내어야 한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": "깨끗한 외함은 충전 도체 사이, 충전 도체와 접지 사이에 발생할 수 있는 아크를 감소시킬 수 있다.",
      "workProcessPhase": "기계적 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E57-014",
      "text": "외함 구조적인 강도는 고장전류 차단 시 가해지는 응력을 견디는 데 중요하다. 따라서 외함에 균열이 있는지에 대해 점검하고 필요 시 교체한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기계적 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-015",
      "text": "정기적인 정비 점검에는 접속부의 느슨함이나 과열의 흔적을 점검하는 것을 포함해야 한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": "과열의 가장 일반적인 원인은 접속부의 느슨함이다.",
      "workProcessPhase": "기계적 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E57-016",
      "text": "느슨한 접속부는 제조자가 권고하는 토크 값으로 필요한 만큼 조여야 한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": "기계적 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E57-017",
      "text": "교환할 수 없는 차단 유닛이 있는 차단기는 공장에서 적합하게 조정하고 조여지고 밀폐하여야 한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기계적 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-018",
      "text": "모든 접속부는 제조자의 권고사항에 따라 정비하도록 한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": "멀리 이격되어 설치되는 교환 가능한 차단 유닛이 있는 차단기들은 설치시 적절히 조여지지 않으면 과열될 수 있다.",
      "workProcessPhase": "기계적 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E57-019",
      "text": "가동부를 갖는 장치는 정기적으로 점검을 실시한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": "차단기의 수동조작은 차단 접점을 깨끗하게 유지하는 데 도움을 줄 수 있다.",
      "workProcessPhase": "기계적 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-020",
      "text": "전기시험은 사용한 트립 유닛 형태에 의해 요구된 방법과 기기 형태로 실시하여야 한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "전기적 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-021",
      "text": "차단기 트립 특성을 시험할 때 과전류 시험은 정격전류의 300 %에서 개별 극에서 실시하는 것을 권장한다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": "전기적 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-022",
      "text": "정상시험 상태 하에서, 차단기는 <표 3>의 최대값(5열) 미만에서 트립되어야 한다.",
      "guideContext": "배선차단기 일반관리 (법령 근거 미확인)",
      "additionalDetail": "부적합한 시험 조건에서는 이 측정값이 <표 3>의 값을 초과할 수 있다.",
      "workProcessPhase": "전기적 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E57-023",
      "text": "순시 회로차단기의 시험은 정확한 전류 표시장치나, 가능한 디지털 표시장치가 구비된 일정한 상승률을 가진 시험장치를 필요로 한다. 이러한 시험장치를 이용할 수 없다면, 차단기의 교정이 필요할 때 제조자, 기타 유능한 정비 업체 등을 이용하는 것이 바람직하다.",
      "guideContext": "배선차단기 일반관리",
      "additionalDetail": null,
      "workProcessPhase": "전기적 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E57-001",
      "term": "배선차단기",
      "definition": "교류 600 V, 직류 750 V 이하의 전로보호에 사용하는 과전류 차단기를 말하며, 개폐기, 트립장치 등을 절연물의 용기 내에 일체로 조립한 것이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E57-002",
      "term": "정격전류",
      "definition": "정격전압, 정격주파수, 주위온도 40 ℃를 기준으로 연속하여 안전하게 통전 가능한 전류로서 이 전류에서는 장시간 계속 사용하여도 발열, 파손, 열화 되지 않고 사용할 수 있는 전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E57-003",
      "term": "지락고장 전류",
      "definition": "절연 고장으로 인하여 대지로 흐르는 전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E57-004",
      "term": "과부하 전류",
      "definition": "전기적으로 건전한 회로에서 발생하는 과전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E57-005",
      "term": "단락 전류",
      "definition": "정상 사용 상태에서 다른 전위를 갖는 지점 사이에 무시할 수 있을 정도의 임피던스만을 갖게 되는 사고 발생(단락회로)으로부터 야기되는 과전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E57-006",
      "term": "차단 전류",
      "definition": "차단 과정 중의 아크 개시 순간에서의 차단기의 한 극에 흐르는 전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E57-007",
      "term": "정정전류",
      "definition": "전기설비를 과전류 및 과부하로부터 보호하기 위하여 사용자가 임의로 선정하는 전류를 말하며, 이 전류는 해당 선로의 부하전류 및 단락전류를 계산하여 보호에 적합한 전류를 선정하는 것이므로 일정한 값을 갖지는 않는다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E57-01",
      "processOrder": 1,
      "processName": "차단기 선정 및 설치",
      "safetyMeasures": "설치 환경 조건 확인(온도 -5℃~40℃, 습도 45~85%, 유해물질 없는 장소), 도체 간 절연거리 확보, 도체 고정 정격토크 체결, 정격전류·정격단락차단용량 기준 적합 제품 선정, 저압전로 단락전류 차단 능력 확인",
      "requiredPPE": null,
      "sourceSection": "4",
      "relatedSR": [
        "SR-ELECTRIC-003",
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "WP-E57-02",
      "processOrder": 2,
      "processName": "기계적 정비 (점검 및 청소)",
      "safetyMeasures": "외부 오염물 청소로 충전 도체 간 아크 방지, 외함 균열 점검 및 필요 시 교체, 접속부 느슨함·과열 흔적 점검, 제조자 권고 토크 값으로 접속부 체결, 가동부 정기 점검 및 수동조작 실시",
      "requiredPPE": null,
