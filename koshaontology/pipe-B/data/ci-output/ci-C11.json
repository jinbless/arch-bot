  "domainTerms": [
    {
      "identifier": "DT-C11-001",
      "term": "계단(Stairways)",
      "definition": "30°부터 60°까지의 경사각을 갖는 통로로서 수평부재는 판 모양이나 평면 발판으로 이루어진 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C11-002",
      "term": "발판(Tread)",
      "definition": "계단을 오르내리기 위해 한 발씩 내딛는 수평부재의 판 모양이나 평면 발판을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C11-003",
      "term": "발판 폭(Width of Tread)",
      "definition": "발판이 가로로 놓여있는 길이를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C11-004",
      "term": "발판 너비(Depth of Tread)",
      "definition": "발판의 전면부에서 후면부까지의 길이를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C11-005",
      "term": "발판 높이(Rise)",
      "definition": "계단에 부착된 발판에서 위 발관과 아래 발관 사이의 수직 거리를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C11-006",
      "term": "계단참(Landing)",
      "definition": "계단의 끝부분에 위치한 수평면의 정지 지역을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
