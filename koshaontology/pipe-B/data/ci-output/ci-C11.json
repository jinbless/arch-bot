  "checklistItems": [
    {
      "identifier": "CI-C11-001",
      "text": "경사로는 경사각 30° 이내에서 설치하며, 경사각이 15°를 초과하는 때에는 미끄러지지 않는 구조로 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "이동통로 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-002",
      "text": "계단은 경사각 30°에서 60°까지의 구간에서 설치하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "이동통로 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-003",
      "text": "사다리는 경사각 60°에서 90°까지 구간에서 설치하며, 이동식 사다리의 기울기는 75° 이하로 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "이동통로 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-C11-004",
      "text": "가설계단의 재료는 한국산업규격 \"KS F 8012 작업발판\"의 규정에 적합한 것이어야 하며, 다음의 규정에 적합하거나 이와 동등한 이상의 기계적 성질을 가진 것으로 사용하고, 주위 환경에 의해 발생되는 부식에 대해 저항성이 있어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-005",
      "text": "계단의 재료는 충분한 강도를 유지하여야 하며 사용 중에 안전성이 있어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-006",
      "text": "발판을 구멍이 있는 재료로 만들 때에는 렌치, 기타 공구 등이 낙하할 위험이 없는 구조로 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-007",
      "text": "발판은 이동시의 추락, 전도, 미끄러짐 등으로 인한 재해를 예방할 수 있는 구조로 설치되어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-008",
      "text": "발판 끝부분과 계단참의 표면은 미끄럼방지 조치를 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-009",
      "text": "계단 위와 주변에는 통행에 유해한 돌출된 못이나 철선 등이 없어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-010",
      "text": "계단에는 자재나 공구 등을 적재하여서는 안된다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-011",
      "text": "계단의 설계는 \"가설공사표준시방서\"에서 정하고 있는 허용응력 설계법을 활용하고, 강재 또는 알루미늄재 등과 같이 비교적 재사용이 많은 부재는 장기허용응력을 적용하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-012",
      "text": "계단 및 계단참은 한국산업규격 \"KS F 8012 작업발판\"에서 규정하고 있는 통로의 역할을 하는 비계에 관한 하중을 적용하여 125kg/m²이상으로 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-SCAFFOLD-002"
      ]
    },
    {
      "identifier": "CI-C11-013",
      "text": "계단 발판 및 지지대의 처짐량 및 휨 하중에 관한 성능은 한국산업규격 \"KS F 8012 작업발판\"에서 규정하고 있는 기준을 적용한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": "계단 발판 처짐량 1.5cm 이내, 전체 처짐(지지대 포함) 2.5cm 이하, 지지대 휨 하중 5,390N 이상",
      "workProcessPhase": "가설계단 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-SCAFFOLD-002"
      ]
    },
    {
      "identifier": "CI-C11-014",
      "text": "발관의 폭(L)은 35cm 이상으로 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-015",
      "text": "발판의 너비(g)는 18cm 이상으로 하고, 각각의 너비가 같은 크기이어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-016",
      "text": "발판의 높이는 24cm 이하 이어야 하고, 동일한 계단에서의 발판 높이는 모두 일정하여야 한다. 단, 이 높이를 일정하게 하는 것이 불가능할 경우에는 출발지점 위치에서 첫 번째 발판에 국한하여 그 높이를 줄이거나 늘려야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-017",
      "text": "비계를 설치한 곳에 조립형 계단을 설치하는 경우에는 참고자료에 제시한 영국 규격 \"BS EN 12811-1 : 2003\"을 응용하도록 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-018",
      "text": "기계ㆍ탱크ㆍ설비의 내·외부 계단이나 마루ㆍ난간ㆍ피트에 연결된 고정계단을 설치하는 경우에는 참고자료에 제시한 미국 규격 \"OSHA 1910.24(e)\"를 응용하도록 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-019",
      "text": "발판의 겹침(r)은 평면상의 발판일 때는 0 이상(r≥0cm)이어야 하며, 판 모양의 발판일 때는 \"r≥1cm\"이상이 되어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-020",
      "text": "높이가 3m를 초과하는 계단에는 높이 3m 이내마다 너비 1.2m 이상의 계단참을 설치하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-021",
      "text": "계단을 설치하는 때에는 각각의 발판으로부터 높이 2m이내의 머리 공간에 장애물이 없도록 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-022",
      "text": "최 상부의 발판은 계단참에 접하거나, 상부 발판과 계단참의 격차가 발판 높이와 같게 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "가설계단 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-023",
      "text": "안전난간은 추락예방을 위한 장치로써 작업자가 추락위험이 있는 지역에는 안전난간을 설치한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-024",
      "text": "높이 1m이상인 계단의 개방된 측면에는 안전난간을 설치하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-025",
      "text": "계단과 인접 구조물과의 사이가 20cm이내인 경우와 안전난간과 동등한 구조의 보호조치가 있는 경우에는 안전난간을 설치하지 않아도 된다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-026",
      "text": "계단과 인접 구조물과의 사이가 3cm이상일 때에는 발끝막이판을 설치하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-027",
      "text": "계단 발판에서 상부 난간대까지의 높이(H)는 0.9m이상 1.2m이하이어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-028",
      "text": "중간 난간대는 상부 난간대와 발판의 중간지점에 설치하며, 그 공간의 폭(B)은 60cm 이하이어야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-029",
      "text": "발끝막이판은 난간 바닥의 물체가 낙하 하는 것을 예방하기 위하여 계단 바닥면으로부터 10cm이상의 높이(h)를 유지토록 하고, 바닥면과의 틈새가 없도록 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-030",
      "text": "계단 발판의 측면이 개방되어 있는 경우에는 폭 20cm 이상의 측면 보강재(w)를 설치하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-031",
      "text": "난간기둥 사이의 간격은 2m이내 이어야 하며, 만약 이 간격 이상이 되면 난간기둥을 보강하거나 고정 장치를 설치하여 임의의 방향으로 움직이는 100kg 이상의 하중에 견딜 수 있도록 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "안전난간 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-C11-032",
      "text": "지지대는 2본이 있어야 하며, 또한 각각 양 끝단에 걸침 고리를 가지고 있어야 한다.",
      "guideContext": "가설계단 설치 및 사용 - 일체형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-033",
      "text": "발판 폭은 35cm 이상으로 하고, 또한 그 바닥면은 미끄러짐 방지 기능을 가지고 있어야 한다.",
      "guideContext": "가설계단 설치 및 사용 - 일체형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-034",
      "text": "발판 너비는 18cm 이상으로 하고, 또한 각각의 너비가 같은 크기이어야 한다.",
      "guideContext": "가설계단 설치 및 사용 - 일체형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-035",
      "text": "발판 높이는 24cm 이하이어야 하고, 일정한 간격으로 부착 고정된 구조이어야 한다.",
      "guideContext": "가설계단 설치 및 사용 - 일체형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-036",
      "text": "가설계단의 경사각은 30°～60°를 유지하여 설치하도록 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용 - 조립형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-037",
      "text": "발판 너비는 23cm 이상으로 하고, 또한 그 바닥면은 미끄러짐 방지 기능을 가지고 있어야 한다.",
      "guideContext": "가설계단 설치 및 사용 - 조립형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-038",
      "text": "발판 높이는 23cm 이하이어야 하고, 일정한 간격으로 설치하여야 한다.",
      "guideContext": "가설계단 설치 및 사용 - 조립형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-039",
      "text": "단관비계와 크램프는 가설기자재 안전인증에 합격한 제품을 사용하여야한다.",
      "guideContext": "가설계단 설치 및 사용 - 조립형 가설계단",
      "additionalDetail": null,
      "workProcessPhase": "기성품 가설계단 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-SCAFFOLD-003"
      ]
    },
    {
      "identifier": "CI-C11-040",
      "text": "당해 작업의 관리감독자는 근로자에게 작업장소의 상황과 작업순서 등을 가능한 그림 등을 사용하여 정확하게 지시하여야 하며, 작업 중 예상되는 위험요인과 안전수칙을 충분히 설명하고 그 이행여부를 감독하여야 한다.",
      "guideContext": "가설계단 설치 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치작업 안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-041",
      "text": "근로자는 당해 작업에 적합한 개인보호구를 착용하여야 하며, 안전한 작업을 수행하도록 안전수칙을 준수하여야 한다.",
      "guideContext": "가설계단 설치 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치작업 안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-042",
      "text": "작업의 안전한 진행을 위하여 근로자의 경험 및 숙련여부를 고려하여 작업에 배치되도록 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치작업 안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-043",
      "text": "작업구역 내에는 관계 근로자 외의 자의 출입을 금지시켜야 한다.",
      "guideContext": "가설계단 설치 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치작업 안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-044",
      "text": "출입금지 장소에는 울타리ㆍ로프ㆍ표지 등을 설치하여 작업장소에 접근할 수 없도록 하고, 필요에 따라 감시자를 배치하여야 한다.",
      "guideContext": "가설계단 설치 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치작업 안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-045",
      "text": "사용하는 기기ㆍ공구 등은 정상적으로 작동할 수 있도록 작업전에 점검하고 불량공구는 사용을 금지하거나 정비한 다음에 사용하여야 한다.",
      "guideContext": "가설계단 설치 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치작업 안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C11-046",
      "text": "가설계단의 설치를 완료하면 설치상태를 점검한 후에 사용하도록 하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "설치 후 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-047",
      "text": "재료가 규격에 적합한지 아닌지를 확인하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "설치 중 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-048",
      "text": "재료에 녹, 변형 또는 손상 등에 의한 결함이 없는 지를 확인하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "설치 중 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-049",
      "text": "발판이 설치기준에 따라 적합하게 되었는지를 확인하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "설치 중 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-050",
      "text": "발판과 지지대의 접속이나 연결부의 이상 유무를 확인하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "유지관리 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-051",
      "text": "발판의 변형 부식 또는 손상유무를 확인하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "유지관리 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-052",
      "text": "발판위에 떨어져있는 자재나 공구 등의 유무를 확인하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "유지관리 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-C11-053",
      "text": "계단 주변의 통로 확보 및 정리정돈 상태를 확인하여야 한다.",
      "guideContext": "가설계단 설치 및 사용",
      "additionalDetail": null,
      "workProcessPhase": "유지관리 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    }
