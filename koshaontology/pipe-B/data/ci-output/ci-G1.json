      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G1-003",
      "term": "인화성물질(Flammable substance)",
      "definition": "대기압 하에서 인화점이 섭씨 60도 이하인 인화성액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "DT-G1-004",
      "term": "화기작업(Hot work)",
      "definition": "불꽃, 스파크나 열을 발생하는 작업을 말한다. 여기에는 용접, 절단, 연삭 및 툴질이 포함된다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "DT-G1-005",
      "term": "폭발(Explosion)",
      "definition": "어떤 원인으로 인해 급격한 압력상승이 생겨 용기 파괴나 음향을 동반하여 그 압력이 해방되는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G1-006",
      "term": "유해·위험요인",
      "definition": "유해·위험을 일으킬 잠재적 가능성이 있는 것의 고유한 특징이나 속성을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G1-007",
      "term": "위험성평가",
      "definition": "사업주가 스스로 유해·위험요인을 파악하고 해당 유해·위험요인의 위험성 수준을 결정하여, 위험성을 낮추기 위한 적절한 조치를 마련하고 실행하는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
