  "checklistItems": [
    {
      "identifier": "CI-G1-001",
      "text": "사업주는 화기작업을 수행하기 전에 근로자와 영향을 받는 사람들의 안전을 확보하기 위하여 작업장에 대한 위험성평가를 하고 가능한 예방대책을 강구하여야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "위험성평가",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G1-002",
      "text": "화기작업을 실시하기 전에 저온절단, 저온수리기술 그리고 수리대신 교체 등의 다른 안전한 방법을 고려하여야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "위험성평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G1-003",
      "text": "화기작업이 꼭 필요한 경우에는 작업을 하기 전에 전문 회사를 이용하여 위험을 회피하거나, 환기, 청소 그리고 불활성기체 치환과 같은 방법을 사용함으로써 위험을 줄여야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "위험성평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G1-004",
      "text": "어떤 사람도 관련된 위험이나 취해질 예방대책에 대한 적절한 훈련을 받지 않고는 탱크 혹은 드럼을 수리하거나 해체해서는 안 된다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "위험성평가",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-G1-005",
      "text": "저온절단도 약간의 열을 발생시키고 위험성이 전혀 없는 것은 아니다. 냉각수를 절단부위에 가하여 냉각시킬 수 있지만 먼저 탱크에서 가연성 물질 등을 깨끗이 치우는 것이 바람직하다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "저온절단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G1-006",
      "text": "탱크를 절단하는 경우 저온절단법을 사용하여 상부의 전부 또는 일부를 우선 제거하는 것이 바람직하다. 이렇게 하면 탱크 내부를 검사할 수 있고 또한 탱크의 압력을 낮출 수 있다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "저온절단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G1-007",
      "text": "화기작업은 경험이 많은 관리자 또는 감독자가 책임을 맡고 적절히 감독하면서 이행되어야 한다. 그들은 수행되는 작업, 포함된 위험성, 취해야 하는 예방 조치에 대하여 알고 있어야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 허가",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G1-008",
      "text": "작업자가 포함된 위험성과 취해야 하는 예방 조치에 대하여 적절한 훈련을 받지 않은 경우 드럼, 탱크 그리고 다른 컨테이너들은 수리하거나 절단하지 말아야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "훈련",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-G1-009",
      "text": "탱크는 파이프 부분을 제거함으로써 다른 설비로부터 격리시켜야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": "연결된 작은 탱크는 가능한 분리하여 안전한 곳으로 치운다.",
      "workProcessPhase": "격리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-G1-010",
      "text": "작은 누출도 심각한 결과를 가져올 수 있으므로 차단 밸브에 의존하지 말아야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "격리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-G1-011",
      "text": "펌프를 이용하여 탱크 내 액체를 적합한 컨테이너로 옮기거나 배수하여 탱크를 비워야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "배출",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-G1-012",
      "text": "잔류물은 환경 기준을 준수하여 폐기해야 하며 배수구, 하수구 또는 수로에 무단으로 버려서는 안 된다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G1-013",
      "text": "탱크는 청소하는 것이 바람직하다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": "청소방법에는 물 또는 세제를 이용한 세척 또는 분사, 스팀 청소, 용제(Solvent) 세척 또는 분사가 있다.",
      "workProcessPhase": "청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G1-014",
      "text": "증기와 다른 휘발성 물질은 탱크 속으로 공기나 스팀을 송풍함으로써 제거될 수 있다. 증기 농도는 가스 검지기를 사용해서 감시하여야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": "대부분의 탱크와 드럼은 연결부와 틈새에 갇힌 액체 또는 고체 잔류물을 여전히 포함하고 있기 때문에 가스 제거만으로는 충분하지 않다.",
      "workProcessPhase": "가스 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G1-015",
      "text": "탱크의 내부에서 사용되는 다른 조명 기구는 반드시 방폭구조(Flameproof)를 가지도록, 즉 가연성 분위기에서 사용할 수 있도록 설계되어야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "검사",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-G1-016",
      "text": "탱크가 깨끗하다고 가정하지 말고, 항상 주의 깊게 검사하여야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-G1-017",
      "text": "만약 불활성 가스가 사용된다면, 불활성 가스가 새어나가고 공기가 다시 들어오는 것을 방지하는 것이 어려울 수 있다. 그러므로 산소 농도를 감시하기 위해 산소 측정기가 필요하다. 이 방법은 전문가에게 맡겨야 한다.",
      "guideContext": "소용량 탱크 및 드럼의 화기작업",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G1-001",
      "term": "불활성화(Inerting)",
      "definition": "이너팅이라고도 부르며, 산소농도를 안전한 농도로 낮추기 위하여 질소 등의 불활성가스를 용기에 주입하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G1-002",
      "term": "가스제거(Gas freeing)",
