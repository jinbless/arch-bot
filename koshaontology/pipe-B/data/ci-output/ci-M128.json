  "checklistItems": [
    {
      "identifier": "CI-M128-001",
      "text": "시멘트 벽돌·블록 성형기를 사용할 때에는 다음의 장소에서 근로자에게 위험을 미칠 우려가 있는 부위가 있는지 확인한다. (1) 시멘트, 골재 등 원재료 적재 및 이송부분 (2) 혼합기 내부 및 작동부분 (3) 성형기의 몰탈공급통 구동링크 전후진 작동부분 및 압축판 상·하 작동부분 (4) 유압푸서, 체인컨베이어, 핑거카 및 지게차 등 이송설비의 작동 부분 (5) 엘리베이터, 로우레이터, 오토로더 및 언로더 등 적재설비의 동작부분 (6) 큐빙기의 작동반경 부분 (7) 지게차, 트럭의 상하차 작업장소",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-002",
      "text": "입고된 원재료를 차량으로 골재호퍼에 투입할 때에는 유도자를 배치하여 미리 호퍼내에 작업자가 없음을 확인하고 안전한 상태에서 차량을 유도한다.",
      "guideContext": "원재료 적재 및 이송작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "원재료 적재 및 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M128-003",
      "text": "컨베이어 가동전 경보벨을 울려 컨베이어가 가동됨을 사전에 알려주도록 하며 컨베이어의 가동상태 및 위험부위를 수시 확인할 수 있는 외부 감시카메라(CCTV)를 설치하여 운전실에서 확인할 수 있도록 한다.",
      "guideContext": "원재료 적재 및 이송작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "원재료 적재 및 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M128-004",
      "text": "혼합기 덮개에 연동장치를 설치하여 덮개를 닫아야만 혼합기가 가동되도록 한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "계량 및 혼합",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-005",
      "text": "혼합 작업중 작동불량 등의 문제점이 발생될 경우 작업자의 임의접근을 금지하고 주운전자 또는 관리자에게 연락하여 안전작업절차에 따라 조치하게 한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "계량 및 혼합",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-006",
      "text": "정비, 청소 등으로 부득이 혼합기 내부에 입조하여 작업을 하여야 할 경우에는 다음과 같은 안전조치 후 작업한다. (가) 작업지휘자를 배치하여 작업을 지휘 감독 (나) 혼합기 구동모타의 주전원 차단 (다) 조작스위치에 시건장치 후 열쇠는 작업자가 직접 지참 (라) 전원스위치 등에 \"작업중\" 표지판 부착 (마) 작업종료후 전원 투입시에는 혼합기 내에 작업자가 없음을 육안으로 확인",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "계량 및 혼합",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-007",
      "text": "성형기의 위험점에 근로자가 접근하는 것을 방지하기 위하여 성형기 전·후면에는 견고한 안전울을 설치하며 안전울 제작시에는 안전거리를 감안하여 위험점이 방호되도록 한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "성형",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-008",
      "text": "성형기의 수리·점검작업 후에 안전울을 개방한 상태로 방치하여서는 안되며, 설비 작동 중에는 반드시 안전울을 닫아 위험점 등에 접근하는 것을 사전에 방지한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "성형",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-009",
      "text": "성형기에 설치된 안전울에는 안전울을 닫아야 작동이 가능하고 안전울을 개방할 경우 조작회로가 차단되어 설비작동이 정지되도록 연동장치를 설치한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "성형",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-010",
      "text": "안전울에는 안전성 향상을 위하여 연동장치를 2중으로 설치함이 바람직하다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "성형",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-011",
      "text": "성형기 전·후면 등에 비상시 즉시 정지 가능하도록 비상정지스위치를 설치하고, 스위치를 조작시에는 작동중인 동력이 차단되어 설비가 정지할 수 있도록 하며 설치기준은 다음과 같다. (가) 비상정지스위치를 조작후 복귀시에는 운전조작을 처음 시동상태부터 하여야만 동작되도록 조치 (나) 스위치의 조작부는 눈에 띄기 쉽게 적색 돌출형으로 설치 (다) 수동복귀되는 형식으로 설치",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "성형",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-012",
      "text": "형틀교체 및 수리점검 등을 위하여 근로자가 성형기 내부에 진입하여 작업할 경우 압축판의 불시하강 또는 스위치 오조작으로 인하여 성형기가 작동시에는 협착재해로 직결될 위험성이 크므로 다음 안전조치를 취한 후 작업한다. (가) 주전원 차단 (나) 키전환 조작스위치에 있는 열쇠 잠금 및 작업자가 열쇠를 지참한 후 작업 (다) 주전원 스위치 및 조작스위치에 \"작업중\" 표지판 부착 (라) 성형기 압축판에 고정핀 체결 또는 안전블록 설치 (마) 작업지휘자 배치",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "성형",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-013",
      "text": "컨베이어 설비중 회전부 및 왕복운동 부위에는 안전울 또는 방책 등을 설치하여 접근을 방지한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 이송",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-014",
      "text": "포장준비, 적재예비, 불량품 취출작업 등으로 컨베이어 주위에 접근하여 작업하여야 할 경우에는, 키전환스위치의 전원을 차단시킨후 작업자가 열쇠를 지참하고 적절한 수공구 등을 사용한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 이송",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-015",
      "text": "컨베이어 상부로 근로자가 통행할 경우에는 적절한 위치마다 건널다리를 설치한다.",
      "guideContext": "컨베이어 이송 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M128-016",
      "text": "핑거카 전후의 진행방향에 근접센서를 설치하여 장해물 또는 작업자가 접근할 경우 전원이 차단되어 핑거카가 정지되도록 한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "핑거카 이송",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-017",
      "text": "핑거카에는 경보장치(경보등 또는 경보음장치)를 설치하여 근로자의 주의를 환기시키도록 한다.",
      "guideContext": "핑거카 이송 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "핑거카 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M128-018",
      "text": "큐빙기 작동반경내에는 안전울을 설치하여 근로자가 위험구역내에 접근하는 것을 근원적으로 방지한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "적재(큐빙)",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-019",
      "text": "안전울의 출입문에는 연동장치를 설치하여 출입문을 개방시에는 큐빙기 작동이 정지되도록 한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "적재(큐빙)",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-020",
      "text": "큐빙기 작업후 파렛트 상부에 잔류벽돌이 남아 있을 경우 이를 자동으로 제거할 수 있도록 간이 스크레이퍼 또는 유압 스크레이퍼를 설치하여, 작업자가 큐빙기 작동 위험지역에 접근하는 것을 근원적으로 차단한다. (가) 적재공정과 후속공정간 이송거리가 짧거나, 파렛트와 파렛트 사이 공간이 충분하지 못할 경우에는 적재작업 후단 컨베이어 상부에 간이 스크레이퍼를 설치하여 파렛트 상부의 잔류 벽돌이 컨베이어 하단부로 제거되고 파렛트만 이송되도록 한다. (나) 간이 스크레이퍼 설치가 불가능한 적재설비에 대해서는 유압 스크레이퍼를 컨베이어 측면에 설치하여 파렛트 상부에 잔류 벽돌이 발생할 경우 광센서가 이를 감지하고 유압 스크레이퍼가 전진하면서 잔류벽돌을 컨베이어 측면으로 제거한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": null,
      "workProcessPhase": "적재(큐빙)",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-021",
      "text": "큐빙기의 수리·보수 및 점검 등으로 큐빙기 홀더(Holder) 하부에서 작업이 이루어질 때 유압 파손으로 큐빙기 홀더가 불시 하강하여 근로자가 협착될 수 있으므로 큐빙기 본체 측면에 쐐기식 브레이크 장치를 설치하여, 큐빙기의 주전원을 차단시에는 브레이크 장치가 자동으로 작동되어 홀더 사프트가 고정되도록 한다.",
      "guideContext": "시멘트 벽돌·블록 성형기 방호조치",
      "additionalDetail": "핀의 투입은 스프링, 해제는 유압으로 구동되도록 설치",
      "workProcessPhase": "적재(큐빙)",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-M128-022",
      "text": "파렛트에 적재된 벽돌제품은 단위중량이 100kgf 이상으로 지게차 등 하역운반기계를 사용하여야 하므로 사전에 작업계획서를 작성하고 이에따라 작업한다.",
      "guideContext": "야적 및 출하작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야적 및 출하",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M128-023",
      "text": "지게차 운행경로를 수시 확인하고 작업장 바닥이 평탄한 상태가 유지되도록하여 요철, 기울어짐이 발생되지 않도록 하며, 특히 작업장 내부에는 지게차의 운행경로를 표시하여 운행하도록 한다.",
      "guideContext": "야적 및 출하작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야적 및 출하",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M128-024",
      "text": "지게차의 운전은 임의 작업자 운전에 따른 재해가 빈발하므로 지정운전자 이외에는 지게차를 운전할 수 없도록 열쇠 관리 등을 철저히 한다.",
      "guideContext": "야적 및 출하작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야적 및 출하",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M128-025",
      "text": "옥외 야적장에 벽돌제품을 적재시에는 적정한 높이(2단 이하)로 적재함이 바람직하나, 작업장 공간 협소 등으로 부득이 3단 이상 적재할 경우 로프로 매는 등 붕괴예방 조치를 하고 수시로 적재상태를 확인하여 사전에 위험을 제거한다.",
      "guideContext": "야적 및 출하작업",
      "additionalDetail": null,
      "workProcessPhase": "야적 및 출하",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.8.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M128-001",
      "term": "혼합기",
      "definition": "시멘트 벽돌제품을 생산하기 위하여 시멘트, 골재 및 물을 적정한 배합비율에 따라 혼합하는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M128-002",
      "term": "성형기",
      "definition": "시멘트 벽돌제품을 생산하기 위하여 형틀에 모르타르를 투입하여 가압·진동시켜 제품형상을 만드는 설비를 말하며, 그 주요부분은 호퍼, 형틀, 가압진동부 및 송급취출장치로 구성되어 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M128-003",
      "term": "엘리베이터(Elevator) 또는 오토로더(Autoloader)",
      "definition": "성형된 벽돌제품이 성형기에서 배출되어 유압푸서 또는 체인컨베이어에 의해 파렛트로 1판씩 이송될 때 자동적재되는 설비를 엘리베이터, 반자동으로 적재되는 설비를 오토로더라고 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M128-004",
      "term": "로우레이터(Lowlator) 또는 언로더(Unloader)",
      "definition": "양생실에서 양생 완료된 벽돌제품을 핑거카(Finger car) 또는 지게차로 유압푸서 또는 체인컨베이어에 내려놓을 때 포장공정까지 이송시키는 중간적재설비로 자동설비로 사용되는 것을 로우레이터, 반자동설비로 사용되는 것을 언로더라고 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M128-005",
      "term": "큐빙기(Cubing machine)",
      "definition": "벽돌이 유압푸서 또는 컨베이어에 의해 이송되어 일정 위치에서 대기하면 상하, 좌우 및 회전 등 복합운동을 하여 일정량씩 집어 이송후 적재대에 최종 적재하는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M128-006",
      "term": "유압푸서",
      "definition": "체인컨베이어와 작업형태는 유사하나 경계석 등 중량이 큰 벽돌제품을 취급할 때 사용되며, 전후진 동작에 의하여 컨베이어 상부에 위치한 벽돌을 밀어서 이송시키는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M128-007",
      "term": "핑거카",
      "definition": "엘리베이터에 적재된 벽돌을 양생실로 옮기는 작업과 양생실에서 양생완료된 벽돌을 로우레이터로 옮기는 작업을 하는 설비로, 엘리베이터 또는 로우레이터의 신호를 감지하여 레일을 따라 자동으로 양생실을 왕복하는 운반설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
