  "checklistItems": [
    {
      "identifier": "CI-H136-001",
      "text": "망간과 그 화합물에 노출되는 공정에 배치된 후 6월 이내에 첫 번째 특수건강진단을 실시한 후, 1년에 1회 이상 특수건강진단을 실시한다.",
      "guideContext": "망간노출 근로자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-002",
      "text": "작업환경측정 결과 망간과 그 화합물 농도가 노출기준 이상인 경우 당해 공정에서 망간과 그 화합물에 노출되는 모든 근로자에 대하여 특수건강진단 주기를 다음 회에 한하여 1/2로 단축한다.",
      "guideContext": "망간노출 근로자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-003",
      "text": "건강진단 결과 망간과 그 화합물에 의한 직업병 유소견자가 발견된 경우 당해 공정에서 망간과 그 화합물에 노출되는 모든 근로자에 대하여 특수건강진단 주기를 다음 회에 한하여 1/2로 단축한다.",
      "guideContext": "망간노출 근로자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-004",
      "text": "특수건강진단 또는 임시건강진단 결과 망간과 그 화합물에 대하여 특수건강진단 실시주기를 단축하여야 한다는 의사의 판정을 받은 근로자는 그 주기를 다음 회에 한하여 1/2로 단축한다.",
      "guideContext": "망간노출 근로자의 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": [
        "SR-SPECIAL_WORKER-001"
      ]
    },
    {
      "identifier": "CI-H136-005",
      "text": "1차 검사항목으로 직업력 및 노출력 조사, 과거병력 조사(주요표적장기와 관련된 질병력 조사), 자각증상 조사(문진표 작성내용 확인), 임상진찰 및 검사(호흡기계: 청진, 흉부방사선(후전면), 신경계: 신경계 증상 문진, 신경증상에 유의하여 진찰)를 실시한다.",
      "guideContext": "망간노출 근로자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-006",
      "text": "2차 검사항목으로 호흡기계(흉부방사선(측면), 폐활량 검사) 및 신경계(신경행동검사, 임상심리검사, 신경학적 검사)를 실시한다.",
      "guideContext": "망간노출 근로자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-007",
      "text": "근로자가 중추신경계 등의 증상 및 증세를 보여 사업주가 수시건강진단의 필요성에 대하여 자문을 요청한 경우 건강진단기관의 의사는 자문에 응하여야 하며, 수시건강진단의 필요성 여부에 대하여 사업주에게 자문결과서를 통보한다.",
      "guideContext": "망간노출 근로자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-008",
      "text": "많은 양의 물을 사용하여 적어도 15분 동안 눈을 세척하고 곧바로 의사의 치료를 받는다.",
      "guideContext": "망간노출 근로자의 건강관리 - 응급조치 (법령 근거 미확인)",
      "additionalDetail": "눈 접촉 시 응급조치",
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-009",
      "text": "오염된 의복 및 신발을 제거하는 동안 적어도 15분 동안 비누와 물로 씻고, 필요시 의사의 치료를 받는다.",
      "guideContext": "망간노출 근로자의 건강관리 - 응급조치 (법령 근거 미확인)",
      "additionalDetail": "피부 접촉 시 응급조치",
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-010",
      "text": "오염된 의복 및 신발은 재사용 전에 철저히 건조시키고 세탁한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 응급조치 (법령 근거 미확인)",
      "additionalDetail": "피부 접촉 후 의복 관리",
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-011",
      "text": "오염되지 않은 지역으로 옮긴다.",
      "guideContext": "망간노출 근로자의 건강관리 - 응급조치 (법령 근거 미확인)",
      "additionalDetail": "흡입 시 응급조치",
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-012",
      "text": "호흡하지 않을 경우 인공호흡을 하고 즉시 의사의 치료를 받는다.",
      "guideContext": "망간노출 근로자의 건강관리 - 응급조치 (법령 근거 미확인)",
      "additionalDetail": "흡입 후 호흡 정지 시 응급조치",
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-013",
      "text": "많은 양을 삼켰다면 즉시 응급실로 후송하여 의사의 치료를 받는다.",
      "guideContext": "망간노출 근로자의 건강관리 - 응급조치 (법령 근거 미확인)",
      "additionalDetail": "섭취 시 응급조치",
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-014",
      "text": "가능하다면 독성이 덜한 물질로 대체한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "10.2.1",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-H136-015",
      "text": "밀폐식 공정을 사용하고 작업자는 공정에서 격리시킨다.",
      "guideContext": "망간노출 근로자의 건강관리 - 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10.2.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H136-016",
      "text": "국소배기 또는 공정밀폐 환기장치를 설치하고 해당 노출기준에 적합한지 확인한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "10.2.3",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H136-017",
      "text": "호흡용 보호구는 한국산업안전보건공단의 검정(\"안\" 마크)을 필한 제품을 사용한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.3.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H136-018",
      "text": "비산물 또는 유해한 액체로부터 보호되는 보안경을 착용한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-019",
      "text": "작업장 가까운 곳에 분수식 눈 세척시설 및 비상 세척설비(샤워식)를 설치한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H136-020",
      "text": "사업주는 망간을 취급하는 실내 작업장, 휴게실 또는 식당 등에 대해서는 망간으로 인한 오염을 제거하기 위하여 청소를 실시한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 위생관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "10.4.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H136-021",
      "text": "사업주는 망간을 취급하는 작업장에서는 근로자가 흡연을 하거나 음식물을 먹지 않도록 한다.",
      "guideContext": "망간노출 근로자의 건강관리 - 위생관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.4.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    }
  ],
  "domainTerms": [
