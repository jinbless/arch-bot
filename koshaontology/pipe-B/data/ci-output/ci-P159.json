  "domainTerms": [
    {
      "identifier": "DT-P159-001",
      "term": "산소 과잉",
      "definition": "공기 중 산소 농도가 부피 기준으로 23.5% 이상인 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P159-002",
      "term": "산소 결핍",
      "definition": "공기 중 산소 농도가 부피 기준으로 18% 미만인 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P159-003",
      "term": "불활성 기체",
      "definition": "아르곤, 질소 등 정상 온도와 압력에서 다른 물질들과 반응을 하지 않는 기체로 일반적으로 질소 또는 아르곤을 말한다. 이외 헬륨 등은 별도로 검토해야 한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P159-01",
      "processOrder": 1,
      "processName": "벤트 설계 조건 파악",
      "safetyMeasures": "배출 기체의 유속, 유량, 최종 온도, 최초 농도를 파악하고, 산소 과잉 또는 산소 결핍 가능성, 배출 빈도, 외부 환경(주변 설비 위치, 작업자 접근 범위, 바람 방향), 사업장 내외부 상주 인력 영향을 고려한다.",
      "requiredPPE": [],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-P159-02",
      "processOrder": 2,
      "processName": "벤트 위치 및 방향 결정",
      "safetyMeasures": "벤트된 기체가 공정 유체 유입구, 건축물, 공조시설 내로 재유입되지 않도록 하고, 산소 과잉/결핍 방지 조치가 없는 한 실내 배출을 금지하며, 작업자 접근 가능 지역에는 벤트를 설치하지 않는다. 산소 벤트와 인화성 가스 벤트/플레어 시스템 간 이격거리를 확보한다.",
      "requiredPPE": [],
      "sourceSection": "4.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-P159-03",
      "processOrder": 3,
      "processName": "벤트 높이 및 수평 안전거리 산정",
      "safetyMeasures": "벤트 높이는 최소 3m 이상으로 설정하고, 벤트 유속 1m/s 이상에서는 부록 1을 적용하여 높이와 수평 거리를 결정한다. 유속 30m/s 이하 저압 기체에는 대기확산 모델링을, 1m/s 미만 유속에서는 전산유체역학(CFD) 모델링을 적용한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-P159-04",
      "processOrder": 4,
      "processName": "대기확산 모델링 수행",
      "safetyMeasures": "기체성상, 배출 유량 및 속도, 기후조건, 지형조건, 공정 배출 시나리오를 고려하여 KOSHA GUIDE P-102에 따라 수행한다. 벤트 방향은 수평부터 수직, 45도로 변경하면서 검토하고, 산소 관심 농도(23.5%, 18%)를 대기 중 관심 농도로 환산하여 적용한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-P159-05",
      "processOrder": 5,
      "processName": "기후조건 검토 및 반영",
      "safetyMeasures": "최악의 기후 조건(고온, 안정적 대기 상태, 저속 벤트 유속)을 고려하며, 희석 효과를 높이기 위해 최대 가능한 벤트 유속을 기준으로 계산한다. 장애물은 모델링에 고려되지 않으므로 별도 검토가 필요하다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-P159-06",
      "processOrder": 6,
      "processName": "초저온 액체 배출 설계",
      "safetyMeasures": "초저온 액체 벤트 배출은 일정 구역으로 한정하고, 소형 벤트와 드레인은 캐치 트레이에 포집하여 기화시킨다. 공동 배관 역류에 의한 밸브 동결 및 과압 발생을 제어하고, 초저온 액체 안전밸브의 동결에 의한 지속 배출 위험에 주의한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    }
  ],
