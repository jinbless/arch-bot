  "domainTerms": [
    {
      "identifier": "DT-M134-001",
      "term": "신선기",
      "definition": "철선, 동선 등의 선재를 다이스 홀 내부로 통과시키면서 냉간가공에 의해 직경을 점차적으로 감소시키는 기기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M134-002",
      "term": "오버헤드(Overhead)형 신선기",
      "definition": "다이스를 통과한 선재를 기계 상단에 분리되어 있는 드럼에 통과시키는 방식의 신선기로서 형태가 단순하여 비교적 좁은 공간에 설치가 가능한 신선기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M134-003",
      "term": "연속스트레이트(Straight)형 신선기",
      "definition": "드럼이 동일라인 상에 연속적으로 설치되어 고속으로 선재를 가공하는 설비로서 기계적으로 정밀한 연동과 다량생산이 가능한 신선기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M134-004",
      "term": "다이스(Dies)",
      "definition": "선재를 홀 내부로 통과시켜 직경을 감소시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M134-005",
      "term": "드럼(Drum)",
      "definition": "선재가 다이스를 통과하도록 선재를 팽팽히 당겨주는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M134-006",
      "term": "안내롤(Guide roll)",
      "definition": "선재의 진행 방향을 바꾸어주는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M134-007",
      "term": "캐비닛형 덮개",
      "definition": "신선기 전체를 둘러싼 것으로, 주요 구성요소들은 덮개 내부에서 구동하는 방식의 덮개를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
