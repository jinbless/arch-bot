  "checklistItems": [
    {
      "identifier": "CI-H97-001",
      "text": "빈혈이 진단된 경우 빈혈 원인에 대한 추가적인 검사와 빈혈 원인에 따른 적절한 치료가 시행되도록 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-002",
      "text": "이차적 적혈구증가증이 진단된 경우 만성폐질환, 심장질환 등 관련 질환에 대한 적절한 치료와 금연이 시행되도록 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-003",
      "text": "백혈구 증가의 가장 많은 원인은 감염증이다. 감염증이 의심되면 적절한 치료를 받도록 하고, 2-4주 뒤에 추적검사가 시행되도록 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-004",
      "text": "백혈구가 감소되었을 때 적혈구나 혈소판의 감소가 동반되지 않으면 바이러스 감염, 약물 사용 등으로 인해 일시적으로 나타나는 소견일 가능성이 높으므로 2-4주 뒤에 추적검사가 시행되도록 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-005",
      "text": "금속열이나 폐포염과 같은 직업적 노출에 의해 동반되는 일시적인 호중구수 증가는 흔하게 나타나는 비특이적인 현상으로 감별진단을 요하지 않는다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-006",
      "text": "추적검사에서 백혈구 감소나 증가가 지속되는 경우, 혈소판이나 적혈구수가 감소가 동반되는 경우 원인질환을 알기 위한 정밀검사가 시행되도록 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-007",
      "text": "경증의 혈소판 감소나 증가할 때에는 2-4주 뒤에 검사를 반복하며 경과를 관찰한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-008",
      "text": "혈소판수가 80,000/μL 이하이거나 50만/μL 이상이면 원인질환을 알기 위해 정밀검사가 시행되도록 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-009",
      "text": "혈소판 감소나 증가가 지속되거나, 시간 경과에 따라 변화 양상의 경향이 보이는 경우, 백혈구나 적혈구수가 감소가 동반되는 경우 원인질환을 알기 위해 정밀검사가 시행되도록 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-010",
      "text": "빈혈을 가진 근로자가 피로를 호소하는 경우 운동부하검사로 그 수준을 평가하고, 최대산소섭취량 백분율에 따른 근무시간을 조정하거나 업무의 육체요구도를 감소시킨다(참고: 운동부하검사지침, H-43- 2011).",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-011",
      "text": "빈혈을 가진 근로자는 산소 농도가 부족한 공간에서의 작업을 제한한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-012",
      "text": "혈구용적치가 32% 미만이면 항공기 승무원으로는 부적당하며, 잠수작업자의 경우 혈색소가 남자는 12 g/dL, 여자는 10.5 g/dL 이상이 작업허용기준이다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-013",
      "text": "절대호중구수가 1,500/μL 이하인 근로자는 감염에 대한 감수성이 높으므로 세균감염의 위험성이 높거나, 즉각적으로 의료서비스를 이용할 수 없는 경우 작업을 제한한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-014",
      "text": "절대호중구수가 1,000/μL 미만이면 발열을 동반한 감염이 우려되므로 작업을 제한한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-015",
      "text": "혈소판수가 20,000/μL 이하인 경우 자발적 출혈의 위험이 높으므로 작업을 제한한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-016",
      "text": "빈혈을 가진 근로자가 피로를 호소하는 경우 근무시간, 휴식시간, 교대근무나 야간근무, 육체 작업에 대한 조정을 고려하여야 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사업주 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-017",
      "text": "빈혈을 가진 근로자가 산소 농도가 부족한 공간에서 작업을 해야 하는 경우 근무제한 조치를 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "사업주 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-018",
      "text": "절대호중구수가 감소한 근로자가 세균감염의 위험성이 높은 작업에 종사하지 않도록 근무제한 조치를 한다",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "사업주 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-019",
      "text": "혈소판수 감소로 자발적 출혈의 위험이 있는 근로자에 대해서는 근무제한 조치를 한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": null,
      "workProcessPhase": "사업주 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H97-020",
      "text": "조혈기계 이상을 가진 근로자가 골수독성물질이나 빈혈을 유발할 수 있는 유해인자에 노출이 되지 않도록 작업전환, 보호구 착용 등의 적절한 조치를 취한다.",
      "guideContext": "조혈기계 검사 이상근로자의 관리",
      "additionalDetail": "골수독성물질: 벤젠, 납, 비소, 전리방사선 등",
      "workProcessPhase": "사업주 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H97-001",
      "term": "조혈기계 검사",
      "definition": "골수에서 만들어지는 각종 혈액세포들의 이상을 검사하는 것을 말한다. 검사 항목은 백혈구수, 백혈구백분율, 적혈구수, 혈색소, 적혈구용적치, 적혈구지수, 혈소관수 등이다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H97-01",
      "processOrder": 1,
      "processName": "건강진단 실시 및 조혈기계 검사결과 확인",
      "safetyMeasures": "산업안전보건법 제130조에 따른 건강진단을 실시하고, 조혈기계 검사결과에서 빈혈 등 이상 소견 여부를 확인한다. 빈혈 의심 시 일반혈액검사, 망상적혈구, 적혈구지수, 말초혈액도말검사, 소변 및 대변 잠혈반응검사를 시행한다.",
      "requiredPPE": [],
      "sourceSection": "4.1.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H97-02",
      "processOrder": 2,
      "processName": "의학적 조치 (추가검사 및 치료 연계)",
      "safetyMeasures": "빈혈 진단 시 원인에 대한 추가 검사 및 적절한 치료 시행. 백혈구 이상 시 2-4주 후 추적검사 시행. 혈소판수 80,000/μL 이하 또는 50만/μL 이상 시 정밀검사 시행.",
      "requiredPPE": [],
      "sourceSection": "8.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H97-03",
      "processOrder": 3,
      "processName": "업무적합성평가",
      "safetyMeasures": "빈혈 근로자 피로 호소 시 운동부하검사로 수준 평가. 빈혈 근로자 산소 부족 공간 작업 제한. 절대호중구수 1,500/μL 이하 시 감염 위험 작업 제한. 혈소판수 20,000/μL 이하 시 작업 제한.",
      "requiredPPE": [],
      "sourceSection": "8.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H97-04",
      "processOrder": 4,
      "processName": "사업주 조치 (근무제한 및 작업전환)",
      "safetyMeasures": "빈혈 근로자 근무시간·휴식시간·교대근무 조정. 산소 부족 공간 작업 근무제한. 호중구 감소 근로자 감염 위험 작업 제한. 골수독성물질 노출 방지를 위한 작업전환 및 보호구 착용 조치.",
      "requiredPPE": [
        "보호구"
      ],
