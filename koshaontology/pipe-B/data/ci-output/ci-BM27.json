  "checklistItems": [
    {
      "identifier": "CI-BM27-001",
      "text": "자동 오토클레이브 시스템에서는 위험 발생 시 잔류 에너지를 안전하게 방출할 수 있도록 모든 안전장치를 페일 세이프(Fail-safe)로 구성해야 한다.",
      "guideContext": "오토클레이브 자동 제어시스템",
      "additionalDetail": "전원 차단(정전), 압력 손실, 과압, 과열, 비상 정지 작동, 인터록 또는 센서의 불일치 등 위험 발생 시 적용",
      "workProcessPhase": "자동 제어시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-BM27-002",
      "text": "자동 시스템이 안전한 상태로 전환될 때 오토클레이브의 유체 유입 밸브(Inlet valve)는 닫히고, 배기 밸브(Exhaust valve)는 열려야 한다. 또한 밸브 위나 근처에는 압력 게이지가 위치하여 유체 라인 내의 압력이 완전히 해소되었는지 확인할 수 있어야 한다.",
      "guideContext": "오토클레이브 자동 제어시스템",
      "additionalDetail": null,
      "workProcessPhase": "자동 제어시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035",
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-003",
      "text": "오토클레이브에 가해지는 압력을 차단하는 조치를 반드시 갖추어야 한다. 이를 위해 일반적으로 페일 세이프형의 자동 밸브 또는 수동 밸브를 설치한다. 관련 유체를 이송하고 차단할 때는 이중격리밸브(Double isolation valve)를 사용해야 한다.",
      "guideContext": "오토클레이브 자동 제어시스템",
      "additionalDetail": null,
      "workProcessPhase": "자동 제어시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-BM27-004",
      "text": "오토클레이브 내부가 고온·고압이 될 경우 고압에서 폭주반응에 의한 폭발을 방지할 수 있도록 안전밸브를 설치하고 압력상승 및 과열방지를 위한 위험경보기(Safety alarm)를 설치하여야 한다.",
      "guideContext": "오토클레이브 자동 제어시스템",
      "additionalDetail": null,
      "workProcessPhase": "자동 제어시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049",
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-BM27-005",
      "text": "자동화 공정 제어에서 인터록이나 센서 불일치로 인한 위험을 방지하기 위해 인터록 및 안전장치의 기능을 확인하여야 한다. 이는 독립적인 센서를 이용하여 인터록과 안전장치를 지속적으로 모니터링하면서 이상 발생 시 오토클레이브를 안전한 상태로 유지하고 동시에 고장 상태를 즉각적으로 보고되어야 한다.",
      "guideContext": "오토클레이브 자동 제어시스템",
      "additionalDetail": null,
      "workProcessPhase": "자동 제어시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-006",
      "text": "수동식 오토클레이브는 설비의 안전한 상태와 인터록 및 안전장치의 정상 작동 여부를 확인하기 위해 작업자가 절차에 따라 수행하여야 한다.",
      "guideContext": "오토클레이브 수동 제어시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 제어시스템 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-007",
      "text": "작업자가 오토클레이브 상태를 교차 점검할 수 있도록 도어 위치를 육안으로 확인할 수 있는 표시기와 추가적인 압력 게이지를 설치하는 것이 사고 위험을 줄일 수 있다.",
      "guideContext": "오토클레이브 수동 제어시스템",
      "additionalDetail": null,
      "workProcessPhase": "수동 제어시스템 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-008",
      "text": "오토클레이브 내부에 작업자가 들어갈 수 있을 만큼 충분히 큰 경우, 작업자가 내부에 있을 때 도어가 닫히거나 오토클레이브 가압 사이클이 시작되는 것을 방지하는 장치를 오토클레이브 도어에 설치하여야 한다.",
      "guideContext": "오토클레이브 내부 작업자 보호",
      "additionalDetail": null,
      "workProcessPhase": "오토클레이브 내부 진입 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-BM27-009",
      "text": "작업자가 오토클레이브 내부에 진입할 수 있을 경우, 공정에 따라 사고 위험을 줄이기 위해 내부에 안전 경고장치나 비상 정지 회로를 자동으로 작동시키는 풀 코드(Pull cord)를 설치하여야 한다.",
      "guideContext": "오토클레이브 내부 작업자 보호",
      "additionalDetail": null,
      "workProcessPhase": "오토클레이브 내부 진입 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-MACHINE-003"
      ]
    },
    {
      "identifier": "CI-BM27-010",
      "text": "인접한 오토클레이브에 부적절한 가압이나 화상을 방지하기 위해 가능한 경우, 독립적인 배수 및 배출 라인을 설치하여야 한다. 만일 독립적인 배관 설치가 불가능한 경우, 한번에 하나의 오토클레이브 배출 밸브만 열릴 수 있도록 추가적인 안전장치를 설치하여야 한다.",
      "guideContext": "오토클레이브 배출·배수 라인 안전",
      "additionalDetail": null,
      "workProcessPhase": "배출·배수 라인 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-BM27-011",
      "text": "어느 한 오토클레이브에서 배출된 유체를 다른 오토클레이브에 재공급하는 경우, 이송 배관에 반드시 밸브를 설치해야 한다. 이 밸브는 유체가 공급되는 오토클레이브의 도어 잠금장치와 인터록이 되어야 한다.",
      "guideContext": "오토클레이브 배출·배수 라인 안전",
      "additionalDetail": null,
      "workProcessPhase": "배출·배수 라인 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-BM27-012",
      "text": "외부 공급원(증기, 공기 또는 기타 가스)에서 압력을 가할 때는 도어 고정 장치와 압력 공급 밸브 사이에 인터록이 되어야 한다.",
      "guideContext": "오토클레이브 도어 폭발적 개방 방지",
      "additionalDetail": "도어나 뚜껑이 완전히 닫히지 않고 고정 장치가 완전히 체결되지 않으면 챔버가 완전히 밀폐되지 않아 오토클레이브에 압력이 가해질 수 없도록 하는 인터록",
      "workProcessPhase": "도어 잠금 및 가압",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-013",
      "text": "용기 내부 액체를 가열하여 압력을 발생시킬 때는 도어 고정 장치와 열원 간에 인터록이 되어야 한다.",
      "guideContext": "오토클레이브 도어 폭발적 개방 방지",
      "additionalDetail": null,
      "workProcessPhase": "도어 잠금 및 가압",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-014",
      "text": "펌프를 이용하는 경우 펌프는 도어 고정 장치가 완전히 체결되어 있지 않으면 압력을 가할 수 없어야 한다.",
      "guideContext": "오토클레이브 도어 폭발적 개방 방지",
      "additionalDetail": null,
      "workProcessPhase": "도어 잠금 및 가압",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-015",
      "text": "자동 도어 개폐 시스템의 일부로 도어 위치 모니터링을 반드시 검증해야 하며 두 개 이상의 위치 센서를 설치해야 한다.",
      "guideContext": "오토클레이브 도어 폭발적 개방 방지",
      "additionalDetail": null,
      "workProcessPhase": "도어 잠금 및 가압",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-016",
      "text": "작업자가 도어 위치를 직접 확인할 수 있도록 시각적 표시기를 설치하는 것을 권장한다.",
      "guideContext": "오토클레이브 도어 폭발적 개방 방지",
      "additionalDetail": null,
      "workProcessPhase": "도어 잠금 및 가압",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-017",
      "text": "도어 고정 장치를 분리하기 전에 오토클레이브 내부 압력을 대기압 수준으로 낮추기 위해 반드시 배기해야 한다.",
      "guideContext": "오토클레이브 도어 개방 전 감압 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-018",
      "text": "챔버 내부에 남아 있는 잔류압력으로 인해 도어 또는 뚜껑이 갑자기 열리지 않도록 주의하여야 한다. 이를 위해 적합한 장치로는 일반 도어 잠금 장치의 단일 부품 고장을 방지할 만큼 충분히 견고한 안전장치이며 안전장치는 정상 작동 압력을 견딜 수 있어야 한다. 안전장치는 자동 및 수동으로 작동할 수 있어야 한다.",
      "guideContext": "오토클레이브 잔류압력 안전 (법령 근거 미확인)",
      "additionalDetail": "도어 고정 장치가 해제된 경우 또는 도어 실이 파손된 경우 독립적으로 해제해야 한다",
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-019",
      "text": "잔류압력이 남아 있는 상태에서 도어 실이 고착될 위험이 있는 경우 잠금장치를 완전히 해제하기 전에 도어 실을 깨뜨려야 하며 도어가 잠금 상태로 유지되어야 한다. 만약 이 방식이 불가능한 경우에는 도어를 부분적으로 해제한 후 최대 8 mm 이하로만 열리도록 제한해야 한다.",
      "guideContext": "오토클레이브 잔류압력 안전 (법령 근거 미확인)",
      "additionalDetail": "적합한 장치는 도어가 잠금을 해제하지 않아도 독립적으로 해제해야 하며, 도어가 틈을 내어 살짝 열리도록 하여 실이 파손될 때까지는 완전히 해제되어서는 안 된다",
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-020",
      "text": "뜨거운 내용물로 인한 위험을 줄이기 위해서는 오토클레이브 내부 내용물 온도가 안전한 수준까지 내려가지 않으면 도어 또는 뚜껑이 열리지 않도록 하여야 한다. 사이클 종료 시 챔버 내에서 가장 온도가 높은 부위에 온도 센서를 설치하여 문 또는 뚜껑과 인터록이 되도록 설치하여야 한다.",
      "guideContext": "오토클레이브 고온 내용물 화상 방지",
      "additionalDetail": null,
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049",
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-BM27-021",
      "text": "모든 오토클레이브에는 작업자가 쉽게 볼 수 있는 곳에 정확하고 적합한 압력표시기가 반드시 설치되어야 한다. 일반적으로 압력표시기는 오토클레이브 본체 또는 근처에 있어야 한다.",
      "guideContext": "오토클레이브 도어 개방 전 압력 확인",
      "additionalDetail": null,
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-022",
      "text": "대형 오토클레이브의 경우 잔류압력(Residual pressure)이 압력계에 표시되지 않을 만큼 낮을 수 있다. 그러나 큰 도어 표면적에 작용하는 잔류압력은 갑자기 도어를 열 때 큰 힘으로 급격히 방출될 수 있어 매우 위험하다. 이러한 사고를 예방하기 위해 보통 배기 밸브(Vent valve) 또는 테스트 록(Test cock)을 설치하여 방지하여야 한다.",
      "guideContext": "오토클레이브 도어 개방 전 압력 확인",
      "additionalDetail": "테스트 록은 수동으로 작동하거나 자동 공정 제어의 일부로 구성될 수 있다",
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-023",
      "text": "자동제어시스템에서는 배기 밸브는 하드와이어링(Hard-wired) 회로로 구성되어야 하며 독립된 센서들이 오토클레이브 내 압력이 없음을 확인해 준다. 또한 배기 밸브와 도어 위치 인터록이 연동되어 작동된다.",
      "guideContext": "오토클레이브 도어 개방 전 압력 확인",
      "additionalDetail": "테스트 시퀀스 버튼을 눌러 배기 밸브를 열리도록 한다",
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-024",
      "text": "수동제어시스템에서는 배기 밸브에서 발생하는 압력 방출음을 듣거나 증기 등이 눈에 보이는 방식으로 압력 해제 여부를 확인한다. 배기 밸브의 배출구는 작업자가 다치지 않도록 반드시 적절한 위치에 배치되어야 한다.",
      "guideContext": "오토클레이브 도어 개방 전 압력 확인",
      "additionalDetail": null,
      "workProcessPhase": "감압 및 도어 개방",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-BM27-025",
      "text": "작업자 이외의 다른 사람의 위험을 줄이기 위해 도어 또는 뚜껑이 가능한 주요 도로(통행로)에서 멀리 떨어지도록 설치해야 한다.",
      "guideContext": "오토클레이브 설치 위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "오토클레이브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-026",
      "text": "오토클레이브의 제어장치는 도어 고장으로 인해 발생하는 잠재적 에너지 방출, 압력 방출 및 배출 또는 배수 배출구에서 멀리 떨어진 곳에 배치해야 한다.",
      "guideContext": "오토클레이브 설치 위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "오토클레이브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-027",
      "text": "배출구는 멀리 떨어진 곳에 설치하거나 배출 장치의 안전을 확보하기 위해 배출 장치로부터 배출구까지 추가 배관을 설치하여 위험이 발생하지 않도록 하여야 한다.",
      "guideContext": "오토클레이브 설치 위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "오토클레이브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-028",
      "text": "오토클레이브에 제품을 적재하기 위해 트롤리를 사용하는 경우, 보행자 접근 플랫폼을 적재 목적으로 사용하지 않아야 한다. 제품 하중을 견딜 수 있는 전용 트롤리와 레일을 설치하여야 한다. 어떠한 경우에도 트롤리, 레일 및 접근 플랫폼의 최대 허용하중을 초과하지 않도록 하여야 한다.",
      "guideContext": "오토클레이브 설치 위치",
      "additionalDetail": null,
      "workProcessPhase": "오토클레이브 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-BM27-029",
      "text": "작업자에게 제공되는 작업 지침과 교육은 오토클레이브 시스템을 안전하게 운용하는 데 필요한 모든 절차와 정보뿐만 아니라 비상시 지켜야 할 절차도 반드시 교육에 포함되어야 한다. 또한 기존 작업자에게 정기적인 보수교육을 실시하여야 한다.",
      "guideContext": "오토클레이브 작업지침 및 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-030",
      "text": "건강 및 안전에 대한 위험성 평가를 실시하지 않거나, 적절한 안전 작업 절차를 마련하지 않거나, 밀폐공간 출입에 대한 교육을 제공하지 않았다면 오토클레이브 내부의 밀폐공간에 들어가도록 허가해서는 안된다.",
      "guideContext": "오토클레이브 밀폐공간 진입 안전",
      "additionalDetail": null,
      "workProcessPhase": "오토클레이브 내부 진입 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-BM27-031",
      "text": "관리감독자는 작업자가 작업을 할 때 상호 합의된 안전 작업 절차를 준수하는지 확인하여야 한다. 또한 관리감독자는 자신의 업무를 효과적으로 수행할 수 있는 역량을 갖춰야 하며 작업 절차에 변경이 있을 경우, 재교육을 받아야 한다.",
      "guideContext": "오토클레이브 작업지침 및 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-032",
      "text": "담당 직원은 관련 유체가 담긴 오토클레이브를 서면검사 계획(Written scheme of examination)에 따라 주기적으로 검사해야 한다. 오토클레이브 사용자는 오토클레이브를 사용하기 전에 서면검사 계획에 따라 공식적으로 검사를 받아야 하는 시스템 부품, 요구되는 검사의 형태, 사전작업에 대한 세부 사항, 검사 주기, 검사 결과의 상세 내용을 포함하여 적용되고 있는지 반드시 확인하여야 한다.",
      "guideContext": "오토클레이브 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정기검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-033",
      "text": "오토클레이브 사용자는 담당 직원이 오토클레이브의 사용 현황을 파악하고 검사를 수행할 수 있도록 운전 및 정비 기록 등 관련 정보를 제공해야 한다.",
      "guideContext": "오토클레이브 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정기검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-034",
      "text": "사용자는 시스템의 중요한 수리 또는 변경 사항을 담당 직원에게 알려야 한다.",
      "guideContext": "오토클레이브 유지보수 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-035",
      "text": "오토클레이브가 제대로 정비되도록 적절하고 효과적인 절차를 마련해야 한다. 제조업자 또는 공급업자가 시스템의 전체 또는 일부에 대해 유지보수 지침을 제공한 경우, 유지관리 지침에 따라 유지관리 계획을 수립해야 한다. 현장 운영 조건을 충분히 반영하지 못하였다면 필요에 따라 보완해야 한다.",
      "guideContext": "오토클레이브 유지보수 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-036",
      "text": "오토클레이브 시스템에 대해 숙련되고 결함을 인지할 수 있도록 충분히 훈련되어 자격이 입증된 인력에 의해 정기적으로 계획된 예방정비(Planned preventive maintenance)를 시행하여야 한다.",
      "guideContext": "오토클레이브 유지보수 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-037",
      "text": "단일 부품의 고장으로 인해 위험이 발생할 수 있는 모든 부품을 포함하여 오토클레이브의 모든 중요 부품을 효율적인 작동 상태로 유지하기 위한 적절한 모니터링 체계가 있어야 한다. 일반적으로 모든 주요 안전 장치가 효과적으로 작동하는지를 점검하는 일상 또는 교대 점검을 포함하며 이러한 점검은 필요한 교육을 이수한 작업자가 수행하여야 한다.",
      "guideContext": "오토클레이브 유지보수 관리",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-BM27-038",
      "text": "시스템 운전 중에 발견된 문제점들에 대해 위험성평가를 통하여 유지관리 시에 적절한 개선조치를 취해야 한다.",
      "guideContext": "오토클레이브 유지보수 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-039",
      "text": "정비 점검, 시험, 결함, 수리 및 개조 등의 사항을 포함하여 포괄적인 정비 이력을 관리하여야 한다. 사전에 문제점을 파악하고 해결할 수 있도록 시스템에 중대한 수리 또는 변경 사항을 담당 직원에게 알려주어야 한다.",
      "guideContext": "오토클레이브 일반 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-040",
      "text": "도어잠금 조립품(Door locking assembly)은 정상 작동 상태인지 확인하고 체결 볼트가 모두 단단히 조여져 있는지, 용접부에 균열이 없는지, 조임 메커니즘이 올바른 공차 내에 있는지 정기적으로 점검해야 한다. 진동으로 인해 볼트가 풀리는 현상이 흔하게 발생하므로 적절한 나사 잠금 장치를 사용해야 한다.",
      "guideContext": "오토클레이브 일반 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-041",
      "text": "3단 도어잠금 조립품(Three-part door locking assembly)의 경우, 도어를 용기 가장자리에 고정하는데 사용되는 단일 구성 요소인 회전 링은 안전에 중요한 부품이며, 연결부의 지속적인 건전성을 유지하도록 정기적인 유지보수를 수행해야 한다. 치수 점검과 육안 검사를 주기적 점검 항목에 포함하여 링이 편심 상태로 회전하지 않는지도 반드시 확인해야 한다.",
      "guideContext": "오토클레이브 일반 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM27-042",
      "text": "도어 조립품은 충분히 윤활되어 있어야 한다. 예를 들면 주입구에는 고온 그리스(High-temperature grease)를 사용하고, 도어 씰 표면에는 흑연 페이스트(Graphite paste)를 직접 도포해야 한다.",
      "guideContext": "오토클레이브 일반 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BM27-001",
      "term": "오토클레이브(Autoclave)",
      "definition": "문이나 뚜껑이 있어 내부 접근이 가능한 구조로서 특수 설계, 제작된 압력용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM27-002",
      "term": "인터록(Interlock)",
      "definition": "공정 또는 작업의 매개변수(Parameter)인 압력, 온도, 유량, 높이, 속도, 하중, 뚜껑의 개폐 및 위험점의 신체접촉 등을 센서로 감지한 후 그 신호를 전기적, 기계적, 유압 및 공압에 의하여 기계의 작동부를 움직여 정상운전이 되도록 자동제어 하거나 정상으로 작동하기 위한 조건이 만족하지 않으면 기계를 작동할 수 없도록 하는 기구(Mechanism)를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM27-003",
      "term": "페일 세이프(Fail Safe)",
      "definition": "시스템에 고장이 생겨도 사고나 재해로 발전하지 않고 항상 안전한 방향으로 유지되는 기능을 갖도록 하는 기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM27-004",
      "term": "잔류압력(Residual pressure)",
      "definition": "시스템이 작동을 멈춘 후에도 완전히 해제되지 않고 남아 있는 압력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BM27-01",
      "processOrder": 1,
      "processName": "오토클레이브 운전 전 안전 점검",
      "safetyMeasures": "인터록 및 안전장치 정상 작동 여부 확인, 도어 고정 장치 완전 체결 확인, 도어 위치 센서 및 압력표시기 확인, 서면검사 계획에 따른 검사 적용 여부 확인",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "WP-BM27-02",
