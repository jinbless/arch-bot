  "checklistItems": [
    {
      "identifier": "CI-P41-001",
      "text": "분진이송은 가능한 한 원통형 덕트를 사용하며, 수평면을 피하고 경사를 유지한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치",
      "additionalDetail": null,
      "workProcessPhase": "분진 이송 설비 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-002",
      "text": "폭발억제장치를 설치하는 경우에는 폭발압 배출장치를 병행하여 설치하는 것이 일반적이다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치",
      "additionalDetail": null,
      "workProcessPhase": "폭발억제장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-003",
      "text": "분진이 항시 존재하는 백 필터의 경우에는 스프링클러 설비, 물분무 설비 등을 설치한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치",
      "additionalDetail": null,
      "workProcessPhase": "소화설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-004",
      "text": "물을 사용하는 소화설비가 설치된 경우에는 방사된 물이 적절하게 배수될 수 있도록 하여 소화수 접적에 의한 전도 및 타 장치 손상 등을 피하도록 하여야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소화설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-005",
      "text": "방출구 면적은 가능한 한 균형이 있고 대칭적으로 분포하여야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-006",
      "text": "방출구의 면적은 폭발허용최대압력을 미리 설정한 안전수준 이하로 제한할 수 있어야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-007",
      "text": "시간이 경과함에 따른 강도의 변화, 내부하중, 부식, 외부손상 등을 고려하여야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-008",
      "text": "배출되는 물질로 인한 인명피해와 재산손실을 최소화하기 위하여 방출구는 안전한 위치에 설치하여야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-009",
      "text": "방출구의 위치는 가능한 한 설비 상부에 높이 설치하고 주위에 장애물이 없어야 한다. 다만 분진집진기(백필터 등)는 중간 이하 또는 하부에 설치한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-010",
      "text": "방출구의 주위에는 경고할 수 있는 적절한 표지관을 설치하여야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-011",
      "text": "저감압력 (P_red)은 취급 밀폐공간 등의 극한강도 (Ultimate stress, 변형이 일어나지 않는 허용 강도)의 2/3를 초과하지 않아야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-012",
      "text": "변형이 허용되지 않을 경우에는 저감압력 (P_red)은 취급 밀폐공간 등의 항복 응력 (Yield strength)의 2/3를 초과하지 말아야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-013",
      "text": "주철과 같이 부서지기 쉬운 재질의 경우에는 특별한 보강을 하여야 한다. 보강조치를 하지 않을 경우에는 최고허용설계 강도는 극한강도의 25 %를 초과하지 말아야 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P41-014",
      "text": "방출구 뚜껑의 무게는 K_st가 250 bar-m/sec이하인 경우 40 kg/㎡ 이하로 한다.",
      "guideContext": "분진 폭발방지를 위한 폭연방출구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭연방출구 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P41-001",
      "term": "분진",
      "definition": "직경 500 μm 이하의 미세한 고체상의 분말을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-002",
      "term": "가연성 분진",
      "definition": "크기와 모양과 관계없이 적절한 비율로 공기와 혼합되거나 기타 산화물 매개체와 일정 농도이상으로 혼합되어 화재나 폭연의 위험성을 갖는 가연성 분말을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-003",
      "term": "폭연",
      "definition": "연소 속도가 음속보다 느리게 전파하는 폭발을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-004",
      "term": "폭연지수",
      "definition": "밀폐공간(체적,V)내에서 연소로 인하여 상승되는 최고 압력상승율(dP/dt)_max로부터 계산되며, 가연성 분진의 폭연지수는 K_st로 나타낸다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-005",
      "term": "밀폐공간",
      "definition": "전체가 밀폐되거나 또는 부분적으로 밀폐된 공간(체적)을 가진 밀폐 작업장, 용기, 탱크, 배관, 덕트 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-006",
      "term": "폭연방출구",
      "definition": "폭연이 발생 시 연소가스와 압력을 신속히 밀폐공간 등으로부터 안전한 외부로 방출시키기 위하여 설치하는 개방된 통기문, 폐쇄된 창문, 판넬 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-007",
      "term": "복합 혼합물",
      "definition": "가연성 가스와 가연성 분진의 혼합물을 말한다. 가연성 가스는 해당 가스 폭발하한계의 10 % 이상으로 포함한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-008",
      "term": "최대압력",
      "definition": "최적의 혼합물이 밀폐공간 등에서 폭연이 발생한 경우 최대로 상승할 수 있는 압력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-009",
      "term": "저감압력",
      "definition": "폭연이 방출되는 동안 방출설비내에 상승될 수 있는 최대 압력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-010",
      "term": "방출구 개방압력",
      "definition": "압력이 서서히(압력 증가율이 10 kPa/min 이하) 증가할 때 방출구 뚜껑이 열리는 압력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-011",
      "term": "저강도 설비",
      "definition": "10 kPa(0.1 bar)이하의 압력을 건딜 수 있는 밀폐공간 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P41-012",
      "term": "고강도 설비",
      "definition": "10 kPa(0.1 bar)를 초과하는 압력을 건딜 수 있는 밀폐공간 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P41-01",
      "processOrder": 1,
      "processName": "분진폭발 특성치 결정",
      "safetyMeasures": "폭연지수(K_st)와 최대압력(P_max)은 적어도 20L용량의 원형 압력용기내에서 연소실험을 통하여 결정한다. 분진폭연 위험등급(ST-1, ST-2, ST-3)을 분류한다.",
      "requiredPPE": [],
      "sourceSection": "7.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-P41-02",
      "processOrder": 2,
      "processName": "저감압력 및 설계압력 결정",
      "safetyMeasures": "저감압력(P_red)은 밀폐공간 등의 극한강도의 2/3를 초과하지 않아야 하며, 변형이 허용되지 않을 경우 항복응력의 2/3를 초과하지 않아야 한다. ASME 압력용기 설계 규정을 활용하여 최고허용압력(P_mawp)을 결정한다.",
      "requiredPPE": [],
      "sourceSection": "7.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-P41-03",
      "processOrder": 3,
      "processName": "폭연방출구 면적 계산",
      "safetyMeasures": "밀폐공간 등의 내부 초기압력이 0.2 barg 이하인 경우 최소 방출면적을 식 4에 따라 계산한다. L/D가 2 이상인 경우 식 5를 적용하며, 공기흐름 속도가 20m/sec 이상인 경우 식 6을 적용한다. 방출구 면적은 균형 있고 대칭적으로 분포하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "7.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-P41-04",
      "processOrder": 4,
      "processName": "폭연방출구 설치 및 시공",
      "safetyMeasures": "방출구는 안전한 위치에 설치하고, 가능한 한 설비 상부에 높이 설치하며 주위에 장애물이 없어야 한다. 방출구 뚜껑의 무게는 K_st가 250 bar-m/sec 이하인 경우 40 kg/㎡ 이하로 한다. 방출구 주위에 경고 표지판을 설치한다.",
      "requiredPPE": [],
      "sourceSection": "7.3",
      "relatedSR": null
    }
  ],
