  "checklistItems": [
    {
      "identifier": "CI-H221-001",
      "text": "사업주는 쾌적한 물류센터 공기를 유지하고, 근로자를 보호하기 위하여 물류센터 공기 중 오염물질을 표 1에 따라 관리할 것을 권고한다.",
      "guideContext": "물류센터 공기질 오염물질 관리",
      "additionalDetail": "관리기준: PM10 100㎍/㎥, PM2.5 50㎍/㎥, CO2 1,000ppm, CO 10ppm (8시간 시간가중평균농도 기준)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H221-002",
      "text": "물류센터 내 창문 등을 통한 자연환기를 활용하는 경우, 온도차와 풍력에 의해 실내 기류가 형성되도록 적정하게 설계하여야 한다.",
      "guideContext": "물류센터 환기 관리",
      "additionalDetail": null,
      "workProcessPhase": "환기 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H221-003",
      "text": "물류의 마찰, 충격 등에 의해 분진이 특히 많이 발생하는 작업의 경우 해당 발생원에 국소배기장치 설치를 통하여 분진의 발생을 방지할 수 있다.",
      "guideContext": "물류센터 국소배기 관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H221-004",
      "text": "산업안전보건법에서 규정하는 허가대상 유해물질, 관리대상 유해물질 취급장소와 분진작업 장소에는 적정한 성능 이상의 국소배기장치를 반드시 설치하여야 한다.",
      "guideContext": "물류센터 국소배기 관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-002",
        "SR-DUST-001",
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-H221-005",
      "text": "물류센터 내 차량 및 차량용 하역기계 등에서 발생하는 매연으로 인하여 미세먼지, 이산화탄소, 일산화탄소 등의 오염물질이 실내에서 발생하거나 유입되지 않도록 상·하차 작업 등 차량을 운행하지 않는 경우는 시동을 끄고 공회전을 하지 않도록 관리하여야 한다.",
      "guideContext": "물류센터 차량관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H221-006",
      "text": "특히, 겨울철에는 실내·외 기온 차이로 인한 외부 공기 유입량이 증가하므로 차량 난방을 위한 공회전을 지양하여야 한다.",
      "guideContext": "물류센터 차량관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H221-007",
      "text": "물류센터 내 바닥을 진공청소, 물청소 등을 통해 항상 청결하게 유지 관리하여 바닥에 축적되어 있는 분진의 재비산을 예방할 수 있다.",
      "guideContext": "물류센터 재비산 분진 예방",
      "additionalDetail": null,
      "workProcessPhase": "청소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H221-008",
      "text": "특히, 황사 및 미세먼지 등 외부 공기의 미세먼지 농도가 높을 경우 청소 주기를 가능한 한 짧게 설정하도록 한다.",
      "guideContext": "물류센터 재비산 분진 예방",
      "additionalDetail": null,
      "workProcessPhase": "청소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-DUST-003"
      ]
    },
    {
      "identifier": "CI-H221-009",
      "text": "통풍구, 창문, 출입문 등의 공기유입구를 재배치하는 등의 조치를 통하여 실외로부터 자동차 매연 또는 그 밖의 오염물질의 실내 유입을 저감 또는 예방할 수 있다.",
      "guideContext": "물류센터 재비산 분진 예방",
      "additionalDetail": null,
      "workProcessPhase": "시설 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H221-010",
      "text": "계절적 영향, 환경적 영향 등 외부 요인으로 인하여 환기를 이용한 공기질 개선이 어려운 경우 환기설비에 연결되어 설치되거나 독립적으로 운영가능한 공기정화시설을 설치하여 실내 미세먼지 농도를 감소시킬 수 있다.",
      "guideContext": "물류센터 공기정화시설 관리",
      "additionalDetail": null,
      "workProcessPhase": "공기정화시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H221-011",
      "text": "물류센터 내의 원활한 공기질 관리를 위하여 직독식 장비를 활용한 지속적인 모니터링을 권장한다.",
      "guideContext": "물류센터 공기질 모니터링",
      "additionalDetail": null,
      "workProcessPhase": "모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H221-012",
      "text": "물류센터 내 산업안전보건법에서 규정하는 작업환경측정 대상 물질을 취급할 경우 작업환경측정을 실시하고 그 결과에 따른 적절한 작업환경관리 조치를 취해야 한다.",
      "guideContext": "물류센터 작업환경측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H221-001",
      "term": "물류센터",
      "definition": "유통, 판매, 배송 등의 과정에서 물류 이동의 효율성을 증대하기 위하여 거점 지역에 설치하는 창고 시설 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H221-002",
      "term": "실내공기 오염물질",
      "definition": "미세먼지(PM10), 초미세먼지(PM2.5), 일산화탄소, 이산화탄소와 같이 실내공기 중에 존재하며 근로자에게 건강장해를 유발할 수 있는 인자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H221-003",
      "term": "전체환기",
      "definition": "자연적 또는 기계적인 방법에 의하여 작업장내의 오염물질을 희석, 환기시키는 장치 또는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "DT-H221-004",
      "term": "국소배기",
      "definition": "발생원에서 발생되는 오염물질을 후드, 덕트, 공기정화장치, 배풍기 및 배기구를 설치하여 배출하거나 처리하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "DT-H221-005",
      "term": "공기정화시설",
      "definition": "실내 오염물질을 없애거나 줄이는 설비로서 환기설비의 안에 설치되거나, 환기설비와 따로 설치되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
