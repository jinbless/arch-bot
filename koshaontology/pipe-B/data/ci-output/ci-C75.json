  "checklistItems": [
    {
      "identifier": "CI-C75-001",
      "text": "조경공사는 현장여건과 설계도서(도면 및 시방서 등)를 검토하여 안전한 작업계획을 수립하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-EXCAVATION-001"
      ]
    },
    {
      "identifier": "CI-C75-002",
      "text": "모든 작업은 사전 위험성평가를 실시하여 잠재위험요인에 대한 안전대책을 수립하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-EXCAVATION-001"
      ]
    },
    {
      "identifier": "CI-C75-003",
      "text": "산업안전보건기준에 관한 규칙 별표 3에서 정하는 바에 따라 작업을 시작하기 전에 관리감독자로 하여금 필요한 사항을 점검하도록 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-EXCAVATION-001"
      ]
    },
    {
      "identifier": "CI-C75-004",
      "text": "작업장의 지형, 지반 및 지층상태 등에 대한 사전조사를 실시하여 산업안전보건기준에 관한 규칙 별표4의 구분에 따른 사항을 포함한 작업계획서를 작성하고, 그 내용을 근로자에게 주지시켜야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-EXCAVATION-001"
      ]
    },
    {
      "identifier": "CI-C75-005",
      "text": "차량계 하역운반기계, 차량계 건설기계, 중량물 취급 작업의 작업계획서를 작성하고, 작업지휘자를 지정하여 작업계획서에 따라 작업을 지휘하도록 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-010"
      ]
    },
    {
      "identifier": "CI-C75-006",
      "text": "차량계 건설기계 사용 시 작업반경내 관계 근로자외의 사람을 출입금지 조치 또는 유도자 배치 등 차량계 건설기계 접촉방지 조치를 철저히 하여야 한다. 또한 장비 운행시 승차석외에 근로자 탑승을 금지하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C75-007",
      "text": "장비 작업 전에 브레이크, 후진경보등, 후방감지기 등 안전장치의 설치상태 및 과부하방지장치, 권과방지장치 등 방호장치에 대하여 검정기관의 검정 합격 여부, 운전원의 자격여부를 확인하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-C75-008",
      "text": "강풍(10m/s이상) 등의 악천후 시 식재작업으로 인하여 근로자에게 위험을 미칠 우려가 있는 경우에는 작업을 중지해야 하며, 비, 눈, 그 밖의 기상상태의 불안정으로 날씨가 몹시 나쁜 경우에는 산업안전보건기준에 관한 규칙 제37조 악천후 및 강풍시 작업중지 또는 제383조 철골작업 중지를 준용하여 작업을 중지하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항 (법령 근거 미확인)",
      "additionalDetail": "제37조, 제383조 준용",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-009",
      "text": "충전전로의 인근에서 작업 시에는 충전부로부터 300센티미터 이상 이격하거나 산업안전보건기준에 관한 규칙 제322조의 충전전로 인근에서 차량·기계장치 작업을 준수 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 일반안전사항",
      "additionalDetail": "제322조 준수",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-ELECTRIC-017"
      ]
    },
    {
      "identifier": "CI-C75-010",
      "text": "수목식재 전 수목의 가지를 다듬어 주어야 하고, 지엽이 무성한 것은 속가지를 수형에 부합되게 정지해야하며, 근로자의 절림 및 인양작업 시 옷 걸림 사고를 예방하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목정지작업",
      "additionalDetail": null,
      "workProcessPhase": "수목정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-011",
      "text": "수목을 굴취하여 뿌리분 및 수관을 잘 포장해야 하며, 뿌리분 등의 포장은 새끼, 마대, 짚 등으로 싸매주어 뿌리 및 수피에 손상이 없도록 반드시 근로자 2인 이상 공동 작업을 실시하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목정지작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-012",
      "text": "특수한 수목에 대하여 필요한 경우 굴취 전에 가지주를 세우고 수목굴취에 착수하여 수목의 넘어짐을 방지하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목정지작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-013",
      "text": "수목식재 전 수목의 가지치기 작업 시에 이동식 사다리를 사용할 때 뒤집힘 방지 조치를 실시하고 반드시 근로자 2인1조로 작업을 실시하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목정지작업",
      "additionalDetail": null,
      "workProcessPhase": "수목정지",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-C75-014",
      "text": "계단식 사다리에서 작업 시에는 최상부 발판으로부터 상부 3개 발판에서의 작업은 금지하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목정지작업",
      "additionalDetail": null,
      "workProcessPhase": "수목정지",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-C75-015",
      "text": "수목굴취에서 식재까지의 시간은 짧을수록 좋으며 운반 경로를 사전에 검토하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-016",
      "text": "수목의 굴취는 수직으로 파내려 가지 말고 주변의 상황에 따라 계단식으로 수목을 굴취 하여야 한다. 근원부의 잡초를 제거하고 근원직경의 3~5배 이상 크기로 뿌리분을 떠야 하며, 분의 흙이 떨어지지 않도록 새끼, 가마니, 철사, 보호재료로 결박시켜야 한다. 또한 수목 굴취시 수목이 넘어지는 것을 방지하기 위하여 수목에 지주를 설치하여 고정해야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-EXCAVATION-003"
      ]
    },
    {
      "identifier": "CI-C75-017",
      "text": "수목의 운반에 지장이 되는 비교적 큰 가지를 제거하여야 하며 가지는 운반에 지장이 없도록 간편하게 결박하여야 한다. 또한 비포장 도로 운반 시에 충격을 받지 않도록 완충재를 이용하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-018",
      "text": "근로자작업과 장비작업 시 동시작업을 금지하여야 하며, 다만, 근로자와 장비가 동시작업을 하는 경우에는 신호수를 배치하고 작업하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C75-019",
      "text": "곡괭이 작업시 곡괭이의 상태를 점검하고, 2인이 한구덩이 안에서 동시 작업을 하지 못하도록 주지시거나 통제하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-020",
      "text": "인양용 공구를 이용한 중량의 수목 운반 작업 전에 와이어로프, 슬링벨트, 훅 안전고리, 샤클의 손상, 체결방법 등의 적합 여부를 점검해야하며, 주기적인 교체로 작업 중 와이어로프의 탈락 및 파단의 원인을 제거하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-021"
      ]
    },
    {
      "identifier": "CI-C75-021",
      "text": "수목은 반입 당일에 식재하는 것이 원칙이나 부득이한 경우에는 가이식하여 수목을 보호하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-022",
      "text": "장비 작업구간에는 반드시 유도자 및 작업지휘자를 배치하여 정해진 운행경로를 확보해야 하며, 화물자동차의 적재함에 근로자를 탑승시켜서는 안된다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-010"
      ]
    },
    {
      "identifier": "CI-C75-023",
      "text": "운반 시에는 차량의 용량에 따라 적정 수량만을 적재하고 이중적재를 금지시켜야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-024",
      "text": "수목을 운반 시에는 2개소 이상에 결박하여 떨어짐을 방지하고, 수목식별 표지를 별도로 설치하여 이동시 부딪힘을 예방하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-025",
      "text": "장비를 이용하여 수목을 인양, 하차시 및 운반 장소의 작업반경내 관계 근로자외의 사람이 출입하지 못하도록 통제한 상태에서 작업해야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C75-026",
      "text": "수목의 운반 및 상·하차 시에는 형겊을 싸서 수목의 손상을 방지하고 대형목인 경우에는 체인 블럭이나 이동식 크레인을 사용하여야 한다. 이동식 크레인을 이용하여 상, 하차시 수목이 회전하지 않도록 걸이를 하여야 하며, 크레인 설치시에 넘어짐을 방지하기 위하여 지형 및 주변 상황에 맞게 장비위치를 선정하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업",
      "additionalDetail": null,
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "CI-C75-027",
      "text": "줄걸이 용구의 안전유의 사항은 운반하역 표준안전 작업지침 및 KOSHA GUIDE C-48-2012 (건설기계 안전보건작업 지침)을 따른다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업",
      "additionalDetail": "KOSHA GUIDE C-48-2012 참조",
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-021"
      ]
    },
    {
      "identifier": "CI-C75-028",
      "text": "목도운반 등 인력 운반 시에는 허리에 재해가 발생할 수 있으므로 준비운동을 실시하고, 가급적 높낮이 차이가 나지 않도록 키가 비슷한 근로자가 인양하도록 하여야 한다. 또한 근골계질환을 예방하기 위해서 KOSHA GUIDE H-65-2012 (사업장 근골계질환 예방·관리 프로그램)을 따른다.",
      "guideContext": "조경공사(수목식재작업) 수목굴취 및 운반작업 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE H-65-2012 참조",
      "workProcessPhase": "수목굴취 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-029",
      "text": "기반을 조성하는 공사 시에는 작업반경내 관계 근로자외의 사람이 출입하지 못하도록 통제한 상태에서 작업을 실시하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 기반조성작업",
      "additionalDetail": null,
      "workProcessPhase": "기반조성",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C75-030",
      "text": "지반이 평탄하지 않을 경우, 장비의 넘어짐 위험이 있으므로 장비 운반로는 고르게 정리하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 기반조성작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기반조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-031",
      "text": "백호 버켓의 탈장착과 관련한 작업방법을 사전에 운전원에게 교육시키고, 이탈방지용 안전핀을 체결하는 등의 조치를 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 기반조성작업",
      "additionalDetail": null,
      "workProcessPhase": "기반조성",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-C75-032",
      "text": "조경 부지정리 작업 시 토사의 무너짐 위험 등이 없는지 주변 지반상태를 확인하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 기반조성작업",
      "additionalDetail": null,
      "workProcessPhase": "기반조성",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-EXCAVATION-003"
      ]
    },
    {
      "identifier": "CI-C75-033",
      "text": "차량계 건설기계를 이용한 고르기 작업 및 수목규격에 맞는 구덩이 파기 작업 시에는 유도자를 배치하여 신호에 따라 작업 및 이동 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 기반조성작업",
      "additionalDetail": null,
      "workProcessPhase": "기반조성",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C75-034",
      "text": "식재를 위한 구덩이는 근로자 2명 이상 작업을 금지하여 파고, 설계도서에 의한 수종 및 규격에 따라 지정된 소정의 비료 또는 퇴비를 넣은 후 양질토로 5cm 정도 덮고, 그 위에 수목을 앉혀서 식재하여야 하며 근로자와 장비가 동시작업 시 근로자의 식별이 용이한 장소에서 작업을 실시하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-EXCAVATION-003"
      ]
    },
    {
      "identifier": "CI-C75-035",
      "text": "차량계 건설기계를 주용도 외의 용도로 사용하여서는 아니 되며 수목을 인양하여 식재하는 때에는 이동식크레인을 사용하여 작업을 진행하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C75-036",
      "text": "이동식 크레인은 아웃트리거를 설치하고, 와이어로프, 슬링벨트, 훅 안전고리, 샤클의 상태, 훅 해지장치의 상태 등을 수시 점검해야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "CI-C75-037",
      "text": "이동식 크레인의 아웃트리거 설치시 받침 등 매트나 미끄럼 방지장치를 준비하여 지지력을 확보한 견고한 받침판을 깔고 설치하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-038",
      "text": "수목 하역 및 식재장소로는 굴착 면에서 충분히 이격된 평탄하고 다짐이 잘 되어 있는 안전한 장소를 선정하고, 수목이 움직이지 않도록 받침목을 설치하는 등 적절한 조치를 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-EXCAVATION-003"
      ]
    },
    {
      "identifier": "CI-C75-039",
      "text": "중량 80kg이상의 수목을 근로자 2명 이상이 목도 운반하는 때에는 준비 운동 및 일정한 신호방법을 정하고, 신호방법에 따라 작업을 실시하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-040",
      "text": "인양작업 시 가지치기 작업으로 나뭇가지에 옷 등이 걸리지 않도록 하고, 와이어로프, 섬유벨트 등으로 2줄 걸이 하는 등의 흔들리지 않도록 균형을 유지하는 방법으로 수목이 탈락되지 않도록 조치를 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-021"
      ]
    },
    {
      "identifier": "CI-C75-041",
      "text": "수목 인양로프는 끊어지지 않도록 건고한 것을 사용하고 허용중량이상의 강도를 가진 로프를 사용하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-021"
      ]
    },
    {
      "identifier": "CI-C75-042",
      "text": "식재를 위하여 뿌리 절단 시 삽날이나 곡괭이를 이용하여 자르지 않도록 해야 하고, 가위나 톱을 이용하여 잘라야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-043",
      "text": "식재 작업 시에 수목이 넘어지지 않도록 보조 지주를 설치하고 필요시 장비를 이용하여 고정 시까지 지지조치를 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-044",
      "text": "삽이나 곡괭이 사용에 의한 인력굴착 작업 시 좁은 공간에서 다수의 인원의 작업을 금지해야 하며, 근로자 상호간 사고를 방지하기 위해 작업 중에 2m이상의 충분한 거리를 유지하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-045",
      "text": "근로자 작업과 차량계 건설기계작업 시 동시작업을 금지해야 하며, 다만, 근로자와 장비가 동시작업을 하게 되는 경우에는 신호수를 배치하고 작업하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C75-046",
      "text": "경사면 식재작업 시 근로자가 떨어지지 않도록 안전대 부착설비를 설치하고, 안전대를 착용하고 작업을 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-FALL-003"
      ]
    },
    {
      "identifier": "CI-C75-047",
      "text": "강풍 시 사고 위험성이 있으므로 풍속의 크기를 측정하여 확인하고, 풍속이 초당 10미터를 초과하는 경우에는 작업을 중지하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "식재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-048",
      "text": "충전전로에 인근 작업 시 크레인 등을 충전전로의 충전부로부터 300센티미터 이상 이격하거나 산업안전보건기준에 관한 규칙 제322조의 충전전로 인근에서 차량·기계장치 작업을 준수하고 신호수를 배치하여 고압선에 접촉하지 않도록 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 식재작업",
      "additionalDetail": "제322조 준수",
      "workProcessPhase": "식재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-ELECTRIC-017"
      ]
    },
    {
      "identifier": "CI-C75-049",
      "text": "지주목 설치 및 가지치기 작업은 발판을 설치하거나 고소작업대 사용을 원칙으로 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C75-050",
      "text": "지주는 못 박기, 철선 결박 등을 튼튼히 하여 흔들림이 없도록 하여야 하며, 결박하는 부위의 철선은 완충재를 대어 수목에 직접 닿지 않도록 고무관을 대주고 끈으로 묶음으로써 수목의 손상을 방지하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-051",
      "text": "삼각형 지주 등은 수목의 교착하는 부분에 2곳 이상 결속하여야 한다. 또한 강풍에 의한 흔들림을 방지하여 수목 활착이 원활히 이루어지도록 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-052",
      "text": "지주 적재 시에는 근로자가 걸려 넘어지지 않도록 자재를 정리하고, 통로를 확보 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C75-053",
      "text": "식재지역에 지반침하가 우려되는 경우에는 지주가 유동하지 않도록 조치하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-054",
      "text": "지주 설치 시에는 결박작업 시 끼임 사고가 발생하지 않도록 가급적 근로자 2인 1조 작업을 실시하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-055",
      "text": "사다리를 이용한 수목에 지주 연결 작업 시에는 보조로프를 사용하여 사다리가 넘어지지 않도록 수목과 결속을 실시하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-C75-056",
      "text": "근로자가 떨어지는 것을 방지하기 위하여 안전대 부착설비를 설치하고, 안전대를 착용하여 승·하강을 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업",
      "additionalDetail": null,
      "workProcessPhase": "지주설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-FALL-003"
      ]
    },
    {
      "identifier": "CI-C75-057",
      "text": "지주 운반 시에는 적정한 중량을 초과하지 않도록 하여 근골격계에 무리한 부담을 주지 아니하여야 하며, 신체에 부담을 감소시킬 수 있는 자세를 근로자에게 주지시켜야 한다. 중량물 취급 작업 시에는 KOSHA GUIDE H-66-2012 (근골계질환 예방을 위한 작업환경개선 지침)을 따른다.",
      "guideContext": "조경공사(수목식재작업) 지주설치작업 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE H-66-2012 참조",
      "workProcessPhase": "지주설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-058",
      "text": "가지치기 작업 시에는 근로자가 떨어지지 않도록 안전대 부착설비 설치 및 안전대를 착용후 작업을 실시해야 하며, 작업 종료시에 주변 정리정돈을 하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-FALL-003"
      ]
    },
    {
      "identifier": "CI-C75-059",
      "text": "비료 등 운반 시에 25kg이상 초과하여 운반하지 않도록 주의하며 운반시에는 올바른 자세를 유지하여 무리한 작업을 금지하여야 한다. 중량물 취급 작업시에는 KOSHA GUIDE H-66-2012 (근골계질환 예방을 위한 작업환경개선 지침)을 따른다.",
      "guideContext": "조경공사(수목식재작업) 유지관리 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE H-66-2012 참조",
      "workProcessPhase": "유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C75-060",
      "text": "가지치기를 할 경우 수형이 파괴되지 않는 범위 내에서 실시하며 이동식 사다리 사용시 근로자 2인 1조로 작업하여야 한다. 이동식 사다리를 사용하는 작업은 KOSHA-GUIDE C-48-2012 (사다리 안전보건작업 지침)을 따른다.",
      "guideContext": "조경공사(수목식재작업) 유지관리",
      "additionalDetail": "KOSHA GUIDE C-48-2012 참조",
      "workProcessPhase": "유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-C75-061",
      "text": "지속적인 물주기 및 병충해 방제 작업을 하여야 하며, 방제 작업 시에는 방독마스크 등 개인보호구를 착용하여야 한다.",
      "guideContext": "조경공사(수목식재작업) 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-C75-062",
      "text": "약제 살포 작업 시에는 유해·위험 물질에 대한 물질안전보건자료(MSDS)를 파악하여 취급시의 주의사항 등을 근로자에게 교육시켜야 한다.",
      "guideContext": "조경공사(수목식재작업) 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-C75-001",
      "term": "조경공사",
      "definition": "건축물 주변 대지에 수목식재, 조형물 등을 설치하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C75-002",
      "term": "수목식재작업",
      "definition": "나무를 심거나 잔디 등 지피식물을 입히는 작업을 말하며, 지피식물은 지표를 낮게 덮는 식물을 이르는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C75-003",
      "term": "수목정지",
      "definition": "수목을 식재목적에 맞도록 나무의 가지나 줄기 및 잎의 일부를 잘라내는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C75-004",
      "term": "가이식",
      "definition": "수목의 향후 본 이식을 목적으로 임시로 보관하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C75-005",
      "term": "수목굴취",
      "definition": "산림 안에 살아 있는 나무를 다른 장소로 옮겨심을 목적으로 나무의 뿌리까지 캐내는 행위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C75-006",
      "term": "수관",
      "definition": "나무의 줄기와 잎이 많이 달려있는 줄기의 윗부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C75-007",
      "term": "근원직경",
      "definition": "수목의 규격을 표시할 때 지표면 부위의 나무줄기의 직경을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C75-008",
      "term": "지주",
      "definition": "식재한 나무가 바람에 흔들리는 것을 막고, 기계적인 장해로부터 보호하기 위해 인위적으로 나무를 지탱시키는 보조 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-C75-01",
      "processOrder": 1,
      "processName": "수목정지작업",
      "safetyMeasures": "이동식 사다리 사용 시 뒤집힘 방지 조치 실시, 근로자 2인 1조 작업, 계단식 사다리 최상부 3개 발판 작업 금지, 특수 수목 굴취 전 가지주 설치로 넘어짐 방지",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "4.2",
      "relatedSR": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "WP-C75-02",
      "processOrder": 2,
      "processName": "수목굴취 및 운반작업",
      "safetyMeasures": "운반 경로 사전 검토, 계단식 굴취, 수목 지주 설치 고정, 근로자·장비 동시작업 금지(불가피 시 신호수 배치), 와이어로프·슬링벨트·훅·샤클 점검, 유도자 및 작업지휘자 배치, 이중적재 금지, 2개소 이상 결박, 이동식 크레인 사용 시 수목 회전 방지 걸이, 화물자동차 적재함 근로자 탑승 금지",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전장갑"
      ],
      "sourceSection": "4.3",
      "relatedSR": [
        "SR-CONSTRUCTION_EQUIP-008",
        "SR-CONSTRUCTION_EQUIP-010",
        "SR-CONSTRUCTION_EQUIP-021",
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "WP-C75-03",
      "processOrder": 3,
      "processName": "기반조성작업",
      "safetyMeasures": "작업반경 내 출입통제, 장비 운반로 평탄화, 백호 버켓 이탈방지용 안전핀 체결, 토사 무너짐 위험 지반상태 확인, 유도자 배치하여 신호에 따라 작업",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "4.4",
      "relatedSR": [
        "SR-CONSTRUCTION_EQUIP-008",
        "SR-CONSTRUCTION_EQUIP-009",
        "SR-EXCAVATION-003"
      ]
    },
    {
      "identifier": "WP-C75-04",
      "processOrder": 4,
      "processName": "식재작업",
      "safetyMeasures": "구덩이 내 근로자 2명 이상 작업 금지, 차량계 건설기계 주용도 외 사용 금지, 이동식 크레인 아웃트리거 설치 및 점검, 경사면 작업 시 안전대 착용, 근로자·장비 동시작업 금지(불가피 시 신호수 배치), 풍속 10m/s 초과 시 작업 중지, 충전전로 300cm 이상 이격, 인력굴착 시 2m 이상 거리 유지",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전대"
      ],
      "sourceSection": "4.5",
      "relatedSR": [
        "SR-FALL-003",
        "SR-CONSTRUCTION_EQUIP-008",
        "SR-CRANE-002",
        "SR-ELECTRIC-017",
        "SR-EXCAVATION-003"
      ]
    },
    {
      "identifier": "WP-C75-05",
      "processOrder": 5,
      "processName": "지주설치작업",
      "safetyMeasures": "발판 또는 고소작업대 사용, 사다리 이용 시 보조로프로 수목과 결속, 안전대 부착설비 설치 및 안전대 착용, 근로자 2인 1조 작업, 자재 정리 및 통로 확보, 지반침하 시 지주 유동 방지 조치",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전대"
      ],
      "sourceSection": "4.6",
      "relatedSR": [
        "SR-FALL-001",
        "SR-FALL-003",
        "SR-PASSAGE-004",
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "WP-C75-06",
      "processOrder": 6,
      "processName": "유지관리",
      "safetyMeasures": "가지치기 시 안전대 부착설비 설치 및 안전대 착용, 비료 운반 25kg 이하 준수, 이동식 사다리 2인 1조 작업, 병충해 방제 시 방독마스크 등 개인보호구 착용, 약제 살포 시 MSDS 파악 및 교육",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전대",
        "방독마스크",
        "보호장갑"
      ],
      "sourceSection": "4.7",
      "relatedSR": [
        "SR-FALL-003",
        "SR-PASSAGE-004",
        "SR-CHEMICAL-024",
        "SR-CHEMICAL-025"
      ]
    }
  ],
