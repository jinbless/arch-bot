  "checklistItems": [
    {
      "identifier": "CI-G65-001",
      "text": "장애인 근로자 개인의 능력과 차이를 고려하여 작업 시 예상되는 위험요소를 확인한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-002",
      "text": "사고의 가능성이 있는 장애인 근로자와 그 유형을 결정한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-003",
      "text": "위험 정도를 평가한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-004",
      "text": "기존 예방책과 보완이 필요한 조치를 결정한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-005",
      "text": "위험성 평가 결과에 따른 작업과정과 작업환경, 작업장비 등에 대한 조치를 취한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-006",
      "text": "밝혀진 위험요소를 기록하고, 그에 상응하는 조치를 취한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-007",
      "text": "해당 근로자들과의 상담을 실시한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-008",
      "text": "정기적인 위험성 평가와 점검을 실시한다.",
      "guideContext": "장애인 근로자 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-009",
      "text": "사업주는 장애를 가진 근로자의 건강상태를 점검하고 그들의 작업수행 능력에 따라서 적절한 근로조건의 작업부서에 배치한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-010",
      "text": "장애인 근로자에게 불필요한 기준들은 제고되어야 한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-011",
      "text": "장애인 근로자가 그들의 장애 상태를 구체적으로 드러낼 것을 요구해서는 안 된다.",
      "guideContext": "장애인 근로자 사업주 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-012",
      "text": "필요 시 장애인 근로자의 의무 일부를 면하게 한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-013",
      "text": "장애인 근로자에게 적절한 근로시간을 근로자와 합의하여 정한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-014",
      "text": "장애인 근로자 및 그와 함께 일하는 동료 근로자에게 적절한 교육 프로그램을 제공한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-015",
      "text": "장애인 근로자들과의 의사전달 효과를 강화하기 위한 시청각 자료 또는 도구를 사용한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-016",
      "text": "필요 시 장애인 근로자에게 대체 작업을 마련해 준다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-017",
      "text": "위험요소를 확인하여 집중적으로 관리하여야 한다.",
      "guideContext": "장애인 근로자 사업주 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-018",
      "text": "장애인 근로자에게 비우호적 태도 또는 적대감을 표시하거나 모욕감을 주고 심지어 폭행을 하는 일은 없도록 한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-019",
      "text": "장애인 근로자에 대한 선입견을 피하고, 작업내용과 장애상태의 관계를 고려해야 한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-020",
      "text": "위험평가 시 장애인 근로자를 참여시켜 그들의 견해를 반영하도록 한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-021",
      "text": "필요 시 전문가와 상담을 실시한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-022",
      "text": "작업환경 및 내용에 대해 재검토한다.",
      "guideContext": "장애인 근로자 사업주 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-023",
      "text": "소아마비의 경우에는 심하게 체력을 요하는 직종은 피하는 것이 좋다.",
      "guideContext": "장애인 근로자 지체장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-024",
      "text": "척수손상 장애인은 비육체 활동에 국한되는 업무를 해야 하므로 교육수준이 향상되도록 하여야 한다.",
      "guideContext": "장애인 근로자 지체장애 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-025",
      "text": "척수손상 장애인의 경우에는 출퇴근에 필요한 교통수단의 배려가 필요하고 기능상실에 따른 장기능 결함 및 방광장애를 고려해야 한다.",
      "guideContext": "장애인 근로자 지체장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-026",
      "text": "사지마비 장애인과 하반신 마비 장애인의 경우 체온조절에 어려움이 있으므로 작업장의 온도에 대한 고려가 필요하다.",
      "guideContext": "장애인 근로자 지체장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-027",
      "text": "근이영양증 장애인은 인지기술과 의사소통 기술이 손상되지 않으므로 가벼운 좌식 작업이 적합하다.",
      "guideContext": "장애인 근로자 지체장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-028",
      "text": "정형외과적 장애(사지절단)를 가진 경우에는 기능적 제약을 고려해야 하며 이와 동시에 심리적인 문제도 동시에 고려해야 한다.",
      "guideContext": "장애인 근로자 지체장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-029",
      "text": "관절염 장애인의 경우에는 관절의 손상정도, 교정수술, 보조기기의 적응, 심리적 안정 등을 고려해야 한다.",
      "guideContext": "장애인 근로자 지체장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-030",
      "text": "시각장애인 중 약시인은 맹인에 비해 보조기구의 도움을 받으면 작업 시 특별한 제한이 없다.",
      "guideContext": "장애인 근로자 시각장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-031",
      "text": "근로자 개인이 좋은 방향감각을 개발하고 다른 감각기관을 최대한 이용할 수 있도록 배려가 필요하다.",
      "guideContext": "장애인 근로자 시각장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-032",
      "text": "청각장애인은 비교적 시각에 의존하기 때문에 비장애인보다 더 나은 조명이 필요하다.",
      "guideContext": "장애인 근로자 청각장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-033",
      "text": "청각장애인 중에는 소음이 그들의 진동감각을 악화시키기 때문에 소음이 심한 환경에서 일하면 불편함을 느끼게 된다.",
      "guideContext": "장애인 근로자 청각장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-034",
      "text": "보청기를 사용하는 근로자를 위해 실내음향을 고려해야 한다.",
      "guideContext": "장애인 근로자 청각장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G65-035",
      "text": "지적장애인이 습득할 수 있는 기술의 수는 제한되어 있으므로 꼭 필요한 기술만 가르쳐야 할 필요가 있다.",
      "guideContext": "장애인 근로자 지적장애 고려사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G65-001",
      "term": "유창성 장애",
      "definition": "말을 하는데 있어 시기와 리듬이 부적당한 패턴으로 나타나는 장애를 말한다. 말더듬, 속화(성급하게 말하기), 신경성 유창성 장애가 이에 포함된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G65-002",
      "term": "근이영양증",
      "definition": "골격근이 점차로 변성되고 위축되어 약화되어 가는 진행성, 불치성, 유전성 질환을 말한다. 이 질환은 중추신경계 또는 말초신경계와 연관 없이 골격근의 퇴화가 진행되어 근육의 약화, 구축, 변형을 보인다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
