  "checklistItems": [
    {
      "identifier": "CI-W24-001",
      "text": "위험성 예측을 위한 노출량은 노출강도(농도) 및 노출기간(빈도)으로 정량화 하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기본자료 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-002",
      "text": "노출평가를 수행하기 전에 제조나노물질의 취급, 노출 등이 밝혀진 공정에 한해 노출평가를 수행하여야 된다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기본자료 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-003",
      "text": "조사 시점에서 제조나노물질을 생산, 취급 및 노출가능성이 없으면 더 이상 진행하지 않아도 되나 취급 등이 재개되면 기본 조사부터 다시 수행하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기본자료 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-004",
      "text": "1단계에서 노출평가를 진행하기로 결정하였다면 본격적인 노출평가를 시행하기 전에 다음 두 가지 사항을 추가로 조사하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": "사업장 정보 조사 및 비의도적 나노물질 발생 정보 조사",
      "workProcessPhase": "사업장 정보 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-005",
      "text": "작업변수를 파악하기 위하여 어떤 작업을 얼마동안 했는지를 시간활동일지(Time activity diary)에 15분 또는 30분 간격(최대한 자주 기록할 것을 권고)으로 작성한다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "사업장 정보 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-006",
      "text": "사업장에서 생산·취급하는 물질은 제외하고 비의도적으로 발생하는 나노물질의 발생원을 파악한다. 이때, 사업장 주변의 제조나노물질 발생사업장, 주요 도로 위치, 디젤 차량 운행 여부 등도 함께 파악함으로써, 생산·취급 제조나노물질을 제외한 배경농도를 측정한다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "비의도적 나노물질 발생 정보 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-007",
      "text": "배경농도는 다음 2가지 방법으로 측정하며, 가능한 한 노출평가에 이용한 동일한 기기를 사용한다. 또한, 배경농도를 측정한 장소 및 시간에 관한 사항을 기록한다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "비의도적 나노물질 발생 정보 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-008",
      "text": "나노물질의 발생 영향이 적은 작업장 내 인근지역(예, 사무실, 복도 등)에서 측정하되, 다른 인위적인 발생원이 없는 장소에서 실시하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비의도적 나노물질 발생 정보 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-009",
      "text": "제조나노물질의 특성은 고정된 위치에서 시료를 채취하는 지역시료채취, 작업자의 호흡영역에서 시료를 채취하는 개인시료채취 등의 전통적인 산업위생 시료채취와 함께 실시간 측정기기(또는 방법)를 이용하여 규명하도록 한다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-010",
      "text": "측정기기는 다양한 실시간 기기 및 비실시간 기기를 함께 이용하도록 한다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-011",
      "text": "측정 장소는 제조나노물질의 발생원 및 작업자 근처 모두를 지정하고, 발생원 등이 여러 곳에 나눠져 있을 경우에는 측정기기를 옮겨가며 수행하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-012",
      "text": "측정시간은 모든 작업을 포함시키고, 배경농도는 반드시 제조나노물질의 생산 또는 공정 가동 이전에 측정하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-013",
      "text": "측정이 이루어지는 동안에는 작업 상황을 시간활동일지에 기록하고 기기의 작동 여부를 수시로 점검한다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-014",
      "text": "실시간 측정이 곤란한 정성평가는 전자현미경 또는 중금속 분석 등을 통해 형상과 성분 등을 조사하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-015",
      "text": "제조나노물질을 포집하기 위해서는 여과지를 카세트에 장착하고 분석 가능한 감도를 얻을 만큼 충분한 시간동안 시료를 채취하여야 하며, 전자현미경 분석과 다른 기기분석을 위한 시료를 같은 장소에서 각각 동시에 채취하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-016",
      "text": "3단계에서 부록 3의 제조나노물질 노출기준(권고안)보다 노출평가 결과가 높은 경우에는 노출저감대책을 세워 작업현장 등을 개선한 다음 다시 2단계 노출평가로 돌아가 재평가를 하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출저감대책 제시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-017",
      "text": "노출저감대책을 시행한 후 노출이 감소되었으면 이에 대한 평가정보를 기록하고 정기적인 평가를 실시한다. 다만, 작업 공정이나 취급 방법이 변경되어 노출 수준의 변화가 예상되면 2단계로 돌아가 재평가를 실시하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관리 및 기록유지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-018",
      "text": "최종보고서는 모든 사람이 알아볼 수 있도록 쉽게 작성하며 기록물 보관소 등에 잘 정리하여 보관하여야 한다.",
      "guideContext": "제조나노물질 노출평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관리 및 기록유지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-019",
      "text": "제조나노물질의 크기, 형태는 전자현미경을 이용하고, 화학적 조성과 양은 중금속 분석 및 전자현미경을 통해 확인한다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W24-020",
      "text": "나노물질 노출 평가를 할 때는 채취된 나노입자를 표준물질과 함께 비교·검증하는 단계가 필요하다.",
      "guideContext": "제조나노물질 노출평가",
      "additionalDetail": null,
      "workProcessPhase": "노출평가 2a단계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록 1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-W24-001",
      "term": "제조나노물질",
      "definition": "자연발생적이 아닌 한 단면이 나노 크기(1～100㎚)인 의도적으로 제조된 나노물질을 말하며, 연소 및 기화 같은 공정에서 비의도적으로 발생하는 나노입자와는 구분된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W24-002",
      "term": "응집(체)",
      "definition": "입자 또는 응집체가 서로 약하게 결합되어 있고 겉표면적이 개별성분의 표면적 합에 비해 작은 형태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W24-003",
      "term": "집합(체)",
      "definition": "강한결합으로 구성된 입자 또는 융합된 입자들이고 실제 겉표면적이 개별성분의 표면적 합에 비해 훨씬 작은 형태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W24-004",
      "term": "사전주의원칙",
      "definition": "새로운 기술에 대하여 불확실하지만 잠재적 위험이 심각하거나 비가역적인 것으로 예상됨에 따라, 위험을 관리하기 위한 정책 등을 해당 기술의 확실성이 나타나기 전에 적용하는 원칙을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W24-005",
      "term": "TEM(Transmission Electron Microscope) Grid",
      "definition": "투과전자현미경 분석에 사용되는 구리, 니켈, 몰리브덴 등의 다양한 재질에 탄소막으로 구성된 격자무늬 형태의 판을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
