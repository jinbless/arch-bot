        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-H169-04",
      "processOrder": 4,
      "processName": "노출 모니터링",
      "safetyMeasures": "개인의 노출수준 모니터링 실시, 작업자의 호흡 영역에서 개인 포집 시료 채취, 가장 높은 노출 시기 및 수리·유지보수 작업 시 포함, 6~8시간 채취하여 시간가중평균농도(TWA) 도출, 필요 시 단시간 노출 기준(STEL) 측정",
      "requiredPPE": [
        "호흡용 보호구"
      ],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-H169-05",
      "processOrder": 5,
      "processName": "교육 및 훈련",
      "safetyMeasures": "디젤엔진 배기가스의 직업적 노출 및 관리 대책에 대한 건강 위험 정보, 훈련, 교육 시행",
      "requiredPPE": [],
