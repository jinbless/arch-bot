  "checklistItems": [
    {
      "identifier": "CI-H169-001",
      "text": "위험성을 평가하기 위하여 작업의 빈도, 작업의 내용을 정기적으로 평가하고 검토하여야 한다.",
      "guideContext": "디젤엔진 배기가스 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H169-002",
      "text": "근로자들의 건강 및 안전을 위하여 유해물질의 노출을 관리해야 한다. 예를 들면, 작업 방법 변경, 작업장 레이아웃 변경, 작업장 내 배기가스를 제거하기 위한 방법 수정, 또는 디젤 연료를 안전한 연료로 대체(천연 가스, 배터리 구동 차량 등)하여 디젤엔진 배기가스에 노출되는 것을 방지하도록 하여야 한다.",
      "guideContext": "디젤엔진 배기가스 예방 및 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "예방 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-H169-003",
      "text": "디젤엔진 배기가스 노출을 제어하기 위해 배출원에 대한 가장 적합한 제어 시스템을 사용하여야 하며, 호흡용 보호 장비(RPE)는 차선책이 되어야 한다.",
      "guideContext": "디젤엔진 배기가스 호흡용 보호 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "공학적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H169-004",
      "text": "호흡용 보호 장비(RPE)는 디젤엔진 배기가스와 그 입자의 구성 요소에 따라 적합한 보호구를 사용해야 한다.",
      "guideContext": "디젤엔진 배기가스 호흡용 보호 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H169-005",
      "text": "작업시에 호흡용 보호구 착용하여 불편함을 느끼게 된다면 작업이 효율적이지 못하며, 유해물 노출의 방지 수단을 호흡용 보호구에 의존해서는 않된다.",
      "guideContext": "디젤엔진 배기가스 호흡용 보호 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H169-006",
      "text": "작업에 있어 개인보호장비가 적절하게 사용 또는 적용되었는지 확인해야 한다.",
      "guideContext": "디젤엔진 배기가스 개인보호장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H169-007",
      "text": "근로자는 개인보호장비가 결함이 있다면 신속한 조치를 취하기 위해 즉시 보고해야 한다.",
      "guideContext": "디젤엔진 배기가스 개인보호장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H169-008",
      "text": "근로자는 사업주가 제공하는 개인보호장비를 적절하게 착용하여야 한다.",
      "guideContext": "디젤엔진 배기가스 개인보호장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H169-009",
      "text": "작업장에서 디젤엔진 배기가스 노출을 제어하기 위해 제공하는 모든 조치가 효과적인 상태로 유지되고, 효율적으로 작업 순서에 맞게 배치되어 있는지 확인해야 한다.",
      "guideContext": "디젤엔진 배기가스 유지보수·검사·관리",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H169-010",
      "text": "호흡용 보호구를 사용하는 경우 철저한 검사 및 유지 보수를 할 수 없다면 일회용 호흡용 보호구를 사용해야 한다.",
      "guideContext": "디젤엔진 배기가스 유지보수·검사·관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H169-011",
      "text": "다회용 안면 보호구의 정기적인 유지 및 보수는 적어도 1개월 이내에 1회 이상 하며, 작업자가 작업 중 필요하다고 생각될 때는 언제든지 검사 및 보수를 실시하여야 한다.",
      "guideContext": "디젤엔진 배기가스 유지보수·검사·관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H169-012",
      "text": "흡입 노출 수준, 위험에 따라서 개인의 노출수준에 대한 모니터링을 실시하여야 한다.",
      "guideContext": "디젤엔진 배기가스 개인 노출 모니터링",
      "additionalDetail": null,
      "workProcessPhase": "노출 모니터링",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H169-013",
      "text": "사업주는 근로자가 단기간 또는 장기간 작업으로 디젤엔진 배기가스에 노출되어 건강 장해가 우려되는 경우, 근로자와 함께 논의하는 것이 바람직 하다.",
      "guideContext": "디젤엔진 배기가스 근로자 건강 감시",
      "additionalDetail": null,
      "workProcessPhase": "건강 감시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H169-014",
      "text": "노조 대표 및 안전관리자에게도 정보를 제공하여 노출을 최소화 하도록 하여야 한다.",
      "guideContext": "디젤엔진 배기가스 근로자 건강 감시",
      "additionalDetail": null,
      "workProcessPhase": "건강 감시",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H169-015",
      "text": "근로자들에게는 디젤엔진 배기가스의 직업적 노출 및 관리 대책에 대한 건강 위험 정보, 훈련, 교육이 시행되어야 한다.",
      "guideContext": "디젤엔진 배기가스 교육 및 훈련",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H169-016",
      "text": "디젤엔진 배기가스 노출 관리를 위하여 작업장의 위험성 평가 결과를 비교하고 작업 상황에 적합한지 확인하여야 한다.",
      "guideContext": "디젤엔진 배기가스 작업장별 노출 관리",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H169-017",
      "text": "상황 별 대체 연료 또는 기술 및 배기가스 제어를 위한 촉매나 비촉매 미립자 트랩의 사용 등 적절한 조치를 고려하여야 한다.",
      "guideContext": "디젤엔진 배기가스 작업장별 노출 관리",
      "additionalDetail": null,
      "workProcessPhase": "공학적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H169-018",
      "text": "출입구나 통풍구의 개방이 비실용적이라면 다른 방안으로 대체하여야 한다.",
      "guideContext": "디젤엔진 배기가스 버스 차고지 노출 관리",
      "additionalDetail": "버스 배기관에 연결된 국소배기장치 또는 미립자 필터가 부착된 플렉시블 덕트를 사용하여 제어 할 수 있다.",
      "workProcessPhase": "공학적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H169-019",
      "text": "엔진 및 철도 차량의 정기적인 유지 보수는 배출 수준을 최소로 유지하도록 하여야 한다.",
      "guideContext": "디젤엔진 배기가스 철도 수리 및 터널 노출 관리",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H169-020",
      "text": "도로 통행 요금소 실내는 양압하에 유지되도록 하고 오염되지 않은 신선한 공기가 충분히 공급되어야 한다.",
      "guideContext": "디젤엔진 배기가스 도로 통행 요금소 노출 관리",
      "additionalDetail": null,
      "workProcessPhase": "공학적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H169-021",
      "text": "소방차량은 차량의 엔진이 잘 유지되도록 정기적으로 점검하고 필요시 수리한다.",
      "guideContext": "디젤엔진 배기가스 소방서 노출 관리",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H169-001",
      "term": "디젤엔진 배기가스",
      "definition": "디젤엔진 배기관에서 외부로 배출되는 모든 배기물을 말한다. (세계보건기구(WHO) 산하 국제암연구소(IARC)는 2012년 6월 12일 디젤엔진 배기가스를 2A등급(발암추정물질)에서 1등급 발암물질로 상향 조정하였다.)",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H169-002",
      "term": "에어로졸",
      "definition": "그 크기가 0.001 ~ 1.0 μm 정도이며 대기 중에 부유하는 고체 또는 액체상태의 작은 입자이다. 이 입자는 여러가지 화학반응을 통하여 대기오염에 관여할 수 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H169-003",
      "term": "다환방향족 탄화수소(PAHs)",
      "definition": "둘 이상의 벤젠 고리를 가지고 있는 탄화수소류를 말한다. 세계보건기구(WHO), 산하 국제 암 연구 센터(IARC)가 지정한 1급 발암물질인 벤젠 등 각종 발암물질과 신경 독성 물질 등 인체에 특히 해로운 유해물질들을 통칭한다. 아세나프텐, 벤조피렌, 나프탈렌, 안트라센, 크리센 등이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H169-004",
      "term": "시간가중평균값(TWA, Time-Weighted Average)",
      "definition": "1일 8시간 작업을 기준으로 한 평균노출농도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
