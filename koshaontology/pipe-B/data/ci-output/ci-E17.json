  "checklistItems": [
    {
      "identifier": "CI-E17-001",
      "text": "사업주는 장비의 안전규칙과 절차의 수립, 적합한 전기설치 형태 및 장비의 동작과 정비의 안전한 접근을 위하여 차폐를 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-002",
      "text": "정비작업자는 스위치 조작이나 제어되지 않은 장비에 대해서는 주의가 필요하다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-003",
      "text": "작업 중인 작업자의 안전을 확보하기 위해 상호 동의절차와 작업방법이 필요하며, 이를 위해 설치 규칙과 절차를 구체화하여야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-004",
      "text": "작업 중 예비 또는 비상발전기가 자동 또는 우연한 작동에 대한 예방조치가 이루어져야 한다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-E17-005",
      "text": "사업주는 정비와 시험 중인 장비의 안전한 작동을 위해 제조사 설명서에 근거하여 정확한 지시를 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-006",
      "text": "사업주는 절차들이 효과적으로 수행되도록 관리하여야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-007",
      "text": "정비작업자는 장비의 제어와 장비에 미치는 영향에 대하여 보고해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-008",
      "text": "모든 작업자는 정비작업을 하는 동안 경고표지, 장비에 대해 구체적인 지시 또는 정비절차 동안의 임시설비에 대하여 주의해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-009",
      "text": "도구, 예비부품 그리고 시험 기구는 목록과 대조하여 정기적으로 점검해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전규칙과 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-010",
      "text": "장비의 정비시 주변과 항상 격리시켜야 하며, 전원의 차단상태를 확인하고 즉시 접지시켜야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-011",
      "text": "장치는 고압 또는 저압 전원이 재투입 되지 않는 사전대책을 세워야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-012",
      "text": "전압 검전기는 항상 사용 전·후에 확인해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-013",
      "text": "사용 전에 장비의 접지를 확인해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-014",
      "text": "활선도체를 포함하고 있는 밀폐함의 접근을 방지하기 위한 격벽은 상시 잠겨있어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-015",
      "text": "전기작업 관리자는 장비의 불통상태, 정전상태 그리고 재투입을 방지하기 위한 적절한 보호수단을 확보해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-016",
      "text": "안전한 작업 및 작업 중 비정상적인 도체의 충전을 방지하거나 활선 도체의 존재의 위험성을 경고하기 위해서 잠금장치, 경계표지 및 격벽을 사용한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-017",
      "text": "개폐기류는 ON 위치로 이동하지 못하도록 잠금장치를 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-018",
      "text": "밀폐함 내의 주회로 도체와 기타 충전단자는 비정상적인 접촉을 방지하기 위해서 필요한 장소를 보호하고 경고표지를 식별이 가능하도록 부착해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-019",
      "text": "계기용 전압기의 역전압 또는 계기용 변류기 2차측 개방으로부터 위험을 피하기 위해 특별한 주의를 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-020",
      "text": "접촉기는 전원 차단장치로 고려하여서는 아니 된다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비를 위한 접근과 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-021",
      "text": "정비되는 장비가 있는 작업 장소와 출입구는 장애물이 없도록 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-022",
      "text": "장비 또는 작업 수행과 관련된 예비부품, 도구, 기기, 격리막, 절연 도구, 휴대 접지장치, 장갑은 각각의 목적을 유지할 수 있도록 보관함에 보관해야 하며, 적절한 상태를 유지해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-023",
      "text": "고정 및 휴대 조명은 안전한 접근과 작업에 필요한 밝기를 제공해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-024",
      "text": "휴대 전기장비는 충분한 절연을 하여야 하며, 이중 절연구조를 취하거나 누전차단기를 사용해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-025",
      "text": "모든 휴대 전기장비들은 정기적으로 점검과 시험을 받아야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-026",
      "text": "전기 장비에 습기, 오물, 해충 등의 침입은 오작동과 위험을 초래하므로 침입 방지 조치를 취해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-027",
      "text": "모든 격실을 닫기 전에 이물질 등이 있는지 확인해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-028",
      "text": "정비작업은 시작하기 전과 후에 전압 검전기를 사용하여 시험해야 한다. 그리고 모든 도체들은 단락접지를 하여야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-029",
      "text": "공기차단기 및 진공차단기와 연관된 작업에서 발생되는 소음의 영향으로부터 작업자를 보호하기 위하여 귀마개 착용 등의 사전예방 조치가 필요하다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "정비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-001",
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-E17-030",
      "text": "화재위험이 있는 곳 또는 화염이나 다른 열원이 있는 공정에서 가연성물질을 사용하는 곳에서 장비를 정비하는 작업자는 소화기 등을 갖추고 있어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재예방조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-031",
      "text": "작업자들은 휴대용 소화기기의 사용법을 훈련받아야 하고 추가적인 도움을 요청하는 방법을 알아야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재예방조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-032",
      "text": "고정식 자동 소화설비가 설치되어 있다면 경고표지는 보호지역 출입구에 표시되어야 한다. 또한 작업자가 보호구역에서 작업할 때 자동으로 작동되지 않도록 주의해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재예방조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-033",
      "text": "전기장치 근처에서 사용되는 소화설비의 형태는 전기장치에 적합해야 하며, 사용시 안전해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재예방조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-034",
      "text": "시험전압을 인가할 때 최소 전류 출력을 얻는 데 필요한 가장 낮은 값을 확보하기 위해서는 주의해야 한다. 장비가 전하를 충전하는 곳에서는 매번 시험한 후에 방전해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-035",
      "text": "시험기기는 연결된 회로에 오동작이나 과도 전류의 유입 또는 반대극성의 결선을 예방하도록 측정이 가능한 형태여야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-036",
      "text": "시험기기 외함은 항상 접지해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-037",
      "text": "장비의 정비에 종사하는 작업자는 제조사 설명서를 숙지하고, 작업, 분해, 재조립 그리고 작동 복구 방법의 주요 참고 가이드로 사용해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-038",
      "text": "새로운 장비는 전체 범위에 대하여 작동 점검과 시험에 관련된 세밀한 조사를 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-039",
      "text": "장비와 함께 제공된 설명서는 안전 준수 절차를 포함하고, 조절가능한 부품의 조작을 통하여 장비 상태를 기록해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-040",
      "text": "모든 장비는 제조사가 정한 점검주기에 따라 점검을 받아야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-041",
      "text": "개폐기 접속, 방호 등의 역할을 수행하는 장비 부품은 금속 부식, 절연체 오염과 같은 먼지, 습기, 열화가 없도록 정기점검과 정비가 필요하다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-042",
      "text": "개폐 빈도가 많은 상태에서는 장비의 형태에 따라 점검을 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-043",
      "text": "정기점검과 작동점검은 정기 계측과 함께 접촉 부품이 허용 상태임을 확인해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-044",
      "text": "유입 또는 공기차단장치의 지속적인 관리를 위해 아크 차단 부품의 용량, 허용범위값 및 필수적인 조정에 관한 지시는 제조사 설명서를 참고하여야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-045",
      "text": "전력 및 제어용 반도체, 동종 부품과 조립품은 의도되지 않은 충격을 받지 않도록 주의해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-046",
      "text": "먼지 등의 제거와 함께 일상점검과 정밀점검을 충분히 실시되어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-047",
      "text": "일상정비는 작동점검과 정기점검에 기초하여 계획해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일상정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-048",
      "text": "점검시 과도한 손상이나 마모가 작동과정에서 발생하지 않아야 하고, 세부적인 정밀점검과 절연시험으로 접촉 시스템의 분해나 기구 관리에 대한 추가 필요성이 없도록 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일상정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-049",
      "text": "일상 진단시험은 열화 가능성과 유지보수 기간의 결정을 위해 필요하다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "일상정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-050",
      "text": "고장 후 정밀점검 및 정비의 필요성과 범위는 고장전류의 크기, 고장 작동 횟수, 아크 소호재의 상태 그리고 아크제어 장치의 성능 등과 같은 항목에 따라 정할 수 있다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "고장 후 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-051",
      "text": "장기간 사용한 개폐기에 대한 특별한 주의가 필요하다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "고장 후 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-052",
      "text": "기록은 정비주기를 정하는 데 필요하며, 정비를 실행할 때 관련 부품을 주의해야 한다. 기록은 장비가 설치되고 다음의 정보를 포함할 때 시작되어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "기록 포함사항: 제조사 세부사항, 설비 명판, 일련번호, 설치일자, 제조사 안내서 위치, 정비 날짜 및 횟수, 수행된 정비 형태, 장비 상태 변화 기록, 퓨즈 링크 세부사항, 최대 고장 수준",
      "workProcessPhase": "정비 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-053",
      "text": "고장이나 파손 등의 재발 방지대책을 수립하기 위하여 기록·분석되어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-054",
      "text": "소모성 예비부품, 분해도, 부품 목록은 정비작업자에게 쉽게 이용할 수 있도록 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부품 교체 및 청결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-055",
      "text": "교체부품은 일련번호나 증명번호를 확인하고, 불량품이나 잠재적인 결함 부품을 사용하지 못하도록 주의해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부품 교체 및 청결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-056",
      "text": "장비의 정상적인 작동을 위해서 청결을 유지해야 하며, 강제 환기가 장애를 받지 않도록 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부품 교체 및 청결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-057",
      "text": "덮개제거, 제동 가스켓 조인트 또는 문개방을 하기 전에 오염물, 먼지 등의 유입을 예방해야 한다. 그리고 내부 청결을 위해 진공청소기를 사용해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부품 교체 및 청결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-058",
      "text": "트래킹이 발생하지 않도록 절연물 손상에 주의해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부품 교체 및 청결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-059",
      "text": "오일 격실 청소는 가죽이나 스펀지를 사용하며, 면 폐기물은 사용해서는 안 된다. 천은 깨끗한 것을 사용하고, 굵은 섬유, 금속 섬유 등이 없어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부품 교체 및 청결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-060",
      "text": "청소나 탈지를 위해 솔벤트 사용이 가능한 곳에서는 장비와 적합해야 한다. 그리고 화재나 독성 영향에 대한 예방대책이 필요한 곳에서는 불연성과 비독성 솔벤트를 사용해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부품 교체 및 청결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-061",
      "text": "덮개, 케이블 말단처리 등은 제거하기 전에 올바른 교체를 확인하고, 표시해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덮개와 접속표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-062",
      "text": "시험을 위해 만들어진 접속은 원상복구를 위한 재접속을 용이하도록 표시해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덮개와 접속표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-063",
      "text": "전원연결이 복구되고, 일시적인 연결과 표시는 장치가 전원공급으로 변환되기 전에 제거해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덮개와 접속표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-064",
      "text": "이동 가능한 플러그, 미끄럼 접속은 작동, 청결 및 과열 징후 여부를 확인해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덮개와 접속표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-065",
      "text": "유연한 접속은 소모성 징후와 유연성의 상실을 확인하고, 필요에 따라 보완조치를 시행해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덮개와 접속표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-066",
      "text": "절연 상태는 정기적으로 측정해야 하며 정비시 절연상태를 점검해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-067",
      "text": "자기 등 모든 애자는 균열이나 다른 결함의 유무를 점검해야 하며, 접착, 적층 절연물 및 다른 유기 절연물은 트래킹, 트리잉, 층간분리 또는 기계적 손상 징후를 점검해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-068",
      "text": "전극사이 그리고 전극과 접지사이의 절연저항 측정은 전원공급이 차단된 상태하에서 절연 시험하는 것이 적합하다.",
      "guideContext": "고전압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "절연시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-069",
      "text": "판단을 용이하게 하기 위해서는 체계적인 시험과 기록방법이 필요하다. 시험 장비와 사용된 방법은 동일하게 적용해야 하고, 시험값은 일정 양식에 시험 당시의 온도와 습도 상태를 기록해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-070",
      "text": "시험 후에 도체는 대지로 방전시키고 배선과 보조 부품의 절연저항은 DC 500V를 초과하지 않는 전압에서 시험되어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-071",
      "text": "배전반의 절연 형태로 사용되는 수지결합, 적층물질 그리고 자기의 저항측정의 결과는 물질의 표면 상태와 습도에 영향을 받으므로 절연시험은 절연체(애자) 표면의 외관 점검을 동반하여야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-072",
      "text": "열악한 환경조건은 절연유에 악영향을 주고 절연유의 오염은 유지보수 운영에 제한요소가 되어 제조사의 설명서에 근거한 일정 주기로 점검해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연유 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-073",
      "text": "절연유는 깨끗한 절연유와 사용된 절연유를 확실히 분리하고, 관리를 위해 확실히 표기해야 한다. 그리고 사용 전에 조사하여 깨끗한 절연유를 사용해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연유 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-074",
      "text": "유입 단자 부싱의 오일수준은 정기적으로 점검하고, 두드러진 변화나 오일 누출의 징후가 있다면 제조사와 협의해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부싱 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-075",
      "text": "충전형 부싱의 지향측정은 습기 상태를 알 수 없으므로 매 5년마다 콤파운드 상부 공간에서 습기 침입의 징후에 대해 점검해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부싱 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-076",
      "text": "덮개가 제거된 곳은 접속부의 재조립에 주의하고 점검하는 동안 접지를 확인해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부싱 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-077",
      "text": "압력게이지를 설치한 차단기에 대하여 SF6 가스압력과 온도에 대한 정기점검을 실시하고 가스 누출량을 기록해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SF6 가스 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-078",
      "text": "아크 혼은 안전하고 간극치수는 정확해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SF6 가스 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-079",
      "text": "노출된 모든 금속은 접지해야 하며, 접지는 기계적·전기적으로 견고해야 한다. 모든 접점 나사는 단단히 조이고 양호한 접점을 유지해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접지·셔터·잠금장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-080",
      "text": "셔터와 잠금장치의 기계적 특징은 모든 상태에서 올바른 기능과 부적절한 작동을 방지하기 위해 점검해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접지·셔터·잠금장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-081",
      "text": "기계장치는 부식이 없어야 하고, 암나사 또는 잠금장치 등의 작동이 안전해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접지·셔터·잠금장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-082",
      "text": "연동장치의 점검이나 정비를 위한 책임자는 필요한 지식과 설비 경험과 함께 연동장치의 범위, 종류, 기능 그리고 목적을 이해해야 한다. 제조사 안내서와 관련된 시설 도식은 참조해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-083",
      "text": "기계적 관점에서 모든 움직이는 부품은 청결하고, 적절히 기름칠 되어야 하고, 정확하게 작동되어야 한다. 마모 징후 또는 과도한 작동 징후는 점검 및 조사되어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-084",
      "text": "전기적 관점에서 모든 제어 권선은 손상의 징후를 조사해야 하며, 절연 상태가 불량하면 절연저항 시험을 실시해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-085",
      "text": "관련된 모선 또는 간선이 정전될 수 있는 곳의 모든 연동장치는 장비가 전원공급으로 복구되기 전에 기능시험을 실시해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-086",
      "text": "기능점검은 연동 시스템이 계획된 작동순서를 이행할 뿐만 아니라 필요할 경우 계획되지 않거나 부적절한 작동의 예방을 위해 실시해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-087",
      "text": "연동장치 결점이 발견된 후 즉시 개선이 이행되지 않을 때에는 다른 수단에 의해 안전을 보장하는 조치를 해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-088",
      "text": "환기장치는 기류가 제한받지 않도록 해야 하며, 강제환기의 경우 기류 연동장치가 정확하게 작동하는지를 점검해야 한다. 필터는 필요에 따라 교체되거나 청소되어야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "환기·과열·조명 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "13",
      "basedOn": null
    },
    {
      "identifier": "CI-E17-089",
      "text": "난방기, 조명, 비상등 설비 및 저전압 공급을 위한 변경장비의 운전을 확인해야 한다.",
      "guideContext": "고전압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "환기·과열·조명 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "13",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E17-001",
      "term": "개폐장치(Switchgear)",
      "definition": "일반적으로 보호 및 제어 장치의 개폐와 관련된 장치 등의 충칭으로 발전, 송전, 배전, 변전 및 변환에 관한 결합체, 보조물, 상자와 지지 구조 등에 관련된 장치들의 집합체도 포함된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-002",
      "term": "제어장치(Controlgear)",
      "definition": "전력계통에 연결된 전력설비의 제어를 위하여, 개폐장치, 측정장치, 보호장치 등이 하나의 외함 또는 부속설비로 이루어 진 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-003",
      "term": "밀폐함(Enclosure)",
      "definition": "내부의 도체나 장치를 보호하고, 충전 부품에 사람이 우연히 접촉하는 것을 막기 위해 이용되는 상자 또는 외함을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-004",
      "term": "셔터(Shutter)",
      "definition": "가동부의 접점이 고정 접점에 닿도록 허용되는 위치로부터 이것이 고정접점을 차폐하는 밀폐 또는 분할의 한 부분이 되는 위치까지 움직일 수 있는 집합체의 한 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-005",
      "term": "점검(Inspection)",
      "definition": "개폐기 및 제어기 등의 상태를 확실하게 평가하기 위한 진단 및 측정과 비파괴 시험과 같은 방법으로 보충되는 부분적인 분해를 추가한 점검을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-006",
      "term": "정비(Maintenance)",
      "definition": "어떤 품목이 요구되는 기능을 수행할 수 있는 상태로 유지되거나 복원하려는 의도로 행하는 감독 업무를 포함한 모든 기술적, 행정적 업무를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-007",
      "term": "격실(Compartment)",
      "definition": "다른 물건의 접촉, 사고를 방지할 목적으로 모선이나 차단기 등을 다른 모선이나 기기에서 격리하여 수납하기 위해 만든 칸막이 방을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-008",
      "term": "차단기(Circuit breaker)",
      "definition": "사람의 개입없이 정상적인 조건하에서 전원을 투입하거나 차단할 뿐만 아니라, 특정시간에 전류를 통전시키거나 단락과 같은 비정상적인 회로 조건하에서는 전류를 차단하는 개폐 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-009",
      "term": "진단시험(Diagnostic test)",
      "definition": "개폐기 및 제어기의 여러 특성을 측정하여 장치의 기능이 실행되는지 점검하기 위한 개폐기 및 제어기의 비교시험을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E17-010",
      "term": "연동장치(Interlock device)",
      "definition": "장비에서 하나 이상의 다른 장치의 위치나 동작에 따라 개폐 장치가 동작되도록 하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E17-01",
