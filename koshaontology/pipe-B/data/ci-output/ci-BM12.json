  "domainTerms": [
    {
      "identifier": "DT-BM12-001",
      "term": "달기기구",
      "definition": "로프슬링(Rope-sling), 체인슬링(Chain-sling), 링(Ring), 훅(Hook), 샤클(Shackle) 등과 같이 인양물건을 쉽게 체결하여 운반작업을 안전하게 수행 할 수 있는 운반보조 기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-002",
      "term": "리그(lug)",
      "definition": "크레인 달기기구의 윗쪽에 줄걸이용인 와이어로프, 섬유로프 또는 크레인의 훅 등을 직접 결속할 수 있도록 원형구멍을 낸 걸고리쇠를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-003",
      "term": "크레인(Crane)",
      "definition": "훅(Hook)이나 그 밖의 달기기구를 사용하여 화물의 권상과 이송을 목적으로 일정한 작업공간 내에서 반복적인 동작이 이루어지는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-004",
      "term": "호이스트(Hoist)",
      "definition": "원동장치, 감속장치 및 드럼 등을 일체형으로 조합한 양중장치와 이 양중장치를 사용하여 화물의 권상 및 횡행 또는 권상 동작만을 행하는 크레인을 말하며, 정치식·모노레일식·이중레일식 호이스트로 구분한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-005",
      "term": "횡행(Traversing)",
      "definition": "크래브(Crab) 또는 트롤리(Trolley)가 거더(Girder), 트랙(Track), 로프(Rope), 지브(Jib) 등을 따라 이동하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-006",
      "term": "줄걸이 작업",
      "definition": "운반하는 화물에 달기기구를 걸거나 벗기는 행위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-007",
      "term": "와이어로프(Wire rope)",
      "definition": "양질의 탄소강(C:0.50~0.85)의 소재를 인발한 많은 소선(Wire)을 집합하여 꼬아서 스트랜드(Strand)를 만들고 이 스트랜드를 심(Core) 주위에 일정한 피치(Pitch)로 감아서 제작한 일종의 로프이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-008",
      "term": "소선(Wire)",
      "definition": "스트랜드를 구성하는 강선, 비도금 소선을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-009",
      "term": "스트랜드(Strand)",
      "definition": "복수의 소선 등을 꼰 로프의 구성요소, 밧줄 또는 연선를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-010",
      "term": "해지장치",
      "definition": "훅걸이용 와이어로프 등이 훅으로부터 벗겨지는 것을 방지하기 위한 장치이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-011",
      "term": "파단하중",
      "definition": "파단시험에서 시험편이 파단될 때 까지의 최대하중을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-012",
      "term": "로프지름",
      "definition": "로프 임의의 단면에서 외접원의 지름을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-013",
      "term": "필러(Filler)선",
      "definition": "필러형 로프 스트랜드 안에서 내·외중 소선사이의 빈틀을 채우고 있는 소선을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM12-014",
      "term": "정격하중",
      "definition": "크레인의 권상(호이스팅)하중에서 훅, 크래브(Crab) 또는 버킷(Bucket) 등 달기기구의 중량에 상당하는 하중을 뺀 하중을 말한다. 다만, 지브(Jib)가 있는 크레인 등으로서 경사각의 위치에 따라 권상능력이 달라지는 것은 그 위치의 권상하중에서 달기기구의 중량을 뺀 하중을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BM12-01",
      "processOrder": 1,
      "processName": "달기기구 선정 및 점검",
      "safetyMeasures": "달기기구의 재질 및 강도는 화물의 형상 및 하중을 고려하여 충분한 내구력을 갖도록 설계한다. 정격하중 표시 확인, 해지장치 균열·변형 확인, 볼트·너트 풀림 확인을 실시한다.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "4.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-02",
      "processOrder": 2,
      "processName": "러그(Lug) 용접",
      "safetyMeasures": "리그 부착 위치는 수직·수평보의 교차점으로 하고, 접촉부위가 완전 용입되도록 용접한다. 하중별 리그 용접길이를 적용하며, 재질 SS41 기준 안전율 10 적용시 허용응력 4.1kgf/㎟로 산정한다.",
      "requiredPPE": [
        "안전모",
        "용접보안면",
        "용접장갑"
      ],
      "sourceSection": "4.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-03",
      "processOrder": 3,
      "processName": "훅 점검",
      "safetyMeasures": "일상점검으로 육안 겉모양·각부 이상유무를 점검하고, 통상점검으로 훅 변형·손상, 결합부분 이완, 나사부 균열·마모, 해지장치 효과를 점검한다. 개조(기계가공, 용접, 열처리, 전기도금, 해지장치 철거) 금지.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "5.2.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-04",
      "processOrder": 4,
      "processName": "아이 스플라이스(Eye splice) 가공",
      "safetyMeasures": "모든 스트랜드를 3회 이상 끼워 짠 후 각 스트랜드 소선 절반을 절단하고 남은 소선을 2회 이상 끼워 짠다(4회 이상 시 1회). 아이 부위 심블은 반드시 용접된 상태여야 한다.",
      "requiredPPE": [
        "안전장갑",
        "보안경"
      ],
      "sourceSection": "8.3.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-05",
      "processOrder": 5,
      "processName": "소켓(Socket) 가공",
      "safetyMeasures": "와이어로프를 시이징 처리 후 소선을 완전히 풀어헤친 상태에서 용융금속을 주입한다. 정확히 가공하면 이음효율 100%.",
      "requiredPPE": [
        "안전장갑",
        "보안경",
        "방열복"
      ],
      "sourceSection": "8.3.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-06",
      "processOrder": 6,
      "processName": "클립(Clip) 체결",
      "safetyMeasures": "새들은 힘이 걸리는 쪽에 위치, 클립 간격은 로프 직경 6배 이상, 수량 최소 4개 이상. 하중 전후 단단히 조임. 심블 부착 권장, 사용 시 이탈방지 용접. 남은부분 시이징 처리.",
      "requiredPPE": [
        "안전장갑"
      ],
      "sourceSection": "8.3.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-07",
      "processOrder": 7,
      "processName": "줄걸이 방법 선정 및 작업",
      "safetyMeasures": "1줄걸이 원칙적 금지. 화물 중심위치 정확히 잡고, 대칭·비대칭 결정, 각도에 따른 장력변화 유의, 후킹용 바 지름은 와이어로프 직경 6배 이상. 줄걸이 각도 60° 이내 권장. 안전교육 이수자가 작업.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전장갑"
      ],
      "sourceSection": "9.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-08",
      "processOrder": 8,
      "processName": "화물 하역 후 줄걸이 용구 분리",
      "safetyMeasures": "훅축 분리 시 가능한 낮은 위치에서 실시. 대형 와이어로프 비틀림 흔들림 주의. 크레인으로 잡아당겨 분리 금지.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전장갑"
      ],
      "sourceSection": "9.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-09",
      "processOrder": 9,
      "processName": "줄걸이용 와이어로프 품질보증",
      "safetyMeasures": "연결 고정 후 인장시험 실시하여 와이어로프 및 피팅류 상태 확인. 시험결과 문서화 보관. 제조자 꼬리표에 제조자명, 안전작업하중, 제조일자, 제조번호 표시.",
      "requiredPPE": [],
      "sourceSection": "9.4.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM12-10",
      "processOrder": 10,
      "processName": "작업자 동반 중량물 운반작업",
      "safetyMeasures": "운반 화물로부터 안전거리 유지, 운반방향 반대쪽 45° 지점에 위치. 화물에 직접 손 대지 않고 안전수공구 사용. 크레인 작업시 수공구 사용에 관한 기술지침(M-84) 참조.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전장갑"
      ],
      "sourceSection": "10",
      "relatedSR": null
    }
  ],
