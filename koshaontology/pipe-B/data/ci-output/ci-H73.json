  "checklistItems": [
    {
      "identifier": "CI-H73-001",
      "text": "환기장치의 설치 및 가동에 관한 사항은 안전보건규칙 제1편 총칙 제8장(환기장치) 등에 따른다.",
      "guideContext": "용접 흄 제거를 위한 환기대책",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-002",
      "text": "작업특성상 국소배기장치의 설치가 곤란하여 전체 환기장치를 설치하여야 할 경우에는 필요 환기량(작업장 환기횟수 : 15~20회/시간)을 충족시킬 것",
      "guideContext": "전체 환기장치 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-003",
      "text": "유입공기가 오염장소를 통과하되 작업자 쪽으로 오지 않도록 위치를 선정할 것",
      "guideContext": "전체 환기장치 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-004",
      "text": "공기 공급은 청정공기로 할 것",
      "guideContext": "전체 환기장치 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-005",
      "text": "오염원 주위에 다른 공정이 있으면 공기배출량을 공급량보다 크게 하고, 주위에 다른 공정이 없을 시에는 청정공기 공급량을 배출량보다 크게 할 것",
      "guideContext": "전체 환기장치 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-006",
      "text": "배출된 공기가 재유입 되지 않도록 배출구 위치를 선정",
      "guideContext": "전체 환기장치 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-007",
      "text": "고정된 장소에서의 용접작업지점에는 국소배기장치를 설치하여 작업토록 한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-008",
      "text": "국소배기시설의 후드는 작업지점이 포위될 수 있도록 부스식으로 설치한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-009",
      "text": "외부식 후드를 설치할 경우 작업지점 측면에 후드를 접근시켜 작업자가 용접 흄에 노출되지 않도록 한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-010",
      "text": "국소배기시설로써 배출되지 않은 용접 흄을 희석하기 위해 전체 환기시설을 설치한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-011",
      "text": "고정되지 않고 이동하는 용접작업지점에는 이동집진기 또는 이동식 환기팬을 설치 가동한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-012",
      "text": "주위에서 작업하는 근로자의 시력보호를 위해 차광펜스를 설치한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-013",
      "text": "국소배기기설이 정상적으로 가동하는 상태에서 작업한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-014",
      "text": "흄용 방진마스크나 송기마스크를 착용한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-015",
      "text": "차광안경을 착용한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-016",
      "text": "소음이 85 dB(A) 이상 시에는 귀마개 등 보호구를 착용한다.",
      "guideContext": "옥내용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H73-017",
      "text": "바람을 등지고 작업한다.",
      "guideContext": "옥외용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥외용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-018",
      "text": "주위에서 작업하는 근로자의 시력보호를 위해 차광펜스를 설치한다.",
      "guideContext": "옥외용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥외용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-019",
      "text": "흄용 방진마스크나 송기마스크를 착용한다.",
      "guideContext": "옥외용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥외용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-020",
      "text": "차광안경을 착용한다.",
      "guideContext": "옥외용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥외용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-021",
      "text": "소음이 85 dB(A) 이상 시에는 귀마개 등 보호구를 착용한다.",
      "guideContext": "옥외용접작업",
      "additionalDetail": null,
      "workProcessPhase": "옥외용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H73-022",
      "text": "급기 및 배기용 팬을 가동하면서 작업한다.",
      "guideContext": "밀폐공간에서의 용접작업",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-023",
      "text": "작업 전 산소농도를 측정하여 18 % 이상 시에만 작업한다. 작업 중에 산소농도가 떨어질 수 있으므로 수시로 점검한다.",
      "guideContext": "밀폐공간에서의 용접작업",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-024",
      "text": "흄용 방진마스크 또는 송기마스크를 착용하고 작업한다.",
      "guideContext": "밀폐공간에서의 용접작업",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-025",
      "text": "소음이 85 dB(A) 이상 시에는 귀마개 등 보호구를 착용한다.",
      "guideContext": "밀폐공간에서의 용접작업",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H73-026",
      "text": "탱크맨홀 및 피트 등 통풍이 불충분한 곳에서 작업 시에는 긴급사태에 대비할 수 있는 조치(외부와의 연락장치, 비상용사다리, 로프 등을 준비)를 취한 후 작업한다.",
      "guideContext": "밀폐공간에서의 용접작업",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-HEAT-003"
      ]
    },
    {
      "identifier": "CI-H73-027",
      "text": "용접작업에 근로자를 종사하게 하는 경우에는 당해작업 계획 수립 시 용접 흄 등에 의한 유해여부를 우선적으로 고려하여, 용접 흄 발생 억제조치 설비의 설치, 작업공정에 사용되는 환기장치의 적절한 가동요령 등에 관한 사항, 보호구의 착용방법 및 관리방법, 용접봉·피복재 및 피용재 등의 MSDS를 활용한 합금성분 등의 함유량에 대한 사항, 기타 용접 흄 및 가스·유해광선 등에 의한 근로자 노출방지를 위한 사항 등을 포함하는 표준 작업관리 지침을 마련하여 당해 근로자가 이에 따라 작업한다.",
      "guideContext": "작업계획수립 및 표준작업관리지침 작성",
      "additionalDetail": null,
      "workProcessPhase": "작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-028",
      "text": "사전에 작업환경측정에 관련된 예비조사 및 장비 등을 점검하여 이상이 없을 시 현장에 나가 측정을 개시할 수 있도록 준비한다.",
      "guideContext": "근로자의 유해인자 노출정도의 측정",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-029",
      "text": "작업자는 평소와 같은 방법으로 작업에 임하도록 하며 측정자가 주지하는 내용 및 협조사항에 대해서 꼭 지키도록 하여 올바른 측정이 이루어지도록 한다.",
      "guideContext": "근로자의 유해인자 노출정도의 측정",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-030",
      "text": "작업환경측정 후 산업안전보건위원회 또는 근로자 대표로부터 작업환경 측정결과에 대한 설명회개최 요구가 있을 때에는 측정기관 또는 사업주가 설명회를 실시한다.",
      "guideContext": "근로자의 유해인자 노출정도의 측정",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-031",
      "text": "사업주는 근로자를 용접작업에 종사하도록 하는 경우에는 고용노동부고시 제2013-38호(화학물질 및 물리적인자의 노출기준)의 기준을 참고하여 필요한 조치를 취한다.",
      "guideContext": "근로자의 유해인자 노출정도의 측정",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-032",
      "text": "용접작업에 근로자를 종사하게 하는 경우에는 특별안전보건 교육을 실시한다.",
      "guideContext": "용접작업자에 대한 특별교육 실시",
      "additionalDetail": null,
      "workProcessPhase": "교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-033",
      "text": "보호구는 성능한계성, 검정합격품 여부 등을 사전에 검토하여 구입한다.",
      "guideContext": "보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-034",
      "text": "근로자가 용접 흄 등에 노출될 우려가 있는 작업장에서 작업하는 근로자는 흄용 방진마스크 또는 송기마스크를 착용한다.",
      "guideContext": "보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-035",
      "text": "호흡용 보호구는 해당 근로자수 이상의 보호구를 지급하고 보호구의 공동사용으로 인한 질병감염을 방지하기 위하여 개인전용의 것을 지급한다.",
      "guideContext": "보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-036",
      "text": "지급된 보호구는 수시로 점검하여 양호한 상태로 유지·관리하고 호흡용 보호구는 여과재의 사용한계에 따른 교체시기를 명확히 하여 정해진 날짜에 교체한다.",
      "guideContext": "보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-037",
      "text": "용접작업 중 가동 중인 국소배기장치 등은 작업자 임의로 정지시키지 않도록 하고 감독자의 지시에 따른다.",
      "guideContext": "근로자의 준수사항",
      "additionalDetail": null,
      "workProcessPhase": "옥내용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-038",
      "text": "용접 흄이 최대한 작업장 주변으로 비산되지 않는 방법으로 작업한다.",
      "guideContext": "근로자의 준수사항",
      "additionalDetail": null,
      "workProcessPhase": "용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-039",
      "text": "용접 흄에 노출되지 않도록 주의하면서 작업한다.",
      "guideContext": "근로자의 준수사항",
      "additionalDetail": null,
      "workProcessPhase": "용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-040",
      "text": "작업 시 지급된 보호구는 사업주 및 안전·보건관계자 등의 지시에 따라 반드시 착용한다.",
      "guideContext": "근로자의 준수사항",
      "additionalDetail": null,
      "workProcessPhase": "용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-041",
      "text": "용접 흄, 가스, 유해광선에 의한 건강장해의 예방을 위하여 사업주 및 안전·보건관계자 등의 지시에 따른다.",
      "guideContext": "근로자의 준수사항",
      "additionalDetail": null,
      "workProcessPhase": "용접작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-042",
      "text": "작업량·작업속도 등을 필요이상으로 올리지 않도록 지도한다.",
      "guideContext": "관리감독자의 의무",
      "additionalDetail": null,
      "workProcessPhase": "관리감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-043",
      "text": "통풍이 불충분한 장소에서의 용접작업 시에는 환기장치를 가동하고 송기마스크, 흄용 방진마스크 등을 착용토록 지도·감독한다.",
      "guideContext": "관리감독자의 의무",
      "additionalDetail": null,
      "workProcessPhase": "관리감독",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.6",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-044",
      "text": "가급적 통풍이 충분한 장소에서 작업토록 하여 용접 흄의 흡입이 최소화되도록 작업방법을 정해준다.",
      "guideContext": "관리감독자의 의무",
      "additionalDetail": null,
      "workProcessPhase": "관리감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-045",
      "text": "응급조치요령을 주지시킨다. 호흡곤란 시 노출지역에서 벗어나 신선한 공기가 있는 곳으로 옮길 것, 필요하다면 인공호흡을 시킬 것, 상황이 발생하면 즉시 보건관리자 등과 연계하며 의학적 조치가 되도록 할 것, 구토 시에는 기도의 막힘을 방지하기 위하여 머리를 옆으로 하여 둔부보다 낮게 누이도록 할 것, 환자를 따뜻하게 하고 안정시킬 것",
      "guideContext": "관리감독자의 의무",
      "additionalDetail": null,
      "workProcessPhase": "관리감독",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2.6",
      "basedOn": [
        "SR-HEAT-003"
      ]
    },
    {
      "identifier": "CI-H73-046",
      "text": "용접작업 근로자에게는 소음(85 dB(A) 이상 시)에 대한 특수건강진단을 2년 1회 실시한다.",
      "guideContext": "건강진단",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": [
        "SR-NOISE-003"
      ]
    },
    {
      "identifier": "CI-H73-047",
      "text": "피용접물 또는 용접봉에 망간(크롬산, 카드뮴)등이 1 % 이상 함유 물질과 용접흄 등에 노출되는 근로자는 1년에 1회 이상 특수건강진단을 실시한다.",
      "guideContext": "건강진단",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-048",
      "text": "사업주는 법령에 의한 건강진단을 실시하고 건강진단 개인표를 송부 받은 때에는 그 결과를 지체 없이 근로자에게 통보하고, 근로자의 건강을 유지하기 위하여 필요하다고 인정할 때에는 작업장소의 변경, 작업의 전환, 근로시간의 단축 및 작업환경개선 등 기타 적절한 조치를 한다.",
      "guideContext": "건강진단",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-049",
      "text": "사업주는 산업안전보건위원회 또는 근로자대표의 요구가 있을 때에는 직접 또는 건강진단을 실시한 기관으로 하여금 건강진단 결과에 대한 설명을 실시한다.",
      "guideContext": "건강진단",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-050",
      "text": "건강상담 및 건강진단실시에 따른 자각증상 호소자에 대하여 질병의 이환여부 또는 질병의 원인 등을 발견하기 위하여 임시 건강진단을 실시한다.",
      "guideContext": "건강진단",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-051",
      "text": "근로자에 대하여 특수건강진단을 실시하는 경우에는 각 유해인자별로 법 시행규칙 〈별표 13〉에서 정한 검사항목이 누락되지 않도록 한다.",
      "guideContext": "건강진단",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-052",
      "text": "용접이 실시되고 있는 작업장내에서는 음식물을 먹지 않는다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-053",
      "text": "용접작업 후 식사를 하는 경우에는 손이나 얼굴을 깨끗이 씻고, 별도의 장소에서 식사한다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-054",
      "text": "용접작업장에서는 보호구를 착용한 후 작업에 임하도록 하고 사용한 보호구는 불순물 및 감염물을 제거한 후 청결한 장소에 보관한다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-055",
      "text": "비상시 사용한 호흡용 보호구는 적어도 1개월 또는 사용 후마다 소독하여 보관한다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-056",
      "text": "작업을 종료한 경우에는 샤워시설 등을 이용하여 손, 얼굴 등을 씻거나 목욕을 한다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-057",
      "text": "퇴근 시에는 작업복을 벗고 평상복으로 갈아입는다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-058",
      "text": "용접작업장소와 격리된 장소에 근로자가 이용할 수 있는 휴게시설을 설치한다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-059",
      "text": "용접작업장 근로자의 건강보호를 위하여 세안, 세면, 목욕, 탈의, 세탁 및 건조시설 등을 설치하고 옷장, 보호구보관함 등 필요한 용품 및 용구를 비치한다.",
      "guideContext": "근로자 개인위생관리",
      "additionalDetail": null,
      "workProcessPhase": "시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H73-060",
      "text": "이러한 작업을 수행하는 근로자는 물론 인근에 있는 근로자도 항상 청력보호구를 착용하여야 한다.",
      "guideContext": "용접작업 시 소음에 의한 청력손실 방지",
      "additionalDetail": "용접, 아크흄가공, 플라즈마 아크용단, 공기탄소 아크용단 및 그라인딩과 같은 공정에서 강렬한 수준의 소음 발생",
      "workProcessPhase": "용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "별첨 2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H73-061",
      "text": "용접과 용단은 주위에 탈수 있는 물질이 없는 상태에서 이루어져야 한다. 가연성 물질은 용접작업 장소로부터 격리되어야 한다.",
      "guideContext": "화재·폭발 방지",
      "additionalDetail": null,
      "workProcessPhase": "용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별첨 2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-H73-062",
      "text": "밀폐 장소에서의 용접 및 용단작업에 대한 지침서를 확보하고 이를 활용하여야 한다.",
      "guideContext": "화재·폭발 방지",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "별첨 2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-H73-063",
      "text": "기류가 한편으로만 흐르지 않도록 공기를 공급 할 것",
      "guideContext": "전체 환기장치 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-H73-064",
      "text": "난방 및 냉방, 창문 등의 영향을 충분히 고려해서 설치할 것",
      "guideContext": "전체 환기장치 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "환기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H73-001",
      "term": "용접(Welding)",
      "definition": "2개 이상의 고체금속을 하나로 접합시키는 금속가공 기술수단을 말하며, \"용단\"이란 전극봉과 모재금속 간에 아크열 등으로 용융시켜 금속을 자르거나 또는 제거하는 것을 말한다. 본 지침에서는 이 두 가지를 통칭하여 용접이라 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H73-002",
      "term": "용접 흄(Welding fume)",
      "definition": "용접작업 시 발생하는 금속의 증기가 응축되거나, 산화되는 등의 화학반응에 의해 형성된 고체상 미립자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H73-003",
      "term": "용접 분진",
      "definition": "용접작업장 주변의 공기 중에 부유하고 있는 모든 고체의 미세한 입자상의 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H73-004",
      "term": "밀폐 공간",
      "definition": "산소결핍이나 유해가스로 인한 중독·화재·폭발 등의 위험이 있는 장소로서 산업안전보건기준에 관한 규칙(이하 \"안전보건규칙\"이라 한다) 〈별표18〉에서 정한 장소를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H73-005",
      "term": "유해광선",
      "definition": "용접작업 시 발생되는 자외선, 가시광선, 적외선 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H73-006",
      "term": "유해가스",
      "definition": "용접작업 시 발생되는 가스로서 오존, 질소산화물, 일산화탄소, 이산화탄소 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H73-01",
      "processOrder": 1,
      "processName": "옥내용접작업 환경관리",
      "safetyMeasures": "고정된 장소에서의 용접작업지점에는 국소배기장치를 설치하여 작업. 국소배기시설의 후드는 작업지점이 포위될 수 있도록 부스식으로 설치. 외부식 후드를 설치할 경우 작업지점 측면에 후드를 접근시켜 작업자가 용접 흄에 노출되지 않도록 함. 국소배기시설로 배출되지 않은 용접 흄을 희석하기 위해 전체 환기시설을 설치. 이동 작업지점에는 이동집진기 또는 이동식 환기팬을 설치 가동. 차광펜스 설치.",
