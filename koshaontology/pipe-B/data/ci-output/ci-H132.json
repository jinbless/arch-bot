  "checklistItems": [
    {
      "identifier": "CI-H132-001",
      "text": "벤젠 노출 근로자에 대하여 배치전 및 주기적 건강진단을 실시하여 관찰하고자 하는 주요 소견은 말초혈액의 변화이다.",
      "guideContext": "벤젠 노출 근로자 건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-002",
      "text": "말초혈액검사는 표준화된 방법에 의해 정도관리를 수행하는 인증된 실험실에서 검사하며 정상범위는 각각의 실험실에서 정한 참고치를 기준으로 한다.",
      "guideContext": "벤젠 노출 근로자 건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-003",
      "text": "말초혈액검사는 연령(노인은 정상에서도 낮은 적혈구 수치를 나타내는 경향이 있음), 체내 수분 균형(적혈구 수, 혈색소, 혈구용적치는 탈수된 경우 높게 나타남), 혈구계산법[혈소관은 자동혈구계산기로 하는 경우에 항응고제로서 에틸렌디아민테트라아세트산(Etylene diamine tetra-acetic acid, 이하 \"EDTA\"라 한다)을 이용하고 있는데 때로는 응고가 일어나 혈소관 감소로 보고되는 경우가 있음) 및 기타(백혈구는 식사, 운동, 선 자세 및 낮 동안 증가함) 요인에 의해 영향을 받으므로 주의하여 해석한다.",
      "guideContext": "벤젠 노출 근로자 건강진단",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-004",
      "text": "벤젠 취급업무에 종사하는 근로자에 대한 특수건강진단은 배치 후 2개월 이내에 실시하고 그 후 6개월에 1회 이상 주기적으로 실시한다.",
      "guideContext": "벤젠 노출 근로자 건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-005",
      "text": "당해 건강진단 직전 작업환경측정결과 벤젠 농도가 노출기준 이상인 경우 또는 벤젠에 의한 직업병 유소견자가 발견된 경우 벤젠에 노출되는 작업공정에 종사하는 근로자에 대하여 특수건강진단 주기를 6개월에서 3개월로 단축한다.",
      "guideContext": "벤젠 노출 근로자 건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-006",
      "text": "근로자가 혈액학적 이상, 급성 신경학적 장해(의식변화, 혼수, 보행장해 등) 등의 증상 및 증세를 보이는 경우 벤젠에 의한 독성영향을 고려한다.",
      "guideContext": "벤젠 노출 근로자 수시건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-007",
      "text": "사업주가 수시건강진단의 필요성에 대하여 자문을 요청한 경우에는 건강진단기관의 의사는 자문에 응하여야 하며, 자문을 요청받은 의사는 수시건강진단의 필요성 여부에 대한 자문결과서를 사업주에게 통보하여야 한다.",
      "guideContext": "벤젠 노출 근로자 수시건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-008",
      "text": "벤젠에 의한 조혈기계 이상이 의심되는 경우, 즉시 더 이상의 노출을 피하도록 조치한다.",
      "guideContext": "벤젠 노출 근로자 사후관리",
      "additionalDetail": null,
      "workProcessPhase": "사후관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H132-009",
      "text": "벤젠에 의한 조혈기계 이상이 의심되는 경우에는 즉시 혈액학을 전공한 내과 전문의에게서 감별진단과 적절한 치료를 받도록 한다.",
      "guideContext": "벤젠 노출 근로자 사후관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사후관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-010",
      "text": "적혈구, 백혈구, 혈소판 중 두 종류 이상의 세포감소증이나 범혈구감소증은 대부분 벤젠노출을 중단하면 정상으로 회복되지만 업무적합성 여부 평가 없이 벤젠에 노출되는 업무에 복귀하는 것은 피하는 것이 좋다.",
      "guideContext": "벤젠 노출 근로자 사후관리",
      "additionalDetail": null,
      "workProcessPhase": "사후관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-011",
      "text": "눈이나 피부에 접촉된 경우 일차적인 응급조치는 노출이 일어난 장소에서 시행될 수 있도록 벤젠 취급 작업장 내에 눈 및 피부 세척을 위한 시설이 갖추어져 있어야 한다.",
      "guideContext": "벤젠 취급 작업장 응급조치 시설",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H132-012",
      "text": "벤젠이 눈에 들어갔을 경우에는 즉시 많은 양의 물을 사용하여 가끔씩 눈꺼풀을 들어올리면서 적어도 15분 동안 눈을 씻고 가능한 빨리 의사의 진료를 받는다.",
      "guideContext": "벤젠 취급 작업장 응급조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-013",
      "text": "벤젠 작업시 콘택트렌즈는 착용하지 않는다.",
      "guideContext": "벤젠 취급 작업장 응급조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H132-014",
      "text": "벤젠이 피부에 접촉되었을 때에는 즉시 물과 비누로 세척한다.",
      "guideContext": "벤젠 취급 작업장 응급조치",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H132-015",
      "text": "벤젠이 의복으로 침투되었을 때 즉시 오염된 의복을 제거하고 물과 비누로 세척하고 즉시 의사의 치료를 받는다.",
      "guideContext": "벤젠 취급 작업장 응급조치",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H132-016",
      "text": "다량의 벤젠 흡입시에는 즉시 신선한 공기가 있는 지역으로 이동시킨다.",
      "guideContext": "벤젠 취급 작업장 응급조치",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.3",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H132-017",
      "text": "호흡하지 않을 경우에는 인공호흡을 실시하고, 환자를 따뜻하게 하고 안정을 취하게 하며, 즉시 의사의 치료를 받게 한다.",
      "guideContext": "벤젠 취급 작업장 응급조치",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.3",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H132-018",
      "text": "벤젠을 먹은 경우 위의 내용물을 토하게 하지 말고 즉시 의사의 치료를 받게 한다.",
      "guideContext": "벤젠 취급 작업장 응급조치",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.4",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H132-019",
      "text": "벤젠은 우리나라를 포함한 대부분의 국가에서 1 ppm을 노출기준으로 정하고 있으나 조혈기계에 암을 일으키는 발암성 물질이기 때문에 1 ppm 이하 농도라고 가급적 노출을 피하고 부득이하게 노출시 반드시 보호구를 착용한다.",
      "guideContext": "벤젠 취급 근로자 건강장해 예방",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H132-020",
      "text": "벤젠에 노출되는 근로자는 호흡용 보호구의 사용지침(KOSHA Guide H-82-2015)에 따라 <표 5>의 호흡용 보호구별 보호계수를 고려하여 적절한 호흡용 보호구를 착용한다.",
      "guideContext": "벤젠 취급 근로자 보호구",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H132-021",
      "text": "호흡용 보호구는 한국산업안전보건공단의 검정(\"안\" 마크)을 받은 것을 사용하여야 한다.",
      "guideContext": "벤젠 취급 근로자 보호구",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H132-022",
      "text": "공기 정화식 호흡용 보호구는 산소가 결핍된 장소에서는 사용할 수 없다.",
      "guideContext": "벤젠 취급 근로자 보호구",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.1",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-H132-023",
      "text": "벤젠 노출 근로자는 피부접촉과 흡수를 줄이기 위해 내화학성 보호장갑을 착용한다.",
      "guideContext": "벤젠 취급 근로자 보호구",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H132-024",
      "text": "보호장갑은 화학작업용으로 제조된 것을 사용하는 것이 좋으며, 벤젠에 대한 침투성 검사 결과가 우수한 재질을 쓰는 것이 바람직하다.",
      "guideContext": "벤젠 취급 근로자 보호구",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H132-025",
      "text": "벤젠은 보호장갑을 착용하더라도 제한적인 사용만 허용(4시간에서 8시간 사용 후 교환 합)되며 보호장갑의 재질은 네오프렌, 천연고무, 부틸고무 등을 권장한다.",
      "guideContext": "벤젠 취급 근로자 보호구",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H132-026",
      "text": "보호장갑 제품들은 제조회사에 따라 질이 매우 다양하므로 반드시 제품별 투과성 자료를 제조회사에 요구하여 검토하는 것이 좋다.",
      "guideContext": "벤젠 취급 근로자 보호구",
      "additionalDetail": null,
      "workProcessPhase": "벤젠 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H132-027",
      "text": "과거에 벤젠 또는 그 밖의 혈액학적 독소에 노출된 경력, 혈액학적 암종의 가족력, 유전성 혈색소 이상을 포함한 혈액질환, 출혈성질환, 혈구기능의 이상, 간 및 신장질환, 약물복용 및 벤젠 이외의 독성물질 노출여부(클로람페니콜, 페닐부타존, 알킬화제제, 에틸렌옥사이드 등), 음주, 전신 감염증 여부, 방사선 피폭 여부 등에 대한 문진을 실시한다.",
      "guideContext": "벤젠 노출 근로자 감별진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H132-001",
      "term": "증상",
      "definition": "질환 또는 환자 상태의 주관적 증거로 환자에 의하여 인식되는 증거를 환자가 직접 호소하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H132-002",
      "term": "징후",
      "definition": "어떤 질환의 존재를 표시하는 것으로 환자가 의사에게 알려주거나 의사가 관찰하거나 조사함으로써 얻을 수 있는 질환의 객관적 증거를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H132-003",
      "term": "검사소견",
      "definition": "의사가 검사결과에 근거하여 판단하는 의학적 견해를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H132-01",
      "processOrder": 1,
      "processName": "건강진단 실시",
      "safetyMeasures": "배치전 및 주기적 건강진단 실시, 말초혈액검사는 표준화된 방법에 의해 정도관리를 수행하는 인증된 실험실에서 검사, 특수건강진단은 배치 후 2개월 이내 실시 후 6개월 1회 이상 주기적 실시, 노출기준 초과 또는 직업병 유소견자 발견 시 주기 3개월로 단축",
      "requiredPPE": [],
      "sourceSection": "8.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H132-02",
      "processOrder": 2,
      "processName": "사후관리",
      "safetyMeasures": "조혈기계 이상 의심 시 즉시 노출 중단 조치, 혈액학 전공 내과 전문의 감별진단 및 치료, 업무적합성 여부 평가 없이 벤젠 노출 업무 복귀 금지",
      "requiredPPE": [],
      "sourceSection": "8.2",
      "relatedSR": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "WP-H132-03",
      "processOrder": 3,
      "processName": "눈 접촉 시 응급조치",
      "safetyMeasures": "즉시 많은 양의 물로 눈꺼풀을 들어올리면서 최소 15분간 세척, 가능한 빨리 의사 진료, 벤젠 작업 시 콘택트렌즈 착용 금지",
      "requiredPPE": [],
      "sourceSection": "9.1",
      "relatedSR": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "WP-H132-04",
      "processOrder": 4,
      "processName": "피부 접촉 시 응급조치",
      "safetyMeasures": "즉시 물과 비누로 세척, 의복 침투 시 즉시 오염 의복 제거 후 물과 비누로 세척, 즉시 의사 치료",
      "requiredPPE": [
