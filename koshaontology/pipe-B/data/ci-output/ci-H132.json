      ]
    },
    {
      "identifier": "WP-H132-05",
      "processOrder": 5,
      "processName": "흡입 시 응급조치",
      "safetyMeasures": "즉시 신선한 공기가 있는 지역으로 이동, 호흡 정지 시 인공호흡 실시, 환자를 따뜻하게 하고 안정, 즉시 의사 치료",
      "requiredPPE": [],
      "sourceSection": "9.3",
