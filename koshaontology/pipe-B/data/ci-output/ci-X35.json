  "checklistItems": [
    {
      "identifier": "CI-X35-001",
      "text": "이 단계의 결과물은 분석을 하기 전에 해당 과제의 책임자와 안전 및 사업 담당 조직에 의해 면밀히 검토되어야 한다.",
      "guideContext": "확률론적 리스크 평가 목표 설정 (법령 근거 미확인)",
      "additionalDetail": "확률론적 리스크 평가의 목표와 범위를 정하는 단계에서 결과물 사전 검토 의무",
      "workProcessPhase": "목표 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-002",
      "text": "확률론적 리스크 평가의 목적을 파악하고, 의도한 목적과 결과의 활용 방안을 정의한다.",
      "guideContext": "확률론적 리스크 평가 목표 설정",
      "additionalDetail": null,
      "workProcessPhase": "목표 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-003",
      "text": "작업의 범위, 적용 대상이 되는 시스템의 설계 및 운영 범위, 사고 시나리오와 관련된 분석의 상세화 정도 등을 포함해 분석의 범위와 심도를 결정한다.",
      "guideContext": "확률론적 리스크 평가 목표 설정",
      "additionalDetail": null,
      "workProcessPhase": "목표 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-004",
      "text": "확률 목표 및 특정 결과의 기준에 기반해 전반적 리스크 목표와 수용 기준 결정",
      "guideContext": "확률론적 리스크 평가 목표 설정",
      "additionalDetail": "분석의 결과 측정 기준치 파악 활동의 일부",
      "workProcessPhase": "목표 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-005",
      "text": "관련 설계 및 운용 정보, 도면, 운용 및 비상 절차 등을 활용해 분석 대상 시스템을 파악한다.",
      "guideContext": "확률론적 리스크 평가 시스템 파악",
      "additionalDetail": null,
      "workProcessPhase": "시스템 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-006",
      "text": "작업의 성공기준을 정의하고, 작업을 완수하기 위해 필요한 각 구성요소의 성공기준 및 기여도를 정의한다.",
      "guideContext": "확률론적 리스크 평가 시스템 파악",
      "additionalDetail": null,
      "workProcessPhase": "시스템 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-007",
      "text": "기존의 시스템이나 유사 시스템에 대한 과거 경험과 체계적 방법(MLD, FMEA 등 기존 시스템의 위험 분석 결과)을 활용해 사고로 이어질 수 있는 초기사상들을 파악하고 평가한다.",
      "guideContext": "확률론적 리스크 평가 초기사상 확인",
      "additionalDetail": null,
      "workProcessPhase": "초기사상 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-008",
      "text": "파악된 초기사상들의 발생 확률을 평가하고 매우 낮은 확률(또는 빈도)의 사상들을 제외한다.",
      "guideContext": "확률론적 리스크 평가 초기사상 확인",
      "additionalDetail": null,
      "workProcessPhase": "초기사상 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-009",
      "text": "시스템에 유사한 영향을 미치는 초기사상들을 그룹화하고 그룹별 발생 확률(또는 빈도)을 결정한다.",
      "guideContext": "확률론적 리스크 평가 초기사상 확인",
      "additionalDetail": null,
      "workProcessPhase": "초기사상 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-010",
      "text": "각 초기사상(또는 초기사상 그룹)에 대해 초기사상이 잠재적인 결과를 발생시키지 않도록 막는 데 필요한 중간사상들(인간 행동, 구조, 시스템, 구성요소 등)의 조건적 반응(성공 또는 실패)과 대략적인 시간 순서를 도출한다.",
      "guideContext": "확률론적 리스크 평가 사고 시나리오 모델링",
      "additionalDetail": null,
      "workProcessPhase": "사고 시나리오 모델링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-011",
      "text": "잠재적 결과로 이어지는 사고 순서에 대해, 초기사상의 효과에 대한 시스템의 조건적인 반응을 평가한다. 재해를 예방하기 위한 제어 장치나 통제 활동(인간 행동, 구조, 시스템, 구성요소 등)의 작동에 따라 시스템의 반응은 조건적으로 변화한다.",
      "guideContext": "확률론적 리스크 평가 사고 시나리오 모델링",
      "additionalDetail": null,
      "workProcessPhase": "사고 시나리오 모델링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-012",
      "text": "각각의 축사상을 정상사상으로 하여, 해당 정상사상을 유발할 수 있는 중간 단계 고장들의 논리 조합인 실패 모델(예를 들면 결함수)을 만든다.",
      "guideContext": "확률론적 리스크 평가 실패 모델링",
      "additionalDetail": "기능이나 시스템에 따라 중간사상의 계층은 여러 개일 수 있다",
      "workProcessPhase": "실패 모델링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-013",
      "text": "정상사상에 대한 결함수 모델을 사건수 모델의 해당 부분에 연결한다.",
      "guideContext": "확률론적 리스크 평가 실패 모델링",
      "additionalDetail": null,
      "workProcessPhase": "실패 모델링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-014",
      "text": "각 초기사상에 대해 연결된 사상모델과 고장모델의 부울 대수 평가를 실시한다. 평가 결과, 사고 상태에 이르는 기본사상의 조합들(최소컷세트)을 도출한다.",
      "guideContext": "확률론적 리스크 평가 정량화",
      "additionalDetail": null,
      "workProcessPhase": "정량화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-015",
      "text": "초기사상의 빈도와 연관된 기본사상들의 실패 확률을 논리적으로 결합하여 각 최소컷세트의 발생 빈도를 추정한다.",
      "guideContext": "확률론적 리스크 평가 정량화",
      "additionalDetail": null,
      "workProcessPhase": "정량화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-016",
      "text": "종결 상태가 같은 사고 시나리오들을 그룹화하고, 확률의 논리적 합을 구함으로써 각각의 대표적인 종결 상태가 일어날 전체 확률을 추정한다.",
      "guideContext": "확률론적 리스크 평가 정량화",
      "additionalDetail": null,
      "workProcessPhase": "정량화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-017",
      "text": "각 최소컷세트의 발생 빈도를 추정할 때, 데이터의 불확실성이 포함되어야 한다. 최소컷세트에 있는 기본사상들에 대해 적합한 불확실성 분포를 만든다.",
      "guideContext": "확률론적 리스크 평가 불확실성 분석",
      "additionalDetail": null,
      "workProcessPhase": "불확실성 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-018",
      "text": "분석적 방법이나 몬테카를로 시뮬레이션 방법을 사용하여 초기사상의 불확실성 분포를 연관된 기본사상의 실패 확률에 대한 불확실성 분포와 논리적으로 합한다.",
      "guideContext": "확률론적 리스크 평가 불확실성 분석",
      "additionalDetail": null,
      "workProcessPhase": "불확실성 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-019",
      "text": "시사점들을 정리하고, 결과를 불확실성의 범위와 함께 기록한다.",
      "guideContext": "확률론적 리스크 평가 불확실성 분석",
      "additionalDetail": null,
      "workProcessPhase": "불확실성 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-020",
      "text": "이 단계는 분석 결과에 큰 영향을 미칠 수 있는 입력이나 요소를 파악하기 위해 수행하여야 한다.",
      "guideContext": "확률론적 리스크 평가 민감도 분석 (법령 근거 미확인)",
      "additionalDetail": "성공기준, 모델링, 파라미터 값의 변화에 따른 리스크 모델 재평가 포함",
      "workProcessPhase": "민감도 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-021",
      "text": "작업, 구조, 시스템, 구성요소들의 성공기준, 모델링, 물리적 파라미터에 관련된 가정들을 열거한다.",
      "guideContext": "확률론적 리스크 평가 민감도 분석",
      "additionalDetail": null,
      "workProcessPhase": "민감도 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-022",
      "text": "확률론적 리스크 평가 모델을 사고 순서, 중요도 순위, 정량적 리스크 결과의 변화 관점에서 전반적으로 재평가한다.",
      "guideContext": "확률론적 리스크 평가 민감도 분석",
      "additionalDetail": null,
      "workProcessPhase": "민감도 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-023",
      "text": "리스크에 기여하는 주요 요소를 파악한다.",
      "guideContext": "확률론적 리스크 평가 중요도 순위 결정",
      "additionalDetail": null,
      "workProcessPhase": "중요도 순위 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-024",
      "text": "중요도 측정방법을 활용해 전반적인 리스크 모델을 평가하고 개별 사고 시나리오와 기본사상에 순위를 부여한다. 중요도 측정 방법으로는 Fussell-Vesely (F-V) 중요도, 리스크 감소 가치 (RRW), 리스크 달성 가치 (RAW), 번버움 중요도 등이 사용될 수 있다.",
      "guideContext": "확률론적 리스크 평가 중요도 순위 결정",
      "additionalDetail": null,
      "workProcessPhase": "중요도 순위 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-025",
      "text": "통계적 방법을 활용해 사상의 발생 확률을 추정하고 불확실성 분포를 도출한다.",
      "guideContext": "확률론적 리스크 평가 데이터 수집 및 분석",
      "additionalDetail": null,
      "workProcessPhase": "데이터 수집 및 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-X35-026",
      "text": "수집된 정보, 데이터, 파라미터 추정치, 불확실성을 포함하여 확률 정보를 데이터베이스에 입력한다.",
      "guideContext": "확률론적 리스크 평가 데이터 수집 및 분석",
      "additionalDetail": null,
      "workProcessPhase": "데이터 수집 및 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-X35-001",
      "term": "마스터 로직 다이어그램(Master logic diagram, MLD)",
      "definition": "사고의 일반적 유형을 정상부에, 상세화된 사고에 대한 기술을 아래에 나타내고, 도출된 초기사상을 하단부에 표시하는 계층 구조적인 트리 구조의 다이어그램을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-002",
      "term": "고장형태와 영향분석(Failure modes and effects analysis, FMEA)",
      "definition": "구성품의 실패를 체계적으로 고려하고 시스템 성능에 대한 영향을 평가하는 방법론을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-003",
      "term": "시나리오(Scenario)",
      "definition": "초기의 원인에서 원하지 않는 결과까지 이어지는 사상의 순서 또는 조합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-004",
      "term": "불확실성(Uncertainty)",
      "definition": "입력 파라미터나 분석 과정의 부정확성으로 인한 확신의 결여를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-005",
      "term": "사건수(Event tree)",
      "definition": "초기사상(사건)에서 출발하여 중간사상(또는 축사상)의 성공과 실패에 따라 종결 상태까지 이어지는 사고 시나리오의 분기를 나무(Tree) 형태로 표현한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-006",
      "term": "사건수 분석(Event tree analysis, ETA)",
      "definition": "초기사건으로 알려진 특정한 장치의 이상 또는 운전자의 실수에 의해 발생되는 잠재적인 사고결과를 정량적으로 평가·분석하는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-007",
      "term": "결함수(Fault tree)",
      "definition": "원하지 않는 사상의 발생원인과 확률을 분석하기 위해 특정 사상의 원인을 그 아래에 있는 다양한 사상들의 논리적 조합으로 표현하는 나무 형태의 그림을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-008",
      "term": "결함수 분석(Fault tree analysis, FTA)",
      "definition": "사고를 일으키는 장치의 이상이나 운전자 실수의 조합을 연역적으로 분석하는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-009",
      "term": "축사상(Pivotal event)",
      "definition": "사건수에서 초기사상과 종결 상태 사이의 중간에 위치한 사상들을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-010",
      "term": "마르코프 분석(Markov analysis) 기법",
      "definition": "어떤 상태가 시간의 경과에 따라 확률적으로 변화하는 확률과정을 바탕으로 시스템의 현 상태를 분석하여 미래를 예측하는 기법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-011",
      "term": "신뢰도 블록 다이어그램(Reliability block diagram, RBD)",
      "definition": "네트워크 관계를 나타내는 블록 다이어그램을 사용하여 복잡한 시스템의 신뢰도 및 가용성을 분석하는 기법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-012",
      "term": "몬테카를로 시뮬레이션(Monte-Carlo simulation)",
      "definition": "확률적인 조건하에서 의사결정을 목적으로 난수(Random number)를 생성하여 정해진 조건식에 적용하는 절차를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-013",
      "term": "Fussell-Vesely (F-V) 중요도",
      "definition": "특정 사상을 포함한 컷세트(Cut set)의 발생 확률 합을 정상사상의 발생 확률로 나눈 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-014",
      "term": "리스크 감소 가치(Risk reduction worth, RRW)",
      "definition": "특정 사상이 발생하지 않는다고 가정할 때 감소하는 재해의 확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-015",
      "term": "리스크 달성 가치(Risk achievement worth, RAW)",
      "definition": "특정 사상이 반드시 발생한다고 가정할 때 증가하는 재해의 확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X35-016",
      "term": "번버움(Birnbaum) 중요도",
      "definition": "특정 사상이 반드시 발생할 때의 재해 확률에서 발생하지 않을 때의 재해 확률을 뺀 것으로 리스크 감소 가치와 리스크 달성 가치의 합이다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
