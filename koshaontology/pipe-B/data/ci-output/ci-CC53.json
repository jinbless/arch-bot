  "checklistItems": [
    {
      "identifier": "CI-CC53-001",
      "text": "변경을 수행함으로서 추가되는 위험이 없도록 제안된 변경내용을 충분히 검토하여야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 원칙",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-002",
      "text": "변경의 결과로서 요구되는 새로운 절차와 자료 등을 검토하여 개정하여야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 원칙",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-003",
      "text": "변경에 관련된 안전운전절차서, 공정안전자료, 공정운전, 정비교육교재 및 설비·정비 대장 등의 서류를 수정 또는 보완하여야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 원칙",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-004",
      "text": "변경관리 대상에는 최소한 다음의 사항이 포함되어야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": "신설 설비 연결, 운전조건 변경, 장치 추가·교체·변경, 경보·계측제어 계통 변경, 압력방출 계통 변경, 비상용 배관 추가·변경, 절차 변경, 위험성평가 결과 변경, 첨가제 추가·변경, 부속설비 변경·가설설비 설치 포함",
      "workProcessPhase": "변경관리 대상 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-005",
      "text": "변경관리 등급은 사업장별 자체 점검표(Check list) 등 변경관리 등급기준을 정하여 이에 따라 구분한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 등급 구분",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-006",
      "text": "등급의 분류는 최소한 2명의 검토자가 검토한 후 변경 발의부서의 장 또는 변경관리위원회에 의해 승인되도록 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 등급 구분",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-007",
      "text": "체계적인 위험성 평가가 생략된 경우에도 최소한 검토 및 승인과정에 대한 목록을 작성하여 관리하여야 한다",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 등급 구분",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-008",
      "text": "변경관리의 등급분류에 대한 적정여부는 자체감사 시에 다시 확인·평가되도록 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 등급 구분",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-009",
      "text": "변경발의자는 변경관리 내용을 \"변경\" 또는 \"단순 교체\"로 분류하되, 확실한 판단이 서지 않는 경우에는 변경 발의부서의 장 또는 변경관리위원회의 판정에 따른다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-010",
      "text": "변경대상으로 분류된 경우, \"정상변경\", \"비상변경\" 또는 \"임시변경\"으로 구분하여 해당절차에 따라 실시한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-011",
      "text": "단순 교체인 경우에는 \"정비작업일지\"에 기재하고, 시행한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-012",
      "text": "긴급한 상황으로 우선 처리가 필요한 경우에는 비상변경절차에 따른다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-013",
      "text": "변경 발의자는 사업장 자체 고유 양식의 변경관리요구서를 작성하여, 변경관리위원회에 문서로 제출한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-014",
      "text": "변경요구서에는 다음과 같은 변경요구의 기술적 근거 및 발의자의 기술적 소견이 포함되어 있어야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": "변경계획에 대한 공정 및 설계의 기술 근거, 변경의 개요와 의견, 공정안전 확보를 위한 대책, 안전운전에 필요한 사항 및 신뢰성 향상 효과 포함",
      "workProcessPhase": "정상변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-015",
      "text": "변경등급 구분에 따라 등급 3의 경우에는 위험성 평가를 생략할 수 있으며, 등급 1과 2는 위험성 평가를 실시하되, 등급 2 경우에는 평가자 구성범위를 축소 또는 조정할 수 있다.",
      "guideContext": "변경요소관리",
      "additionalDetail": null,
      "workProcessPhase": "정상변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-016",
      "text": "변경관리위원회는 변경요구서를 접수한 후 요구사항을 검토하기 위하여 검토 책임부서와 전문가를 지정한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-017",
      "text": "검토자는 할당받은 사항에 대한 기술 및 안전성 검토를 하여 그 결과를 위원회에 제출한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-018",
      "text": "변경관리위원회는 최종 검토후 승인여부를 결정하고, 변경의 필요성 조사, 변경의 승인여부 결정 및 승인여부의 논리적 근거를 기록하여 발의자에 서면 통보하여 시행을 지시한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-019",
      "text": "변경 여부를 통보한 후 변경완료 사항을 검사·확인하고, 변경에 관련된 제반서류 및 도서에 변경내용을 기록하여 보관한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-020",
      "text": "긴급을 요할 경우에는 정상변경 절차에 따르지 않고, 변경을 우선 지시하고, 사후에 완료를 요구할 수 있다. 또한 일과 후, 주말 또는 휴일 등에 발생하는 긴급한 변경은 별도의 절차를 마련하여 시행한다.",
      "guideContext": "변경요소관리",
      "additionalDetail": null,
      "workProcessPhase": "비상변경관리 절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-021",
      "text": "인명피해, 설비손상, 환경파괴 또는 심각한 경제적 손실을 피하기 위하여 즉시 변경이 요구되는 경우에는 담당자가 비상변경 발의를 할 수 있다.",
      "guideContext": "변경요소관리",
      "additionalDetail": null,
      "workProcessPhase": "비상변경관리 절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-022",
      "text": "비상변경 발의자는 운전부서의 장 및 사업주의 승인을 받는다. 다만 필요시 유선으로 보고하고 추후 승인을 받는다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상변경관리 절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-023",
      "text": "비상변경 발의자는 변경시행 후 즉시 6.2의 정상변경관리절차에 따라 변경관리요구서를 작성하여 변경관리위원회에 제출한다. 다만, 신속한 처리를 요청하기 위하여 변경관리요구서에 \"비상\" 표시를 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상변경관리 절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-024",
      "text": "변경관리위원회는 변경관리요구서를 검토하여 변경 시행된 사항을 계속 유지하여 운전할 것인가를 결정한다. 만약 위원회가 변경내용을 승인하면 그 변경 내용은 정상변경관리절차에 따라 결정된 것으로 보며, 이후 절차는 정상변경관리절차에 따른다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상변경관리 절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-025",
      "text": "임시변경도 변경관리에 포함하여야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임시변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-026",
      "text": "임시변경은 단시간 내에 실시되어야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임시변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-027",
      "text": "임시변경을 실시한 설비는 변경이 완료되면 원상복구하여야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임시변경 관리절차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-028",
      "text": "변경발의 부서의 장은 변경관리요구서를 변경관리위원회에 제출하기 전에 다음 사항을 검토하여야 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": "변경설비의 기본 및 상세 설계, 안전·보건·환경에 관한 사항, 공정안전자료 보완, 공정위험성 평가수행 필요 여부, 안전운전절차서 신설·보완, 안전작업 허가절차, 운전원 및 정비보수원 교육, 가동전 안전점검표, 변경완료후 검사, 정비 및 검사기록 보완, 점검·정비절차 신설·보완, 예비품 확보, 감독 및 판정, 변경일정 적합성, 관련기관 보고업무, 공정안전자료 개정 목록 및 일정 포함",
      "workProcessPhase": "변경발의 전 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-029",
      "text": "변경관리위원회는 공정기술자, 정비기술자 및 운전기술자 등 3인을 필수위원으로 구성하되, 변경 규모 및 대상 등에 따라 기계기술자, 전기기술자 또는 계장기술자 등을 추가할 수 있다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리위원회 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-030",
      "text": "모든 변경의 기록을 유지하고, 변경관리에 관한 자체감사를 수립 시행한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리위원회 임무",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-031",
      "text": "변경관리위원회의 책임자 선임, 운영절차 및 문서보관 등 모든 운영에 관한 사항을 규정하여 운영한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리위원회 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-032",
      "text": "발의자로부터 처음 변경관리요구서를 접수했을 경우 변경관리위원회는 1차 검토를 수행한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리위원회 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-033",
      "text": "변경관리위원회는 제안된 변경의 어려움 정도를 파악하여 전문적인 검토가 필요한 경우에는 검토가 필요한 항목마다 전문가를 지정하여 검토요구를 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리위원회 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-034",
      "text": "지정된 전문가는 해당 항목을 상세하고 광범위하게 검토한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "전문가 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-035",
      "text": "검토를 마친 전문가는 검토결과를 문서로 변경관리위원회에 통보한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "전문가 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-036",
      "text": "변경관리위원회는 각 전문가로부터 검토사항을 접수하여 최종검토를 수행한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경관리위원회 2차 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-037",
      "text": "변경이 비상변경절차에 따라 결정되고, 실시되었을 경우 변경관리위원회는 그 결정과 실시에 대한 검토를 한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상변경 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-038",
      "text": "변경관리위원회는 변경의 지속 허용여부를 결정한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상변경 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-039",
      "text": "변경관리위원회가 변경요구를 승인하였을 경우 변경 주관부서(변경 발의부서)는 변경관리요구서의 필요한 요구사항을 반영하여 변경관리를 시행한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "변경 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-040",
      "text": "변경관리위원회 또는 사업장의 자체감사 주관부서는 다음과 같은 내용을 포함한 \"변경관리에 관한 자체감사 계획\"을 작성하여 시행한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": "자체감사팀 구성, 자체감사 범위 결정, 자체감사 주기 결정, 자체감사 항목(등급구분 적정성, 점검표 선택 적절성, 현장 적용 여부, 관련자 교육 통보 여부, 절차서 일치 여부, 미이행 변경 유무, 제·개정 여부, 관련자료 첨부 여부, 자체감사 절차 준수 여부) 포함",
      "workProcessPhase": "변경관리 자체감사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC53-041",
      "text": "변경관리 후에는 필요한 관련 서류를 일정기간 보존하고, 공정흐름도 및 배관·계장도면 등 공정 변경관련 자료는 주기적으로 보완(As-built)하여 별도로 보존한다.",
      "guideContext": "변경요소관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "서류 보존",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "12",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC53-001",
      "term": "단순 교체",
      "definition": "<별표 1>에서 \"○\" 표시한 변경요소가 모두 같은 경우로, 기존 설비와 동일한 것으로 바꾸는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC53-002",
      "term": "변경",
      "definition": "<별표 1> 및 <별표 2>에서 \"○\" 표시한 변경요소가 하나라도 다른 경우로, 기존 설비와 다르게 교체하거나 증설 또는 감축하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC53-003",
      "term": "정상변경",
      "definition": "계획에 의한 변경으로 정상변경절차에 따라 실시되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC53-004",
      "term": "비상변경",
      "definition": "긴급을 요할 경우에 실시하는 변경으로, 정상변경절차를 따르지 않고, 실시하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC53-005",
      "term": "임시변경",
      "definition": "변경이 완료되면 원상복구가 가능한 단기간내 일시적으로 이루어지는 변경을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-CC53-01",
      "processOrder": 1,
      "processName": "변경관리 분류",
      "safetyMeasures": "변경발의자는 변경관리 내용을 '변경' 또는 '단순 교체'로 분류하고, 변경대상으로 분류된 경우 '정상변경', '비상변경' 또는 '임시변경'으로 구분하여 해당절차에 따라 실시한다. 단순 교체는 정비작업일지에 기재하고 시행한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-02",
      "processOrder": 2,
      "processName": "변경발의 전 검토",
      "safetyMeasures": "변경발의 부서의 장은 변경관리요구서를 제출하기 전에 변경설비의 기본·상세 설계, 안전·보건·환경 사항, 공정안전자료 보완, 공정위험성 평가수행 필요 여부, 안전운전절차서 신설·보완, 안전작업 허가절차, 운전원 및 정비보수원 교육, 가동전 안전점검표, 변경완료후 검사, 정비 및 검사기록 보완 등을 검토한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-03",
      "processOrder": 3,
      "processName": "정상변경 관리절차",
      "safetyMeasures": "변경관리요구서를 작성하여 변경관리위원회에 문서로 제출한다. 변경요구의 기술적 근거 및 기술적 소견을 포함하여야 한다. 변경등급에 따라 위험성 평가를 실시하고, 위원회는 검토 책임부서와 전문가를 지정하여 검토 후 승인여부를 결정한다. 변경완료 사항을 검사·확인하고 제반서류에 변경내용을 기록·보관한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-04",
      "processOrder": 4,
      "processName": "비상변경관리 절차",
      "safetyMeasures": "긴급을 요할 경우 정상변경 절차에 따르지 않고 변경을 우선 지시한다. 비상변경 발의자는 운전부서의 장 및 사업주의 승인을 받는다. 변경시행 후 즉시 정상변경관리절차에 따라 변경관리요구서를 작성하여 위원회에 제출하고, '비상' 표시를 한다. 위원회는 변경의 지속 허용여부를 결정한다.",
      "requiredPPE": [],
      "sourceSection": "6.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-05",
      "processOrder": 5,
      "processName": "임시변경 관리절차",
      "safetyMeasures": "임시변경도 변경관리에 포함하여야 한다. 임시변경은 단시간 내에 실시되어야 하며, 변경이 완료되면 원상복구하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "6.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-06",
      "processOrder": 6,
      "processName": "변경관리위원회 1차 검토",
      "safetyMeasures": "변경관리요구서를 접수 후 1차 검토를 수행한다. 전문적인 검토가 필요한 경우 항목마다 전문가를 지정하여 검토를 요구한다.",
      "requiredPPE": [],
      "sourceSection": "10.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-07",
      "processOrder": 7,
      "processName": "전문가 검토",
      "safetyMeasures": "지정된 전문가는 해당 항목을 상세하고 광범위하게 검토한다. 검토를 마친 전문가는 검토결과를 문서로 변경관리위원회에 통보한다.",
      "requiredPPE": [],
      "sourceSection": "10.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-08",
      "processOrder": 8,
      "processName": "변경관리위원회 2차 검토 및 승인",
      "safetyMeasures": "각 전문가로부터 검토사항을 접수하여 최종검토를 수행한다. 변경의 승인여부를 결정하고 변경관리요구서에 승인여부와 사유를 기재한다.",
      "requiredPPE": [],
      "sourceSection": "10.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC53-09",
      "processOrder": 9,
      "processName": "변경관리 자체감사",
      "safetyMeasures": "자체감사팀을 구성하고 감사 범위와 주기를 결정한다. 등급구분 적정성, 점검표 선택 적절성, 현장 적용 및 교육 통보 여부, 절차서 일치 여부, 미이행 변경 유무, 제·개정 여부, 관련자료 첨부 여부 등을 감사항목으로 포함한다.",
      "requiredPPE": [],
      "sourceSection": "11",
      "relatedSR": null
    }
  ],
