  "domainTerms": [
    {
      "identifier": "DT-M56-001",
      "term": "위험요인(Hazard)",
      "definition": "신체의 손상이나 상해를 초래할 수 있는 근원을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M56-002",
      "term": "가드(Guard)",
      "definition": "기계의 일부로서 방호기능을 수행하는 물리적 방벽이며 케이싱, 덮개, 스크린, 문, 울타리(방호울) 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M56-003",
      "term": "고정식 가드(Fixed guard)",
      "definition": "가드가 특정 위치에 용접 등으로 영구적으로 고정되거나 고정 장치 (스크류, 너트 등)로 부착된 구조로서, 공구를 사용하지 아니하고는 가드의 제거 또는 개방이 불가능한 구조의 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M56-004",
      "term": "연동형 가드(Interlocking guard)",
      "definition": "기계의 위험한 부분이 가드로 방호되어 가드가 닫혀야 만 작동될 수 있고 가드가 열리면 정지명령이 주어지는 연동장치와 조합된 가드를 말한다. 단, 가드가 닫혔을 때 기계의 작동이 초기화되는 방식을 의미하는 것은 아니다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M56-005",
      "term": "가동유지장치(Hold to run)",
      "definition": "수동으로 버튼을 누를 때에만 작동되고 버튼을 놓으면 자동으로 정지되는 조작 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M56-006",
      "term": "형판(Platen)",
      "definition": "사출성형기에서 금형을 고정하기 위한 부위를 말하며 고정측 설치판(상고정판)을 고정하는 부위를 고정측 형판(A 판)이라 하고 가동측 설치판(하고정판)을 고정하는 부위를 가동측 형판(B 판)이라 한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
