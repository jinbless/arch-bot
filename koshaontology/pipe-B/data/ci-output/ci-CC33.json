  "checklistItems": [
    {
      "identifier": "CI-CC33-001",
      "text": "건조설비의 바깥 면은 불연성 재료로 만들 것",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제1호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-002",
      "text": "건조설비(유기과산화물을 가열 건조하는 것은 제외한다)의 내면과 내부의 선반이나 틀은 불연성 재료로 만들 것",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제2호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-003",
      "text": "위험물 건조설비의 측벽이나 바닥은 견고한 구조로 할 것",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제3호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-004",
      "text": "위험물 건조설비는 그 상부를 가벼운 재료로 만들고 주위상황을 고려하여 폭발구를 설치할 것",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제4호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-005",
      "text": "위험물 건조설비는 건조하는 경우에 발생하는 가스·증기 또는 분진을 안전한 장소에 배출시킬 수 있는 구조로 할 것",
      "guideContext": "건조설비의 구조",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제5호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-006",
      "text": "액체연료 또는 인화성 가스를 열원의 연료로 사용하는 건조설비는 점화하는 경우에는 폭발이나 화재를 예방하기 위하여 연소실이나 그 밖에 점화하는 부분을 환기시킬 수 있는 구조로 할 것",
      "guideContext": "건조설비의 구조",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제6호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-007",
      "text": "건조설비의 내부는 청소하기 쉬운 구조로 할 것",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제7호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-008",
      "text": "건조설비의 감시창·출입구 및 배기구 등과 같은 개구부는 발화 시에 불이 다른 곳으로 번지지 아니하는 위치에 설치하고 필요한 경우에는 즉시 밀폐할 수 있는 구조로 할 것",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제8호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-009",
      "text": "건조설비는 내부의 온도가 부분적으로 상승하지 아니하는 구조로 설치할 것",
      "guideContext": "건조설비의 구조",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제9호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "CI-CC33-010",
      "text": "위험물 건조설비의 열원으로서 직화를 사용하지 아니할 것",
      "guideContext": "건조설비의 구조",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제10호",
      "workProcessPhase": "건조설비 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-011",
      "text": "위험물 건조설비가 아닌 건조설비의 열원으로서 직화를 사용하는 경우에는 불꽃 등에 의한 화재를 예방하기 위하여 덮개를 설치하거나 격벽을 설치할 것",
      "guideContext": "건조설비의 구조",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조 제11호",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-012",
      "text": "건조설비에 대하여 내부의 온도를 수시로 측정할 수 있는 장치를 설치하거나 내부의 온도가 자동으로 조정되는 장치를 설치하여야 한다",
      "guideContext": "건조설비의 온도 측정",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제281조에 따른 온도 측정·조정 장치 설치 의무",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "CI-CC33-013",
      "text": "건조설비는 불연성 재료로써 최대운전 온도에서의 열팽창에 의한 응력을 충분히 견딜 수 있도록 설계·제작되어야 한다",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-014",
      "text": "건조설비는 건조설비의 외부표면온도가 70 ℃를 초과하지 않도록 설계·제작 되어야 한다",
      "guideContext": "건조설비의 구조",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-HEAT-001",
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-CC33-015",
      "text": "연소실에는 각 버너 마다 연료의 연소상태를 확인할 수 있도록 관찰구(Peep hole) 등을 설치하여야 한다",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-016",
      "text": "건조실의 출입문은 건조실 내부에서도 열 수 있는 구조이어야 한다",
      "guideContext": "건조설비의 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-017",
      "text": "연소실은 충분한 환기가 되는 구조이어야 한다",
      "guideContext": "건조설비의 구조",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-018",
      "text": "점화 할 때는 문을 열고 점화하는 구조로 하는 것이 권장된다",
      "guideContext": "건조설비의 구조",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-019",
      "text": "연도는 통풍이 잘 되고, 폭발의 도피 공간을 충분히 가질 수 있는 곳에 설치하여야 한다",
      "guideContext": "건조설비의 구조",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-020",
      "text": "강우, 침수 및 적설 등으로 통풍에 지장이 없도록 설치하여야 한다",
      "guideContext": "건조설비의 구조",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-021",
      "text": "덕트는 운전온도에 적합한 내열성 및 불연성 재료로써 배기가스가 외부로 누출되지 않도록 제작되어야 한다",
      "guideContext": "덕트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덕트 제작·설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-022",
      "text": "덕트 외부표면 온도가 70 ℃를 초과하는 경우에는 덕트 접촉으로 인한 화상을 방지할 수 있도록 단열 등의 조치를 하여야 한다. 다만, 작업자가 접촉할 우려가 없는 부위는 그리하지 아니한다.",
      "guideContext": "덕트",
      "additionalDetail": null,
      "workProcessPhase": "덕트 제작·설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-CC33-023",
      "text": "덕트가 가연성 재질의 벽, 바닥 또는 지붕을 통과하는 경우, 배기덕트에는 적절한 단열조치 또는 틈새를 두어 덕트가 통과하는 구조물의 표면온도가 70℃를 초과하지 않도록 하여야 한다",
      "guideContext": "덕트",
      "additionalDetail": null,
      "workProcessPhase": "덕트 제작·설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-CC33-024",
      "text": "배기덕트 배출구는 건조실의 출입문, 창문 또는 공기흡입구 등과 충분히 이격된 장소에 설치하여 건조 과정중 발생하는 배기가스가 건조실 및 실내작업장 내부로 다시 들어오지 않도록 하여야 한다",
      "guideContext": "덕트",
      "additionalDetail": null,
      "workProcessPhase": "덕트 제작·설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-025",
      "text": "배기덕트의 배출가스에 분진 등이 포함되어 있는 경우에는 정기적으로 덕트내의 분진을 제거할 수 있도록 청소구(Clean door)를 설치하여야 한다",
      "guideContext": "덕트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덕트 제작·설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-026",
      "text": "공기공급 덕트 및 배기가스 덕트에 설치된 풍량 조절용 댐퍼는 완전히 닫히지 않도록 설계·제작되어 어떠한 경우라도 공기가 연소실 내부로 유입되거나 또는 배기가스가 건조실 외부로 배출될 수 있어야 한다",
      "guideContext": "댐퍼",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-027",
      "text": "자동으로 작동되는 댐퍼는 건조설비 이상 운전시에도 최소한의 개구부가 유지되도록 기계적인 장치 등을 사용하여 제작되어야 한다",
      "guideContext": "댐퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-028",
      "text": "가연성가스·인화성물질 등을 열원으로 사용하는 외부 연소식 건조설비 및 간접가열식 건조설비는 점화전 또는 재점화전 가연성가스 등을 제거할 수 있도록 배기휀 등으로 최대유량의 50% 이상이고, 연소실 내부용적의 4배 이상의 신선한 공기로 환기한 후 연료를 공급·점화하여야 한다",
      "guideContext": "가연성가스의 제거",
      "additionalDetail": null,
      "workProcessPhase": "점화 전 환기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-029",
      "text": "건조과정중 피건조물로부터 가연성가스, 인화성물질 또는 독성물질의 증기가 발산되는 건조설비는 운전중단 기간중 가연성가스, 인화성물질 또는 독성물질의 증기가 건조실 내부에 남아 있을 수 있으므로 건조설비 가동 또는 재가동전 배기휀 등에 의하여 건조실 내부용적의 4배 이상의 신선한 공기로 환기한 후 열원을 공급하여야 한다. 다만, 피건조물 또는 공정 특성상 공기중의 산소와의 접촉을 피하여야 하는 경우에는 질소 등과 같은 불활성 가스를 사용하여 건조실 내부를 환기한다.",
      "guideContext": "가연성가스의 제거",
      "additionalDetail": null,
      "workProcessPhase": "점화 전 환기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-030",
      "text": "건조과정중 피건조물로 부터 가연성가스, 인화성물질 또는 독성물질의 증기가 발산되는 건조설비는 신선한 공기를 흡입하고 배기가스를 적절히 외부로 배출시킬 수 있도록 강제적인 환기설비를 설치하여야 한다",
      "guideContext": "배기설비",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-031",
      "text": "배기설비는 건조실내의 가연성가스 농도가 항상 폭발한계의 25%이하로 유지되도록 설계·운전되어야 한다. 다만, 건조실내에 가연성 가스농도 측정 및 조절장치를 설치하여 연속적으로 가연성 가스 농도를 측정·조절하다가 가연성 가스의 농도가 증가하면 경보를 올리며 배기설비를 제외한 건조설비의 가동이 모두 정지되는 등 폭발한계의 50% 를 초과하지 않도록 하는 경우에는 그리하지 아니한다.",
      "guideContext": "배기설비",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-032",
      "text": "기체연료 및 액체연료를 열원으로 사용하는 외부 연소식 건조설비 및 간접 가열식 건조설비는 연소용 공기 공급휀 또는 배기휀이 작동하지 않으면 연료가 공급되지 않도록 연동되어야 한다",
      "guideContext": "배기설비",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-033",
      "text": "전기를 열원으로 사용하는 건조설비는 건조실의 급·배기휀이 작동하지 않으면 전기 히터에 전원이 공급되지 않도록 연동되어야 한다",
      "guideContext": "배기설비",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-034",
      "text": "연소실과 건조실은 운전중 유해가스가 외부로 누출되지 않도록 음압으로 운전하여야 한다",
      "guideContext": "배기설비",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-CC33-035",
      "text": "안전보건규칙 제284조의 규정에 의하여 건조실에는 온도조절장치 및 온도경보장치를 설치 하여야 한다",
      "guideContext": "온도조절 및 경보장치",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제284조에 따른 온도조절·경보장치 설치 의무",
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10",
      "basedOn": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "CI-CC33-036",
      "text": "온도조절용 온도감지기는 열원 긴급차단용 온도감지기와 별도로 설치하여야 한다",
      "guideContext": "온도조절 및 경보장치",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10",
      "basedOn": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "CI-CC33-037",
      "text": "기체연료 및 액체연료를 열원으로 사용하는 건조설비에는 다음 각호와 같은 건조설비의 이상시 자동으로 연료의 공급을 차단할 수 있는 긴급차단밸브를 설치하여야 한다: (가) 공기흡입휀, 배기휀 또는 순환휀 고장, (나) 건조실내의 온도이상 상승, (다) 전기공급 중단, (라) 불꽃감지기(Flame detector) 작동, (마) 제어용 전원 또는 압축공기 차단, (바) 연료공급 중단",
      "guideContext": "긴급차단장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-038",
      "text": "전기·스팀 또는 열매유 등을 열원으로 사용하는 건조설비에는 다음 각호와 같은 건조설비의 이상시 자동으로 전원·스팀 또는 열매유 등이 차단되는 설비를 설치하여야 한다: (가) 건조실 내의 온도이상 상승, (나) 배기 또는 순환휀 고장",
      "guideContext": "긴급차단장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-039",
      "text": "긴급차단밸브는 바이패스가 있어서는 안 된다",
      "guideContext": "긴급차단장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-040",
      "text": "긴급차단밸브는 가능한 버너와 가까운 곳에 설치하여야 권장한다",
      "guideContext": "긴급차단장치",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-041",
      "text": "기체연료 배관에 설치한 긴급차단밸브는 연료의 누설시험을 위하여 긴급차단밸브 다음에 차단밸브를 설치하고, 사이에 시험 콕 등을 설치하여야 한다",
      "guideContext": "긴급차단장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-042",
      "text": "안전보건규칙 제281조 제4항의 규정에 의한 건조설비에는 폭발구가 설치되어야 한다. 폭발구의 최소 면적은 건조설비의 내부 부피 6.1 m³ 당 1 m² 가 되도록 한다. 폭발구의 작동압력은 건조설비의 기계적인 강도를 고려하여 압력 0.48~0.96kPa(0.0048 ~ 0.0096kg/cm²)로 한다.",
      "guideContext": "폭발구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-043",
      "text": "건조설비의 폭발구는 안전한 위치에 설치하여 건조설비 주위의 근로자를 보호하여야 한다. 또한 폭발구 주위에는 배관이나 제어반 등을 설치하여서는 아니 되며, 시설물의 설치 등으로 폭발구의 유효면적이 감소되지 않도록 하여야 한다.",
      "guideContext": "폭발구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-044",
      "text": "공기공급휀 및 배기휀 등의 고장시, 피 건조물의 공급을 목적으로 건조설비에 설치된 컨베이어가 작동되지 않도록 연동되어야 한다",
      "guideContext": "컨베이어 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "13",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-045",
      "text": "버너는 사용하는 연료에 적합한 것이어야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-046",
      "text": "버너는 사용조건에서 안정된 화염을 유지하는 구조이거나 버너 타일을 두어야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-047",
      "text": "버너는 적당량의 공기가 공급되는 구조이어야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-048",
      "text": "버너는 화염을 정확하고, 안정시킬 수 있도록 적정한 공기비를 조절 할 수 있도록 공기조절장치를 설치하여야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-049",
      "text": "버너에는 점화용 버너 및 점화용 전극 등의 자동점화장치를 설치하거나 확실한 점화를 할 수 있는 위치에 점화구멍을 설치하여야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-050",
      "text": "점화용 버너는 메인 버너에 점화하였을 때 그 메인 버너의 연소용 공기 흐름 등으로 화염이 꺼지지 않는 구조이어야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "버너 점화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-051",
      "text": "점화용 버너는 메인 버너에 확실하게 점화시키는 곳에 설치하여야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-052",
      "text": "점화용 버너는 연소상태를 육안으로 확인되는 곳에 설치하여야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-053",
      "text": "오일 버너는 필요에 따라 연소 정지 후 남은 연료를 회수할 수 있는 구조이어야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-054",
      "text": "연료의 자연발화온도 이하의 온도에서 사용하는 연소실 및 자주 점화하는 메인 버너에는 점화용 버너를 설치하여야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-055",
      "text": "연료의 자연발화온도 이하의 온도에서 사용하는 연소실 및 자주 점화하는 메인 버너에는 불꽃감지기를 설치하여야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-056",
      "text": "여러 개의 메인버너를 설치한 경우에는 메인 버너 마다 점화장치와 불꽃감지기를 설치하여야 한다",
      "guideContext": "버너 구조 및 기능 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조설비 설계·제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-057",
      "text": "연료 배관 및 부속설비는 과열 또는 파손의 위험이 없는 곳에 설치한다",
      "guideContext": "연료 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-058",
      "text": "연료 배관 등은 최고사용압력의 1.5배 이상의 압력 및 온도에 견디고, 연료 등의 특성 및 사용 상태에 적합한 것이어야 한다",
      "guideContext": "연료 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-059",
      "text": "연료 배관 등은 내식성이 있는 것을 설치하여야 한다",
      "guideContext": "연료 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-060",
      "text": "공기 또는 연료가 역류할 위험이 있는 곳에는 역류를 방지하는 조치를 하여야 한다",
      "guideContext": "연료 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-061",
      "text": "연료 배관 등에는 연료의 팽창 등으로 과도한 압력상승을 방지토록 설치하여야 한다",
      "guideContext": "연료 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-062",
      "text": "연료 배관 등에는 등전위 접지를 하여야 한다",
      "guideContext": "연료 배관",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "15",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-CC33-063",
      "text": "연료 배관에는 필요에 따라 벤트밸브, 드레인 밸브를 설치하여야 한다",
      "guideContext": "연료 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-064",
      "text": "연료 배관 등에는 진동 및 충격이 전달되지 않도록 필요시에는 플랙시블 호스 등을 설치하여야 한다",
      "guideContext": "연료 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC33-065",
      "text": "연료 배관 등의 밸브는 개폐의 정도를 쉽게 확인 할 수 있는 구조와 점검 및 보수가 용이한 구조로 설치하는 것을 권장한다",
      "guideContext": "연료 배관",
      "additionalDetail": null,
      "workProcessPhase": "연료 배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
