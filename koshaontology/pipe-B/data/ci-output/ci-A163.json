  "checklistItems": [
    {
      "identifier": "CI-A163-001",
      "text": "모든 화학물질은 흄후드에서 다루어야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 시료 전처리 및 분석 작업",
      "additionalDetail": "이황화탄소는 가연성이므로 특히 주의 필요",
      "workProcessPhase": "시료 전처리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-A163-002",
      "text": "실험복 및 보호장갑 등 적절한 개인보호구를 사용하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 시료처리 작업",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A163-003",
      "text": "클로로-1,3-부타디엔을 채취하는 경우 보안경을 착용하는 등 눈을 보호하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 시료채취 작업",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A163-004",
      "text": "모든 화학물질의 흡입과 피부접촉을 피해야 하며, 흄후드 안에서 사용하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 건강영향 및 예방조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-A163-005",
      "text": "보안경과 실험복을 착용하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 건강영향 및 예방조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A163-006",
      "text": "매우 빠르게 자동 산화하여(심지어 0℃ 에서도) 불안정한 과산화물을 형성하고 정제 후에는 즉시 -15℃에 보관하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 시약 보관",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-007",
      "text": "공기 중의 농도를 ㎎/㎥으로 표시했을 때의 ㎥은 정상상태(NTP, Normal Temperature and Pressure : 25℃, 1기압)의 기체용적을 뜻한다. 따라서 노출기준과 비교 시는 작업환경 측정 시의 온도와 압력을 실측하여 정상상태의 농도로 환산하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 작업환경측정 농도 환산 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-008",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 분석용 시약 품질 기준 (법령 근거 미확인)",
      "additionalDetail": "분석에 사용하는 시약은 제조회사에서 표시하는 농도 함량을 따른다.",
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-009",
      "text": "광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의해야 하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 분석 시약 순도 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-010",
      "text": "계량기구 중 측정값을 분석결과의 계산에 사용할 목적으로 사용되는 것은 모두 보정하는 것을 원칙으로 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 분석 계량기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-011",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 달수 있어야 하며, 화학분석 용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 달 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 분석용 저울 규격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-012",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등 이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 분석용 유리기구 규격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-013",
      "text": "탈착효율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다. 탈착효율에 대한 평가는 분석자가 해야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 탈착효율 기준 (법령 근거 미확인)",
      "additionalDetail": "12개의 탈착효율 실험결과를 근거로 판단해야 할 사항은 탈착효율간의 일정성이다. 만일 탈착효율간의 차이가 크고 변이가 심하여 일정성이 없으면 정확한 보정이 될 수가 없다.",
      "workProcessPhase": "탈착효율 검정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-014",
      "text": "시료채취 후 활성탄관의 양 끝을 플라스틱 마개(고무마개는 피한다)로 밀봉하여 운반한다.",
      "guideContext": "2-클로로-1,3-부타디엔 시료채취 후 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-015",
      "text": "만일 뒤 층에서 검출된 양이 앞 층에서 검출된 양의 10%를 초과하면(Wb > Wf/10), 시료 파과가 일어난 것이므로 이 자료는 사용할 수 없다.",
      "guideContext": "2-클로로-1,3-부타디엔 농도 계산 시 시료 파과 판정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-016",
      "text": "검량선은 분석할 시료의 농도를 포함해야 하며 외삽법은 피한다. 검량선의 적정성은 제시된 분석기기의 매뉴얼을 참조하거나 상관계수가 0.99이상의 것을 사용하도록 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 검량선 작성 기준",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-017",
      "text": "탈착효율은 흡착관을 이용하여 채취한 유기용제 등의 분석값을 보정하는 실험이며, 시료 배치당 최소한 한 번씩은 행해야 한다.",
      "guideContext": "2-클로로-1,3-부타디엔 탈착효율 실시 주기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탈착효율 검정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A163-018",
      "text": "시료의 시험, 바탕시험 및 표준액에 대한 일련의 동일시험을 행할 때 사용하는 시약 또는 시액은 동일 롯트(LOT)로 조제된 것을 사용한다.",
      "guideContext": "2-클로로-1,3-부타디엔 분석 시약 관리",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A163-001",
      "term": "밀폐",
      "definition": "취급 또는 보관상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A163-002",
      "term": "밀봉",
      "definition": "취급 또는 보관 상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A163-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A163-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ± 10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A163-005",
      "term": "즉시",
      "definition": "시험조작 중 30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A163-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A163-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A163-008",
      "term": "탈착효율",
      "definition": "채취한 유기화합물 등의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 흡착관에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-A163-01",
      "processOrder": 1,
      "processName": "시료채취",
      "safetyMeasures": "시료채취기를 활성탄관에 연결하고, 근로자에게 장착하여 0.01~0.2 L/min 유량으로 1.5~20 L 공기를 채취한다. 채취 후 활성탄관의 양 끝을 플라스틱 마개로 밀봉하여 운반한다. 총 시료수의 10% 이상 또는 시료 세트 당 2~10개의 현장 공시료를 확보한다.",
      "requiredPPE": [
        "보안경"
      ],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-A163-02",
      "processOrder": 2,
      "processName": "시료 전처리(탈착)",
      "safetyMeasures": "활성탄관의 앞 층과 뒤 층을 각각 바이엘에 넣고 이황화탄소 1 mL로 30분간 탈착한다. 이황화탄소는 가연성이므로 모든 작업은 흄후드에서 수행하여야 하며, 실험복, 보호장갑, 보안경 등 개인보호구를 착용한다.",
      "requiredPPE": [
        "보안경",
        "실험복",
        "보호장갑"
      ],
      "sourceSection": "6",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "WP-A163-03",
      "processOrder": 3,
      "processName": "검량선 작성 및 탈착효율 검정",
      "safetyMeasures": "최소 5개 수준의 표준용액을 제조하여 검량선을 작성하고, 상관계수 0.99 이상을 확인한다. 탈착효율 검정은 시료 배치당 최소 1회 수행하며, 3개 농도 수준 × 3반복 = 9개와 공시료 3개를 준비한다. 탈착효율 0.75 이상을 확보한다.",
      "requiredPPE": [
        "보안경",
        "실험복",
        "보호장갑"
      ],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-A163-04",
      "processOrder": 4,
      "processName": "가스크로마토그래프 분석",
      "safetyMeasures": "가스크로마토그래프/불꽃이온화검출기를 사용하여 분석한다. 기기조건: 주입구 250℃, 검출기 280℃, 컬럼 40~300℃, 주입량 1~2 μL, 이동상 질소 0.5~3 mL/min. 모든 화학물질은 흄후드 안에서 취급한다.",
      "requiredPPE": [
        "보안경",
        "실험복"
      ],
      "sourceSection": "6",
      "relatedSR": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "WP-A163-05",
      "processOrder": 5,
      "processName": "농도 계산 및 결과 판정",
      "safetyMeasures": "농도 계산식 C = ((Wf + Wb - Bf - Bb) / (V × DE)) × (24.45 / MW)를 적용한다. 뒤 층 검출량이 앞 층 검출량의 10%를 초과하면 시료 파과로 판정하여 해당 자료를 사용할 수 없다. 작업환경 측정 시 온도와 압력을 실측하여 정상상태(25℃, 1기압) 농도로 환산한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    }
  ],
  "equipmentSpecs": [
    {
      "identifier": "ES-A163-001",
