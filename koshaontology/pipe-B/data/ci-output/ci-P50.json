      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P50-01",
      "processOrder": 1,
      "processName": "작업장 특성 파악 및 분석",
      "safetyMeasures": "운전에 들어가기 전 1차 평가를 실시하고, 상존하는 위험요인 확인을 위한 2차 평가를 실시한다. 2차 평가에는 생명 및 건강에 즉시 영향을 주는 조건, 밀폐공간출입·화재·폭발 가능성, 사업장의 위치 및 규모, 기후 조건, 사업장의 접근성을 포함한다.",
      "requiredPPE": [],
      "sourceSection": "4.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-P50-02",
      "processOrder": 2,
      "processName": "안전보건 계획 수립",
      "safetyMeasures": "각 업무 별 위험요인 분석, 근로자 교육 및 훈련, 개인보호구, 의학적 조치, 노출 모니터링, 오염물질제거 절차, 비상대응계획, 밀폐공간출입 절차, 누출 오염 관련 사항을 포함하여 안전보건 계획을 수립한다.",
      "requiredPPE": [],
      "sourceSection": "4.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-P50-03",
      "processOrder": 3,
      "processName": "교육훈련 실시",
      "safetyMeasures": "안전보건 계획에 따라 관리자를 포함한 모든 근무자에게 교육훈련을 실시한다. 근로자는 적절한 교육을 받지 않고 해당 업무에 종사하여서는 안 된다.",
      "requiredPPE": [],
      "sourceSection": "4.6",
      "relatedSR": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "WP-P50-04",
      "processOrder": 4,
      "processName": "유해 폐기물 취급 작업",
      "safetyMeasures": "허용노출농도 이하에서 근로자가 일할 수 있도록 설비를 설치·유지하거나 작업 방법을 개선한다. 불가능한 경우 개인보호구를 지급한다. 드럼 또는 용기 취급에 관한 절차를 작성·비치하고 교육한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "보호복",
        "보호장갑"
      ],
      "sourceSection": "4.8",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-P50-05",
      "processOrder": 5,
      "processName": "노출 모니터링",
      "safetyMeasures": "대기의 오염이 근로자의 건강에 심각한 위험을 줄 수 있으므로 노출 모니터링을 주기적으로 실시한다. 모니터링 주기 및 방법은 산업안전보건법에 따른다.",
      "requiredPPE": [],
      "sourceSection": "4.9",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-P50-06",
      "processOrder": 6,
      "processName": "오염물질 제거",
      "safetyMeasures": "오염물질 제거절차를 안전보건 계획의 일부분으로 작성·비치한다. 현장 안전보건관리자는 근로자의 오염물질 제거상태를 모니터링한다. 보호의 및 개인 보호장비는 오염물질 제거, 청소, 세탁, 유지·보수 및 교체를 실시하여 항시 사용할 수 있도록 조치한다.",
      "requiredPPE": [
        "보호의",
        "개인 보호장비"
      ],
      "sourceSection": "4.11",
      "relatedSR": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "WP-P50-07",
      "processOrder": 7,
      "processName": "비상대응",
      "safetyMeasures": "비상조치계획을 안전보건 계획의 일부분으로 작성·비치한다. 비상조치계획에는 개인별 임무 및 의사소통 절차, 비상상황 인지 및 예방, 비상응급조치, 경보 방법, 안전한 피난 거리 및 장소, 현장 보안 및 제어, 오염물질 제거 절차, 개인보호구 및 비상 장비, 피난경로 및 절차, 사고보고 방법 및 절차를 포함한다.",
      "requiredPPE": [
        "개인보호구",
        "비상 장비"
      ],
      "sourceSection": "4.12",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001",
        "SR-CONFINED-021"
      ]
    }
  ],
