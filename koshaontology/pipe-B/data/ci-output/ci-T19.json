  "domainTerms": [
    {
      "identifier": "DT-T19-001",
      "term": "급성경구독성",
      "definition": "시험물질을 24시간 이내에 1회 또는 수회 경구투여한 후 단시간 내에 나타나는 유해영향(Adverse effects)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T19-002",
      "term": "투여량(Dose)",
      "definition": "투여하는 시험물질의 양을 말한다. 일반적으로 단위는 시험동물의 체중 당 시험물질의 무게(예, mg/kg)로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T19-003",
      "term": "빈사 상태(Moribund state)",
      "definition": "시험물질의 독성에 의하여 시험동물이 죽어가는 상태 또는 생존할 가망이 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T19-004",
      "term": "GLP(Good Laboratory Practice)",
      "definition": "유해위험성 실험실운영규정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T19-005",
      "term": "GHS(Globally Harmonized Classification System for Chemical Substances and Mixtures)",
      "definition": "화학물질 분류 및 표지의 세계조화시스템을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-T19-01",
      "processOrder": 1,
      "processName": "시험계획서 작성",
      "safetyMeasures": "시험물질의 조제 등에 관한 자료를 확보하고 시험계획서를 작성한다. 시험계획서는 운영책임자에 의하여 승인되어야 하며, 실험동물윤리위원회의 심의를 거친다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-T19-02",
      "processOrder": 2,
      "processName": "동물입수 준비",
      "safetyMeasures": "사용할 동물실의 환경, 청소 소독, 설비를 점검하고 이상이 없도록 준비한다. 사용할 기자재가 완전히 갖추어진 것을 확인한다. 개체식별카드 및 동물실 사용기록지를 작성하여 부착한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-T19-03",
      "processOrder": 3,
      "processName": "실험동물 선정 및 순화",
      "safetyMeasures": "연령 8~12주령 랫드를 사용하며 개체 간 체중 차이는 평균체중의 ±20%를 넘지 않도록 한다. 암컷을 우선 사용하며, 시험 시작 전 최소 5일 이상 순화시킨 건강한 동물 중에서 무작위 선정한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-T19-04",
      "processOrder": 4,
      "processName": "사육환경 조성",
      "safetyMeasures": "사육실 온도 22℃±3℃, 습도 30~70% 유지. 조명은 인공조명으로 연속 12시간 간격 점등. 암·수 구별 사육하며 밀도가 높지 않도록 한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-T19-05",
      "processOrder": 5,
      "processName": "시험물질 조제",
      "safetyMeasures": "시험물질은 적당한 용매에 용해 또는 현탁시킨다. 사용하는 용매는 사전에 독성 여부와 특성이 잘 알려진 것을 사용한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.4",
      "relatedSR": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "WP-T19-06",
      "processOrder": 6,
      "processName": "예비시험 수행",
      "safetyMeasures": "고정용량(5, 50, 300, 2,000 ㎎/㎏) 가운데 하나를 선택하여 한 마리씩 투여한다. 투여 후 적어도 14일 동안 관찰하며, 부식성이나 자극성이 큰 물질의 경우 시험을 피한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-T19-07",
      "processOrder": 7,
      "processName": "본시험 수행",
      "safetyMeasures": "각 시험용량에 대해 단일 성 5마리를 사용한다. 투여 후 30분 이내 관찰, 처음 4시간 특별 주의 관찰, 이후 14일까지 1회 이상 관찰한다. 빈사 상태 동물은 안락사 시키며 모든 관찰은 체계적으로 개체별 기록한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-T19-08",
      "processOrder": 8,
      "processName": "결과 처리 및 보고",
      "safetyMeasures": "시험용량, 시험동물 수, 독성증상, 치사동물 수, 독성발현 시간, 용량-독성반응 관계, 부검결과 등을 기록하고 시험보고서를 작성한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    }
  ],
