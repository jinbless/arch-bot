  "checklistItems": [
    {
      "identifier": "CI-CC66-001",
      "text": "각 설비별 고장모드의 분류는 KOSHA GUIDE C-C-48-2026「유해위험설비의 점검·정비·유지관리에 관한 기술지원규정」에 따른다.",
      "guideContext": "화학설비 고장율 산출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고장모드 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC66-002",
      "text": "설비 고장율을 산출하고자 하는 대상공정을 선정한다.",
      "guideContext": "화학설비 고장율 산출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "대상공정 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC66-003",
      "text": "대상공정이 선정되면 플랜트 운전 및 안전에 중요한 설비들을 도출하여 목록을 작성한다.",
      "guideContext": "화학설비 고장율 산출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설비 목록 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC66-004",
      "text": "선정된 대상설비에 대해 보수·정비작업의뢰서, 사고조사보고서, 설비이력카드, 시험보고서, 운전일지, 운전절차서, 정기점검 및 보수 절차서 등의 자료원을 확인한다.",
      "guideContext": "화학설비 고장율 산출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료원 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC66-005",
      "text": "자료원으로부터 단위공장 운전이력, 설비목록 및 사양, 설비별 운전시간, 설비별 보수 및 고장이력 등의 자료를 수집한다.",
      "guideContext": "화학설비 고장율 산출 (법령 근거 미확인)",
      "additionalDetail": "단위공장의 운전상태 변화를 알수 있는 정상운전기간 및 년차 보수기간, 설비번호·설비명·상세사양·설계운전조건, 실제 설비 운전시간, 보수시작일·보수완료일·고장발견일·보수시간·이용불능시간·고장원인·고장내용·보수작업내용 등",
      "workProcessPhase": "자료 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC66-006",
      "text": "수집한 자료들로부터 설비별 고장원인 분류 및 고장모드 선정, 고장심각도 결정, 보수작업 내용 및 보수시간에 대한 분석을 실시한다.",
      "guideContext": "화학설비 고장율 산출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC66-007",
      "text": "수집 또는 분석된 자료로부터 설비고장을 계산을 위해서 필요한 고장모드별 고장횟수, 설비운전시간, 설비작동횟수, 이용불능시간, 설비필요시간 자료를 구한다.",
      "guideContext": "화학설비 고장율 산출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계산 자료 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC66-001",
      "term": "설비 고장율",
      "definition": "설비의 시간당 또는 작동횟수당 고장발생율을 말한다. 시간당 고장율은 고장횟수의 합을 운전시간의 합으로 나눔으로서 계산할 수 있으며, 작동횟수당 고장율은 고장횟수의 합을 작동횟수의 합으로 나눔으로서 계산한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC66-002",
      "term": "설비 이용불능도",
      "definition": "주어진 시간에 설비가 보수등의 이유로 인하여 이용할 수 없는 가능성을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC66-003",
      "term": "설비이용불능시간",
      "definition": "설비의 기능을 수행하지 못한 시간을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
