  "checklistItems": [
    {
      "identifier": "CI-CC42-001",
      "text": "다음은 산업안전보건법령에 관한 사항으로써 반드시 준수하여야 한다.",
      "guideContext": "사건수 분석 기법 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조에 따른 공정안전보고서 작성 시 사건수 분석(ETA)을 포함한 위험성평가 기법 적용",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC42-002",
      "text": "수용수준과 평가결과를 비교하여 평가결과가 수용수준을 만족하지 못할 경우에는 개선권고사항을 작성하여야 한다.",
      "guideContext": "사건수 분석 5단계 사고결과 상세 분석 (법령 근거 미확인)",
      "additionalDetail": "평가항목별로 각 개선요소의 신뢰도 향상 방안과 새로운 안전요소의 추가 등을 분석하여 수용수준을 만족할 수 있는 개선권고사항을 작성",
      "workProcessPhase": "사고결과 상세 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC42-003",
      "text": "사건수분석결과 사고의 발생확률이 사업장에서 설정한 수용수준을 초과하는 경우에는 반드시 개선권고사항을 작성하여야 한다.",
      "guideContext": "개선권고사항의 후속조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과의 문서화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC42-004",
      "text": "개선권고사항은 경보장치, 안전장치 및 주요기기의 중복설계와 같은 시설변경이나 운전절차, 작업방법의 변경과 같은 절차의 변경을 포함하며 사고확률을 감소시킬 수 있는 사항이이어야 한다.",
      "guideContext": "개선권고사항 내용 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과의 문서화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC42-005",
      "text": "경영자는 공정안전관리 담당부서에게 평가결과 보고서의 내용들이 적절하게 추진되고 있는지를 감사하도록 한다.",
      "guideContext": "개선권고사항의 후속조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC42-006",
      "text": "후속조치의 책임부서는 회사의 특성에 따라 정비부, 기술부, 사업부 등에서 각각 시행할 수 있도록 책임부서를 지정하여야 한다",
      "guideContext": "개선권고사항의 후속조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC42-007",
      "text": "사건수분석시 사용하였던 기술자료의 사본과 리더가 사용했던 주요기기가 표시된 공정 배관계장도면도 위험성평가 서류에 첨하고 검토보고서의 후속조치, 재설계 서류, 부가적인 권고사항 등 권고사항을 제시하기 위해 작성된 모든 작업서류를 모아 첨한다.",
      "guideContext": "보고서 작성 참고자료 첨부",
      "additionalDetail": null,
      "workProcessPhase": "결과의 문서화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC42-001",
      "term": "초기 사건 (Initiating Event)",
      "definition": "시스템 또는 기기의 결함, 운전원의 실수 등을 말한다.",
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC42-002",
      "term": "안전 요소 (Safety Function)",
      "definition": "초기의 사건이 실제 사건으로 발전되지 않도록 하는 안전장치, 운전원의 조치 등을 말한다.",
      "sourceSection": "4",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-CC42-01",
      "processOrder": 1,
      "processName": "발생 가능한 초기사건의 선정",
      "safetyMeasures": "정성적인 위험성평가 기법(HAZOP, Checklist등), 과거의 기록, 경험 등을 통하여 초기사건을 선정한다. 초기사건으로는 관심의 대상이 될 수 있는 것으로서 시스템 또는 운전원이 초기사건에 얼마나 잘 대처하느냐에 따라 결과가 다르게 나타날 수 있는 것을 선정토록 한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC42-02",
      "processOrder": 2,
      "processName": "초기사건을 완화시킬 수 있는 안전요소 확인",
      "safetyMeasures": "초기사건으로 인한 영향을 완화시킬 수 있는 모든 안전요소를 확인하여 이를 시간별 작동·조치순서대로 도표의 상부에 나열하고 문자 또는 알파벳으로 표기한다. 안전요소에는 자동 대응 안전 시스템, 경보 장치, 운전원의 조치, 완화 장치, 사고 영향 완화 시스템, 주변 상황 등이 포함된다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC42-03",
      "processOrder": 3,
      "processName": "사건수 구성",
      "safetyMeasures": "선정된 초기사건을 사건수 도표의 왼쪽에 기입하고 관련 안전 요소를 시간에 따른 대응 순서대로 상부에 기입하고 초기사건에 따른 첫번째 안전요소를 평가하여 성공 또는 실패 여부를 결정하여 도표에 표시한다. 안전요소의 성공은 도표의 상부에, 실패는 하부에 표시한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC42-04",
      "processOrder": 4,
      "processName": "사고결과의 확인",
      "safetyMeasures": "사건수의 구성이 끝난 후에는 초기사건에 따른 관련 안전요소의 성공 또는 실패의 경로별로 사고의 형태 및 그 결과를 도표의 우측에 서술식으로 기술하며 이와 함께 경로별로 관련된 안전요소를 문자 또는 알파벳으로 함께 표기한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC42-05",
      "processOrder": 5,
      "processName": "사고결과 상세 분석",
      "safetyMeasures": "평가항목, 수용수준, 평가결과, 개선요소로 분석을 수행한다. 수용수준과 평가결과를 비교하여 평가결과가 수용수준을 만족하지 못할 경우에는 개선권고사항을 작성하여야 한다. 각 개선요소의 신뢰도 향상 방안과 새로운 안전요소의 추가 등을 분석한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC42-06",
      "processOrder": 6,
      "processName": "결과의 문서화",
      "safetyMeasures": "사건수분석의 최종결과는 문서화 절차에 의하여 작성한다. 개요(공정 및 설비의 개요, 공정의 위험특성, 초기사건의 설명 및 선정배경, 팀 인적사항), 사건수분석 내용(평가방법, 기본가정사항, 공정설명 및 주요 운전조건, 사건수 분석도, 대응조치 정보표), 정량화 결과 및 해석(예상사고 시나리오, 위험성평가결과 조치계획)을 포함한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
  ],
