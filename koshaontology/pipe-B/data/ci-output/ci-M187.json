  "domainTerms": [
    {
      "identifier": "DT-M187-001",
      "term": "사출성형기(Injection moulding machine)",
      "definition": "열을 가하여 용융 상태의 열가소성 또는 열경화성 플라스틱, 고무 등의 재료를 노즐을 통해 두개의 금형 사이에 주입하여 원하는 모양의 제품을 성형·생산하는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-002",
      "term": "가드(Guard)",
      "definition": "기계의 일부로서 방호 기능을 수행하는 물리적 방벽이며 케이싱, 덮개, 스크린, 문, 울타리(방호울)등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-003",
      "term": "고정식 가드(Fixed guard)",
      "definition": "가드가 특정위치에 용접 등으로 영구적으로 고정되거나 고정 장치(스크류, 너트 등)로 부착된 구조로서, 공구를 사용하지 아니하고는 가드의 제거 또는 개방이 불가능한 구조의 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-004",
      "term": "가동식 가드(Movable guard)",
      "definition": "미달이 또는 여닫이 형태로 중력이나 수동 조작 등으로 확실하게 잠길 수 있는 가드로서, 사출성형기에 견고하게 고정되어 공구를 사용치 않고는 제거할 수 없는 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-005",
      "term": "연동식 가드(Interlocking guard)",
      "definition": "기계의 위험한 부분이 가드로 방호되어 가드가 닫혀야만 작동될 수 있고 가드가 열리면 정지 명령이 주어지는 연동장치와 조합된 가드를 말한다. 단, 가드를 닫는 것 만으로 위험한 기계기능이 스스로 가동되지는 않는다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-006",
      "term": "제어회로(Control circuit)",
      "definition": "사출성형기의 운전을 제어하기 위하여 필요한 정보를 수집, 변조, 전달하는 회로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-007",
      "term": "동력회로(Power circuit)",
      "definition": "사출성형기의 운전을 위하여 에너지를 공급하기 위한 회로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-008",
      "term": "형체기구(Clamping mechanism)",
      "definition": "사출시 금형이 열리지 않도록 형 체결력으로 금형을 닫고 사출된 재료가 고형화되면 형체를 열어 성형품을 빼낼 수 있도록 고안된 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-009",
      "term": "사출기구(Injection unit)",
      "definition": "용융된 재료의 일정량을 높은 압력으로 금형 안으로 유입시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-010",
      "term": "성형구역(Mould area)",
      "definition": "고정관과 이동관 사이의 구역을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-011",
      "term": "체결구역(Clamping mechanism area)",
      "definition": "형체기구에서 성형구역을 제외한 구역으로서 이동판의 후방영역을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-012",
      "term": "고정 플레이트(Stationary platen)",
      "definition": "사출성형기의 형체기구 중 고정금형이 부착되는 곳으로서 사출기에 고정되어있는 정반을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-013",
      "term": "이동 플레이트(Movable platen)",
      "definition": "사출성형기의 형체기구 중 이동금형이 부착되는 곳으로서 개폐운동을 하는 정반을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-014",
      "term": "노즐(nozzle)",
      "definition": "가열 실린더의 선단부에 있는 성형재료의 사출구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-015",
      "term": "타이바(Tie bar)",
      "definition": "이동판 등을 지지하고 금형의 개폐동작을 안내하며 형 체결력을 지탱하는 기둥을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-016",
      "term": "가동유지장치(Hold-to-run control devices)",
      "definition": "수동으로 버튼을 누를 때에만 작동되고 버튼을 놓으면 자동으로 정지되는 조작 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M187-017",
      "term": "양수조작장치(Two-hand control devices)",
      "definition": "양손으로 동시에 버튼을 누를 때에만 작동되고 한손이라도 버튼을 놓으면 자동으로 정지되는 조작 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M187-01",
      "processOrder": 1,
      "processName": "사출성형기 구역별 위험 확인",
      "safetyMeasures": "형체기구 운동부위, 사출기구 운동부위, 전단·물림부위, 감전 위험부위, 고온부위 및 고온 재료 부위를 포함하여 근로자에게 위험을 끼칠 우려가 있는 부위를 확인한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-02",
      "processOrder": 2,
      "processName": "성형구역 방호장치 설치",
      "safetyMeasures": "조작스위치가 있는 쪽에 Ⅲ형식 방호장치를 갖춘 가동형 가드를 설치하고, 조작스위치가 없는 쪽에는 두 개의 위치검출센서를 구비한 연동 가드를 설치한다. 안전거리 미확보 시 윗면 등에 고정식 가드 또는 Ⅱ형식 가동형 가드를 추가 설치한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-03",
      "processOrder": 3,
      "processName": "체결구역 방호장치 설치",
      "safetyMeasures": "Ⅱ형식 방호장치를 갖춘 가동형 가드를 설치한다. 하향행정 플레이트 사출성형기의 경우 2개의 억제장치를 실린더에 설치하고, 플레이트 한 면 800mm 이상·스트로크 500mm 초과 시 유압식 및 기계식 억제장치를 설치한다.",
      "requiredPPE": [],
      "sourceSection": "6.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-04",
      "processOrder": 4,
      "processName": "노즐구역 방호장치 설치",
      "safetyMeasures": "I형식 방호장치를 갖춘 가동형 가드를 설치하고, 노즐 운동위치를 고려하여 양끝 단에서도 방호되도록 조치한다. 보수 시에는 사출기구의 모든 운동부분이 수동으로만 운전되도록 한다.",
      "requiredPPE": [],
      "sourceSection": "6.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-05",
      "processOrder": 5,
      "processName": "사출 및 가소장치구역 방호조치",
      "safetyMeasures": "구동장치 운동에 의한 위험이 발생하지 않도록 설계하거나 안전거리를 확보하고, 실린더 온도는 최대 사용온도를 초과하지 않도록 자동 모니터링하며 초과 시 가열장치 전원을 자동 차단한다.",
      "requiredPPE": [],
      "sourceSection": "6.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-06",
      "processOrder": 6,
      "processName": "배출구 방호장치 설치",
      "safetyMeasures": "제품 배출 시 손이나 팔이 접근할 수 없도록 안전거리를 고려하여 고정식 가드, I형식 가동형 가드 또는 광전자식안전장치를 설치한다.",
      "requiredPPE": [],
      "sourceSection": "6.6",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-07",
      "processOrder": 7,
      "processName": "고온부 방호 및 단열조치",
      "safetyMeasures": "재질별 온도 기준(금속 65℃, 코팅된 금속 70℃, 세라믹·유리·석재 80℃, 플라스틱·호스 85℃)을 초과하는 경우 보호가드를 설치하거나 단열조치를 하고 고온경고표지를 부착한다.",
      "requiredPPE": [],
      "sourceSection": "6.7",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "WP-M187-08",
      "processOrder": 8,
      "processName": "기타 방호조치 및 소음 관리",
      "safetyMeasures": "5 MPa 이상 유압호스 연결부위에 피팅류 접속·밀폐가드·보호망 등을 설치하고, 전기장치는 KS C IEC 60204-1:2002에 적합하게 하며, 소음은 85 dB(A) 미만을 유지하고 배기장치 설치가 가능하도록 설계한다.",
      "requiredPPE": [
        "방음보호구"
      ],
      "sourceSection": "6.9",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "WP-M187-09",
      "processOrder": 9,
      "processName": "이름판 및 안전표지 부착",
      "safetyMeasures": "제조자 정보, 형식, 일련번호, 제조일, 유공압 압력, 사출용량, 전원 정격, 고온부위 경고, 안전인증 표시가 포함된 이름판을 부착하고, 협착·화상·감전·추락·용융수지 비래 위험 경고표지를 해당 부위에 부착한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-29",
      "processOrder": 10,
      "processName": "금형 교체 전 준비",
      "safetyMeasures": "사출 유닛을 금형으로부터 후진시키고 적절한 온도를 유지하며 노즐 잠금 밸브를 개방한다. 코어 밀기 기구와 이젝터 커플링에 공급되는 전원을 차단한다. 적절한 양중장비를 사용한다.",
      "requiredPPE": [],
      "sourceSection": "10.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-30",
      "processOrder": 11,
      "processName": "가드/연동장치 사용시 금형 교체",
      "safetyMeasures": "방호가드가 열려있을 때 플레이트, 코어 및 이젝터 기구가 움직이지 않는 것을 확인한 후 작업을 개시한다. 방호영역 내 작업 시 비상정지제어에 의해 모든 기계 움직임이 정지되어야 한다. 전력 불필요 시 금형 교체가 지연되면 전원을 끄고 저장된 에너지를 방출한다.",
      "requiredPPE": [],
      "sourceSection": "10.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-31",
      "processOrder": 12,
      "processName": "가드/연동장치 제거시 금형 교체",
      "safetyMeasures": "가드나 연동장치를 제거하고 금형교체를 한다면 기계의 전원을 끄고 저장된 에너지를 방출시켜야 한다.",
      "requiredPPE": [],
      "sourceSection": "10.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-32",
      "processOrder": 13,
      "processName": "금형 교체 후 확인 및 점검",
      "safetyMeasures": "사용된 호스가 온도에 적절한 것인지 확인한다. 가드나 연동장치를 재설치하고 점검표에 따라 가드가 적절히 작동하는지 점검한다. 작업자는 가공작업 전에 기계를 운전하여 독립적으로 동작상태를 점검한다.",
      "requiredPPE": [],
      "sourceSection": "10.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-33",
      "processOrder": 14,
      "processName": "일상 및 금형 교체 후 점검",
      "safetyMeasures": "고정식·연동식 가드의 위치 및 기능 확인, 조작측 가드 열림 시 플레이트 닫힘 여부, 제어장치 덮개 닫힘·잠금·키 제거 확인, 기계적 구속 올바름 확인을 실시한다.",
      "requiredPPE": [],
      "sourceSection": "11.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-M187-34",
