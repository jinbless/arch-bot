  "checklistItems": [
    {
      "identifier": "CI-M176-001",
      "text": "밴드나이프 전단기는 7.1에 따라 안전장치를 설치하여야 한다.",
      "guideContext": "밴드나이프 전단기 일반 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-002",
      "text": "위험한 부분에 접근하지 못하도록 안전거리를 유지하여야 한다.",
      "guideContext": "밴드나이프 전단기 일반 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-003",
      "text": "방호울(Fence)의 높이는 1.8 m 이상으로 설치하고, 출입문에는 연동장치를 설치하여야 한다.",
      "guideContext": "밴드나이프 전단기 일반 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-004",
      "text": "고정식 가드의 고정 시스템은 이러한 안전장치가 제거될 때 보호대 또는 기계에 붙어있도록 남아있어야 한다.",
      "guideContext": "밴드나이프 전단기 일반 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-005",
      "text": "광전자식 안전장치는 안전인증 기준에 맞는 것을 사용하여야 한다.",
      "guideContext": "밴드나이프 전단기 일반 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-006",
      "text": "최대 절단구역 외부에 있는 움직이는 밴드나이프와의 접촉은 고정 또는 인터록된 안전장치에 의해 예방이 가능하다.",
      "guideContext": "밴드나이프 전단기 기계적 위험 안전대책",
      "additionalDetail": null,
      "workProcessPhase": "절단 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-007",
      "text": "밴드나이프 작동 시에는 경고 신호를 보내는 장치가 설치되어있어야 한다.",
      "guideContext": "밴드나이프 전단기 기계적 위험 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절단 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-008",
      "text": "위험지역에 접근을 예방할 수 있는 가드를 설치한다.",
      "guideContext": "밴드나이프 전단기 기계적 위험 안전대책 (법령 근거 미확인)",
      "additionalDetail": "위험지역에서의 절단과 물림 방지",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-009",
      "text": "연마 장치에 장착된 가드는 연마석 조각이 배출될 위험을 줄일 수 있도록 만들어져야 한다.",
      "guideContext": "밴드나이프 전단기 기계적 위험 안전대책 (법령 근거 미확인)",
      "additionalDetail": "연마 숫돌에서 배출되는 조각에 맞을 위험 방지",
      "workProcessPhase": "밴드나이프 연마",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-010",
      "text": "기계를 적합하게 고정할 수 있는 지점에 설치하여야 한다.",
      "guideContext": "밴드나이프 전단기 기계적 위험 안전대책 (법령 근거 미확인)",
      "additionalDetail": "안정성을 잃으면서 발생하는 위험 방지",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-011",
      "text": "밴드나이프 절단기는 비상정지장치가 설치되어야 한다.",
      "guideContext": "밴드나이프 전단기 기계적 위험 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-012",
      "text": "비상정지버튼은 눌러서 작동되고, 수동으로 돌려서 복귀하는 형식으로 설치되어야 한다.",
      "guideContext": "밴드나이프 전단기 비상정지장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-013",
      "text": "작업자가 쉽게 볼 수 있는 장소에 설치하여야 한다.",
      "guideContext": "밴드나이프 전단기 비상정지버튼 설치 위치 (법령 근거 미확인)",
      "additionalDetail": "비상정지버튼 설치 위치 요건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-014",
      "text": "추가적인 소음 감소 대책은 다음에 의해 이뤄질 수 있다. 방음 재료, 가능하다면 밴드나이프 작동 부품의 저소음 재료 사용, 전동기 주변을 밀폐하여 소음 감소, 진공시스템 배기관에 소음기의 설치, 컨베이어 시스템에 저소음 재료의 사용",
      "guideContext": "밴드나이프 전단기 소음 안전대책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M176-015",
      "text": "연마 장치는 연마 장치에 연결된 배기장치에 의해서 먼지 배출과 비산되는 불꽃이 감소될 수 있도록 설계되어야 한다.",
      "guideContext": "밴드나이프 연마 시 화재 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밴드나이프 연마",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-016",
      "text": "연마 장치와 가드는 가드 내부에 먼지가 축적되는 것을 감소시킬 수 있도록 설계되어야 한다.",
      "guideContext": "밴드나이프 연마 시 화재 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밴드나이프 연마",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M176-017",
      "text": "국소배기장치가 필요한 작업일 경우, 기계는 배기 고장 검출 시스템(Exhaust failure detection system)이 있어야한다.",
      "guideContext": "밴드나이프 전단기 분진 안전대책 (법령 근거 미확인)",
      "additionalDetail": "배기장치 고장 시 기계 작동 방지 또는 제어된 정지 기능",
      "workProcessPhase": "절단 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.5",
      "basedOn": null
    }
  ],
