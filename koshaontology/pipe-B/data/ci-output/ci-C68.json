  "checklistItems": [
    {
      "identifier": "CI-C68-001",
      "text": "보강토(뒷채움재)는 유기질 및 유해물이 함유되지 않은 재료를 사용하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강토 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-002",
      "text": "보강토는 콘크리트 블록에 연결된 보강재가 토압에 충분히 저항할 수 있는 전단강도를 발현할 수 있는 재료를 사용하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강토 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-003",
      "text": "보강토의 입도는 No.200체(75㎛)의 통과백분율이 15% 이하 및 내부마찰각 25° 이상이어야 하고 세부 사항은 관련 시방서에 따른다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강토 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-004",
      "text": "현장의 유용토를 사용할 경우에는 그 적합 여부를 표준삼축압축강도시험 또는 직접전단시험 등을 수행하여 검증하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강토 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-005",
      "text": "현장에 반입된 콘크리트 블록은 표본 채취하여 압축강도, 흡수율, 치수, 외관조사 등을 실시하고 그 성능을 검증하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-006",
      "text": "블록의 강도시험은 KS F 2405-01(콘크리트 압축강도)와 KS F 4419-01(보차도용 조립블록)을 준용하여 실시하고, 설계기준강도 이하의 콘크리트 블록을 사용하여서는 아니된다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-007",
      "text": "블록의 흡수율은 평균 8% 이내 이어야 하고 각각의 흡수율은 10%이내 이어야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-008",
      "text": "블록의 치수는 가로, 세로, 높이가 각각 ±3mm 이내의 오차로 제작되어야 하고 이를 초과한 제품을 사용하여서는 아니 된다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-009",
      "text": "블록의 외관은 균열 및 파손 등의 결함이 없는 것을 사용하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-010",
      "text": "블록의 야적 장소는 평탄한 곳을 택하여 적치된 블록이 쓰러지지 않도록 조치하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-C68-011",
      "text": "보강재는 설계서에서 정한 인장강도 이상의 제품을 사용하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-012",
      "text": "보강재의 인장변형률은 최대인장강도에서 13% 이내이어야 하며, 치수는 허용오차를 초과하지 않아야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-013",
      "text": "보강재는 지중에 매립되었을 때 부식을 방지할 수 있는 재료를 사용하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-014",
      "text": "보강재의 부식방지용 피복이 손상된 재료를 사용하여서는 아니 된다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-015",
      "text": "보강재를 보관할 때에는 인화성이 있는 물질을 피하고, 자외선에 장시간 노출 되지 않도록 보호커버를 씌워서 보관하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-016",
      "text": "결속봉은 부식을 방지할 수 있는 재질을 사용하여야 하며, 결속봉 전용으로 제작된 것을 사용하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-017",
      "text": "콘크리트 블록과 보강재를 상호 결속에 필요한 강도 등의 성능을 고려하여 자재를 선정하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-018",
      "text": "블록의 배면에 설치하여 토립자의 유출방지 성능이 우수한 자재를 사용하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수재 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-019",
      "text": "배수재는 블록벽체 배면에 설치되는 배수 필터로써, 투수성이 크고 내부식성이 높은 부직포를 사용하여야 하며, 설치시 이음부의 겹이음이 충분할 수 있도록 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수재 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-020",
      "text": "각 세부공정별로 위험성평가를 실시하고, 관리 대상 위험요인에 대한 재해예방 대책을 시행하고 작업하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-021",
      "text": "위험성평가를 실시할 때에는 설계서, 현장 및 작업 조건, 투입되는 근로자 및 건설장비 등을 종합적으로 검토하여야 하며, 허용할 수 없는 위험요인에 대해서는 위험요인의 제거 또는 위험수준을 낮출 수 있도록 재해 예방 대책을 수립하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-022",
      "text": "보강토 옹벽의 설계는 현장의 지형, 지반 조건, 옹벽의 높이, 보강토의 토질정수, 보강토 옹벽에 사용되는 자재의 성능 등을 반영한 것이어야 한다. 이때 보강토 옹벽 배면에 설치하는 보강재 길이의 충분한 확보 및 지하매설물 또는 지상구조물 등의 여부를 확인하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-023",
      "text": "보강토 옹벽 배면에 시공 시 간섭되는 지하매설물이 있는 경우에는, 지하매설물의 이설, 설계 변경 등 대책 방안을 수립하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-024",
      "text": "보강토 옹벽 배면에 기존 시설물이 존재하거나 현장여건에 따라 보강재의 설계길이가 부족한 경우에는 기존구조물에 앵커를 설치하거나 기존 지반에 소일네일링 등의 계획을 수립하고 그에 대한 안전성을 검토하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-025",
      "text": "설계서에는 기초의 소요지내력, 보강토의 성토두께 및 다짐조건, 보강재를 설치할 수 없는 경우의 앵커체를 정착할 수 있는 지반 또는 구조물의 강도기준, 앵커체와 콘크리트 블록 간의 연결방법 등을 반드시 명기하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-026",
      "text": "투입되는 건설장비의 종류 및 능력을 검토하여 작업조건에 적합한 건설기계를 선정하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-027",
      "text": "작업조건 및 지형을 고려하여 건설장비의 안전한 이동경로를 확보하여야 하며, 굴착작업을 하는 때에는 굴착장비의 전도·전락 또는 근로자의 충돌·협착 등의 사고를 방지하기 위하여 유도자를 배치하는 등의 안전조치를 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-028",
      "text": "기초 터파기는 설계서에서 정한 깊이와 폭, 지반의 지내력 등을 확보하여야 하며, 콘크리트 블록을 수평으로 설치할 수 있도록 준비되어야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-029",
      "text": "기초 터파기의 깊이와 폭은 설계서에서 정한 바에 따라 굴착하되 기초콘크리트 타설과 기초 블록을 설치할 수 있는 작업공간을 확보하여야 하고, 배면에는 보강재의 설치가 용이하도록 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-030",
      "text": "보강토 옹벽의 설치높이에 따른 콘크리트 블록의 자중으로 인하여 침하가 발생하지 않도록 기초 지반의 지내력을 확보하여야 하며, N=6이하의 연약한 지층인 경우에는 연약층 깊이를 고려하여 연약지층을 치환 또는 보강하는 등의 조치를 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-031",
      "text": "기초 바닥면은 지내력이 충분하지 않을 경우 다짐, 잡석 포설 등 보강조치를 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-032",
      "text": "콘크리트를 타설할 때에는 장비의 이동경로 및 작업 공간을 확보하고 작업반경 내 근로자의 접근을 통제하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "기초콘크리트 타설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-033",
      "text": "기초 콘크리트는 계획된 기초 높이에 맞추어 기초표면이 수평이 되도록 타설하여야 한다. 이때 기초 지반이 경사진 경우에는 콘크리트 블록의 길이와 높이를 고려하여 모든 콘크리트 블록이 수평을 유지할 수 있도록 계획하여 계단식으로 타설하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "기초콘크리트 타설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-034",
      "text": "기초 콘크리트의 치수는 콘크리트 블록의 크기 및 지반조건에 따라 설계서에서 정한 크기로 설치하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-035",
      "text": "콘크리트 블록은 쌓기 작업 위치별로 분산 적재하고 운반장비의 이동경로 및 작업조건 등을 고려하여 안전한 작업계획을 수립하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-C68-036",
      "text": "콘크리트 블록의 축조는 근로자의 근골격계 질환은 예방할 수 있는 방법으로 실시하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-037",
      "text": "작업조건에 따라 작업시간과 휴식시간 등을 적정하게 배분하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-038",
      "text": "지게차 등으로 콘크리트 블록을 운반할 경우에는 보강재가 손상되지 않도록 이동 경로를 정하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-039",
      "text": "블록 인양기구는 블록 인양공 등의 형상에 적합하고 블록의 중량을 고려한 강도로 제작하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-040",
      "text": "블록은 상하로 인접하는 블록간에는 상호 교차되도록 조립하고 좌우로는 요칠결합이 되도록 축조하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-041",
      "text": "블록 설치 시 블록치수의 허용오차내의 누적된 수평변위 또는 부동침하에 의한 블록의 수평변위 등의 문제에 따른 블록 벽체의 변형을 방지하기 위하여, 블록 설치 시 마다 기울기 및 수평도의 이상 유무를 확인하여야 하고, 블록의 기울기 및 수평도에 이상이 있을 때에는 모르터 등을 사용하여 수평을 조정한 후 블록을 설치하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-042",
      "text": "시공이 완료된 옹벽의 높이에 대한 기울기는 100분의 3이내이어야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "블록쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-043",
      "text": "보강토의 포설 및 다짐작업을 하는 경우에는 장비의 이동경로를 계획하고 이동경로에 따라 장비의 전도·전락 또는 근로자의 충돌·협착 재해 등을 방지하기 위하여 작업지휘자를 배치하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-044",
      "text": "보강토의 각 층별 다짐작업은 그 층의 보강재 포설 및 콘크리트 블록 쌓기를 완료한 후 시행하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-045",
      "text": "보강토 옹벽 단부에는 장비사용시 붕괴, 전락 등의 사용 장비의 중량 등을 고려하여 접근한계를 설정하고 준수하여 작업을 실시하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-046",
      "text": "보강토의 포설 및 다짐 작업은 블록의 방향과 평행하게 실시하되, 블록과 가까운 쪽부터 시작하여 먼 쪽으로 진행하여야 한다. 이 때 블록에서 1.5m 이내의 위치는 중량의 장비의 접근을 금지하고, 소형 롤러 등 경량의 장비로 다짐하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-047",
      "text": "옹벽의 단부에서 근로자가 작업하는 경우에는 작업조건 및 지형 등을 고려하여 근로자의 추락을 방지하기 위한 적절한 조치를 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-048",
      "text": "보강토의 포설 및 다짐은 다짐 장비 및 흙의 성질에 따라 충분한 다짐이 되도록 계획하되 1개층의 다짐두께는 20cm가 초과되지 않도록 하고 매 층마다 설계서에서 정한 다짐도를 확보하여, 블록의 높이 및 보강재의 포설 높이까지 단계별로 시공한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-049",
      "text": "보강토의 포설 및 다짐 작업 시 장비의 이동으로 인하여 설치된 보강재가 뒤틀리거나 훼손되지 않도록 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-050",
      "text": "보강토의 다짐층 높이는 전면에 걸쳐 동일하게 하고 특히 블록과 보강재의 연결고리 부분은 보강재의 연결 폭과 높이를 적정히 유지하여, 그 위층에 보강토를 포설 및 다짐할 때에 보강재가 눌리어 블록이 끌려오거나 보강재가 꺾이지 않도록 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-051",
      "text": "보강재 후단을 팽팽히 긴장하였을 때 다짐면으로부터 이격됨이 없이 접합되도록 보강토 다짐면의 평활도를 확보하여, 그 위층의 뒷채움재를 포설 및 다짐할 때 보강재에 굴곡이 생기지 않고 토압에 대응하는 전단력이 충분히 발현될 수 있도록 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강토 다짐",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-052",
      "text": "보강재의 설치는 뒷채움재(보강토)를 포설하고 다짐이 완료된 후 시행하고, 보강재를 벽체에 연결하여 뒷채움재의 다짐층 위에 지그재그(Zigzag) 형태로 펴서 설치하되, 보강재의 느슨함이 없도록 보강재 후단부를 긴장하여 고정하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-053",
      "text": "띠형 보강재의 경우 보강재의 이음은 1m이상 겹이음 하고, 겹이음의 위치는 항상 보강재의 후단부 고정못 위치에서 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-054",
      "text": "보강토 옹벽 배면에 기존 구조물과의 간섭 등으로 인하여 보강재의 설치 길이가 충분히 확보되지 않아 앵커를 근입하여 보강재를 설치하는 경우에는, 보강재를 연결하는 앵커의 정착력이 블록에 작용하는 토압 이상으로 확보되도록 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-055",
      "text": "보강토 옹벽 배면에 원지반의 경사면이 있어 이에 소일네일링을 시공하고 보강재를 설치하는 경우에는 소일네일링의 정착력이 블록에 작용하는 토압 이상으로 확보되는지를 확인하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "보강재 포설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-056",
      "text": "보강토 옹벽 배면에 설치되는 앵커 및 소일네일링과 보강재의 연결을 위한 모든 재료는 토사에 매립될 경우 부식이 되지 않도록 방청재를 도포하는 등 부식방지 조치를 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": "다만 콘크리트를 타설하여 콘크리트에 매립되는 경우에는 그러하지 아니하다.",
      "workProcessPhase": "보강재 포설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-057",
      "text": "배수재 설치시 발생되는 각 이음부는 겹이음 처리하되 벌어짐으로 인한 토사유출 방지를 위해 겹이음량을 충분히 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "배수재 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-058",
      "text": "배수가 원활히 될 수 있도록 배수재와 접하는 측에는 잡석으로 뒷채움을 하고 그 후면에 보강토(뒷채움재)를 포설하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수재 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-059",
      "text": "다량의 지하수 혹은 용출수의 유입이 예상 될 경우에는 원활한 배수를 위하여 기초 지반 위에 배수층을 설치하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수재 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-060",
      "text": "보강토로서 점성질 사질토를 사용할 경우에는 높이 3~4m 간격마다 배수층을 수평으로 설치하여 벽체의 배수공을 통하여 배수될 수 있도록 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수재 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-C68-061",
      "text": "옹벽 전면이 물에 잠기거나 물이 흐르는 하천인 경우에는 토사의 유실을 방지하고, 수위 변화에 따른 전면부 배수를 원활히 하기 위해 갠자갈을 약 50cm 폭으로 벽체 후면부에 채워야 하며, 또한 옹벽기초부의 침식 방지 및 기초 보강을 위한 보호책을 강구하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": "배수재 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.8",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-062",
      "text": "콘크리트 블록 쌓기작업, 옹벽 단부에서의 다짐작업 및 보강재의 포설작업 배수재 설치 작업 등을 수행할 때에는 추락재해로부터 근로자를 보호하기 위한 조치를 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.9",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-063",
      "text": "근로자를 대상으로 추락재해 예방에 대한 안전교육을 실시하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.9",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-064",
      "text": "현장조건 및 작업조건에 고려하여 예상되는 추락 위험 요인에 적합한 안전시설물을 갖추어야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.9",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C68-065",
      "text": "추락재해 방지시설은 옹벽 전면에 쌍줄비계를 설치하여 안전난간을 설치하거나 옹벽 후면에 안전대 부착설비를 갖추어 안전대를 착용하는 등의 조치를 하여야 한다.",
      "guideContext": "블록식 보강토 옹벽 공사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.9",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-C68-001",
      "term": "보강토(Reinforced Earth)",
      "definition": "인장력이 큰 합성섬유 등으로 제조된 보강재를 성토(뒷채움재) 다짐층 내에 일정 간격으로 설치하여 내부응력 및 외력에 대한 저항성을 증가시켜 주도록 보강된 흙을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C68-002",
      "term": "콘크리트 블록(Concrete Block)",
      "definition": "보강토의 전면에 설치되어 보강토의 유출을 방지하고, 보강토 옹벽의 외부 마감재로 사용되며 구조적인 안정성을 확보하기 위한 콘크리트 블록을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C68-003",
      "term": "보강재",
      "definition": "블록에 연결되고 성토(뒷채움재)층 내에 일정 간격으로 설치되어 흙과의 마찰력으로 토압에 저항하도록 하는 합성섬유 등으로 제조된 띠형(보통 THK 2.5～4.3mm, W50mm)이나, 격자형의 재료를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C68-004",
      "term": "결속봉(Connecting Rod)",
      "definition": "여러 개의 블록을 수직으로 적층하여 결합시키기 위하여 FRP(강화 파이바 프라스틱) 등으로 제작한 자재를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C68-005",
      "term": "배수재(Drain Filter)",
      "definition": "블록의 배면부에 설치되어 토립자의 유출방지와 침투수의 원활한 배수를 위하여 설치하는 부직포를 말한다. 또한 25mm이하의 자갈층 및 유공관(부직포 포함)을 두어 원활한 배수를 유도할 수 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C68-006",
      "term": "수평간격 이음재",
      "definition": "블록 하단부에 수평간격 이음재를 부착하여 편심에 의한 블록 파단현상을 감소시키기 위한 발포고무 합성소재 등으로 제작한 패드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
