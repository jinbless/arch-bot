  "checklistItems": [
    {
      "identifier": "CI-G44-001",
      "text": "작업의 형태, 대상물의 특성, 작업자의 체력 등을 고려하여 공구의 종류와 크기를 선택한다.",
      "guideContext": "수공구 사용 전 조치사항",
      "additionalDetail": null,
      "workProcessPhase": "수공구 선택 및 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-002",
      "text": "올바른 사용방법을 숙지하도록 반복훈련을 실시한다.",
      "guideContext": "수공구 사용 전 조치사항",
      "additionalDetail": null,
      "workProcessPhase": "수공구 선택 및 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-003",
      "text": "가공물, 파편의 비래가 발생할 수 있는 작업장에는 방호판을 설치하고 보안경, 안면보호구 등을 착용한다.",
      "guideContext": "수공구 사용 전 조치사항",
      "additionalDetail": null,
      "workProcessPhase": "수공구 선택 및 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-004",
      "text": "고소지역 작업 시 작업발판을 설치 또는 안전대를 착용한다.",
      "guideContext": "수공구 사용 전 조치사항",
      "additionalDetail": null,
      "workProcessPhase": "수공구 선택 및 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-005",
      "text": "손잡이 체결상태 및 수공구의 마모, 변형상태를 점검한다.",
      "guideContext": "수공구 사용 전 조치사항",
      "additionalDetail": null,
      "workProcessPhase": "수공구 선택 및 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-006",
      "text": "손잡이의 기름 등 이물질을 제거하고 이상 유무 확인 후 사용한다.",
      "guideContext": "수공구 사용 전 조치사항",
      "additionalDetail": null,
      "workProcessPhase": "수공구 선택 및 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-007",
      "text": "렌치 등은 미끄러지지 않도록 정확히 입의 물림면을 조인 후 사용하고 렌치 홈에 쐐기를 삽입하지 않도록 한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-008",
      "text": "렌치, 플라이어 등은 큰 힘을 얻기 위해 파이프 등을 끼워 길이를 연장하거나 해머 등 다른 공구로 두드리지 않도록 한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-009",
      "text": "손가락이 협착되지 않도록 손잡이 사이에 충분한 공간이 있는 공구를 선택한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-010",
      "text": "렌치, 플라이어 등은 밀지 말고 끌어당기는 상태로 작업한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-011",
      "text": "너트와 볼트작업에는 플라이어를 사용하지 않고 렌치를 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-012",
      "text": "플라이어 등은 과중한 열에 노출시키지 않도록 한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-013",
      "text": "플라이어 등은 규칙적으로 중심점에 기름을 바른 후 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-014",
      "text": "드라이버 홈의 폭과 길이가 같은 날 끝의 것을 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-015",
      "text": "드라이버 날 끝이 수평하여야 하며, 둥글거나 빠진 것은 사용하지 않도록 한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-016",
      "text": "드라이버 손잡이에 대하여 축이 수직으로 된 것을 사용하고 날 끝이 홈에 맞지 않을 때에는 임의로 교정하지 않는다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-017",
      "text": "드라이버로 전기작업을 할 때에는 절연손잡이로 된 드라이버를 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-018",
      "text": "손이 잘 닿지 않거나 불편한 곳에서 나사를 돌리기 시작 할 때에는 나사가 자석에 붙는 드라이버를 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-019",
      "text": "한 손으로 드라이버를 사용하고 있는 동안 다른 손으로 나사를 잡지 않도록 한다.",
      "guideContext": "수공구 사용 안전지침 - 조립공구",
      "additionalDetail": null,
      "workProcessPhase": "조립공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-020",
      "text": "수직방향으로 절단하고 가공물이 튀지 않도록 절단부 주위를 마대자루, 천 등으로 방호한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-021",
      "text": "제품 결속용 밴드(Band)해체 시 충돌되지 않도록 작업자 안전거리 유지 및 외부인 접근 통제조치를 취한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-022",
      "text": "절단공구를 사용할 때에는 사용자 앞쪽으로 절단하지 않도록 한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-023",
      "text": "톱은 잘리는 나무에 못, 옹이 또는 톱을 손상시키거나 휘어지게 하는 이물질이 있는지 확인하고 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-024",
      "text": "톱날이 튀는 것을 방지하기 위해 천천히 베기 시작하고, 톱을 아래로 내릴 때만 압력을 가한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-025",
      "text": "가위는 연한 금속을 자를 때만 사용하고 단단하거나 경화된 금속은 다른 절단공구를 적절히 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-026",
      "text": "오른손잡이가 가위를 사용할 경우 부스러기 등은 오른쪽에 놓이도록 절단하고, 왼손잡이의 경우는 부스러기 등이 왼쪽으로 놓이도록 절단한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-027",
      "text": "가위의 너트와 중심 볼트가 항상 적절히 조정되어야 하며, 중심볼트는 수시로 기름을 바른다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-028",
      "text": "끌은 내리치는 면이 더 큰 나무나 플라스틱 해머 등을 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-029",
      "text": "끌 사용시 나무에 마디, 격쇠, 나사, 못 등 다른 이물질이 있는지 작업 전 확인한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-030",
      "text": "열처리된 끌 등은 교정하기 위해 동력연삭기를 사용하지 말고 숫돌을 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-031",
      "text": "강철 끌의 표면이 버섯 모양으로 퍼지거나 모서리 이가 빠진 것은 사용하지 말아야 한다.",
      "guideContext": "수공구 사용 안전지침 - 절단공구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절단공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-032",
      "text": "추락 위험개소에서 작업시 작업발판 설치 및 안전대를 착용한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-033",
      "text": "2인 공동 작업시 가공물 지지자는 손이 다치지 않도록 집게나 고정구를 이용한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-034",
      "text": "사용시 헛치지 않도록 대상물의 표면보다 더 큰 직경의 해머머리를 선택한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-035",
      "text": "대형 해머의 경우 작업 전 신체를 충분히 이완시키고 균형을 잃지 않도록 편평한 바닥위에서 안정 된 자세로 작업한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-036",
      "text": "작업에 맞는 무게의 해머를 사용하고, 한 두번 가볍게 친 다음에 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-037",
      "text": "미끄러짐 방지를 위하여 기름 묻은 손으로 손잡이를 잡지 않도록 하고, 장갑을 착용하는 경우에는 미끄러짐이 없는 장갑을 착용한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-038",
      "text": "협소한 장소, 발 딛는 장소가 나쁠 때, 작업이 끝나기 직전에 특히 유의하여 작업한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-039",
      "text": "눈이나 신체일부에 파편이 튀는 것을 방지하기 위해 돌, 벽돌 등 단단한 물질을 타격하지 않도록 한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-040",
      "text": "금이 가고, 부러지고, 쪼개지고, 모서리가 날카롭거나 해머머리에 헐겁게 끼워진 불안전한 손잡이는 폐기하고, 손잡이가 흔들림이 없도록 고정하여 사용한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-041",
      "text": "타격하는 해머의 표면이 맞는 물체의 표면에 평행하도록 수직으로 내리치고 물체를 주시하여야 한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-042",
      "text": "해머 머리가 패인부분이 있거나 금이 간 것, 이가 빠진 자리, 버섯모양으로 퍼진 상태, 또는 지나치게 마모된 해머 머리는 사용하지 말고 교체한다.",
      "guideContext": "수공구 사용 안전지침 - 타격공구",
      "additionalDetail": null,
      "workProcessPhase": "타격공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-043",
      "text": "가공물을 들어 올리거나 작업발판, 가설비계 조립용으로 사용은 금지시킨다.",
      "guideContext": "수공구 사용 안전지침 - 고정공구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고정공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-044",
      "text": "다른 공구, 보조 도구를 사용하여 가공물을 무리하게 고정시키지 말아야 한다.",
      "guideContext": "수공구 사용 안전지침 - 고정공구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고정공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-045",
      "text": "클램프 형태와 크기는 작업에 따른 고정방법과 다음의 사항을 고려하여 클램프 특성에 맞게 적절하게 선택한다.",
      "guideContext": "수공구 사용 안전지침 - 고정공구",
      "additionalDetail": "강도와 무게, 조절의 용이성, 표면 조임, 사용하는 재료와 크기를 고려",
      "workProcessPhase": "고정공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-046",
      "text": "바이스는 작업대나 지지대에 단단하게 설치하여야 하며 바이스 바닥의 모든 구멍에는 볼트를 채운다.",
      "guideContext": "수공구 사용 안전지침 - 고정공구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고정공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-047",
      "text": "가공물을 변형시키지 않고도 고정시킬 수 있도록 충분히 큰 바이스를 사용하여야 한다.",
      "guideContext": "수공구 사용 안전지침 - 고정공구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고정공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-048",
      "text": "바이스를 꽉 조이기 위해 손잡이를 길게 하여 사용하지 않는다.",
      "guideContext": "수공구 사용 안전지침 - 고정공구",
      "additionalDetail": null,
      "workProcessPhase": "고정공구 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-049",
      "text": "사업주는 안전한 상태의 수공구를 근로자에게 제공하여 사용토록 하여야 하며 근로자는 수공구를 안전한 상태로 유지 관리하여야 한다.",
      "guideContext": "수공구 안전수칙 - 일반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-050",
      "text": "사업주는 가공물의 비래가 우려되는 장소에서 작업하는 경우에는 근접 작업자가 위험에 노출되지 않도록 적절한 조치를 하여야 한다.",
      "guideContext": "수공구 안전수칙 - 일반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-051",
      "text": "칼이나 가위의 날은 작업에 적절한 상태로 유지되도록 관리 한다.",
      "guideContext": "수공구 안전수칙 - 일반",
      "additionalDetail": "날 부분이 둔탁한 칼 등은 더 위험하다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-052",
      "text": "수공구 사용자는 보안경, 장갑, 안면보호구 등 개인 보호구를 착용 하여야 한다.",
      "guideContext": "수공구 안전수칙 - 일반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-053",
      "text": "인화성 물질이 있는 곳에서 스파크를 발생할 수 있는 철 등으로 된 타격공구를 사용하면 점화원이 될 수 있으므로 황동, 플라스틱, 알루미늄 또는 나무로 된 수공구를 사용한다.",
      "guideContext": "수공구 안전수칙 - 일반",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-054",
      "text": "작업에 적정한 수공구를 사용한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-055",
      "text": "사용하기 적정한 상태를 유지한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-056",
      "text": "안전장소에 보관한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-057",
      "text": "수공구를 던지지 않는다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-058",
      "text": "손상된 수공구를 사용하지 않는다",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-059",
      "text": "사용하기 전에 수공구 상태를 점검한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-060",
      "text": "수공구를 손에 들고 사다리 등을 오르지 않는다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-061",
      "text": "수공구는 설계된 목적 외로 사용하지 않는다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-062",
      "text": "사용할 수 없는 수공구는 꼬리표를 부착하고 수리될 때 까지 사용하지 않는다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-063",
      "text": "수공구는 높은 곳에서 다른 작업자에게 떨어뜨리지 않도록 관리한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-064",
      "text": "수공구의 유지·관리에 대해서는 각 작업자에게 책임을 부여하고, 부적절한 수공구 발견 시 즉시 수리 또는 보고 절차를 거쳐 조치한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-065",
      "text": "칼 등 날카로운 수공구는 적절한 방법으로 보호한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-066",
      "text": "사용 후 적절한 보관함 등을 활용하여 제자리에 보관한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-067",
      "text": "작업복 호주머니에 날카로운 수공구를 넣고 다니지 않는다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-068",
      "text": "모든 수공구는 기록·관리 하고, 항상 안전하고 정상적인 상태로 사용할 수 있도록 한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G44-069",
      "text": "작업을 할 때 손이 수공구를 잡고 있지 않도록 한다.",
      "guideContext": "수공구 안전수칙",
      "additionalDetail": "타격 대상물을 잡고 있을 때 수공구 대신 집게 등 보조도구 사용",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G44-001",
      "term": "드라이버(Driver)",
      "definition": "주로 작은 나사, 나사 못, 태핑 나사 등을 죄고 푸는데 사용하는 수공구로 일반적으로 스크루 드라이버라고도 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-002",
      "term": "펜치(Plier)",
      "definition": "주로 동선류 또는 철선류를 잡고 구부리거나 자르는데 사용하는 수공구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-003",
      "term": "스패너(Spanner)",
      "definition": "볼트, 너트 또는 나사의 조립 또는 분해에 사용하는 둥근형 또는 뾰족형 수공구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-004",
      "term": "칼(Knife)",
      "definition": "종이 등의 재료를 자르는 작업에 사용하는 도구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-005",
      "term": "줄(Files)",
      "definition": "주로 금속을 손 작업으로 다듬질할 때 쓰이는 수공구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-006",
      "term": "톱(Saw)",
      "definition": "손작업에 사용하는 쇠톱날을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-007",
      "term": "가위(Scissors)",
      "definition": "절단 및 재단용으로 사용되는 일반용 가위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-008",
      "term": "해머(Hammer)",
      "definition": "철공, 목공, 토공작업 등에 사용하는 손망치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-009",
      "term": "끌(Chisel)",
      "definition": "주로 금속의 모양을 깎아 만들거나 절삭하는데 사용하는 수공구로 철공작업용, 목공작업용 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-010",
      "term": "펀치(Punches)",
      "definition": "여러 모양의 구멍류를 가공하는 데 사용되는 끝이 날카롭거나 일정한 형상을 가진 수공구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G44-011",
      "term": "렌치(Wrench)",
