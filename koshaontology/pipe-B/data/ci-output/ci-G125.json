  "checklistItems": [
    {
      "identifier": "CI-G125-001",
      "text": "사업장은 지진의 규모와 크기(진도), 시설물 내진 특성, 위험 특성 등을 고려하여 비상대응조직 가동 여부, 단계별 대응 수준 및 방법을 결정하기 위한 자체 기준을 다음의 지진 대응 여부 판단을 고려하여 운영한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "평상시 지진 대비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-002",
      "text": "석유화학공장이나 국가 핵심 사업장의 경우 지진계측기 웹 모니터링 시스템을 구축한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "평상시 지진 대비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-003",
      "text": "진도 Ⅲ 정도의 경우 상황 전파, 외관점검을 수행한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-004",
      "text": "진도 Ⅳ 정도의 경우에는 외관점검과 정밀점검을 수행한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-005",
      "text": "진도 Ⅴ 이상의 경우에는 비상대응대책본부를 가동한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-006",
      "text": "지진 시 사고의 수습, 피해확산 방지, 신속한 구조 및 구호 등을 위한 비상대응조직을 사전에 구성하고, 교육·훈련을 통해 지진 발생 시 유연하게 대응할 수 있는 체제를 유지해야 한다.",
      "guideContext": "사업장 지진대비 비상대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 조직 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-007",
      "text": "사업장 특성에 따라 임무의 종류와 근로자 수 등을 고려하여 조직한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 조직 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-008",
      "text": "총괄책임자 및 업무별 책임자에 대해서는 수시로 교육·훈련을 실시하여 평소에도 재난관리의 책임을 주지하고 역량을 유지하도록 해야 한다.",
      "guideContext": "사업장 지진대비 비상대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-009",
      "text": "지진 발생에 대비한 비상연락망은 사업장 근로자뿐만 아니라 협력업체 근로자를 포함하여 작성한다. 다만 소방이나 화학물질 누출 대비 등 다른 비상 시 대응조직과 같이 작성할 수 있다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 조직 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-010",
      "text": "점검책임자는 소방이나 방재에 관한 지식이나 기술을 가진 자(예. 안전관리자, 방화관리자 등)나 내진 전문가 등으로 지정한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-011",
      "text": "안전부서나 공무부서 등의 직원을 점검 담당자로 지정하고, 전문지식이나 기술이 필요한 경우 전문 업체에 의뢰한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-012",
      "text": "사업장 주변 지역의 위험(지반의 연약성, 해일위험, 건물 내진 특성 등)에 대한 위험지도(Hazard Map)를 작성·관리한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-013",
      "text": "건축법 등 내진설계기준이 적용되어 있는 건축·시설물에 대해서는 내진기준에 따라 건축되었는지를 미리 확인하고, 내진여부가 불확실하거나 구조적으로 취약한 건물은 내진성능평가를 실시할 필요가 있다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-014",
      "text": "내진성능평가 결과에 따라 필요한 경우 내진 보강을 실시한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-015",
      "text": "근로자가 상시 작업하는 장소와 피난장소, 업무상 중요한 장소 등은 우선적으로 내진보강을 한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-016",
      "text": "건물의 기초, 기둥, 벽 등의 노후정도와 변형·균열 등을 점검하고 취약부분을 보강한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-017",
      "text": "산업설비 및 중량물, 간판이나 조명기구 등 지진에 의해 흔들려 이동하거나, 떨어질 수 있는 물체는 흔들림이 없도록 확히 고정한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-G125-018",
      "text": "사업장 주변의 붕괴위험이 있는 자연사면에 대해서도 미리 점검하고, 필요한 경우 위험방지조치를 한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-G125-019",
      "text": "깨지기 쉬운 유리는 강한 유리로 교체하거나, 투명필름이나 테이프를 붙이는 등 깨졌을 때 비산하지 않도록 조치한다.",
      "guideContext": "사업장 지진대비 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "건축물·설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-020",
      "text": "위험물을 저장·취급하는 사업장에서는 위험물의 누출 시 확대 방지 조치, 회수 방법, 화재 등의 2차 재해 방지 조치, 기자재 준비와 조달 방법 등을 미리 준비해 둔다.",
      "guideContext": "위험물 저장·취급 설비 점검",
      "additionalDetail": null,
      "workProcessPhase": "위험물 설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-021",
      "text": "위험물질을 다량 저장·취급하는 화학공장은 비상 시 사고피해 최소화를 위한 비상조치계획을 수립·시행한다.",
      "guideContext": "위험물 저장·취급 설비 점검",
      "additionalDetail": "비상조치계획 수립에 관한 사항은 KOSHA GUIDE P-101 참조",
      "workProcessPhase": "위험물 설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-022",
      "text": "고인화성·고독성물질 취급 설비, 노후 화학설비, 지반침하 및 붕괴우려 설비, 국가기간산업(발전설비) 관련설비 등은 내진성능 등 지진영향 대비 정밀 점검을 실시한다.",
      "guideContext": "위험물 저장·취급 설비 점검",
      "additionalDetail": null,
      "workProcessPhase": "위험물 설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-023",
      "text": "위험물 저장·취급량, 설비특성을 고려하여 위험물의 누출 시 신속한 제거를 위하여 흡이나 흡착제·중화제 등을 충분히 준비해 둔다.",
      "guideContext": "위험물 저장·취급 설비 점검",
      "additionalDetail": null,
      "workProcessPhase": "위험물 설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-024",
      "text": "비상 시 사업장의 위험물을 인근 위험물 설비로 이송이 가능하도록 다른 사업장 또는 기관과의 협력 체제를 구축해 둔다.",
      "guideContext": "위험물 저장·취급 설비 점검",
      "additionalDetail": null,
      "workProcessPhase": "위험물 설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-025",
      "text": "위험물 저장·취급 설비의 방유제, 배수로, 유분리조 등이 손상됐을 경우의 대응책도 미리 강구해야 한다.",
      "guideContext": "위험물 저장·취급 설비 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험물 설비 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-026",
      "text": "현장 내 지진 취약 요인에 대하여 위험지도(Hazard Map)를 작성·관리한다.",
      "guideContext": "건설공사 현장 점검",
      "additionalDetail": null,
      "workProcessPhase": "건설공사 현장 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-027",
      "text": "조립 또는 임시로 거치되어 있는 교량 PC부재, 철골 부재 등의 전도·낙하 위험에 대한 안전성 여부를 상시 점검하고 보완한다.",
      "guideContext": "건설공사 현장 점검",
      "additionalDetail": null,
      "workProcessPhase": "건설공사 현장 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-G125-028",
      "text": "비계 등은 기둥 및 띠장·장선 간격을 준수하고, 특히 벽이음의 가로·세로 간격이 5미터를 유지하고 있는지 점검한다.",
      "guideContext": "건설공사 현장 점검",
      "additionalDetail": null,
      "workProcessPhase": "건설공사 현장 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-029",
      "text": "중량물 등 지진에 의해 흔들려 이동하거나, 떨어질 수 있는 물체는 흔들림이 없도록 확실히 고정한다.",
      "guideContext": "건설공사 현장 점검",
      "additionalDetail": null,
      "workProcessPhase": "건설공사 현장 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-G125-030",
      "text": "대수선을 수반하는 리모델링 공사의 경우 잭서포트 등의 보강 시 상하부를 앵커처리하여 지진하중에 따른 수평하중 안전성을 확보한다.",
      "guideContext": "건설공사 현장 점검",
      "additionalDetail": null,
      "workProcessPhase": "건설공사 현장 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-031",
      "text": "터널 막장면 및 천단부의 균열, 절리에 대한 지질 조사(Face Mapping) 시 지진 발생을 고려하여 안전 시공 및 관리대책을 이행한다.",
      "guideContext": "건설공사 현장 점검",
      "additionalDetail": null,
      "workProcessPhase": "건설공사 현장 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-032",
      "text": "흙막이 굴착면의 경우 낙하위험이 있는 토석을 제거하고 버팀보 등에 적치한 자재의 양단이 충분한 걸침상태가 유지되도록 관리한다.",
      "guideContext": "건설공사 현장 점검",
      "additionalDetail": null,
      "workProcessPhase": "건설공사 현장 점검 및 보강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5.4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-G125-033",
      "text": "지진 직후 사업장 내 또는 인근에 임시 대피할 수 있는 안전한 장소를 지정해 둔다.",
      "guideContext": "대피장소 및 피난경로 지정",
      "additionalDetail": null,
      "workProcessPhase": "대피장소 및 피난경로 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-034",
      "text": "지진에 의해 화재가 발생하는 등 사업장 주위가 위험에 처했을 때 피난할 수 있는 안전한 공터를 지정해 둔다.",
      "guideContext": "대피장소 및 피난경로 지정",
      "additionalDetail": null,
      "workProcessPhase": "대피장소 및 피난경로 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-035",
      "text": "임시 대피장소 및 피난장소까지 이동할 수 있는 경로를 여러 가지로 정해둔다.",
      "guideContext": "대피장소 및 피난경로 지정",
      "additionalDetail": null,
      "workProcessPhase": "대피장소 및 피난경로 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-036",
      "text": "피난 담당 책임자와 피난유도자는 사전에 피난 장소와 피난 경로를 직접 확인해 둔다.",
      "guideContext": "대피장소 및 피난경로 지정",
      "additionalDetail": null,
      "workProcessPhase": "대피장소 및 피난경로 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-037",
      "text": "복도와 출입구 주변에는 통행에 장애가 되는 캐비넷 등의 물건을 쌓아두거나 방치하지 않는다.",
      "guideContext": "대피장소 및 피난경로 지정",
      "additionalDetail": null,
      "workProcessPhase": "대피장소 및 피난경로 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-038",
      "text": "지진 시에는 건물이 변형·파손되어 출입문 개방이 불가능해 질 수 있으므로, 미리 여러 가지 피난 경로를 정해둔다.",
      "guideContext": "대피장소 및 피난경로 지정",
      "additionalDetail": null,
      "workProcessPhase": "대피장소 및 피난경로 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-039",
      "text": "ABC 분말 소화기 등 소방대상물에 적합한 소화기를 비치한다.",
      "guideContext": "소화용구 준비 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "소화용구 준비 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-040",
      "text": "소화기 등은 지정된 장소에 상시 비치하고, 주변 물건의 전도·낙하 등으로 소화기를 사용하지 못하거나 쉽게 꺼낼 수 없는 장소에는 비치하지 않는다.",
      "guideContext": "소화용구 준비 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "소화용구 준비 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-041",
      "text": "소화기는 항상 사용이 가능하도록 정기적으로 점검을 해야 하며, 소화기 점검은 방화관리자 등 유자격자가 실시한다.",
      "guideContext": "소화용구 준비 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소화용구 준비 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-042",
      "text": "지진에 의한 피해를 가상한 시나리오를 참조하여 훈련을 실시한다.",
      "guideContext": "지진 대비 교육 및 훈련",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-043",
      "text": "안전점검의 날 등을 활용하여 전 근로자가 참여하여 지진 대비 훈련을 정기적으로 실시한다.",
      "guideContext": "지진 대비 교육 및 훈련",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-044",
      "text": "지진 시 기본적인 업무를 반복 훈련하는 등 근로자가 각각의 임무를 숙지하고 책임을 몸으로 익히도록 해야 한다.",
      "guideContext": "지진 대비 교육 및 훈련 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-045",
      "text": "지진으로 인한 흔들림을 느끼면 모든 근로자들은 당황하지 않고 개인마다 본인의 안전을 최우선으로 행동한다.",
      "guideContext": "지진 발생 시 행동 요령",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-046",
      "text": "지진 발생 시 크게 흔들리는 시간은 길어야 1~2분이므로, 이 시간동안 테이블 등의 밑으로 들어가 몸을 피하고 테이블 등이 없을 때는 방석 등으로 머리를 보호한다.",
      "guideContext": "지진 발생 시 행동 요령",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-047",
      "text": "여진은 지진보다 진동은 작지만 지진에 취약해진 건물에 치명적인 손상을 줄 수 있으므로 모든 활동 시 여진에 철저히 대비해야 한다.",
      "guideContext": "지진 발생 시 행동 요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-048",
      "text": "독성가스 누출, 건물 붕괴, 화재·폭발 위험이 있는 경우에는 우선 안전한 공간으로 긴급 대피한다. 단, 지하층으로 대피해서는 안 된다.",
      "guideContext": "지진 발생 시 행동 요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-049",
      "text": "문을 열어서 출구를 확보하고 전기·가스 등을 차단한다.",
      "guideContext": "지진 발생 시 행동 요령",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-050",
      "text": "지진 발생 때는 유리창이나 간관 등이 떨어져 대단히 위험하므로 서둘러서 밖으로 뛰어 나가면 안 된다.",
      "guideContext": "지진 발생 시 행동 요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-051",
      "text": "지진 시에 화재가 발생할 때는 엘리베이터를 사용하지 말아야 하고, 타고 있을 때는 긴급 버튼을 눌러 신속하게 내린 후 대피한다. 만일 갇혔을 때는 인터폰으로 구조를 요청한다.",
      "guideContext": "지진 발생 시 행동 요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-052",
      "text": "큰 진동이 멈춘 후 공터나 공원 등 넓은 공간으로 대피한다. 또한 블록담이나 고정되지 않은 물건 등은 넘어질 우려가 있으므로 가까이 가서는 안 된다.",
      "guideContext": "지진 발생 시 행동 요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지진 발생 시 즉시 행동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-053",
      "text": "안전보건총괄책임자 주관하에 상황관단회의를 통해 비상대응여부를 판단한다.",
      "guideContext": "지진 관련 정보수집 및 전달",
      "additionalDetail": null,
      "workProcessPhase": "상황 전파 및 정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-054",
      "text": "재난문자, 재난방송(TV, 라디오), 인터넷, 소방청, 기상청 등을 통해 지진 상황을 파악한다.",
      "guideContext": "지진 관련 정보수집 및 전달",
      "additionalDetail": null,
      "workProcessPhase": "상황 전파 및 정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-055",
      "text": "비상대응 활동을 수행하는 근로자는 반드시 개인보호장구 및 개인 통신장비를 착용해야 한다.",
      "guideContext": "지진 관련 정보수집 및 전달 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상황 전파 및 정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-056",
      "text": "각 비상대응 책임자는 비상대응 초기, 활동 중, 종료 시 조원에 대한 인원 점검을 실시하고, 비상연락망을 통해 이상 유무를 수시로 파악한다.",
      "guideContext": "지진 관련 정보수집 및 전달",
      "additionalDetail": null,
      "workProcessPhase": "상황 전파 및 정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-057",
      "text": "지진의 진동이 멈추면 조정실 근무자는 비상용 유선전화 등을 이용하여 상황실에 지진발생 및 지진으로 인한 영향을 통보하여야 한다.",
      "guideContext": "석유화학공장 지진 상황 전파 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상황 전파",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-058",
      "text": "상황실 근무자는 지진강도가 중진 이상으로 관정된 경우, 비상경보시스템을 이용하여 생산·공무부서에 지진발생 여부 및 지진강도를 통보하여야 한다.",
      "guideContext": "석유화학공장 지진 상황 전파 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상황 전파",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-059",
      "text": "상황실로부터 지진상황을 접수한 생산부서는 통보받은 지진강도를 페이징 등을 이용하여 소속된 운전원, 작업자 및 협력업체 직원에게 알려야 한다.",
      "guideContext": "석유화학공장 지진 상황 전파 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상황 전파",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-060",
      "text": "상황실로부터 지진강도를 통보받은 생산부서는 점검항목을 포함하는 외관점검을 신속히 실시하여, 이상이 발견되면 필요시 응급조치를 실시하고 점검결과 및 조치내용을 상황실에 통보한다.",
      "guideContext": "석유화학공장 설비 점검",
      "additionalDetail": null,
      "workProcessPhase": "외관점검 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-061",
      "text": "공무부서에서는 생산부서의 외관점검 결과를 확인하고, 설비점검 항목표를 참조하여 관할지역 설비에 대한 정밀점검을 실시하며, 그 결과를 생산부서에 다시 통보하여야 한다.",
      "guideContext": "석유화학공장 정밀점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정밀점검 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-062",
      "text": "생산부서는 공무부서의 정밀점검결과와 이상이 있을 시 적절한 임시 보수 등 조치를 취하고, 조치내용에 대하여 상황실에 통보하여야 한다.",
      "guideContext": "석유화학공장 정밀점검 결과 조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정밀점검 결과 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-063",
      "text": "비상경보시스템이 설치되어 있지 않은 부서에서는 상황실로부터의 통보가 없더라도 지진강도가 \"Ⅳ\" 이상이라 판단되면 인력 및 건물 등 관할설비에 대해 점검을 실시하고 그 결과를 상황실에 통보하여야 한다.",
      "guideContext": "석유화학공장 기타 부서 조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "외관점검 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-064",
      "text": "생산부서에서는 외관점검 또는 정밀점검 결과, 공정운전을 중단할 필요가 있다고 판단되면, 공장 비상정지 기준에 따라 공정운전을 중단하고, 이를 상황실에 통보하여야 한다.",
      "guideContext": "석유화학공장 비상정지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 및 비상정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-065",
      "text": "공장을 비상 정지를 한 경우 기타 응급조치 완료 후 공정 재가동시에는 가동전 안전점검을 실시하여야 한다.",
      "guideContext": "석유화학공장 비상정지 후 재가동 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE P-97 '가동전 안전점검에 관한 기술지침' 참조",
      "workProcessPhase": "비상대응 및 비상정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-066",
      "text": "상황실 근무자는 화재 및 폭발, 가스누출, 해상누유, 건물붕괴 등의 사고가 발생한 경우, 안전부서에 통보하여 비상경보시스템 및 동시통보시스템을 가동하여 비상대응인력을 동원한다.",
      "guideContext": "석유화학공장 비상대응",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 및 비상정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-067",
      "text": "공장별, 공정별 및 설비별로 비상 시 정지순서 등 가동정지 절차를 작성하여 비치한다.",
      "guideContext": "전 공장 가동정지",
      "additionalDetail": null,
      "workProcessPhase": "전 공장 가동정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-068",
      "text": "외관점검 결과 지진으로 인한 손상이 발생하였거나, 2차 피해가 예상되는 설비는 즉시 가동을 정지한다.",
      "guideContext": "전 공장 가동정지",
      "additionalDetail": null,
      "workProcessPhase": "전 공장 가동정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-069",
      "text": "피해가 없더라도 가동을 지속할 경우 해당 설비 또는 주변 지역에 피해가 예상되는 설비는 가동 정지 여부를 판단하여 가동을 정지한다.",
      "guideContext": "전 공장 가동정지",
      "additionalDetail": null,
      "workProcessPhase": "전 공장 가동정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G125-070",
      "text": "가동 정지 시 오히려 위험한 상황을 초래하거나 다른 설비에도 영향을 미칠 수 있으므로 신중하게 가동을 정지한다.",
      "guideContext": "전 공장 가동정지",
      "additionalDetail": null,
      "workProcessPhase": "전 공장 가동정지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G125-001",
      "term": "지진(Earthquake)",
      "definition": "지구 내부, 특히 지각에서 장시간 축적된 에너지가 순간적으로 방출되면서 그 에너지의 일부가 지진파의 형태로 지표면까지 도달하여 지반이 흔들리는 자연현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-002",
      "term": "지진파(Seismic Wave)",
      "definition": "지진이 일어난 곳을 중심으로 진동이 사방으로 전달되는 파동 현상을 말하며, 지진파는 P파(Primary Wave, 종파)와 S파(Secondary Wave, 황파)로 구분되며, P파가 S파보다 빠르게 전달된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-003",
      "term": "진원(Earthquake focus)",
      "definition": "지구 내부에서 지진이 발생한 장소, 즉 지진이 발생한 원점을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-004",
      "term": "진앙(Epicenter)",
      "definition": "지진이 발생한 원점에서 수직으로 상부 가장 가까운 지표면을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-005",
      "term": "규모(Magnitude)",
      "definition": "지진의 강도를 나타내는 절대적 개념의 단위로, 지진 발생 시 방출되는 에너지의 양을 나타내는 척도를 말하며, 리히터 스케일(Richter scale)이라고도 한다. 보통 규모 1이 증가할 때 이에 해당하는 에너지가 32배 증가한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-006",
      "term": "진도(Intensity)",
      "definition": "지진의 크기를 나타내는 상대적 개념의 단위로 사람이 느끼는 지진의 정도와 건물의 피해 정도를 기준으로 나타낸다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-007",
      "term": "비상경보시스템",
      "definition": "사업장내 비상사태 발생 시 전 근로자들에게 사고상황 전파 및 자위소방대원 출동 지시를 위하여 설치된 시스템을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-008",
      "term": "외관점검",
      "definition": "중대사고의 징후를 발견하기 위하여 단시간에 공장 전체의 외관을 확인하는 개략적인 점검을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-009",
      "term": "정밀점검",
      "definition": "중대사고 또는 2차 재해로 확산될 수 있는 경미한 누설, 이상한 소음, 설비의 손상 등을 발견하기 위하여 외관점검 후 공장 전역에 걸쳐 실시하는 점검을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-010",
      "term": "내진 대상 시설물",
      "definition": "지진·화산재해대책법 제14조(내진설계기준의 설정)에 따라 정한 시설물로 건축물, 액화지장탱크, 위험기계·기구·설비, 송유관, 원자력설비 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-011",
      "term": "내진성능평가(Seismic capacity evaluation)",
      "definition": "기존 건축물 등을 대상으로 내진전문가(구조기술사 등)가 정밀진단을 통하여 내진 성능여부를 평가하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G125-012",
      "term": "위험지도(Hazard Map)",
      "definition": "지진 발생 시 붕괴등 위험이 있는 설비에 표시하여 미리 위험을 알리는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
