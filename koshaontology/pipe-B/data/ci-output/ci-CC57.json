  "checklistItems": [
    {
      "identifier": "CI-CC57-001",
      "text": "다음은 산업안전보건법령에 관한 사항으로써 반드시 준수하여야 한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조(공정안전보고서의 세부 내용 등)에 따른 안전운전계획 내 자체감사 및 사고조사계획 포함",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-002",
      "text": "사고가 발생하면 사고조사반을 구성하여 사고조사를 수행한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사반 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-003",
      "text": "사고조사반은 다음 전문가 2인 이상으로 구성한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": "사고 공정 담당자, 기술지식과 실무경험을 가진 기술자, 외부 전문가",
      "workProcessPhase": "사고조사반 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-004",
      "text": "사고 원인조사, 피해, 사고교훈 및 동종 재해예방대책을 포함한 [부록] 양식에 따른 사고조사 보고서 작성",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": "사고조사반의 임무",
      "workProcessPhase": "보고서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-005",
      "text": "사고조사는 사고현장의 상황과 세밀한 부분이 변형되기 전에 실시",
      "guideContext": "중대산업사고 조사",
      "additionalDetail": null,
      "workProcessPhase": "현장조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-006",
      "text": "사고현장 실태를 분야별로 미세한 부분에서부터 점차 확대하여 조사하고, 이를 연결 조합하여 중요한 부분에 대해서는 중점 확대 재조사",
      "guideContext": "중대산업사고 조사",
      "additionalDetail": null,
      "workProcessPhase": "현장조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-007",
      "text": "사고와 관련된 물적 자료를 철저하게 조사·수집하고 필요시 재료시험을 실시",
      "guideContext": "중대산업사고 조사",
      "additionalDetail": null,
      "workProcessPhase": "현장조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-008",
      "text": "사고현장의 상황을 종합적으로 검토하기 위한 사진촬영",
      "guideContext": "중대산업사고 조사",
      "additionalDetail": null,
      "workProcessPhase": "현장조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-009",
      "text": "목격자, 책임자 및 피해자 등 관련자의 협조를 얻어 조사",
      "guideContext": "중대산업사고 조사",
      "additionalDetail": null,
      "workProcessPhase": "현장조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-010",
      "text": "사고원인이 파악되면 이를 제거하기 위한 권고사항을 준비하여 재해예방 대책에 포함시켜야 하며, 권고사항 작성시 고려할 사항은 다음과 같다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": "시스템 근본원인 문제해결, 개선사항 명확 언급, 실행 가능 방안, 피해결과 감소방안, 목표 완료날짜, 수행책임자 지명, 변경과정 관리·분석",
      "workProcessPhase": "권고사항 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-011",
      "text": "사고 조사보고서에서 지적되고 권고된 개선사항들은 반드시 검토되어 시행될 수 있도록 한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보고서 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-012",
      "text": "개선사항에 대한 검토와 시행은 문서화 시킨다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보고서 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-013",
      "text": "사고 조사보고서가 작성되면 사고원인, 분석내용, 사고교훈 및 동종재해 예방대책을 모든 작업자에게 알리고 교육을 실시한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보고서 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-014",
      "text": "사고 조사보고서는 5년 이상 보관한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보고서 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-015",
      "text": "사고원인은 직접원인, 선행원인 및 간접원인으로 구분하여 작성한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": "직접원인(불안전한 상태, 불안전한 행동), 선행원인(안전보건교육, 관리적 사항, 작업표준 또는 작업절차, 안전보건수칙, 공정안전관리분야 등), 간접원인(법 위반사항 등)",
      "workProcessPhase": "보고서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-016",
      "text": "사고의 근본원인 분석에 의한 사고원인 흐름도(발생원, 조직분류, 설비결함, 대분류, 소분류, 근본원인)를 작성한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보고서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-017",
      "text": "사고로부터 얻은 교훈을 작성하고, 안전관리 강화, 교육훈련 및 화재 진압설비의 보완 등 향후 개선조치내용과 사고 재발방지대책을 구체적으로 작성하며, 사고로 인하여 타산업에 미치는 영향도 조사하여 기재한다.",
      "guideContext": "중대산업사고 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보고서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC57-018",
      "text": "사고당시의 사고현장 및 사고발생 설비의 사진 등 특별히 보관할 필요가 있는 것은 사고 보고서와 함께 보관한다.",
      "guideContext": "중대산업사고 조사",
      "additionalDetail": null,
      "workProcessPhase": "보고서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "11",
      "basedOn": null
    }
  ],
  "domainTerms": [
