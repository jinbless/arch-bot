  "checklistItems": [
    {
      "identifier": "CI-X72-001",
      "text": "계층적 작업분석을 통해 휴먼에러의 체계적 예측 및 저감 방법의 대상이 될 작업과 시스템에 대해 철저하게 분석하여 기술한다.",
      "guideContext": "SHERPA 단계 1: 계층적 작업분석",
      "additionalDetail": null,
      "workProcessPhase": "계층적 작업분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-002",
      "text": "작업을 목표에 따라 여러 개의 세부 작업들로 구분하고, 필요한 경우 세부 작업들을 다시 더 작은 작업들로 나누는 과정을 반복한다.",
      "guideContext": "SHERPA 단계 1: 계층적 작업분석 세부절차",
      "additionalDetail": null,
      "workProcessPhase": "계층적 작업분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-003",
      "text": "계층적 작업분석의 최하위 수준에 있는 작업들을 행동에 따라 분류한다.",
      "guideContext": "SHERPA 단계 2: 작업 분류",
      "additionalDetail": "행동 분류체계(행위, 정보확인, 점검, 선택, 정보전달)를 활용",
      "workProcessPhase": "작업 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-004",
      "text": "단계 2의 행동 분류 결과에 따라 발생 가능한 에러의 형태를 확인한다.",
      "guideContext": "SHERPA 단계 3: 휴먼에러 확인",
      "additionalDetail": "에러 형태 분류체계(A1~A10, R1~R3, C1~C6, S1~S2, I1~I3)를 활용",
      "workProcessPhase": "휴먼에러 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-005",
      "text": "발생 가능한 것으로 판정된 각각의 에러에 대해 에러에 대한 설명을 제시한다. 에러에 대한 설명은 명확하고 간결해야 한다.",
      "guideContext": "SHERPA 단계 3: 휴먼에러 확인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "휴먼에러 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-006",
      "text": "각각의 발생 가능한 에러에 대해 작업에 관련된 결과를 명확하게 기술한다.",
      "guideContext": "SHERPA 단계 4: 결과 분석",
      "additionalDetail": null,
      "workProcessPhase": "결과 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-007",
      "text": "에러가 발생한 후 관련된 결과를 방지하기 위해 취할 수 있는 복구 방법에 대해 기술한다.",
      "guideContext": "SHERPA 단계 5: 복구 방법 분석",
      "additionalDetail": null,
      "workProcessPhase": "복구 방법 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-008",
      "text": "해당 에러에 대한 복구 방법을 확인할 수 없는 경우, '없음'을 명시한다.",
      "guideContext": "SHERPA 단계 5: 복구 방법 분석",
      "additionalDetail": null,
      "workProcessPhase": "복구 방법 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-009",
      "text": "에러의 발생 확률을 서수적으로 평가한다.",
      "guideContext": "SHERPA 단계 6: 서수적 발생 확률 분석",
      "additionalDetail": "'낮음', '중간', '높음'의 3단계 서수척도 사용",
      "workProcessPhase": "서수적 발생 확률 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-010",
      "text": "에러의 결과가 얼마나 치명적인 영향을 갖는지에 대해 평가한다.",
      "guideContext": "SHERPA 단계 7: 치명도 분석",
      "additionalDetail": "'낮음', '중간', '높음'의 3단계 서수 척도 사용",
      "workProcessPhase": "치명도 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-011",
      "text": "에러를 저감시키기 위한 방법을 제시한다. 개선방안은 일반적으로 공정이나 시스템의 설계에 대한 변경을 포함한다.",
      "guideContext": "SHERPA 단계 8: 개선방안 제시",
      "additionalDetail": "장비, 훈련, 절차, 조직의 4가지 범주 포함",
      "workProcessPhase": "개선방안 제시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-X72-012",
      "text": "분석 결과는 미리 정한 양식에 따라 기록지(부록 1 참조)에 기록한다.",
      "guideContext": "SHERPA 수행 절차 총괄",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-X72-001",
      "term": "휴먼에러(Human error)",
      "definition": "의도치 않게 시스템의 효율, 안전, 성능 등을 저해할 수 있는 부적절하거나 바람직하지 않은 인간의 행동 또는 의사결정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X72-002",
      "term": "작업(Task)",
      "definition": "시스템의 목적이나 기능을 달성하기 위한 인간 행동의 단위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X72-003",
      "term": "계층적 작업분석(Hierarchical task analysis)",
      "definition": "작업을 목표에 따라 여러 개의 세부작업들로 나누고 이 세부작업들을 다시 더 작은 작업들로 나누는 과정을 반복함으로써 작업구조를 계층형태로 상세하게 표현하는 분석 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X72-004",
      "term": "결과(Consequence)",
      "definition": "휴먼에러가 발생함으로써 야기되는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
