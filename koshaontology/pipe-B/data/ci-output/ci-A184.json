  "checklistItems": [
    {
      "identifier": "CI-A184-001",
      "text": "산을 취급할 때에는 보호장갑, 실험복 및 보안경을 착용하고 숙련된 작업자와 적절한 환기가 필요하다.",
      "guideContext": "인산 시료채취 시 안전보건 예방조치",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A184-002",
      "text": "격렬한 발열반응을 피하기 위하여 산을 천천히 섞어야 한다.",
      "guideContext": "인산 시료채취 시 안전보건 예방조치 (법령 근거 미확인)",
      "additionalDetail": "인산은 염기, 가연성물질, 산화제, 환원제, 또는 물과 접촉 시 화재와 폭발의 위험이 있다.",
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-003",
      "text": "각 개인 시료채취펌프를 하나의 대표적인 시료채취매체와 연결하여 보정한다.",
      "guideContext": "인산 시료채취 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-004",
      "text": "시료 세트 당 최소 3개의 현장 공시료를 준비하고 채취한 시료와 동일한 방식으로 처리한다.",
      "guideContext": "인산 시료채취 품질관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-005",
      "text": "시료를 바로 실험실로 보낼 수 없는 경우 냉장보관하여야 한다.",
      "guideContext": "인산 시료 운반 및 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-006",
      "text": "시료를 수령한 후 4주 이내 분석을 실시한다.",
      "guideContext": "인산 시료 보관 안정성 (법령 근거 미확인)",
      "additionalDetail": "시료의 안정성: 20℃에서 1주일간 안정, 4℃에서 28일간 안정함",
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-007",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급이상의 것을 사용하여야 한다.",
      "guideContext": "인산 측정·분석 시약 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-008",
      "text": "광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의해야 하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.",
      "guideContext": "인산 측정·분석 시약 순도 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-009",
      "text": "계량기구 중 측정값을 분석결과의 계산에 사용할 목적으로 사용되는 것은 모두 보정하는 것을 원칙으로 한다.",
      "guideContext": "인산 측정·분석 기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-010",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 칭량할 수 있어야 하며, 화학 분석용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 칭량할 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "인산 측정·분석 기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-011",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 한국산업규격 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "인산 측정·분석 기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-012",
      "text": "표준용액, 회수율 등에 사용되는 시약은 같은 롯트(Lot)번호를 가진 것을 사용하여야 한다.",
      "guideContext": "인산 측정·분석 검량선 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-013",
      "text": "회수율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다.",
      "guideContext": "인산 측정·분석 회수율 검정 (법령 근거 미확인)",
      "additionalDetail": "회수율간의 차이가 크고 변이가 심하여 일정성이 없으면 정확한 보정이 될 수가 없다. 따라서 그 원인을 찾아 교정하고 다시 실험을 실시해야 한다.",
      "workProcessPhase": "회수율 검정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-014",
      "text": "노출기준과 비교 시는 작업환경 측정 시의 온도와 압력을 실측하여 정상상태의 농도로 환산하여야 한다.",
      "guideContext": "인산 측정·분석 농도 환산 (법령 근거 미확인)",
      "additionalDetail": "정상상태(NTP): 25℃, 1기압",
      "workProcessPhase": "농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-015",
      "text": "제조한 표준용액은 폴리에틸렌 용기에 넣고 단단히 밀폐시킨다. 표준용액은 매주 새로운 용액으로 준비하여야 한다.",
      "guideContext": "인산 분석 검량선 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성 및 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-016",
      "text": "시료, 시약 공시료, 현장 공시료를 20개 분석할 때마다 최소 3개의 표준시료를 같이 분석한다.",
      "guideContext": "인산 분석 품질관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성 및 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-017",
      "text": "사용 전 보호장갑, 방독마스크, 실험복 등의 보호구를 착용해야 하며, 실험 시 화재가 발생하지 않도록 주의해야 한다.",
      "guideContext": "인산 취급 시 건강영향 예방조치",
      "additionalDetail": "호흡기, 피부접촉, 눈 접촉 등을 통해 흡수되며, 눈, 상기도에 자극을 줄 수 있다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A184-018",
      "text": "표백제 또는 암모니아를 함유한 용액과 혼합해서는 안 된다.",
      "guideContext": "인산 취급 시 건강영향 예방조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-A184-019",
      "text": "노출기준/허용기준이 호흡성/흉곽성/흡입성으로 설정된 경우 해당 시료채취기를 사용하고 그에 설정된 유량을 적용하여야 함",
      "guideContext": "인산 시료채취 매체 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A184-001",
      "term": "밀폐",
      "definition": "취급 또는 보관 상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A184-002",
      "term": "밀봉",
      "definition": "취급 또는 보관 상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A184-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A184-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ± 10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A184-005",
      "term": "즉시",
      "definition": "30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A184-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A184-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A184-008",
      "term": "회수율",
      "definition": "채취한 유기화합물 등의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 매체에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-A184-01",
      "processOrder": 1,
      "processName": "시료채취 기구 선정 및 검량선 준비",
      "safetyMeasures": "시료채취의 목적과 시료채취시간, 방해인자, 예상되는 오염농도 및 분석장비의 능력 등을 종합적으로 고려하여 최적의 시료채취기구 및 분석방법을 선택한다. 충분한 수의 표준용액을 준비하고, 최소한 5개 수준의 표준용액을 제조한다.",
      "requiredPPE": [
        "보호장갑",
        "실험복",
        "보안경"
      ],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-A184-02",
      "processOrder": 2,
      "processName": "시료채취",
      "safetyMeasures": "개인시료채취펌프를 시료채취매체와 연결하여 보정 후 1~5 L/min 유량으로 총 15~1000 L 공기를 채취한다. 채취 후 PTFE 코팅된 핀셋으로 여과지를 플라스틱 용기로 옮기고 추출용액 5 mL로 처리한다. 시료 세트 당 최소 3개의 현장 공시료를 준비한다. 시료는 냉장 상태로 운반한다.",
      "requiredPPE": [
        "보호장갑",
        "실험복",
        "보안경"
      ],
      "sourceSection": "6.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-A184-03",
      "processOrder": 3,
      "processName": "시료 전처리",
      "safetyMeasures": "시료 용기를 상온조건으로 옮긴 후 초음파 세척기에서 15분 이상 처리하고 30분 이상 식힌다. PTFE 재질의 실린지 여과지를 이용하여 추출용액을 여과하여 오토샘플러 바이알에 담는다.",
      "requiredPPE": [
        "보호장갑",
        "실험복",
        "보안경"
      ],
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-A184-04",
      "processOrder": 4,
      "processName": "검량선 작성 및 이온크로마토그래피 분석",
      "safetyMeasures": "용리액으로 표준원액을 희석하여 최소 5개 표준물질로 검량선을 작성한다. 이온크로마토그래피를 제조회사 권고에 따라 설정하고 시료를 주입하여 피크 높이 또는 피크면적을 측정한다. 피크가 검량선 범위를 초과하면 희석 후 재분석한다.",
      "requiredPPE": [
        "보호장갑",
        "실험복",
        "보안경"
      ],
      "sourceSection": "6.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-A184-05",
      "processOrder": 5,
      "processName": "농도 계산",
      "safetyMeasures": "C = [(C₁V₁Fd) - (C₀V₀)] / V × Fc 공식을 적용하여 분석물질의 농도(mg/m³)를 산출한다. 음이온에서 산농도로의 변환계수 Fc=1.031을 적용한다. 노출기준 비교 시 NTP(25℃, 1기압) 기준으로 환산한다.",
      "requiredPPE": [],
      "sourceSection": "6.4",
      "relatedSR": null
    }
  ],
  "equipmentSpecs": [
    {
      "identifier": "ES-A184-001",
      "equipmentName": "시료채취매체",
      "specifications": {
