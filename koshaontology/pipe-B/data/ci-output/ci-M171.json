  "checklistItems": [
    {
      "identifier": "CI-M171-001",
      "text": "작업자가 작업영역에 들어가기 전에 주요한 안전잠금장치가 올바르게 작동을 하는지 확인하여야 한다.",
      "guideContext": "자동차 정비용 리프트 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-M171-002",
      "text": "리프트의 정격하중을 초과하지 말아야 한다.",
      "guideContext": "자동차 정비용 리프트 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-003",
      "text": "시멘트 앵커 볼트가 느슨하거나 리프트의 구성요소에 결함이 있거나 마모가 발견된 경우 리프트를 사용하여서는 안 된다.",
      "guideContext": "자동차 정비용 리프트 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-004",
      "text": "리프트 아래에 사람이나 장비가 있는 경우 리프트를 작동하여서는 안 된다.",
      "guideContext": "자동차 정비용 리프트 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-005",
      "text": "작업자는 리프트를 내리거나 올릴 때에는 2 m 이상의 안전거리를 유지해야 한다.",
      "guideContext": "자동차 정비용 리프트 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-006",
      "text": "리프트를 모든 안전잠금장치가 작동하지 않은 상승된 상태로 두지 말아야 한다.",
      "guideContext": "자동차 정비용 리프트 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-M171-007",
      "text": "잭 스탠드 또는 다른 하중지지 장치를 적절하게 사용한다.",
      "guideContext": "자동차 정비용 리프트 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-008",
      "text": "차량을 들어올리기 전에 차량의 문, 트렁크, 보닛 등이 닫혀있는지 확인해야 한다.",
      "guideContext": "자동차 정비용 리프트 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-009",
      "text": "2주식 리프트는 평평한 표면에 구조적 안전성을 확인하여 설치되어야 한다.",
      "guideContext": "2주식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-010",
      "text": "차량을 들어올릴 때는 차량 제조자의 조언을 따라야 한다. 특히 큰 SUV(Sports utility vehicle)나 경량 화물차, 상업 밴을 들어 올릴 때에는 차량에 적절한 장비를 사용해야 한다.",
      "guideContext": "2주식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-011",
      "text": "차량 섀시와 섀시 잭 포인트가 확인 가능해야 하며 차량 잭포인트의 경우 문들에 있는 표시를 확인하고 만약 의심스러우면 항상 차량 안내서를 확인해야 한다.",
      "guideContext": "2주식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-012",
      "text": "차량을 들어올릴 때는 지지암 픽업패드가 사용가능한 상태여야 하며 필요한 경우 가령, 적재팔 때문에 차량 차체가 찌그러지는 것을 피하기 위해 차량을 들어올리기 전에 적절한 높이로 설정해야 한다.",
      "guideContext": "2주식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-013",
      "text": "적재팔은 매번 리프팅 이전에 조심스럽게 배치해야 하며 차량 제조자의 안내에 따라 진행해야 한다. 이는 올바른 중량 분배와 하중지지 지점에 올바르게 위치하게 함으로써 차량이 안정적 위치에 있도록 해야 한다.",
      "guideContext": "2주식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-014",
      "text": "차량의 하중 분배를 고려할 때에는 전면/후면 엔진 위치, 차량 내 하중, 엔진이나 기어박스와 같은 주요 부품의 위치를 고려해야 한다.",
      "guideContext": "2주식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-015",
      "text": "차량의 주요 부품 제거 또는 공구에 의해 가해지는 힘으로 인한 차량의 안정성에 미치는 영향을 고려해야 한다.",
      "guideContext": "2주식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-016",
      "text": "작업 전 적재팔의 암 고정장치가 제대로 작동하는 지 여부를 확인 하여야 한다.",
      "guideContext": "2주식 리프트 사용 안전",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-M171-017",
      "text": "리프트 작동중에는 작업자의 신체일부가 위험반경 내에 접근해서는 안 된다.",
      "guideContext": "4주식 리프트, 시저스 방식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-018",
      "text": "리프트를 사용하기 전에 바퀴 스토퍼, 고정장치 등의 안전장치가 정상적으로 작동하는 지를 확인해야 한다.",
      "guideContext": "4주식 리프트, 시저스 방식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-019",
      "text": "차량 아래에서 작업을 할 때에는 이동이 가능한 보조전등 등을 이용하여 작업자의 시야를 확보해야 한다.",
      "guideContext": "4주식 리프트, 시저스 방식 리프트 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 하부 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-020",
      "text": "들어 올릴 차량의 무게를 버틸 수 있는 잭이어야 하고 차량의 제조자가 명시한 밑면의 올바른 잭 포인트에 적용될 수 있는 적합한 잭을 사용해야 한다.",
      "guideContext": "잭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잭 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-021",
      "text": "잭을 사용하여 차축을 들어 올리는 경우에는 차량 하부에서 작업자가 작업을 하여서는 안 된다. 또한 적절한 지지대로 보조지지를 하여야 하며 바닥에 닿은 바퀴에 고임목 등을 설치하여야 한다.",
      "guideContext": "잭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잭 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-022",
      "text": "잭은 단단한 평지에서만 사용해야 한다.",
      "guideContext": "잭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잭 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-023",
      "text": "사용자는 잭이 올바른 작동을 할 수 있도록 정기점검과 유지보수를 해야 한다.",
      "guideContext": "잭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잭 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-024",
      "text": "사용자는 잭을 올바르게 사용할 수 있도록 잭의 사용에 관한 훈련 받아야 한다.",
      "guideContext": "잭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잭 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-025",
      "text": "짧은 휴대용 램프의 경우 차량을 정지된 위치에 유지하는 용도로 사용하여야 한다.",
      "guideContext": "램프 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "램프 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-026",
      "text": "긴 램프의 경우 차량을 놓은 수평 위치에 유지시키는 용도로 사용 하여야 한다.",
      "guideContext": "램프 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "램프 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-027",
      "text": "램프는 움직이는 부분이 없어야 하며 자체적으로 램프를 제조한 경우 바퀴 브레이크, 받침 등을 이용하여 안정성을 확보해야 한다.",
      "guideContext": "램프 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "램프 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-028",
      "text": "프롬의 일반적인 형태는 소도구로서 차체 지지대이거나 쇠막대이다. 프롬은 스탠드의 높이를 조절할 수 있는 핀이 함께 제공되는데 이 핀을 잃어버리거나 핀이 망가진 경우 해당 사양에 가장 잘 맞는 핀으로 교체해야 하며 드라이버, 볼트 등과 같이 적재 용량을 알 수 없는 것을 사용해서는 안 된다.",
      "guideContext": "프롭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프롭 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-029",
      "text": "프롬을 올바르게 사용하면 트롤리 잭과 같은 리프팅장치로 들어 올린 차량 밑에서 작업들이 더 안전하게 작업할 수 있다.",
      "guideContext": "프롭 사용 안전",
      "additionalDetail": null,
      "workProcessPhase": "프롭 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-030",
      "text": "여러 잭을 활용해 들어 올린 휠 프리 상황의 차량을 지지하는데 프롬을 사용할 수 있다. 프롬은 단단한 평면에서 사용해야 하며 프롬 위에 적재된 하중을 올바르게 운반할 수 있도록 설계되어야 한다.",
      "guideContext": "프롭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프롭 사용 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-031",
      "text": "차체 지지대의 구조와 안정성, 용접된 접이 부분을 중심으로 정기적으로 검사해야 한다.",
      "guideContext": "프롭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프롭 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-032",
      "text": "대형 수송차 운전석을 앞으로 기울이고 정비를 할 경우에는 프롬을 사용하여 보조지지를 하여야 한다. 프롬의 사용 전에는 프롬이 해당 위치에 고정되어 있어야 한다.",
      "guideContext": "프롭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-033",
      "text": "트럭의 적재함을 올리고 그 차량의 하부에서 정비작업을 하는 경우에는 프롬을 이용하여 효과적으로 지지시켜야 한다.",
      "guideContext": "프롭 사용 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 하부 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-034",
      "text": "엔진의 시동은 반드시 운전자가 운전석에 완전하게 탑승하여 핸드브레이크를 작동시키고 기어는 중립에 놓고 걸어야 한다.",
      "guideContext": "차량 시동 안전 (법령 근거 미확인)",
      "additionalDetail": "차량 밖에서 시동을 거는 등 절차를 따르지 않으면 리프트 등에서 차량이 떨어지거나 열린 문이 리프트 기둥을 치고 사람과 충돌하여 치명적인 부상을 야기 시킨다.",
      "workProcessPhase": "차량 시동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-035",
      "text": "차량의 이동 및 점검을 하는 작업자는 차량점검에 관한 모든 훈련. 운전면허, 정비 자격증 등을 갖춘 자 이어야 한다. 특히 고성능 차량의 경우에 더욱 주의를 해야 한다.",
      "guideContext": "차량 이동 및 점검 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 이동 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-036",
      "text": "차량을 사용하지 않을 때에는 자동차 키를 안전한 곳에 보관한다.",
      "guideContext": "차량 이동 및 점검 안전",
      "additionalDetail": null,
      "workProcessPhase": "차량 이동 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-037",
      "text": "제한된 공간이나 잘 보이지 않는 코너, 특히 후진할 경우에는 차량의 이동을 감독해야 한다.",
      "guideContext": "차량 이동 및 점검 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 이동 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-038",
      "text": "운전하는 작업자는 자동차운전면허를 받고 정비하는 차량의 운전에 익숙한 자이어야 한다.",
      "guideContext": "차량 이동 및 점검 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 이동 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-039",
      "text": "자동차정비용 리프트의 각 조작위치에 작동 시 모든 인양장치의 작동을 정지시키는 0정지방식의 비상정지장치가 정상으로 작동하는 지에 대하여 확인하여야 한다.",
      "guideContext": "리프트 안전장치 점검",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-M171-040",
      "text": "리프트 조작버튼의 가동유지방식으로 운영되는지 여부를 확인하여야 한다.",
      "guideContext": "리프트 안전장치 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-041",
      "text": "리프트의 하중인양장치의 과상승 방지를 위한 장치가 정상으로 작동하는 지에 대하여 확인하여야 한다.",
      "guideContext": "리프트 안전장치 점검",
      "additionalDetail": "확인 대상: (가) 하중인양장치를 직접 구동시키는 유압실린더의 오버플로우, (나) 기계 구동식 리프트장치의 리미트 스위치",
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-M171-042",
      "text": "리프트의 외함 및 철대의 전기절연 상태가 정상인 지에 대하여 확인하여야 한다.",
      "guideContext": "리프트 안전장치 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-043",
      "text": "차량이 리프트에서 떨어지는 것을 방지하기 위하여 바퀴 고임이나 멈춤장치가 정상으로 작동하는 지에 대하여 확인하여야 한다.",
      "guideContext": "리프트 안전장치 점검",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-M171-044",
      "text": "비상정지장치가 정상작동 되는 지 여부를 확인하여야 한다.",
      "guideContext": "리프트 안전장치 점검",
      "additionalDetail": null,
      "workProcessPhase": "리프트 사전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-M171-045",
      "text": "차량의 하부 공간에 정비 작업을 하는 때에는 차량의 상태와 지면의 상태를 확인해야 한다.",
      "guideContext": "차량 하부 작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 하부 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-046",
      "text": "차량을 잭 등으로 들어올린 경우에는 작업자가 차량 밑으로 들어가 정비작업을 하는 것을 금지해야 한다.",
      "guideContext": "차량 하부 작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 하부 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-047",
      "text": "해당 차량의 정비 부위와 차량 자체의 적합한 리프트를 선택하여 차량을 들어 올려야 한다.",
      "guideContext": "자동차정비용 리프트 선택",
      "additionalDetail": "2주식, 4주식, 단일, 3주식, 6주식 기둥, 시저스방식 리프트 중 선택",
      "workProcessPhase": "리프트 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-M171-048",
      "text": "해당 작업에 적합한 리프트의 선택이 어려울 때에는 리프트의 사용설명서를 참고해야 한다.",
      "guideContext": "자동차정비용 리프트 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-049",
      "text": "승인받은 사람 이외의 임의조작을 금지해야 한다.",
      "guideContext": "리프트 운전자 주의사항",
      "additionalDetail": null,
      "workProcessPhase": "리프트 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-010"
      ]
    },
    {
      "identifier": "CI-M171-050",
      "text": "정비 등의 작업 등 취급 시 사용설명서를 숙지해야 한다.",
      "guideContext": "리프트 운전자 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-051",
      "text": "하중인양장치 및 인양팔의 운동범위에 장애물을 제거해야 한다.",
      "guideContext": "리프트 운전자 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-052",
      "text": "인양 후 차량 안착상태의 확인 등의 안전확인을 해야 한다.",
      "guideContext": "리프트 운전자 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-053",
      "text": "인양작업 중 리프트의 작동상태를 감시해야 한다.",
      "guideContext": "리프트 운전자 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-054",
      "text": "리프트 작동중에는 위험반경 내에 사람이 접근하는 것을 금지해야 한다.",
      "guideContext": "리프트 운전자 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-055",
      "text": "리프트에 사람이 탑승하는 것을 금지해야 한다.",
      "guideContext": "리프트 운전자 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 리프팅",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-056",
      "text": "해당 차량 점검 적합한 정비용 리프트를 사용하였는지 확인해야 한다.",
      "guideContext": "들어 올려진 차량의 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.7",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-057",
      "text": "자동차정비용 리프트는 오로지 훈련받은 공인 정비사만이 사용하도록 해야 한다.",
      "guideContext": "들어 올려진 차량의 정비",
      "additionalDetail": null,
      "workProcessPhase": "리프트 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.7",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-010"
      ]
    },
    {
      "identifier": "CI-M171-058",
      "text": "자동차정비용 리프트 위의 차량을 점검할 때 초크, 잭, 프롬의 배치, 과적 방지 등의 사항을 확인해야 한다.",
      "guideContext": "들어 올려진 차량의 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.7",
      "basedOn": null
    },
    {
      "identifier": "CI-M171-059",
      "text": "자동차정비용 리프트를 사용하기 전에는 잭과 차축 지지대의 적절한 유지보수를 해야 한다. 또한 모든 리프팅 장비들의 정기 점검과 유지보수를 해야 하며 이를 기록하여 보관해야 한다.",
      "guideContext": "들어 올려진 차량의 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리프트 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M171-001",
      "term": "2주식 리프트(Two-post lifts)",
      "definition": "일반적으로 주 기둥, 보조기둥 두 개의 수직 지지기둥이 있는 리프트를 말한다. 두 지지기둥에 모두 적재팔이 두 개씩 있으며 이 적재팔은 지지기둥 부분에 위치하고 길이조절이 가능하며 일부는 관절 형태이다. 각 적재팔의 끝 부분에는 픽업패드가 씌워져 있는 조절 가능한 픽업판이 있다. 주로 엔진/미션 탈·부착 등 하체정비 시 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M171-002",
      "term": "4주식 리프트(Four-post lifts)",
      "definition": "차량하부에서 정비작업을 할 수 있도록 4개의 기둥을 설치하고 2개의 승강장에 정비차량을 탑재하여 유압실린더로 들어 올리는데 사용하는 리프트를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M171-003",
      "term": "시저스 방식 리프트(Scissors lifts)",
      "definition": "차량 하부에서 정비작업을 할 수 있도록 승강장에 탑재된 정비차량을 링크구조의 유압실린더로 들어올리는 데 사용되는 리프트 이다. 주로 엔진/미션 탈·부착 등 2주식 리프트와 유사한 작업용으로 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M171-004",
      "term": "정격하중",
      "definition": "리프트 적재장치가 운반할 수 있는 최대하중을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M171-005",
      "term": "암 고정장치(Arm locking device)",
      "definition": "자동차정비용 리프트의 안전장치중의 하나이며 리프트를 상승시킨 상태에서 불시하강을 방지하기 위해 자동으로 록킹되는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M171-006",
      "term": "잭(Jack)",
