  "domainTerms": [
    {
      "identifier": "DT-H59-001",
      "term": "응급처치",
      "definition": "사고나 질병으로 갑자기 재해자가 발생하였을 때, 그 재해자가 의료기관에 도착하기 전까지 행해지는 즉각적이고 임시적인 처치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H59-002",
      "term": "재해자",
      "definition": "업무에 기인하거나 또는 업무와 관계없는 사고나 질병으로 인하여 위급한 상황에 처한 사람을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H59-01",
      "processOrder": 1,
      "processName": "재해자 의식확인",
      "safetyMeasures": "재해자의 어깨를 가볍게 두드리며 이름을 부르거나 호출하여 의식 확인. 환자의 몸을 심하게 흔들지 않으며, 머리나 목에 외상이 의심되면 꼭 필요한 경우에만 이동. 의식이 있으면 응급처치 실시 허락을 받고, 편한 자세를 취하게 한 후 지혈·환부 고정 등 필요한 처치를 시행한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H59-02",
      "processOrder": 2,
      "processName": "환자 반응 확인",
      "safetyMeasures": "양쪽 어깨를 가볍게 두드리며 큰 목소리로 호출하여 몸 움직임, 눈 깜빡임, 대답 등으로 반응을 확인한다. 반응이 없으면 심장마비의 가능성이 높은 것으로 판단한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H59-03",
      "processOrder": 3,
      "processName": "구조요청 및 AED 요청",
      "safetyMeasures": "환자의 반응이 없으면 즉시 주변 사람에게 도움을 요청하고, 자동심장충격기(AED)가 비치되어 있으면 함께 요청한다. 119 신고 시 특정인을 지정하여 정확하고 단호하게 요청한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H59-04",
      "processOrder": 4,
      "processName": "호흡확인",
      "safetyMeasures": "쓰러진 사람의 얼굴과 가슴을 10초 정도 관찰하여 호흡 여부를 확인한다. 반응이 없고 호흡이 없거나 비정상적이면 심장마비 발생으로 판단한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H59-05",
      "processOrder": 5,
      "processName": "가슴압박 실시(30회)",
      "safetyMeasures": "가슴뼈(흉골) 아래쪽 절반 부위에 깍지 낀 두 손의 손바닥 꿈치를 대고, 분당 100~120회 속도로 약 5cm 깊이로 강하고 빠르게 압박한다. 양팔을 쭉 편 상태에서 체중을 실어 환자의 몸과 수직이 되도록 압박하며, 압박된 가슴은 완전히 이완 후 다시 압박한다. 손가락이 가슴에 닿지 않도록 주의한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H59-06",
      "processOrder": 6,
      "processName": "인공호흡 시행(2회)",
      "safetyMeasures": "머리기울임-턱 들어올리기(head tilt-chin lift) 방법으로 기도를 개방한 후, 환자의 코를 막고 입을 완전히 막아 가슴이 올라올 정도로 1초 동안 숨을 불어넣는다. 10초 이내에 1초씩 2회 시행하며, 1회에 500~800 ml 정도를 불어 넣는다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H59-07",
      "processOrder": 7,
      "processName": "자동심장충격기(AED) 사용",
      "safetyMeasures": "정상적인 반응과 호흡이 없는 심정지 환자에게만 사용한다. 전원을 켜고 패드 1은 오른쪽 빗장뼈 바로 아래, 패드 2는 왼쪽 젖꼭지 옆 겨드랑이 아래쪽에 부착한다. 심장리듬 분석 시 환자에게서 손을 떼고, 제세동 버튼을 누르기 전에 반드시 다른 사람이 환자에게서 떨어져 있는지 확인한다. 제세동 후 즉시 가슴압박을 재개하며, 119 구급대 도착 시까지 지속한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": null
    },
    {
      "identifier": "WP-H59-08",
      "processOrder": 8,
      "processName": "기도폐쇄시 조치",
      "safetyMeasures": "의식이 있을 때: 재해자의 뒤쪽에서 양쪽 겨드랑이 밑으로 손을 넣어 배를 감싸고 배꼽과 명치 사이에 주먹을 대어 위쪽으로 5-10회 압박하며 밀쳐 올린다. 의식을 잃었을 때: 즉시 심폐소생술을 실시하고 흉부압박 30회 후 구강 내 이물 배출 여부를 확인한다. 이물 배출 후에도 병원에서 복부 손상 여부를 진단받도록 한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
  ],
