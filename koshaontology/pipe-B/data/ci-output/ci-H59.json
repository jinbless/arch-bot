  },
  "checklistItems": [
    {
      "identifier": "CI-H59-001",
      "text": "재해자의 어깨를 가볍게 두드리며 이름을 부르거나 \"여보세요 괜찮으세요?\" 라고 말한다.",
      "guideContext": "재해자 의식확인",
      "additionalDetail": null,
      "workProcessPhase": "재해자 의식확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-002",
      "text": "환자의 몸을 심하게 흔들지 않는다.",
      "guideContext": "재해자 의식확인",
      "additionalDetail": null,
      "workProcessPhase": "재해자 의식확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-003",
      "text": "쓰러져있는 사람의 머리나 목에 외상이 의심되면 꼭 필요한 경우에만 환자를 이동해야 한다.",
      "guideContext": "재해자 의식확인 (법령 근거 미확인)",
      "additionalDetail": "예: 건물의 화재, 붕괴사고, 밀폐공간 등",
      "workProcessPhase": "재해자 의식확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-004",
      "text": "의식이 있으면 자신을 소개하고 응급처치 실시의 허락을 받는다. 의식이 없으면 동행인에게 허락을 구하고 동행인도 없으면 허락을 받은 것으로 간주한다.",
      "guideContext": "재해자 의식확인",
      "additionalDetail": null,
      "workProcessPhase": "재해자 의식확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-005",
      "text": "재해자가 편하다는 자세를 취하여 주고 지혈, 환부의 고정 등 필요한 처치를 시행한다.",
      "guideContext": "재해자 의식확인",
      "additionalDetail": null,
      "workProcessPhase": "재해자 의식확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-006",
      "text": "양쪽 어깨를 가볍게 두드리며 큰 목소리로 \"여보세요 괜찮으세요?\" 라고 말한다.",
      "guideContext": "심폐소생술 - 환자 반응 확인",
      "additionalDetail": null,
      "workProcessPhase": "환자 반응 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-007",
      "text": "환자의 몸 움직임, 눈 깜빡임, 대답 등으로 반응을 확인 한다",
      "guideContext": "심폐소생술 - 환자 반응 확인",
      "additionalDetail": "반응이 없으면 심장마비의 가능성이 높다",
      "workProcessPhase": "환자 반응 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-008",
      "text": "환자의 반응이 없으면 즉시 주변에 있는 사람에게 도움을 요청한다.",
      "guideContext": "심폐소생술 - 구조요청",
      "additionalDetail": null,
      "workProcessPhase": "구조요청 및 AED 요청",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-009",
      "text": "주변에 자동심장충격기(Automatic external defibrillator, AED)가 비치되어 있는 경우 자동심장충격기도 함께 요청한다.",
      "guideContext": "심폐소생술 - 구조요청",
      "additionalDetail": null,
      "workProcessPhase": "구조요청 및 AED 요청",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-010",
      "text": "119에 신고를 요청 할 때는 특정인을 지정하여 정확하고 단호하게 요청한다.",
      "guideContext": "심폐소생술 - 구조요청",
      "additionalDetail": null,
      "workProcessPhase": "구조요청 및 AED 요청",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-011",
      "text": "주위에 아무도 없을 경우에는 즉시 스스로 119에 신고한다.",
      "guideContext": "심폐소생술 - 구조요청",
      "additionalDetail": null,
      "workProcessPhase": "구조요청 및 AED 요청",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-012",
      "text": "쓰러진 사람의 얼굴과 가슴을 10초 정도 관찰하여 호흡이 있는지를 확인한다.",
      "guideContext": "심폐소생술 - 호흡확인",
      "additionalDetail": "반응이 없는 사람이 호흡이 없거나 호흡이 비정상적이면 심장마비가 발생한 것으로 판단한다",
      "workProcessPhase": "호흡확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-013",
      "text": "가슴뼈(흉골)의 아래쪽 절반 부위를 확인한다.",
      "guideContext": "심폐소생술 - 가슴압박 위치 확인",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-014",
      "text": "깍지 낀 두 손의 손바닥 꿈치를 부위에 댄다.",
      "guideContext": "심폐소생술 - 가슴압박 위치 확인",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-015",
      "text": "손가락이 가슴에 닿지 않도록 주의하여야 한다.",
      "guideContext": "심폐소생술 - 가슴압박 위치 확인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-016",
      "text": "성인의 경우 분당 100~120회의 속도로 압박한다.",
      "guideContext": "심폐소생술 - 가슴압박 방법",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-017",
      "text": "가슴이 약5cm 깊이로 눌릴 정도로 강하고 빠르게 압박한다.",
      "guideContext": "심폐소생술 - 가슴압박 방법",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-018",
      "text": "양팔을 쭉 편 상태에서 체중을 실어서 환자의 몸과 수직이 되도록 가슴을 압박한다.",
      "guideContext": "심폐소생술 - 가슴압박 방법",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-019",
      "text": "압박 시에는 하나, 둘, 셋.....하고 소리 내어 세어가며 30회 시행한다.",
      "guideContext": "심폐소생술 - 가슴압박 방법",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-020",
      "text": "압박된 가슴은 완전히 이완 된 후 다시 압박한다.",
      "guideContext": "심폐소생술 - 가슴압박 방법",
      "additionalDetail": null,
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-021",
      "text": "인공호흡 하는 방법을 모르거나 인공호흡을 꺼리는 일반인 구조자는 가슴압박 소생술을 하도록 권장한다.",
      "guideContext": "심폐소생술 - 가슴압박 방법",
      "additionalDetail": "가슴압박 소생술(compression-only CPR 또는 hands-only CPR)은 심폐소생술(가슴압박과 인공호흡을 함께 하는 방법)과 달리 인공호흡은 하지 않고 가슴압박만을 시행하는 소생술방법이다",
      "workProcessPhase": "가슴압박 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-022",
      "text": "가슴 압박과 인공호흡을 계속 반복하는 도중에 환자가 소리를 내거나 움직이면 호흡도 회복되었는지 확인한다.",
      "guideContext": "심폐소생술 - 회복 자세",
      "additionalDetail": null,
      "workProcessPhase": "회복 자세 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-023",
      "text": "호흡이 회복되었으면 옆으로 돌려 눕혀 기도가 막히는 것을 예방한다.",
      "guideContext": "심폐소생술 - 회복 자세",
      "additionalDetail": null,
      "workProcessPhase": "회복 자세 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-024",
      "text": "인공호흡을 시행하기 위해서는 먼저 환자의 머리기울임-턱 들어올리기(head tilt-chin lift) 방법을 사용하여 기도를 개방시킨다.",
      "guideContext": "인공호흡 - 기도 개방",
      "additionalDetail": null,
      "workProcessPhase": "인공호흡 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-025",
      "text": "머리를 젖혔던 손의 엄지와 검지로 환자의 코를 잡아서 막는다.",
      "guideContext": "인공호흡 - 인공호흡 방법",
      "additionalDetail": null,
      "workProcessPhase": "인공호흡 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-026",
      "text": "입을 크게 벌려 환자의 입을 완전히 막은 뒤에 가슴이 올라올 정도로 1초 동안 숨을 불어넣는다.",
      "guideContext": "인공호흡 - 인공호흡 방법",
      "additionalDetail": null,
      "workProcessPhase": "인공호흡 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-027",
      "text": "숨을 불어넣을 때에는 환자의 가슴이 부풀어 오르는지 눈으로 확인한다.",
      "guideContext": "인공호흡 - 인공호흡 방법",
      "additionalDetail": null,
      "workProcessPhase": "인공호흡 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-028",
      "text": "인공호흡은 10초 이내에 1초씩 2회 시행한다.",
      "guideContext": "인공호흡 - 인공호흡 방법",
      "additionalDetail": "공기의 양은 1회에 500~800 ml 정도 불어 넣는다",
      "workProcessPhase": "인공호흡 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-029",
      "text": "숨을 불어넣은 후에는 입을 떼고 코도 놓아주어서 공기가 배출되도록 한다.",
      "guideContext": "인공호흡 - 인공호흡 방법",
      "additionalDetail": null,
      "workProcessPhase": "인공호흡 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-030",
      "text": "자동심장충격기는 정상적인 반응과 호흡이 없는 심정지 환자에게만 사용하여야 한다.",
      "guideContext": "자동심장충격기 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-031",
      "text": "심폐소생술 중에 자동심장충격기가 도착하면 지체 없이 이를 적용해야 한다.",
      "guideContext": "자동심장충격기 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-032",
      "text": "자동심장충격기를 심폐소생술에 방해가 되지 않는 위치에 놓은 뒤에 전원 버튼을 눌러 전원을 켠다.",
      "guideContext": "자동심장충격기 사용 - 전원 켜기",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-033",
      "text": "패드 부착부위에 이물질이 있다면 제거하고 패드와 제세동기 본체가 분리되어 있는 경우에는 연결한다.",
      "guideContext": "자동심장충격기 사용 - 패드 부착",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-034",
      "text": "패드 1은 오른쪽 빗장뼈 바로 아래에 부착한다.",
      "guideContext": "자동심장충격기 사용 - 패드 부착",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-035",
      "text": "패드 2는 왼쪽 젖꼭지 옆 겨드랑이 아래쪽에 부착한다.",
      "guideContext": "자동심장충격기 사용 - 패드 부착",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-036",
      "text": "\"분석 중...\" 이라는 음성 지시가 나오면 심폐소생술을 멈추고 환자에게서 손을 뗀다.",
      "guideContext": "자동심장충격기 사용 - 심장리듬 분석",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H59-037",
      "text": "자동심장충격기의 충전은 수 초 이상 소요되므로 가능한 가슴압박을 시행한다.",
      "guideContext": "자동심장충격기 사용 - 심장리듬 분석",
      "additionalDetail": null,
      "workProcessPhase": "자동심장충격기 사용",
      "bindingForce": "RECOMMENDED",
