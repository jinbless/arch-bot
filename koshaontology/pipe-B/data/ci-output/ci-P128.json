  "domainTerms": [
    {
      "identifier": "DT-P128-001",
      "term": "기상반응",
      "definition": "가연성 고체가 증발하여 생긴 증기나 분해 생성가스가 공기 중의 산소와 산화 반응하여 연소하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P128-002",
      "term": "표면반응",
      "definition": "가연성고체의 표면에서 열분해 및 증발을 일으키지 않고 고온을 유지하면서 산소와 반응하여 연소하는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P128-003",
      "term": "자기소화성",
      "definition": "외부의 열원 없이는 연소를 계속할 수 없는 물질의 성질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P128-004",
      "term": "전하 완화",
      "definition": "물체표면 등에 발생된 전하가 손실되어 양전하와 음전하의 균형이 회복하는 것으로서 방전이나 물체 표면 또는 내부의 전기 전도에 의해 일어나는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P128-005",
      "term": "최대폭발압력",
      "definition": "밀폐공간 내의 분진운이 발화하여 화염이 전파하고 발생한 열에 의해 용기 내의 압력이 상승하는데 반응이 분진운 전체로 진행하여 나타난 압력의 최대값을 폭발압력이라 하며 이러한 폭발압력이 농도 변화에 따라 가장 큰 값을 가질 때의 폭발압력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P128-006",
      "term": "퇴적분진 화염전파속도",
      "definition": "설비의 표면이나 작업장 바닥에 퇴적된 분진층의 일부분이 착화원에 의해 착화되어 화염이 퇴적 분진층 상부를 따라 전파하는데 단위 시간당 화염면이 이동하는 거리를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
