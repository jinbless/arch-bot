  "checklistItems": [
    {
      "identifier": "CI-P128-001",
      "text": "Al 성분이 40 % 이상 함유된 Mg-Al합금 분진이 퇴적되어 있는 경우에는 착화 위험성이 크게 낮아진다. 그러나 공기중에 분산, 부유되면 폭발할 수 있으므로 퇴적분진 주변의 기류 발생에 유의한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책",
      "additionalDetail": null,
      "workProcessPhase": "금속분진 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-002",
      "text": "Al은 비중이 2.7로 작아 공기 중에 부유하기 쉬우며, 입경이 20 μm이하의 Al은 폭발압력이 9.8 bar로서 폭발위험성이 매우 높으므로 취급시에는 착화원 관리를 통한 폭발사고예방에 주의가 필요하다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책",
      "additionalDetail": null,
      "workProcessPhase": "금속분진 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-003",
      "text": "가연성 금속분진을 보관, 취급하는 경우에는 부도체 용기의 사용을 금지하고 반드시 도전성이 있는 용기를 사용한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책",
      "additionalDetail": null,
      "workProcessPhase": "금속분진 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-004",
      "text": "금속분진의 충진 작업은 가급적 자동화 작업으로 이루어지도록 하여 충진 작업이 종료할 때까지 작업자가 접근하지 않아도 되는 방식으로 한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책",
      "additionalDetail": null,
      "workProcessPhase": "금속분진 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-005",
      "text": "제조된 금속분진을 이동하거나 충진 작업 중에 공기와 처음으로 접하는 경우에는 급격한 산화반응에 따른 화재폭발위험성이 증가하므로 취급에 주의한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책",
      "additionalDetail": null,
      "workProcessPhase": "금속분진 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-006",
      "text": "Zr분진은 부도체와 접촉하면 쉽게 대전되며 또한 방전이 되는 경우에는 불꽃방전으로 화재폭발 가능성이 있으므로 가급적 소량씩 취급한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책",
      "additionalDetail": null,
      "workProcessPhase": "금속분진 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-007",
      "text": "Mg-Al합금을 연마하는 경우에는 연삭기를 접지하고 도전성 롤러를 사용하며, 또한 작업자는 대전방지 작업복을 착용한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-008",
      "text": "연마기(Grinder) 및 작업대에 금속분진이 쌓이지 않도록 자주 청소를 하여 제거한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-009",
      "text": "연마 분진을 흡인하는 장치를 사용하는 경우에는 덕트 내에 연마분이 퇴적하지 않도록 충분한 크기의 배출 공기량이 되도록 한다.",
      "guideContext": "금속분진 물성 기반 화재폭발 방지대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-010",
      "text": "집진 공정에서의 금속분진 폭발사고는 전 단계의 공정에서 발생한 착화원의 혼입에 의한 경우가 많기 때문에 이러한 요인을 배제하는 것이 필요하다.",
      "guideContext": "집진설비",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-011",
      "text": "집진기에는 폭발압력을 시스템 밖으로 방출하기 위한 폭발방산구를 설치해야 한다.",
      "guideContext": "집진설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-012",
      "text": "폭발방산구의 설치가 곤란한 경우에는 사용분진의 최대폭발압력에 건딜 수 있도록 내압 설계한 집진기를 설치할 수 있다.",
      "guideContext": "집진설비",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-013",
      "text": "금속분을 취급하는 연속공정에서의 분진폭발 피해확산을 방지하기 위해서는 폭발압력을 검출하여 긴급차단밸브를 작동시켜 폭발압력이 전파하지 않도록 하는 폭발억제장치를 사용해야 한다.",
      "guideContext": "집진설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-014",
      "text": "가연성 금속분진의 제거를 위해 전기청소기를 사용하면 금속분이 플라스틱 재질의 호스 내를 유동층이 통과하면서 강하게 대전되고 필터에 축적되면서 불꽃방전을 일으키므로 일반적인 건식 전기청소기를 사용하지 않도록 한다.",
      "guideContext": "집진설비",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-015",
      "text": "집진기에서 발생하는 정전기 착화예방을 위하여 집진기 도전체 전부를 접지하도록 하며 집진기 내부를 도장하는 경우에는 도전성 도료를 사용한다.",
      "guideContext": "집진설비",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-016",
      "text": "전기기기가 설치되는 집진기를 방폭구획에 설치하는 경우에는 내압방폭형의 전기기기를 사용한다.",
      "guideContext": "집진설비",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P128-017",
      "text": "집진기에서의 분진폭발방지를 위한 운전조건은 착화원을 완전히 배제하는 것이므로 운전 전의 점검 및 운전중의 일상점검과 보수관리의 철저가 화재폭발사고 방지를 위하여 가장 중요하다.",
      "guideContext": "집진설비",
      "additionalDetail": null,
      "workProcessPhase": "집진설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-018",
      "text": "금속분진을 폴리에틸렌 비닐 봉투나 플랙시블 용기 등의 부도체 용기에 넣어 옮기지 않도록 한다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-019",
      "text": "염화비닐관 등의 부도체 배관으로 분진을 수송하는 경우에는 분진과 관 벽의 마찰로 인해 양쪽이 대전하여 불꽃방전이나 연면방전과 같은 착화성정전기 방전이 발생하므로 염화비닐재질로 된 관을 사용하지 않는다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-020",
      "text": "금속분진은 절연되면 불꽃방전이 일어날 수 있기 때문에 소량이더라도 발화 위험성이 있으므로 반드시 대전방지성능 또는 도전성이 있는 재질의 덕트를 사용한다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-021",
      "text": "도전성이 있는 금속재료로 만들어진 용기라 하더라도 배출을 촉진시킬 목적으로 진동기(vibrator)위에 올려놓아 사용하는 경우에는 전기적으로 절연될 위험성이 있으므로 확실하게 용기의 접지를 해야 한다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-022",
      "text": "절연성 용기 및 도전성 재료에 있어서 내측이 절연물로 피복된 용기는 접지를 하더라고 전하 완화(Charge relaxation)가 없으므로 최소착화에너지가 3 mJ보다 작은 분진에서는 사용하지 않도록 한다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-023",
      "text": "금속분진의 이송배관에서 플랜지 접속부는 연결하여 접지하도록 한다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-024",
      "text": "금속분의 배관 내 이송 속도는 관벽에 퇴적하거나 체류하지 않을 정도로 하며 정전기 대전을 억제하기 위해서는 가급적 최소화하도록 한다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-025",
      "text": "분진을 저장용기나 저장조에 배출시키는 경우에는 폭발한계농도 이상의 분진운이 발생하고 대전된 분진에 의한 방전 또는 배관벽면에 퇴적된 분진층이 떨어지면서 생기는 방전 등에 의해 폭발이 발생할 수 있으므로 제전 방지 대책을 사전에 실시해야 한다.",
      "guideContext": "분진이동 및 수송",
      "additionalDetail": null,
      "workProcessPhase": "분진이동 및 수송",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-026",
      "text": "금속의 연마 작업에서 발생한 인화성 분진입자의 불꽃에 의한 발화위험성에 주의해야 한다.",
      "guideContext": "연마 및 분쇄 공정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-027",
      "text": "자동차 알루미늄 휠이나 Mg-Al합금 제품의 연마공정에서 발생하는 분진 농도는 일반적으로 낮기 때문에 폭발위험성이 높지 않지만, 연마 작업 시에 발생하는 분진 불꽃이 배관 또는 집진기 내부로 혼입되어 착화원으로 작용하면 분진폭발을 일으킬 수 있으므로 연마 작업시에는 자주 분진의 제거작업을 해야만 한다.",
      "guideContext": "연마 및 분쇄 공정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-028",
      "text": "금속분진폭발이 발생하기 쉬운 입자의 분쇄나 분급을 하는 경우에는 불활성 가스 분위기에서 실시해야 한다. 금속 분진의 종류나 입자경에 따라 다르지만 10 %이하의 산소농도에서의 공정작업이 요구된다.",
      "guideContext": "연마 및 분쇄 공정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-029",
      "text": "Mg-Al합금을 볼밀링(Ball milling)으로 미분쇄하는 공정의 경우에는 볼밀링 처리가 종료하고 밀을 회전시키면서 분쇄물을 배출하는 과정에서 정전기 발생과 알루미늄 볼에 의한 충격 불꽃에 의한 착화로 폭발사고 위험성이 높으므로 정전기발생 억제 및 폭발피해 확산을 방지하기 위한 대책이 필요하다.",
      "guideContext": "연마 및 분쇄 공정",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-030",
      "text": "분쇄기나 분급기 내부에 고속회전하는 롤러인 경우에는 기계부분의 접촉 및 회전부의 마찰에 따른 발열이 발화원이 되지 않도록 회전축의 진동과 온도 점검, 정기적인 보수관리가 중요하다.",
      "guideContext": "연마 및 분쇄 공정",
      "additionalDetail": null,
      "workProcessPhase": "연마 및 분쇄",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-031",
      "text": "기계류 수리 및 배관공사에 전기아크, 가스용접, 가스절단 등을 사용하는 과정에서 불꽃이 작업장 내의 퇴적 금속분진에 착화할 위험성이 있으므로 주의해야 한다.",
      "guideContext": "용접 및 절단 등의 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접 및 절단 보수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-032",
      "text": "퇴적 금속분진에 착화한 경우에는 급격하게 화재폭발로 이어질 가능성은 낮지만 CO₂소화기나 분말소화기를 사용하거나 피해최소화를 위하여 착화된 분진을 안전한 장소로 옮기려고 하는 과정에서 부유분진이 발생하지 않도록 해야 한다.",
      "guideContext": "용접 및 절단 등의 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접 및 절단 보수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-033",
      "text": "퇴적된 금속분진이 착화하여 발화된 경우에는 건조 모래 등을 사용하여 질식 소화에 의한 화재 진압이 효과적이다.",
      "guideContext": "용접 및 절단 등의 보수작업",
      "additionalDetail": null,
      "workProcessPhase": "용접 및 절단 보수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-034",
      "text": "연구 개발 단계에서 사용되는 금속분진은 적은 양을 사용하는 경우가 많아 화재폭발 위험성의 인식이 낮고 안전대책을 고려하지 않는 경우가 있는데 실험 과정에서 착화원이 될 수 있는 요인을 충분한 검토하고 안전대책을 강구해야 한다.",
      "guideContext": "연구개발 시의 실험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연구개발 실험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-035",
      "text": "연구실험실에서 Al분진의 산화실험 중에 폭발사고사례가 있으며, Mg는 부유상태만이 아니고 퇴적 상태에서의 착화위험성이 높기 때문에 실험조건, 사용량 등에 따른 위험성에 주의해야 한다.",
      "guideContext": "연구개발 시의 실험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연구개발 실험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-036",
      "text": "공정 설비 및 환기 장치에서 발생하는 분진을 극소화시킨다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-037",
      "text": "집진 시스템과 집진 장치를 사용한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-038",
      "text": "바닥, 기계설비의 외부 표면, 천장, 창문 등에 분진의 퇴적을 감소시키고, 또한 청소하기 쉬운 표면이나 구조로 하여야 한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-039",
      "text": "설비 주변의 분진 퇴적에 대한 점검을 하기 위해서는 설비에 있어서 잘 보이지 않는 부분에까지 쉽게 접근 할 수 있도록 공간이 확보되어야 한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-040",
      "text": "분진의 퇴적 상황을 정기적으로 점검하고 분진이 퇴적될 수 있는 모든 부분에 대하여 점검을 실시한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-041",
      "text": "퇴적 분진에 대한 정기적인 청소를 한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-042",
      "text": "착화원이 가까이에 존재하는 경우에는 분진운을 발생시키지 않는 청소 방법을 강구한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-043",
      "text": "분진의 집진에 적합하며 정전기발생 방지 기능을 갖는 진공청소기를 사용한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-044",
      "text": "안전밸브 등의 압력방출장치는 분진폭발 위험지역으로부터 격리한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-045",
      "text": "분진의 위험성평가, 퇴적 상황의 점검, 청소 및 분진 관리에 관한 사업장의 특성에 적합한 안전규칙을 제정하고 실시하도록 한다.",
      "guideContext": "분진폭발 예방을 위한 분진관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분진관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-046",
      "text": "전기 기기 및 배선 방식을 적정하게 선정하고 사용하도록 한다.",
      "guideContext": "분진의 착화원 관리",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P128-047",
      "text": "접지를 포함하여 정전기 관리를 철저히 한다.",
      "guideContext": "분진의 착화원 관리",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-048",
      "text": "흡연, 화염 및 전기 불꽃의 관리에 주의한다.",
      "guideContext": "분진의 착화원 관리",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-049",
      "text": "기계적인 전기 불꽃과 마찰원 관리를 철저히 한다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-050",
      "text": "금속제거장치 등과 같은 이물질 제거장치를 사용한다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-051",
      "text": "고온 배관 등의 열이 발생하는 부분이 분진과 접촉되지 않도록 한다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-052",
      "text": "건조기나 소성로(Combustion furnace) 등의 가열 장치로부터 분진을 격리시킨다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-053",
      "text": "방폭 대응형의 작업용 차량을 사용한다.",
      "guideContext": "분진의 착화원 관리",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P128-054",
      "text": "분진관련 장치와 기기의 적절한 성능유지 및 관리를 철저히 한다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-055",
      "text": "모터, 조명기구, 제어반 등의 전기 설비는 방폭형구조로 하고 정기적인 청소를 실시한다.",
      "guideContext": "분진의 착화원 관리",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P128-056",
      "text": "스위치의 불꽃, 퓨즈의 단선, 배선 불량 등 전기 기기의 문제로 인한 착화원 방지를 위해서 방폭형구조 및 정기적인 청소를 실시한다.",
      "guideContext": "분진의 착화원 관리",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P128-057",
      "text": "스팀 배관, 열풍 발생기 덕트 등의 열원(Heat sources)에 대해서는 단열재에 의한 완벽한 보호와 스팀배관 등의 벽 관통부의 정기적인 점검을 실시한다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-058",
      "text": "집진 및 배기 덕트에 퇴적된 분진의 축열에 대해서는 온도 감시와 정기적인 청소를 실시한다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-059",
      "text": "금속분진을 포집하는 집진장치는 도전성 섬유의 여과 천을 사용하여 대전을 방지하고 펄스 에어에 의한 분진의 제거 및 집진장치 전체를 접지하도록 한다.",
      "guideContext": "분진의 착화원 관리",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P128-060",
      "text": "건조기는 다른 공정과 격리시키고 건조기 주위나 내부를 불연재로 피복한다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P128-061",
      "text": "열풍 발생기 등의 연소 장치는 방화 구획으로 격리시킨다.",
      "guideContext": "분진의 착화원 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "착화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
