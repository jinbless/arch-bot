  "checklistItems": [
    {
      "identifier": "CI-H110-001",
      "text": "사업주는 결정형 유리규산을 취급하는 작업장의 보기 쉬운 장소에 결정형 유리규산이 인체에 미치는 영향, 결정형 유리규산의 취급상 주의사항, 착용하여야 할 보호구, 응급조치 및 긴급 방재요령을 게시한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H110-002",
      "text": "결정형 유리규산의 취급업무에 종사하는 근로자는 전용 작업복을 착용하도록 하여야 하며, 작업복과 개인 의복은 분리하여 보관한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.1.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H110-003",
      "text": "작업장에 퇴적 또는 누출된 결정형 유리규산을 제거하는 경우에는 고성능 필터의 진공청소기 등 흡입장치를 사용하거나 정전기의 발생 등을 예방할 수 있도록 젖은 천으로 닦아내도록 하고 홀날리게 해서는 안 된다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H110-004",
      "text": "결정형 유리규산을 취급하는 장소에서는 음식물의 저장, 섭취, 흡연 등을 금지한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H110-005",
      "text": "발생되는 폐기물 및 청소 걸레 등은 지정된 밀폐 장소에 보관하고, 규정된 절차에 따라 처리한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H110-006",
      "text": "결정형 유리규산을 취급하는 작업장에는 손과 피부를 씻을 수 있는 세척 설비를 갖추어야 하며, 옷이나 피부에 부착되어 결정형 유리규산이 다른 장소로 비산 전파되는 것을 방지하기 위하여 목욕 및 세탁설비 등도 설치한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-007",
      "text": "분말 상의 결정형 유리규산은 액체 또는 고체 매개물에 응집시켜 관리하며, 기술적으로 가능한 경우 분말 대신 반죽형태(paste) 또는 화합물 형태로 사용한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-008",
      "text": "결정형 유리규산을 취급하는 근로자 및 해당 업무에 종사하게 될 근로자에 대해서는 다음 내용이 포함된 특별안전보건 교육을 16시간 이상 실시한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": "교육내용: 물질안전보건자료, 물리·화학적 특성, 건강장해 예방대책, 현재 조치 사항, 공정별 표준작업 요령, 국소배기장치 및 안전설비, 보호구 사용법 및 관리방법, 응급처치방법",
      "workProcessPhase": "교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "8.1.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H110-009",
      "text": "사업주는 결정형 유리규산을 취급하는 업무에 상시 종사하는 근로자에 대해 매 분기마다 다음내용이 포함된 결정형 유리규산의 취급일지를 작성하여 30년간 보존한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": "포함내용: 근로자 성명, 물질 명 및 사용량, 작업내용 및 업무의 종사기간, 위급상황에 대한 개요 및 응급조치 요령",
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-010",
      "text": "결정형 유리규산의 취급 작업 중에는 가동 중인 국소배기장치 등을 임의로 정지시키지 않는다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 중",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.4",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-H110-011",
      "text": "결정형 유리규산이 가능한 한 작업장 내로 발산되지 않는 방법으로 작업한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 중",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.4",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-012",
      "text": "지급된 보호구는 사업주 및 관리감독자 등의 지시에 따라 반드시 착용한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 중",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.1.4",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H110-013",
      "text": "규정된 안전한 지역에서 취급, 사용 및 저장해야 한다.",
      "guideContext": "결정형 유리규산 취급 및 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "취급 및 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-014",
      "text": "분진 발생이 최소화할 수 있도록 취급한다.",
      "guideContext": "결정형 유리규산 취급 및 보관",
      "additionalDetail": null,
      "workProcessPhase": "취급 및 보관",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.9",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H110-015",
      "text": "결정형 유리규산의 비산이 이루어지지 않도록 포장, 혹은 밀폐공간에 보관한다.",
      "guideContext": "결정형 유리규산 취급 및 보관",
      "additionalDetail": null,
      "workProcessPhase": "취급 및 보관",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1.9",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-016",
      "text": "사업주는 작업환경 실태를 파악하기 위하여 해당 근로자 또는 작업장에 대해 작업환경측정의 계획을 수립하고 시료를 채취하고 분석 평가해야한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H110-017",
      "text": "사업주는 작업환경측정을 하기 전에 예비조사를 실시해야 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-018",
      "text": "작업환경측정은 작업이 정상적으로 이루어져 작업시간과 유해인자에 대한 근로자의 노출 정도를 정확히 평가할 수 있을 때 실시해야 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-019",
      "text": "사업주는 어떤 근로자가 호흡용 보호구가 필요 없는지, 광물성 분진과 결정형 유리규산의 노출기준 이상에 노출되는 지를 확인하여야 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H110-020",
      "text": "작업환경측정 결과 및 평가에 대한 모든 기록은 30년간 보존한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2.1",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-H110-021",
      "text": "사업주는 작업환경측정결과를 다음 각 호의 어느 하나에 방법으로 해당 사업장 근로자에게 알려야 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": "방법: 게시판 부착, 사보 게재, 정례조회 시 집합교육, 기타 알 수 있는 방법",
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H110-022",
      "text": "결정형 유리규산을 사용하는 경우 발암성이 없는 물질로 대체한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": "물질을 대체하는 경우에는 새로운 물질의 유해성에 대하여 면밀히 검토한다.",
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-023",
      "text": "해당 공정이 분산 배치되지 않도록 하고 다른 작업장과 격리시킨다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3.2",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-H110-024",
      "text": "관련 기계, 기구 등을 배치할 때는 가능한 한 밀폐시키거나 국소배기장치 등을 설치하여 근로자에게 결정형 유리규산의 노출을 최소화한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-025",
      "text": "작업상 필요한 개구부를 제외하고는 완전히 밀폐시킨다.",
      "guideContext": "결정형 유리규산 발산원 밀폐 조치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3.3",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-026",
      "text": "결정형 유리규산의 보관 장소 등 밀폐된 작업 장소의 내부는 전체환기장치를 설치하여 음압으로 유지한다.",
      "guideContext": "결정형 유리규산 발산원 밀폐 조치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3.3",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H110-027",
      "text": "작업특성상 밀폐실 내부를 음압으로 유지하는 것이 곤란한 경우 또는 개구부 등을 통하여 결정형 유리규산이 누출되는 경우에는 해당 부위에 국소배기장치를 설치하여 결정형 유리규산의 발산을 최소화한다.",
      "guideContext": "결정형 유리규산 발산원 밀폐 조치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3.3",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H110-028",
      "text": "사업주는 결정형 유리규산에 노출되는 공정에 설치된 국소배기장치의 배기량을 보충하는 전체환기장치를 설치해야 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": "설치하지 않은 경우 국소배기장치의 필요 송풍량이 달성되지 않는다.",
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3.4.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H110-029",
      "text": "작업장 외부로 배출된 공기가 당해 작업장 또는 인접한 다른 작업장으로 재유입되지 않도록 필요한 조치를 취해야 한다.",
      "guideContext": "결정형 유리규산 전체환기",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3.4.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H110-030",
      "text": "전체 환기장치를 설치할 때 국소배기장치에서 배기되는 송풍량을 고려하여 그 효율이 떨어지지 않도록 적정한 필요 환기량을 산정하여야 한다.",
      "guideContext": "결정형 유리규산 전체환기",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3.4.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H110-031",
      "text": "외부공기가 유입되는 송풍기나 급기구에는 필요시 외부로부터 유해물질의 유입을 막기 위한 필터나 흡착시설 등을 설치하는 것이 바람직하다.",
      "guideContext": "결정형 유리규산 전체환기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-032",
      "text": "국소배기장치의 후드는 작업 방법, 발암성물질의 발산 상태 등을 고려하여 결정형 유리규산을 흡인하기에 적당한 형식과 크기로 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-033",
      "text": "후드는 발산원마다 설치한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-034",
      "text": "후드의 형식은 포위식 또는 부스식 후드를 설치하는 것을 원칙으로 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": "포위식 또는 부스식 후드를 설치하기가 곤란한 경우에는 외부식 또는 레시바식 후드를 설치하되 발암성물질이 발생되는 발산원에서 가장 가까운 위치에 설치한다.",
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-035",
      "text": "국소배기장치의 덕트 길이는 가능한 짧게 하고 굴곡부의 수를 적게 하여 압력손실을 최소화한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-036",
      "text": "국소배기장치는 후드, 덕트, 공기정화장치, 송풍기, 배기구의 순으로 설치하는 것을 원칙으로 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-037",
      "text": "국소배기장치의 배기구는 직접 외부로 향하도록 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-038",
      "text": "국소배기장치의 배기구 높이는 옥상 또는 옥상, 난간상부로부터 건물 높이의 0.5배 이상으로 하여 배출된 발암성물질이 당해 작업장으로 재 유입되거나 인근의 다른 작업장으로 확산되지 않는 구조로 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-039",
      "text": "배기구는 전체환기장치의 외부 공기 유입구와도 15 m이상 거리를 두는 것이 좋다",
      "guideContext": "결정형 유리규산 국소배기장치 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-040",
      "text": "국소배기장치에 공기정화장치를 설치하는 경우에는 고체흡착 방식, 연소 방식 또는 이와 동등 이상의 성능을 가진 공기정화장치를 설치한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-041",
      "text": "국소배기장치의 성능은 물질의 상태에 따라 <표 5>에서 정하는 제어풍속 이상이 되도록 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 설치",
      "additionalDetail": "입자상 포위식 포위형: 0.7 m/sec, 외부식 측방흡인형: 1.0 m/sec, 외부식 하방흡인형: 1.0 m/sec, 외부식 상방흡인형: 1.2 m/sec",
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-042",
      "text": "국소배기장치는 설치 목적에 알맞도록 가동하고 작업 중에 작업자가 임의로 가동을 중지시킬 수 없는 구조로 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 정상 가동",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3.4.3",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-H110-043",
      "text": "국소배기장치가 정상 가동이 되지 않는 경우에는 작업자가 이상 상태를 즉시 인지 할 수 있도록 경보장치 등을 설치한다.",
      "guideContext": "결정형 유리규산 국소배기장치 정상 가동",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3.4.3",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-H110-044",
      "text": "후드 가장자리에 가벼운 끈 등을 부착하여 제어되는 방향과 강도를 근로자가 보고 국소배기장치의 성능을 판단할 수 있도록 하는 것이 좋다.",
      "guideContext": "결정형 유리규산 국소배기장치 정상 가동 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-045",
      "text": "결정형 유리규산이 발산되어 화재·폭발의 위험이 있는 경우에는 작업을 중단하거나 제한할 수 있도록 하고 시설, 장비 등의 가동이 자동적으로 중단되도록 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 정상 가동",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.3.4.3",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H110-046",
      "text": "작업이 종료된 이후에도 작업장 내에 결정형 유리규산이 발산되는 제품 등이 있는 경우에는 유해요인이 제거될 때까지 국소배기장치를 계속 가동한다.",
      "guideContext": "결정형 유리규산 국소배기장치 정상 가동",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3.4.3",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H110-047",
      "text": "당해 국소배기장치의 가동 여부를 수시 확인하고 필요할 때는 가동일지 등을 기록, 보관한다.",
      "guideContext": "결정형 유리규산 국소배기장치 정상 가동",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3.4.3",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-H110-048",
      "text": "국소배기장치를 설치한 후 처음 사용하거나 분해하여 개조 또는 수리한 후 재사용 할 경우에는 다음 사항을 점검하고 이상을 발견하면 즉시 청소, 보수하는 등 필요한 조치를 하여 항상 성능이 유지되도록 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 관리",
      "additionalDetail": "점검사항: 덕트 및 배풍기의 분진 퇴적 상태, 덕트 접속부의 이완 유무, 흡기 및 배기 능력의 적정성",
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3.4.4",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-H110-049",
      "text": "사업주는 산업안전보건법 제36조 및 같은 법 시행규칙 제74조에 의거하여 작업 중 국소배기장치(제진장치 및 배출가스 처리장치포함)가 효과적으로 작동하고 있는지 확인하기 위해 노동부령이 정하는 자격을 가진 자로 하여금 매년 1회 이상 정기적으로 안전검사를 실시하고 그 결과를 기록, 보존하여야 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 안전검사",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3.4.5",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-H110-050",
      "text": "사업주는 근로자대표의 요구가 있을 때에는 자체검사에 근로자대표를 입회시켜야 한다.",
      "guideContext": "결정형 유리규산 국소배기장치 안전검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3.4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-051",
      "text": "결정형 유리규산을 취급하는 근로자는 호흡기 노출을 방지하기 위하여 안전 인증을 받은 개인전용 호흡용 보호구(방진마스크)를 착용 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.3.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H110-052",
      "text": "결정형 유리규산이 흩날리거나 튀어 눈에 직접 접촉될 우려가 있는 경우에는 근로자의 눈을 보호하기 위하여 고글형 보호안경을 착용 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.3.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H110-053",
      "text": "결정형 유리규산에 노출되는 근로자에 대한 배치전 및 특수건강진단을 실시한다.",
      "guideContext": "결정형 유리규산 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": "관찰 주요 소견: 흉부방사선, 객담세포검사, 폐활량 검사의 변화",
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-054",
      "text": "흉부방사선, 객담세포검사, 폐활량검사는 표준화된 방법에 의해 정도관리를 수행하는 인증된 실험실에서 검사하여야 하며 정상범위는 각각의 실험실에서 정한 참고 값을 기준으로 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-055",
      "text": "사업주는 근로자가 다음과 같은 증상과 징후를 보이는 경우에 수시건강진단을 실시한다.",
      "guideContext": "결정형 유리규산 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": "증상: 호흡곤란, 심계항진, 기침, 객담, 가슴통증 및 빈혈, 맥박이상, 호흡이상",
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.4.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-056",
      "text": "근로자는 호흡곤란, 기침, 가래 등의 자각증상을 인지한 경우에는 보건관계자 또는 사업주에게 즉시 통보하여야 하며 근로자로부터 통보를 받은 보건관계자는 이를 즉시 사업주에게 통보한다.",
      "guideContext": "결정형 유리규산 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.4.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-057",
      "text": "당해 보고를 접한 사업주는 자각증상의 원인을 조사하고 작업환경상의 문제점을 파악한 후 당해 근로자의 작업방법을 점검하는 등 철저한 후속조치를 하여야 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": "파악된 문제에 따른 조치를 실시하고 필요시 해당근로자에 대한 건강 진단 조치 등을 취하여야 한다.",
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.4.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H110-058",
      "text": "결정형 유리규산을 취급하는 작업에는 임신부나 18세 미만의 사람이 종사하지 않도록 한다.",
      "guideContext": "결정형 유리규산 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
