  "checklistItems": [
    {
      "identifier": "CI-E112-001",
      "text": "각 타입에 대한 SPD는 <표 1>에 나타낸 항목의 시험에 합격하여야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-002",
      "text": "SPD가 고장 난 경우에 안전성을 확보하기 위해 각 모드에 다음과 같은 장치를 설치하는 것이 좋다.",
      "guideContext": "서지보호장치 보조장치 설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-003",
      "text": "개방모드에서는 SPD가 고장 났을 때 다음에 침입하는 서지에 대해 기기를 보호할 수 없기 때문에 고장 난 SPD를 교환하기 위해 SPD의 상태를 표시하는 동작표시기를 설치한다.",
      "guideContext": "서지보호장치 보조장치 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-004",
      "text": "단락모드에서는 고장 난 SPD에 의해 배전계통이 단락에 가까운 상태가 되기 때문에 단락전류로 인해 화재 등이 발생하지 않도록 SPD를 분리기를 설치한다.",
      "guideContext": "서지보호장치 보조장치 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-005",
      "text": "건축물에 설치하는 기기에 필요한 정격 충격전압은 기기의 설치장소 및 공칭전압에 따라 <표 4>에 표시한 충격전압 보다 높아야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-006",
      "text": "건축물 내 설비에는 다음의 것을 제외하고는 과전압 범주 II의 보호수준을 갖는 SPD를 설치한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-007",
      "text": "설비에 높은 신뢰성이 요구되는 경우에는 뇌과전압 방지를 하는 것이 바람직하다.",
      "guideContext": "서지보호장치 선정 및 설치",
      "additionalDetail": "연간 뇌우일수(IKL)가 AQ1(≤25일/연)인 경우에도 적용 검토",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-008",
      "text": "SPD의 연결도체 길이가 길어지면 뇌서지 회로의 임피던스가 증가하여 과전압 보호의 효율성이 떨어지므로 가급적이면 짧게 한다. SPD 연결도체의 길이는 <그림 2>와 같이 0.5 m를 초과하지 않게 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-009",
      "text": "SPD 연결도체는 단면적 10 mm² 이상의 동선과 이와 동등 이상이어야 한다. 단, 건축물에 피뢰설비가 없는 경우는 단면적 4 mm² 이상도 가능하다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-010",
      "text": "SPD가 누전차단기의 부하 측에 설치되는 경우 누전차단기는 시간지연장치 유무에 관계없이 최소 3 kA, 8/20 µs의 서지전류에 대한 내성을 가져야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-011",
      "text": "설비 인입구 또는 주배전반 등에 설치하는 SPD는 LPS가 있는 건축물은 내충격 범주 I, LPS가 없는 건축물은 내충격 범주 II 이어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-012",
      "text": "기기에 근접하여 설치하는 SPD는 내충격 범주 II 또는 III 이어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-013",
      "text": "SPD의 최대연속동작전압 Uc 는 설치되는 전력계통의 종류와 이에 접속되는 장소에 따라 <표 5>의 값 이상이어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-014",
      "text": "SPD는 저압계통 내의 사고(중성선 단선 사고는 제외)로 인한 순간 과전압(UTOV)에 견뎌야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-015",
      "text": "고압계통 내의 지락사고로 인한 순간 과전압에 대해 기기를 보호하기 위하여 상도체 또는 중성선과 보호도체 사이에 접속되는 주 SPD는 관련 규격의 시험에 합격한 것이어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-016",
      "text": "SPD의 공칭방전전류 In는 5 kA 8/20 µs 이상이어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-017",
      "text": "중성선과 보호도체 사이에 연결된 SPD에 대한 공칭방전전류 값은 3상 계통에서 20 kA 8/20, 단상 계통은 10 kA 8/20 µs 이상이어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-018",
      "text": "SPD의 뇌충격 전류 Iimp 는 KS C IEC 61312-1(뇌 전자충격 보호)에 따라 산출된 뇌충격 전류(파형 10/350 µs) 값 이상이어야 한다. 단, 뇌충격 전류의 값을 구할 수 없는 경우에는 12.5 kA 이상으로 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-019",
      "text": "중성선과 보호도체 사이에 연결된 SPD에 대한 뇌충격 전류의 값은 (1)의 규정에 따라 계산한다. 단, Iimp 의 값을 구할 수 없는 경우, 3상 계통은 50 kA 이상, 단상 계통은 25 kA 이상으로 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-020",
      "text": "같은 전력계통에 설치된 SPD가 여럿인 경우에는 SPD 간 필요한 에너지 협조를 고려하여 <그림 9>와 같은 순서대로 설치해야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-021",
      "text": "전력공급이 우선 되어야 하는 경우 보호장치는 SPD가 설치되어 있는 회로 내에 설치한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 보호장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-022",
      "text": "전력공급 보다 기기를 과전압으로부터 보호하는 것이 우선되어야 하는 경우 보호장치는 SPD가 설치되어 있는 회로의 전원 측에 설치한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 보호장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-023",
      "text": "간접접촉에 대한 감전방지는 SPD가 고장이 났을 때도 보장되어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-024",
      "text": "TN계통에서 자동 전원차단은 일반적으로 SPD의 전원측 과전류보호장치로 행한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-025",
      "text": "TT계통에서 자동 전원차단은 누전차단기의 부하 측에 SPD를 설치하여 행한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-026",
      "text": "SPD가 과전압을 보호하지 못하는 경우에는 SPD의 동작표시기 등으로 표시되어야 한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E112-027",
      "text": "설비의 인입구 또는 그 부근에서 중성선이 보호도체(PE)에 연결되어 있거나 중성선이 없는 경우에는 상도체와 주접지단자 사이 또는 상도체와 보호도체 사이에 SPD를 접속한다.",
      "guideContext": "서지보호장치 선정 및 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SPD 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E112-001",
      "term": "서지보호장치(Surge Protective Device : SPD)",
      "definition": "과도적 과전압을 제한하고 서지전류를 분류하는 것을 목적으로 하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-002",
      "term": "보조장치(Auxiliary device)",
      "definition": "SPD 분리기 및 동작표시기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-003",
      "term": "SPD 분리기(SPD disconnector)",
      "definition": "SPD를 전원계통에서 분리하기 위해 필요한 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-004",
      "term": "동작표시기(Status indicator)",
      "definition": "SPD의 동작상태를 표시하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-005",
      "term": "최대연속사용전압 Uc(Maximum continuous operating voltage)",
      "definition": "SPD에 연속적으로 인가할 수 있는 최대전압 실효값을 말하며 SPD의 정격전압과 같다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-006",
      "term": "전압 보호수준 Up(Voltage protection level)",
      "definition": "단자 사이에 걸리는 전압을 제한할 수 있는 SPD의 성능을 규정하는 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-007",
      "term": "잔류전압 Ures(Residual voltage)",
      "definition": "방전전류의 통과로 인해 SPD 단자 사이에 나타나는 전압의 피크 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-008",
      "term": "순간 과전압 UTOV(Temporary overvoltage)",
      "definition": "규정된 시간 내에 보호장치가 견딜 수 있는 일시적인 과전압을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-009",
      "term": "1.2/50 충격전압(1.2/50 Voltage impulse)",
      "definition": "전압시험 파형을 파두길이 1.2µs, 파미길이 50µs인 충격전압을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-010",
      "term": "8/20 충격전류(8/20 Current impulse)",
      "definition": "전류시험 파형으로 파두 8µs, 파미 20µs의 충격전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-011",
      "term": "공칭 방전전류 In(Nominal discharge current)",
      "definition": "SPD에 흐르는 전류파형이 8/20인 파형을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-012",
      "term": "충격전류 Iimp(Impulse current)",
      "definition": "SPD에 흐르는 전류파형이 10/350 µs 파형으로 전류 피크 값이 규정된 충격 전류와 같다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-013",
      "term": "조합파(Combination wave)",
      "definition": "개방회로 양단의 1.2/50 충격전압과 단락회로에서의 8/20 충격전류를 인가하는 발생기에서 정해지며, 개방회로의 충격전압은 Uoc 로 표시된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E112-014",
      "term": "속류 If(Follow current)",
      "definition": "SPD가 방전된 후 SPD에 공급되는 전압에 의해 흐르는 전류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
