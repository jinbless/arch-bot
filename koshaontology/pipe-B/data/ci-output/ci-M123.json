  "checklistItems": [
    {
      "identifier": "CI-M123-001",
      "text": "사고발생 빈도가 높고 사고피해의 크기가 큰 설비에 대해서는 정량적 위험성평가 방법을 사용한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성평가 방법 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-002",
      "text": "위험성평가는 절차에 따라 수행하고 얻어진 결과를 문서로서 작성한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성평가 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-003",
      "text": "설계가 개량되고 변경되었을 경우에 관련 자료를 보완하여야 한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-004",
      "text": "사고사례가 없거나 발생된 사고의 수가 적고 사고의 강도가 낮은 경우만으로 위험성이 낮다고 판단하여서는 아니된다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-005",
      "text": "사용된 정보와 자료들에 관련된 불확실한 사항들은 위험성평가 기록 문서에 표기한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 유지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-006",
      "text": "기계에 관련되는 모든 위험상태와 발생할 수 있는 사고들을 확인한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-007",
      "text": "위험도 산정은 위험에 노출되는 모든 사람들을 고려해야 한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-008",
      "text": "운전자, 정비자 등 직접 기계에 관련된 사람이외에 근처 작업자, 통행인 등 기계로 인하여 영향을 받을 수 있는 모든 사람들을 고려한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-009",
      "text": "위험에의 노출을 산정하기 위하여는 기계 운전의 모든 상태와 작업방법들을 전부 고려한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-010",
      "text": "기계의 설치, 교육, 작동절차의 변경이나 수정, 청소, 고장점검, 유지·보수 기간 중에 발생될 수 있는 위험에의 노출을 고려한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-011",
      "text": "노출이 축적되었을 때의 영향과 상승효과 등도 고려되어야 한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-012",
      "text": "작업조직개선, 행동개선, 주의, 개인보호구의 착용, 기능훈련 등의 안전조치는 설비개선 등 입증된 기술적 안전조치 보다 상대적으로 낮은 신뢰도를 가질 수 있으므로 위험도 산정에 고려 되어야 한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-013",
      "text": "위험도 산정에는 안전조치를 무효화시킬 수 있는 가능성을 고려한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-014",
      "text": "위험도 산정에는 안전조치가 요구되는 방호의 수준을 제공하는데 필요한 상태를 유지할 수 있는가를 고려한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-015",
      "text": "위험도 산정에서는 기계와 함께 사용자를 위한 정보가 충분히 제공되는지 검토한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험도 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.8",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-016",
      "text": "위험수준 감소가 필요하면 적절한 안전조치를 선정 적용하고 <그림 1>의 절차를 다시 반복한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 판단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-017",
      "text": "반복 작업을 통하여 새로운 안전조치가 취하여졌을때 다른 추가적인 위험이 발생하는지 검토하여야 한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 판단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-018",
      "text": "기계의 사용자를 위한 정보는 충분하고 명확하게 한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험수준 감소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-019",
      "text": "기계의 사용을 위한 운전절차는 기계를 사용하는 사람과 기계의 위험에 노출 될 수 있는 모든 사람들의 능력에 맞게 작성한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험수준 감소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-020",
      "text": "기계를 사용할 때 필요한 안전작업 요구사항과 이에 관련된 훈련 사항들을 적절하게 기술한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험수준 감소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-021",
      "text": "개인보호구 착용이 필요하면 적합한 사양과 사용을 위하여 필요한 훈련 사항들을 적절히 기술한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험수준 감소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M123-022",
      "text": "위험성평가의 절차별로 나타난 결과를 문서로 기록한다.",
      "guideContext": "기계류의 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 유지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M123-001",
      "term": "위험성평가",
      "definition": "가능한 한 논리적이고 시스템적인 방법으로 기계에 관련된 위험성을 진단하고, 진단된 위험성에 위험수준감소 조치를 하고 다시 평가하여 새로운 위험성을 진단하는 절차를 반복하여 위험을 최대한 제거하고 최선의 안전조치를 강구하는 과정",
      "sourceSection": "4.1",
      "relatedSR": null
    },
    {
      "identifier": "DT-M123-002",
      "term": "위험성분석",
      "definition": "기계의 위험성평가 범위를 결정하고 위험확인을 하며 위험도를 산정하는 과정으로, 위험성판단을 위하여 필요한 정보를 제공한다.",
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "DT-M123-003",
      "term": "위험성판단",
      "definition": "위험도 산정 후에 위험수준 감소가 필요한지 또는 안전하게 되었는지를 결정하는 과정",
      "sourceSection": "8.1",
      "relatedSR": null
    },
    {
      "identifier": "DT-M123-004",
      "term": "위험도",
      "definition": "피해크기와 피해 발생 가능성의 조합으로 표시되며, 위험도 = 피해크기 × 피해 발생 가능성으로 산정된다.",
      "sourceSection": "7.1.1",
      "relatedSR": null
    },
    {
      "identifier": "DT-M123-005",
      "term": "피해크기",
      "definition": "예상되는 위험으로부터 가능한 피해의 크기로, 사람·재산·환경에 대한 방호 목적물과 피해의 정도(가벼움, 심각함, 사망) 및 피해의 범위(한사람, 여러 사람)에 따라 구분된다.",
      "sourceSection": "7.1.2",
      "relatedSR": null
    },
    {
      "identifier": "DT-M123-006",
      "term": "피해 발생 가능성",
      "definition": "노출의 빈도와 기간, 위험한 사고의 발생 가능성, 피해를 없게 하거나 줄일 수 있는 가능성의 세 가지 요소로 구성된다.",
      "sourceSection": "7.1.3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M123-01",
      "processOrder": 1,
      "processName": "위험성평가를 위한 자료 수집",
      "safetyMeasures": "기계의 범위, 수명 평가 자료, 설계 도면 또는 사양서, 동력 자료, 사고 및 고장사례, 재해발생 사례를 수집하고 준비한다. 설계가 개량·변경된 경우 관련 자료를 보완하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "4.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-M123-02",
      "processOrder": 2,
      "processName": "위험성평가 범위 결정",
      "safetyMeasures": "기계의 노후화 정도, 사용범위(정상·비정상·이상작동 상태), 기계의 중요도 및 사용율, 기계 작동에 필요한 기능, 예상 사용자의 능력·경험·훈련 정도, 위험 노출 가능 인원을 고려하여 범위를 결정한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-M123-03",
      "processOrder": 3,
      "processName": "위험확인",
      "safetyMeasures": "기계에 관련되는 모든 위험상태와 발생 가능 사고를 확인한다. M-HAZOP, What-if, FMECA, FTA, ETA 등의 기법을 활용할 수 있다. 별표 1의 위험상태 및 사고 예를 참조하여 해당 기계에서 발생 가능한 상태를 검토한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-M123-04",
      "processOrder": 4,
      "processName": "위험도 산정",
      "safetyMeasures": "피해크기(사람·재산·환경)와 피해 발생 가능성(노출 빈도·기간, 사고 발생 가능성, 피해 감소 가능성)을 결정하여 위험도를 산정한다. 노출되는 모든 사람, 인간요소, 안전기능 신뢰성, 안전조치 무효화 가능성을 고려한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": null
    },
    {
      "identifier": "WP-M123-05",
      "processOrder": 5,
      "processName": "위험성 판단 및 위험수준 감소",
      "safetyMeasures": "위험수준 감소가 필요한지 판단하고, 필요 시 덜 위험한 물질 대체, 안전가드 설치 등 적절한 안전조치를 선정·적용한다. 새로운 안전조치 후 추가 위험 발생 여부를 검토하고, 목표 도달 시까지 절차를 반복한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-M123-06",
      "processOrder": 6,
      "processName": "위험성 비교",
      "safetyMeasures": "유사 기계의 안전성, 사용자와 작업방법, 위험과 위험요소, 사용조건을 비교 검토한다. 유사 기계가 안전하더라도 위험성평가 절차 수행의 필요성은 유지된다.",
      "requiredPPE": [],
      "sourceSection": "8.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-M123-07",
