  "checklistItems": [
    {
      "identifier": "CI-H62-001",
      "text": "방사성동위원소 취급 작업장 내에 눈 및 피부 세척을 위한 시설이 갖추어져 있어야 한다.",
      "guideContext": "전리방사선 노출 근로자 응급조치",
      "additionalDetail": "고농도의 방사성물질에 노출되었을 경우 즉시 응급조치가 시행될 수 있도록 작업장 내 세척시설 구비",
      "workProcessPhase": "응급조치 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H62-002",
      "text": "다량의 방사성물질을 흡입할 경우 오염이 되지 않은 물로 코와 입을 세척하고 즉시 신선한 공기가 있는 지역으로 이동시켜야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H62-003",
      "text": "응급조치를 시행하는 자는 보호의·보호장갑·호흡용보호구 등 보호구를 착용해야 한다.",
      "guideContext": "전리방사선 노출 근로자 응급조치",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H62-004",
      "text": "응급조치 후 오염된 의복, 세척용수 등은 노출 선량 추정을 위해 모아 두어야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치 후 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H62-005",
      "text": "오염된 폐기물은 방사성폐기물 전문 처리사업자를 통해 처리해야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치 후 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H62-006",
      "text": "노출선량이 연간 50 mSv를 넘지 아니하여야 하며, 임의 연속된 5년 동안 누적 노출선량이 100 mSv를 넘지 아니하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": "원자력안전법 시행령 제2조 제4호 관련 별표 1(선량한도) 기준",
      "workProcessPhase": "방사선 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H62-007",
      "text": "분말 또는 액체상태의 방사성물질에 오염된 지역 내에 근로자를 종사하도록 하는 때에는 적절한 개인전용의 호흡용보호구를 지급하고 착용하도록 하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H62-008",
      "text": "방사성물질의 흩날림 등으로 근로자의 신체가 오염될 우려가 있는 때에는 보호의·보호장갑·신발덮개·보호모 등의 보호구를 지급하고 착용하도록 하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 보호구 관리",
      "additionalDetail": "대피 시에는 공기여과식 호흡보호구(유기가스용 정화통 및 전면형) 또는 공기호흡기(대피용)를 착용한다.",
      "workProcessPhase": "보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.2.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H62-009",
      "text": "호흡용 보호구는 한국산업안전보건공단의 검정(\"안\" 마크)을 받은 것을 사용하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H62-010",
      "text": "사업주는 방사선 발생장치 또는 기기에 대하여 다음 각호의 구분에 따른 내용을 근로자가 보기 쉬운 장소에 게시하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리",
      "additionalDetail": "입자 가속장치: 장치의 종류, 방사선의 종류 및 에너지. 방사성물질 내장 기기: 기기의 종류, 방사성 동위원소의 종류 및 양(베크렐), 내장 연월일, 소유자의 성명 또는 명칭",
      "workProcessPhase": "방사선 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.3",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H62-011",
      "text": "사업주는 전리방사선 노출 업무에 근로자를 종사하도록 하는 때에는 건강장해를 예방하기 위하여 방사선 관리구역을 지정하고 다음 각 호의 사항을 게시하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리",
      "additionalDetail": "게시사항: 방사선량 측정용구의 착용에 관한 주의사항, 방사선 업무상의 주의사항, 방사선 피폭 등 사고발생시의 응급조치에 관한 사항, 그밖에 방사선 건강장해 방지에 필요한 사항",
      "workProcessPhase": "방사선 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.3",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H62-012",
      "text": "사업주는 방사선업무를 수행하는데 필요한 관계근로자외의 자가 관리구역에 출입하는 것을 금지시켜야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사선 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H62-013",
      "text": "사업주는 방사선업무에 근로자를 종사하도록 하는 때에는 전리방사선이 인체에 미치는 영향, 안전한 작업방법, 건강관리요령 등에 관한 내용을 근로자에게 널리 알려야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "안전교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "10.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H62-014",
      "text": "사업주는 전리방사선을 취급하는 실내작업장, 휴게실 또는 식당 등에 대해서는 전리방사선으로 인한 오염을 제거하기 위하여 청소를 실시하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "10.4.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H62-015",
      "text": "사업주는 방사성물질 취급 작업실 그밖에 방사성물질을 들여 마시거나 섭취할 우려가 있는 작업장에 대하여는 근로자가 담배를 피우거나 음식물을 먹지 아니하도록 경고표시 등을 게시하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.4.2",
      "basedOn": [
        "SR-HAZMAT-028"
      ]
    },
    {
      "identifier": "CI-H62-016",
      "text": "사업주는 전리방사선을 취급하는 작업에 근로자를 종사하도록 하는 때에는 세면·목욕·세탁 및 건조를 위한 시설을 설치하고 필요한 용품 및 용구를 비치하여야 한다.",
      "guideContext": "전리방사선 노출 근로자 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "위생관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10.4.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H62-001",
      "term": "선량한도",
      "definition": "외부에 피폭하는 방사선량과 내부에 피폭하는 방사선량을 합한 피폭방사선량의 상한 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H62-002",
      "term": "유효수준한도",
      "definition": "방사선에 연속 피폭될 경우, 합리적인 근거에 의해서도 피폭이 용인되지 않는 선량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H62-003",
      "term": "등가선량",
      "definition": "인체의 피폭선량을 나타낼 때, 흡수선량에 해당하는 방사선의 방사선 가중치를 곱한 양. 즉 조직 또는 장기에 흡수되는 방사선의 종류와 에너지에 따라 다르게 나타나는 생물학적 영향을 동일한 선량 값으로 나타내기 위하여 방사선 가중치를 고려하여 보정한 흡수선량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H62-004",
      "term": "전리방사선",
      "definition": "전자파 또는 입자선 중 원자에서 전자를 떼어내어 주위의 물질을 이온화 시킬 수 있는 능력을 가진 것으로서 알파선, 중양자선, 양자선, 베타선 그 밖의 중하전 입자선, 중성자선, 감마선, 엑스선 등의 에너지를 가진 입자나 파동을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H62-005",
      "term": "방사성물질",
      "definition": "원자핵 분열 생성물 등 방사선을 방출하는 방사능을 가지는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H62-006",
      "term": "방사성동위원소",
      "definition": "방사선을 방출하는 동위원소와 그 화합물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H62-007",
      "term": "방사선발생장치",
      "definition": "하전입자를 가속시켜 방사선을 발생시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H62-008",
      "term": "방사선관리구역",
      "definition": "방사선에 노출될 우려가 있는 업무를 행하는 장소를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
