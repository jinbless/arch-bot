  "checklistItems": [
    {
      "identifier": "CI-D63-001",
      "text": "안전밸브 배출배관의 흐름은 등온과정이 단열과정보다 보수적인 결과를 제시하므로 등온과정으로 가정하는 것이 좋다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-002",
      "text": "서로 반응할 수 있는 물질을 같은 배출배관에 연결하지 않아야 한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-003",
      "text": "대기로 방출하는 경우에는 안전지역으로 연결하여야 한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-004",
      "text": "배출배관은 굴곡부나 이음관의 사용을 줄이고 가능한 한 짧고 직선으로 설치하는 것이 좋다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-005",
      "text": "녹아웃 드럼(K.O drum) 등으로 연결된 배출배관은 배출 시 응축되는 액체가 녹아웃 드럼 등으로 흐르도록 1/500 이상의 기울기를 가져야 한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-006",
      "text": "배출되는 내용물질의 부식성, 온도 및 압력에 적합한 재질 및 규격으로 설치하여야 한다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D63-007",
      "text": "배출되는 물질이 냉각될 때 점성이 높아지는 물질일 경우에는 배출배관을 가열할 필요가 있다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-008",
      "text": "배출출관의 재료(개스킷 포함)는 분기관에서 다른 연결배관에서의 역류가능성과 주울-톰슨(Joule-Thomson) 효과에 의한 온도저하를 고려하여 재질을 선정하여야 한다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-D63-009",
      "text": "안전밸브 또는 파열관 작동 시의 하중이 배출배관에 과도하게 걸리는 것을 피하고, 내용물이 배출되는 동안 배관지지물의 반력을 적절히 지지할 수 있어야 한다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-D63-010",
      "text": "고온 또는 저온물질을 방출하는 경우에는 열응력을 고려하여야 하고, 안전밸브 배출 시 발생하는 진동의 영향도 고려하여야 한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-011",
      "text": "안전밸브 배출배관 중 지름이 동일한 구간의 분기되는 지점을 별도의 구간으로 나눈 후에 길이를 산정한다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": "배출배관 길이 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-042",
      "text": "각각의 안전밸브에서 최종 배기처리시설로 연결되는 배관에 대해 계통도를 작성한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "계통도 작성 예는 <부록 1>의 <그림 1>과 같다.",
      "workProcessPhase": "배출배관 계통도 작성 및 검토구간 구분",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-043",
      "text": "지름이 동일한 배관 중 분기되는 지점을 표시하고, 각 지점 사이의 구간을 검토구간으로 구분한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배출배관 계통도 작성 및 검토구간 구분",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-044",
      "text": "계통도에 포함될 수 있는 사항으로 안전밸브 관련정보(안전밸브 번호, 설정압력, 입구 및 출구측 사이즈, 안전밸브 타입) 및 안전밸브의 배출배관이 만나는 지점의 위치를 작성한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "안전밸브번호 및 배출배관의 연결지점 외의 내용은 별도의 시트에 작성할 수 있다.",
      "workProcessPhase": "배출배관 계통도 작성 및 검토구간 구분",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-045",
      "text": "안전밸브 배출지점의 안전밸브 배출용량(Required capacity), 분자량(혼합물인 경우에는 평균분자량), 온도, 점도(Viscosity) 물성치를 구한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전밸브별 물성치 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-046",
      "text": "안전밸브 배출배관의 연결지점의 물성치는 5.2.5항의 식을 통해 구한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전밸브별 물성치 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-047",
      "text": "구한 물성치를 계통도에 표시하거나 별도의 시트에 작성한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전밸브별 물성치 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-048",
      "text": "검토구간별로 실제배관길이와 배관 핏팅류의 등가길이를 확인하여 최종 배관길이를 산정한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검토구간별 배관길이 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-049",
      "text": "배관길이 산정은 4.2.1항을 따른다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검토구간별 배관길이 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-050",
      "text": "산정된 최종 구간별 배관길이는 계통도의 해당구간에 표시한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검토구간별 배관길이 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-051",
      "text": "각 안전밸브별 토출측의 최대 허용배압을 계산한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "최대 허용배압은 <표 3>의 기준을 따르며, 냉동시스템 외에는 일반적인 안전밸브의 기준을 따른다.",
      "workProcessPhase": "최대 허용배압 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-052",
      "text": "배출배관이 연결되는 지점마다 유량, 평균온도, 평균분자량, 평균점도를 산출한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "연결배관의 유량은 두 개 배관의 유량을 단순히 합산한다.",
      "workProcessPhase": "배출배관 연결지점 물성치 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-053",
      "text": "배출배관을 분석하기 위해서는 최종 배출지점에서 안전밸브까지 거슬러 올라가면서 수행하는 것이 좋다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-054",
      "text": "대기로 배출되는 경우는 최종 배출지점의 압력은 대기압이다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "배기처리시설(플레어스택, 흡수탑, 흡착탑 등)로 연결되는 경우에는 해당 시설의 압력강하 자료를 파악하거나, 적절히 최종 압력을 가정한다.",
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-055",
      "text": "최종 배출배관의 압력, 계산된 물성치를 사용하여 식 (5-5) 또는 식 (5-6)을 사용하여 배출배관 내경과 마하수(Ma₂)를 파악한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-056",
      "text": "계산된 마하수가 1 이상이면 초음속이 되어 배관의 진동 및 소음발생이 심하게 되므로 마하수가 0.8 미만이 되도록 배관의 지름을 증대시킨다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-057",
      "text": "가능한 한 마하수를 0.6 이하로 유지하는 것이 바람직하다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-058",
      "text": "<표 1>의 재질별 절대표면거칠기(ε)의 값을 사용하여 상대표면거칠기(ε/D)를 계산한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "D는 배관의 내경이다.",
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-059",
      "text": "식 (5-9)을 사용하여 레이놀즈수를 구하며, 다른 알려진 식을 사용하여 구할 수 있다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-060",
      "text": "계산된 상대표면거칠기(ε/D)와 레이놀즈수(Re)를 사용하여 <그림 2>의 무디 차트를 통해 마찰계수(f)를 구한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "식 (5-10) 또는 식 (5-11)을 사용하여 마찰계수를 구할 수도 있다.",
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-061",
      "text": "식 (5-12) 또는 식 (5-13)을 사용하여 상류측 압력(P₁)을 가정하면서 시행착오법으로 구한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": "좌우항의 값이 같을 때의 압력(P₁)값이 상류측의 압력이 된다.",
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-062",
      "text": "입구측 마하수(Ma₁)가 0.8을 초과하면 배관의 사이즈가 작으므로 보다 큰 사이즈의 배관을 선정한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-063",
      "text": "만족스러운 마하수가 될 때까지 5.2.6.2항에서 5.2.6.5항까지의 과정을 반복한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "최종 배출배관 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-064",
      "text": "말단배관의 분석이 완료되면 말단 배관구간 바로 위의 구간인 상류측 배관을 분석한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상류측 배관 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-065",
      "text": "5.2.6.5항과 5.2.6.6항에서 구한 입구측 압력(P₁)과 입구측 마하수(Ma₁)는 이 분석구간에서는 출구측 압력(P₂)과 출구측 마하수(Ma₂)가 된다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상류측 배관 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-066",
      "text": "최종적으로 안전밸브 배출측에 도달될 때까지 하나씩 검토구간을 순차적으로 분석한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상류측 배관 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-067",
      "text": "최종적으로 구한 입구측 압력(P₁)과 해당 안전밸브의 최대 허용배압을 비교한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "입구측 압력과 최대 허용배압 비교",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-068",
      "text": "최종적으로 구한 입구측 압력(P₁)이 해당 안전밸브의 최대 허용배압보다 작으면 배출배관의 분석은 완료된다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "입구측 압력과 최대 허용배압 비교",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-069",
      "text": "최종적으로 구한 입구측 압력이 최대 허용배압보다 클 경우에는 안전밸브 토출측 배관의 사이즈를 증대시키거나, 안전밸브의 형식이 일반형(Conventional)이면 벨로우즈형으로 변경하여 최대 허용배압을 증대시켜 비교한다.",
      "guideContext": "안전밸브 배출배관 설계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "입구측 압력과 최대 허용배압 비교",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-070",
      "text": "계산된 입구측 압력이 최대 허용배압보다 현저히 작을 경우에는 안전밸브 배출배관 중 길이가 가장 긴 배관의 사이즈를 줄여 입구측 압력이 최대 허용배압에 근접하도록 조치할 필요가 있다.",
      "guideContext": "안전밸브 배출배관 설계",
      "additionalDetail": null,
      "workProcessPhase": "입구측 압력과 최대 허용배압 비교",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-140",
      "text": "상용금속배관의 절대표면거칠기값(ε)은 <표 2>에서 0.045 mm 이므로 상대표면거칠기(ε/d)는 배관의 내경을 단순히 나누면 된다. 이 때 같은 단위를 사용해야 한다.",
      "guideContext": "안전밸브 배출배관 설계 시 상대표면거칠기 산출 (법령 근거 미확인)",
      "additionalDetail": "상대표면거칠기 산출 시 절대표면거칠기와 배관 내경의 단위를 반드시 통일하여 계산",
      "workProcessPhase": "배관 설계 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록 1-2.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-141",
      "text": "안전밸브 출구측 배관구간에서는 산출에 의해 구한 입구측 압력과 해당 안전밸브의 최대 허용배압(MABP)을 비교한다.",
      "guideContext": "안전밸브 배출배관 설계 최대허용배압 검증",
      "additionalDetail": "C-H, C-G, D-E, D-F 구간에서 각각 수행",
      "workProcessPhase": "최대허용배압 비교",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록 1-2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-142",
      "text": "만약 해당 구간의 입구측 압력이 각각 해당 안전밸브의 최대 허용배압보다 작으면, 계산은 종료된다.",
      "guideContext": "안전밸브 배출배관 설계 완료 판정 기준",
      "additionalDetail": null,
      "workProcessPhase": "최대허용배압 비교",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록 1-2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-143",
      "text": "만약 입구측 압력이 최대 허용배압보다 크게 되면, 안전밸브 타입을 변경(예, 일반형이면 벨로우즈타입으로 변경)하거나 또는 배관의 지름을 크게 하는 방법으로 계산한다.",
      "guideContext": "안전밸브 배출배관 설계 시 최대허용배압 초과 대응",
      "additionalDetail": null,
      "workProcessPhase": "최대허용배압 비교",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "부록 1-2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D63-144",
      "text": "2.4항에서 수행했던 방법을 배관구간 B-C에 대해 동일한 방법으로 수행한다.",
      "guideContext": "안전밸브 배출배관 설계 시 연속 구간 계산",
      "additionalDetail": "2.4항에서 구한 PB 값이 이 구간에서는 P₂ 값으로 사용되며, Ma₁ 값은 Ma₂ 값으로 사용된다.",
      "workProcessPhase": "배관 설계 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록 1-2.5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-D63-001",
      "term": "최대 허용배압",
      "definition": "안전밸브 작동 시 배압에 의해 안전밸브의 기능이 저하되지 않도록 안전밸브 토출측에 작용될 수 있는 최대의 배압을 말하며, 일반적으로 일반형(Conventional type) 안전밸브의 경우에는 안전밸브 설정압력의 10% 이내이며, 벨로우즈형 안전밸브의 경우에는 안전밸브 설정압력의 50% 이내로 허용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D63-002",
      "term": "중첩배압",
      "definition": "안전밸브가 작동하기 직전에 토출측에 걸리는 정압(Static pressure)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D63-003",
      "term": "누적배압",
      "definition": "안전밸브가 작동한 후에 유체방출로 인하여 발생하는 토출측에서의 압력증가량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D63-004",
      "term": "일반형 안전밸브",
      "definition": "밸브의 토출측 배압의 변화에 의하여 직접적으로 성능특성에 영향을 받도록 만들어진 스프링 직동식 안전밸브를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D63-005",
      "term": "벨로우즈형 안전밸브",
      "definition": "밸브의 토출측배압의 변화에 의하여 성능특성에 영향을 받지 않도록 만들어진 스프링 직동식 안전밸브를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D63-006",
      "term": "파일롯트조작형 안전밸브",
      "definition": "안전밸브 자체에 내장된 보조의 안전밸브 작동에 의하여 작동되는 안전밸브를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D63-007",
      "term": "주울-톰슨 효과",
      "definition": "통상의 압력에서 압축된 기체를 단열된 구멍(노즐)을 통해 분출시키면 온도가 내려가는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-D63-01",
      "processOrder": 1,
      "processName": "배출배관 등가길이 산정",
      "safetyMeasures": "동일한 지름의 배관 중 엘보우 등과 같은 배관 핏팅류가 있으면 실제 배관길이에 핏팅류에 의한 등가배관길이를 계산하여 최종적인 배관 등가길이를 구한다. L₂ = L₁ + 핏팅류 개수 x (L/d 비) x d (내경)",
      "requiredPPE": [],
      "sourceSection": "4.2.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-11",
      "processOrder": 2,
      "processName": "배출배관 계통도 작성 및 검토구간 구분",
      "safetyMeasures": "각각의 안전밸브에서 최종 배기처리시설로 연결되는 배관에 대해 계통도를 작성하고, 지름이 동일한 배관 중 분기되는 지점을 표시하여 각 지점 사이의 구간을 검토구간으로 구분한다. 안전밸브 번호, 설정압력, 입구 및 출구측 사이즈, 안전밸브 타입 및 배출배관 연결지점 위치를 포함한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-12",
      "processOrder": 3,
      "processName": "안전밸브별 물성치 파악",
      "safetyMeasures": "안전밸브 배출지점의 배출용량(Required capacity), 분자량(혼합물인 경우 평균분자량), 온도, 점도(Viscosity)를 구한다. 구한 물성치를 계통도에 표시하거나 별도의 시트에 작성한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-13",
      "processOrder": 4,
      "processName": "검토구간별 배관길이 산정",
      "safetyMeasures": "검토구간별로 실제배관길이와 배관 핏팅류의 등가길이를 확인하여 최종 배관길이를 산정하며, 배관길이 산정은 4.2.1항을 따른다. 산정된 최종 구간별 배관길이는 계통도의 해당구간에 표시한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-14",
      "processOrder": 5,
      "processName": "최대 허용배압(MABP) 산출",
      "safetyMeasures": "각 안전밸브별 토출측의 최대 허용배압을 계산한다. 일반형 안전밸브는 설정압력의 10% 이내, 벨로우즈형은 50% 이내, 파일롯 자동형은 제한없음을 기준으로 한다. 냉동시스템용은 ASHRAE 15 기준을 적용한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-15",
      "processOrder": 6,
      "processName": "배출배관 연결지점 물성치 산출",
      "safetyMeasures": "배출배관이 연결되는 지점마다 유량(합산), 평균분자량(식 5-2), 평균온도(식 5-3), 평균점도(식 5-4)를 산출한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-16",
      "processOrder": 7,
      "processName": "최종 배출배관 설계(내경, 마하수, 마찰계수, 압력 산출)",
      "safetyMeasures": "최종 배출지점 압력 선정 후 배관 내경 및 마하수(Ma₂)를 산출한다. 마하수가 1 이상이면 배관 지름을 증대시키고, 가능한 한 0.6 이하로 유지한다. 상대표면거칠기(ε/D), 레이놀즈수(Re), 마찰계수(f)를 산출하고 시행착오법으로 상류측 압력(P₁)과 입구측 마하수(Ma₁)를 구한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.6",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-17",
      "processOrder": 8,
      "processName": "상류측 배관 분석",
      "safetyMeasures": "말단배관 분석 완료 후 상류측 배관을 분석한다. 이전 구간의 입구측 압력(P₁)과 마하수(Ma₁)를 이 구간의 출구측 값으로 사용하여 안전밸브 배출측에 도달할 때까지 순차적으로 반복 분석한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.7",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-18",
      "processOrder": 9,
      "processName": "입구측 압력과 최대 허용배압 비교 및 조정",
      "safetyMeasures": "최종 입구측 압력(P₁)과 해당 안전밸브의 최대 허용배압을 비교한다. 입구측 압력이 최대 허용배압보다 크면 배관 사이즈 증대 또는 안전밸브 형식 변경(일반형→벨로우즈형)으로 조치한다. 현저히 작으면 가장 긴 배관의 사이즈를 줄여 근접시킨다.",
      "requiredPPE": [],
      "sourceSection": "5.2.8",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-36",
      "processOrder": 10,
      "processName": "최대 허용배압(MABP) 산출",
      "safetyMeasures": "개별 안전밸브 토출측의 최대 허용배압을 산출한다. 일반형은 설정압력의 10%, 벨로우즈형은 40%에 대기압을 합산하여 절대압력으로 산출한다.",
      "requiredPPE": [],
      "sourceSection": "부록 1-2.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-37",
      "processOrder": 11,
      "processName": "지점별 유량 및 물성치 산출",
      "safetyMeasures": "각 지점별로 유량을 합산하고, 혼합지점의 분자량·온도·점도를 식 (5-2), (5-3), (5-4)로 산출한다.",
      "requiredPPE": [],
      "sourceSection": "부록 1-2.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-38",
      "processOrder": 12,
      "processName": "배관 내경 및 배관 선정",
      "safetyMeasures": "출구측 마하수를 0.6으로 가정하여 식 (5-5)로 배관지름을 산출하고, 표준 배관표에서 적합한 공칭경 및 스케줄의 배관을 선정한다.",
      "requiredPPE": [],
      "sourceSection": "부록 1-2.4.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-39",
      "processOrder": 13,
      "processName": "상대표면거칠기·레이놀즈수·마찰계수·마하수·입구측 압력 산출",
      "safetyMeasures": "선정된 배관의 내경으로 상대표면거칠기, 레이놀즈수, 마찰계수(무디차트 또는 식 5-11), 출구측 마하수, 입구측 압력을 순차적으로 산출한다. 연속 구간에서는 이전 구간의 입구측 압력을 다음 구간의 출구측 압력으로 사용한다.",
      "requiredPPE": [],
      "sourceSection": "부록 1-2.4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-D63-40",
      "processOrder": 14,
      "processName": "최대허용배압(MABP) 비교 및 판정",
      "safetyMeasures": "안전밸브 출구측 배관구간(C-H, C-G, D-E, D-F)에서 산출된 입구측 압력과 해당 안전밸브의 MABP를 비교한다. 입구측 압력이 MABP보다 작으면 설계 완료이며, 초과 시 안전밸브 타입 변경 또는 배관 지름 증대 후 재계산한다.",
      "requiredPPE": [],
      "sourceSection": "부록 1-2.7",
      "relatedSR": null
    }
