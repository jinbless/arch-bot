      ]
    },
    {
      "identifier": "CI-P44-002",
      "text": "꽃불 근처에서 흡연을 금지하여야 한다.",
      "guideContext": "장난감용 꽃불 점화방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-003",
      "text": "꽃불이 저장된 장소에 출입을 엄격히 제한한다.",
      "guideContext": "장난감용 꽃불 점화방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-004",
      "text": "꽃불 근처에 가열기와 같은 고온을 발생하는 장치와 멀리한다.",
      "guideContext": "장난감용 꽃불 점화방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-005",
      "text": "미판매된 꽃불을 반납할 때는 공급자의 조언에 따른다.",
      "guideContext": "장난감용 꽃불 점화방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-006",
      "text": "꽃불은 산화제(배수 청정제 등), 인화성 물질(페인트 탈거용제(Stripper) 등) 및 부식제(목재 방부제 등) 등과 함께 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 점화방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-007",
      "text": "꽃불은 비료 및 과산화물(유리섬유 강화제 등)을 포함하는 제품 가까이에 두지 않는다.",
      "guideContext": "장난감용 꽃불 점화방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-008",
      "text": "꽃불은 축축하거나 젖지 않도록 보관한다.",
      "guideContext": "장난감용 꽃불 점화방지",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "CI-P44-009",
      "text": "꽃불을 운반할 때에는 마찰 또는 동요되거나 굴러 떨어지지 않도록 하고 발화성 또는 인화성 물질, 외장이 불안정하여 꽃불에 마찰 또는 충격을 줄 염려가 있는 물질, 칠재류, 독물 등 유해성 물질과 함께 운반하지 않는다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-010",
      "text": "가연물과 격리된 적절한 저장소 및 캐비닛과 같은 진열장에 보관한다.",
      "guideContext": "장난감용 꽃불 화염확산방지",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-P44-011",
      "text": "꽃불을 저장소나 공연장으로 이동할 때에는 밀폐된 이동(Transport)상자를 이용하여 운반한다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-012",
      "text": "꼭 필요하지 않은 꽃불은 취급하지 않는다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-013",
      "text": "꽃불이 금속제 쓰레기통으로 유입되지 않도록 한다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-014",
      "text": "꽃불은 쉽게 연소할 수 있는 물질근처에 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-015",
      "text": "꽃불은 화재가 확산될 수 있는 물질근처에 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-016",
      "text": "주정이나 나이론 양말과 같은 인화성 물질과 함께 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-017",
      "text": "팔렛, 판지, 상자나 지류 등 물질과 가까이에 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-018",
      "text": "주차된 차량 근처에 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 화염확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-019",
      "text": "꽃불 취급지역에 있는 모든 꽃불은 적절히 진열되고 저장되는지 확인하여야 한다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 진열",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-020",
      "text": "화재나 폭발을 대비한 모든 대피통로 및 출구는 명확하게 표시하고 비상구는 잠겨 있지 않아야 한다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-P44-021",
      "text": "화재감지 및 경보시스템을 주기적으로 검사(Test)하고 정확하게 작동되도록 하여야 한다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-022",
      "text": "화재 시 취하여야 할 최우선 사항은 화재 지역 내에서 근로자나 고객이 가능한 한 빨리 대피하는 것임을 모든 구성원이 알도록 하여야 한다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-023",
      "text": "꽃불을 취급하는 장소에 저장되는 양은 가급적 줄이고 이 양을 신중히 고려하여 관리하여야 한다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-024",
      "text": "이동저장설비는 이웃이나 공공지역으로부터 멀리 떨어지도록 한다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-025",
      "text": "대피통로나 비상구 근처에는 꽃불을 저장하거나 진열하지 않는다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-026",
      "text": "저장소나 간이 저장소에 과잉의 꽃불을 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-027",
      "text": "허가 및 등록된 양보다 많은 양을 저장하지 않는다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-028",
      "text": "공동주택이나 소규모 주택이 있는 건물 인근에 꽃불 취급 장소가 있다면 특별한 주의가 요구된다. 이때는 허가당국에 더 많은 정보를 요구한다.",
      "guideContext": "장난감용 꽃불 화재 시 인적손상방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-029",
      "text": "장난감용 꽃불의 종류와 특성을 파악하여 그 특성에 맞도록 사용하여야 한다. 특히 불꽃·불티 또는 꽃불을 내는 것은 불꽃길이가 180 ㎝ 이하여야 하고 날기를 주로 하는 것은 지상으로부터 나는 높이가 5 m 이상이어야 하므로 이러한 특성에 적합하게 사용해야 한다.",
      "guideContext": "장난감용 꽃불 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-030",
      "text": "장난감용 꽃불을 발사할 때에는 꽃불의 특성에 적합한 장소에서 사용설명서에 정한 지시에 따라 발사하여야 한다.",
      "guideContext": "장난감용 꽃불 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-031",
      "text": "장난감용 꽃불을 발사할 때에는 사람이나 가연성 물질이 있는 방향으로 발사하지 말고 바람을 등지고 발사하도록 한다.",
      "guideContext": "장난감용 꽃불 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P44-032",
      "text": "한꺼번에 규정량 이상의 꽃불을 발사하지 않는다.",
      "guideContext": "장난감용 꽃불 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "꽃불 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P44-001",
      "term": "꽃불",
      "definition": "산화제와 조연제에 불꽃의 색을 내는 금속화합물을 혼합하여 연소 시 여러 가지 색을 발휘할 수 있는 화공품으로 총이나 포로 쏘아 날리는 타오르는 불꽃을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P44-002",
      "term": "장난감용 꽃불",
      "definition": "10 g 정도의 화약을 이용하여 불꽃 불티 또는 꽃불을 주로 내거나 회전, 달리기, 날기, 위로 쏘아 올리기 등을 주로 하는 것, 또는 폭발음을 주로 내는 것과 같은 일정한 기능을 가진 화공품으로 총포 도검 화약류 등 단속법 시행규칙 제4조에 규정된 장난감용 꽃불을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
