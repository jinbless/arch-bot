  ],
  "domainTerms": [
    {
      "identifier": "DT-M57-001",
      "term": "압출기(Extruder)",
      "definition": "호퍼를 통하여 공급된 펠릿(pellet)상, 또는 분말상의 고체재료를 용융시킨 후 이것을 다이를 통해 압출하는데 필요한 압력을 발생시켜 파이프, 막대, 프로파일, 시트, 필름, 섬유, 피복전선 등과 같은 제품을 연속적으로 제조하는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M57-002",
      "term": "인취기(Haul-off)",
      "definition": "적당한 인장력과 맥동을 하지 않은 인장속도로 인출된 파이프나 시트 등의 치수를 균일하게 유지하여 인취하는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M57-003",
      "term": "절단장치",
      "definition": "인취로울러에 의하여 보내지는 시트를 필요한 크기로 자르는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M57-004",
      "term": "가동유지장치(Hold to run)",
      "definition": "수동으로 버튼을 누를 때에만 작동되고 버튼을 놓으면 자동으로 정지되는 조작 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M57-005",
      "term": "위험요인(Hazard)",
      "definition": "신체의 손상이나 상해를 초래할 수 있는 근원을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M57-006",
      "term": "가드",
      "definition": "기계의 일부로서 방호기능을 수행하는 물리적 방벽이며 케이싱, 덮개, 스크린, 문, 울타리(방호울) 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M57-007",
      "term": "고정식 가드(Fixed guard)",
      "definition": "가드가 특정위치에 용접 등으로 영구적으로 고정되거나 고정 장치(스크류, 너트 등)로 부착된 구조로서, 공구를 사용하지 아니하고는 가드의 제거 또는 개방이 불가능한 구조의 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M57-008",
      "term": "연동식 가드(Interlocking guard)",
      "definition": "기계의 위험한 부분이 가드로 방호되어 가드가 닫혀야 만 작동될 수 있고 가드가 열리면 정지명령이 주어지는 연동장치와 조합된 가드를 말한다. 단, 가드가 닫혔을 때 기계의 작동이 초기화되는 방식을 의미하는 것은 아니다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M57-01",
      "processOrder": 1,
      "processName": "압출기 청소작업(Purging) 및 금형 교체",
      "safetyMeasures": "청소작업 시 속도와 압력을 낮추어 작업할 것. 고온 기계 부품이나 압출 플라스틱을 취급하는 동안 내열성 장갑/보호용 장갑을 사용할 것. 용융 플라스틱으로 인한 위험이 있는 모든 작업에 대해 보안면과 안전모를 착용할 것. 압출기가 작동하는 동안 금형 바로 앞에 서지 말 것. 작업 구역 내 인원을 최소화하고 금형을 위한 적절한 양중장치가 있는지 확인할 것.",
      "requiredPPE": [
        "내열성 장갑",
        "보호용 장갑",
        "보안면",
        "안전모"
      ],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "WP-M57-02",
      "processOrder": 2,
      "processName": "인취기 설정 및 송급",
      "safetyMeasures": "인취기 정지 상태에서 사전 조정(정렬) 실시. 작업 시작 전 생산라인 모든 요소 조정. 온도가 낮은 재료 취급 시 장갑 미착용, 고온 재료 시 밀착형 장갑 선택. 인취기 정지 상태 송급 불가 시 로프나 기존 생산품 여유 부분 사용. 움직이는 인취기 위험지역 접근 시 추가 안전조치(협착방지장치, 가동유지장치) 적용.",
      "requiredPPE": [
        "밀착형 장갑"
      ],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-MACHINE-038"
      ]
    },
    {
      "identifier": "WP-M57-03",
      "processOrder": 3,
      "processName": "일일 안전점검 (작업자 체크리스트)",
      "safetyMeasures": "매일 또는 금형 변경 후 수행. 고정형/연동형 가드 상태 및 고정 확인, 연동장치 정렬·부착 확인, 연동형 가드 개방 시 즉시 정지 확인, 제어반 잠김 확인, 끼임예방장치 작동 확인, 안전장치 손상 여부 확인.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": [
        "SR-MACHINE-043"
      ]
    },
    {
      "identifier": "WP-M57-04",
      "processOrder": 4,
      "processName": "월간 정기 점검",
      "safetyMeasures": "매월 수행. 고정형 가드 설치 상태, 연동장치 연결·부착 상태, 비상정지장치 작동, 전기배선 상태, 고압호스 상태, 단열재·경고표지 상태, 온도제어기 작동(압출기), 인취기 안정성, 조정가능 가드 조정 상태 점검.",
      "requiredPPE": [],
      "sourceSection": "9",
      "relatedSR": null
    }
  ],
