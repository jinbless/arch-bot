  "checklistItems": [
    {
      "identifier": "CI-X41-001",
      "text": "사업주는 단독작업자의 작업활동으로 인해 발생할 수 있는 안전보건에 대한 책임이 있으며, 그 책임을 단독작업자에게 전가시키지 않아야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-002",
      "text": "사업주는 단독작업자 및 단독작업자에 의해 영향을 받을 수 있는 특정인에게 관련된 대해서도 리스크 평가를 수행하여야 하며, 리스크 평가의 산출물에 따라 리스크를 회피하거나 통제하기 위한 적절한 조치가 취해졌는지 확인하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-003",
      "text": "사업주는 단독작업자에게 발생할 수 있는 리스크를 평가하고, 통제하기 위하여 필요한 리스크 평가를 할 때 근로자나 근로자 대표를 참여시켰는지 확인하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-004",
      "text": "사업주는 단독작업자에게 발생할 수 있는 리스크를 평가하고, 통제하기 위하여 교육, 감독, 개인용 보호구 지급 등의 통제수단이 있는지를 조사하였는지 확인하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-005",
      "text": "사업주는 단독작업자에게 발생할 수 있는 리스크를 평가하고, 통제하기 위하여 매년 또는 작업활동에 커다란 변화가 있을 때 리스크 평가의 산출물을 검토하였는지 확인하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-006",
      "text": "리스크 평가를 통해 단독작업자의 작업이 불안전한 것으로 확인되면 도움이나 지원을 제공하는 조치를 취하여 리스크를 적절히 관리하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-007",
      "text": "유기화합물을 취급하는 사업장에서 감시인이 없는 동안은 작업자가 밀폐공간 내에 들어가서 혼자서 작업하지 않도록 하여야 한다.",
      "guideContext": "단독작업 리스크 통제",
      "additionalDetail": "기타 자세한 사항은 안전보건기술지침 \"유기화합물 취급 관리지침\"을 참조한다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-X41-008",
      "text": "잠수작업이 필요한 경우에 잠수사가 혼자서 수중에서 작업하지 않도록 하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": "기타 자세한 사항은 안전보건기술지침 \"잠수작업 안전기술지침\"을 참조한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-009",
      "text": "건설공사 현장의 인력굴착 작업은 가급적 단독작업을 피하고, 최소 2인 이상이 함께 작업하도록 한다.",
      "guideContext": "단독작업 리스크 통제",
      "additionalDetail": "기타 자세한 사항은 안전보건기술지침 \"굴착공사 표준안전작업지침\"을 참조한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-EXCAVATION-001"
      ]
    },
    {
      "identifier": "CI-X41-010",
      "text": "활선작업 시 주상에서의 방호작업은 원칙적으로 2명으로 하고, 단독작업은 금지하여야 한다.",
      "guideContext": "단독작업 리스크 통제",
      "additionalDetail": "기타 자세한 사항은 안전보건기술지침 \"정전작업 및 활선작업 등에 관한 기술지침\"을 참조한다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-X41-011",
      "text": "사업주는 단독작업자의 작업활동에 적용되는 법규를 인지하고, 법적 의무사항을 준수하는지를 확인하고 평가하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-012",
      "text": "단독작업자가 보다 많은 리스크에 노출되지 않도록 추가적인 통제조치를 하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 통제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-013",
      "text": "정상작업과 예측 가능한 비상사태(예로, 화재, 장비 고장, 질병 및 사고 등)를 모두 고려하여 예방조치를 세워야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 통제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-014",
      "text": "사업주는 단독작업자의 작업환경을 점검하고, 단독작업자가 작업하는 구역에 특정 리스크의 존재 여부, 단독작업자를 위한 안전통로의 존재 여부, 단독작업자가 접근장비(이동사다리, 발판 등)를 안전하게 취급가능한지 여부, 작업장 내에 있는 기계장치와 화물이 단독작업자에 의해 안전하게 취급가능한지 여부, 단독작업자에게 리스크를 일으킬 수 있는 특정 화학물질이나 위험물질의 노출 여부, 단독작업자가 들기 힘든 과중한 물체를 들어 올리는 작업의 존재 여부, 장비의 안전한 운전을 위하여 제어장치를 작동하는데 1인 이상의 작업자가 필요한지 여부, 폭력 리스크 존재 여부, 경험이 적은 작업자 임산부 또는 장애를 가진 작업자가 단독으로 일할 때 특별한 리스크의 존재 여부, 한국어를 사용하지 못하는 외국인이 비상상황에서 명확한 의사소통을 할 수 있도록 적절한 조치가 있는지 여부를 확인하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리스크 통제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-015",
      "text": "질환이 있는 작업자가 단독작업을 하는 경우에는 업무적합성평가 결과에 따른다.",
      "guideContext": "단독작업 리스크 통제",
      "additionalDetail": "사업주는 단독작업자에게 육체적 및 정신적 부담을 줄 수 있는 작업과 예측 가능한 비상상황을 고려하여야 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-016",
      "text": "사업주는 작업자가 수행할 단독작업에 충분한 경험을 가지고 있는지를 확인하여야 하며, 작업시작 전 단독작업과 관련된 리스크와 예방대책에 대해 확실하게 이해할 수 있도록 교육과 훈련을 제공하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-017",
      "text": "사업주는 단독작업자가 단독으로 수행할 수 있는(또는 수행할 수 없는) 작업의 범위를 설정하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-018",
      "text": "사업주는 단독작업자가 경험하지 못한 작업이나 교육·훈련을 받지 못한 작업을 할 때 발생할 수 있는 리스크를 해결할 수 있는지 확인하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-019",
      "text": "사업주는 단독작업자가 지속적인 감시의 대상이 아닐지라도 단독작업자가 작업과 관련된 리스크를 이해하고 있는지 그리고 안전보건에 필요한 예방대책을 이행하는지를 정기적인 감시를 통해 확인하여야 한다.",
      "guideContext": "단독작업 리스크 통제",
      "additionalDetail": null,
      "workProcessPhase": "감시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-MGMT-005"
      ]
    },
    {
      "identifier": "CI-X41-020",
      "text": "단독작업자의 안전보건을 위하여 적절한 감시가 필요하며, 감시 절차서에는 단독작업자를 주기적으로 방문하거나 감시하는 자의 성명, 단독작업자와 감시자 사이의 정기적인 연락여부, 단독작업자로부터 정기적인 특정신호를 받지 못했을 때 작동하는 자동경보장치의 이상 유무, 비상 시 경보를 울리도록 설계된 기타 장치들의 이상 유무, 작업완료 후 단독작업자가 원위치로 복귀했음을 확인하기 위한 절차의 수행 여부를 표기하여야 한다.",
      "guideContext": "단독작업 리스크 통제",
      "additionalDetail": null,
      "workProcessPhase": "감시",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-MGMT-005"
      ]
    },
    {
      "identifier": "CI-X41-021",
      "text": "단독작업자가 작업 중 아프거나 사고 등과 같은 비상사태가 발생할 수 있으므로, 비상조치절차를 수립하여 사전에 작업자에게 교육시켜야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-022",
      "text": "단독작업이 행하여지는 장소에는 상호연락 가능한 신호기구(무전기) 등을 휴대하고 유사시 비상연락이 가능하도록 하여야 하며, 특히 위험한 장소에는 CCTV 등을 설치하는 등 신속한 상황전파 체계를 확보하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-023",
      "text": "작업장 내 비상조치절차와 위험구역에 대한 정보를 단독작업자에게 제공하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X41-024",
      "text": "단독작업자에게 단독작업 장소 인근 응급치료 시설에 대한 정보를 제공하여야 하고, 이동작업자는 경미한 부상을 대비하여 적절한 구급상자를 휴대하여야 한다.",
      "guideContext": "단독작업 리스크 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-X41-001",
      "term": "단독작업자",
      "definition": "직접적인 감독이 없는 상태에서 고정된 시설물에서 근무하는 사람, 즉 건물이 딸린 부지(지역)구내에서 혼자 일하는 사람 (가게, 주유소, 간이매점 등), 자택근무자, 사람들과 떨어져 단독으로 일하는 사람 (공장, 창고, 연구 및 교육 기관, 레저 센터, 박람회장 등), 정상적인 근무시간 이외의 시간에 일하는 사람(청소부, 경비원, 수리공 등) 및 이동작업자 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X41-002",
      "term": "이동작업자",
