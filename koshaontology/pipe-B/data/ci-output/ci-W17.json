  "domainTerms": [
    {
      "identifier": "DT-W17-001",
      "term": "한랭",
      "definition": "냉각원에 의하여 근로자에게 동상 등의 건강장해를 유발할 수 있는 차가운 온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-004"
      ]
    },
    {
      "identifier": "DT-W17-002",
      "term": "한랭환경",
      "definition": "「2.적용범위 (1),(2),(3)」에 해당하는 장소에서의 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-004"
      ]
    },
    {
      "identifier": "DT-W17-003",
      "term": "등가냉각온도",
      "definition": "기온과 기류를 조합하여 작업자가 실제 느끼는 체감온도를 말하며 복사열은 고려하지 않았다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W17-004",
      "term": "작업대사율",
      "definition": "작업할 때 소비되는 열량을 나타내기 위하여 성별, 연령별 및 체격의 크기를 고려한 지수로써 다음의 식으로 계산한다. 작업대사율 = (작업에 소요된 에너지대사량-안정시 에너지대사량) / 기초대사량",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W17-005",
      "term": "Clo(Clothing and Thermal Insulation) 값",
      "definition": "의복에 의한 보온효과를 나타내는 보정계수를 말하며 1 Clo는 피부와 주위 기온 사이의 온도차에 대해 복사와 대류에 의한 5.55 Kcal/m²/hr의 열교환 값을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W17-006",
      "term": "경작업",
      "definition": "190Kcal까지의 열량이 소요되는 작업을 말하며, 앉아서 또는 서서 기계의 조정을 하기 위하여 손 또는 팔을 가볍게 쓰는 일 등을 뜻한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W17-007",
      "term": "중등작업",
      "definition": "시간당 191~350Kcal의 열량이 소요되는 작업을 말하며, 물체를 들거나 밀면서 걸어다니는 일 등을 뜻한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W17-008",
      "term": "중작업",
      "definition": "시간당 350~500Kcal의 열량이 소요되는 작업을 말하며, 곡괭이질 또는 삽질하는 일 등을 뜻한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-W17-01",
      "processOrder": 1,
      "processName": "한랭 측정 및 평가",
      "safetyMeasures": "측정대상 인자는 기온과 기류로 하며, 6개월에 1회 이상 정기적으로 측정한다. 기온은 0.5도 이하 간격의 온도계, 기류는 0~20 m/s 범위 측정기기를 사용한다. 바닥면 50~150cm 위치에서 측정하고, 설치 후 5분 이상 대기 후 측정한다. 등가냉각온도를 산출하여 위험 및 조치영역을 구분하고, Clo 값과 작업부하를 평가하여 노출기준 및 연속작업시간을 결정한다.",
      "requiredPPE": [],
      "sourceSection": "4.(2)",
      "relatedSR": [
        "SR-HEAT-004"
      ]
    },
    {
      "identifier": "WP-W17-02",
      "processOrder": 2,
      "processName": "환경관리",
      "safetyMeasures": "실내 한랭작업의 경우 적절한 온·습도 조절장치를 설치한다. 온도계 등의 기기를 상시 작업장소에 비치하여 근로자가 온도·습도를 쉽게 알 수 있도록 한다.",
      "requiredPPE": [],
      "sourceSection": "5.(1)",
      "relatedSR": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "WP-W17-03",
      "processOrder": 3,
      "processName": "작업관리",
      "safetyMeasures": "운동지도 및 영양지도를 실시한다. 젖은 작업복은 즉시 교체하도록 한다. 한랭작업과 격리된 장소에 따뜻한 휴게시설을 설치한다. 저온물체 취급 장소에 관계자 외 출입을 금지하고 게시한다. 탈의시설, 목욕시설, 세탁시설 및 건조시설을 설치·운영한다. 순환근무를 실시하고 차가운 금속과 피부 접촉을 방지한다.",
      "requiredPPE": [
        "방한모",
        "방한화",
        "방한장갑",
        "방한복"
      ],
      "sourceSection": "5.(2)",
      "relatedSR": [
        "SR-HEAT-001",
        "SR-HEAT-004"
      ]
    },
    {
      "identifier": "WP-W17-04",
      "processOrder": 4,
      "processName": "보호구 지급 및 관리",
      "safetyMeasures": "저온물체 취급 또는 추운 장소 작업 근로자에게 방한모, 방한화, 방한장갑, 방한복을 개인전용으로 지급한다. 4℃ 이하 작업환경에서는 적절한 보호복, 젖은 곳에서는 방수복을 착용시킨다. 머리 보호구를 제공하고 보호구를 상시 점검하여 이상 시 보수 또는 교환한다.",
      "requiredPPE": [
        "방한모",
        "방한화",
        "방한장갑",
        "방한복",
        "방수복",
        "머리 보호구"
      ],
      "sourceSection": "5.(3)",
      "relatedSR": [
        "SR-HEAT-004"
      ]
    },
    {
      "identifier": "WP-W17-05",
      "processOrder": 5,
      "processName": "건강관리",
      "safetyMeasures": "건강진단 결과에 따른 건강관리 및 적정배치를 실시한다. 수면시간, 영양지도 등 건강관리지도 및 건강상담을 실시한다. 작업 전 건강상태 확인 및 작업 중 주기적 순회 상담을 한다. 따뜻한 음료를 공급한다. 고혈압 등 건강위험 근로자 배치 시 전문의 적합성 평가를 받도록 한다.",
      "requiredPPE": [],
      "sourceSection": "5.(4)",
      "relatedSR": [
        "SR-HEAT-004"
      ]
    },
    {
      "identifier": "WP-W17-06",
      "processOrder": 6,
      "processName": "응급조치",
      "safetyMeasures": "한랭장애 증상 발생 시 즉시 따뜻한 곳으로 이동하여 체온을 올리고 따뜻한 음료를 보충한다. 필요 시 의사 진찰을 받도록 한다. 긴급 연락망을 미리 작성하여 근로자에게 주지시키고, 가까운 병원 소재지와 연락처를 파악해 둔다.",
      "requiredPPE": [],
      "sourceSection": "5.(6)",
      "relatedSR": [
        "SR-HEAT-003"
      ]
    }
  ],
