  "checklistItems": [
    {
      "identifier": "CI-BE3-001",
      "text": "보호기체는 공기로 하여야 하며, 이때 사용하는 공기는 오염이나 이물질로부터 영향을 받지 아니하고, 가스등을 포함하지 않아야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-002",
      "text": "변전실등에는 가스등의 침입을 최소화하도록 설계되어야 하며, 깨끗한 공기를 보호기체로 이용하기 위하여, 가스등의 혼입을 방지하기 위한 필터 등 공기 정화기가 구비된 환기설비를 사용한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "배전반 등에 있는 전기설비는 특수한 용기 내에 넣을 필요는 없다.",
      "workProcessPhase": "양압설비 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-003",
      "text": "필요에 따라 인화성 액체의 침입을 방지하기 위하여 바닥을 높이거나 방유제 등을 사용할 수 있다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-004",
      "text": "양압설비는 배전반 등의 모든 지역에서 필요한 압력과 풍량이 공급되도록 설계한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-005",
      "text": "변전실등의 출입문 수는 양압을 유지할 수 있도록 최소한으로 하되, 안전하게 대피할 수 있도록 설치한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-006",
      "text": "양압설비의 급기력은 변전실등의 실내기압이 항상 양압(25 Pa 이상의 압력을 말한다.)을 유지하도록 하고 다음의 조치를 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "가스폭발 위험장소 또는 분진폭발 위험장소에 적합한 방폭성능을 갖는 전기 기계·기구를 변전실 등에 설치·사용한 경우에는 그러하지 아니하다.",
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-007",
      "text": "양압을 유지하기 위한 환기설비의 고장 등으로 양압이 유지되지 아니한 경우 경보를 할 수 있는 조치를 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-008",
      "text": "환기설비가 정지된 후 재가동하는 경우 변전실등에 가스 등이 있는지를 확인할 수 있는 가스검지기 등 장비의 비치를 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-009",
      "text": "환기설비에 의하여 변전실등에 공급되는 공기는 가스폭발 위험장소 또는 분진폭발 위험장소가 아닌 곳으로부터 공급되도록 하는 조치를 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-010",
      "text": "에어로크가 사용되는 경우 시간당 최소 청정 공기 유량이 에어로크 체적의 5배 이상이거나, 제한값의 25%에서 경보를 발생시키는 가스 감지기가 에어로크 내에 설치되어야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-011",
      "text": "에어로크의 각 문에는 에어로크의 문이 하나라도 열려 있으면, 그 사실을 표시해주는 장치를 눈에 잘 띄는 장소에 설치해야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-012",
      "text": "에어로크 출입 시, 한쪽 문을 열기 전에 다른 쪽 문을 닫도록 경고를 표시해야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-013",
      "text": "에어로크가 설치되지 않은 경우, 열린 문을 통해 방출되는 공기의 최소 속도는 0.3 m/s 이상이어야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-014",
      "text": "변전실등의 내부에 공기를 소비하는 장치가 있는 경우에는 공기소비량을 고려하여 양압이 유지되도록 충분한 공기를 공급하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "공기를 소비하는 장치에는 공기압축기, 실험실 후드 등이 있다.",
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-015",
      "text": "공기의 양이 충분하지 않을 경우에는 해당 장치의 공기를 별도의 공급원으로부터 공급받는 등 조치를 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-016",
      "text": "보호기체 공급설비는 변전실등의 내부 또는 외부에 설치할 수 있으나, 외부나 벽면에 설치할 경우에는 방폭구조의 것을 사용하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호기체 공급설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE3-017",
      "text": "공정 특성상 제어전원이 차단될 우려가 있는 경우에는 양압유지용 보호기체 공급설비를 다중화 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호기체 공급설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-BE3-018",
      "text": "가스누출감지경보기는 가스등, 독성이 있는 가스 또는 액체의 증기를 항상 검출하여 경보장치가 작동되도록 하여야 하며, 만약 가스등의 누출이 검출될 경우에도 상황에 따라 보호기체 공급설비를 작동시킬 수 있는 시스템을 갖추어야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호기체 공급설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-019",
      "text": "급기구는 가스등 또는 독성가스등, 그 밖의 오염된 공기가 변전실등의 실내로 유입되지 아니하도록 안전한 장소에 위치하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "공기는 가스, 분진 등이 존재할 우려가 적은 지역에서 흡입하며, 팬 흡입구의 높이는 가스·증기·먼지의 밀도에 따라 결정한다.",
      "workProcessPhase": "급기구 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-020",
      "text": "급기덕트는 누설부분이 없어야 하며, 부식이나 외부로부터 물리적인 손상이 없도록 적절한 보호장치를 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "급기구 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-021",
      "text": "폭발위험장소와 접한 곳에는 개방된 창문 등의 설치를 금지하고, 틈새가 생기지 않도록 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "급기구 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-022",
      "text": "급기덕트 및 접속부품의 재료는 불연성의 자재로 시공하고, 설치장소에 적합한 강도와 내식성이 있어야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "급기덕트 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-023",
      "text": "덕트 및 접속부품의 강도는 최대사용압력의 1.5배에 견딜 수 있도록 하되, 최소한 200 Pa 이상의 압력에 견딜 수 있어야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "급기덕트 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-024",
      "text": "덕트 및 접속부품이 사용 중의 과도한 압력으로 변형을 일으킬 우려가 있는 경우에는 적절한 보호장치를 설치하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "급기덕트 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-025",
      "text": "급기덕트의 수량, 설치 위치 및 크기는 변전실등의 실내 양압을 유지하거나 퍼지 시키기에 충분한 급기량을 확보할 수 있어야 하며, 보호대상 설비의 배치 상태 및 구조와의 관계를 고려하여 선정하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "급기덕트 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-026",
      "text": "급기덕트가 폭발위험장소를 통과하는 경우에는 가스등이 덕트 내부로 유입되지 않도록 급기덕트 내부압력이 해당 폭발위험장소의 기압보다 높아야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "급기덕트가 밀봉된 구조인 경우에는 예외로 한다.",
      "workProcessPhase": "급기덕트 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-027",
      "text": "변전실 등의 내부로 인입되는 케이블·전선관·덕트 등은 가스등이 해당 설비를 통하여 실내로 유입되는 것을 방지하고, 실내의 양압이 유효하게 유지될 수 있도록 실링재나 건조한 모래 등을 사용하여 밀봉시켜야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "전선관 및 덕트 인입부 시공",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-028",
      "text": "배기구가 폭발위험장소 쪽으로 개방되어 있는 경우, 급기장치의 고장으로 인하여 양압이 유지되지 않을 때에는 외부로부터 가스등의 유입을 방지하기 위한 자동차단밸브를 설치하도록 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "배기구 자동차단밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-029",
      "text": "양압설비의 전원은 변전실등의 입력전원 차단장치 앞단의 주 전원선에서 분기하거나 별도로 독립된 전원을 사용하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-BE3-030",
      "text": "양압설비의 조작스위치, 전선로, 전동기 등은 양압이 유지되지 않았을 때를 감안하여 해당 폭발위험장소에 적합한 방폭구조로 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE3-031",
      "text": "양압설비의 고장은 팬의 배출구 끝에서 감지할 수 있도록 하여야 하며, 필요한 조치를 취할 수 있는 근무자가 즉각 감지할 수 있는 장소에 경보기를 설치하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-032",
      "text": "양압설비의 고장 시 전기공급의 차단은 양압실폐시 조치내용 및 전원차단 절차에 따라 이루어져야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-033",
      "text": "변전실등 내부의 적합한 위치에 가연성가스 누출감지경보기를 설치하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-034",
      "text": "전등, 전화기와 같이 양압실폐시에도 전원이 투입되어야 하는 모든 전기기기는 양압실폐시 기기가 설치될 장소에 적합한 방폭구조의 것을 사용하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "보호장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE3-035",
      "text": "변전실등의 내부에는 기압계 또는 유속계를 설치하여 양압 유지상태를 감시하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "양압의 저하를 감지하는 장치로는 유량스위치, 압력스위치 등이 있으며, 팬 전동기의 전기 연동장치는 벨트의 미끄러짐, 느슨한 날개, 팬의 역회전 등을 감지하지 못하므로 적절하지 아니하다.",
      "workProcessPhase": "보호장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-036",
      "text": "양압실폐시 폭발위험장소로 구분되는 변전실등의 경우, 해당 폭발위험장소에 적합하지 않은 전기기기의 전원을 투입하기 전에 변전실등의 내부가 비폭발위험장소인 것을 확인하거나 비위험으로 간주될 때까지 충분한 시간동안 퍼지 시켜야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "비폭발위험장소로 확인되는 경우는 용기, 부속덕트 등 실내 모든 지점에서의 가스 농도가 해당 가스 폭발하한값의 25% 이하인 때이며, 측정위치는 가스 농도가 가장 높은 곳이어야 한다.",
      "workProcessPhase": "퍼지 및 전원투입",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-037",
      "text": "퍼지용 보호기체의 최소량은 실내와 부속덕트 내부용적 합의 5배 이상이다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "퍼지 및 전원투입",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-038",
      "text": "전원을 투입하기 전에 변전실등의 실내는 양압을 유지시킨다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "퍼지 및 전원투입",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-039",
      "text": "양압설비가 정지된 후, 기기를 재가동할 경우에는 사전에 변전실등의 실내를 충분히 퍼지시켜 실내의 적정 양압이 유지된 이후에 전원을 투입하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "퍼지 및 전원투입",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-040",
      "text": "양압실폐시 또는 양압설비 정지 후, 변전실등을 안전하게 통전시키기 위한 규정이 마련되어야 한다. 이 규정에는 변전실등의 실내에 가스등이 위험한 정도로 존재하고 있는 지를 확인하기 위하여 가스누출감지기로 검사하는 내용이 포함되어 있어야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "퍼지 및 전원투입",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-041",
      "text": "X 가압, 즉 양압실폐시 1종장소로 구분되는 양압실의 경우 실내에 설치된 전기기기가 방폭구조의 것이 아닌 경우에는 양압실폐시 이를 알리는 적합한 경보장치(시각이나 청각 또는 둘 모두)를 설치한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압실폐시 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-042",
      "text": "X 가압, 양압실폐시 1종장소, 비방폭 전기기기의 경우 양압복귀를 위한 신속한 조치를 취한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압실폐시 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-043",
      "text": "X 가압, 양압실폐시 1종장소, 비방폭 전기기기의 경우 가능한 전원은 자동으로 신속히 차단되어야 한다. 다만, 실외의 주위 조건이 직접적으로 위험하지 않다는 것이 증명되는 경우에는 일정 지연시간을 두고 정해진 절차에 따라 전원을 차단할 수 있다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압실폐시 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-044",
      "text": "X 가압, 양압실폐시 1종장소, 2종 장소에 적합한 방폭구조 전기기기의 경우 양압실폐시 이를 알리는 적합한 경보장치(시각이나 청각 또는 둘 모두)를 설치한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압실폐시 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-045",
      "text": "X 가압, 양압실폐시 1종장소, 2종 장소 방폭구조 기기의 경우 양압복귀가 규정시간 이내에 이루어지지 않거나 가스등의 축적이 위험수준까지 상승할 경우에는 절차에 따라 전원을 차단한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압실폐시 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-046",
      "text": "Z 가압, 즉 양압실폐시 2종 장소로 구분되는 양압실의 경우, 실내에 설치되는 전기기기가 방폭구조의 것이 아닌 경우에는 적합한 경보장치 설치, 양압복귀 신속 조치, 규정시간 초과 또는 가스 위험수준 시 절차에 따른 전원 차단을 하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "양압실폐시 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-047",
      "text": "양압실을 가동하기 전에 규정된 절차에 따라 시험을 실시하여야 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": "변전실등의 구조와 보호장치에 따른 퍼지 효과 및 정상운전상태에서 모든 개구부를 닫고 최소유량으로 최소 양압의 유지가능 여부를 확인한다.",
      "workProcessPhase": "시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-048",
      "text": "양압설비를 한 변전실등의 모든 문에는 \"경고-양압실-문을 닫을 것\" 등과 같은 표시를 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-049",
      "text": "변전실등 실내의 보기 쉬운 위치에는 실내 최소 양압 또는 보호기체의 최소유량을 표시한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "CI-BE3-050",
      "text": "양압설비에는 전기기기의 전원을 투입하기 전에 비위험지역으로 간주될 때까지 충분한 시간동안 환기팬을 운전하여야 하는 사항과, 양압실폐시 스위치를 차단하거나 필요시 시간지연 운전을 하여야 하는 기기 목록과 그 밖의 조치들을 부착하도록 한다.",
      "guideContext": "변전실 등의 양압유지",
      "additionalDetail": null,
      "workProcessPhase": "표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-012"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BE3-001",
      "term": "양압설비",
      "definition": "실내압이 외부의 대기압보다 높은 상태로 보호기체를 유지함으로써 외부 가스등의 실내유입을 억제하는 설비를 말하며, 보호기체 공급설비 및 그 부속설비, 덕트 및 각종 보호장치 등을 포함한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "DT-BE3-002",
      "term": "보호기체",
      "definition": "변전실 등에 양압을 유지하기 위하여 주입하거나 변전실 등에 전원을 투입하기 전 내부를 퍼지 시키기 위하여 사용하는 공기를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "DT-BE3-003",
      "term": "보호기체 공급설비",
      "definition": "양압에서 보호기체를 공급하기 위한 압축기, 송풍기, 압력용기 등을 말하며, 인입·인출 배관, 덕트, 압력조정기 등을 포함한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "DT-BE3-004",
      "term": "개구부",
      "definition": "문·창문·밀봉되지 않은 배전반·틈새 등 보호기체가 새어 나갈 수 있는 곳을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE3-005",
      "term": "퍼지",
      "definition": "가스등의 농도를 안전한 수준으로 낮추기 위하여 변전실등의 내부와 덕트 등에 충분한 양의 보호기체를 흘려 내보내는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE3-006",
      "term": "양압실",
      "definition": "양압으로 보호되고 있는 건물내부 공간을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "DT-BE3-007",
      "term": "X가압",
      "definition": "양압실 내부의 위험을 폭발위험 1종 장소에서 비폭발위험장소로 완화시키는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-012"
      ]
    },
    {
      "identifier": "DT-BE3-008",
      "term": "Z가압",
      "definition": "양압실 내부의 위험을 폭발위험 2종 장소에서 비폭발위험장소로 완화시키는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-012"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BE3-01",
      "processOrder": 1,
      "processName": "양압설비 설계",
      "safetyMeasures": "근무인원 수, 수용 설비 종류, 변전실 위치와 바람 방향, 공정설비 위치 등을 고려하여 설계한다. 보호기체는 공기로 하고 오염이나 가스등을 포함하지 않아야 한다. 가스등의 침입을 최소화하도록 설계하며, 출입문 수는 양압 유지를 위해 최소한으로 한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-ELECTRIC-012"
      ]
