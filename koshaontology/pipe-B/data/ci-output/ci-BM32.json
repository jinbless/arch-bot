  "checklistItems": [
    {
      "identifier": "CI-BM32-001",
      "text": "근로자의 안전보건을 확보하기 위하여 합리적이고 실천적인 조치를 취하고 안전관리 시스템을 제공하고 유지하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-002",
      "text": "법적의무를 다하기 위하여 안전정책을 수립하고 철강제품의 지장시스템에 대한 위험성평가를 하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-003",
      "text": "위험성 평가과정, 위험제거 실행 대책 수립 시 근로자를 참여시켜 의견을 들어야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-004",
      "text": "안전한 적재작업을 할 수 있도록 근로자에게 교육과 안전정보를 제공하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-005",
      "text": "근로자가 제품지장에 사용하는 장비가 안전하게 작동되는지 정기적으로 검사를 하고 유지관리 하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-006",
      "text": "근로자에게 적절한 안전보호구를 제공하고 착용방법에 대해 교육하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-007",
      "text": "적재된 제품이 갑자기 붕괴되거나 떨어지면 중대재해를 일으킬 수 있으므로 올바른 적재장 설계가 안전상 매우 중요하며 아래 사항을 고려하여야 한다.",
      "guideContext": "적재장 배치 설계",
      "additionalDetail": "안전한 작업장 배치, 적재장 작업시간 최소화, 이동방지용 지주·지지대·체인 설치, 크레인 위험 최소화, 안전한 접근방법 등",
      "workProcessPhase": "적재장 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-008",
      "text": "자립형 적재 및 적층형 적재는 제품들이 떨어지거나 움직여서 재해를 일으키지 않도록 건고하게 적재되도록 설계되어야 한다.",
      "guideContext": "적재방법 선정",
      "additionalDetail": null,
      "workProcessPhase": "적재시스템 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-009",
      "text": "선반형 적재대는 제품의 중량을 건딜 수 있는 안정적이고 충분한 강도를 유지하도록 설계되어야 한다.",
      "guideContext": "적재방법 선정",
      "additionalDetail": null,
      "workProcessPhase": "적재시스템 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-010",
      "text": "다양한 철강제품의 종류에 따라 안전한 적재방법을 선정하여야 하며 아래의 사항을 고려하여야 한다.",
      "guideContext": "적재방법 선정",
      "additionalDetail": "적재할 제품의 물리적 특성, 적재형태에 따른 안정성, 인양 및 취급설비의 종류, 최대무게·양·접근성, 입출고 빈도, 포장형태, 충격하중 정도, 이동 또는 붕괴 시 방책",
      "workProcessPhase": "적재시스템 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-011",
      "text": "사업주는 크레인 장비를 안전하게 활용하기 위하여 싱글·더블 호이스트의 적정 사용기준과 펜던트·리모컨의 점검 및 관리기준을 마련·이행하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "크레인 인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-012",
      "text": "크레인 구조체에 대한 주기적 비파괴 검사를 실시한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "크레인 인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-013",
      "text": "인양 케이블 및 연결고리에 대한 주기적 비파괴 검사를 실시한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "크레인 인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-014",
      "text": "적재설비 구조에 대한 주기적 비파괴 검사를 수행 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "크레인 인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-015",
      "text": "더블 호이스트 크레인은 장척·유연 재료 인양에 우선 적용하여 슬링거의 랙 내부 진입 및 상부 보행을 최소화한다.",
      "guideContext": "크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "크레인 인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-016",
      "text": "싱글 호이스트 크레인 사용 시 제품 형상·하중·접근성 등을 고려한 위험성평가를 실시하고, 필요 시 스프레더빔·태그라인 등 보조장비를 병행한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "크레인 인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-017",
      "text": "펜던트·리모컨은 전원 차단(E-stop 포함), 일일 기능점검, 오조작 방지조치 및 컨트롤-호이스트 일치 표시(색상/번호)를 실시한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "크레인 인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-018",
      "text": "사업주는 인양작업의 계획·감독·수행에 관한 기준을 마련하고, 밴딩 인양 금지, 수직 인양 원칙, 안전구역 지정, 장비점검 및 교육훈련 등을 철저히 시행하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-019",
      "text": "모든 인양작업은 유능자에 의해 계획·감독 하에 안전하게 수행하며, 단순작업은 표준계획서를, 비정형 작업은 건별 계획을 수립한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-020",
      "text": "밴딩 인양을 금지하고, 크레인은 수직 인양 원칙을 준수한다. 하중은 인원 상부를 통과할 수 없다.",
      "guideContext": "인양작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인양작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-021",
      "text": "작업자 및 방문 운전자는 지정된 안전구역을 준수하고, 시아 확보·접근 통로를 관리한다.",
      "guideContext": "인양작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인양작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-022",
      "text": "인양장비 및 부속구는 안전작업하중(Safe Working Load, SWL)/정격하중(Working Load Limit, WLL) 표시, 정기검사 및 정비를 시행하고, 사용자는 반드시 교육·훈련을 이수한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-023",
      "text": "수평으로 적재하는 것을 수직으로 적재하는 것보다 우선적으로 사용하도록 한다.",
      "guideContext": "봉강류·강관류 외팔보형 선반적재",
      "additionalDetail": null,
      "workProcessPhase": "봉강류·강관류 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-024",
      "text": "구경이 작은 경우 처짐이 발생하기 쉬우므로 중간에 받침대를 두어야 한다.",
      "guideContext": "봉강류·강관류 외팔보형 선반적재",
      "additionalDetail": null,
      "workProcessPhase": "봉강류·강관류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-025",
      "text": "U형 선반적재는 구조적 안정성 문제로 다층 적재(상호 적층)를 금지한다.",
      "guideContext": "H빔 대형 형강류 적재",
      "additionalDetail": null,
      "workProcessPhase": "H빔 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-026",
      "text": "사용 전에는 유능자가 하중 지지능력을 평가하여 표시하고, 해당 능력을 초과하지 않도록 하여야 한다.",
      "guideContext": "H빔 대형 형강류 적재",
      "additionalDetail": null,
      "workProcessPhase": "H빔 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-027",
      "text": "적재대는 정기적으로 용접부 균열 및 손상 여부를 점검하고, 이상이 발견되면 즉시 보수·교체하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "H빔 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-028",
      "text": "장기 보관이나 고하중 적재가 필요한 경우에는 외팔보형 선반적재 등 대체 적재방식을 활용하는 것이 바람직하다.",
      "guideContext": "H빔 대형 형강류 적재",
      "additionalDetail": null,
      "workProcessPhase": "H빔 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-029",
      "text": "광폭 코일을 수평 위치로 자립적 적재를 할 때는 바닥에 고정 쐐기(Chock)를 받쳐 코일의 움직임을 방지하여야 한다.",
      "guideContext": "광폭 코일 자립형 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-030",
      "text": "코일의 하중 지탱은 쐐기가 해주기 때문에 1열 위에 2열을 쌓는 것은 붕괴 위험이 있으므로 하지 않아야 한다.",
      "guideContext": "광폭 코일 자립형 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-031",
      "text": "쐐기는 코일 한쪽 당 2개씩 중앙선을 중심으로 해서 일정한 간격으로 설치한다.",
      "guideContext": "광폭 코일 자립형 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-032",
      "text": "쐐기의 각도가 적으면 마찰계수가 적어 코일이 쐐기를 넘어 이동하므로 각도를 알맞게 조정하여야 한다.",
      "guideContext": "광폭 코일 자립형 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-033",
      "text": "적재장 바닥에는 오일 등의 누출이 없도록 하여 쐐기와 바닥간의 마찰을 확보하여야 한다.",
      "guideContext": "광폭 코일 자립형 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-034",
      "text": "코일의 자립식 적재장의 이동통로 옆에는 코일의 구름을 정지시키는 지주대 등으로 스토피(Stopper)를 세워야 한다.",
      "guideContext": "광폭 코일 자립형 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-035",
      "text": "적층 높이를 낮게 유지하도록 한다. 3층 이상 쌓을 경우에는 이에 맞는 지지대를 설계하여 사용하여야 한다.",
      "guideContext": "광폭 코일 적층 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-036",
      "text": "맨 하층의 코일은 적절하게 지지 고정되어야 한다. 두 개의 인접 코일을 서로 묶어 움직이지 못하게 하여 적층으로 인한 안전성을 향상 시키도록 한다.",
      "guideContext": "광폭 코일 적층 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-037",
      "text": "코일을 정확하게 정렬하면서 상층으로 적층되어 각 코일의 중심점의 연결선 중점이 바로 상층 코일의 중심점이 되도록 한다.",
      "guideContext": "광폭 코일 적층 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-038",
      "text": "적층을 할 때에는 코일 양단에서 구름이 일어나지 않도록 고정된 구속물을 설치하도록 한다.",
      "guideContext": "광폭 코일 적층 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-039",
      "text": "바닥층의 각 코일에는 양쪽에 2개씩 고정 쐐기를 설치한다.",
      "guideContext": "광폭 코일 적층 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-040",
      "text": "바닥층의 코일은 그 지름이 10 % 이상 차이가 나지 않도록 하여 상층 코일의 안정성을 높이도록 한다.",
      "guideContext": "광폭 코일 적층 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-BM32-041",
      "text": "광폭 코일은 지지대 또는 선반형 적재를 할 때 코일이 적재장 밖으로 구름에 대비하여 구름방지 방책을 설치하여야 한다.",
      "guideContext": "광폭 코일 지지대·선반형 적재",
      "additionalDetail": null,
      "workProcessPhase": "코일류 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-042",
      "text": "적재시스템을 설계할 때 고소에 접근할 필요를 최소화 하여야 한다.",
      "guideContext": "고소 추락 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-043",
      "text": "고소에 접할 때 안전한 접근수단(안전발관, 안전작업대, 이동식 고소작업대 등)을 제공하여야 한다. 단, 이동식 사다리는 가장 불안정하다.",
      "guideContext": "고소 추락 방지",
      "additionalDetail": null,
      "workProcessPhase": "고소작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-044",
      "text": "작업대에는 안전 난간대를 설치하여야 한다.",
      "guideContext": "고소 추락 방지",
      "additionalDetail": null,
      "workProcessPhase": "고소작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-045",
      "text": "근로자들의 이동통로, 작업지역 및 적재장소를 명확히 구분할 수 있는 표시(예: 적재장 바닥에 페인트마킹 등)를 하여야 한다.",
      "guideContext": "차량 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-046",
      "text": "차량 이동통로와 근로자 이동통로는 분리하여야 하며 지정된 보행자 횡단지역을 명확히 표시하여야 한다.",
      "guideContext": "차량 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-047",
      "text": "적재된 제품이 굴러 보행자와 충돌을 막기 위해 적재장소와 보행자 통로 사이에 제품의 구름방지 방책을 설치하여야 한다. 이때 구름방지 방책은 적재제품의 이동 또는 붕괴를 막을 수 있는 충분한 강도를 가져야 한다.",
      "guideContext": "차량 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-048",
      "text": "크레인 운전원이 인양된 제품을 이동시킬 때 이동시 방해물 또는 이동통로에서 일하는 근로자를 볼 수 있어야 한다.",
      "guideContext": "운반설비 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "인양작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-049",
      "text": "제품 적재높이를 제한하여 넓은 시아를 확보하여야 한다. 특히 차량이동 통로와 근로자 보행통로가 가까울 경우 적재제품의 높이를 제한하여야 한다.",
      "guideContext": "운반설비 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-050",
      "text": "모든 작업장은 적절한 조도의 조명이 있어야 하며 필요시 시아를 넓게 하는 보조기구(예: 볼록거울 설치 또는 근로자의 형광 작업복 착용)를 설치하여야 한다.",
      "guideContext": "운반설비 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-051",
      "text": "차량 또는 운반설비의 운전자가 좋은 시아를 갖도록 사각지대를 볼 수 있는 거울을 장착하거나 폐쇄회로 텔레비전(CCTV)을 설치한 차량을 선정하도록 한다.",
      "guideContext": "운반설비 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-052",
      "text": "근로자들이 제품에 오르거나 제품을 건너뛰는 불안전한 행동을 하지 않아야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-053",
      "text": "근로자 이동통로와 작업장의 바닥단면은 오일 또는 물의 누출이 없도록 하여야 한다.",
      "guideContext": "미끄러짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-054",
      "text": "제품을 적재장 밖으로 운반하기 위하여 싣거나 내리는 지역과 차량통행로는 겨울에 눈이나 얼음이 없도록 관리하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-055",
      "text": "무질서한 적재제품의 정리정돈 또는 폐기물의 제거를 통하여 걸려 넘어지는 요인을 제거해야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-056",
      "text": "보행자 통로에는 돌출된 적재제품, 빈 팔레트 및 적재의 느슨한 포장띠 등 걸리는 위험요인이 없도록 하여야 한다.",
      "guideContext": "걸림 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-057",
      "text": "작업장 바닥 또는 도로 표면에는 패인 곳, 돌출물 또는 부적절한 배수구 덮개 등이 없어야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-058",
      "text": "크레인 운전원 등 적재장소에서 작업하는 모든 근로자는 머리 보호를 위한 안전모를 착용하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재장 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-059",
      "text": "낙하물로부터 위험을 방지하기 위해 필요시 낙하방지시설 또는 낙하물이 더 이상 이동통로로 들어오지 못하도록 정지시키는 방책을 설치하여야 한다.",
      "guideContext": "낙하물 충돌 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM32-060",
      "text": "고소 지역에서 작업할 때에는 산업안전보건법 제42조에 따른 유해·위험방지계획서에 고소작업 및 추락재해 방지대책을 포함하여 수립하고, 그 계획에 따라 안전대를 착용하고 추락방호망을 설치하여야 한다.",
      "guideContext": "철강제품 적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고소작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM32-061",
      "text": "작업장 시아 확보를 위한 충분한 조도의 채광, 경광등 및 조명시설을 확보한다.",
      "guideContext": "적재장 안전",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM32-062",
      "text": "작업장 내 원활한 의사소통을 위해 통신설비(확성기 등)를 갖추고 작업환경의 소음 기준을 설정·관리한다.",
      "guideContext": "적재장 안전",
      "additionalDetail": null,
      "workProcessPhase": "적재장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-NOISE-001"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BM32-001",
      "term": "자립형 적재(Free standing)",
      "definition": "철강제품을 지지대 또는 받침대 없이 제품 그대로를 바닥에 쌓아서 지장하는 것을 말하며 구름이나 미끄러짐이 없도록 고임목 또는 쐐기로 고정하여 적재하는 것을 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM32-002",
      "term": "선반형 적재(Racking)",
      "definition": "철강제품을 고정된 지지대 위해 설치된 가로대 선반(받침대)위에 제품을 얹어 적재하거나 세워서 지장하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM32-003",
      "term": "적충형 적재(Stacking)",
      "definition": "철강제품을 자립형 적재 또는 선반형 적재에서 여러 층으로 쌓아 지장하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BM32-01",
      "processOrder": 1,
      "processName": "적재장 배치 및 설계",
      "safetyMeasures": "안전한 작업장 배치, 적재장 작업시간 최소화, 이동방지용 지주·지지대·체인 설치, 근로자의 선반형 적재대·적충 제품 위 올라갈 필요성 최소화, 크레인 등 적재하역 장비 위험 최소화, 이동통로·발판·사다리·안전난간 등 안전한 접근방법 확보, 근로자 이동통로와 구분되는 지게차 등 운반차량의 안전한 이동통로 확보",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-CARGO-004",
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "WP-BM32-02",
