  "domainTerms": [
    {
      "identifier": "DT-H173-001",
      "term": "염료",
      "definition": "방직섬유 등 다른 물질을 염색하는데 사용하는 색소를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H173-002",
      "term": "분진",
      "definition": "근로자가 작업하는 장소에서 발생하거나 흩날리는 미세한 분말 상태의 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "DT-H173-003",
      "term": "분진작업",
      "definition": "염료 및 안료를 제조하거나 분쇄, 분말 상태의 염료 및 안료를 계량·투입·포장 등 취급하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "DT-H173-004",
      "term": "호흡기보호 프로그램",
      "definition": "분진노출에 대한 평가, 분진노출기준 초과에 따른 공학적 대책, 호흡용 보호구의 지급 및 착용, 분진의 유해성과 예방에 관한 교육, 정기적 건강진단, 기록·관리 사항 등이 포함된 호흡기질환 예방·관리를 위한 종합적인 계획을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "DT-H173-005",
      "term": "표적장기",
      "definition": "화학물질의 독성이 나타나는 특정 인체 장기를 말한다. 전신성의 독성을 나타내는 화학물질이라도 그 대부분은 모든 장기에 똑같이 독성을 나타내는 것이 아니고 1개 내지 2개의 특정장기 즉, 표적이 되는 장기에 독성을 나타낸다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H173-01",
      "processOrder": 1,
      "processName": "반응 (반응조)",
      "safetyMeasures": "반응조에 원료 투입 시 액체 및 고체원료는 저장조의 배관을 통해 투입하거나 용기에 계량한 후 작업자가 직접 투입한다. 투입 후에는 투입구를 밀폐하여야 하며, 반응 중 반응기 밀폐 상태가 미흡하면 반응액 증기 및 유해가스와 악취가 발생된다. 원료계량 및 반응기 투입 작업 시 원료증기 및 분진 발생에 유의하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "WP-H173-02",
      "processOrder": 2,
      "processName": "여과 (Filter press)",
      "safetyMeasures": "반응이 끝난 원액을 배관으로 이송하여 필터프레스에서 여과한다. 여과 시 프레트 부위 및 여액배출부위에서 반응액 증기 및 유해가스와 악취가 발생되며, 여과 후 프레트에서 염료 케익을 수거하는 과정에서도 반응액 증기 및 유해가스와 악취가 발생된다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "WP-H173-03",
      "processOrder": 3,
      "processName": "건조 (Cabinet 건조기 등)",
      "safetyMeasures": "염료 케익을 트레이에 담아 건조기에서 30℃~60℃로 약 30~48시간 건조시킨 후 건조된 제품을 운반용기에 수거한다. 트레이에서 건조된 제품을 운반용기에 수거하는 과정에서 염료분진이 발생된다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "WP-H173-04",
      "processOrder": 4,
      "processName": "분쇄 (분쇄기)",
      "safetyMeasures": "분쇄기 투입구에 건조된 제품을 소량씩 투입하고 분쇄된 제품을 혼합기로 이송하거나 용기에 담아 보관한다. 분쇄기 투입구에 제품 투입 시 염료분진이 발생되며, 분쇄된 제품을 용기에 담아 보관하는 경우 수거 과정에서도 염료분진이 발생된다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "WP-H173-05",
      "processOrder": 5,
      "processName": "혼합 (혼합기)",
      "safetyMeasures": "분쇄기에서 바로 이송하여 투입하거나 필요시 보관제품을 추가 투입한 후 일정시간 제품을 혼합한다. 혼합기에서 보관제품을 투입하는 과정에서 염료분진이 발생된다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "WP-H173-06",
      "processOrder": 6,
      "processName": "포장",
      "safetyMeasures": "혼합이 완료된 후 혼합기 배출구에서 밸브를 조작하거나 수공구를 사용하여 용기에 포장한다. 포장공정에서 대체로 분진의 발생이 많은 편이며, 염료제품에 따라 직업성 천식을 유발시킬 수 있다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-DUST-001",
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-H173-22",
      "processOrder": 7,
      "processName": "염료의 취급",
      "safetyMeasures": "필수 훈련을 받은 사람에 한하여 저장소 출입 허가 제한. 실내작업장에 밀폐설비나 국소배기장치 설치. 분진 발산 면적이 넓은 경우 전체 환기장치 설치 가능. 분말 염료의 분진 최소화를 위한 작업 점검.",
      "requiredPPE": [
        "호흡용 보호구"
      ],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-DUST-001",
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "WP-H173-23",
      "processOrder": 8,
      "processName": "이차 노출 방지 관리",
      "safetyMeasures": "벽면 광택처리로 먼지 부착 방지. 저장장소 조명 및 환기 확보. 바닥 미끄럼 방지. 용기 바닥에서 300mm 이상 보관. 표면 세척 용이하게 관리. 불필요 물건 정리 및 밀폐 보관. 정기적 환기 및 청소. 염료 처리 지역 음식·흡연 금지.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "WP-H173-24",
      "processOrder": 9,
      "processName": "염료취급 작업 및 염색기 작업 전 준비",
      "safetyMeasures": "모든 작업자 적합한 교육 및 감독. 제조자 운전 매뉴얼 엄격 준수. 제어관련 작동법·안전수칙 숙지 및 고장 보고·기록. 뚜껑·도어 개방 전 열기 배출 확인. 헝클어진 직물 해체 시 안면보호대 및 개인 보호구 착용.",
      "requiredPPE": [
        "안면보호대",
        "개인 보호구"
      ],
      "sourceSection": "6.3",
      "relatedSR": [
        "SR-CHEMICAL-024",
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-H173-25",
      "processOrder": 10,
      "processName": "반응공정",
      "safetyMeasures": "공정 밀폐화 및 국소배기장치 설치. 액상원료 자동계량장치·배관 연결 밀폐화. 밀폐 곤란 시 국소배기장치 설치(포집속도 0.5m/s 이상). 댐퍼 설치하여 배출량 조절. 반응기 밀폐형 개조. 샘플링 배관 구조로 뚜껑 개방 방지. 베타-나프틸아민 밀폐 드럼 용해 자동 투입.",
      "requiredPPE": [
        "호흡용 보호구"
      ],
      "sourceSection": "6.4",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-005"
      ]
    },
    {
