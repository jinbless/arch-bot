    },
    {
      "identifier": "WP-H102-03",
      "processOrder": 3,
      "processName": "물질관리(제거·대체)",
      "safetyMeasures": "사용제한 또는 금지대상 물질여부를 확인하고, 유해성·위험성이 높은 화학물질에 대해 대체 가능성(기술적, 경제적)을 분석하여 적절한 대체물질이 있으면 시행한다. 대체 시 MSDS 등 자료를 면밀히 검토한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H102-04",
      "processOrder": 4,
      "processName": "노출특성 파악 및 노출관리",
      "safetyMeasures": "작업공정별 노출특성을 파악하고, 밀폐·격리·원격조치, 국소배기장치 또는 전체환기 설치, 누출방지조치(부식방지, 계측장치, 경보설비, 긴급차단장치 등)를 실시한다. 출입제한, 작업시간 및 작업인원 관리로 위험노출을 최소화한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "피부 보호구"
      ],
      "sourceSection": "5.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H102-05",
      "processOrder": 5,
      "processName": "화학물질 대체 절차 수행",
      "safetyMeasures": "화학물질의 유해성·위해성 확인 → 대체물질의 탐색 및 개발 → 대체후보물질에 대한 평가 → 적용 테스트 → 화학물질 대체 → 지속적 관리의 순서로 수행한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H102-06",
      "processOrder": 6,
      "processName": "비상대응 계획 수립 및 훈련",
      "safetyMeasures": "사고 발생 시 비상조치를 위한 장비·인력 현황, 비상연락 체계, 피해 최소화 조치, 각 조직의 임무 및 행동절차를 포함하는 비상 대응 계획을 수립하고 훈련을 실시한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H102-07",
      "processOrder": 7,
      "processName": "프로그램 평가 및 시정조치",
      "safetyMeasures": "화학물질관리 활동의 성과를 정량적·정성적으로 평가하고, 결함의 근본 원인을 파악하여 시정조치를 수립한다. 원료 대체, 장비·설비 개선, 교육훈련 강화, 개인보호구 지급, 안전장치 및 경보시스템 강화 등을 포함한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
  ],
