  },
  "checklistItems": [
    {
      "identifier": "CI-M76-001",
      "text": "동력식 수동대패를 이용한 작업을 수행하기 전 근로자는 기본적인 방호요건을 확인해야 한다.",
      "guideContext": "동력식 수동대패 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-002",
      "text": "커터블록과 접촉 시에도 가드 또는 커터블록이 손상되지 않고, 무거운 가공재를 지지할 수 있을 정도의 충분한 강도 및 강성을 가진 목재 또는 알루미늄 재질을 사용하여 제작해야 한다.",
      "guideContext": "브리지 가드 요구조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-003",
      "text": "쉽게 변형되거나 커터블록이 노출되지 않도록 제작해야 한다.",
      "guideContext": "브리지 가드 요구조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-004",
      "text": "최대로 조정되었을 때 안내판과 테이블 사이의 틈을 덮을 수 있을 정도로 충분히 길게 해야 한다. 크기가 큰 기계일 경우에는 텔레스코프형 가드(Telescopic guard)를 설치할 수 있다.",
      "guideContext": "브리지 가드 요구조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-005",
      "text": "브리지 가드와 안내판 및 가공재 사이의 틈새는 최대한 가깝게 조정 되어야 한다.",
      "guideContext": "브리지 가드 요구조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-006",
      "text": "가드의 폭은 최소한 커터블록의 지름 이상이 되도록 충분히 넓어야 한다.",
      "guideContext": "브리지 가드 요구조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-007",
      "text": "공구가 없이도 쉽게 수평방향과 수직방향으로 조정할 수 있어야 한다.",
      "guideContext": "브리지 가드 요구조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-008",
      "text": "커터블록이 정지하는 동안에 접촉으로 인한 위험을 줄이기 위해서 기계는 10초 이내에 커터블록을 정지 시킬 수 있는 제동장치를 갖추어야 한다.",
      "guideContext": "제동장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-009",
      "text": "동력식 수동대패에는 원통형 커터블록만 사용해야 한다.",
      "guideContext": "커터블록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-010",
      "text": "절삭날의 돌출길이는 가능한 최소를 유지하고, 신규제작 기계의 경우 1.1 mm 이하가 되도록 해야 한다.",
      "guideContext": "커터블록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-011",
      "text": "커터블록은 회전에 따른 균형을 고려하여 설치하고, 스크루 체결식의 경우 절삭날의 최소 돌출길이 및 토크는 공구 제작사의 권고에 따라야 한다.",
      "guideContext": "커터블록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-012",
      "text": "절삭날은 가공물의 걸림(Snatching), 되튀김(Kick-back)으로 인한 재해의 위험을 줄이기 위하여 일정한 주기로 날카롭게 해 주어야 한다.",
      "guideContext": "커터블록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-013",
      "text": "절삭원과 송급 및 배출측 테이블의 가장자리 사이의 틈새거리는 가능한 작게 유지하되, 3 mm ± 2 mm 이하여야 한다.",
      "guideContext": "테이블 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-014",
      "text": "배출측 테이블의 높이는 절삭원의 직경보다 낮게 설치되지 않아야 한다.",
      "guideContext": "테이블 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-015",
      "text": "동력식 수동대패를 시험 기동하기 전 모든 방호가드는 정해진 위치에 설치되어 있어야 한다.",
      "guideContext": "테이블 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-016",
      "text": "가공재가 배출측 테이블로 약 2/3 이상 옮겨지면 오른손으로 가공재를 밀어 넣어 작업을 마무리한다. 이 경우, 가공재를 커터블록에 직접 밀어 넣지 않도록 한다.",
      "guideContext": "평면 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "평면 가공작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-017",
      "text": "모서리 가공작업시 근로자의 손이 목재를 잡고 있는 동안에는 절삭날 위로 손이 지나가지 않도록 해야 한다.",
      "guideContext": "모서리 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "모서리 가공작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-018",
      "text": "길이가 짧은 가공재의 평면을 가공 할 때에는 밀기블록을 사용한다.",
      "guideContext": "짧은 가공재의 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "짧은 가공재의 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-019",
      "text": "밀기블록에는 근로자가 견고하게 잡을 수 있는 손잡이를 부착하여야 한다.",
      "guideContext": "짧은 가공재의 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "짧은 가공재의 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-020",
      "text": "쇼우가드를 설치하는 등 근로자의 손이 커터블록에 닿지 않도록 커터블록 주변에 터널형 가드를 설치한다.",
      "guideContext": "홈가공 및 경사면 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "홈가공 및 경사면 가공작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-021",
      "text": "커터블록과 송급 및 배출 테이블 사이의 틈새에는 신체 접근을 방지하기 위한 가드를 설치한다.",
      "guideContext": "홈가공 및 경사면 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "홈가공 및 경사면 가공작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-022",
      "text": "가공재의 되튀김(Kick-back) 위험을 줄이기 위하여 날카로운 상태의 칼날을 사용한다.",
      "guideContext": "홈가공 및 경사면 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "홈가공 및 경사면 가공작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-023",
      "text": "쇼우가드는 확장 패드를 사용하여 가공재가 없는 경우에도 커터블록에 대한 접근을 효과적으로 방지할 수 있는 구조여야 한다.",
      "guideContext": "홈가공 및 경사면 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "홈가공 및 경사면 가공작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-024",
      "text": "경사면 가공작업을 하는 경우에는 가공재를 적절하게 지지해야 한다.",
      "guideContext": "홈가공 및 경사면 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경사면 가공작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-025",
      "text": "홈가공 작업을 하는 경우에는 커터블록 주변에 쇼우가드를 설치하는 등 터널형 가드를 구성하여 그 사이로 가공재가 송급되도록 해야 한다.",
      "guideContext": "홈가공 및 경사면 가공작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "홈가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-026",
      "text": "가동부에는 주기적으로 윤활을 해야 한다.",
      "guideContext": "유지 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-027",
      "text": "기계에 손상된 부위가 있는지 확인하고 필요시 손상된 부품을 교체한다.",
      "guideContext": "유지 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-028",
      "text": "가공재의 크기에 적합한 크기를 유지하도록 쇼우가드의 패드를 주기적으로 교체해야 한다.",
      "guideContext": "유지 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-029",
      "text": "고정나사는 양호한 상태를 유지하고 필요시 사용할 수 있는 예비부품 및 공구를 비치해 두어야 한다.",
      "guideContext": "유지 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M76-030",
      "text": "밀기블록의 손잡이는 주기적으로 점검하고 양호한 상태를 유지하여야 한다.",
      "guideContext": "유지 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M76-001",
      "term": "동력식 수동대패",
      "definition": "가공물을 고정시키는 두 개의 테이블 사이에 수평으로 설치되어 회전하는 커터블록(cutter block)을 이용하여 목재 또는 이와 유사한 재질의 표면을 매끄럽게 깎아서 가공하는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M76-002",
      "term": "커터블록",
      "definition": "절삭날을 고정시키는 원통형의 기둥을 말하며 이를 회전시켜서 가공재의 표면을 절삭하는 동력식 수동대패의 부품을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M76-003",
      "term": "쇼우가드",
      "definition": "넓은 판으로 이루어진 가드를 두 개 이상 이용하여 터널과 같이 가공재를 감싸는 형태로 만들어진 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M76-004",
      "term": "밀기블록",
      "definition": "가공재의 길이가 짧아 직접 가공재를 공급하여 가공해야 할 때 가공재와 근로자의 손 사이에 위치하여 커터블록이 근로자의 손에 접촉하지 못하도록 하는 도구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M76-005",
      "term": "밀기막대",
      "definition": "길이가 길거나 쇼우가드 등으로 감싸여 있어 직접 공급이 불가능한 가공재를 공급하기 위하여 가공재를 밀어주는 막대형태의 도구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M76-006",
      "term": "절삭원",
      "definition": "커터블록에 부착되어 있는 커터가 함께 회전하며 실제적인 절삭작업을 수행하는 바깥 궤적을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M76-01",
      "processOrder": 1,
      "processName": "방호장치 확인 및 테이블 설정",
