  "checklistItems": [
    {
      "identifier": "CI-G89-001",
      "text": "사업주는 객실청소 작업자에게 객실 청소작업의 특성과 위험요인, 안전작업 방법 등에 대한 안전보건교육을 실시하고 안전한 업무 절차에 따른 작업을 지시하여야 한다.",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-002",
      "text": "교육내용에는 아래 사항이 포함되어야 한다. (가) 객실 청소 작업에 따른 유해 위험요인과 안전작업 방법 (나) 청소작업 시 사용되는 물품이나 용품의 물리적·화학적 특성과 사용 시의 주의 사항",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-003",
      "text": "사업주는 객실청소 작업별 유해위험요인과 인체에 미치는 영향을 파악하고 이에 적합한 개인보호구를 작업자에게 지급해야 한다.",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-004",
      "text": "사업주는 숙박시설 내 비상구를 정상적인 상태로 항상 유지 관리해야 하며, 필요한 위치에 위험을 알리는 위험표지판을 설치하여야 한다.",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-005",
      "text": "사업주는 객실청소작업에 필요한 도구 일체를 지급하여야 한다.",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-006",
      "text": "사업주는 작업자 체크리스트를 이용해 객실 청소작업이 잘 수행되고 있는지를 평가하고 문제점을 개선한다.",
      "guideContext": "숙박시설 객실청소 작업",
      "additionalDetail": "부록 참조",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-007",
      "text": "청소 도구 및 용품은 항상 정해진 장소에 보관하고 사용 전·후에 정리정돈 및 유지관리를 철저히 하여야 한다.",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-008",
      "text": "청소도구 및 용품은 객실 각 층별로 충분한 수량을 확보하여야 한다.",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-009",
      "text": "청소도구 및 용품의 올바른 사용법과 사용 시 주의 사항을 숙지하여야 한다.",
      "guideContext": "숙박시설 객실청소 작업",
      "additionalDetail": "청소작업 시 사용되는 화학물질 포함",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-G89-010",
      "text": "보관에 필요한 충분한 공간 확보 및 정리정돈을 해야 하며 적절한 조명과 환기를 유지해야한다.",
      "guideContext": "숙박시설 화학물질 보관관리 (법령 근거 미확인)",
      "additionalDetail": "청소에 사용되는 화학물질의 안전한 보관관리",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-011",
      "text": "용기에 라벨을 이용하여 화학물질의 명칭과 유해성 및 취급상의 주의사항을 작업자가 알 수 있도록 명확히 표시하여야 한다.",
      "guideContext": "숙박시설 화학물질 보관관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G89-012",
      "text": "필요 저장량을 최소화하여 보관한다.",
      "guideContext": "숙박시설 화학물질 보관관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-013",
      "text": "천식과 피부염 증상이 있는 작업자를 작업 전 확인하고, 호흡기 관리가 필요한 작업자 및 피부염 관련 화학약품을 사용하는 작업에 배치해서는 안 된다.",
      "guideContext": "숙박시설 객실청소 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-014",
      "text": "청소를 해야 하는 객실의 수와 작업량을 미리 파악하여 작업 일정계획을 수립하여 계획대로 작업을 하도록 한다.",
      "guideContext": "숙박시설 객실청소 작업",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-015",
      "text": "작업자는 객실청소를 시작하기 전에 객실창문을 개방하고 환풍기 등을 이용하여 환기를 실시해야 하며 먼지의 흡입을 방지하기 위하여 마스크를 착용해야 한다.",
      "guideContext": "먼지 털기 및 실내 정돈 작업",
      "additionalDetail": null,
      "workProcessPhase": "먼지 털기 및 실내 정돈",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G89-016",
      "text": "쓰레기통을 비우거나, 분류할 때 알 수 없는 물질을 맨손으로 만지는 것은 손을 베이거나 감염 등의 우려가 있으므로 반드시 집게를 사용하거나 보호복과 안전장갑을 착용하고 작업해야 한다.",
      "guideContext": "먼지 털기 및 실내 정돈 작업",
      "additionalDetail": null,
      "workProcessPhase": "먼지 털기 및 실내 정돈",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-G89-017",
      "text": "청소도구 및 쓰레기수거용 봉투를 장착시킬 수 있는 청소용 운반카트를 이용해 신체에 가해지는 부담을 줄인다.",
      "guideContext": "먼지 털기 및 실내 정돈 작업",
      "additionalDetail": null,
      "workProcessPhase": "먼지 털기 및 실내 정돈",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-018",
      "text": "쓰레기통 수거 시 허리를 사용하기 보다는 무릎을 구부리거나 선 자세에서 작업한다.",
      "guideContext": "먼지 털기 및 실내 정돈 작업",
      "additionalDetail": null,
      "workProcessPhase": "먼지 털기 및 실내 정돈",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-019",
      "text": "쓰레기통 비우기 작업 시 가능하면 신체 가까이에 붙여서 들어 올리고 쓰레기통 아래 부분에 구멍을 뚫어 쓰레기통에서 쓰레기 봉지를 꺼내는 작업 시 흡착력을 감소시켜 들어 올리는데 소요되는 힘을 감소시켜준다.",
      "guideContext": "먼지 털기 및 실내 정돈 작업",
      "additionalDetail": null,
      "workProcessPhase": "먼지 털기 및 실내 정돈",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-020",
      "text": "진공청소기 또는 전동 청소기 사용 시 전선이 꼬이지 않도록 하고 피복이 벗겨진 전선은 교체한 후 사용하며, 한 콘센트에 여러 개의 전기기기 사용을 피하는 등 감전 방지에 필요한 조치를 하여야 한다.",
      "guideContext": "바닥 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "바닥 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-G89-021",
      "text": "화학약품을 사용할 때는 보호안경과 보호장갑, 보호복을 착용하고, 흐르는 물에 손 씻기를 자주 하고 건조시켜야 하며, 유해물질이 직접피부에 접촉되는 것을 방지해야 한다.",
      "guideContext": "바닥 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "바닥 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-G89-022",
      "text": "밀폐된 공간에서 락스와 세제를 혼합해서 사용하지 않는다.",
      "guideContext": "바닥 청소작업 (법령 근거 미확인)",
      "additionalDetail": "락스와 세제 혼합 시 독성 가스 발생 위험",
      "workProcessPhase": "바닥 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-023",
      "text": "락스를 사용하는 작업은 반드시 환기팬 등을 사용하거나 환기 가능한 공간에서 실시해야 하며 세제와 혼합하지 않고 각각 따로 사용해야 한다.",
      "guideContext": "바닥 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "바닥 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G89-024",
      "text": "락스 청소 후 염소기체가 빨리 증발되도록 따뜻한 물을 바닥에 부어준다.",
      "guideContext": "바닥 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "바닥 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-025",
      "text": "락스와 세제는 적정량을 사용하고 장시간의 작업은 호흡기 점막에 문제를 발생시키므로 피해야 하며 필요시 송기마스크 등 개인보호구를 착용해야 한다.",
      "guideContext": "바닥 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "바닥 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G89-026",
      "text": "가구류 이동 작업 시, 신체에 가해지는 부담을 줄이기 위해 바퀴 달린 이동용 카트 또는 바닥과의 마찰력을 감소시켜주는 도구를 사용한다.",
      "guideContext": "바닥 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "바닥 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-027",
      "text": "대걸레로 바닥 청소 작업 시, 좌우로 과도하게 뻗어 작업하거나 손목을 비트는 자세를 피하고, 똑바로 선 자세로 팔꿈치를 신체에 가까이 위치시킨 자세로 작업한다.",
      "guideContext": "바닥 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "바닥 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-028",
      "text": "욕실 등 물기가 있는 작업 공간에서는 미끄럼을 방지할 수 있는 안전화를 착용하고 객실 청소에 사용되는 화학약품으로부터 신체를 보호하기 위해 보호복, 보호장갑을 착용해야 한다.",
      "guideContext": "욕실 및 화장실 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "욕실 및 화장실 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-G89-029",
      "text": "양동이 손잡이에 패드를 대거나 단단한 플라스틱류의 지름이 큰 손잡이를 장착하여 손에 가해지는 압박을 줄이고, 쥐는 힘에 무리가 가해지지 않도록 한다.",
      "guideContext": "욕실 및 화장실 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "욕실 및 화장실 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-030",
      "text": "청소도구의 헤드부가 회전 가능한 긴 막대형의 청소도구를 사용하여 욕조 밖에서 작업함으로써 전도를 방지하고, 과도한 뻗기나 구부리기, 비틀기를 피하고 선 자세로 작업하도록 한다.",
      "guideContext": "욕실 및 화장실 청소작업",
      "additionalDetail": null,
      "workProcessPhase": "욕실 및 화장실 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-031",
      "text": "청소용 고무장갑은 내부가 잘 건조된 상태에서 착용해야하며, 장시간 사용 시 습기가 생기기 전 건조된 것과 교체하여 사용한다.",
      "guideContext": "욕실 및 화장실 청소작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "욕실 및 화장실 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-032",
      "text": "매트 들기 및 시트 깔아 끼우기 작업 전에 스트레칭 등으로 근육을 이완시켜 주고 이불보 정리 시 허리를 굽히지 말고 무릎을 굽혀 작업한다.",
      "guideContext": "침대 정리 작업",
      "additionalDetail": null,
      "workProcessPhase": "침대 정리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-033",
      "text": "간편하게 매트리스에 씌울 수 있는 매트리스용 커버를 사용하고, 가능하면 가벼운 무게의 매트리스를 사용한다.",
      "guideContext": "침대 정리 작업",
      "additionalDetail": null,
      "workProcessPhase": "침대 정리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-034",
      "text": "침대 시트 정리하는 작업 조를 2인으로 구성하여 신체적 부담을 덜어준다.",
      "guideContext": "침대 정리 작업",
      "additionalDetail": null,
      "workProcessPhase": "침대 정리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-035",
      "text": "객실 내 전기기구 점검 시 젖은 손으로 만지는 것을 피하고 습기 찬 곳에서 점검하지 않도록 한다.",
      "guideContext": "린넨류 및 비품 유지 관리 작업",
      "additionalDetail": null,
      "workProcessPhase": "린넨류 및 비품 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-036",
      "text": "린넨류 이동 작업 시 린넨 수거용 자루를 장착할 수 있는 바퀴달린 이동용 카트를 사용한다.",
      "guideContext": "린넨류 및 비품 유지 관리 작업",
      "additionalDetail": null,
      "workProcessPhase": "린넨류 및 비품 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-037",
      "text": "린넨 수거용 자루는 1/2 이상 차지 않도록 하며, 린넨류가 자루에 1/2 이상 적재된 경우에는 다른 자루에 나눠담는다.",
      "guideContext": "린넨류 및 비품 유지 관리 작업",
      "additionalDetail": null,
      "workProcessPhase": "린넨류 및 비품 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-038",
      "text": "비품이나 청소용품을 적재하고 운반할 때, 카트의 차체 및 적재물의 최대높이가 근로자의 가슴 높이를 넘지 않도록 해서 전방시야를 확보하도록 한다.",
      "guideContext": "객실 및 층간 이동작업",
      "additionalDetail": null,
      "workProcessPhase": "객실 및 층간 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-039",
      "text": "근로자에 대한 사전교육을 통해서 운반카트의 조작법을 충분히 익히도록 한다. 또한 객실 통로와 이동경로에 대해서 정확하게 숙지하고 파악하도록 한다.",
      "guideContext": "객실 및 층간 이동작업",
      "additionalDetail": null,
      "workProcessPhase": "객실 및 층간 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G89-040",
      "text": "근로자 전용통로 및 엘리베이터를 이용해서 층간 이동을 하도록 한다. 근로자 전용통로 및 엘리베이터가 없는 경우 고객과의 충돌에 주의하도록 한다.",
      "guideContext": "객실 및 층간 이동작업",
      "additionalDetail": null,
      "workProcessPhase": "객실 및 층간 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G89-001",
      "term": "숙박시설",
      "definition": "공중위생관리법에서 규정하는 호텔이나 여관 등의 숙박을 사업목적으로 하는 시설을 말한다. 다만 취사도구를 갖춘 체류형 숙박시설은 포함하지 않는다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G89-002",
      "term": "린넨류",
      "definition": "마직류를 말하는데, 숙박시설에서의 린넨이란 면류나 화학직류로 만들어진 타월, 냅킨, 시트, 담요, 유니폼, 커튼 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G89-003",
      "term": "객실청소",
      "definition": "숙박시설 내의 먼지털기 및 실내정돈, 바닥청소, 욕실 및 화장실 청소, 침대 정리, 린넨류(Linen) 및 비품 유지 관리, 객실 및 층 간 이동 작업 등 객실 및 객실에 포함된 각종 시설, 비품 등을 안전하고 깨끗하게 유지·관리하는 업무를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
