  "checklistItems": [
    {
      "identifier": "CI-P76-001",
      "text": "인화성 액체 저장실의 인화성 액체 전체량은 <표 1>의 A등급에 제시된 양을 초과하지 않아야 한다.",
      "guideContext": "실험실 위험등급 - 높은 화재위험",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-002",
      "text": "인화성 액체 저장실의 인화성 액체의 전체량은 <표 1>의 B등급에 제시된 양을 초과하지 않아야 한다.",
      "guideContext": "실험실 위험등급 - 중간 화재위험",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-003",
      "text": "인화성 액체 저장실의 인화성 액체의 전체량은 <표 1>의 C등급에 제시된 양을 초과하지 않아야 한다.",
      "guideContext": "실험실 위험등급 - 낮은 화재위험",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-004",
      "text": "인화성 액체 저장실의 인화성 액체의 전체량은 <표 1>의 D등급에 제시된 양을 초과하지 않아야 한다.",
      "guideContext": "실험실 위험등급 - 최소 화재위험",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-005",
      "text": "의료시설에 부속된 실험실에 있는 인화성 액체의 양은 D등급인 실험실에 한정된 양을 초과하지 않아야 한다.",
      "guideContext": "실험실 위험등급 - 의료시설 부속 실험실",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-006",
      "text": "6명 이상에게 하루에 4시간, 1주일에 12시간 이상의 교육을 목적으로 사용하는 강의용 실험실에서 실험 또는 시험을 하는 경우에는 강사가 직접 감독 하에 수행하여야 한다.",
      "guideContext": "강의용 실험단위 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실험실 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-007",
      "text": "강의 목적으로 사용되는 실험실은 <표 1>의 B등급의 실험실에서 취급하는 인화성 액체량의 50 %로 제한하여야 한다.",
      "guideContext": "강의용 실험단위",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-008",
      "text": "<표 1>의 실험실 당 인화성 액체의 최대 허용량은 실험실 10 ㎡ 당 한정하여 계산된 양을 초과하지 않아야 한다. 이때, 사무실, 실험실에 인접한 구역도 이 계산에 포함되어야 한다.",
      "guideContext": "강의용 실험단위",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-009",
      "text": "인화점이 39 ℃ ~ 93 ℃ 미만인 액체가 혼합되었을 때 인화성 액체와 인화성 액화가스의 최대량은 <표 1>에서 제시한 최대량을 초과하지 않아야 한다.",
      "guideContext": "강의용 실험단위",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-010",
      "text": "실험실 내 작업에서 취급한 고압 반응물에 의한 다음 항의 폭발위험을 충분히 고려하여야 한다.",
      "guideContext": "실험실 작업구역의 안전",
      "additionalDetail": "반응성 위험물질 저장·사용, 높은 발열반응, 잠재위험 화학물질 구조 등 포함",
      "workProcessPhase": "실험 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-011",
      "text": "실험실에 폭발위험 가능성이 있다고 인정될 경우에는 실험실, 인접한 실험실, 비실험구역의 사람들을 보호하기 위해 적절한 방호조치를 하여야 한다.",
      "guideContext": "실험실 작업구역의 안전",
      "additionalDetail": null,
      "workProcessPhase": "실험 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-012",
      "text": "실험실에 필요한 구조물은 건축 시 화재 위험등급, 실험실의 구역, 제공되는 방호물의 요구사항에 허용된 범위 내에서 설치하여야 한다.",
      "guideContext": "실험실 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-013",
      "text": "실험실은 <표 2>와 <표 3>에서 정한 내화 요구사항 이상이어야 하며, 비실험구역과 분리하여야 한다.",
      "guideContext": "실험실 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-014",
      "text": "교육장소가 있는 실험실은 화재 시 화재위험으로부터 비실험구역과 1 시간 이상 격리될 수 있도록 분리하여야 한다.",
      "guideContext": "실험실 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-015",
      "text": "파이프, 도관, 주 덕트, 케이블, 철사, 공기덕트, 공기튜브, 기타 유사한 건물보조 장치는 화재등급에 따라 마루나 천장과 조립식 벽을 통한 화재침투는 소방법 시설기준에 맞도록 방호하여야 한다.",
      "guideContext": "실험실 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-016",
      "text": "모든 바닥의 구멍들은 보다 낮은 바닥의 액체누출을 방지하기 위해서 봉합하거나 통제하여야 한다.",
      "guideContext": "실험실 구조",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-017",
      "text": "조립식 창문 및 방화문은 화재등급에 따라 1시간 이하의 내화성능을 갖는 조립품으로 방화기준에 맞게 설치하여야 한다.",
      "guideContext": "실험실 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-018",
      "text": "실험실의 최대면적은 화재 위험등급, 실험실 건축, 화재 방호에 따라 결정하여야 한다.",
      "guideContext": "실험실 최대면적 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-019",
      "text": "실험실 구역은 폭발위험이 있는 장소를 포함하기 때문에 사고가 실험실 구역으로의 접근이나 실험실에서 탈출이 쉬운 최소 2개 이상 비상구가 있어야 한다.",
      "guideContext": "비상구의 접근방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-020",
      "text": "긴급비상 조명 설비는 (1)항에 부합하는 비상구로의 2차 접근수단이 필요한 모든 실험실작업구역 내에 설치하여야 한다.",
      "guideContext": "비상구의 접근방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-021",
      "text": "실험실 내외화재 A, B등급의 모든 실험실 작업구역에 설치된 비상문은 비상구 방향으로 열려야 한다.",
      "guideContext": "비상구의 접근방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-022",
      "text": "전기 케이블과 부속물, 기구, 조명, 신호시스템, 경보시스템, 원격조정설비에 사용되는 부품을 포함한 모든 전기장치는 국제전기 관련코드에 부합하여야 하며, 전기 소켓, 스위치, 통제는 액체유출에 영향을 받지 않는 곳에 위치하고 있어야 한다.",
      "guideContext": "전기설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-P76-023",
      "text": "모든 실험실은 다음과 같은 화재위험에 적합한 방호계획을 제공하여야 한다.",
      "guideContext": "방화 대책 일반사항",
      "additionalDetail": "휴대용 소화기, 화재경보시스템, 대피와 긴급조치계획, 스프링클러설비 포함",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-024",
      "text": "A등급 및 B등급의 실험실에 대한 자동스프링클러설비는 스프링클러설비의 설치에 대한 기준에 맞아야 한다.",
      "guideContext": "자동소화시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-025",
      "text": "자동스프링클러설비는 감시, 점검 및 관리하여야 한다.",
      "guideContext": "자동소화시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-026",
      "text": "자동소화설비의 방출은 청취 가능한 화재경보시스템이 작동하여야 한다.",
      "guideContext": "자동소화시스템",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P76-027",
      "text": "등급 수준의 위나 아래에 2층 이상인 모든 실험실 건물에 설치된 옥내소화전설비 설치는 국가화재안전기준에 부합하여야 한다.",
      "guideContext": "옥내 소화설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-028",
      "text": "옥내소화전설비는 정기적으로 점검 및 관리하여야 한다.",
      "guideContext": "옥내 소화설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-029",
      "text": "호스선, 커플링과 관창을 포함하는 옥내소화전설비는 관리, 사용 및 수리점검에 관한 기준에 적합하도록 검사 및 관리하여야 한다.",
      "guideContext": "옥내 소화설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-030",
      "text": "휴대용 소화기는 소화기에 대한 기준에 부합되도록 설치, 비치 및 관리하여야 한다.",
      "guideContext": "휴대용 소화기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-031",
      "text": "화재경보설비는 국가화재안전기준에 부합되도록 설치하고, 관리하여야 한다.",
      "guideContext": "화재경보설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P76-032",
      "text": "필요한 장소에는 화재경보설비가 설치되어 화재상황이나 부수적인 상황 작동 시에는 모든 직원은 경계하여야 한다.",
      "guideContext": "화재경보설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P76-033",
      "text": "화재예방절차는 다음 사항을 포함하여 관리하여야 한다.",
      "guideContext": "화재예방",
      "additionalDetail": "화학물질·인화성 액체와 가스의 취급 및 저장, 작업 허가, 휴대용 전기코드 정리, 흡연실 통제 포함",
      "workProcessPhase": "화재예방 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-034",
      "text": "실험실 작업구역 내나 폭발 위험이 인정될 경우에는 실험실 구역과, 인접한 실험실, 비실험구역의 사람들을 보호하기 위해 다음 각 호의 적절한 조치를 한 개 이상 제공하여야 한다.",
      "guideContext": "폭발위험 방지",
      "additionalDetail": "화학물질 한계량, 특별 예방 및 방호조치, 폭발방지 벽, 원격 조정, 폭발분출구, 격리 실험 포함",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.7.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-035",
      "text": "폭발위험이 있는 실험실 작업구역과 실험실에 설치된 창문, 문, 또는 분출구와 파편 차단물 사이의 펜스 공간에 무단 접근을 방지하여야 한다.",
      "guideContext": "폭발위험 방지 - 무단 접근방지",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.7.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-036",
      "text": "모든 방호용 건설 장치와 시스템의 진단점검은 적어도 일 년에 한번 이상 완벽도와 작동 가능성을 보증하기 위해 수행하여야 한다.",
      "guideContext": "폭발위험 방지 - 진단 점검과 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-037",
      "text": "폭발 방호물과 특별한 폭발억제 후드가 약화되거나 특별히 폭발 억제 후드에서 교체하고 사이트 판넬(Sight panel)은 매번 사용하기 전에 점검하여야 한다.",
      "guideContext": "폭발위험 방지 - 진단 점검과 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-038",
      "text": "환기설비는 실험실에서 생성되는 화학물질이 재순환되지 않도록 하여야 한다.",
      "guideContext": "실험실 환기설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P76-039",
      "text": "실험실 내에 화학물질이 누출되어 가연범위를 형성하거나, 화학물질 증기가 점화원과 접촉하지 않도록 방지하거나 통제하여야 한다.",
      "guideContext": "실험실 환기설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-P76-040",
      "text": "신선한 공기유입 위치와 배치는 실험실건물 자체에서 또는 다른 건축물과 장비로부터 나온 화학물질과 연소가스의 유입을 피하여야 한다.",
      "guideContext": "환기 공급시스템",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-P76-041",
      "text": "화학물질이 존재하는 실험실구역은 지속적으로 환기되어야 한다.",
      "guideContext": "환기 공급시스템",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-P76-042",
      "text": "공기 공급 확산장비의 위치는 실험실후드, 배출설비, 화재감지나 소화 설비의 성능에 약 영향을 미치는 기류를 피하여야 한다.",
      "guideContext": "환기 공급시스템",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-P76-043",
      "text": "모든 실험실 후드에서 배출된 공기와 다른 특별한 지역의 배출 설비는 재순환되어서는 안 된다.",
      "guideContext": "배출공기 방출",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P76-044",
      "text": "화학물질이 존재하는 실험실에서 나온 공기는 화학물질의 재유입을 방지하기 위해 정상적으로 덕트 설비를 통해 지속적으로 충분한 위치, 높이, 적정 속도로 지붕 위로 처리 방출하여야 한다.",
      "guideContext": "배출공기 방출",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P76-045",
      "text": "생물학적인 물질을 취급 및 지장하는데 사용하는 안전캐비닛을 실험실 후드 대신으로 사용하여서는 안 된다.",
      "guideContext": "배출공기 방출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-046",
      "text": "실험실 후드와 지역 배출설비 덕트는 완전히 비 연소성 물질로 설치하여야 한다.",
      "guideContext": "구역 배출설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-047",
      "text": "덕트는 근무조건과 설치 요구사항에 맞도록 적정한 길이와 강도를 유지하고, 기계적인 피해로부터 방호되어야 하며 실험실의 배출 덕트는 건물의 외부 지점이나 기계적인 공간, 축까지 분리하여야 한다.",
      "guideContext": "구역 배출설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-048",
      "text": "실험실 배출설비의 덕트 내 유체의 흐름속도는 실험실 후드의 정상적인 가동 중에 배출설비에서 액체의 침전물이나 응축 가능한 고체를 최소화하도록 충분히 유지하여야 한다.",
      "guideContext": "구역 배출설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P76-049",
      "text": "인화성 가스나 증기 또는 연소성 분진가 팬을 통해 통과할 때 방폭모터, 회전 날개 및 케이싱 재질은 방폭구조에 적합한 재질이어야 한다.",
      "guideContext": "구역 배출설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P76-050",
      "text": "팬의 회전방향, 실험실 후드와 배출설비의 진행위치는 화살표나 다른 수단으로 표시하여야 한다.",
      "guideContext": "구역 배출설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P76-051",
      "text": "실험실 후드 공기 우회덕트(Bypass) 구멍은 후드 내 폭주반응 시 비산하는 유리나 타는 잔유물을 차단하고 빗나가지 않도록 그릴이나 고정판(Solid panel)에 의해 차폐되어야 한다.",
      "guideContext": "구역 배출설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P76-052",
      "text": "설비와 제어장치가 후드 내에 있는 장치에서 추가 전기 연결은 후드에서 15 m 이내에 접근 가능하도록 비치하고, 표시하여야 한다.",
      "guideContext": "구역 배출설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-053",
      "text": "유량모니터는 각 실험실 후드 위에 설치하고 실험실 환기나 실험실을 통과하는 기류에 영향을 미칠 수 있는 변경 시에도 현존하는 실험실 후드위에 설치하여야 한다.",
      "guideContext": "구역 배출설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-P76-054",
      "text": "실험실 후드는 난기류가 최소인 구역에 비치하여야 한다.",
      "guideContext": "구역 배출설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-P76-055",
      "text": "실험실 후드를 배출설비로 사용하지 않아야 한다.",
      "guideContext": "구역 배출설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-056",
      "text": "실험실 후드의 배출팬 등을 차단하기 위해 화재감지 및 경보설비를 인터록하여서는 안 된다.",
      "guideContext": "구역 배출설비",
      "additionalDetail": "다만, 가스 소화설비를 사용하는 장소에서 방호된 실험실 후드는 다른 실험실 후드와 독립시켜야 하고, 소화시스템의 발동작용을 차단하기 위해 배출설비를 인터록하도록 승인하여야 한다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P76-057",
      "text": "설치 및 수정 시 실험실 후드, 실험실 후드 배출설비, 실험실 특수 배출설비는 매년 1회 이상 다음 사항을 점검하여야 한다.",
      "guideContext": "안전 점검",
      "additionalDetail": "후드 내부·새시·덕트 육안검사, 유량모니터, 저기류·기류손실 경보, 표면속도, 내부 기류 변동, 작업구역 환경 변화 포함",
      "workProcessPhase": "실험실 후드 안전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.6",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-P76-058",
      "text": "화학약품은 지정수량 이상을 실험실 구역에 유입되지 않아야 한다.",
      "guideContext": "화학물질 저장설비",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-059",
      "text": "교육용 실험실 내의 인화성 액체 저장용기는 수용량이 4 L를 초과하지 않아야 한다. 다만, 안전용기는 8 L로 수용량을 승인받아야 한다.",
      "guideContext": "저장용기",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-060",
      "text": "실험실 건물 내부나 실험실 작업구역에서 인화성 액체는 수용량이 20 L를 초과하지 않도록 대규모 저장용기에서 작은 저장용기로 소분할 때는 다음 사항을 지켜야 한다.",
      "guideContext": "저장용기 - 인화성 액체 소분",
      "additionalDetail": "실험실 후드 내에서 작업하거나, 폭발하한의 25% 이상 인화성 증기 축적을 방지하기에 적합한 환기가 제공된 구역 내에서 작업",
      "workProcessPhase": "인화성 액체 소분 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P76-061",
      "text": "저장용기의 형태와 최대 수용량은 <표 4>에 부합되어야 하고, 화학물질의 목록은 저장시설의 제한된 수용량 내에서 관리하여야 한다.",
      "guideContext": "저장용기",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-062",
      "text": "산화제는 가연성 물질로부터 격리되어야 하며, 모든 가연성 물질은 전용 가연성 물질 저장 캐비닛에 저장하여야 한다.",
      "guideContext": "저장용기",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "CI-P76-063",
      "text": "폐기물이 발생 시는 적정수집 용기에 \"위험 폐기물\"이라는 표지를 붙이고, 표지에 내용물을 기입하여 실험실에 위험폐기물을 200 L까지 보관할 수 있으나, 매우 위험한 폐기물을 1 L까지 보관할 수 있다.",
      "guideContext": "저장용기 - 폐기물 관리",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P76-064",
      "text": "3일 내에 위험한계 폐기물 저장구역으로 옮겨야 하고, 특례승인일을 충족시키지 못하면 저장 폐기물을 비워야 한다.",
      "guideContext": "저장용기 - 폐기물 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-065",
      "text": "가스 실린더는 항상 훈련된 직원에 의해 안전하게 취급·확인하여야 한다.",
      "guideContext": "가스 실린더 안전",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-066",
      "text": "실험실에 있는 실린더는 최대 사용압력으로 설계하고, 표시된 압력조정기가 구비하여야 한다.",
      "guideContext": "가스 실린더 안전",
      "additionalDetail": "조정시스템은 실린더 압력과 밖의 압력 모드를 보여주도록 2개의 게이지가 구비되어야 하고, 수동 차단밸브를 갖고 있어야 한다.",
      "workProcessPhase": "가스 실린더 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P76-067",
      "text": "수동차단밸브는 각 공급위치와 사용위치에 제공하여야 한다.",
      "guideContext": "가스 실린더 안전",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-P76-068",
      "text": "독성 또는 가연성 가스 실린더를 창문, 문 또는 다른 실험실 작업장의 구멍 근처에 설치하지 않아야 한다.",
      "guideContext": "가스 실린더 안전",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-069",
      "text": "잠재위험이 있는 모든 화학물질에 대한 저장기에는 라벨을 부착하여야 한다.",
      "guideContext": "라벨 부착",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.4",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P76-070",
      "text": "장기간 저장으로 인해 잠재위험이 발생하는 물질의 저장기는 처음 개방되었을 때 잠재위험 통제를 쉽게 하기 위해 개봉날짜를 기입하여야 한다.",
      "guideContext": "라벨 부착",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 저장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.4",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P76-071",
      "text": "사용한 화학물질을 선별 회수 재활용하고, 배출할 때 안전처리규정에 따라 성상별로 배출 혼합을 억제하여야 한다.",
      "guideContext": "배출 억제",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-P76-072",
      "text": "화학물질 폐기물은 유별을 달리하여 라벨표시 저장하고, 명세서를 부착하여 안전한 장소에 적정 관리하여야 한다.",
      "guideContext": "배출 억제",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.5",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P76-073",
      "text": "화학물질의 배출현황 및 안전관리를 위하여 자체점검 기록을 일지에 명시 책임자는 확인하여야 한다.",
      "guideContext": "배출 억제",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-P76-074",
      "text": "특정 화학물질 및 화학약품을 필요이상 사용하고자 할 때에는 화학물질 안전대책을 수립하여 안전부서에 보고하여야 한다.",
      "guideContext": "보고",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P76-075",
      "text": "실험실 안전책임자는 안전관리자등의 화학물질 안전조사에 협력하여야 한다.",
      "guideContext": "보고 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-076",
      "text": "실험실을 폐기하거나 새로 개설 변경사항이 발생할 때에는 반드시 안전과에 그 내용을 보고하여야 한다.",
      "guideContext": "보고 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-077",
      "text": "실험실 책임자는 화학약품에 관한 재해사고가 발생하였을 때 또는 발생할 증상이 나타날 때에는 즉시 비상연락을 통해 응급조치를 하고, 사고조사 및 신속한 복구에 노력하여야 한다.",
      "guideContext": "사고 시 조치",
      "additionalDetail": null,
      "workProcessPhase": "사고 시 비상조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-P76-078",
      "text": "실험실 책임자는 사고가 발생하였을 때에는 즉시 사고 상황을 관계기관 및 관계부서장에게 통보하고, 동시에 응급조치 완료 후 대책을 강구하여야 한다.",
      "guideContext": "사고 시 조치",
      "additionalDetail": null,
      "workProcessPhase": "사고 시 비상조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-P76-079",
      "text": "실험실 내에 있는 시설(Furniture), 지원 설비(Casework), 장치(Equipment)는 정리정돈이 되어 있어야 하고, 모든 위치에서 쉽게 비상구에 접근할 수 있어야 한다.",
      "guideContext": "시설, 지원 설비, 장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-080",
      "text": "환기팬은 화재, 폭발, 부식에 대한 요구사항에 적합한 것으로 수리, 청소, 점검을 위해 신속하고 쉽게 접근이 연계되어야 한다.",
      "guideContext": "구역 배출설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P76-081",
      "text": "압력조절 시스템은 더 이상의 압력상승을 피하기 위한 충분한 방출 속도를 제공하기 위해 설계하여야 하고, 안전한 장소로 환기해야 한다.",
      "guideContext": "가스 실린더 안전",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P76-001",
      "term": "사용 등",
      "definition": "제조, 연구, 개발, 사용, 보관, 운반 및 처리를 포함시켜 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-002",
      "term": "기구",
      "definition": "실험실에서 사용하는 설비, 실험실 후드, 원심분리기, 냉각장치, 상용 또는 직접 제작한 장치 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-003",
      "term": "보충공기",
      "definition": "실험실 내의 공기오염을 줄이기 위해 실험실 후드의 외부 표면 주위에서 제공되는 공기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-004",
      "term": "방해판 (Baffle)",
      "definition": "후드를 통과하는 공기의 흐름을 분할하는 것을 돕는 후드 내부의 뒷면에 위치한 패널을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-005",
      "term": "생물학적인 안전캐비닛",
      "definition": "생물학적인 물질을 취급하거나 지장하는데 사용되는 특별한 안전캐비닛을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-006",
      "term": "사용장소",
      "definition": "사업장의 연구실험실과 대학 연구실험실 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-007",
      "term": "화재 차단물",
      "definition": "방호된 구멍을 갖고, 화재의 확산을 억제하도록 설계된 수평 또는 수직인 화재방지를 위하여 조립한 재료를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-008",
      "term": "실험실 작업구역",
      "definition": "화학물질을 사용하는 검사, 분석, 연구 교육이나 유사한 작업활동을 위한 공간을 말하며, 연구실과는 구분된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-009",
      "term": "안전용기",
      "definition": "스프링 개폐식 뚜껑 또는 배출 방지용 뚜껑을 가지고 있도록 설계되어 화재에 노출 시 내부압력을 안전하게 감소시킬 수 있도록 승인된 저장용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P76-010",
      "term": "대체 (Substitution)",
      "definition": "창고에서 위성도가 높은 위험물을 위험도가 보다 낮은 위험물질로 대체하여 저장·취급하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
