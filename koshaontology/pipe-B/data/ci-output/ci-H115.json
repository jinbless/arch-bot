  "checklistItems": [
    {
      "identifier": "CI-H115-001",
      "text": "호흡보호구는 양압 자가호흡장치(Self-contained breathing apparatus, SCBA)를 갖춘다.",
      "guideContext": "위험구역(Hot zone) 구조활동 시 보호",
      "additionalDetail": "시안화수소는 피부로도 흡수되므로 호흡보호 필수",
      "workProcessPhase": "위험구역 구조활동",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-002",
      "text": "시안화수소는 피부로도 잘 흡수가 되고 소량에도 전신 중독증상이 나타나기 때문에 반드시 화학물질이 투과되지 않는 피부 보호복이 필요하다.",
      "guideContext": "위험구역(Hot zone) 구조활동 시 보호",
      "additionalDetail": null,
      "workProcessPhase": "위험구역 구조활동",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-003",
      "text": "위험구역은 안전선을 치고 출입을 통제한다.",
      "guideContext": "위험구역(Hot zone) 운영",
      "additionalDetail": null,
      "workProcessPhase": "위험구역 구조활동",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-H115-004",
      "text": "시안화수소 중독이 의심되는 환자의 기도(Airway)를 확보하고, 적절한 호흡(Breathing)과 맥박(Circulation)을 확인한다.",
      "guideContext": "위험구역 응급 구조의 원칙(ABC)",
      "additionalDetail": null,
      "workProcessPhase": "위험구역 구조활동",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-005",
      "text": "이상이 있으면 딱딱한 들것 위에 누이고 경추보호대를 착용시켜 경추를 보호한다.",
      "guideContext": "위험구역 응급 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험구역 구조활동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H115-006",
      "text": "시안화수소를 입으로 마신 피재자의 토사물이나 시안화수소 용액에 젖은 피재자의 의복 등은 시안화수소를 배출시키는 오염원이 될 수 있어서 구조시 접촉하지 않도록 주의한다.",
      "guideContext": "위험구역 피재자 구조",
      "additionalDetail": null,
      "workProcessPhase": "위험구역 구조활동",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H115-007",
      "text": "위험구역에서 데리고 나온 피재자의 의복이나 피부 등이 시안화수소 용액에 젖어 있는지 살펴보고, 호흡 보호구 및 피부 보호구를 갖춘 사람이 피재자를 받아 인계하고 다른 사람은 함부로 피재자를 만지지 않는다.",
      "guideContext": "위험구역 피재자 인계",
      "additionalDetail": null,
      "workProcessPhase": "위험구역 구조활동",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-008",
      "text": "시안화수소 중독이 의심되는 피재자를 처치하는 사람들은 반드시 호흡 보호구를 착용하고, 피재자의 토사물이나 피부와 옷에 묻은 화학물질을 피부 보호구 없이 직접 만지지 않는다.",
      "guideContext": "응급처치구역 운영",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-009",
      "text": "환자의 기도(Airway)를 확보하고, 호흡(Breathing)과 맥박(Circulation)을 확인한다.",
      "guideContext": "응급처치구역 응급처치의 원칙(ABC)",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-010",
      "text": "시안화수소 중독이 있는 피재자에게 최대한 산소와 시안화수소 해독제를 투입하는 등의 전문응급처치(Advanced treatment)를 받게 이송하며 기초응급처치(Basic decontamination)를 동시에 실시해야 한다.",
      "guideContext": "응급처치구역 운영",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-011",
      "text": "노출된 피부와 머리카락은 흐르는 물에 3~5분간 씻는다.",
      "guideContext": "응급처치구역 기초응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-012",
      "text": "통증을 호소하거나 충혈된 눈은 물이나 식염수로 5분간 세척한다.",
      "guideContext": "응급처치구역 기초응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-013",
      "text": "시안화수소 중독이 있는 피재자 또는 시안화수소 용액 및 염을 입으로 삼킨 피재자는 최대한 빨리 100% 산소와 시안화수소 해독제를 투입하는 등 전문응급처치를 실시한다.",
      "guideContext": "응급처치구역 기초응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-014",
      "text": "시안화수소에 노출된 근로자 중 스스로 움직일 수 있는 사람은 안내를 해서 스스로 오염된 옷을 두 번 밀봉하여 파기하도록 한다.",
      "guideContext": "응급처치구역 기초응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H115-015",
      "text": "현장에서 심정지, 호흡정지가 나타날 경우 즉각 심폐소생술을 수행한다.",
      "guideContext": "응급처치구역 전문응급치료",
      "additionalDetail": null,
      "workProcessPhase": "응급처치구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-016",
      "text": "시안화수소에 노출되었던 근로자의 의복 등이 오염되지 않았는지 다시 점검해서 다른 근로자들의 간접 노출을 예방한다.",
      "guideContext": "보호구역(Support zone) 운영",
      "additionalDetail": null,
      "workProcessPhase": "보호구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H115-017",
      "text": "응급조치구역에서 확보한 기도가 잘 유지되고 있는지 다시 확인한다.",
      "guideContext": "보호구역 치료원칙",
      "additionalDetail": null,
      "workProcessPhase": "보호구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-018",
      "text": "의식이 떨어지거나 쇼크가 오는 환자는 즉각 시안화수소 중독 해독제 등 응급치료를 시행한다.",
      "guideContext": "보호구역 치료원칙",
      "additionalDetail": null,
      "workProcessPhase": "보호구역 운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-019",
      "text": "코와 입을 옷으로 감싸고 많은 양의 시안화수소를 흡입하지 않도록 숨을 참고 외부 공기가 있는 곳으로 나간다.",
      "guideContext": "재해현장에서 근로자 자체 응급조치 - 기중 노출",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자체 응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-H115-020",
      "text": "시안화수소에 노출된 동료근로자를 외부 공기가 유입되는 곳으로 데려온다.",
      "guideContext": "재해현장에서 근로자 자체 응급조치 - 기중 노출",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자체 응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-H115-021",
      "text": "안전한 곳으로 데려온 후 기도를 확보하도록 입을 벌리고 정상적인 호흡과 목이나 손목에서 맥박을 확인한다.",
      "guideContext": "재해현장에서 근로자 자체 응급조치 - 기중 노출",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자체 응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-022",
      "text": "눈이 액상 시안화수소에 노출되면 즉시 많은 양의 흐르는 물에 눈을 씻는다. 만약 콘택트렌즈를 착용하고 있으면 즉시 눈에서 제거한다.",
      "guideContext": "재해현장에서 근로자 자체 응급조치 - 액상 노출",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자체 응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-023",
      "text": "피부가 액상 시안화수소에 노출되면 즉시 흐르는 물에 피부를 씻는다.",
      "guideContext": "재해현장에서 근로자 자체 응급조치 - 액상 노출",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자체 응급조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-024",
      "text": "시안화수소에 많이 노출되었다고 판단이 되면 시안화수소 중독 증상이 없어도 일단 오염원을 제거한 피재자는 모두 의료기관으로 옮긴다. 특히 사고로 입에 튀어 들어가거나 피부가 많이 노출된 피재자는 증상에 상관없이 의료기관으로 이송해야 한다.",
      "guideContext": "응급조치 후 피재자 관리",
      "additionalDetail": null,
      "workProcessPhase": "피재자 이송 및 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-025",
      "text": "의료기관으로 의뢰할 때에는 이송 시점에서 환자의 상태, 현장에서 해독 치료, 의료기관에 도착 예상 시간을 사전에 알린다.",
      "guideContext": "응급조치 후 피재자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "피재자 이송 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H115-026",
      "text": "시안화수소 용액이 입으로 튀어 들어간 피재자는 이송 중 구토할 것을 대비해서 일회용 타올과 토사물을 담아 밀봉할 수 있는 비닐 팩을 준비하여 이송한다.",
      "guideContext": "응급조치 후 피재자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "피재자 이송 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H115-027",
      "text": "귀가할 때에는 이름, 주소, 부서, 연락처도 확보하고 <부록2. 시안화수소에 노출된 근로자가 주의해야 할 사항>과 같은 안내문을 주어 해당 증상이 발생할 경우 즉각 의료기관을 방문하도록 안내한다.",
      "guideContext": "응급조치 후 피재자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "피재자 이송 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H115-028",
      "text": "시안화수소를 입으로 흡입하거나 피부나 눈에 직접 시안화수소를 접촉한 피재자는 귀가 여부를 결정할 시점에서는 증상이 없어도 시간이 지난 후 중독이 나타날 수 있으므로, 응급의료기관에서 최소한 4~6시간까지는 집중 관찰을 해야 한다.",
      "guideContext": "응급조치 후 피재자 관리",
      "additionalDetail": null,
      "workProcessPhase": "피재자 이송 및 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-029",
      "text": "시안화수소에 노출된 후 눈의 각막에 손상을 입은 피재자는 24시간 이내에 다시 전문의료기관에서 검진을 받아야 한다.",
      "guideContext": "응급조치 후 피재자 관리",
      "additionalDetail": null,
      "workProcessPhase": "피재자 이송 및 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CONFINED-024"
      ]
    },
    {
      "identifier": "CI-H115-030",
      "text": "사업주는 시안화수소 및 시안화염을 취급하는 공정에서 다음과 같은 사전예방 점검표를 비치하고 근로자에게 안내하여 재해를 예방한다.",
      "guideContext": "시안화수소 중독 예방",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H115-031",
      "text": "안전보건 책임자가 점검표를 확인하고 보호구를 적절히 관리하게 한다.",
      "guideContext": "시안화수소 중독 예방",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-032",
      "text": "취급지역으로 출입하기 전에 적절한 호흡보호구가 비치되어 있다.",
      "guideContext": "시안화수소 취급지역 작업전후 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-033",
      "text": "취급지역의 시안화수소 노출을 파악할 수 있는 시설 및 장비(예, 가스모니터링 기계 및 직독식 검지관)이 비치되고 있다.",
      "guideContext": "시안화수소 취급지역 작업전후 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H115-034",
      "text": "취급지역의 시안화수소 노출을 파악할 수 있는 시설 및 장비(예, 가스모니터링 기계 및 직독식 검지관)이 정상적으로 작동하고 있다.",
      "guideContext": "시안화수소 취급지역 작업전후 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H115-035",
      "text": "취급지역의 시안화수소 노출을 파악할 수 있는 시설 및 장비(예, 가스모니터링 기계 및 직독식 검지관)에 따라 기중 시안화수소 노출수준이 노출기준 미만으로 확인된다.",
      "guideContext": "시안화수소 취급지역 작업전후 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H115-036",
      "text": "시안화수소 및 시안화염은 작업공정서에 따라서 필요시에만 필요량을 취급한다.",
      "guideContext": "시안화수소 취급지역 작업전후 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H115-037",
      "text": "시안화수소 및 시안화염을 취급한 후 밀봉하고 누출되지 않는 지 육안점검한다.",
      "guideContext": "시안화수소 취급지역 작업전후 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-H115-038",
      "text": "시안화수소 및 시안화염을 취급한 후 취급지역에서 나온 후 시안화수소 노출을 파악할 수 있는 시설 및 장비(예, 가스모니터링 기계 및 직독식 검지관)을 통하여 노출수준을 점검한다.",
      "guideContext": "시안화수소 취급지역 작업전후 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전예방 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H115-039",
      "text": "매달(자주 취급하지 않는 경우 분기별로) 호흡보호구의 적합성을 검토한다.",
      "guideContext": "호흡보호구 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-040",
      "text": "한번이라도 시안화수소 및 시안화염 취급지역에서 사용한 보호구는 전체 또는 캐니스터 등 일부를 교환한다.",
      "guideContext": "호흡보호구 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-041",
      "text": "송기형 호흡보호구는 분기별로 기류가 적절히 통하는지 점검한다.",
      "guideContext": "호흡보호구 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-042",
      "text": "송기형 호흡보호구는 필터의 유효기간 등을 확인하고 사용한 필터는 폐기한다.",
      "guideContext": "호흡보호구 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-043",
      "text": "양압식 호흡보호구의 작동 여부를 분기별로 확인한다.",
      "guideContext": "호흡보호구 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-044",
      "text": "시안화수소가 있거나 의심되는 곳에 작업자의 출입을 제한한다.",
      "guideContext": "시안화수소 노출 위험에 따른 시설 관리",
      "additionalDetail": null,
      "workProcessPhase": "시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-H115-045",
      "text": "시안화수소의 자연환기 경로를 파악하여 기류의 방향을 표기한다.",
      "guideContext": "시안화수소 노출 위험에 따른 시설 관리",
      "additionalDetail": null,
      "workProcessPhase": "시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-H115-046",
      "text": "시안화수소를 포함한 용기 및 장비는 주의 표기를 한다.",
      "guideContext": "시안화수소 노출 위험에 따른 시설 관리",
      "additionalDetail": null,
      "workProcessPhase": "시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H115-047",
      "text": "작업환경을 시안화수소의 노출수준에 따른 구역으로 구분한다.",
      "guideContext": "시안화수소 노출 위험에 따른 시설 관리",
      "additionalDetail": null,
      "workProcessPhase": "시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-H115-048",
      "text": "시안화수소 누출시 응급대응 조치와 업무지속계획을 세운다.",
      "guideContext": "시안화수소 노출 위험에 따른 시설 관리",
      "additionalDetail": null,
      "workProcessPhase": "시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H115-049",
      "text": "시안화수소의 누출 부위의 밀폐와 폐쇄 방안을 마련한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H115-050",
      "text": "시안화수소를 퍼지(Purge)하고 환기시킬 수 있는 설비를 보강한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-H115-051",
      "text": "시안화수소를 다룬 보관 탱크 등을 보수할 때에는 완전히 탱크를 비운 후 물을 가득 채우고 비우기를 2회 반복한 후, 신선한 공기로 퍼지한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-H115-052",
      "text": "탱크 보수를 위해 작업자가 진입할 때에는 퍼지를 한 후에도 위생보호구를 온전히 착용한 후 들어가 작업을 하도록 지시한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-H115-053",
      "text": "강제 환기 시설을 마련한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H115-054",
      "text": "사업장의 관리구역마다 <표 5>을 참고하여 적절한 호흡용 보호구를 마련하고 근로자에게 배포한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-055",
      "text": "시안화수소의 피부 보호를 위해 부틸 고무 장갑과 테플론 코팅이 된 화학 보호복을 구비한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H115-056",
      "text": "시안화수소가 함유된 폐기물은 이차 오염을 막기 위해 염화물로 알칼리화시켜 시안산을 중화시킨 후 배출한다.",
      "guideContext": "시안화수소 노출 예방 장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H115-057",
      "text": "사업장 내 안전 교육을 병행한다.",
      "guideContext": "시안화수소 중독 예방 교육",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H115-058",
      "text": "시안화수소의 건강영향을 교육한다.",
      "guideContext": "시안화수소 중독 예방 교육",
      "additionalDetail": null,
      "workProcessPhase": "교육 및 훈련",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H115-059",
      "text": "적절한 호흡보호구 및 보호의복이 없는 경우에는 아무도 현장에 들여보내지 않도록 한다.",
      "guideContext": "시안화수소 누출사고 처리 원칙",
      "additionalDetail": null,
      "workProcessPhase": "누출사고 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H115-060",
      "text": "누출되는 가스를 환기하고 국소배기를 시행한다.",
      "guideContext": "시안화수소 누출사고 처리 원칙",
      "additionalDetail": null,
      "workProcessPhase": "누출사고 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H115-061",
      "text": "가스형태로 배출되는 경우, 가스의 누출 및 공급을 중단한다.",
      "guideContext": "시안화수소 누출사고 처리 원칙",
      "additionalDetail": null,
      "workProcessPhase": "누출사고 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-H115-062",
      "text": "액상 형태로 누출되는 경우, 일회용 종이 타월로 닦아내서, 국소배기장치가 있는 안전한 곳에서 기화시켜 배기시킨다. 종이 타월은 연소시켜 폐기처리 한다.",
      "guideContext": "시안화수소 누출사고 처리 원칙",
      "additionalDetail": null,
      "workProcessPhase": "누출사고 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H115-063",
