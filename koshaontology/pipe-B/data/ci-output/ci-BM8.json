  "domainTerms": [
    {
      "identifier": "DT-BM8-001",
      "term": "이동식 크레인",
      "definition": "원동기를 내장하고 있는 것으로서 불특정 장소에 스스로 이동할 수 있는 크레인으로 동력을 사용하여 중량물을 매달아 상하 및 좌우(수평 또는 선회를 말한다)로 운반하는 실비로서 「건설기계관리법」을 적용 받는 기중기 또는 「자동차관리법」 제3조에 따른 화물·특수자동차의 작업부에 탑재하여 화물 운반 등에 사용하는 기계 또는 기계장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM8-002",
      "term": "정격총하중",
      "definition": "크레인 지브의 경사각 및 길이 또는 지브에 따라 훅, 슬링(인양로프 또는 인양용구)등의 달기기구의 중량을 포함하여 인양할 수 최대하중이며, \"정격하중\"은 최대하중에서 훅, 슬링 등의 달기기구의 중량을 제외한 것으로 실 인양 무게를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM8-003",
      "term": "충격하중",
      "definition": "인양작업 중 갑작스러운 하중 전이에 의해 순간적으로 충격이 슬링 등에 전달되어 부재나 장비에 과도한 동적 변화를 가져오게 하는 하중을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM8-004",
      "term": "과부하방지장치",
      "definition": "정격하중 이상의 하중이 부하되었을 때 자동적으로 상승이 정지되면서 경보음을 발생하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM8-005",
      "term": "권과방지장치",
      "definition": "권과를 방지하기 위하여 인양용 와이어로프가 일정한계 이상 감기게 되면 자동적으로 동력을 차단하고 작동을 정지시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM8-006",
      "term": "훅 해지장치",
      "definition": "훅에서 와이어로프가 이탈하는 것을 방지하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM8-007",
      "term": "아웃트리거",
      "definition": "전도 사고를 방지하기 위하여 장비의 측면에 부착하여 전도 모멘트에 대하여 효과적으로 지탱할 수 있도록 한 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
