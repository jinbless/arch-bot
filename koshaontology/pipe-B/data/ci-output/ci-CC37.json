  "domainTerms": [
    {
      "identifier": "DT-CC37-001",
      "term": "위험과 운전분석",
      "definition": "공정에 존재하는 위험요인과 공정의 효율을 떨어뜨릴 수 있는 운전상의 문제점을 찾아내어 그 원인을 제거하는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-002",
      "term": "위험요인",
      "definition": "인적·물적손실 및 환경피해를 일으키는 요인(요소) 또는 이들 요인이 혼재된 잠재적 위험요인으로 실제 사고(손실)로 전환되기 위해서는 자극이 필요하며 이러한 자극으로는 기계적 고장, 시스템의 상태, 작업자의 실수 등 물리·화학적, 생물학적, 심리적, 행동적 원인이 있음을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-003",
      "term": "운전성",
      "definition": "운전자가 공장을 안전하게 운전할 수 있는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-004",
      "term": "설계의도",
      "definition": "설계자가 바라고 있는 운전조건을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-005",
      "term": "검토구간",
      "definition": "위험성평가를 하고자 하는 설비구간을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-006",
      "term": "변수",
      "definition": "유량, 압력, 온도, 물리량이나 공정의 흐름 조건을 나타내는 변수를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-007",
      "term": "가이드워드",
      "definition": "변수의 질이나 양을 표현하는 간단한 용어를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-008",
      "term": "이탈",
      "definition": "가이드워드와 변수가 조합되어, 유체흐름의 정지 또는 과잉상태와 같이 설계의도로부터 벗어난 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-009",
      "term": "원인",
      "definition": "이탈이 일어나는 이유를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-010",
      "term": "결과",
      "definition": "이탈이 일어남으로써 야기되는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-011",
      "term": "현재 안전조치",
      "definition": "이탈에 대한 안전장치의 역할을 하고 있는 이미 설치된 장치나 현재의 관리상황을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-012",
      "term": "위험도",
      "definition": "특정한 위험요인이 위험한 상태로 노출되어 특정한 사건으로 이어질 수 있는 사고의 빈도(가능성)와 사고의 강도(중대성) 조합으로서 위험의 크기 또는 위험의 정도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC37-013",
      "term": "개선권고사항",
      "definition": "이탈에 대한 현재 안전조치가 부족하다고 판단될 때 추가적인 안전성을 확보하기 위해 도출된 장치 또는 활동 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-CC37-01",
      "processOrder": 1,
      "processName": "위험성평가 팀 구성",
      "safetyMeasures": "팀 리더와 서기를 임명하고, 설계팀·운전팀 기술자 및 분야별 전문가가 참여하도록 구성한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-02",
      "processOrder": 2,
      "processName": "위험성평가 자료 수집",
      "safetyMeasures": "팀 리더가 위험성평가의 목적과 범위를 정한 후 최신의 설계도서 및 현장과 일치하는 자료를 수집한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-03",
      "processOrder": 3,
      "processName": "위험성평가 세부계획 수립",
      "safetyMeasures": "회의일자, 평가 대상 단위 공정의 도면 및 설비, 팀 구성원, 보고서 작성, 후속조치에 대한 계획을 포함하여 수립한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-04",
      "processOrder": 4,
      "processName": "위험성평가 회의 진행",
      "safetyMeasures": "팀원이 모든 공정의 이탈 상황을 평가하고, 서기가 토의결과를 빠짐없이 기록하며, 개선권고사항은 팀 전원의 동의로 결정한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-12",
      "processOrder": 5,
      "processName": "도면선정 및 공정설명",
      "safetyMeasures": "팀 리더가 위험성평가 대상 도면을 선정하고 공정정보 목록(별지 1)과 도면목록(별지 2)을 작성한다. 위험성평가 개요와 목적을 팀 구성원에게 충분히 설명하고, 도면에 표기된 모든 장치 및 설비에 대한 목적과 특성을 설명하고 토의한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-13",
      "processOrder": 6,
      "processName": "검토구간 선정 및 관련정보 작성",
      "safetyMeasures": "공정의 복잡성 및 팀 경험에 따라 검토구간 크기를 결정한다. 공정흐름 순서를 따르고 원료 투입 배관 주변을 첫 번째 검토구간으로 정한다. 설계목적 변경, 운전조건 변경, 연결 공정설비가 있을 때 구간을 변경한다. 검토구간 정보(별지 3)와 검토구간별 가이드워드(별지 4)를 작성한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-14",
      "processOrder": 7,
      "processName": "위험성평가 실시",
      "safetyMeasures": "가이드워드와 변수를 조합하여 이탈을 도출하고 정상운전 상태로부터 벗어날 수 있는 원인과 결과를 조사한다. 수정·변경 필요 시 도면에 적색으로, 평가 완료 구간은 녹색으로 표시한다. 모든 검토구간 완료 시 도면에 서명한다. 과거 유사설비의 중대산업사고, 공정사고 및 아차사고에 대하여도 위험성평가를 수행한다.",
      "requiredPPE": [],
      "sourceSection": "6.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-15",
      "processOrder": 8,
      "processName": "위험성평가 결과 기록지 작성",
      "safetyMeasures": "6하 원칙에 따라 기기·장치·설비·계기의 고유번호를 사용하여 작성한다. 이탈번호, 이탈, 원인, 결과, 현재 안전조치, 위험도, 개선번호, 개선권고사항을 별지 5 양식에 기록한다. 하나의 원인에 2개 이상의 결과가 예상되는 경우 모두 기록하고, 서로 다른 원인에 의한 같은 결과도 원인별로 각각 구분하여 기록한다.",
      "requiredPPE": [],
      "sourceSection": "6.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-16",
      "processOrder": 9,
      "processName": "위험도 구분",
      "safetyMeasures": "사고의 발생빈도와 강도를 조합하여 위험도를 1에서 5까지 구분한다. 발생빈도는 현재 안전조치를 고려하여 결정하나 강도는 현재 안전조치를 고려하지 않는다. 위험도 기준, 발생빈도 및 강도의 구분은 회사의 실정에 맞도록 규정한다.",
      "requiredPPE": [],
      "sourceSection": "6.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-17",
      "processOrder": 10,
      "processName": "개선권고사항 작성",
      "safetyMeasures": "개선권고사항에 대한 우선조치 순위를 정하여 경영진에게 보고한다. 후속조치 담당부서를 위해 검토 시나리오, 이탈에 따른 가능한 결과, 개선권고 요지를 첨부한다. 무슨 조치가 필요한가, 어디에 필요한가, 왜 시행되어야 하는가를 고려하여 작성한다.",
      "requiredPPE": [],
      "sourceSection": "6.6",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-26",
      "processOrder": 11,
      "processName": "위험성평가 보고서 작성",
      "safetyMeasures": "보고서에 공정 및 설비 개요, 공정의 위험 특성, 검토 범위와 목적, 팀 구성원 인적사항, 위험성평가 결과 기록지, 위험성평가 결과 조치계획을 포함. 공정안전자료(공정흐름도면, 공정배관·계장도면, 운전절차)를 위험성평가 서류에 첨부 보관. 회의 결과 사본을 팀 구성원들에게 배포하여 검토.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC37-27",
      "processOrder": 12,
      "processName": "개선권고사항 후속조치",
      "safetyMeasures": "위험관리 기준을 바탕으로 개선권고사항을 검토하고 우선순위를 정하여 조치. 경영자는 허용 가능한 위험도 이하로 낮추기 위한 안전조치를 취함. 책임부서를 지정하여 시행. 경영자는 후속조치 이행 여부를 확인.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
  ],
