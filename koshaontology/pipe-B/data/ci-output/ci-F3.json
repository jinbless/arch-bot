  "checklistItems": [
    {
      "identifier": "CI-F3-001",
      "text": "발포 성형된 우레탄폼은 가연성 물질로서, 고온 또는 용접 불티 등의 점화원에 의하여 쉽게 점화되어 화재로 이어질 수 있으므로, 연소장치(예 굴뚝, 소각로 등), 고온의 공정장치나 고온 배관 상부 또는 고온 배관과 인접하여 시공하지 말아야 하며 제조자가 제시하는 최고사용온도를 초과하는 설비에 보온용으로 시공하여서는 안 된다.",
      "guideContext": "경질폴리우레탄폼 발포 성형 후 시공 제한",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-F3-002",
      "text": "건축물에 단열재로 사용되는 우레탄폼은 국토해양부 고시 제 2011－39호 (건축물 내부 마감 재료의 난연 성능 기준)에서 정한 난연 성능을 보유하여야 하며 이러한 요건을 충족시키기 위해서는 할로겐화합물이나 인(Phosphate)계 화합물 등의 난연제를 혼합하여야 한다.",
      "guideContext": "경질폴리우레탄폼 난연 성능 기준",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-057"
      ]
    },
    {
      "identifier": "CI-F3-003",
      "text": "우레탄폼의 원료 제조자는 시공 매뉴얼을 제공하고, 각 원료의 사용온도를 용기에 표기하여 제품별로 정해진 온도범위 내에서 사용하도록 하여야 한다.",
      "guideContext": "우레탄폼 원료 원액 관리",
      "additionalDetail": null,
      "workProcessPhase": "원료 원액 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-F3-004",
      "text": "이소시아네이트 및 시스템폴리올 등의 원액은 발포 현장과 격리된 곳으로 직사광선, 불꽃 등에 노출되지 않는 별도의 장소에 보관하고, 발포 현장에는 일일 사용량을 고려하여 최소량을 보관하여야 한다.",
      "guideContext": "우레탄폼 원료 원액 관리",
      "additionalDetail": null,
      "workProcessPhase": "원료 원액 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-F3-005",
      "text": "이소시아네이트 및 시스템폴리올 등의 원액은 제조자가 정한 온도조건하에서 저장하여야 하며 특히 동절기에는 예열시 과열되지 않도록 하여야 한다.",
      "guideContext": "우레탄폼 원료 원액 관리",
      "additionalDetail": null,
      "workProcessPhase": "원료 원액 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-F3-006",
      "text": "발포 현장에서 폴리올에 촉매류, 정포제, 난연제 및 발포제 등을 혼합하여 사용하는 경우에는 원료 보관 및 취급에 따른 화재 위험성이 있으므로 저장 및 취급시 주의하여야 한다.",
      "guideContext": "우레탄폼 원료 원액 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "원료 원액 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-007",
      "text": "원료 드럼을 개방할 때에는 내부 증기압 상승에 따른 원료 및 원료증기가 분출되지 않도록 드럼의 마개를 서서히 돌려 개방하여야 한다.",
      "guideContext": "우레탄폼 원료 원액 관리",
      "additionalDetail": null,
      "workProcessPhase": "원료 원액 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-F3-008",
      "text": "발포제로 사용되는 HCFC-141b 또는 싸이클로펜탄은 비점이 낮기 때문에 밀폐 용기에 저장된 상태에서 외부온도가 상승하면 증기압에 의하여 폭발이 발생할 수 있으므로 저온 보관하여야 한다.",
      "guideContext": "우레탄폼 원료 원액 관리",
      "additionalDetail": null,
      "workProcessPhase": "원료 원액 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-F3-009",
      "text": "우레탄폼의 원료 보관 장소 또는 우레탄폼의 원료 제조시에는 용접 및 흡연 등과 같이 점화원이 될 수 있는 요인 등을 금지하여야 한다. 특히, 싸이클로펜탄은 인화점이 매우 낮은 액체이므로 점화원으로부터 격리하여야 한다.",
      "guideContext": "우레탄폼 원료 원액 관리",
      "additionalDetail": null,
      "workProcessPhase": "원료 원액 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-F3-010",
      "text": "발포 전 용접 등과 같은 화기작업을 중지하고 타 공종의 작업자와 안전회의를 실시한다.",
      "guideContext": "발포 전 사전 준비",
      "additionalDetail": null,
      "workProcessPhase": "발포 전 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-F3-011",
      "text": "필요한 경우 발포 현장과 동일한 장소에서는 배관, 전기 공사 등의 병행작업을 금지하여야 한다.",
      "guideContext": "발포 전 사전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "발포 전 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-012",
      "text": "발포 현장 주변에는 \"화기취급 주의 또는 경고\" 등의 안내표시를 하고 소화기구를 비치하며, 발포 현장이 지하공간 또는 냉동창고 등과 같은 실내인 경우에는 정전 대비 유도등 및 비상 조명기구를 설치하여야 한다.",
      "guideContext": "발포 전 사전 준비",
      "additionalDetail": null,
      "workProcessPhase": "발포 전 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-017",
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-F3-013",
      "text": "발포작업에 대한 사전 안전교육을 다음과 같이 실시한다. (가) 발포작업시의 화재 위험성 (나) 작업전 비상구 확인 및 비상시 대피 요령 (다) 여러 업체가 동시에 작업시 타 작업자와의 의사소통",
      "guideContext": "발포 전 사전 준비",
      "additionalDetail": null,
      "workProcessPhase": "발포 전 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-F3-014",
      "text": "지하실, 냉동창고 등과 같이 밀폐된 공간에서 작업하는 때에는 발포시 발생하는 유해가스가 제거되도록 강제 급기 및 배기장치를 설치하여야 한다.",
      "guideContext": "발포 전 사전 준비",
      "additionalDetail": null,
      "workProcessPhase": "발포 전 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-F3-015",
      "text": "싸이클로펜탄 등 인화성이 매우 높은 발포제를 사용하는 경우 발포 현장에서 사용하는 전기기계기구는 방폭형이어야 한다.",
      "guideContext": "발포 전 사전 준비",
      "additionalDetail": null,
      "workProcessPhase": "발포 전 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-F3-016",
      "text": "우레탄폼을 화학공정 장치 및 설비 등의 외부단열용으로 사용할 경우에는 다음과 같은 보호대책을 수립하여야 한다. (가) 햇빛의 자외선과 악천후로부터 보호대책 (나) 물리적 충격으로부터 보호대책 (다) 점화원으로부터 보호대책",
      "guideContext": "발포 전 사전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "발포 전 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-017",
      "text": "시공자는 우레탄폼 취급 장소에서의 화재를 예방할 수 있도록 <부록 1>의 6단계 화재예방 안전수칙을 준수하여야 한다.",
      "guideContext": "발포작업 중 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 중",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-018",
      "text": "시공자는 설계자가 제시한 시방서, 설계도서 및 건축 코드 등에 따라 우레탄폼을 엄격하게 시공하여야 한다.",
      "guideContext": "발포작업 중 시공 기준 준수",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 중",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-F3-019",
      "text": "우레탄폼 발포 시에는 우레탄폼 원료 제조자 및 공급자가 제공하는 안전보건정보를 준수하여야 하며, 발포 작업이 이루어지는 대상물의 온도가 5 ℃ 이하인 경우와 32 ℃ 이상인 경우에는 가급적 시공을 피하여야 한다.",
      "guideContext": "발포작업 중 온도 조건",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 중",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-020",
      "text": "인화성물질의 증기 또는 가연성가스가 체류할 수 있는 지하공간 또는 냉동창고 등 발포작업이 이루어지는 건축물 내부에는 인화성물질의 증기 또는 가연성 가스농도측정 및 경보장치를 이용하여 다음과 같은 경우 가스농도를 측정하도록 하여야 하며, 가스의 농도가 폭발한계 값의 25 % 이상인 때에는 즉시 근로자를 안전한 장소에 대피시키고 화기 기타 점화원이 될 우려가 있는 기계·기구 등의 사용을 중지하며 통풍·환기 등을 하여야 한다. (가) 매일 작업을 시작하기 전 (나) 인화성물질의 증기 또는 가연성가스에 대한 이상을 발견한 때 (다) 인화성물질의 증기 또는 가연성가스가 발생하거나 정체할 위험이 있을 때 (라) 장시간 작업을 계속하는 때",
      "guideContext": "발포작업 중 가스농도 측정 및 대피",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 중",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CONFINED-001",
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-F3-021",
      "text": "발포 시에는 흡연 또는 용접 등과 같은 화기 작업을 금지하고 지속적으로 화재 감시원이 감시하여야 한다.",
      "guideContext": "발포작업 중 화기작업 금지",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 중",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-F3-022",
      "text": "시공자는 발포작업 후에도 우레탄폼의 화재를 예방할 수 있도록 <부록 1>의 화재예방 안전수칙을 준수하여야 한다.",
      "guideContext": "발포작업 후 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 후",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-023",
      "text": "우레탄폼 표면의 상부 또는 우레탄 표면 등과 11 m 이내에서 화기작업을 수행하여야 할 경우에는 방화덮개 또는 방염포로 표면을 차단하고, 화재 감시원을 배치하여야 한다.",
      "guideContext": "발포작업 후 화기작업 시 보호조치",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 후",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-F3-024",
      "text": "가연물인 우레탄폼이 적재 또는 시공되어 있는 장소에서 용접 등의 화기작업을 할 경우, 화기작업을 행하는 자는 KOSHA GUIDE (안전작업허가지침)에 따라 화기작업허가서 발행 등 사전 안전조치를 수행한 후 실시한다.",
      "guideContext": "발포작업 후 화기작업허가 절차",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 후",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-F3-025",
      "text": "발포된 우레탄폼은 용접 또는 용단 중인 고열물 등과 접촉되지 않도록 주의하고, 우레탄폼을 벽체 및 천정 내장재로 마감할 경우에는 폼 표면 위에 12.5 mm 이상의 석고보드 또는 그와 동등한 성능을 갖는 불연재를 사용하여 내부를 점화원으로부터 격리하여야 한다.",
      "guideContext": "발포작업 후 불연재 격리",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 후",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-F3-026",
      "text": "이소시아네이트 및 폴리올을 혼합 발포한 후 혼합헤더 내부의 경화 방지를 위하여 메틸렌클로라이드(Methylene chloride) 등과 같은 인화성물질을 사용하여 청소하는 경우에는 인화성이 높은 유증기가 발생할 수 있으므로 주변의 점화원을 제거하여야 한다.",
      "guideContext": "발포작업 후 청소 시 점화원 제거",
      "additionalDetail": null,
      "workProcessPhase": "발포작업 후",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-F3-027",
      "text": "사용하고 남은 이소시아네이트와 시스템폴리올을 밀폐용기에 넣고 서로 혼합할 경우 반응에 의한 압력이 발생하여 용기가 파열 또는 폭발할 수 있으므로, 분리하여 잔여분을 처리하여야 한다.",
      "guideContext": "우레탄 원액 여분처리",
      "additionalDetail": null,
      "workProcessPhase": "원액 여분처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-F3-028",
      "text": "폐액이 담겨있는 폐액 밀폐용기는 파열 또는 폭발의 위험이 있으므로 반드시 압력이 상승하지 않도록 조치하여야 한다.",
      "guideContext": "우레탄 원액 여분처리",
      "additionalDetail": null,
      "workProcessPhase": "원액 여분처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-F3-029",
      "text": "발포후의 우레탄폼은 가연물이므로 우레탄폼 조각 또는 쓰레기가 다량 적재되어 방치되지 않도록 청소하여야 한다.",
      "guideContext": "우레탄 원액 여분처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "원액 여분처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-030",
      "text": "우레탄폼을 취급하는 작업장에는 환풍기 및 소화기를 비치하여 만약의 사태에 대비토록 한다.",
      "guideContext": "비상조치 장비 비치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-031",
      "text": "우레탄폼을 취급하는 작업장 및 당해 작업장이 있는 건축물에는 출입구외에 근로자가 안전한 장소로 대피할 수 있도록 1개 이상의 비상구를 다음과 같이 설치하여야 하며, 비상구에 문을 설치하는 경우에는 항상 사용 가능한 상태로 유지하여야 한다. (가) 출입구와 같은 방향에 있지 아니하고, 출입구로부터 3 m 이상 떨어져 있을 것 (나) 작업장의 각 부분으로부터 하나의 비상구 또는 출입구까지의 수평거리가 50 m 이하가 되도록 할 것 (다) 비상구의 폭은 0.75 m 이상으로 하고, 높이는 1.5 m 이상으로 할 것 (라) 비상구의 문은 피난방향으로 열리도록 하고, 실내에서 항상 열 수 있는 구조로 하며, 내부 및 외부에는 비상구의 표시를 할 것",
      "guideContext": "비상구 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-F3-032",
      "text": "비상구·비상통로 또는 비상용 기구에 대하여는 비상용이라는 표시를 하고 근로자가 쉽게 이용할 수 있도록 관리하여야 한다.",
      "guideContext": "비상구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-033",
      "text": "우레탄폼을 취급하는 작업장으로 통하는 장소 또는 작업장내에는 근로자의 통행을 위한 통로를 설치하고 통로에는 75럭스 이상의 채광 또는 조명시설을 설치하고, 통로의 주요한 부분에는 통로표시를 하여야 한다.",
      "guideContext": "작업장 통로 및 조명 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-F3-034",
      "text": "우레탄폼을 취급하는 연면적이 400 m² 이상이거나 상시 50인 이상의 근로자가 상주하는 실내작업장에는 비상시 근로자에게 신속하게 알리기 위한 경보용 설비 또는 기구를 설치하여야 한다.",
      "guideContext": "경보설비 설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-F3-035",
      "text": "화재발생시 즉시 화재경보를 발하고, 초기소화에 실패하는 경우 신속하게 안전한 장소로 대피할 수 있도록 근로자에게 주기적으로 소방교육 및 비상훈련을 실시하여 화재예방 및 대응활동에 대한 체제를 확립하여야 한다.",
      "guideContext": "소방교육 및 비상훈련",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-F3-001",
      "term": "우레탄폼",
      "definition": "한국산업규격 KS M 3809:2006(경질폴리우레탄폼 단열재)에서 정한 100 ℃이하의 보온 및 보냉에 사용하는 경질폴리우레탄폼 단열재 등 미리 성형한 우레탄폼 단열판과 현장에서 시공하는 스프레이 우레탄폼을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-F3-002",
      "term": "시스템폴리올",
      "definition": "폴리올에 촉매류, 정포제 및 발포제 등의 첨가제를 일정한 비율로 혼합하여 현장에서 별도의 부재료를 추가하지 않고 이소시아네이트와 바로 혼합시켜 우레탄폼을 발포·성형시킬 수 있도록 만든 폴리올을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
