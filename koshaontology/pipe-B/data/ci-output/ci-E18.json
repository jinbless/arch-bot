  "checklistItems": [
    {
      "identifier": "CI-E18-001",
      "text": "개폐장치 및 제어장치의 정비작업자는 법적 요구사항에 따라 작업하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-002",
      "text": "정비기간동안 발생하는 전기 이외의 모든 위험원에 대하여 보수과정의 안전측면에서 전부 고려하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-003",
      "text": "사업장의 장비를 운전하기 위하여 설치되는 전기설비에는 이에 적합한 안전규칙 및 절차를 수립하는 것이 권장된다.",
      "guideContext": "저압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-004",
      "text": "안전확보를 위해서는 안전작업허가제를 도입하는 것이 권장되며, 안전규칙 및 절차를 수립하는 기본원칙은 예상되는 모든 위험으로부터 실용 가능한 범위 내에서 위험을 예방할 수 있도록 수립되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-005",
      "text": "전기도체는 전류가 흐르지 않는 것이 사전 입증되지 않았으면 항상 활선인 것으로 간주하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-006",
      "text": "다른 장비의 운전으로 인해 도체가 활선으로 될 수 있는 경우에는 각별한 주의가 필요하며, 이러한 장비에는 외함에 경고표지 등 안내문을 부착하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-007",
      "text": "전기설비를 사용하는 동안 안전에 영향을 미치는 여러 요인이 변화할 수 있으므로, 설비변경 후 안전 조치사항 확인 및 정기점검 등을 실시하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-008",
      "text": "전기에 관한 모든 안전규정은 모든 사람들에게 엄격히 적용되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-009",
      "text": "전기설비의 보수작업 전에 비상구를 확인하고, 통행에 지장이 없도록 조치하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-010",
      "text": "작업장으로의 접근 또는 안전한 작업을 위해 고정형 또는 이동형 조명장치를 이용한 적절한 조명을 확보하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-011",
      "text": "설비 보수작업중 화재의 위험이 있을 때를 대비한 소화설비의 준비 및 이의 사용방법에 대한 교육이 필요하며, 필요시 비상연락을 할 수 있도록 하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-012",
      "text": "전기설비에 적용되는 소화설비의 형태는 기름화재의 경우 물을 사용하지 않아야 하며, 전기설비를 격리시키기 전에는 물을 이용한 소화설비가 사용되어서는 안 된다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-013",
      "text": "소화설비는 제조 또는 설치업체를 통하여 정기적으로 정비하여야 하며, 검사표지를 부착하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-014",
      "text": "자동 소화설비가 설치된 장소에는 이에 대한 내용을 건물 외부에 분명하게 표시하여야 하며, 자동 소화설비의 기능을 정지시키는 절차도 포함되어 있어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-015",
      "text": "자동 소화설비가 설치된 장소에 들어가거나, 작동중인 장소에 들어가는 경우 위험으로부터 개인 보호조치에 관한 절차가 수립되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-016",
      "text": "안전규칙이 정해지면 모든 운전원 및 작업자가 활용할 수 있도록 이를 공표하여야 하며, 운전원 및 작업자는 관련 설비에 대한 안전규칙을 숙지하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-017",
      "text": "감전이나 전기화재시의 응급조치 사항을 게시하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-018",
      "text": "전기설비의 회로도와 보호장치의 상세내용을 확보하여야 하며, 불시의 전원공급으로 작업자가 충전 도체에 노출되지 않도록 주의표시와 안전 잠금장치가 충분히 갖추어져야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-019",
      "text": "활선에 대한 위험표지를 항상 구비하여야 하며, 표지는 확연하게 읽기 쉽도록 변형이 되지 않은 재질로 제작하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-020",
      "text": "비상구는 건물 내부에서 외부로 탈출하는 방향으로 표지를 명확하게 부착하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-021",
      "text": "전기작업을 수행하는 경우 작업책임자는 감전시의 응급조치에 대한 지시를 명확히 하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-022",
      "text": "응급조치 설비는 작업자에 의해 이용 가능하도록 설치하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-023",
      "text": "가장 가까운 장소의 응급조치센터, 의사, 병원 등에 관한 주소와 전화번호가 작업장 주변에 게시되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-024",
      "text": "모든 전기기술자는 심폐소생술 훈련을 받아야 하고, 응급서비스 센터에 호출할 수 있는 방법을 알고 있어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-025",
      "text": "전기설비의 외함은 일반인이 쉽게 접촉이 되지 않도록 설계되어야 하고, 제작된 외함의 등급이 항상 유지되도록 관리하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-026",
      "text": "전기설비가 안전하게 동작하고 운전하는데 지장이 없도록 공간을 확보하고, 접근 경로에 장애물이 없도록 조치하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-027",
      "text": "이동사다리의 재질은 비도전성 재질을 사용하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-028",
      "text": "보수작업을 수행하기 전 전기설비는 가능한 격리시켜야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-029",
      "text": "격리절차에는 다음의 사항이 포함되어야 한다. (가) 불시에 에너지가 재충전되지 않도록 하는 조치 (나) 검전기를 사용하여 전기설비가 정전상태임을 확인하는 조치",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-030",
      "text": "정상상태에서 단로기가 개방(OFF)된 경우에는 전로로부터 분리된 위치에 주의 표시를 하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-031",
      "text": "퓨즈 링크를 설치하는 경우 이중으로 연결되지 않도록 주의사항을 표시하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-032",
      "text": "단로기 접점은 전로의 차단기로 역할을 대신해서는 안 된다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-033",
      "text": "예기치 못한 사고로 전로에 재충전되는 것을 방지하기 위한 관련 개폐기 연동장치는 너무 과신하면 안 된다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-034",
      "text": "차단부의 접점 작동상태는 기기의 외부에서 확인할 수 없고, 기계적 결함으로 인해 모든 접점이 개방되지 않을 수도 있으므로, 외부 손잡이(Handle)로 수동조작 또는 자동동작을 위한 제어전원이 반드시 차단하였다고 간주하면 안 된다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-035",
      "text": "기계적 연동장치를 사용한 외부 손잡이의 경우 전원의 차단실패 가능성이 높으므로, 정비작업 전에 계측기를 사용하여 정전상태임을 확인하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-036",
      "text": "정전을 확인하기 위한 전압시험은 오결선 상태를 고려하여 상전압 및 선간전압을 모두 확인하여야 하며, 전압계는 시험전후에 정상적임을 반드시 점검하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-037",
      "text": "전기설비에는 경보장치, 제어장치, 온습도조절기 및 조명, 축전지 전원 등 서로 다른 회로로부터 전원이 공급되고 있으므로, 주 전원이 차단되더라도 일부 활선상태인 주변 전원에 대하여는 절연덮개로 격리시키거나 경고표지 및 차단장치 등에 대한 설명을 부착하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-038",
      "text": "변압기로부터의 역송전 또는 변류기 2차 측의 개방에 따른 감전을 예방하기 위한 안전조치가 필요하다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-039",
      "text": "한 사람은 전원을 차단하고, 다른 사람은 보수작업을 하는 경우 전원을 차단하는 자는 작업대상 전기설비가 정전상태로 안전함을 확인하여야 하고, 재충전될 가능성이 없도록 안전조치를 취하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 전 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-040",
      "text": "감전 및 전기화상을 예방하기 위하여, 특별한 이유가 없는 한 활선 및 활선근접 작업을 하여서는 안 된다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-041",
      "text": "활선 및 활선근접작업을 시행하여야 하는 경우에는 수행작업의 특성과 장비의 설계의도를 고려하여 정비에 적합한 작업자의 수행능력에 대한 요구사항이 명시되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-042",
      "text": "작업을 시작하기 전 작업자의 수행능력이 적합한 지, 작업자에 대한 사전 안전조치 사항을 알려주었는지를 확인하는 절차가 수립되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-043",
      "text": "보수기간 중 오염물 침입에 대한 흔적을 검사하여 이의 흔적이 발견된 경우 오염물을 제거하고, 재발방지를 위한 조치가 이루어져야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-044",
      "text": "정비작업자에게는 안전확보를 위해 절연공구, 절연보호구, 방호구 등 절연장구가 제공되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-045",
      "text": "절연장구는 항상 절연성능을 유지하도록 주기적으로 확인 및 검사를 하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-046",
      "text": "접지장비가 필요한 경우에는 즉시 사용될 수 있도록 미리 구비하여야 하며, 그 기능을 유지할 수 있도록 관리가 되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-047",
      "text": "전압계는 사용목적에 적합한 전압범위와 고장전류에 견딜 수 있는 것을 사용하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-048",
      "text": "고장전류에 대한 보호장치는 전압을 측정하는 지점에서 가장 가까운 곳에 설치하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-049",
      "text": "케이블, 콘덴서 등 용량성 부하를 갖는 전기설비는 전로에 전압이 없음을 검전기로 확인하고, 충전된 에너지가 완전히 방전되었음을 확인하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-050",
      "text": "제어반의 기능시험시 제어반과 관련된 설비가 갑작스럽게 동작하지 않도록 주의하여야 하며, 전동기 및 밸브 등에 대하여는 기계적으로 분리시켜야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-051",
      "text": "이동식 전동기구 및 전동은 저압에서 사용되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-052",
      "text": "도전성의 밀폐공간에서 사용되는 전기장치는 대지전압 25 V 이하에서 사용되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-053",
      "text": "주 전원을 사용하는 이동식 전동기구는 외함 전체가 절연되거나 이중 절연구조의 것이 사용되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-054",
      "text": "전원에 연결되는 케이블의 길이는 최소화 되어야 하고, 외부 충격으로부터 보호되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-055",
      "text": "모든 노출된 금속제 외함은 접지가 되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.8",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-056",
      "text": "접지도체의 연결은 기계적으로 건고하여야 하고, 모든 연결나사는 꽉 죄어져서 접촉상태를 양호하게 하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.8",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-057",
      "text": "정비작업 중에 풀어진 볼트와 너트를 다시 조이도록 조치하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.8",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-058",
      "text": "전기설비의 정비작업에는 화염, 연기, 가스, 또는 액체가 침입할 수 있는 모든 부위에 대한 방화벽과 밀봉조치의 검사를 포함시켜야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-059",
      "text": "전압측정시 전압계에 흐르는 전류가 최소가 되도록 조치하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-060",
      "text": "모든 전기설비는 용량성 부하를 갖고 있어 전기를 저장할 수 있으므로 검전 후에는 반드시 방전시켜야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-061",
      "text": "전기설비가 시험전압 및 시험전류의 극성에 의해 손상되지 않도록 주의하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-062",
      "text": "시험장비는 극성을 잘못 연결하여 오동작 또는 단락전류가 흐르지 않도록 하는 구조의 것을 사용하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-063",
      "text": "시험장비의 모든 금속 외함은 항상 접지되어야 하고, 접지하지 않은 경우에는 안전작업절차와 같은 시험자의 안전을 위한 특별한 조치가 수립되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-064",
      "text": "처리방안이 불분명한 폐기물은 제조자의 권고사항을 참조하거나 해당 기관의 지시에 따라야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-065",
      "text": "손상된 부품을 재활용하는 경우 관련 안전규정을 만족하는지 확인하여야 하며, 사용시 재활용 부품임을 표기하는 등 특별한 주의가 필요하다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-066",
      "text": "주요 부품에 대한 정보는 기록하여 보존하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-067",
      "text": "기록에는 다음의 사항이 포함되어야 한다. (가) 장비의 상세내용이 있는 제작자 기술사양 (나) 최대 정비주기를 포함한 제작자 정비사양 (다) 제작자가 권장하는 예비부품 목록 (라) 보수 및 운전사양과 현장에서 발견한 주요 내용",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-068",
      "text": "주요 고장에 대하여는 원인 분석한 결과를 기록하여야 하고, 향후 예방대책이 수립되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-069",
      "text": "일부 부품은 정비하지 않고 정기적으로 새로운 부품으로 교체하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-070",
      "text": "반도체와 같은 전력전자 부품은 쉽게 손상될 수 있으므로, 정비는 하지 않고 이상현상이 발견된 때에는 일괄교체토록 하는 것이 바람직하다.",
      "guideContext": "저압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-071",
      "text": "연속운전을 하는 설비는 생산계획을 고려하여 정비계획을 수립하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비 주기 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-072",
      "text": "정비작업 전에 주요 회로에 대하여는 사전 진단을 수행하는 것이 권장된다.",
      "guideContext": "저압 개폐장치 정비",
      "additionalDetail": null,
      "workProcessPhase": "정기보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-073",
      "text": "고장전류가 흘러 이의 영향을 받은 전기설비 및 보호장치, 관련 부품 및 연결장치 등은 보수 후 재사용되기 전 안전하게 동작하는 지를 확인하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사후정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-074",
      "text": "애자(Porcelain) 또는 몰딩 절연재질은 금이 가거나 흠이 있는지를 점검하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연재 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-075",
      "text": "접착 또는 적층 섬유(Laminated fibrous), 기타 유기질 절연재질은 트래킹(Tracking), 수트리(Treeing), 부풀림, 갈라짐, 기계적 손상 등을 점검하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연재 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-076",
      "text": "절연재질은 측정 전에 건조시키고, 깨끗하게 청소하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연재 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-077",
      "text": "전기설비 내에 설치된 반도체 부품은 절연저항 측정시 인가되는 전압에 의해 소손될 우려가 있으므로, 반도체 부품을 포함한 전기설비의 절연저항 측정시에는 이에 대한 보호대책을 강구하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연재 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-078",
      "text": "절연유의 시험주기는 전기설비의 운전특성 및 제작업체의 권고사항을 기준으로 결정하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "절연재 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-079",
      "text": "어떤 조건하에서도 오작동하지 않도록 기계적인 잠금장치는 주의깊게 확인하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잠금장치 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-080",
      "text": "잠금장치는 부식되지 않아야 하며, 운전으로 인해 스스로 풀어지지 않는 구조의 너트, 잠금장치 등을 구비하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "잠금장치 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-081",
      "text": "연동장치를 시험할 때 이의 오동작 또는 잘못된 조작으로 인해 작업자가 위험하지 않도록 주의하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-082",
      "text": "차단기 외함이 적정위치까지 완전히 체결되기 전까지는 차단기가 투입되어 회로를 연결시키면 안 된다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "인출시 회로를 분리시키는 차단기의 기계적 연동장치 요구사항",
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "13.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-083",
      "text": "차단기가 개방되어 회로를 분리하기 전까지는 접점위치로 차단기함을 끌어내거나 원래의 위치에서 이동시킬 수 없어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "인출시 회로를 분리시키는 차단기의 기계적 연동장치 요구사항",
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "13.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-084",
      "text": "연동장치를 점검 또는 정비하는 자는 관련 전기지식과 전기설비에 대한 경험이 풍부하고, 연동장치의 기능과 특성, 목적 등을 충분히 이해하고 있어야 하며, 필요시 제작업체의 설치·운전·정비 매뉴얼을 참고하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "13.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-085",
      "text": "볼트, 레버, 스프링, 슬라이드, 잠금장치 등을 깨끗이 청소하고, 정확히 작동되도록 윤활제를 발라야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "연동장치 기계적 정비",
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-086",
      "text": "과도한 손상이나 저절로 움직이는 경우에는 제작업체와 협의하여 정비하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "연동장치 기계적 정비",
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-087",
      "text": "볼트, 너트, 나사, 고정 핀과 같은 모든 고정장치는 풀림이 없이 정확히 설치되어 있는 지를 확인하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "연동장치 기계적 정비",
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-088",
      "text": "제어전선 및 연결 단자대 부위에 손상이 없는 지를 확인하고, 필요시 보수하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "연동장치 전기적 정비",
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-089",
      "text": "제어회로에 대한 절연시험을 수행하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": "연동장치 전기적 정비",
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-090",
      "text": "모선과 분기회로의 전원을 재투입하기 전 모든 연동장치의 기능시험을 수행하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-091",
      "text": "기능시험은 원래의 설계 의도대로 모든 작동제어 절차가 시행되는 것과 위험한 작동이 없는 지를 확인하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-092",
      "text": "연동장치의 결함이 발견되었으나 즉시 정비 또는 대체가 불가능한 경우에는 다른 보조수단을 이용하여 안전을 확보하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연동장치 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "13.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-093",
      "text": "장비는 잘못된 부분을 정비하여 부품별 기능이 올바르게 작동되도록 복구되어야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비결과 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-094",
      "text": "외부 장비 또는 느슨한 배선이 어떤 위험도 초래하지 않도록 하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비결과 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-095",
      "text": "계기 및 계전기 덮개를 안전하게 다시 덮어야 하며, 모든 외함의 체결볼트는 확실히 조여야 하고, 개폐문은 안전하게 잠근 후 원래의 보호등급이 유지되도록 하여야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비결과 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "14",
      "basedOn": null
    },
    {
      "identifier": "CI-E18-096",
      "text": "안전규칙에서 정한 모든 절차가 지켜져야 한다.",
      "guideContext": "저압 개폐장치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비결과 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "14",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E18-001",
      "term": "개폐장치(Switchgear)",
      "definition": "전력공급계통에서 전원을 연결하거나 차단하기 위한 개폐기구, 제어장치, 측정장치, 보호장치 등이 하나의 외함 또는 부속설비로 이루어 진 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E18-002",
      "term": "제어장치(Controlgear)",
      "definition": "전력계통에 연결된 전력설비의 제어를 위하여, 개폐장치, 측정장치, 보호장치 등이 하나의 외함 또는 부속설비로 이루어 진 것을 말한다.",
