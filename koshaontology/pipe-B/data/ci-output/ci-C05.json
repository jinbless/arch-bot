  "domainTerms": [
    {
      "identifier": "DT-C05-001",
      "term": "돌관작업",
      "definition": "당초에 계획된 공사기간에 공사목적물을 완성하기 위해 인력·장비의 추가투입, 교대근무 또는 야간근무 등 근무시간을 연장하여 실시하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C05-002",
      "term": "교대근무",
      "definition": "하나의 작업을 함에 있어 근로자를 2개조 이상으로 나눠 각기 다른 시간대에 근무하도록 함으로써 전체 작업시간을 늘리는 근로 형태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C05-003",
      "term": "야간작업",
      "definition": "주간작업에 비하여 특히 조명, 기온 등 작업환경의 변화에 적절한 조치가 요구되는 작업을 말하며 통상 오후 10시부터 오전 6시까지를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
