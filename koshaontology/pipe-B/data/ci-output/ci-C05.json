  "checklistItems": [
    {
      "identifier": "CI-C05-001",
      "text": "발주자는 건설공사 발주 시 돌관작업을 하지 않고도 계획된 공사기간 내에 준공할 수 있도록 적정한 공사기간을 보장하여야 한다.",
      "guideContext": "돌관작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-002",
      "text": "돌관작업을 추진하게 하는 경우에는 공사품질 및 근로자의 안전보건을 확보하기 위한 적정한 공사비 또는 산업안전보건관리비를 추가로 산정하여 공사금액에 반영하여야 한다.",
      "guideContext": "돌관작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-003",
      "text": "건설업체로부터 돌관작업 계획서를 제출 받아 작업계획에 따라 시공하는지 여부를 수시로 확인하여야 한다.",
      "guideContext": "감독자 및 감리자 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-004",
      "text": "일일 작업계획이 품질 및 안전·보건을 확보하기 위해 적정하게 수립·이행되는지 확인한다.",
      "guideContext": "감독자 및 감리자 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-005",
      "text": "돌관작업으로 안전보건 조치가 불량하여 중대한 사고 발생 위험이 있는 경우 공사를 중단하도록 하고, 해당 위험에 대한 안전보건조치가 완료된 후 공사를 재개하여야 한다.",
      "guideContext": "감독자 및 감리자 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-006",
      "text": "돌관공사 전 작업계획을 수립하여야 하며 계획 수립 시 근로자투입 및 근무시간의 적정 배분 계획, 미숙련 근로자에 대한 안전·보건교육실시 계획, 근로자 휴게시설 확보 계획, 관리감독자 및 안전·보건관리자의 운용계획, 작업장에 동시 투입가능 장비의 수량 및 운용계획, 가설재 및 안전시설물 확보 및 설치계획, 가설전기·가설용수 등의 확충 계획, 동시작업에 의한 위험성 평가 및 대책, 작업장 내 근로자 및 장비의 동선 계획 및 정리정돈 계획, 화재·폭발예방 및 대피계획, 재해 발생 시 구조 및 응급처치 계획을 고려하여야 한다.",
      "guideContext": "건설업체 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-007",
      "text": "일일 작업계획을 수립하여 위험요인을 사전에 제거하도록 노력하여야 한다.",
      "guideContext": "건설업체 의무 (법령 근거 미확인)",
      "additionalDetail": "위험성 평가를 통한 사전 대책 수립, 대형사고의 위험이 있는 고위험작업에 대한 안전작업계획 수립",
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-008",
      "text": "다수 공종의 작업이 동시에 진행됨에 따라 발생 할 수 있는 위험을 최소화 할 수 있도록 공정회의 또는 협의체회의를 통해 작업상황과 유해·위험요인 및 예방대책을 공유하고 이행하여야 하며, 반드시 근로자에게 주지시켜야 한다.",
      "guideContext": "건설업체 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-009",
      "text": "산업재해예방을 위해 관련 법규 및 안전보건기준을 준수하여야 한다.",
      "guideContext": "근로자 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-010",
      "text": "급박한 위험이 있는 경우 즉시 작업을 중단하고 안전한 장소로 대피하여 관리감독자에게 보고하여야 한다.",
      "guideContext": "근로자 의무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-011",
      "text": "근로자 동원 계획 수립 시 근로기준법에서 정한 근로시간을 초과하지 않도록 한다.",
      "guideContext": "돌관작업 근로자관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자관리 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-012",
      "text": "교대근무 편성 등으로 충분한 휴식시간을 확보한다.",
      "guideContext": "돌관작업 근로자관리 계획 (법령 근거 미확인)",
      "additionalDetail": "근로시간이 4시간 이상인 경우에는 30분 이상, 8시간인 경우에는 1시간 이상의 휴게시간을 근로시간 도중에 주어야 한다.",
      "workProcessPhase": "근로자관리 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-013",
      "text": "동일 장소에서 다수의 공종·공정이 동시작업을 실시할 경우 발생 가능성이 있는 사고의 잠재된 유해·위험요인에 대한 위험성평가를 실시하여 공종·공정간 간섭과 영향이 최소화 되도록 작업 계획을 수립한다.",
      "guideContext": "돌관작업 근로자관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-014",
      "text": "위험성평가에는 동일 장소에 다수의 건설장비 운용시 충돌·협착 위험, 인화성물질·가연성가스 사용과 용접·용단 등 화기사용 작업시 화재·폭발 위험, 구조물 또는 흙막이공사시 붕괴 위험, 상·하 동시작업에 따른 낙하 위험 등에 대한 평가가 포함되어야 한다.",
      "guideContext": "돌관작업 근로자관리 계획",
      "additionalDetail": null,
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C05-015",
      "text": "미숙련 근로자 및 신규근로자에 대한 안전교육 실시계획을 수립한다.",
      "guideContext": "돌관작업 근로자관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자관리 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-016",
      "text": "야간작업 시 근로자 식별이 용이하도록 야광 반사조끼 지급 및 착용 계획을 수립한다.",
      "guideContext": "돌관작업 근로자관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-017",
      "text": "장비 투입 전 사전점검 및 정기점검 계획을 수립한다.",
      "guideContext": "돌관작업 장비관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비관리 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-018",
      "text": "장비의 동선이 서로 간섭되지 않도록 계획을 수립한다.",
      "guideContext": "돌관작업 장비관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비관리 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-019",
      "text": "신호수 또는 유도자 배치계획을 수립한다.",
      "guideContext": "돌관작업 장비관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비관리 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-020",
      "text": "야간작업 시 장비 전락 방지를 위한 가설도로 조명 및 점멸등 설치 계획, 안전표지판 설치위치 및 식별을 위한 조명 설치 계획, 장비 식별을 위한 경광등 및 반사테이프를 부착 계획을 수립한다.",
      "guideContext": "돌관작업 장비관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-021",
      "text": "공사물량 증가에 따른 가설재 및 안전시설물 수급계획을 수립한다.",
      "guideContext": "가설구조물 및 안전시설물 설치 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가설구조물 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-022",
      "text": "빠르게 진척되는 공정에 따라 사전에 비계, 거푸집동바리 구조검토 및 조립도를 작성하고 근로자에게 그 내용을 교육하도록 계획한다.",
      "guideContext": "가설구조물 및 안전시설물 설치 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가설구조물 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-023",
      "text": "일일 또는 주간단위로 단위작업 및 동시에 진행되는 타 공종의 작업의 영향을 포함하여 위험성평가 실시계획을 수립한다.",
      "guideContext": "일반 안전보건관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-024",
      "text": "매일 작업 전 TBM(Tool Box Meeting)· 위험예지활동 및 안전시설물 등에 대한 안전점검 등 구체적인 안전활동 실시계획을 수립한다.",
      "guideContext": "일반 안전보건관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-025",
      "text": "작업장까지 안전하게 이동하기 위한 안전통로 설치계획을 수립한다.",
      "guideContext": "일반 안전보건관리 계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가설구조물 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-026",
      "text": "정전 발생 시 전력복구 또는 공급 계획을 수립한다.",
      "guideContext": "일반 안전보건관리 계획",
      "additionalDetail": "한국전력 등 유관기관 비상연락망 구축, 비상발전기 수량 및 설치 계획 포함",
      "workProcessPhase": "돌관작업 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-C05-027",
      "text": "현장 임의출입을 방지하기 위한 조치를 한다.",
      "guideContext": "돌관작업 현장 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-028",
      "text": "근로자의 과로를 방지하기 위해 근로자별로 일일 작업시간을 기록한다.",
      "guideContext": "돌관작업 현장 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-029",
      "text": "공종별 또는 교대 근무조 별로 식별이 용이하도록 작업복, 안전모의 색을 달리하여 착용하도록 한다.",
      "guideContext": "돌관작업 현장 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-030",
      "text": "미숙련근로자는 단독작업에 투입하지 않는다.",
      "guideContext": "돌관작업 현장 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-031",
      "text": "신규채용근로자에 대한 안전교육을 철저히 실시한다.",
      "guideContext": "돌관작업 현장 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-032",
      "text": "근로자가 피로를 회복할 수 있도록 충분한 휴게시설을 마련한다.",
      "guideContext": "돌관작업 현장 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-033",
      "text": "야간작업 개시와 종료 시에는 관리감독자에게 보고하도록 한다.",
      "guideContext": "돌관작업 야간 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-034",
      "text": "야간에 식별이 용이하도록 근로자의 안전모, 안전화, 작업복에 부착된 반사물의 부착상태를 확인한다.",
      "guideContext": "돌관작업 야간 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-035",
      "text": "기온이 내려갈 우려가 있는 경우 근로자의 체온을 유지 될 수 있는 복장을 착용하도록 하고, 임의로 불을 피우지 않도록 관리한다.",
      "guideContext": "돌관작업 야간 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-036",
      "text": "근로자에게 소화기, 비상조명기기 및 전원스위치의 위치를 알려주어야 한다.",
      "guideContext": "돌관작업 야간 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-037",
      "text": "일일 공정회의를 통해 작업 장소 및 작업의 위험성 등을 공유한다.",
      "guideContext": "돌관작업 현장 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-038",
      "text": "자재의 낙하, 화재·폭발 등의 위험이 발생하지 않도록 장소 또는 시간적으로 작업을 적절히 분리한다.",
      "guideContext": "돌관작업 현장 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-039",
      "text": "인화성 물질을 사용하는 작업과 용접 등 화기를 사용하는 작업은 작업장소를 철저히 분리하여 작업한다.",
      "guideContext": "돌관작업 현장 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-040",
      "text": "상·하부 동시 작업으로 낙하 및 추락의 위험이 발생하지 않도록 작업을 배치한다.",
      "guideContext": "돌관작업 현장 작업 관리",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C05-041",
      "text": "작업 위치별로 작업공종과 위험요인을 알리는 안내표지를 설치한다.",
      "guideContext": "돌관작업 현장 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-042",
      "text": "근로자와 장비의 동선이 겹치지 않도록 하며, 동선이 겹치는 곳에는 울타리·방호울 등을 설치하여 구분한다.",
      "guideContext": "돌관작업 현장 작업 관리 (법령 근거 미확인)",
      "additionalDetail": "공사차량 및 장비 등의 진출입로에는 경광등을 설치한다.",
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-043",
      "text": "화재예방을 위해 소화기를 충분히 비치하고 그 위치를 쉽게 알 수 있도록 표지를 부착한다.",
      "guideContext": "돌관작업 현장 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-044",
      "text": "신호의 불일치, 인식의 오류에 의한 재해를 예방하기 위해 각 작업공종 간 신호체계를 확립하고 근로자에게 주지시킨다.",
      "guideContext": "돌관작업 현장 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-045",
      "text": "야간작업 일지를 기록하고 다음 작업반과 인계인수를 철저히 하도록 한다.",
      "guideContext": "돌관작업 야간 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-046",
      "text": "야간작업 시 작업장의 최소조도는 조도기준을 준수한다.",
      "guideContext": "돌관작업 야간 작업 관리 (법령 근거 미확인)",
      "additionalDetail": "일반 실내 및 지하 작업장 55Lux 이상, 일반 옥외 33Lux 이상, 피난 또는 비상구 바닥 110Lux 이상",
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-047",
      "text": "개구부 주변에는 별도의 조명을 설치한다.",
      "guideContext": "돌관작업 야간 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-048",
      "text": "가급적 단독작업은 금하고, 2인 이상이 함께 작업하도록 관리한다.",
      "guideContext": "돌관작업 야간 작업 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-049",
      "text": "비상전원 공급 장치, 비상 조명등의 이상 유무를 확인한다.",
      "guideContext": "돌관작업 야간 작업 관리",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-C05-050",
      "text": "안전인증을 받지 않는 가설재는 현장에 반입되지 않도록 관리감독자로 하여금 자재검수를 철저히 하도록 한다.",
      "guideContext": "돌관작업 가설재 관리 (법령 근거 미확인)",
      "additionalDetail": "안전인증을 받지 않은 가설재 반입 시 현장 외부로 즉시 반출한다.",
      "workProcessPhase": "가설재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-051",
      "text": "비계 조립도를 작성하고 조립도에 따라 설치하도록 근로자에게 특별안전교육을 실시한다.",
      "guideContext": "돌관작업 가설재 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가설재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-052",
      "text": "거푸집동바리 구조검토 및 조립도를 작성하고 조립도에 따라 시공되는지를 확인한다.",
      "guideContext": "돌관작업 가설재 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가설재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-053",
      "text": "야간작업 시 차량 및 근로자의 충돌을 방지하기 위한 반사테이프 등 식별표지를 부착한다.",
      "guideContext": "돌관작업 야간 가설재 관리 (법령 근거 미확인)",
      "additionalDetail": "야간에 작업발판 및 구조물의 단부에 반사테이프를 부착하고, 특히 위험한 장소에는 조명을 설치한다.",
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-054",
      "text": "방호장치가 부착되지 않은 장비는 사용할 수 없다.",
      "guideContext": "돌관작업 건설장비 관리",
      "additionalDetail": "사전에 인가되지 않은 장비는 현장에 반입되지 않도록 한다.",
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-008"
      ]
    },
    {
      "identifier": "CI-C05-055",
      "text": "운전원의 자격유무를 확인하고 무자격자의 운전을 금지한다.",
      "guideContext": "돌관작업 건설장비 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-056",
      "text": "장비의 일일점검 등 정기적인 점검을 실시한다.",
      "guideContext": "돌관작업 건설장비 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-057",
      "text": "장비작업 시 또는 이동시 반드시 신호수 또는 유도자를 배치하고, 그 유도에 따라 작업한다.",
      "guideContext": "돌관작업 건설장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-010"
      ]
    },
    {
      "identifier": "CI-C05-058",
      "text": "차량 및 건설장비에는 전조등 및 후진 시 경고음의 정상 작동을 확인하여야 한다.",
      "guideContext": "돌관작업 건설장비 관리",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-C05-059",
      "text": "야간작업 시 장비 운전원의 과로를 방지하기 위해 일일 근무시간, 건강상태를 확인하고 작업에 투입한다.",
      "guideContext": "돌관작업 야간 건설장비 관리 (법령 근거 미확인)",
      "additionalDetail": "장비에는 전조등, 경광등을 부착하여 식별이 쉽도록 한다.",
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-060",
      "text": "전기 기계·기구의 현장 반입 시 안전장치 부착, 절연상태 등을 사전에 점검하고 점검필증을 붙여서 관리한다.",
      "guideContext": "돌관작업 전기기계기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-061",
      "text": "사전점검을 받지 않은 기계·기구의 사용을 금지한다.",
      "guideContext": "돌관작업 전기기계기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-062",
      "text": "동시 작업으로 인한 전력 수요의 증가를 수용할 수 있도록 가설전기의 용량을 증설한다.",
      "guideContext": "돌관작업 전기기계기구 관리 (법령 근거 미확인)",
      "additionalDetail": "전기 기계·기구류의 수량 및 용량을 고려하여 가설분전함 및 전선 용량을 증설하고, 가설분전함의 전원인출 회로에 작업공종을 알 수 있는 명폐를 부착하고, 임의 조작을 금지하기 위해 가설 분전함은 잠금장치를 한다.",
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-063",
      "text": "감전재해 방지를 위해 접지 및 누전차단기의 설치 상태를 일일 점검한다.",
      "guideContext": "돌관작업 전기기계기구 관리",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-C05-064",
      "text": "가설분전함 주위에는 충분한 밝기의 조명을 설치한다.",
      "guideContext": "돌관작업 전기기계기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건설장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-065",
      "text": "돌관작업 계획에 명기된 휴게시간의 준수여부를 확인한다.",
      "guideContext": "돌관작업 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-066",
      "text": "작업 중 수시로 휴식을 할 수 있는 간이 휴게시설을 충분히 마련하여야 한다.",
      "guideContext": "돌관작업 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-067",
      "text": "작업시작 전 근로자의 건강상태 및 피로도를 확인하여 투입여부를 결정하여야 한다.",
      "guideContext": "돌관작업 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-068",
      "text": "혈압계, 간이혈당계 등 간이 건강검진 장비와 비상약품을 현장에 비치하고 근로자의 건강관리를 지원하여야 한다.",
      "guideContext": "돌관작업 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-069",
      "text": "정기적으로 근로자 건강검진을 실시하고, 건강 이상자는 위험작업에 투입을 금지한다.",
      "guideContext": "돌관작업 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-070",
      "text": "화재·붕괴 등의 비상시에 대비하여 연락체계, 대피 경로 및 유도자 배치, 대피 장소 등이 포함된 비상시 피난계획을 수립·시행하여야 한다.",
      "guideContext": "비상시 긴급 안전조치 (법령 근거 미확인)",
      "additionalDetail": "비상시에 대피경로를 쉽게 알 수 있도록 안내표지를 설치하고, 정전시를 대비하여 비상조명등, 유도등, 손전등을 설치하며, 비상시에 사용할 수 있는 경보설비를 설치한다.",
      "workProcessPhase": "비상시 긴급 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-071",
      "text": "비상시를 대비해 근로자를 대상으로 대피 훈련을 실시한다.",
      "guideContext": "비상시 긴급 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상시 긴급 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-072",
      "text": "응급조치시설, 구난장비 등을 비치하고 성능을 유지하여야 한다.",
      "guideContext": "비상시 긴급 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상시 긴급 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-073",
      "text": "작업장에서 가까운 거리에 야간 응급실을 갖춘 종합병원을 사전에 지정하여 재해발생에 대비하여야 한다.",
      "guideContext": "비상시 야간작업 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-074",
      "text": "사업주는 작업에 필요한 가시설 및 안전시설물이 적정하게 확보되지 않은 경우 작업을 금지시켜야 한다.",
      "guideContext": "작업의 중지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-075",
      "text": "정전이 예고된 경우의 야간작업을 금지시켜야 한다.",
      "guideContext": "작업의 중지",
      "additionalDetail": null,
      "workProcessPhase": "야간작업 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-C05-076",
      "text": "강풍, 강우, 강설, 혹한 시 옥외작업을 금지시켜야 한다.",
      "guideContext": "작업의 중지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-077",
      "text": "안전보건조치가 미흡하여 재해발생 위험이 높은 경우 작업을 금지시켜야 한다.",
      "guideContext": "작업의 중지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-078",
      "text": "중대재해가 발생하였을 때 작업을 금지시켜야 한다.",
      "guideContext": "작업의 중지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "현장 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-C05-079",
      "text": "근로자는 산업재해가 발생할 급박한 위험이 있는 경우 작업을 중지하고 대피하였을 때에는 그 사실을 바로 위 상급자에게 보고하고, 바로 위 상급자는 이에 대한 적절한 조치를 하여야 한다.",
      "guideContext": "작업의 중지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상시 긴급 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    }
