  "checklistItems": [
    {
      "identifier": "CI-D46-001",
      "text": "화재를 예방하기 위해서는 화재의 3요소 중 최소한 1요소 이상을 관리하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-002",
      "text": "일반적으로 화학공장은 인화성 가스 및 인화성 물질을 대량으로 취급하고 있고, 산소는 공기중에 약 21 % 포함되어 있어서 가연물 및 산소의 관리가 어려우므로, 다음과 같이 점화원을 집중관리하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": "정상운전 중에는 고열, 고온, 정전기 및 충격 등 점화원 관리, 정비작업 시에는 가연물 관리",
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-003",
      "text": "다음과 같은 물질은 산소가 없어도 연소(폭발)가 가능함으로 특별하게 관리하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": "디보란, 니트로메탄 등 폭발성 물질, 마그네슘·알루미늄·칼륨 등 발화성물질",
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-004",
      "text": "펌프는 구동부위인 그랜드(Gland)나 실(Seal)에서 내부 유체가 누출되기 쉽고 누출과 동시에 화재를 일으킬 수 있다. 따라서 이중구조의 기계적 실(Mechanical seal)을 사용하는 등의 방법으로 누출을 최소화할 수 있다.",
      "guideContext": "화학공장의 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D46-005",
      "text": "누출을 예방하기 위해서는 운전개시(Start-up)시에 온도의 상승이나 하강을 단위시간당 허용하는 범위 내에서 실시하고, 기술기준에서 제시하는 온도에서 토크렌치를 사용하는 등의 적정한 회전력으로 볼트의 재조임 작업(고온볼트 작업, 냉각볼트 작업)을 해주어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D46-006",
      "text": "근로자들에게 지급되는 작업복은 10,042 kJ/m2 h 정도의 복사열에 견딜 수 있는 작업복을 지급하도록 권장한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-D46-007",
      "text": "여름철용으로 지급되는 작업복도 소매가 긴 작업복을 지급하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-D46-008",
      "text": "사업장 내에서 취급하는 위험물은 잘 설계된 취급설비(용기류나 배관류 등)에서 벗어나지 않도록 관리되어야 한다. 취급설비에서 벗어날 경우에는 소각 처리를 하는 등의 조치를 취하여 안전하게 배출되도록 하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-009",
      "text": "위험물 취급설비는 공정의 운전조건(운전압력, 운전온도 등)과 취급물질의 물성, 사용재질의 특성, 설비의 설치목적 등에 따라 내압, 내열성 또는 내부식성을 고려하여 설계하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D46-010",
      "text": "윤활유 등과 같이 인화점이 높아서 위험물질에 포함되지 않는 물질도 고압에 의해 미스트(Mist) 상태로 분무되는 경우에는 가스와 같은 위험성을 갖게 되므로 핀홀(Pinhole)과 같은 미세한 구멍에서 안개처럼 누출되지 않도록 관리되어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-011",
      "text": "압력용기의 설계압력과 설계온도는 KOSHA GUIDE \"화학설비 등의 공정설계지침\"에 따라 결정하여야 하며, 재질은 KOSHA GUIDE \"화학설비의 재질선정에 관한 기술지침\"에 따라 부식방지 측면에서 취급 유체에 적합한 재질을 선정하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D46-012",
      "text": "배관의 설계조건은 KOSHA GUIDE \"화학설비의 공정설계지침\"에 따라 결정하여야 하며, 재질은 KOSHA GUIDE \"화학설비의 재질선정에 관한 기술지침\"에 따라 부식방지 측면에서 취급유체에 적합한 재질을 선정하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D46-013",
      "text": "취급 유체의 조건에 적합한 재질의 개스킷을 사용하고, 접합면을 상호 밀착시키는 등 적절한 조치를 취하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-D46-014",
      "text": "인화성 물질을 저장하는 상압탱크는 탱크의 입·출하와 일광에 의한 증발량을 고려하여 충분한 크기의 통기구를 상부에 설치하여야 한다. 외부화재 등 복사열에 의한 증발량 증가에 대해서는 통기구외에 긴급통기설비를 설치하고, 지붕형 상압탱크 내부폭발에 대해서는 탱크의 원통과 지붕을 연결하는 부위에 취약부위를 만들어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-015",
      "text": "액화석유가스와 같이 상온·상압 하에서 가스인 인화성 가스를 액화시켜 보관하거나 액상의 가연성 물질을 압력용기에 보관하는 경우에 설비의 주위에서 화재가 발생되면 전달된 열에 의해 비등액체팽창증기운폭발이 발생될 수 있으므로, 설비의 냉각이나 복사열을 차단하기 위한 물분무설비 등이 설치되어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-016",
      "text": "인화성 물질, 가연성 액화가스 등을 저장하는 탱크의 주위에는 누출 시 확산에 의한 화재의 확대를 예방하기 위하여 방유제를 설치하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": "방유제는 KOSHA GUIDE \"방유제 설치에 관한 기술지침\"에 따른다",
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-017",
      "text": "가스 또는 분진폭발위험장소에 설치되는 건축물 등에는 화재 시 붕괴에 의한 화재의 확대를 방지하기 위하여 철구조물에 내화조치를 하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": "내화의 방법은 KOSHA GUIDE \"내화구조에 관한 기술지침\"에 따른다",
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1.7",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-D46-018",
      "text": "공정으로부터 배출되는 인화성 물질의 증기, 인화성 가스 등은 연소·흡수·세정·포집 또는 회수 등의 방법으로 처리하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1.8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-019",
      "text": "위험물을 취급하는 설비의 성능을 유지하기 위해서는 주기적으로 유지·보수를 실시하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": "설비의 유지·보수는 KOSHA GUIDE \"화학공장의 정비·보수에 관한 기술기준\"에 따른다",
      "workProcessPhase": "위험물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1.9",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-020",
      "text": "대형의 위험물저장탱크에 화재가 발생하였을 때는 내부의 위험물을 펌프를 이용하여 안전한 장소로 이송하는 등의 방법으로 화재의 규모를 최소화하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.1.10",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-021",
      "text": "설비의 점검·정비 시에는 비점화성 재질의 공구류를 사용한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-022",
      "text": "높은 장소에서는 철재 자재 또는 공구 등 낙하 위험이 있는 물체가 방치되지 않도록 정리정돈 등의 조치가 필요하다.",
      "guideContext": "화학공장의 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D46-023",
      "text": "인화성 가스의 압축과 같은 단열압축은 압력의 증가에 따라 온도가 상승하므로, 압축된 가스의 온도가 취급중인 물질의 발화온도와 비교하여 발화온도의 80 %를 초과하지 않도록 다단압축을 시키면서 중간냉각을 시키는 등의 조치가 필요하다.",
      "guideContext": "화학공장의 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D46-024",
      "text": "가스폭발위험장소나 분진폭발위험장소에 사용되는 전기설비는 점화원으로 작용되지 않도록 적절한 형태의 방폭형 전기기계기구를 설치하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2.4",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-D46-025",
      "text": "방폭구조 전기기계기구의 성능은 KOSHA GUIDE \"방폭전기설비의 선정 및 유지보수에 관한 기술지침\"에 따라 유지·보수하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.4",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-D46-026",
      "text": "운전온도는 당해 위험물 발화온도의 80 %를 초과하지 않도록 공정물질과 스팀 사용 기기류에 대해서는 보온조치를 하여 고온의 표면이 노출되지 않도록 하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-D46-027",
      "text": "정전기는 이론상 10^6 Ω 이하만 유지하면 체류하지 않는 것으로 되어 있지만 전기적으로 격리된 부위에 대해서는 본딩(Bonding) 등의 방법으로 10^3 Ω 이하로 유지하여야 한다. 그리고 설비의 한곳 이상은 접지저항 10 Ω 이하의 접지를 실시하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2.6",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-D46-028",
      "text": "정전기로 인해 인체에 대전될 수 있는 에너지는 탄화수소류의 평균적인 최소점화에너지의 40배에 해당하여 화학공장내에서 점화원으로 작용될 위험이 있다. 따라서 근로자들에게 지급되는 작업복은 제전사의 코로나방전의 원리에 의해 인체의 정전기를 위험수준 이하로 낮추어주는 제전복을 지급하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.6",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-D46-029",
      "text": "운전온도가 대기온도보다 높아서 고온용 보온을 해놓은 부위에 고비점의 탄화수소(윤활유 등)가 침투되어 있거나, 기름걸레를 한 곳에 장기간 방치하는 경우에 발화할 수 있으므로 청결하게 유지되어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-D46-030",
      "text": "발화점이 비교적 낮은 고분자물질(예 : C4고분자 등)이 모아져 햇빛에 노출된 경우는 자연발화가 쉽게 이루어지므로, 이러한 조건을 피하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2.7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-D46-031",
      "text": "불활성 가스는 질소, 이산화탄소, 수증기 또는 연소배기가스 등이 사용된다. 연소억제제를 위하여 관리되어야 할 산소의 농도는 안전율을 고려하여 해당물질의 최소산소농도 보다 4 % 정도 낮게 관리되어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "산소 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-D46-032",
      "text": "안정적이고 지속적인 불활성화를 유지하기 위해서 대상설비에 산소농도측정기를 설치하고 산소농도를 관리하여야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "산소 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-D46-033",
      "text": "산소농도측정기는 정확한 농도측정을 위하여 제조회사에서 제시하는 기간이 초과되기 전에 교정이 필요하며, 감지부(Sensor)를 주기적으로 교체해 주어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "산소 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-D46-034",
      "text": "화재발생시 조기에 감지하여 효과적으로 소화활동을 실시하기 위해서는 「소방시설유지 및 안전관리에 관한 법률」 동법 시행령 제3조에 따른 소방시설(소화설비, 경보설비, 피난설비, 소화용수설비 및 소화활동설비)의 철저한 유지·보수 및 관리가 필요하다.",
      "guideContext": "화학공장의 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소화설비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D46-035",
      "text": "화학공장에서 운용이 가능한 설비 및 근로자들의 능력수준에 일치하는 비상조치계획이 수립되고 화재 등 비상상황에 적용되어야 한다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": "비상조치계획에는 화재발생 시 경보 및 소화 절차, 근로자 임무부여와 훈련, 소화설비 유지관리, 지속적인 방화훈련 포함",
      "workProcessPhase": "비상조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.5.1",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-D46-036",
      "text": "소화설비의 운용과 소화활동에 참여하도록 임무가 부여된 근로자는 설비의 운용 및 소화훈련교육을 받아야 하고, 재교육은 최소한 1년에 1회 이상 실시되어야 한다.",
      "guideContext": "화학공장의 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D46-037",
      "text": "석유화학공단 내 석유화학공장에서는 대규모 화재가 발생할 경우를 대비하여 방재센터 운영과 주민 대피 등을 위한 해당지역의 비상대책기관과 유기적인 협조가 이루어져야 한다.",
      "guideContext": "화학공장의 화재예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D46-038",
      "text": "화재발생 시 안전하게 조업중단을 할 수 있도록 절차가 마련되어야하며, 이를 위해 정기적인 훈련 및 연동·제어장치 등의 신뢰도검사 같은 대책이 필요하다.",
      "guideContext": "화학공장의 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "비상조치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.5.4",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-D46-001",
      "term": "연소",
      "definition": "물질이 산소와 결합하여 에너지를 방출하는 화학반응을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-002",
      "term": "화재",
      "definition": "인적, 물적인 피해를 수반하는 연소현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-003",
      "term": "점화",
      "definition": "인화성 가스 또는 인화성 액체의 증기 등이 산소(공기)와 혼합하여 연소범위를 형성한 상태에서 연소를 개시할 수 있는 충분한 에너지를 공급하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-004",
      "term": "인화점",
      "definition": "사용중인 용기 내에서 인화성 액체가 증발하여 인화될 수 있는 가장 낮은 온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-005",
      "term": "연소점",
      "definition": "인화성 액체가 공기중에서 열을 받아 점화원의 존재하에 지속적인 연소를 일으킬 수 있는 온도이다. 동일한 물질일 경우 연소점은 인화점보다 약 3~10 ℃ 정도 높으며 연소를 5초 이상 지속할 수 있는 온도이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-006",
      "term": "발화온도",
      "definition": "점화원 없이 가연성 물질을 대기 중에서 가열함으로써 스스로 연소 혹은 폭발을 일으키는 최저 온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-007",
      "term": "연소범위",
      "definition": "연소(폭발)이 일어나는데 필요한 인화성 가스나 인화성 액체의 특정한 농도범위를 말하며, 공기중의 인화성 가스나 인화성 액체가 연소하는데 필요한 농도의 하한과 상한을 각각 연소하한계(LFL), 연소상한계(UFL)라 하고, 보통 1기압, 상온에서의 부피 백분율(vol.%)로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-008",
      "term": "인화성 액체",
      "definition": "대기압 하에서 인화점이 60 ℃이하인 액체로서, 안전규칙 별표1(위험물질의 종류) 제4호에서 정한 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-009",
      "term": "인화성 가스",
      "definition": "연소 범위의 하한이 13 %이하 또는 상한의 차이가 12 %이상인 가스를 말하며, 안전규칙 별표1(위험물질의 종류) 제5호에서 정한 가스를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-010",
      "term": "화재의 3요소",
      "definition": "화재(연소)가 지속되는 조건을 말하며, 가연물(위험물), 산소(공기) 및 점화원(불씨)의 3가지 구성요소를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-011",
      "term": "최소산소농도",
      "definition": "연소가 이루어지기 위해 필요한 최소의 산소 요구량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-012",
      "term": "최소점화에너지",
      "definition": "연소에 필요한 최소 에너지를 말하며, 분진을 포함한 모든 가연성 물질은 고유한 최소점화에너지를 필요로 하는데 탄화수소의 평균적인 최소점화에너지는 0.25 mJ이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-013",
      "term": "비등액체팽창증기폭발",
      "definition": "액화상태의 인화성 가스나 비점이 낮은 인화성 액체가 충전된 저장탱크 주위에 화재가 발생하여 저장탱크 벽면이 장시간 화염에 노출되면 윗부분의 온도가 상승하여 재질의 인장력이 저하되고, 내부의 비등현상으로 인한 압력상승으로 저장탱크 벽면이 파열되는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-014",
      "term": "분출화재",
      "definition": "어느 정도 가압 하에 있는 가연성 기체나 인화성 액체가 용기, 파이프 등 설비의 구멍이나 틈새로부터 유출된 후 점화되었을 때 발생하는 화재를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D46-015",
      "term": "액면화재",
      "definition": "가연성 액체가 지면에 흘러나와 액면을 형성한 후 그 액면의 가연성 액체가 연소범위가 되었을 때 점화되면 화재로 액면 전체가 화염에 휩싸이게 되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-D46-01",
      "processOrder": 1,
      "processName": "위험물 관리",
      "safetyMeasures": "위험물은 취급설비에서 벗어나지 않도록 관리하고, 취급설비는 내압·내열성·내부식성을 고려하여 설계한다. 압력용기 및 배관은 공정설계지침에 따라 설계하고 부식방지 재질을 선정한다. 접속부에 적합한 재질의 개스킷을 사용한다. 상압탱크에는 통기구 및 긴급통기설비를 설치하고, 압력탱크 주위에는 물분무설비를 설치한다. 저장탱크 주위에 방유제를 설치한다. 설비는 주기적으로 유지·보수를 실시한다.",
      "requiredPPE": [
        "작업복"
      ],
      "sourceSection": "7.1",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001",
        "SR-FIRE_EXPLOSION-032",
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "WP-D46-02",
      "processOrder": 2,
      "processName": "점화원 관리",
      "safetyMeasures": "기계적 점화원: 비점화성 재질 공구 사용, 낙하물 정리정돈, 단열압축 시 발화온도 80% 이내 관리. 전기적 점화원: 방폭형 전기기계기구 설치 및 유지보수. 열적 점화원: 보온조치로 고온표면 노출 방지, 운전온도 발화온도 80% 이내 관리. 정전기: 본딩 10^3 Ω 이하, 접지 10 Ω 이하, 제전복 지급. 자연발화: 보온재 부위 청결 유지, 고분자물질 햇빛 노출 방지.",
      "requiredPPE": [
        "제전복",
        "안전화"
      ],
      "sourceSection": "7.2",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001",
        "SR-ELECTRIC-011",
        "SR-ELECTRIC-024",
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "WP-D46-03",
      "processOrder": 3,
      "processName": "산소 관리 및 불활성화",
