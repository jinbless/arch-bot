  "checklistItems": [
    {
      "identifier": "CI-P60-001",
      "text": "암모니아를 냉매로 사용하는 열교환기 및 부대설비를 운전할 때에는 해당 근로자들의 책임과 권한을 명확히 하는 절차서를 수립하여 운영하여야 한다.",
      "guideContext": "암모니아 냉매설비의 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-002",
      "text": "암모니아 취급 시 노출확인 절차서, 노출로 인한 위험관리 절차서, 근로자 작업 확인 및 교육 절차서, 암모니아 열교환기 및 안전설비의 유지관리 절차서, 비상훈련 절차서를 수립하여 운영하는 것이 바람직하다.",
      "guideContext": "암모니아 냉매설비의 안전관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-003",
      "text": "암모니아 누출경보가 울린 경우에는 인명피해가 없었다고 할지라도 누출원인을 정확히 파악할 수 있도록 사고조사를 실시하여야 한다.",
      "guideContext": "암모니아 냉매설비의 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-004",
      "text": "실내에 사용되는 전기설비는 방폭구조여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P60-005",
      "text": "암모니아 설비가 설치된 건물이나 구조물은 난연재료를 사용하는 등 적절한 내화성능(Suitable fire-resistant building)을 가지는 것이 바람직하며, 만일 건물이나 구조물의 내화성능 유지가 어려울 경우에는 실내 벽과 바닥을 내화페인트로 마감하여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-006",
      "text": "실내는 건물이나 구조물의 다른 곳과 차단(Seal)될 수 있도록 배관 관통부 주변이 새지 않도록 밀봉하여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-007",
      "text": "실내 크기가 60 ㎡가 넘는 경우에는 최소한 2개의 비상구를 설치하여야 하며, 비상구는 밖으로 열 수 있는 구조여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-008",
      "text": "출입문은 자동으로 잠기는 구조가 아니어야 하며, 접근이 용이하도록 장애물을 두지 말아야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-009",
      "text": "실내에 난방을 하는 경우에는 암모니아 취급설비가 과열되지 않도록 하여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-010",
      "text": "실내에 다른 물질을 저장하거나 근로자의 휴식장소로 사용하지 말아야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-011",
      "text": "비상상황 시 암모니아 압축기를 정지할 수 있는 스위치를 실외에 설치하여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P60-012",
      "text": "실내에는 비상등을 설치하고 모든 암모니아 배관에 물질명과 흐름방향 등 배관 정보표지를 부착하여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-017",
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-P60-013",
      "text": "누출지역 내부를 환기할 수 있는 설비의 스위치는 실내뿐만 아니라 실외에도 설치되어야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-P60-014",
      "text": "배기설비는 천정에 가까운 곳에 설치하고 급기설비는 배기와 반대편 아래쪽에 설치하여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우",
      "additionalDetail": "암모니아 기체는 공기보다 가볍기 때문에 천정이나 높은 곳에 모이는 성질이 있음",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P60-015",
      "text": "배기설비의 출구는 주변에 2차 영향을 미치지 않는 안전한 곳에 설치하여야 한다.",
      "guideContext": "암모니아 설비가 실내에 설치된 경우",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P60-016",
      "text": "열교환기의 공정유체 측 내부를 스팀으로 청소할 때에는 암모니아를 완전히 배출한 후 스팀을 공급하여야 한다.",
      "guideContext": "암모니아 냉매 열교환기 보수·수리",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P60-017",
      "text": "열교환기의 압력방출장치가 정상적으로 설치되어 있는지 확인하여야 한다.",
      "guideContext": "암모니아 냉매 열교환기 보수·수리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-018",
      "text": "설비의 가동을 중지한 후, 내부에 남아있는 암모니아를 모두 안전한 곳으로 배출하고 열교환기를 격리하여야 한다.",
      "guideContext": "암모니아 취급설비 해체 시",
      "additionalDetail": null,
      "workProcessPhase": "설비 해체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P60-019",
      "text": "격리된 지역은 물이나 스팀을 이용하여 퍼지한다.",
      "guideContext": "암모니아 취급설비 해체 시",
      "additionalDetail": null,
      "workProcessPhase": "설비 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-020",
      "text": "근로자가 암모니아에 노출되지 않도록 개인보호구를 착용하고, 암모니아 누출감지 및 경보 설비가 정상 작동되는지 확인한다.",
      "guideContext": "암모니아 취급설비 해체 시",
      "additionalDetail": null,
      "workProcessPhase": "설비 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P60-021",
      "text": "암모니아 냄새가 날 경우에는 냄새지역을 벗어나 감독자에게 알려야 한다.",
      "guideContext": "노출확인 절차",
      "additionalDetail": null,
      "workProcessPhase": "누출 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-P60-022",
      "text": "반드시 호흡용 보호구를 착용한 후 감지기를 이용하여 공기 중 암모니아 농도를 측정한다.",
      "guideContext": "노출확인 절차",
      "additionalDetail": null,
      "workProcessPhase": "누출 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P60-023",
      "text": "암모니아가 누출된 곳에 자동환기설비가 설치되지 않은 경우에는 누출지역 내부를 배기하여 안전하다고 판단될 때까지 들어가지 말아야 한다.",
      "guideContext": "노출확인 절차",
      "additionalDetail": null,
      "workProcessPhase": "누출 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-P60-024",
      "text": "시험지는 일반적으로 페놀프탈레인을 함유하고 있으므로 입으로 적셔서는 안 된다.",
      "guideContext": "노출확인 절차 - pH 시험지 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "누출 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-025",
      "text": "시험지는 누출을 감지하는 데에만 사용하여야 하며, 공기 중 암모니아 농도를 측정하는데 사용하지 않는다.",
      "guideContext": "노출확인 절차 - pH 시험지 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "누출 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-026",
      "text": "시험지는 기계실에 보관하여서는 안 된다.",
      "guideContext": "노출확인 절차 - pH 시험지 사용 (법령 근거 미확인)",
      "additionalDetail": "암모니아에 노출되면 변색되어 사용 불가",
      "workProcessPhase": "누출 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-027",
      "text": "누출지역을 확인한 후, 감독자나 동료가 현장에 도착하기 전까지는 누출을 멈추기 위한 어떤 시도도 하지 말아야 한다.",
      "guideContext": "노출확인 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "누출 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-028",
      "text": "만일 밸브를 조였음에도 불구하고 누출이 지속되는 경우에는 가동을 중지하고 해당 설비를 수리하여야 한다.",
      "guideContext": "노출확인 절차",
      "additionalDetail": null,
      "workProcessPhase": "누출 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-020"
      ]
    },
    {
      "identifier": "CI-P60-029",
      "text": "암모니아가 노출될 수 있는 위험요인을 도출하기 위하여 적절한 교육을 받은 사람과 함께 위험성평가를 실시하여야 한다.",
      "guideContext": "노출로 인한 위험관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-030",
      "text": "암모니아가 노출되었을 때 호흡기를 보호할 수 있는 호흡보호프로그램을 수립하여 운영하는 것이 바람직하다.",
      "guideContext": "노출로 인한 위험관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P60-031",
      "text": "호흡용 보호구는 근로자 얼굴 형태에 적합한 것인지 적합검사(Fit-test)를 실시하여야 한다.",
      "guideContext": "호흡보호프로그램",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P60-032",
      "text": "적합검사는 처음 실시한 이후 매년 1회 지속적으로 실시하며, 그 결과를 기록하여 보관하는 것이 바람직하다.",
      "guideContext": "호흡보호프로그램",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P60-033",
      "text": "호흡용 보호구를 착용하여야 하는 근로자는 착용훈련을 받아야 한다.",
      "guideContext": "호흡보호프로그램",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-P60-034",
      "text": "암모니아가 노출되었을 때 피부를 보호할 수 있는 절차서를 수립하여 운영하는 것이 바람직하다.",
      "guideContext": "노출로 인한 위험관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P60-035",
      "text": "암모니아 설비가 밀폐된 곳이나 외진 곳에 설치된 경우, 해당 지역에서 근로자 작업할 때에는 CCTV 등을 통한 육안 확인 또는 무전기나 전화를 통한 음성 확인 중 어느 하나에 의해 근로자의 안전을 확인할 수 있어야 한다.",
      "guideContext": "근로자 작업 확인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-036",
      "text": "미리 정해진 주기마다 근로자의 안전을 확인하여야 하며, 확인사항을 기록하여 보관하는 것이 바람직하다.",
      "guideContext": "근로자 작업 확인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-037",
      "text": "암모니아 설비 주변에 설치된 안전대책을 주기적으로 점검하고 작동여부를 확인하여야 한다.",
      "guideContext": "암모니아 설비 및 안전설비의 유지관리",
      "additionalDetail": "안전대책에는 모니터·감지설비·경보설비, 무전기, 아이샤워·비상사워·응급조치함, 호흡용 보호구와 피부보호장비가 포함",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P60-038",
      "text": "암모니아 설비 주변에 설치된 안전대책의 작동 및 사용 가능여부를 최소한 분기별로 1회 확인하고 점검하여야 한다.",
      "guideContext": "암모니아 설비 및 안전설비의 유지관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P60-039",
      "text": "신뢰도, 정확도, 응답속도(Response speed) 및 작동 온도범위를 고려하여 선정하여야 한다.",
      "guideContext": "암모니아 누출감지 및 경보 설비 선정·관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P60-040",
      "text": "암모니아 외의 다른 물질이 누출된 경우에는 감응하지 않는 선택성을 갖는 감지설비를 선정하는 것이 바람직하다.",
      "guideContext": "암모니아 누출감지 및 경보 설비 선정·관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P60-041",
      "text": "매년 검교정을 실시하며, 누출을 감지하여 작동한 경우에도 검교정을 실시하여야 한다.",
      "guideContext": "암모니아 누출감지 및 경보 설비 선정·관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P60-042",
      "text": "전기화학적 감지기(Electrochemical sensor)가 장착된 경우, 한번이라도 경보가 울린 후에는 반드시 감지기를 교체하여야 한다.",
      "guideContext": "암모니아 누출감지 및 경보 설비 선정·관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P60-043",
      "text": "경보음과 경보등은 외부에서 실내의 농도를 정확히 읽을 수 있도록 설치되어야 한다.",
      "guideContext": "암모니아 누출감지 및 경보 설비 선정·관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P60-044",
      "text": "암모니아 설비의 유지보수 중에는 안전표지와 \"수리중\"이라는 표지를 설치하여 다른 사람의 접근이나 설비 가동을 방지하여야 한다.",
      "guideContext": "암모니아 설비 및 안전설비의 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P60-045",
      "text": "암모니아 열교환기 및 주변 설비의 유지보수는 반드시 작업계획을 수립하여 작업허가를 받은 후에 시행되어야 한다.",
      "guideContext": "암모니아 설비 및 안전설비의 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-046",
      "text": "비상훈련 절차서는 암모니아 열교환기 및 주변 설비에 대한 위험성평가를 토대로 작성되어야 한다.",
      "guideContext": "비상훈련 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-047",
      "text": "비상상황이 되었을 때 암모니아 외에 위험성이 증가할 수 있는 물질이 주변에 존재하는지 확인하고 해당 물질의 조치절차를 포함하여야 한다.",
      "guideContext": "비상훈련 절차서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-048",
      "text": "절차서의 내용을 점검한 후 근로자에게 알려야 한다.",
      "guideContext": "비상훈련 절차서",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P60-049",
      "text": "비상연락망을 포함한 주요 내용을 게시하고, 주기적으로 훈련을 실시하여야 한다.",
      "guideContext": "비상훈련 절차서",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P60-050",
      "text": "위험성평가 결과에 따라 암모니아의 확산영향반경을 확인하고 근로자가 쉽게 접근할 수 있는 지역에 개인보호구함과 현장경보장치를 설치하여야 한다.",
      "guideContext": "비상훈련",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P60-051",
      "text": "위험성평가 결과를 토대로 필요한 개인보호구의 종류를 파악하여 확보하여야 한다.",
      "guideContext": "비상훈련",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P60-052",
      "text": "아이샤워설비, 비상사워설비 및 응급조치함의 사용법을 교육하고 훈련하여야 한다.",
      "guideContext": "비상훈련",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P60-053",
      "text": "비상훈련 절차서에는 암모니아가 누출되었을 때 대피할 경로와 대피소의 위치를 명시하여야 한다.",
      "guideContext": "비상훈련",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-P60-054",
      "text": "비상사태에서 모든 근로자가 안전한 장소로 대피하였는가를 확인할 수 있는 체계를 갖추어야 한다.",
      "guideContext": "비상훈련 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-055",
      "text": "비상훈련은 정해진 주기에 따라 실시되고 그 결과를 기록하여야 한다.",
      "guideContext": "비상훈련 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-056",
      "text": "소방서 및 인근 다른 사업장에 필요한 정보를 제공하는 것이 바람직하다.",
      "guideContext": "비상훈련 절차서",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P60-057",
      "text": "사고 후 탈출절차와 수색 및 구조에 대한 내용을 포함하는 것이 바람직하다.",
      "guideContext": "비상훈련 절차서",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P60-001",
      "term": "암모니아",
      "definition": "무수암모니아와 암모니아수용액으로 구분되는데, 냉매로 사용하는 암모니아는 무수암모니아를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P60-002",
      "term": "시간가중평균노출기준 (TWA, Time weighted average)",
      "definition": "근로자가 유해인자에 노출되는 경우 1일 8시간 작업을 기준으로 노출되어도 거의 모든 근로자에게 건강상 나쁜 영향을 미치지 아니하는 기준을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "DT-P60-003",
      "term": "단시간노출기준 (STEL, Short term exposure limit)",
      "definition": "근로자가 1회에 15분간 유해인자에 노출되어도 거의 모든 근로자에게 건강상 나쁜 영향을 미치지 아니하는 기준으로, 이 기준 이하에서는 1회 노출간격이 1시간 이상인 경우 작업시간 동안 4회까지 노출이 허용될 수 있는 기준을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P60-01",
      "processOrder": 1,
      "processName": "암모니아 누출 확인 및 조치",
      "safetyMeasures": "냄새 감지 시 냄새지역 벗어나 감독자에게 보고, 호흡용 보호구 착용 후 감지기로 공기 중 암모니아 농도 측정, 자동환기설비 미설치 시 배기 후 안전 확인 전 진입 금지, pH 시험지(페놀프탈레인)로 누출지역 및 누출지점 확인, 감독자·동료 도착 전 누출 정지 시도 금지, 밸브 조임 후 누출 재확인, 누출 지속 시 가동 중지 및 수리",
      "requiredPPE": [
