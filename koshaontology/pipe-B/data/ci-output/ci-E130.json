  "checklistItems": [
    {
      "identifier": "CI-E130-001",
      "text": "폭발위험장소에서 사용되는 전압인가식 제전기는 방폭인증 제품이어야 한다.",
      "guideContext": "전압인가식 제전장치의 사용안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-E130-002",
      "text": "제전전극은 취급 및 사용 중에 쉽게 변형되지 않는 구조이어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E130-003",
      "text": "제전전극은 고압전원 접속용의 인출 케이블 또는 커넥터가 설치되어 있어야 한다. 단, 인출 케이블은 기계적으로 확실하게 부착하고, 또한, 전기적으로 확실하게 접속됨과 동시에 케이블 인출 부분이 제전전극을 관통하는 부분에는 기계적 보호 및 방전 방지용의 조치가 강구되어 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-004",
      "text": "고전압 전극의 단말부에는 방전 방지용 조치가 강구되어 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-005",
      "text": "제전전극의 절연체에 사용하는 절연물은 절연열화가 적은 재질이어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-006",
      "text": "제전전극의 고전압 충전부분은 방전전극의 침을 제외하고는 절연물로 덮여져 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E130-007",
      "text": "방전전극의 링 부분은 링 1개마다 1본의 침이 전기적으로 확실히 접속하고, 침이 용이하게 빠지지 않는 방법으로 고정되어 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-008",
      "text": "방전전극은 전극상호간이 절연되고, 고전압 전극과 링 부분 사이에는 절연물이 채워져 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E130-009",
      "text": "방전전극의 침은 내구성이 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-010",
      "text": "방전전극의 침은 원칙적으로 등간격으로, 또한 모든 침이 접지전극과 등거리가 되도록 배열되어 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-011",
      "text": "방전전극의 침은 침 끝을 가지런히 하고, 또한 선단이 접지전극보다 돌출되지 않도록 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-012",
      "text": "접지전극은 케이블의 차폐용 편조선과 전기적으로 확실히 접속되어 있어야 한다.",
      "guideContext": "제전전극 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "제전전극 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E130-013",
      "text": "전원장치는 누설형 단상 변압기의 사용 등에 의해, 2차 전압 및 2차 단락 전류의 제한 특성을 갖는 것이어야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E130-014",
      "text": "전원장치의 변압기는 양질의 재료로 만들어지고, 튼튼한 구조이어야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E130-015",
      "text": "전원장치에는 혼촉방지관이 있는 변압기를 사용하여야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E130-016",
      "text": "전원장치의 변압기의 권선 및 철심은 절연성 수지로 몰드되어 있어야 한다. 또한, 몰드시키는 절연성 수지는 사용 중에 균열이 생기지 않고, 누출할 염려가 없는 것이어야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E130-017",
      "text": "전원장치의 1차 측은 퓨즈, 표시등 및 전원 스위치가 설치되어 있어야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E130-018",
      "text": "전원장치는 2차 전압의 출력 유무를 표시하는 기능을 가져야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E130-019",
      "text": "전원장치의 2차 측에는 제전전극 접속용의 인출 케이블 또는 커넥터가 설치되어 있을 것. 또한, 인출 케이블은 기계적으로 확실하게 부착시키고, 역시 전기적으로 확실하게 접속됨과 동시에, 케이블 인출부분이 전원장치의 외함을 관통하는 부분에는 기계적 보호 및 방전방지용의 조치가 강구되어 있어야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-020",
      "text": "전원장치의 외함은 금속제로 기계적으로 견고하여야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E130-021",
      "text": "전원장치의 외함은 접지선을 확실하게 접속시킬 수 있는 접지단자가 설치되어 있어야 한다. 또한, 전원장치의 외함은 케이블의 실드용 도선(편조선)과 전기적으로 확실히 접속되어 있어야 한다.",
      "guideContext": "전원장치 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "전원장치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E130-022",
      "text": "케이블은 심선의 주위에 반 도전층을 갖는 실드 편조선이 붙어 있는 동축케이블 또는 이것과 동등 이상의 성능을 가져야 한다.",
      "guideContext": "케이블 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "케이블 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-023",
      "text": "케이블의 절연재료는 절연 열화가 적은 것이어야 한다.",
      "guideContext": "케이블 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "케이블 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-024",
      "text": "케이블은 충분한 기계적 강도를 갖는 것이어야 한다.",
      "guideContext": "케이블 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "케이블 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E130-025",
      "text": "케이블의 단말부에는 방전 방지용의 조치가 강구되어 있어야 한다.",
      "guideContext": "케이블 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "케이블 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-026",
      "text": "커넥터는 기계적으로 견고한 동축 구조의 금속제 커넥터이어야 한다.",
      "guideContext": "커넥터 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "커넥터 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E130-027",
      "text": "커넥터의 절연재료는 절연열화가 적은 것이어야 한다.",
      "guideContext": "커넥터 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "커넥터 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-028",
      "text": "커넥터는 상호간이 기계적 및 전기적으로 확실하게 접속할 수 있고, 또한, 용이하게 빠지지 않는 구조이어야 한다.",
      "guideContext": "커넥터 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "커넥터 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E130-029",
      "text": "커넥터는 케이블, 제전전극 또는 전원장치에 기계적으로 확실하게 부착되고, 또한 전기적으로 확실하게 접속되는 것이어야 한다.",
      "guideContext": "커넥터 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "커넥터 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E130-030",
      "text": "커넥터는 정체구조이거나 또는 커넥터의 보기 쉬운 위치에 「통전 중 접속·분리 금지」라고 명시한 주의명판이 부착되어 있어야 한다.",
      "guideContext": "커넥터 구조 및 재료 요건",
      "additionalDetail": null,
      "workProcessPhase": "커넥터 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E130-031",
      "text": "도체판은 전기적 접속을 하지 않는 상태로 시험장치에 장착한 경우에 최소 정전용량이 15 pF을 확보하여야 하며, 그 크기는 150 mm×150 mm이어야 한다.",
      "guideContext": "이온화 성능 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이온화 성능 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E130-032",
      "text": "시험회로의 전체 정전용량은 (20±2) pF이어야 한다.",
      "guideContext": "이온화 성능 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이온화 성능 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E130-033",
      "text": "모니터 장치의 응답시간은 대전판 전압을 정확하게 측정할 수 있도록 충분해야 한다.",
      "guideContext": "이온화 성능 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이온화 성능 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E130-034",
      "text": "표준편차는 0.5 pF 이하가 되도록 하는 것이 바람직하다.",
      "guideContext": "도체판 정전용량 측정",
      "additionalDetail": null,
      "workProcessPhase": "도체판 정전용량 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E130-035",
      "text": "장치 그 자체는 고전압 장치이기 때문에 안전에 충분한 주의를 기울여야 한다.",
      "guideContext": "고전압에 대한 안전성",
      "additionalDetail": "코로나 방전개시 전압은 4 kV 정도이며, 실용장치는 이 이상의 전압을 채용",
      "workProcessPhase": "제전기 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E130-036",
      "text": "보수 등으로 장치를 점검하는 경우에는 반드시 전원을 끄고 수행한다. 또한 접지하여야 할 개소는 완전하게 접지를 하여야 한다.",
      "guideContext": "고전압에 대한 안전성",
      "additionalDetail": null,
      "workProcessPhase": "제전기 보수·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "CI-E130-037",
      "text": "현재, 제전기에 대한 오존농도를 규정하고 있는 규격, 지침 등은 없으나 일반작업 환경 농도의 기준치를 초과하지 않도록 한다.",
      "guideContext": "오존에 대한 안전성",
      "additionalDetail": "일본, 미국, 유럽 등 대부분의 나라에서 오존 기준치 0.1 ppm 채택",
      "workProcessPhase": "제전기 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-E130-038",
      "text": "양·음 이온의 밸런스가 크게 달라지면, 대전전압이 증가하게 되어 자칫 제전능력의 상실에 따른 정전기 방전에 의한 화재·폭발을 일으킬 수 있으므로 양·음 이온의 밸런스에 대한 측정주기를 설정하여 관리할 필요가 있다.",
      "guideContext": "양·음 이온의 밸런스",
      "additionalDetail": null,
      "workProcessPhase": "제전기 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E130-039",
      "text": "제전전극에서는 전계의 집중에 의해, 종이 가루, 실밥 그 외의 이물질이 방전침과 그 주변에 부착되어, 제전성능이 저하한다. 더욱이 오염이 심하게 되면 절연파괴가 일어나 제전전극의 소손을 불러올 염려가 있다. 그러므로 제전전극은 정기적으로 오염을 청소·제거할 필요가 있다.",
      "guideContext": "보수",
      "additionalDetail": null,
      "workProcessPhase": "제전기 보수·점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E130-001",
      "term": "인화성 액체",
      "definition": "산업안전보건법 시행령 별표 10에서 정하는 바에 따라 표준압력(101.3 ㎪)하에서 인화점이 60℃ 이하이거나 고온·고압의 공정운전조건으로 인하여 화재·폭발위험이 있는 상태에서 취급되는 가연성 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-002",
      "term": "인화성 가스",
      "definition": "산업안전보건법 시행령 별표 10에서 정하는 바에 따라 인화한계 농도의 최저한도가 13 % 이하 또는 최고한도와 최저한도의 차가 12 % 이상인 것으로서 표준압력(101.3 ㎪)하의 20 ℃에서 가스 상태인 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-003",
      "term": "본딩",
      "definition": "둘 또는 그 이상의 도전성 물질이 같은 전위를 갖도록 도체로 접속하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-E130-004",
      "term": "정전기 방전",
      "definition": "가연성 혼합물을 점화시킬 수 있는 불꽃방전, 코로나방전, 브러시방전 등의 형태로 정전기가 방출되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E130-005",
      "term": "대전방지",
      "definition": "정전기 전하를 안전한 수준까지 방전시킨 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E130-006",
      "term": "정전기",
      "definition": "전계의 영향은 크나 자계의 영향이 상대적으로 미미한 전기 전하를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E130-007",
      "term": "정전용량",
      "definition": "측정되는 전하의 양으로, 전위차를 1 V 만큼 올리기 위해 특정 물체에 축적된 전하의 양을 말한다. 이 정전용량은 C/V 또는 단위 F(Farad)로 나타낸다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-008",
      "term": "교류전압 인가식 제전기",
      "definition": "용량결합에 의해 방전전극에 교류전압을 인가하여 코로나 방전을 일으켜, 대전물체의 제전에 필요한 이온을 생성하는 정전기 제거장치를 말하며, 제전전극, 전원장치, 케이블 및 커넥터 등으로 구성된다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E130-009",
      "term": "제전전극",
      "definition": "제전기의 주요 구성부분으로, 대전물체와 마주 보고 설치되며, 제전을 위한 이온을 생성, 공급하는 전극장치를 말하며, 방전전극, 접지전극, 고전압 전극, 절연체, 지지체 등으로 구성된다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E130-010",
      "term": "결합용량",
      "definition": "방전전극의 링 부분과 고전압 전극사이로, 그 사이에 정전용량으로 전기적으로 결합하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-011",
      "term": "방전전극",
      "definition": "이온생성의 코로나 방전을 일으키는 침, 고전압 전극과의 용량결합을 위한 링 부분 등으로 되는 전극을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E130-012",
      "term": "고전압 전극",
      "definition": "전원장치의 2차측 고전압 단자와 케이블로 접속되어, 방전전극의 링 부분과의 용량결합에 의해 방전전극에 고전압을 인가하는 전극을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-013",
      "term": "접지전극",
      "definition": "방전전극과 쌍으로 구성하여 방전을 일으키도록 접지시킨 전극을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-E130-014",
      "term": "전원장치",
      "definition": "변압기를 주요부분으로 하며 제전전극에 고전압을 공급하기 위한 전원을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-015",
      "term": "케이블",
      "definition": "전원장치의 2차측과 제전전극을 연결하는 케이블을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-016",
      "term": "커넥터",
      "definition": "전원장치와 케이블, 제전전극과 또는 케이블과 케이블을 접속하는 접속기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E130-017",
      "term": "보호구역",
      "definition": "정전계나 정전기 방전으로 인한 위험정도가 허용 가능한 수준의 구역을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E130-01",
      "processOrder": 1,
      "processName": "이온화 성능 측정 시험",
      "safetyMeasures": "대전판 모니터(Charge plate monitor)를 사용하여 이온화 성능을 측정한다. 도체판의 최소 정전용량 15 pF 확보, 시험회로 전체 정전용량 (20±2) pF 유지, 모니터 장치 응답시간의 충분성을 확인한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-E130-02",
      "processOrder": 2,
      "processName": "도체판 정전용량 측정",
      "safetyMeasures": "전원이 연결된 탐침자로 도전성판을 순간적으로 접촉하여 전압 V로 판을 대전시킨 후, 쿨롱미터가 연결된 탐침자로 도전성판을 접촉시켜 판상의 전하를 제거하고 전하 표시값을 기록한다. 평균값 및 표준편차 측정을 위해 10회의 시험을 반복한다. 100 ㎂의 전류제한값을 갖는 전원장치를 사용한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-E130-03",
      "processOrder": 3,
      "processName": "제전기 보수·점검",
      "safetyMeasures": "보수 등으로 장치를 점검하는 경우에는 반드시 전원을 끄고 수행한다. 접지하여야 할 개소는 완전하게 접지를 한다. 제전전극의 방전침과 그 주변에 부착된 이물질을 정기적으로 청소·제거한다. 양·음 이온의 밸런스 측정주기를 설정하여 관리한다.",
      "requiredPPE": [],
      "sourceSection": "7.1",
      "relatedSR": [
        "SR-ELECTRIC-019",
        "SR-ELECTRIC-024"
      ]
    }
  ],
