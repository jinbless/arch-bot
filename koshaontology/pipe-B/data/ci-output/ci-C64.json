  "checklistItems": [
    {
      "identifier": "CI-C64-001",
      "text": "조적공사에 사용되는 벽돌, 블록, 철근 등의 자재는 KS 규격에 합격한 품질, 성능 및 외관이 양호한 제품이 반입되어야 한다.",
      "guideContext": "조적공사 자재반입 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자재반입 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-002",
      "text": "벽돌, 블록, 시멘트 등의 조적공사용 자재를 실은 차량은 건설현장에서 지정한 안전속도를 준수하고 경비, 신호수 등의 통제에 따라 주행하여야 한다.",
      "guideContext": "조적공사 자재운반 차량 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자재반입 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-003",
      "text": "작업구간에는 통행 등에 지장을 주지 않도록 필요한 분량의 자재만 적재하도록 하여야 한다.",
      "guideContext": "조적공사 자재적재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자재반입 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-004",
      "text": "자재를 작업위치에 운반하여 적재할 때에는 과도한 집중하중이 유발되지 않도록 분산 배치하여야 한다. 특히, 복도 및 발코니 등 취약부위에는 과다한 하중이 작용하지 않도록 하여야 한다.",
      "guideContext": "조적공사 자재적재",
      "additionalDetail": null,
      "workProcessPhase": "자재반입 및 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-C64-005",
      "text": "작업공구를 운반하는 경우 던지지 않도록 하여야 한다. 특히, 작업공구 등을 올리거나 내릴 경우에는 반드시 달줄, 달포대 등을 사용하여야 한다.",
      "guideContext": "조적공사 공구운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자재반입 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-006",
      "text": "인력운반작업을 하는 경우 안전모, 안전화 등 개인보호구를 반드시 착용하여야 한다.",
      "guideContext": "조적공사 인력운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자재반입 및 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-007",
      "text": "인력운반작업을 할 경우에는 근골격계 재해예방을 위한 안전한 작업방법을 강구하여야 한다.",
      "guideContext": "조적공사 인력운반 (법령 근거 미확인)",
      "additionalDetail": "중량물 취급 시 산업안전보건기준에 관한 규칙 제385조 및 KOSHA GUIDE C-102-2014 참조",
      "workProcessPhase": "인력 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-008",
      "text": "인력운반작업 전 작업자는 충분한 준비운동을 실시하여야 한다.",
      "guideContext": "조적공사 인력운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인력 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-009",
      "text": "인력운반작업을 할 경우에는 자재 중량이 허리에 집중되지 않도록 무릎을 굽힌 상태에서 허리를 펴고 짐을 들어올리며, 가급적 짐은 몸 가까이 붙여 들어 올리고 하중이 하체에 전달되도록 자세를 취하여야 한다.",
      "guideContext": "조적공사 인력운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인력 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-010",
      "text": "인력운반작업을 할 경우에는 운반물이 다른 물체에 부딪히지 않도록 사전에 운반경로를 확인하고, 운반물이 전방 시야를 방해하지 않도록 하여야 한다.",
      "guideContext": "조적공사 인력운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인력 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-011",
      "text": "운반경로의 바닥면 등에 돌출물이 있을 경우에는 넘어짐 재해예방을 위하여 즉시 제거하고, 바닥면은 미끄럽지 않도록 유지하여야 한다.",
      "guideContext": "조적공사 인력운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인력 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-012",
      "text": "수레 등 운반용구를 이용하여 자재를 운반하는 경우에는 사전에 각륜, 볼트 체결, 용접 상태 등 각 부위의 이상 유무를 확인하고 이상이 있을 경우에는 즉시 보완조치를 하여야 한다.",
      "guideContext": "조적공사 수레운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수레 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-013",
      "text": "운반경로에는 돌출장애물이 없도록 조치하고, 시야를 확보하여야 한다. 또한 운반물은 운반도중 이탈되지 않도록 로프 등을 이용하여 견고히 고정시켜야 한다.",
      "guideContext": "조적공사 수레운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수레 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-014",
      "text": "수레에는 과다의 자재 적재를 지양하고, 수레운반 작업 시 뛰는 행동 등 과속운반을 하여서는 아니된다. 또한 반드시 앞에서 끌어 운반하고, 가능한 2인 1조로 운반하여야 한다.",
      "guideContext": "조적공사 수레운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수레 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-015",
      "text": "건축물 각 층에 설치된 건설용 리프트 승강구내에서 자재운반용 수레를 사용할 경우에는 안전한 통행로를 설치하고, 건설용 리프트의 운반구가 도착하지 않은 층의 출입문은 항상 닫혀 진 상태로 유지하여야 한다.",
      "guideContext": "조적공사 리프트 승강구 수레운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수레 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-016",
      "text": "차량계하역운반기계를 이용하여 운반할 경우에는 부딪힘, 깔림 등의 재해를 예방하기 위하여 작업계획서를 작성하고, 그 작업계획에 따라 작업을 하여야 한다.",
      "guideContext": "조적공사 차량계하역운반기계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량계하역운반기계 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-017",
      "text": "차량계하역운반기계를 사용하여 운반작업을 하는 경우에는 기계의 넘어짐, 굴러 떨어짐 및 기계와의 접촉 방지를 위하여 유도자를 배치하여야 한다. 또한 지반의 부등침하 방지 및 갓길 붕괴 방지 조치를 하여야 한다.",
      "guideContext": "조적공사 차량계하역운반기계",
      "additionalDetail": null,
      "workProcessPhase": "차량계하역운반기계 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C64-018",
      "text": "차량에 적재된 벽돌, 블록 등의 자재 하역작업에 지게차를 사용할 때에는 작업구역을 설정하고, 신호수를 배치하여야 한다.",
      "guideContext": "조적공사 지게차 하역 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE M-185-2015(지게차의 안전작업에 관한 기술지침) 참조",
      "workProcessPhase": "차량계하역운반기계 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-019",
      "text": "텔레스코픽 핸들리(Telescopic handler, 일명 하이랜더)를 이용하여 벽돌, 블록 등을 운반할 때에는 평탄한 지반에서 아웃리거를 설치하고, 작업반경에 따른 정격하중을 지켜야 한다. 또한 작업구역을 설정하고 신호수를 배치하여 작업반경내에 근로자의 출입을 통제하여야 한다.",
      "guideContext": "조적공사 텔레스코픽 핸들러 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량계하역운반기계 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-020",
      "text": "차량 적재함에서 벽돌, 블록 등의 자재를 하역할 경우에는 자재더미 상부에 올라가는 등의 불안전한 행동을 하여서는 아니 된다. 팔레트는 평탄하고 견고한 지반에 적재하되, 2단 이하의 높이로 적재하여야 한다.",
      "guideContext": "조적공사 자재하역",
      "additionalDetail": null,
      "workProcessPhase": "차량계하역운반기계 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.4",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-C64-021",
      "text": "바탕처리, 면 정리, 먹줄 놓기, 실 띄우기 등 작업 전 작업부위의 자재 등을 정리·정돈하여 작업 중 자재 등에 걸려 넘어지거나 미끄러지지 않도록 하여야 한다.",
      "guideContext": "조적공사 바탕처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "바탕처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-022",
      "text": "작업발판의 단부, 개구부 등 떨어짐 위험이 있는 곳은 안전난간 또는 개구부 덮개(위험표지 부착)를 설치하여야 한다.",
      "guideContext": "조적공사 바탕처리",
      "additionalDetail": null,
      "workProcessPhase": "바탕처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C64-023",
      "text": "실의 고정을 위한 못을 박는 경우 튀거나 이탈되지 않도록 하여야 한다.",
      "guideContext": "조적공사 바탕처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "바탕처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-024",
      "text": "바탕처리 작업 시 작업발판은 견고하고 안전한 것을 사용하여야 한다.",
      "guideContext": "조적공사 바탕처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "바탕처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-025",
      "text": "시멘트 등 포대를 해체하여 사용할 경우에는 시멘트가 날리지 않도록 작업을 실시하고, 방진마스크 등을 착용하도록 하여야 한다.",
      "guideContext": "조적공사 붙임재료 배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "붙임재료 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-026",
      "text": "붙임재료 배합 시 코팅장갑 등을 착용하여 손이 직접 시멘트페이스트 등에 접촉하지 않도록 하여야 한다.",
      "guideContext": "조적공사 붙임재료 배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "붙임재료 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-027",
      "text": "작업자는 정해진 동선으로 보행토록 하고, 관계근로자 외의 자 출입을 통제하여야 한다.",
      "guideContext": "조적공사 붙임재료 배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "붙임재료 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-028",
      "text": "붙임재료 배합 시 사용하는 배합 용기는 정해진 용도의 것을 사용하고, 화재·폭발 우려가 있는 폐드럼통, 페인트통 등을 가스로 절단하지 않도록 하여야 한다.",
      "guideContext": "조적공사 붙임재료 배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "붙임재료 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-029",
      "text": "삽 또는 흙손 등을 사용하여 붙임재료(붙임모르타르 등)를 배합하는 경우에는 요통 재해를 예방하기 위한 조치를 하여야 한다.",
      "guideContext": "조적공사 인력배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인력 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-030",
      "text": "작업자의 체력에 맞는 배합량을 조절하고, 허리에 힘을 주어 삽질 등을 하지 않도록 하여야 한다.",
      "guideContext": "조적공사 인력배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인력 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-031",
      "text": "작업 전 안전장갑을 착용한 상태에서 회전날의 이상유무를 확인하고, 회전날에 접근하지 않도록 하여야 한다.",
      "guideContext": "조적공사 이동식 믹서 배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이동식 믹서 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-032",
      "text": "붙임재료 배합 시 모르타르 등이 비산되지 않도록 작업구간에 울을 설치하는 등의 필요한 조치를 하여야 한다.",
      "guideContext": "조적공사 이동식 믹서 배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이동식 믹서 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-033",
      "text": "이동식 믹서의 절연여부, 회전날의 고정상태 및 이동전선의 배선상태 등 이상 유무를 작업 전 확인하여야 한다.",
      "guideContext": "조적공사 이동식 믹서 배합 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이동식 믹서 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-034",
      "text": "이동식 믹서의 전선을 연결 또는 제거 시에는 전원을 차단한 상태에서 작업하도록 하여야 한다. 또한 당해 작업중임을 사전에 주변 작업자에게 알려야 한다.",
      "guideContext": "조적공사 이동식 믹서",
      "additionalDetail": null,
      "workProcessPhase": "이동식 믹서 배합",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-C64-035",
      "text": "고정식 믹서의 분전반은 단독으로 설치하고, 충전부가 노출되지 않도록 하여야 한다.",
      "guideContext": "조적공사 고정식 믹서",
      "additionalDetail": null,
      "workProcessPhase": "고정식 믹서 배합",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-C64-036",
      "text": "가설전선은 바닥에서 띄워서 사용하는 것을 원칙으로 하고, 부득이 바닥으로 배선하는 경우에는 반드시 보호덮개를 설치하는 등 절연이 파괴되지 않는 조치를 하여야 한다.",
      "guideContext": "조적공사 고정식 믹서",
      "additionalDetail": null,
      "workProcessPhase": "고정식 믹서 배합",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-C64-037",
      "text": "고정식 믹서의 모터 등은 절연상태, 동력전달부의 방호덮개 설치상태를 수시로 점검하여 그 성능이 항상 유지되도록 하여야 한다.",
      "guideContext": "조적공사 고정식 믹서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고정식 믹서 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-038",
      "text": "믹서의 주입구는 다른 불순물, 자재 및 작업자 등이 떨어지지 않도록 방호울, 덮개 등을 설치하여야 한다. 또한 회전하고 있는 믹서 안으로 손을 넣지 않도록 하여야 한다.",
      "guideContext": "조적공사 고정식 믹서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고정식 믹서 배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-039",
      "text": "조적벽체의 구조적 안정성을 확보하고, 부등침하를 방지하기 위하여 구조검토에 따라 견고한 잡석다짐, 철근·콘크리트 기초를 설치하고, 조적벽체를 일부 또는 부분적으로 높게 쌓지 않도록 하여야 한다.",
      "guideContext": "조적작업 공통사항",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C64-040",
      "text": "조적작업은 시스템비계, 강관비계, 이동식 비계 등의 비계를 조립하고, 견고한 작업발판을 설치한 후 실시하여야 한다.",
      "guideContext": "조적작업 공통사항 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE C-32-2011, C-30-2011, C-28-2011, C-08-2015 참조",
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-041",
      "text": "비계의 작업발판에 벽돌, 블록 등의 자재를 싣는 경우에는 비계기둥 사이의 적재하중이 400 kg을 초과하지 않도록 하고, 자재의 낙하에 따른 재해를 방지하기 위하여 안전난간 아래의 작업발판에는 발끝막이판을 설치하여야 한다.",
      "guideContext": "조적작업 비계 적재",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-C64-042",
      "text": "조적벽체 시공의 정확성 및 안전성을 확보하고, 벽체붕괴에 따른 재해를 예방하기 위하여 규준틀을 설치하고 수평계, 수직내림추를 사용하여 수평, 수직도를 계측하고 점검하여야 한다.",
      "guideContext": "조적작업 공통사항",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C64-043",
      "text": "출입문, 창문 등의 개구부 상부에 조적벽체를 시공할 경우에는 2명 이상이 함께 인방보를 설치하되, 인방보는 벽체와 같은 두께로서 길이는 개구부 폭보다 40 ㎝ 이상 길게 하여 개구부 양단부에 20 ㎝ 이상 정착되도록 하여야 한다.",
      "guideContext": "조적작업 인방보 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-044",
      "text": "조적벽체의 개구부 폭이 1.8 m를 초과할 때에는 철근·콘크리트 인방보를 설치하여야 한다. 인방보의 높이는 20 cm 이상, 길이는 20 cm 이상 양단부에 정착될 수 있도록 하여야 한다.",
      "guideContext": "조적작업 인방보 설치 (법령 근거 미확인)",
      "additionalDetail": "개구부 폭이 2.1 m 초과 시 또는 과대한 하중 시 별도 구조검토 필요",
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-045",
      "text": "조적벽체에 테두리보를 설치할 때에는 철골 또는 철근·콘크리트 구조로 하되, 테두리보의 폭은 조적벽체 두께 이상으로 하고, 테두리보의 춤은 테두리보 폭의 1.5배 또는 30 ㎝ 이상으로 하여야 한다.",
      "guideContext": "조적작업 테두리보 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-046",
      "text": "조적벽체의 출입문, 창문, 설비배관 주위의 충전재로 우레탄 폼을 사용할 때에는 주변에서 용접불똥, 산소불꽃 등을 발생하는 작업을 하지 않아야 하며 작업장 주위에 소화기를 갖추어 두어야 한다.",
      "guideContext": "조적작업 우레탄 폼 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-047",
      "text": "자재 반입구, 설비용 덕트, 엘리베이터 출입구 등 개구부 주위에서 조적작업을 실시할 때에는 벽돌, 블록 등의 낙하에 의한 재해를 예방하기 위하여 개구부 상부에 덮개 또는 낙하물방지망을 설치하여야 한다.",
      "guideContext": "조적작업 개구부 낙하방지",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-C64-048",
      "text": "조적작업용 모르타르는 건축공사표준시방서에서 정한 시멘트, 모래, 물을 사용하고, ALC블럭 쌓기에 사용되는 모르타르는 ALC블럭 전용 모르타르를 사용하여야 한다.",
      "guideContext": "조적작업 모르타르 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-049",
      "text": "기온이 4 ℃ 이하의 한랭기에 모르타르의 온도가 4 ℃ 이상, 49 ℃ 이하가 되도록 골재나 물을 대울 때에는 화기, 뜨거운 물 등에 의한 화상을 입지 않도록 주의하여야 한다.",
      "guideContext": "조적작업 한랭기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-050",
      "text": "조적작업을 할 경우, 추락의 위험이 있는 경우에는 안전난간, 안전방망 등의 안전시설을 설치하고 안전모, 안전화, 안전대 등의 개인보호구를 착용하여야 한다.",
      "guideContext": "조적작업 추락방지",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C64-051",
      "text": "조적작업 장소에는 걸려 넘어지거나 미끄러지지 않도록 정리정돈상태를 점검하고, 청결한 상태를 유지하여야 한다.",
      "guideContext": "조적작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-052",
      "text": "야간작업을 할 경우, 투광등 등을 설치하여 적정 조명을 유지하고, 감전사고 예방을 위한 안전조치를 하여야 한다.",
      "guideContext": "조적작업 야간작업",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-C64-053",
      "text": "벽돌은 통줄눈이 생기지 않도록 전체적으로 같은 높이로 쌓아 올라가고, 하루 쌓기 높이는 1.2m(18켜 정도)를 표준으로 하고, 최대 1.5m(22켜 정도) 이하로 하여야 한다.",
      "guideContext": "벽돌공사",
      "additionalDetail": null,
      "workProcessPhase": "벽돌 쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C64-054",
      "text": "굴뚝내부에서 내화벽돌 쌓기작업을 할 경우, 구조벽체에서 0.5B(벽돌의 절반 길이) 정도 공간을 두어서 쌓고, 60 ㎝ 이내마다 구조벽체와 접촉하여 조적벽체가 붕괴되지 않도록 시공하여야 한다.",
      "guideContext": "벽돌공사 굴뚝",
      "additionalDetail": null,
      "workProcessPhase": "벽돌 쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C64-055",
      "text": "굴뚝, 화로 등 밀폐된 장소에서 내화벽돌 조적작업을 할 때에는 작업 전에 작업자에게 질식재해예방을 위한 안전교육을 실시하여야 하며, 산소농도를 측정하고, 적정한 공기가 유지되도록 환기를 실시한 후 송기마스크를 착용한 상태에서 작업하여야 한다.",
      "guideContext": "벽돌공사 밀폐공간 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽돌 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-056",
      "text": "내화벽돌에 불을 때어 건조작업을 실시할 경우에는 비닐, 스티로폼 등 인화성 물질을 제거하고 소화기를 갖추어 둔 후 감시인을 배치하여야 한다.",
      "guideContext": "벽돌공사 건조작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽돌 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-057",
      "text": "아치쌓기용 가설형틀은 형상 및 치수를 정확하게 하여 설치하고, 축선에 따라 미리 벽돌 나누기를 한 후, 아치의 하부에서부터 좌우 대칭형으로 균등하게 쌓아야 한다. 가설형틀의 하부에는 구조검토에 따라 견고한 거푸집동바리 및 수평연결재를 설치하여야 한다.",
      "guideContext": "벽돌공사 아치쌓기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽돌 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-058",
      "text": "보강벽돌쌓기 작업에서 종철근은 기초콘크리트 타설 전에 내진설계로 배근하고, 조적공사 시방서에 따라 모르타르 및 콘크리트 타설 시의 측압에 견디도록 1회의 타설높이는 1.5 m 이하로 하여야 한다.",
      "guideContext": "벽돌공사 보강벽돌쌓기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽돌 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-059",
      "text": "블록은 하중이 고르게 분포하도록 전체적으로 같은 높이로 쌓아 올라가고, 하루 쌓기 높이는 콘크리트 블록은 1.5m(블록 7켜 정도) 이내, ALC블록의 하루 쌓기 높이는 1.8m를 표준으로 하고, 최대 2.4m이내로 하여야 한다.",
      "guideContext": "블록공사",
      "additionalDetail": null,
      "workProcessPhase": "블록 쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.3",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C64-060",
      "text": "보강블록구조로 시공할 경우, 세로철근은 상부 테두리보에 철근지름의 40배 이상 정착시키고, 모르타르 또는 콘크리트 사춤작업은 공극이나 틈새가 생기지 않도록 다져야 한다.",
      "guideContext": "블록공사 보강블록구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-061",
      "text": "보강블록벽체의 강성, 내구성 등을 증진시키기 위하여 조적벽체와 철골 또는 철근·콘크리트 구조 사이에 설치하는 연결철물은 제품의 특성에 따라 구조검토를 실시한 후 견고하게 설치하여야 한다.",
      "guideContext": "블록공사 연결철물 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-062",
      "text": "콘크리트 블록, ALC블록 등의 블록을 절단할 때에는 전용도구 또는 절단톱을 사용하고 전동 절단톱날 주위에는 보호덮개를 설치하여야 한다.",
      "guideContext": "블록공사 블록절단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "블록 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-063",
      "text": "쌓기가 완료된 벽돌은 어떠한 경우에도 움직이지 않도록 하여야 한다. 쌓은 후 12시간 동안은 하중을 받지 않도록 하고 3일 동안은 집중하중을 받지 않도록 하되, 모르타르 등 붙임 재료가 완전히 경화될 때까지 유해한 진동, 충격 및 횡력 등의 하중을 받지 않도록 하여야 한다.",
      "guideContext": "조적공사 보양 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보양",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-064",
      "text": "블록을 쌓은 후에는 줄눈 모르타르 및 사춤 모르타르, 그라우트 등이 충분히 경화될 때까지 충격 및 기타 하중을 받지 않도록 하여야 한다.",
      "guideContext": "조적공사 보양 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보양",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-065",
      "text": "강우로 인하여 조적한 내부로 빗물이 들어가 무너질 우려가 있는 경우에는 비닐, 천막 등 빗물의 침투에 의한 무너짐 방지를 위하여 필요한 조치를 하여야 한다.",
      "guideContext": "조적공사 보양 붕괴방지",
      "additionalDetail": null,
      "workProcessPhase": "보양",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C64-066",
      "text": "벽돌, 블록의 가공, 조적벽체의 면처리 작업을 위하여 둥근톱, 그라인더 등의 기계·기구를 사용할 때에는 물을 분무하거나 배기장치를 설치하여 분진발생을 억제하고, 보안경 및 방진마스크 등의 개인보호구를 착용하여야 한다.",
      "guideContext": "조적공사 분진작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면처리 및 가공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-067",
      "text": "조적벽체의 세척, 방수작업에 고소작업차를 사용할 때에는 평탄한 장소에서 작업구역을 설정하고, 신호수를 배치하여야 한다.",
      "guideContext": "조적공사 고소작업차 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE M-86-2011(고소작업차 안전운전에 관한 기술지침) 참조",
      "workProcessPhase": "세척 및 방수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-068",
      "text": "염산을 조적벽체 세척작업에 사용할 때에는 3 % 이하의 묽은 염산을 사용하고 보호의, 보안경, 보호장갑 등의 개인보호구를 착용하여야 한다.",
      "guideContext": "조적공사 염산 세척 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세척 및 방수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-069",
      "text": "조적벽체에 고압 물청소를 할 때에는 분사노즐의 압력을 2.8～4.9 MPa로 하고, 근로자의 신체에 직접 접촉하지 않도록 하여야 한다.",
      "guideContext": "조적공사 고압 물청소 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세척 및 방수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-070",
      "text": "조적벽체에 샌드 블라스팅에 의한 청소작업을 실시할 때에는 공기압축기, 압축탱크, 호스, 노즐의 상태를 수시로 점검하고 보안경, 호흡용보호구 등 작업에 적합한 개인보호구를 착용하여야 한다.",
      "guideContext": "조적공사 샌드 블라스팅 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "세척 및 방수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-071",
      "text": "조적작업에서 가급적 달비계 사용은 금지하되, 부득이 하게 줄눈의 보수, 청소 등의 작업에 달비계를 사용할 때에는 구명줄을 설치하고, 안전대를 착용하여야 한다.",
      "guideContext": "조적공사 달비계 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE C-33-2016(달비계 안전작업 지침) 참조",
      "workProcessPhase": "보수 및 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-072",
      "text": "조적작업용 시멘트 운반, 모르타르 배합, 청소 등 분진이 발생하는 작업을 실시할 때에는 보안경, 방진마스크, 안전장갑 등의 개인보호구를 착용하여야 한다.",
      "guideContext": "조적공사 분진작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-073",
      "text": "조적작업에 사용되는 혼합기, 전동드릴 등의 전동 기계·기구는 배선상태가 양호한 것을 사용하고, 누전차단기 및 접지가 안전기준에 적합하게 설치된 분전함에 접속하여 사용하여야 한다. 또한, 전동 기계·기구는 배선 및 절연상태를 수시로 점검하고, 물에 젖은 손으로 사용하여서는 아니 된다.",
      "guideContext": "조적공사 전동기계 감전방지",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-C64-074",
      "text": "조적공사용 철골, 철근의 조립작업에 아크용접기를 사용할 때에는 화재·폭발, 화상 등의 재해를 방지하기 위하여 방염포를 설치하고, 인화성물질을 제거한 후 소화기를 갖추어 두어야 한다.",
      "guideContext": "조적공사 용접작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C64-075",
      "text": "조적작업장의 조도는 150 럭스(lux) 이상을 유지하고, 조명등의 파손을 방지하기 위하여 보호철망, 보호덮개 등을 설치하여야 한다.",
      "guideContext": "조적작업장 조명",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C64-076",
      "text": "조적작업장에서 화재·폭발 등의 비상사태가 발생할 경우에 대비하여 경보설비 및 대피통로를 설치하고, 근로자에게 정기적으로 안전교육을 실시하여야 한다.",
      "guideContext": "조적작업장 비상대비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조적작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-C64-001",
      "term": "조적공사",
      "definition": "모르타르를 사용하여 벽돌, 블록 등의 재료를 쌓아서 구조물을 축조하거나 장치하는 공사를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-002",
      "term": "규준틀",
      "definition": "조적벽체의 위치, 수직도 등을 정확하게 시공하기 위하여 모서리, 중앙부 등에 설치하는 목재로서 건조하고 곧은 목재를 2면 이상 대패질하여 벽돌줄눈, 창문틀, 앵커볼트 등의 위치를 기입한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-003",
      "term": "인방보",
      "definition": "조적벽체의 출입구, 창문 등 개구부 상부에 설치하여 상부의 하중을 조적벽체 좌우로 분산시키는 철근·콘크리트, 석재, 철재 등의 보 부재를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-004",
      "term": "테두리보",
      "definition": "조적조의 철근콘크리트 슬라브(Slab)와 조적벽체를 일체화시켜 벽체상부에 작용하는 수평력에 의한 균열을 방지하고, 하중을 벽체에 고르게 분포시킴으로써 조적벽체 전체의 강성을 증가시키는 구조물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-005",
      "term": "내화벽돌",
      "definition": "규조토, 내화점토 등이 주성분인 벽돌로서 강도는 높지 않으나 열에 강하기 때문에 굴뚝, 벽난로 등의 구조물에 사용되는 벽돌을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-006",
      "term": "보강블록구조",
      "definition": "콘크리트 블록 개체의 속빈 부분 또는 수직단면 간의 공동부에 철근을 매입하고, 모르타르(Mortar) 또는 콘크리트를 채워 넣어 내력벽으로 시공한 블록구조를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-007",
      "term": "ALC(Autoclaved lightweight concrete)블록",
      "definition": "석회질, 규산질 원료와 기포제 및 혼화재료를 주원료로 물과 혼합하고, 고온고압(180 ℃, 1.0 MPa)의 증기양생 과정을 거쳐 경량성, 단열성, 내화성 및 시공성이 우수한 블록을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-008",
      "term": "우레탄 폼",
      "definition": "글리콜 성분과 디이소시아네이트 성분이 물과 반응하여 발생한 탄산가스를 이용하여 형성된 발포체를 말하는 것으로 폴리우레탄폼이라고도 한다. 우레탄 폼은 조적벽체의 단열, 방음, 방습 등을 목적으로 출입문, 창문, 설비배관 주위의 충전재로 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C64-009",
      "term": "적정한 공기",
