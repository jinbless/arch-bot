  "checklistItems": [
    {
      "identifier": "CI-P63-001",
      "text": "건물 내에서 공기덕트 설비를 통하여 외부로부터 건물 내로 연기가 확산되는 것을 제한하여야 한다.",
      "guideContext": "공기조화 및 환기설비의 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-002",
      "text": "발화장소가 건물의 내부 또는 외부이던 공기덕트 설비를 통한 화재의 확산을 제한하여야 한다.",
      "guideContext": "공기조화 및 환기설비의 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-003",
      "text": "바닥, 칸막이, 지붕, 벽 및 공기덕트 설비 설치에 영향을 받는 바닥, 천장의 부재와 같은 건물의 구성요소에 대하여 내화도를 유지하여야 한다.",
      "guideContext": "공기조화 및 환기설비의 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-004",
      "text": "장치는 검사, 유지 및 보수가 가능하도록 배열하여야 한다.",
      "guideContext": "HVAC 설비 일반 요구사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "HVAC 설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-005",
      "text": "장치는 제조자의 설치 지침 및 목적에 맞도록 선택하고 설치하여야 한다.",
      "guideContext": "HVAC 설비 일반 요구사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "HVAC 설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-006",
      "text": "장치는 인명 보호 및 이물질이 침입하지 않도록 방호하여야 한다.",
      "guideContext": "HVAC 설비 일반 요구사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "HVAC 설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-007",
      "text": "전기배선 및 기기는 규격에 맞는 제품을 사용하고 설치하여야 한다.",
      "guideContext": "HVAC 설비 일반 요구사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "HVAC 설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-008",
      "text": "외부 공기 유입구는 가연성 물질이나 인화성 증기가 들어오지 않도록 하고, 다른 구조물의 화재로부터 위험을 최소화하도록 배치하여야 한다.",
      "guideContext": "외부 공기 유입구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "외부 공기 유입구 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-009",
      "text": "외부 공기 유입구는 12.5 mm mesh 보다 크지 않은 내식성망에 의하여 보호하여야 한다.",
      "guideContext": "외부 공기 유입구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "외부 공기 유입구 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-010",
      "text": "외부 공기 유입구는 가연성 부속건물이나 위험시설로부터 화염의 유입을 최소화할 수 있는 위치에 있어야 하며 적절한 방화댐퍼를 갖추어야 한다.",
      "guideContext": "외부 공기 유입구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "외부 공기 유입구 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-011",
      "text": "공기정화기 및 공기여과기는 적합한 규격 또는 제조자의 지침에 따라 설치하여야 한다.",
      "guideContext": "공기정화기 및 공기여과기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기정화기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-012",
      "text": "공기여과기에 사용되는 액체 접착성 코팅(Liquid adhesive coatings)의 인화점은 160℃ 이상이어야 한다.",
      "guideContext": "공기정화기 및 공기여과기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기정화기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-013",
      "text": "액체접착물이 많은 곳에서는 팬이 작동 중에는 공기정화기에서 접착물이 흘러나오지 않도록 공기여과기를 배열하여야 한다.",
      "guideContext": "공기정화기 및 공기여과기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기정화기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-014",
      "text": "팬은 적합한 규격 또는 제조자의 지침에 따라 설치하여야 한다.",
      "guideContext": "팬 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팬 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-015",
      "text": "팬은 검사 및 보수유지가 가능하도록 위치를 선정하여 설치하여야 한다.",
      "guideContext": "팬 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팬 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-016",
      "text": "노출된 팬 급기구는 종이나 쓰레기 기타 이물질이 유입되지 않도록 금속망을 설치하여야 한다.",
      "guideContext": "팬 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팬 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-017",
      "text": "가열 및 냉각장치는 적합한 규격 또는 제조자의 지침에 따라 설치하여야 한다.",
      "guideContext": "공기냉각 및 가열장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "냉난방 장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-018",
      "text": "공기덕트는 철, 강철, 알루미늄, 구리, 콘크리트, 벽돌, 진흙타일 등과 같은 재료로 시공하여야 하며, 단단(Rigid)하거나 가요성(Flexible)이 있어야 한다.",
      "guideContext": "공기덕트 시공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-019",
      "text": "공기공급, 공기순환이나 배기설비 및 용적/압력 가변식 공기설비와 같은 공기덕트 설비 사용의 요구사항을 만족시키도록 보강, 밀봉된 재료로 시공하여야 한다.",
      "guideContext": "공기덕트 시공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-020",
      "text": "덕트설비에서의 진동차단 연결관은 화염지연 구조로 만들거나 적합한 재료를 사용하여 슬리브조인트를 구성하여야 한다.",
      "guideContext": "공기덕트 시공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-021",
      "text": "방화댐퍼의 작동을 방해하지 않기 위하여 방화댐퍼에서의 공기덕트 라이닝을 하여서는 안 된다.",
      "guideContext": "공기덕트 시공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-022",
      "text": "공기덕트 피복재의 설치로 점검구를 막거나 은폐하여서는 안 된다.",
      "guideContext": "공기덕트 시공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-023",
      "text": "점검구는 방화댐퍼, 방연댐퍼 및 연기감지기에 근접한 공기덕트에 설치하여야 하며, 장치의 보수 및 재배치가 가능한 크기이어야 한다.",
      "guideContext": "공기덕트 접근 및 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-024",
      "text": "수평 공기덕트 및 플레넘에는 먼지 및 가연성 물질의 축적을 용이하게 제거할 수 있도록 점검구를 설치하여야 한다.",
      "guideContext": "공기덕트 접근 및 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-025",
      "text": "공기덕트의 점검구 보수 및 점검을 위하여 접근이 가능하도록 벽이나 천장의 개구부 등에 설치하여야 한다.",
      "guideContext": "공기덕트 접근 및 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-026",
      "text": "공기덕트는 손상되거나 균열이 쉽게 생기지 않는 곳에 설치하거나 그 기능이 완전하게 유지될 수 있도록 보호하여야 한다.",
      "guideContext": "공기덕트 보전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-027",
      "text": "공기덕트가 옥외에 위치한 경우, 피복재나 내장재 등으로 공기덕트를 위해요소로부터 방호하여야 한다.",
      "guideContext": "공기덕트 보전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-028",
      "text": "전기, 화석연료 또는 태양에너지 등 직접 열원이 공기덕트에 설치된 경우, 화재위험을 발생시키지 않아야 한다.",
      "guideContext": "공기덕트 보전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-029",
      "text": "공기배출구는 어떤 부분에 공급되는 공기이든 간에 양 및 농도에 있어서 위험상황을 발생시킬 수 있는 인화성 증기, 부유물, 먼지 등을 포함하여서는 안 된다.",
      "guideContext": "공기배출구 및 공기흡입구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-030",
      "text": "인화성 증기, 부유물, 먼지 등이 순환 공기설비에 위험상황을 발생시킬 수 있는 양 또는 농도로 존재하는 경우, 공기흡입구에는 어떤 장소로부터도 공기가 재순환되어서는 안 된다.",
      "guideContext": "공기배출구 및 공기흡입구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-031",
      "text": "공기배출구 및 공기흡입구는 불연성 재료로 설치하여야 한다.",
      "guideContext": "공기배출구 및 공기흡입구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-032",
      "text": "공기배출구 및 공기흡입구는 바닥으로부터 최소한 7.5 cm 위에 위치하여야 한다. 다만, 오물이나 먼지축적물 등이 설비에 들어가는 것을 방지하기 위한 시설이 있는 경우는 예외로 할 수 있다.",
      "guideContext": "공기배출구 및 공기흡입구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-033",
      "text": "방화댐퍼 및 방연댐퍼는 적합한 규격 또는 제조자의 지침에 따라 설치하여야 한다.",
      "guideContext": "방화댐퍼 및 방연댐퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-034",
      "text": "설비의 잔존물로부터 필터를 포함한 공기 취급장치의 용량이 7000 L/sec 이상인 경우에는 연기순환을 제한하기 위하여 방연댐퍼를 설치하여야 한다.",
      "guideContext": "방화댐퍼 및 방연댐퍼 (법령 근거 미확인)",
      "additionalDetail": "다만, 공조기가 그것이 작동하는 층에 위치하고 그 층에서만 작동하는 경우, 또는 공조기가 지붕에 위치하고 그 바로 밑의 층에서만 작동하는 경우는 예외",
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-035",
      "text": "덕트배분 플레넘은 5.3.1항 공기덕트의 시공에서 정한 방법으로 설치하여야 한다.",
      "guideContext": "플레넘 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-036",
      "text": "조립된 공간용 케이싱 플레넘은 5.3.1항 공기덕트의 시공에서 정한 방법으로 설치하여야 한다.",
      "guideContext": "플레넘 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-037",
      "text": "의료, 보호 및 감호, 주거 용도의 복도 출구가 인접지역을 위한 공조시설의 한 부분으로 사용하여서는 안 된다.",
      "guideContext": "복도 공기설비 (법령 근거 미확인)",
      "additionalDetail": "다만, 문이 난 화장실·욕실·샤워룸·싱크대, 문틈이 방화문 규정 간격 초과, 공학적 제연설비 일부분, 보호·감호시설 개방 구조물 등은 예외",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-038",
      "text": "비상통로, 계단, 경사로 및 다른 비상구는 건물 내 다른 부분을 위한 급기, 순환, 배기 설비와 같은 공조설비의 일부분으로 사용하여서는 안 된다.",
      "guideContext": "복도 공기설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-039",
      "text": "공기공급이나 순환공기 조절공간으로 사용되는 공기조절 유니트는 공조기실 플레넘의 기준에 적합하여야 한다.",
      "guideContext": "공조설비실 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-040",
      "text": "개구부의 보호를 포함하여 공조설비실은 샤프트의 내화성능 이상의 구축물인 샤프트로부터 분리하여야 한다.",
      "guideContext": "공조설비실 샤프트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-041",
      "text": "공조기를 수용하는 기타공간은 건축물 관련 법규나 규정에서 요구하는 사항을 만족하여야 한다.",
      "guideContext": "공조설비실 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-042",
      "text": "금속 공기덕트로부터 목재 라스(Wood lath)에 석고처리를 한 것을 포함한 조립품까지의 틈새는 1.3 cm 이상이거나, 그 가연재료는 두께 0.6 cm 이상의 적합한 단열재료로 보호하여야 한다.",
      "guideContext": "건물 시공 공기덕트 간격 (법령 근거 미확인)",
      "additionalDetail": "다만, 이 간격은 오직 환기나 냉방, 가열되지 않은 공기조절에만 쓰이는 설비에서는 예외로 할 수 있다.",
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-043",
      "text": "행거를 포함한 공기덕트의 설치는 구조재의 내화성능을 저하시켜서는 안 된다.",
      "guideContext": "건물 시공 구조재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-044",
      "text": "2시간 이상의 내화성능이 요구되는 벽이나 칸막이의 개구부를 공기덕트가 통과하거나, 그것에서 끝나는 곳에 적절한 댐퍼를 설치하여야 한다.",
      "guideContext": "내화성 벽 및 칸막이 개구부 방호 (법령 근거 미확인)",
      "additionalDetail": "다만, 벽을 관통하는 다른 개구부를 방호할 필요가 없는 경우 방화댐퍼는 설치하지 않아도 된다.",
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-045",
      "text": "내화성능을 가지며 다른 개구부의 방호가 요구되는 칸막이에 있는 모든 공기 이송 개구부에는 규격에 맞는 방화댐퍼를 설치하여야 한다.",
      "guideContext": "내화성 벽 및 칸막이 개구부 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-046",
      "text": "공기덕트가 한 층의 바닥이나 인접하는 2개층 만을 관통하는 경우, 공기덕트가 바닥을 관통하는 지점에 방화댐퍼를 설치하여야 한다.",
      "guideContext": "내화성이 요구되는 바닥 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-047",
      "text": "수직개구부의 방호를 요하는 건물 바닥을 통과하는 공기덕트는 건축물 규정에서 인정하는 재료로 시공된 칸막이나 벽으로 구획하여야 한다.",
      "guideContext": "샤프트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-048",
      "text": "구획 부분의 내화성능은 각각 4층 미만인 건물에 설치된 공기덕트에서는 1시간 이상, 4층 이상의 건물인 경우 2시간 이상이어야 한다.",
      "guideContext": "샤프트 (법령 근거 미확인)",
      "additionalDetail": "다만, 공기덕트가 한층만을 관통하고 당해 바닥을 관통하는 지점에 방화댐퍼가 설치된 경우에는 공기덕트의 외함은 요구하지 않는다.",
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-049",
      "text": "공기덕트를 구성하거나 주변공기의 이동에 사용되는 공기덕트를 감싼 샤프트는 조리기구로부터 나온 연기 및 기름이 함유된 증기제거용 배기덕트, 인화성 증기 제거용 덕트, 원료·증기·먼지를 이동·전달·전송하는 덕트, 불연성·부식성 가스나 증기 제거용 덕트, 쓰레기 등 폐기물과 연결되어서는 안 된다.",
      "guideContext": "샤프트 (법령 근거 미확인)",
      "additionalDetail": "다만, 물이나 기타 무해·무독성 물질을 운반하는 배관은 예외",
      "workProcessPhase": "공기덕트 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-050",
      "text": "방연댐퍼는 공기덕트가 방연벽을 관통하는 지점이나 인근지점에 설치한다. 그러나 방연벽으로부터 0.6 m 이상 떨어지거나 공기덕트의 흡입구나 배기측에 설치하여서는 안 된다.",
      "guideContext": "방연벽 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방연댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-051",
      "text": "방연벽의 관통부분에 방화댐퍼가 필요한 경우, 연기 및 화염방지를 위한 겸용의 방화 및 방연댐퍼를 설치하여야 한다.",
      "guideContext": "방연벽 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방연댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-052",
      "text": "모든 댐퍼 및 천장댐퍼의 작동은 자동이어야 하며, 공기 덕트에서 비정상적 온도상승에 의하여 쉽게 영향 받을 수 있는 위치에 설치된 등록된 퓨지블 링크(Fusible link)나 다른 승인된 열 작동장치가 작동될 때에는 닫혀진 상태로 유지하여야 한다.",
      "guideContext": "댐퍼폐쇄기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-053",
      "text": "연기제거를 위하여 필요한 경우, 방화 및 방연 댐퍼가 조합된 장치에 대하여 원격 개방이 가능하여야 한다.",
      "guideContext": "댐퍼폐쇄기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-054",
      "text": "댐퍼는 그것이 설치되는 공기덕트 설비의 부분 중 최대 산출 기류에서 작동하여야 한다.",
      "guideContext": "댐퍼폐쇄기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-055",
      "text": "모든 방화, 방연, 천장댐퍼 및 본 지침에서 요구하는 동일형의 방호장치의 위치 및 배열은 공기덕트 설비의 도면에 표시하여야 한다.",
      "guideContext": "댐퍼 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-056",
      "text": "슬리브를 포함한 방화댐퍼, 방연댐퍼 및 천장댐퍼는 등록조건 및 제조자의 설치지침에 따라 설치하여야 한다.",
      "guideContext": "댐퍼 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-057",
      "text": "방화댐퍼용 슬리브의 두께는 내화성능 조건에 관련된 것보다 작아서는 안 된다.",
      "guideContext": "댐퍼 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방화댐퍼 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-058",
      "text": "최소한 4년마다 퓨지블 링크를 교체하며, 작동여부를 확인하기 위하여 모든 댐퍼를 작동시키며, 걸쇠를 점검하고 필요하면 동작부분을 손질한다.",
      "guideContext": "댐퍼 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정기 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-059",
      "text": "공기조화 및 환기설비의 작동 및 제어에 관련된 배선 및 장치의 설비는 관련 규격에 적합하여야 한다.",
      "guideContext": "설비 제어 배선 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-060",
      "text": "각 공기 배분설비에는 비상시에 팬의 공급, 순환 및 배기의 작동을 정지시킬 수 있는 한 가지 이상의 수동 작동수단이 있어야 한다. 이때, 수동 작동수단은 승인된 장소에 설치하여야 한다.",
      "guideContext": "설비 수동제어 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-061",
      "text": "방연댐퍼는 자동경보장치에 의하여 제어되어야 한다. 이때, 방연댐퍼는 방재센터에서 수동으로 작동될 수 있도록 하여야 한다.",
      "guideContext": "방연댐퍼 제어 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-062",
      "text": "공조기를 차단시키기 위하여 설치된 방연댐퍼는 설비가 작동되지 않을 때 자동으로 닫혀지도록 설치하여야 한다.",
      "guideContext": "방연댐퍼 제어 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-063",
      "text": "방연벽에 설치된 방연댐퍼는 이와 관련된 댐퍼기동장치나 연기감지가 작동하는 한, 팬이 정지한 경우에도 개방되어 있어야 한다.",
      "guideContext": "방연댐퍼 제어 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-064",
      "text": "모든 자동 차단장치는 연 1회 이상 시험하여야 한다.",
      "guideContext": "자동제어용 연기감지기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정기 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-065",
      "text": "공기배분 설비용으로 등록된 연기감지기는 공기필터의 하류와 1000 L/sec 이상의 용량이 큰 급기설비의 분기관 연결부, 각층 공동리턴 연결부 앞과 800 L/sec 용량을 초과하고 1개 층 이상에 사용되는 공기순환 설비의 모든 재순환 또는 신선한 공기흡입구 연결부의 전면에 설치하여야 한다.",
      "guideContext": "자동제어용 연기감지기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연기감지기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-066",
      "text": "연기감지기에 연기가 감지된 때에는 자동적으로 각 팬이 정지하여야 한다.",
      "guideContext": "자동제어용 연기감지기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-067",
      "text": "연기감지기는 적합한 신호설비기준의 요구사항에 따라 안전 신호장치에 연결하여야 한다.",
      "guideContext": "자동제어용 연기감지기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "연기감지기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-068",
      "text": "승인된 방호신호설비를 설치하지 않은 건물에 설치된 경우, 연기감지기의 고장 상태는 설치된 지역 내에 시각적으로 또는 음향으로 지시되어야 하며, 또한 공기덕트 감지기의 고장도 동일하게 지시하여야 한다.",
      "guideContext": "자동제어용 연기감지기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-069",
      "text": "인수시험을 통해 본 지침에서 제시한 방호조치가 화염 및 연기확산 제어기능이 양호한지를 결정하여야 한다.",
      "guideContext": "인수시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인수시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-070",
      "text": "모든 방화, 방연 및 천장댐퍼는 건물 입주에 앞서 본 지침에서 제시한 조건에 따라 정상적으로 기능을 발휘할 수 있도록 작동테스트를 하여야 한다.",
      "guideContext": "인수시험 댐퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인수시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-071",
      "text": "팬의 정지 및 자동댐퍼 작동에 관한 제어는 본 지침에서 제시한 조건에 따라 시험하여야 한다. 이때, 일반적으로 공기조화설비의 화재경보설비도 시험항목에 포함한다.",
      "guideContext": "인수시험 제어 및 운영체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인수시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-072",
      "text": "공기조화 및 환기설비에서 방화 장치의 수용여부는 가능한 한 일상 작업조건에서 수행하여야 한다.",
      "guideContext": "인수시험 제어 및 운영체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인수시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P63-073",
      "text": "경보 및 제어설비의 몇 가지 부분은 예비전원이나 긴급시의 기타 다른 운전법을 확보하고, 정상상태와 마찬가지로 이들 조건하에서 작동이 가능한 지를 결정할 수 있도록 시험하여야 한다.",
      "guideContext": "인수시험 제어 및 운영체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인수시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P63-001",
      "term": "공기정화기",
      "definition": "가열, 환기 및 공기조절 설비로부터 나온 공기 중의 부유물질을 정전기적 수단으로 제거하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-002",
      "term": "공기연결관",
      "definition": "공기덕트나 플레넘과 같은 공기터미널 유니트나 급기구 또는 배기구 사이의 공기를 이송하는 도관을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-003",
      "term": "공기덕트",
      "definition": "공기를 운반하는 도관을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-004",
      "term": "급기구",
      "definition": "공기가 유입되는 개구부를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-005",
      "term": "배기구",
      "definition": "공기가 배출되는 개구부를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-006",
      "term": "플레넘",
      "definition": "하나 이상의 공기덕트가 연결되고 공기배분설비를 구성하는 작은 공간을 말하며, 저장용으로 사용하는 것은 아니다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-007",
      "term": "방화댐퍼",
      "definition": "열감지기와 연동하여 자동으로 폐쇄하도록 설계되어 공기의 흐름을 차단하며, 화염의 확산을 막는 공기배분설비에 설치된 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-008",
      "term": "방연댐퍼",
      "definition": "공기 배분설비 안에서 공기이동을 제어하는 장치로 화염 및 연기의 확산을 막는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-009",
      "term": "천장댐퍼",
      "definition": "내화도가 1시간 이상인 천장에 있는 급기구나 배기구를 통하여 방출되는 열의 전달을 제한하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-010",
      "term": "방연벽",
      "definition": "벽, 바닥 또는 천장 등으로 연기의 이동을 제한하도록 설계된 수직 또는 수평의 연속 막을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P63-011",
      "term": "HVAC",
      "definition": "건물의 난방(Heating) 환기(Ventilating) 공기조화(Air Conditioning) 설비를 총체적으로 지칭하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P63-01",
      "processOrder": 1,
      "processName": "HVAC 설비 설치 및 배치",
      "safetyMeasures": "장치는 검사·유지·보수가 가능하도록 배열하고, 제조자의 설치 지침에 맞도록 설치하며, 인명 보호 및 이물질 침입 방지를 위해 방호한다. 전기배선 및 기기는 규격에 맞는 제품을 사용한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-P63-02",
      "processOrder": 2,
      "processName": "외부 공기 유입구 설치",
      "safetyMeasures": "가연성 물질·인화성 증기 유입 방지 배치, 12.5mm mesh 이하 내식성망 보호, 가연성 부속건물·위험시설로부터 화염 유입 최소화 위치 선정, 적절한 방화댐퍼 설치",
      "requiredPPE": [],
      "sourceSection": "5.2.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-P63-03",
      "processOrder": 3,
      "processName": "공기덕트 시공",
      "safetyMeasures": "철·강철·알루미늄 등 적합한 재료 사용, 보강·밀봉 재료로 시공, 적절한 구조 강도·내구성 확보, 진동차단 연결관은 화염지연 구조, 방화댐퍼에서 라이닝 금지, 피복재로 점검구 은폐 금지",
      "requiredPPE": [],
      "sourceSection": "5.3.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-P63-04",
      "processOrder": 4,
      "processName": "방화댐퍼 및 방연댐퍼 설치",
      "safetyMeasures": "적합한 규격 또는 제조자 지침에 따라 설치, 내화성 벽·칸막이 개구부에 적절한 댐퍼 설치, 바닥 관통 지점에 방화댐퍼 설치, 방연벽 관통 지점에 방연댐퍼 설치(0.6m 이내), 슬리브 두께 내화성능 조건 이상",
      "requiredPPE": [],
      "sourceSection": "6.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-P63-05",
      "processOrder": 5,
      "processName": "연기감지기 설치 및 제어 배선",
      "safetyMeasures": "공기필터 하류 및 1000 L/sec 이상 급기설비 분기관에 설치, 800 L/sec 초과 공기순환 설비 재순환·흡입구 전면에 설치, 안전 신호장치 연결, 고장 시 시각적·음향 지시 확보",
      "requiredPPE": [],
      "sourceSection": "7.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-P63-06",
      "processOrder": 6,
      "processName": "인수시험 및 작동 테스트",
      "safetyMeasures": "모든 방화·방연·천장댐퍼 작동테스트 실시, 팬 정지·자동댐퍼 작동 제어 시험, 화재경보설비 시험 포함, 예비전원·긴급 운전법 확보 후 작동 확인, 일상 작업조건에서 방화장치 수용여부 확인",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-P63-07",
      "processOrder": 7,
      "processName": "정기 점검 및 유지보수",
      "safetyMeasures": "4년마다 퓨지블 링크 교체, 모든 댐퍼 작동여부 확인, 걸쇠 점검 및 동작부분 손질, 자동 차단장치 연 1회 이상 시험, 연기감지장치 청결 유지 및 감지 정확성 확인",
      "requiredPPE": [],
      "sourceSection": "6.3.6",
      "relatedSR": null
    }
