  "checklistItems": [
    {
      "identifier": "CI-H122-001",
      "text": "사업주는 모든 작업공정에 대한 표준작업지침서를 작성하고 근로자들이 이를 준수하도록 관리 감독한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": "표준 작업관리지침은 분진 발생 억제조치 설비의 설치, 환기장치 가동요령, 호흡보호구 지급 및 착용·관리방법, 유해성 정보와 응급조치 등에 관한 사항을 포함한다.",
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-002",
      "text": "목재 분진에 대한 물질안전보건자료(MSDS)를 노출 근로자들이 쉽게 볼 수 있는 위치에 비치 및 관리한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H122-003",
      "text": "주기적인 작업환경 측정을 통해 노출 정도를 평가하고 관리한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-004",
      "text": "주기적인 건강진단(일반, 특수)을 실시하고 정해진 안전보건교육시간에 따라 교육을 실시하여 건강장해를 예방한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-005",
      "text": "휴게실, 식당과 분진 노출 작업장은 격리한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-006",
      "text": "목재 취급 작업 시 적절한 호흡용 보호구(방진마스크)를 착용한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H122-007",
      "text": "적절한 보호복과 장갑을 착용한다. 보호복과 장갑은 전기톱과 같은 작업 장비에 끼거나 휘감기지 않게 착용한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H122-008",
      "text": "음식을 먹기 전에 손과 얼굴을 씻고 흡연을 할 경우 작업지역 밖으로 이동한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-009",
      "text": "작업장을 벗어날 때에는 샤워를 하고 깨끗한 옷으로 갈아입는다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-010",
      "text": "건강진단에 빠짐없이 참여하고 사업주가 실시하는 교육에 참여한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-011",
      "text": "현장의 정리, 정돈, 청소 등 청결을 유지한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H122-012",
      "text": "작업은 가능한 한 습식화 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-DUST-003"
      ]
    },
    {
      "identifier": "CI-H122-013",
      "text": "기계와 주변 작업장을 매일 청소하여 청결하게 유지한다. 청소 시 습식 청소 및 흡입용 청소기를 이용하여 비산 분진을 감소시킨다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "일반적인 작업 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H122-014",
      "text": "청소 및 의복에 묻은 목재 분진을 제거하기 위해 빗자루나 압축 공기 등을 사용하여 비산시키지 않도록 주의한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반적인 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-015",
      "text": "전기톱, 연마기 등 기구를 이용하여 작업하는 경우 회전 속도를 적절하게 하여 비산 분진을 감소시킨다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반적인 작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-016",
      "text": "목재 분진에 노출되는 근로자 및 해당 업무에 종사하게 될 근로자에 대해서는 다음 내용이 포함된 특별안전보건 교육을 16시간 이상 실시한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": "교육 내용: 사용 목재 종류, 건강영향과 예방대책, 직업병 예방 조치 사항, 공정별 표준작업 요령, 국소배기장치 및 안전설비, 보호구 사용법 및 관리방법, 응급처치방법, 기타 안전·보건상의 조치",
      "workProcessPhase": "교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-017",
      "text": "해당 공정이 분산 배치되지 않도록 하고 다른 작업장과 격리시킨다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업공정 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-018",
      "text": "관련 기계, 기구 등을 배치할 때는 가능한 밀폐하거나 국소배기장치 등을 설치하여 근로자에게 분진 노출을 최소화한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업공정 배치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-019",
      "text": "작업상 필요한 개구부를 제외하고는 완전히 밀폐시킨다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "분진 발산원 밀폐",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-DUST-001",
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H122-020",
      "text": "목재 보관 장소, 작업 장소 등 밀폐된 작업 장소의 내부는 전체환기 장치를 설치하여 음압으로 유지한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "분진 발산원 밀폐",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H122-021",
      "text": "작업특성상 밀폐실 내부를 음압으로 유지하는 것이 곤란한 경우 또는 개구부 등을 통하여 분진이 노출되는 경우에는 해당 부위에 국소배기장치를 설치하여 분진 발산을 최소화한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "분진 발산원 밀폐",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-022",
      "text": "사업주는 목재 분진에 노출되는 공정에 설치된 국소배기장치의 배기량을 보충하는 전체환기 장치를 설치해야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": "설치하지 않은 경우 국소배기장치의 필요 송풍량이 달성되지 않는다.",
      "workProcessPhase": "환기",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H122-023",
      "text": "외부공기가 유입되는 송풍기나 급기구에는 필요시 외부로부터 유해물질의 유입을 막기 위한 필터나 흡착시설 등을 설치하는 것이 바람직하다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "환기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H122-024",
      "text": "작업장 외부로 배출된 공기가 당해 작업장 또는 인접한 다른 작업장으로 재유입되지 않도록 필요한 조치를 취해야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "환기",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H122-025",
      "text": "전체 환기장치를 설치할 때 국소배기장치에서 배기되는 송풍량을 고려하여 그 효율이 떨어지지 않도록 적정한 필요 환기량을 산정하여야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": "필요 환기량의 산정은 환기설비에 관한 기술지침(KOSHA GUIDE W-1-2012)의 <별표1>을 참고한다.",
      "workProcessPhase": "환기",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H122-026",
      "text": "국소배기장치의 후드는 작업 방법, 분진 발산 상태 등을 고려하여 분진을 흡인하기에 적당한 형식과 크기로 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-027",
      "text": "후드는 발산원마다 설치한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-028",
      "text": "후드의 형식은 포위식 또는 부스식 후드를 설치하는 것을 원칙으로 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": "포위식 또는 부스식 후드를 설치하기가 곤란한 경우에는 외부식 또는 레시버식 후드를 설치하되 분진이 발생되는 발산원에서 가장 가까운 위치에 설치한다. 후드로 들어가는 공기 방향이 근로자 호흡기를 통과하지 않도록 해야 한다.",
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-029",
      "text": "국소배기장치의 덕트 길이는 가능한 짧게 하고 굴곡부의 수를 적게 하여 압력손실을 최소화한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-030",
      "text": "국소배기장치는 후드, 덕트, 공기정화장치, 송풍기, 배기구의 순으로 설치하는 것을 원칙으로 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-031",
      "text": "국소배기장치의 배기구는 직접 외부로 향하도록 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-032",
      "text": "국소배기장치의 배기구 높이는 옥상 또는 옥상, 난간상부로부터 건물 높이의 0.5배 이상으로 하여 배출된 발암성물질이 당해 작업장으로 재 유입되거나 인근의 다른 작업장으로 확산되지 않는 구조로 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-033",
      "text": "배기구는 전체환기장치의 외부 공기 유입구와도 15 m이상 거리를 두는 것이 좋다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-034",
      "text": "국소배기장치에 공기정화장치를 설치하는 경우에는 고체흡착 방식, 연소 방식 또는 이와 동등 이상의 성능을 가진 공기정화장치를 설치한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-035",
      "text": "국소배기장치의 성능은 물질의 상태에 따라 <표 1>에서 정하는 제어풍속 이상이 되도록 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": "입자 상태: 포위식 포위형 0.7 m/sec, 외부식 측방흡인형 1.0 m/sec, 외부식 하방흡인형 1.0 m/sec, 외부식 상방흡인형 1.2 m/sec",
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-036",
      "text": "국소배기장치는 설치 목적에 알맞도록 가동하고 작업 중에 작업자가 임의로 가동을 중지시킬 수 없는 구조로 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 가동",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.3",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-037",
      "text": "국소배기장치가 정상 가동이 되지 않는 경우에는 작업자가 이상 상태를 즉시 인지 할 수 있도록 경보장치 등을 설치한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 가동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-038",
      "text": "후드 가장자리에 가벼운 끈 등을 부착하여 제어되는 방향과 강도를 근로자가 보고 국소배기장치의 성능을 판단할 수 있도록 하는 것이 좋다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 가동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-039",
      "text": "목재 분진이 발산되어 화재·폭발의 위험이 있는 경우에는 작업을 중단하거나 제한할 수 있도록 하고 시설, 장비 등의 가동이 자동적으로 중단되도록 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 가동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-040",
      "text": "작업이 종료된 이후에도 작업장 내에 분진이 발산되는 제품 등이 있는 경우에는 유해요인이 제거될 때까지 국소배기장치를 계속 가동한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 가동",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.3",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-H122-041",
      "text": "당해 국소배기장치의 가동 여부를 수시 확인하고 필요할 때는 가동일지 등을 기록, 보관한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 가동",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.3",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-H122-042",
      "text": "국소배기장치를 설치한 후 처음 사용하거나 분해하여 개조 또는 수리한 후 재사용 할 경우에는 다음 사항을 점검하고 이상을 발견하면 즉시 청소, 보수하는 등 필요한 조치를 하여 항상 성능이 유지되도록 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": "점검사항: 덕트 및 배풍기의 분진 퇴적 상태, 덕트 접속부의 이완 유무, 흡기 및 배기 능력의 적정성, 기타 성능 유지 필요사항",
      "workProcessPhase": "국소배기장치 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.4",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-H122-043",
      "text": "사업주는 산업안전보건법 제36조 및 같은 법 시행규칙 제74조에 의거하여 작업 중 국소배기장치(제진장치 및 배출가스 처리장치포함)가 효과적으로 작동하고 있는지 확인하기 위해 노동부령이 정하는 자격을 가진 자로 하여금 매년 1회 이상 정기적으로 안전검사를 실시하고 그 결과를 기록, 보존하여야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 안전검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.5",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-H122-044",
      "text": "사업주는 근로자대표의 요구가 있을 때에는 자체검사에 근로자대표를 입회시켜야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 안전검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-045",
      "text": "미세 목재 분진은 눈으로 잘 보이지 않으므로 분진 전구(dust lamp)를 설치하여 비산 분진의 정도를 확인하여 작업자 스스로 분진 노출을 관리할 수 있게 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-046",
      "text": "목재를 취급하는 근로자는 호흡기 노출을 방지하기 위하여 안전인증을 받은 개인전용 호흡용 보호구(방진마스크)를 착용 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": "호흡용 보호구의 사용 및 관리에 대한 자세한 내용은 호흡용 보호구의 사용지침(KOSHA GUIDE H-82-2012)을 참고한다.",
      "workProcessPhase": "개인 보호",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H122-047",
      "text": "사업주는 작업환경 실태를 파악하기 위하여 해당 근로자 또는 작업장에 대해 작업환경측정 계획 수립, 측정 실시, 작업환경 평가를 하여야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-048",
      "text": "사업주는 작업환경측정에 관한 서류를 30년간 보존하여야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-049",
      "text": "사업주는 작업환경측정결과를 근로자에게 알려야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": "방법은 게시판 부착, 사보 게재, 교육시간을 통한 방법 등 해당 근로자들이 결과를 알 수 있는 방법을 이용한다.",
      "workProcessPhase": "작업환경 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H122-050",
      "text": "사업주는 산업안전보건법 제43조, 시행규칙 별표 12의2(특수건강진단 대상 유해인자)에 의해 목재 분진 노출 근로자에 대해 일반건강진단, 특수건강진단, 배치전 건강진단을 실시해야 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-051",
      "text": "목재 분진에 노출되는 근로자에 대한 배치전 및 특수건강진단을 실시한다. 이때 호흡기 질환(진폐, 천식)에 유의하여 진찰을 하고, 흉부방사선, 폐활량검사 결과를 관찰한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-052",
      "text": "사업주는 근로자가 다음과 같은 증상과 징후를 보이는 경우에 수시건강진단을 실시한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": "호흡기 자극증상, 기관지염, 천식, 자극성 피부염, 알레르기성 피부염 등의 증상 및 징후를 보일 때",
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H122-053",
      "text": "목재 분진을 취급하는 작업에는 임신부나 18세 미만의 사람이 종사하지 않도록 한다.",
      "guideContext": "목재 분진 노출 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "보건관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.4.3",
      "basedOn": [
        "SR-SPECIAL_WORKER-001"
      ]
    }
  ],
  "domainTerms": [
