  "checklistItems": [
    {
      "identifier": "CI-D20-001",
      "text": "라이닝 하고자 하는 화학설비는 작업자가 용이하게 작업할 수 있도록 맨홀 또는 분리가 가능한 뚜껑(이하 \"맨홀 등\"이라 한다)이 있어야 하며, 표면처리 및 접착제를 사용할 때 발생하는 유해가스 등을 충분히 환기시킬 수 있는 구조로 제작되어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-002",
      "text": "용접이 필요한 모든 부속물은 라이닝 하기 전에 장착되어 있어야 하며, 라이닝 후 또는 라이닝 중에는 해당 화학설비의 내·외부 표면에 용접 등 화기작업을 하여서는 안된다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-003",
      "text": "화학설비의 내용물을 용기의 바깥 쪽에서 가열하도록 된 구조의 것은 고무의 접착면이 고온으로 가열되면 고무가 박리되거나 부풀게 되는 원인이 되기 때문에 가열장치는 라이닝 표면으로부터 100㎜이상 이격하여 설치하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "증기를 불어넣을 때에는 라이닝 표면에 직접 증기가 닿지 않도록 한다.",
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-004",
      "text": "외부와 연결되는 모든 노즐은 플랜지식이어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-005",
      "text": "라이닝 작업은 사람 손에 의한 작업이므로 구조는 될 수 있는 대로 간단해야 하고, 라이닝할 부분에는 가공 시에는 반드시 손이 닿을 수 있어야 하여 직접 눈으로 볼 수 있도록 분할구조이어야 한다, 다만 관류는 그렇지 않다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-006",
      "text": "사용 중에 손상되기 쉬운 부분은 본체에서 들어내어 교환하기 쉽고, 보수 점검 및 수리가 용이한 구조로 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-D20-007",
      "text": "라이닝하는 화학설비는 단순하여야 하고, 보강을 필요로 하는 경우에는 라이닝을 하지 않은 면에 보강물을 부착하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-008",
      "text": "화학설비 내부에서 살수관이나 다공판 등을 설치하는 경우에는 라이닝작업이 불안전하여 사용 중 문제발생 가능성이 높고, 수리가 힘들므로 분할 구조 설계가 바람직하다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-D20-009",
      "text": "라이닝에 기계적 강도를 필요로 하는 경우에는 라이닝된 부분에 나사 가공부 등을 설치하지 않도록 주의하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-010",
      "text": "라이닝 하고자 하는 화학설비로서 특히 경질 고무를 라이닝으로 사용 하는 것은 수송이나 조립, 설치 공사 및 사용 중에 반복 변형으로 균열 등의 사고가 생기기 쉬우므로 충분한 강성을 갖도록 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-011",
      "text": "라이닝하는 관체 및 기기의 치수, 평행도, 직각도, 진원도, 동심도, 진직도, 평면도 및 회전체와의 조정 등은 라이닝 전의 관체의 상태에 있어서 충분히 주의하여 제작하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 구조 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-012",
      "text": "라이닝 하고자 하는 화학설비가 압력용기에 해당하는 경우에는 라이닝 작업전 압력용기 안전인증기준 및 검사기준에 의하여 인증 및 검사를 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-013",
      "text": "라이닝 하고자 하는 화학설비의 내용물과 접촉하는 모든 부위는 라이닝 되어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 시공",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-014",
      "text": "모든 플랜지, 맹관 및 맨홀 뚜껑들은 플랜지의 접촉면까지 라이닝 되어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 시공",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-015",
      "text": "라이닝면의 용접은 모두 연속 용접하고, 구조상 용접 부분에 공기집이 생길 우려가 있을 때에는 공기 빼는 구멍을 만들든지 또는 단속 용접한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-016",
      "text": "라이닝 하고자 하는 용접부위는 날카로운 부위가 없도록 매끄럽게 다듬어야 하며 언더컷, 기공, 균열, 패임 등의 용접결함이 없어야 한다. 용접 결함이 있는 경우에는 결함의 제거 및 보수용접을 한후 다시 매끄럽게 다듬어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-017",
      "text": "철관의 모서리 바깥쪽으로 라이닝 할 경우 모서리 가공 반경은 라이닝 할 고무관 두께 이상이어야 하며 반대로 철관의 모서리 안쪽으로 라이닝 할 경우 모서리 가공 반경은 라이닝 할 고무관 두께의 2배 이상이어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-018",
      "text": "라이닝 모서리는 둥글게 하고 일반적으로 안쪽 모서리는 최소 10R, 바깥쪽 모서리는 최소 3R로 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-019",
      "text": "라이닝용 고무재료를 선택할 때에는 화학설비의 내용물을 고려하여 가장 적절한 것으로 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "경화된 라이닝용 고무의 물리·화학적 성질은 사용된 고무의 종류, 배합물 중에 포함된 충진제 및 경화제의 양과 종류에 따라 광범위하게 변화한다.",
      "workProcessPhase": "라이닝 재료 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032",
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-D20-020",
      "text": "라이닝 고무재료에 의해 화학설비의 내용물이 오염될 우려가 있는 경우에는 라이닝 고무재료의 견본에 대하여 사전에 번짐 시험을 실시하여 라이닝 고무재료를 선정하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 재료 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-021",
      "text": "니켈, 크롬강, 부주강, 티탄, 하스테로이 및 스테라이트 등의 특수강을 사용할 때에는 미리 라이닝 재질에 의한 접착력을 시험한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "스테인레스 13~33 까지는 일반적인 접착제로 고무의 접착이 가능하다. 다만 특수강의 성분에 따라 연강재의 접착력과 같은 접착력을 얻기는 어렵다.",
      "workProcessPhase": "화학설비 재질 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-022",
      "text": "주철 및 주강은 접착성에는 문제가 없다. 표면결함 등 때문에 가교 중 뜨거나 부풀림 등의 현상이 생겨 라이닝이 곤란해지므로 공동이나 다공질이어서는 안된다. 대형 혹은 중량물로서 주조물을 라이닝할 때에는 미리 라이닝 시공사와 협의하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 재질 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-023",
      "text": "알루미늄 합금에 고무 라이닝을 할 때에는 미리 라이닝 재질에 의한 접착 시험을 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 재질 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-024",
      "text": "구리, 마그네슘 및 아연, 그 밖에 다른 종류의 금속에 의한 조합은 라이닝 재질과의 접착성에 문제가 있기 때문에 미리 라이닝 시공사와 협의하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "화학설비 재질 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-025",
      "text": "라이닝한 후 고무라이닝의 두께는 최소 3㎜이상이어야 한다. 다만, 심한 화학반응, 마모 또는 기계적인 손상이 있을 수 있는 경우에는 두께를 6㎜ 또는 그 이상으로 할 수 있다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "두께 6㎜ 까지의 라이닝인 경우에는 제작된 고무관을 한 층(Layer)으로, 두께 6㎜를 초과하는 라이닝의 경우에는 제작된 고무관을 두 층 이상으로 부착시킬 수 있다.",
      "workProcessPhase": "라이닝 시공",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-026",
      "text": "카렌다 또는 압출기 등에 의하여 제작된 라이닝용 고무관 내부에는 기포, 불순물 등이 없어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "카렌다에 의해 라이닝용 고무관을 제작할 경우 필요한 고무관 겹(Plies)수는 고무관의 두께, 고무의 종류 및 배합물을 고려하여 결정하여야 한다.",
      "workProcessPhase": "라이닝 시공",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-027",
      "text": "고무관 두께의 허용오차는 ±10% 이내로 유지되어야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 시공",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-028",
      "text": "라이닝 하고자 하는 화학설비의 표면은 기름, 수분 또는 다른 이물질이 없도록 완전히 세척하여야 하며 세척된 표면은 모래 또는 강구 분사를 통하여 녹이나 기타 불순물을 완전히 제거하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "표면처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-029",
      "text": "경화 과정 중 라이닝 고무관의 수축이 우려되는 경우에는 라이닝 작업 전 고무관을 가열하여 수축 발생을 사전에 방지하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-030",
      "text": "라이닝용 고무관을 화학설비 표면에 부착시킬 때에는 적당한 공구를 이용하여 고무관과 화학설비의 표면 또는 고무관과 고무관 사이에 기포가 형성되지 않도록 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-031",
      "text": "중첩이음은 고무관의 모서리를 30°에서 35°로 비스듬히 깎아 두 고무관이 중첩되게 잇는 방법으로서 중첩 이음된 접촉면의 길이는 32㎜를 초과하여서는 아니된다. 중첩이음을 할 때에는 유체의 흐름방향에 따라 고무관이 중첩되도록 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "12",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-032",
      "text": "사선이음은 고무관의 모서리를 40°에서 50°로 비스듬히 깎아 고무관이 중첩되지 않도록 잇는 방법으로서 두 고무관 사이의 접촉면 길이는 32㎜를 초과하여서는 안된다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "12",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-033",
      "text": "덮개판 이음은 고무관 모서리를 30°에서 35°로 비스듬히 각은 덮개판을 이음부위의 상부 중앙에 별도로 부착시키는 방법으로서 덮개판 끝부분으로부터 라이닝할 화학설비의 표면까지의 길이는 32㎜를 초과하여서는 안된다. 이 경우 덮개판을 부착하기 전 이음부위에 대하여 방전시험을 통하여 결함 또는 핀홀 등이 있는지 시험하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "덮개판의 두께는 라이닝 두께 이하도 할 수 있다.",
      "workProcessPhase": "라이닝 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-034",
      "text": "두 층 이상으로 라이닝을 할 경우에는 사선이음법을 사용하여야 한다. 이 경우 각층이 엇갈리면서 이어지도록 하여야 하며, 이음부위와 이음부위의 거리는 최대한으로 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "라이닝 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "12",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-035",
      "text": "라이닝된 화학설비의 크기와 라이닝 재료에 따라 경화방법, 온도 및 압력 등과 같은 경화조건을 결정하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "경화는 일반적으로 고압솥, 스팀, 가열된 공기, 더운물 등을 이용하여 실시한다.",
      "workProcessPhase": "경화",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-036",
      "text": "라이닝된 화학설비가 음압하에서 사용될 경우에는 라이닝된 화학설비의 내부에 압력을 가한 상태에서 라이닝을 경화시켜야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "경화",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "13",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-037",
      "text": "설계압력 이상의 압력을 가한 상태에서 라이닝을 경화시킬 때에는 그 내부 압력에 견딜 수 있도록 적절한 조치를 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "경화",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "13",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-038",
      "text": "경화 전·후 라이닝된 화학설비의 전표면에 대하여 기계적 손상, 기포, 접착이 잘 안된 부분 또는 이음이 불안전하게 된 부분은 없는지 여부를 확인하기 위한 육안검사를 실시하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "제품 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-039",
      "text": "경도시험은 경화가 완료된 직후에 실시하여야 한다. 경도측정치는 사용된 라이닝 재료의 경도 규정치 ±5°이내이어야 하며 경도측정은 라이닝된 표면의 단위 평방미터(㎡) 마다 최소한 3회 이상 하여야 한다. 만약 경도측정치가 규정된 경도치 미만인 경우에는 경화를 다시 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "제품 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-040",
      "text": "경화 후 라이닝된 화학설비의 표면을 세척, 건조시킨 다음 방전시험기로 라이닝의 연속성에 결함 또는 핀홀 등이 있는지 여부를 시험하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "장시간의 방전은 라이닝 표면에 손상을 줄수도 있으므로 방전시간을 적절히 선택하고 방전시험기의 탐침이 라이닝위를 연속적으로 움직이도록 하여야 한다.",
      "workProcessPhase": "제품 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-041",
      "text": "진공시험이 필요하거나 또는 라이닝된 화학설비가 음압하에서 사용될 경우에는 진공시험을 하여야 한다. 진공시험 후 라이닝의 박리 등 어떠한 결함도 라이닝 표면에 나타나서는 안된다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "제품 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-042",
      "text": "핀홀 시험은 스파크 방전에 의하여 라이닝 표면이 깨끗하고 건조되어 있는 부분에 대하여 고전압 테스트의 단자를 주사하여 핀홀의 유무를 조사한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": "전압이 지나치게 높거나 오랫동안 작용시키면 라이닝된 고무가 파괴되므로 정상 전압을 선택하고 한곳에 오랫동안 작용하지 않도록 주의하여야 한다.",
      "workProcessPhase": "제품 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "14",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-043",
      "text": "라이닝된 화학설비의 검사는 기계·기구 등 자체검사 규정의 화학설비 및 부속설비 자체검사 기준에 따라 육안검사를 실시한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "검사 및 보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "15.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-044",
      "text": "화학설비의 라이닝된 표면에 핀홀 등과 같은 결함이 우려되는 부분은 14항 (4)호의 규정에 의하여 방전시험으로 점검하여야 한다. 또한 화학설비에서 매우 부식성이 심한 물질을 취급하게 될 경우에는 라이닝된 모든 부분에 대하여 방전시험을 하여야 한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "검사 및 보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "15.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D20-045",
      "text": "보수된 부위를 경화시킨 후 14항의 규정에 따라 경도나 연속성에 대한 점검을 실시한다.",
      "guideContext": "위험물질 저장취급 화학설비의 고무라이닝",
      "additionalDetail": null,
      "workProcessPhase": "검사 및 보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "15.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    }
  ],
