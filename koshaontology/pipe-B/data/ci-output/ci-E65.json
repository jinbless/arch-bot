  },
  "checklistItems": [
    {
      "identifier": "CI-E65-001",
      "text": "작업자나 장비 또는 농기계는 심각하고 치명적인 감전 및 부상사고를 당하지 않도록 가공전선에 접촉하지 않아야 한다.",
      "guideContext": "가공전선 근처에서의 위험성",
      "additionalDetail": "농기계 또는 장비가 가공전선에 너무 가깝게 있거나 접촉하게 되면 지면에 있는 농기계 또는 장비에 전기가 흐르게 되고 가공전선에 접촉한 작업자는 감전이 발생된다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-002",
      "text": "가공전선 근처에서 작업할 때, 농업에 종사하는 모든 사람들은 안전 절차를 따르고, 이해하고, 알아야 한다.",
      "guideContext": "가공전선 근처에서의 위험성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-003",
      "text": "지면과 전력선(또는 케이블) 사이에 최소 거리(안전이격거리)를 유지해야 한다.",
      "guideContext": "가공전선의 높이",
      "additionalDetail": "일반적으로 전송되는 전압에 따라 케이블의 지표상의 높이는 변하며, 높은 전압일수록 전력케이블 높이는 더 높아진다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-004",
      "text": "가공전선의 위험성을 평가할 때 위험성 유무, 가공전선에 의해 영향을 받을 수 있는 사람, 위험성을 줄이거나 제거하기 위한 방법 유무, 추가적인 방법 유무를 고려해야 하며, 위험성평가를 할 경우 효과적인 개선이 구현되도록 계획해야 한다.",
      "guideContext": "위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-005",
      "text": "농기계와 장비를 안전하게 사용한다.",
      "guideContext": "위험성평가 관리방안",
      "additionalDetail": null,
      "workProcessPhase": "농기계 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-006",
      "text": "안전한 조작거리를 알아야 한다.",
      "guideContext": "위험성평가 관리방안",
      "additionalDetail": null,
      "workProcessPhase": "농기계 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-007",
      "text": "위험성이 높은 지역을 피할 수 있도록 작업을 계획한다.",
      "guideContext": "위험성평가 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-008",
      "text": "농장을 가로지르거나 또는 경계선 근처를 지나가는 가공전선의 전압과 경로를 찾아야 한다.",
      "guideContext": "가공전선 경로 파악 (법령 근거 미확인)",
      "additionalDetail": "농장 지도에 전압과 경로를 표시한다.",
      "workProcessPhase": "작업 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-009",
      "text": "모든 장비와 기계에 대한 수직 도달거리와 최대 높이를 알아야 한다.",
      "guideContext": "기계 작동범위 사전 파악",
      "additionalDetail": "새로운 장비 또는 중고 장비를 구입했을 때, 가공전선과 관련된 위험성을 고려한다.",
      "workProcessPhase": "농기계 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-010",
      "text": "가공전선과 관련된 위험성을 인식하도록 모든 작업자를 훈련시켜야 한다.",
      "guideContext": "작업자 정보 제공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-011",
      "text": "작업자들에게 교육을 시키고, 사고 발생시 사후 조치사항을 알 수 있도록 해야 한다.",
      "guideContext": "작업자 정보 제공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-012",
      "text": "가공전선 근처에 있는 사람들(어부, 도보자, 캠핑하는 사람 등)을 위해 표지판으로 위험을 알려야 한다.",
      "guideContext": "작업자 정보 제공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-013",
      "text": "가공전선 근처에서 작업해야 한다면 접근을 제한하기 위한 방책과 골대를 사용해야 한다.",
      "guideContext": "접근 제한",
      "additionalDetail": "특정한 높이의 기계만이 방책 아래로 지나갈 수 있도록 해야 한다.",
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-014",
      "text": "전주는 등주가드(Climbing guard)를 갖추어야 하고, 만약 없다면 전력회사에 연락하여 조언을 구해야 한다.",
      "guideContext": "접근 제한 (법령 근거 미확인)",
      "additionalDetail": "가공전선을 지지하는 전주를 점검하고 특이사항은 전력회사에 보고한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-015",
      "text": "지상 방책은 쉽게 이동시킬 수 없도록 견고하게 설치해야 한다.",
      "guideContext": "방책과 골대 설치",
      "additionalDetail": "기둥과 울타리, 양단을 접지한 고장력 철사, 대형 강철 드럼통, 최소 1m 높이의 토양 제방, 목재 장애물 등을 사용한다.",
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-016",
      "text": "지상에 설치되는 방책은 쉽게 보여야 한다. 만약 강철 드럼통이 사용된다면, 빨간색과 흰색의 수평 줄무늬로 페인트칠하거나 철조망에 빨간색과 흰색이 교대로 엇갈린 풋말을 사용한다.",
      "guideContext": "방책과 골대 가시성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-017",
      "text": "방책은 밤에 잘 보여야 한다. 예를 들어, 흰색 또는 형광색 페인트칠을 하거나 반사테이프 등을 붙인다.",
      "guideContext": "방책과 골대 야간 가시성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-018",
      "text": "골대는 목재 또는 플라스틱 파이프와 같은 전기가 통하지 않는 딱딱한 재료로 만들어야 한다.",
      "guideContext": "방책과 골대 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-019",
      "text": "운전자들이 보기 쉽도록 골대 위에 경고 표지판을 설치해야 한다. 골대의 가로대 높이를 알려주고 운전자에게 기계를 낮게 유지하도록 지시해야 한다.",
      "guideContext": "방책과 골대 설치",
      "additionalDetail": null,
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-020",
      "text": "농기계가 가공전선 아래로 곧바로 지나가지 못한다면 전선과 지상 방책 사이의 최소 이격 거리는 6 m 이어야 한다. 이러한 이격 거리는 항상 가공전선이 지나가는 지상의 선으로부터 지면을 따라 수평으로 측정되어야 한다.",
      "guideContext": "방책과 골대 이격거리",
      "additionalDetail": null,
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-021",
      "text": "가공전선 아래에서 파이프를 놓는 등의 특별한 작업을 할 경우에는 방책과 골대를 세워야 하고 추가적인 안전대책을 세워야 한다.",
      "guideContext": "방책과 골대 설치",
      "additionalDetail": null,
      "workProcessPhase": "방책 및 골대 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-022",
      "text": "가공전선을 피하기 위해 작업장소에서의 접근 방법을 계획한다.",
      "guideContext": "농기계 통제",
      "additionalDetail": null,
      "workProcessPhase": "농기계 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-023",
      "text": "농기계의 모든 부분이 최대로 확장되었을 때 장비와 농기계의 전체 높이를 알아야 한다. 특히 전체 높이가 위험지역을 알 수 있도록 농장 지도에 표시된 전선 안전이격거리를 위배하는지 점검해야 한다.",
      "guideContext": "농기계 통제",
      "additionalDetail": null,
      "workProcessPhase": "농기계 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-024",
      "text": "안전작업과 잠재적 위험성에 대하여 작업자에게 주지시켜야 한다.",
      "guideContext": "농기계 통제",
      "additionalDetail": null,
      "workProcessPhase": "농기계 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-025",
      "text": "무전기의 안테나는 짧게 한다. 가공전선의 위치에 대한 지도를 점검하고 가공전선 아래로의 운전을 피해야 한다.",
      "guideContext": "무전기 위험성 통제 (법령 근거 미확인)",
      "additionalDetail": "안테나는 가공전선과 접촉할 수 있을 만큼 운전대로부터 높게 확장될 수 있다.",
      "workProcessPhase": "농기계 운용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-026",
      "text": "물분사기는 가공전선 바로 밑으로 이동하지 않고, 가공전선과 떨어져 평행으로 이동해야 한다.",
      "guideContext": "물분사기 위험성 통제",
      "additionalDetail": "물 분사에 의한 물줄기로 전기가 흐르고 회로가 구성되어 장비에 전기를 통하게 한다.",
      "workProcessPhase": "물분사기 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-027",
      "text": "기계의 전체 높이를 점검하여 4 m가 넘는다면, 조작자가 가공전선과 접촉하지 않도록 이동방법을 계획하고 표식기둥(Marker post)과 골대를 사용한다.",
      "guideContext": "물분사기 위험성 통제",
      "additionalDetail": null,
      "workProcessPhase": "물분사기 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-028",
      "text": "붐의 끝단에서 가장 인접한 전력선까지 지면 수평거리는 최소 15 m 안전간격을 유지해야 한다. 만약 기계들이 가공전선 근처에서 사용된다면 전력회사와 동작절차, 경로 등의 안전조치를 강구해야 한다.",
      "guideContext": "긴 붐을 가진 관개차 통제",
      "additionalDetail": null,
      "workProcessPhase": "관개차 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-029",
      "text": "접근방법은 농장 지도에 표시되어야 하고, 차고로부터 현장까지 정지된 붐을 이동하기 위한 경로와 관개수로 경로를 모두 포함해야 한다.",
      "guideContext": "긴 붐을 가진 관개차 통제",
      "additionalDetail": null,
      "workProcessPhase": "관개차 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-030",
      "text": "기계가 이동되거나 사용될 때 면밀한 관측과 통제하에서 유지되어야 한다. 붐은 나일론 또는 폴리프로필렌 제어 로프가 있어야 한다.",
      "guideContext": "긴 붐을 가진 관개차 통제",
      "additionalDetail": null,
      "workProcessPhase": "관개차 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-031",
      "text": "붐이 현장에서 조립되거나 해체되는 경우 15 m 안전간격 밖에서 실시되어야 한다.",
      "guideContext": "긴 붐을 가진 관개차 통제",
      "additionalDetail": null,
      "workProcessPhase": "관개차 운용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-032",
      "text": "가파른 계곡을 가로지르는 울타리 설치는 가공전선 보다 높은 곳에서 작업해야 한다.",
      "guideContext": "울타리 설치 위험성 통제 (법령 근거 미확인)",
      "additionalDetail": "울타리 설치시 철사가 가공전선에 가깝거나 아래에 부설되면 위로 튀어오를 수 있고 전선에 접촉하여 전기가 흐르는 회로를 구성하는 위험성이 있다.",
      "workProcessPhase": "울타리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-033",
      "text": "사다리를 이동하기 전에 사다리의 길이를 항상 가장 짧게 줄여야 한다. 항상 수평으로 사다리를 이동시키고, 지면과 가깝게 해야 한다.",
      "guideContext": "사다리 위험성 통제 (법령 근거 미확인)",
      "additionalDetail": "사다리가 확장되면 가공전선에 접촉할 우려가 있으며, 사다리를 운반하는 사람은 치명적인 감전을 받을 수 있다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-034",
      "text": "가공전선 근처에는 사다리를 두지 않아야 한다.",
      "guideContext": "사다리 위험성 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-035",
      "text": "임시 적치물 또는 더미를 쌓기 전에 가공전선의 위치에 대해 생각하고 적치물이 가공전선으로부터 멀리 있도록 계획해야 한다. 농기계가 가공전선 아래로 이동해야 되는 장소에는 더미 또는 임시 적치물을 위치시켜서는 안 된다.",
      "guideContext": "임시 적치물 통제",
      "additionalDetail": "임시 적치물은 전선과 지면 사이에 안전이격거리를 줄이기 때문에 가공전선과 가깝거나 아래에 위치해서는 안 된다.",
      "workProcessPhase": "적치물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-036",
      "text": "더미와 리프팅 장비 및 취급장비를 유지하기 위해서는 가공전선으로부터 최소 9 m의 수평거리를 확인해야 한다.",
      "guideContext": "임시 적치물 통제",
      "additionalDetail": null,
      "workProcessPhase": "적치물 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "CI-E65-037",
      "text": "케이블이 떨어질 위험이 있을 때에는 강풍 또는 폭풍우 후에 모든 가공전선의 경로를 점검해야 한다.",
      "guideContext": "느슨한 케이블 통제 (법령 근거 미확인)",
      "additionalDetail": "손상된 케이블과 파손된 도체는 사람과 가축에게 감전의 위험이 있다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-038",
      "text": "늘어졌거나 바닥에 끌리는 전선에 절대로 접근하지 않아야 한다. 모든 차의 운전석에 전력회사의 전화번호를 저장하고, 모든 작업자와 도급자는 그 전화번호가 무엇인지 확실히 알고 있어야 한다.",
      "guideContext": "느슨한 케이블 통제 (법령 근거 미확인)",
      "additionalDetail": "늘어진 케이블은 나무나 산울타리 등 발견하기 어려운 곳에 있어 우발적인 접촉의 위험이 있다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E65-039",
      "text": "전력회사와 연락하여 통전상태인지를 확인해야 한다. 전기가 통하지 않는다는 것을 확인할 때까지 항상 케이블은 전기가 통한다고 생각해야 한다.",
      "guideContext": "느슨한 케이블 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E65-001",
      "term": "안전이격거리",
      "definition": "가공전선로에 접근하여 작업하는 경우 작업자 또는 작업자가 접촉할 수 있는 충전부와의 안전한 이격거리를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "DT-E65-002",
      "term": "가공전선",
      "definition": "가설된 전선뿐만 아니라 전선을 지지하는 철탑, 전주 등으로 하여 공중에 가설한 전선을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E65-003",
      "term": "골대",
      "definition": "가공전선로 아래 안전한 출입을 위하여 설치한 나무 및 금속으로 된 기둥 및 말뚝을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E65-01",
      "processOrder": 1,
      "processName": "위험성평가 및 작업 계획",
      "safetyMeasures": "가공전선의 위험성 유무, 영향 받을 수 있는 사람, 위험성 제거 방법 등을 고려하여 위험성평가를 실시한다. 농장 지도에 가공전선 전압과 경로를 표시하고, 모든 장비의 수직 도달거리와 최대 높이를 파악하며, 위험성이 높은 지역을 피할 수 있도록 작업을 계획한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-E65-02",
      "processOrder": 2,
      "processName": "방책과 골대 설치",
      "safetyMeasures": "지상 방책은 쉽게 이동시킬 수 없도록 견고하게 설치한다. 방책은 주야간 모두 잘 보이도록 빨간색·흰색 줄무늬 또는 형광색 페인트, 반사테이프를 적용한다. 골대는 비전도성 재료(목재, 플라스틱 파이프)로 제작하고 경고 표지판을 설치한다. 가공전선과 방책 사이 최소 6m 이격거리를 확보한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "WP-E65-03",
      "processOrder": 3,
      "processName": "농기계 안전 운용",
      "safetyMeasures": "가공전선을 피하기 위해 접근 방법을 사전 계획한다. 농기계의 모든 부분이 최대 확장 시 전체 높이를 파악하고, 안전이격거리 위배 여부를 점검한다. 무전기 안테나는 짧게 유지하고, 가공전선 아래 운전을 피한다. 물분사기는 가공전선과 떨어져 평행으로 이동한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "WP-E65-04",
      "processOrder": 4,
      "processName": "관개차 붐 작업",
      "safetyMeasures": "붐 끝단에서 가장 인접한 전력선까지 지면 수평거리 최소 15m 안전간격을 유지한다. 붐 조립·해체는 15m 안전간격 밖에서 실시한다. 이동 경로는 농장 지도에 표시하고, 기계 이동·사용 시 면밀한 관측과 통제하에 유지한다. 붐에 나일론 또는 폴리프로필렌 제어 로프를 설치한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "WP-E65-05",
      "processOrder": 5,
      "processName": "임시 적치물 관리",
      "safetyMeasures": "적치물이 가공전선으로부터 멀리 있도록 사전 계획한다. 농기계가 가공전선 아래로 이동해야 되는 장소에는 더미 또는 임시 적치물을 위치시키지 않는다. 더미와 리프팅 장비는 가공전선으로부터 최소 9m 수평거리를 확보한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": [
        "SR-ELECTRIC-022"
      ]
    },
    {
      "identifier": "WP-E65-06",
      "processOrder": 6,
      "processName": "느슨한 케이블 점검 및 비상 대응",
      "safetyMeasures": "강풍 또는 폭풍우 후에 모든 가공전선 경로를 점검한다. 늘어졌거나 바닥에 끌리는 전선에 절대로 접근하지 않는다. 전력회사와 연락하여 통전상태를 확인하고, 전기가 통하지 않는다는 것을 확인할 때까지 항상 케이블은 통전 상태로 간주한다. 모든 차의 운전석에 전력회사 전화번호를 저장한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
