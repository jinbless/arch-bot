  "checklistItems": [
    {
      "identifier": "CI-T17-001",
      "text": "랫드와 마우스 이외의 종을 사용하는 경우 그 과학적 타당성이 보고서에 제시되어야 한다.",
      "guideContext": "포유류 골수세포 염색체이상시험 동물종 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-002",
      "text": "의도적으로 규정된 목적을 위한 자료의 생성을 위한 혼합물의 시험 가이드라인을 사용하기 전에, 그것이 그 목적을 위해 적절한 결과를 제공할 있는지, 그렇다면 그 이유에 대해 고려하여야 한다.",
      "guideContext": "혼합물 시험 적용 전 적절성 검토 (법령 근거 미확인)",
      "additionalDetail": "혼합물의 시험이 규정으로 필요한 경우에는 해당하지 않는다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-003",
      "text": "설치류 이외의 종들이 사용되는 경우, 골수 염색체 이상의 측정이 다른 적절한 독성시험으로 통합하는 것이 추천된다.",
      "guideContext": "포유류 골수세포 염색체이상시험 동물종 선택",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-036",
      "text": "실험동물은 적절한 노출 경로로 시험물질에 노출하여야 하고 처리 이후 적절한 시간에 인도적 희생하여야 한다.",
      "guideContext": "포유류 골수세포 염색체이상시험 (법령 근거 미확인)",
      "additionalDetail": "인도적 희생에 앞서 실험동물은 중기-고정제(예: 콜히친 또는 콜세미드)로 처리한다.",
      "workProcessPhase": "시험의 원리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-037",
      "text": "시험기관은 <표 1>에 나열한 양성대조물질들 중 최소 2종 이상에 대해 적합한 매개물질(Vehicle)/대조용매와 함께 숙련도시험을 하여 염색체이상 빈도의 보고자료(4.2.1)로부터 기대되는 결과들을 재현할 수 있는 능력을 입증해야만 한다.",
      "guideContext": "실험 숙련도 조사 (법령 근거 미확인)",
      "additionalDetail": "재현성 및 용량반응 증가를 가지며 민감도와 관심 조직(골수)에서 시험계의 역동적 범위를 가지는 용량을 사용해야 한다.",
      "workProcessPhase": "실험 숙련도 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-038",
      "text": "실험실에서 수용할 수 있는 채점방법을 사용해야 한다.",
      "guideContext": "실험 숙련도 조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실험 숙련도 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-039",
      "text": "숙련도 조사의 과정 중에 실험실은 과거 양성대조(Historical positive control) 범위와 분포, 그리고 과거 음성대조(Historical negative control) 범위와 분포를 확립해야 한다.",
      "guideContext": "과거 대조군 자료 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "과거 대조군 자료 확립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-040",
      "text": "과거 음성대조 분포 자료가 처음 수집된 동시에 음성 대조자료들도 그것이 존재하는 곳에서 보고된 대조 자료들과 일치해야 한다.",
      "guideContext": "과거 대조군 자료 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "과거 대조군 자료 확립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-041",
      "text": "실험실의 과거 음성대조 데이터베이스는 그 실험실이 음성 대조자료들의 분포를 평가하기 위한 그 실험실의 능력을 보장하기 위해 통계적으로 견고해야 한다.",
      "guideContext": "과거 대조군 자료 (법령 근거 미확인)",
      "additionalDetail": "최소 10개의 실험이 필수적이지만 적어도 20개의 비교 실험조건에서 수행된 실험으로 구성되는 것이 바람직하다.",
      "workProcessPhase": "과거 대조군 자료 확립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-042",
      "text": "실험실은 그 자료들이 얼마나 변이를 갖는지 확인하고 그 실험실에서 그 방법이 통제중임을 보이기 위해 대조 차트(예 : C-차트 또는 X-막대 차트(4.2.3))와 같은 품질관리 방법을 사용해야 한다.",
      "guideContext": "과거 대조군 자료 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "과거 대조군 자료 확립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-043",
      "text": "실험 프로토콜의 어떤 변화들도 그 실험실에 현존하는 과거 대조 데이터베이스와 일관성이 유지되는 결과 자료들에 미치는 영향의 관점에서 고려하여야 한다.",
      "guideContext": "과거 대조군 자료 (법령 근거 미확인)",
      "additionalDetail": "주요 불일치들은 전문가 판단으로 이전의 분포와 다르다고 결정하는 새로운 과거 대조군 자료의 구축으로 이어져야 한다.",
      "workProcessPhase": "과거 대조군 자료 확립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-044",
      "text": "음성대조 자료들은 각 실험동물의 구조적 염색체이상(갭 제외)의 발생으로 구성하여야 한다.",
      "guideContext": "과거 대조군 자료 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "과거 대조군 자료 확립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-045",
      "text": "동시적인 음성대조군들은 실험실의 과거 음성대조 데이터베이스 분포의 95% 대조 범위 내에서 이상적으로 제어되어야 한다.",
      "guideContext": "과거 대조군 자료 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "과거 대조군 자료 확립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-046",
      "text": "실험에 일반적으로 사용되는 건강한 젊은 성체 실험동물 계통을 사용해야 한다.",
      "guideContext": "동물 종의 선택 (법령 근거 미확인)",
      "additionalDetail": "마우스도 적합할 수 있지만, 랫드가 일반적으로 사용된다.",
      "workProcessPhase": "동물 종 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-047",
      "text": "설치류의 경우, 동물실의 온도는 22℃(±3℃)이어야 한다.",
      "guideContext": "동물 사육과 식이 조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 사육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-048",
      "text": "동물실 청소 중 이외에는 상대습도가 70%를 초과하지 않아야 한다.",
      "guideContext": "동물 사육과 식이 조건 (법령 근거 미확인)",
      "additionalDetail": "이상적인 상대습도는 50~60%이어야 한다.",
      "workProcessPhase": "동물 사육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-049",
      "text": "조명은 12시간 점등 12시간 소등되는 인공조명이어야 한다.",
      "guideContext": "동물 사육과 식이 조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 사육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-050",
      "text": "공격적인 행동이 예상되지 않으면 설치류는 같은 성별 및 처리군의 소그룹들(케이지 당 다섯 마리 이하)로 사육하여야 한다.",
      "guideContext": "동물 사육과 식이 조건 (법령 근거 미확인)",
      "additionalDetail": "환경적으로 풍족한 단단한 바닥 케이지에서 사육되는 것이 바람직하다.",
      "workProcessPhase": "동물 사육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-051",
      "text": "실험동물들은 과학적으로 정당화된 경우에만 개별적으로 수용할 수 있다.",
      "guideContext": "동물 사육과 식이 조건",
      "additionalDetail": null,
      "workProcessPhase": "동물 사육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-052",
      "text": "각각의 동물들은 인도적인 최소한의 침습적 방법(예 : 벤소리, 꼬리표, 마이크로-칩 또는 생체인식 가능, 귀 또는 발가락 천공은 불가)을 사용하여 고유 식별이 되고 적어도 5일 동안 실험조건에 적응시킨다.",
      "guideContext": "동물의 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-053",
      "text": "케이지는 위치에 가능한 영향을 최소화하는 방식으로 배열하여야 한다.",
      "guideContext": "동물의 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-054",
      "text": "양성대조군과 시험물질에 의한 교차오염을 피해야 한다.",
      "guideContext": "동물의 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-055",
      "text": "연구의 시작 시 동물들의 체중 변이는 최소화하여야 하고 각 성별 체중의 ±20%를 넘지 않아야 한다.",
      "guideContext": "동물의 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-056",
      "text": "고체 시험물질은 실험동물에 투여하기 전에 적절한 용매 또는 매개물질에 용해 또는 현탁하거나 먹이나 음용수에 혼합해야한다.",
      "guideContext": "용량의 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-057",
      "text": "신선한 시험물질의 안정성 자료 확보와 적절한 저장조건을 확보하는 신선한 조제가 이루어져야 한다.",
      "guideContext": "용량의 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-058",
      "text": "용매/매개물질은 사용되는 용량수준에서 독성효과를 일으키지 않아야 하고, 시험물질과의 화학반응이 의심되지 않아야 한다.",
      "guideContext": "용매/매개물질 (법령 근거 미확인)",
      "additionalDetail": "만약 알려진 용매/매개물질을 사용하지 않는 경우는 이들의 호환성을 나타내는 참고 자료들을 지원하여야 한다.",
      "workProcessPhase": "용량 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-059",
      "text": "가능한 경우는 언제나 액상 용매/매개물질의 사용을 먼저 고려할 것을 권장한다.",
      "guideContext": "용매/매개물질",
      "additionalDetail": "일반적으로 사용되는 호환 용매/매개물질의 예로는 물, 생리식염수, 메틸셀룰로스 용액, 카르복시메틸 셀룰로오스 나트륨염 용액, 올리브오일 및 옥수수유를 포함한다.",
      "workProcessPhase": "용량 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-060",
      "text": "과거 또는 보고된 대조군 자료들이 없는 것은 구조적 이상이 없거나 선택된 비정형 용매/매개물질로 인해 유해효과가 유도되었음을 나타내고, 초기시험은 용매/매개물질의 수용을 확립하기 위해 수행하여야 한다.",
      "guideContext": "용매/매개물질 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-061",
      "text": "양성대조물질로 처리된 동물군은 일반적으로 각 시험에 포함하여야 한다.",
      "guideContext": "양성대조군 (법령 근거 미확인)",
      "additionalDetail": "시험 수행의 숙련도를 입증하고 경험적 양성대조 범위를 설정한 경우에는 면제될 수 있다.",
      "workProcessPhase": "대조군 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-062",
      "text": "양성대조물질의 경우 구조적 염색체이상을 갖는 세포의 빈도로 증가가 확실히 관찰되어야 한다.",
      "guideContext": "양성대조군 (법령 근거 미확인)",
      "additionalDetail": "양성대조 용량은 그 영향이 확실하지만 코드화된 시료들을 계수기에서 즉시 확인할 수 없도록 선택하여야 한다.",
      "workProcessPhase": "대조군 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-063",
      "text": "적절한 경우 화학물질 부류-관련 양성대조물질의 사용을 고려하여야 한다.",
      "guideContext": "양성대조군 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "대조군 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-064",
      "text": "음성대조군 동물은 시험물질의 처리를 받지 않는 경우를 제외하고는 매 시료채취 시간마다 포함하여야 하고 그렇지 않으면 처리 군과 같은 방법으로 다루어야 한다.",
      "guideContext": "음성대조군 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "대조군 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-065",
      "text": "만일 용매/매개물질이 시험물질의 처리에 사용되면 그 대조군은 이 용매/매개물질을 받아야 한다.",
      "guideContext": "음성대조군 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "대조군 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-066",
      "text": "시험개시 시의 군 크기는 한 가지 성에서, 만약 군당 두 가지 성 모두 사용된다면 각 성별 최소한 다섯 마리의 분석 가능한 동물을 제공하는 것을 목표로 확립하여야 한다.",
      "guideContext": "동물의 수와 성별 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-067",
      "text": "예비 범위-규명 연구가 수행된 경우, 같은 실험실에서 같은 종, 계통, 성별을 가지고 수행하여야 하고 본시험에 사용되는 처리요법도 같아야 한다.",
      "guideContext": "용량 수준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.9",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-068",
      "text": "용량 반응 정보를 얻기 위해 완전한 시험은 음성대조군과 일반적으로 2의 인자에 의하지만 4보다는 크지 않은 최소 3개 용량 수준을 포함해야 한다.",
      "guideContext": "용량 수준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.9",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-069",
      "text": "만일 시험물질이 기존의 자료들에 범위-결정 시험에서 독성을 나타내지 않거나 기존 자료들에 의존하는 경우, 단일 투여의 가장 높은 용량은 체중 kg당 2,000 ㎎이어야 한다.",
      "guideContext": "용량 수준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4.9",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-070",
      "text": "표적 조직(골수) 독성이 모든 시험의 용량 수준에서 관찰되는 경우 비독성 용량에서의 추가시험이 권장된다.",
      "guideContext": "용량 수준",
      "additionalDetail": null,
      "workProcessPhase": "용량 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.9",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-071",
      "text": "14일 이상의 투여기간 중에 제한 용량은 매일 체중 kg당 1,000 ㎎이다.",
      "guideContext": "제한 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4.10",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-072",
      "text": "14일 투여기간 중에 제한 용량은 매일 체중 kg당 2,000 ㎎이다.",
      "guideContext": "제한 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4.10",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-073",
      "text": "사람에서 예상되는 경로는 시험법을 설계할 때 고려하여야 한다.",
      "guideContext": "용량 투여 (법령 근거 미확인)",
      "additionalDetail": "급식, 음수, 국소 피하, 정맥, 경구(위관), 흡입, 기관내 또는 주입법과 같은 노출경로를 선택할 수 있다.",
      "workProcessPhase": "용량 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.11",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-074",
      "text": "노출경로는 표적 조직의 적절한 노출을 보장하기 위해 선택해야 한다.",
      "guideContext": "용량 투여 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.11",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-075",
      "text": "복강 내 주사는 일반적으로 사람 노출의 경로가 아니므로 권장되지 않고, 특정 과학적 정당성과 함께 사용해야만 한다.",
      "guideContext": "용량 투여 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.11",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-076",
      "text": "위관 또는 주사로 한 번에 투여될 수 있는 액체의 최대 부피는 실험동물의 크기에 의존하며, 그 부피는 최대 체중 g당 2 ㎖가 사용될 수 있는 수용액인 경우를 제외하고는 통상 체중 100 g당 1 ml를 초과하지 않아야 한다.",
      "guideContext": "용량 투여 (법령 근거 미확인)",
      "additionalDetail": "이보다 큰 부피의 사용은 정당성이 있어야 한다.",
      "workProcessPhase": "용량 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4.11",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-077",
      "text": "시험 부피의 가변성은 모든 용량수준에서 체중과 관련된 일정부피의 투여를 보장하기 위해 농도를 조정함으로써 최소화해야 한다.",
      "guideContext": "용량 투여 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.11",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-078",
      "text": "골수 시료는 단일 처리 이후 두 개의 분리된 시간에 취해야 한다.",
      "guideContext": "처리 일정 (법령 근거 미확인)",
      "additionalDetail": "설치류의 경우 첫 번째 시료채취 간격은 1.5 정상 세포주기 시간(일반적으로 처리기간 이후 12~18시간)을 완료하는데 필요한 시간이어야 한다.",
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.12",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-079",
      "text": "첫 시료채취 시점에서 모든 용량군을 처리해야 하고 시료를 분석을 위해 수집되지만, 이후 시료채취 시간에서 단지 최고 용량만 투여할 필요가 있다.",
      "guideContext": "처리 일정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.12",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-080",
      "text": "처리 이후 및 시료 수집 전에, 실험동물들은 적절한 용량의 중기-고정제(예 : 콜세미드® 또는 콜히친)의 적당한 용량으로 복강 내 주입되고, 시료는 이후 적절한 간격으로 수집한다.",
      "guideContext": "처리 일정 (법령 근거 미확인)",
      "additionalDetail": "마우스의 경우 수집 전 대략 3~5시간, 랫드에서는 2~5시간이다.",
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.12",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-081",
      "text": "실험동물의 일반적 임상관찰이 이루어져야 하고 임상 증상은 적어도 하루에 한 번 기록하여야 하며, 매일 같은 시간이 바람직하고 투여 후 예상 효과의 최대 기간을 고려하여야 한다.",
      "guideContext": "관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-082",
      "text": "투여 기간 동안 적어도 하루에 두 번은 모든 실험동물들의 이환율과 사망률이 관찰되어야 한다.",
      "guideContext": "관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-083",
      "text": "모든 실험동물들은 시험 개시 시, 반복-투여 시간 동안에는 적어도 1주일에 한 번 및 인도적 희생 시에 계체해야 한다.",
      "guideContext": "관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-084",
      "text": "적어도 1주일간 지속되는 시험에서는 사료섭취량의 계측은 적어도 1주 단위로 시행하여야 한다.",
      "guideContext": "관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-085",
      "text": "만약 시험물질이 식수를 통해 투여되면 물 섭취량은 매 물을 갈아줄 때 및 적어도 1주일에 한 번은 계측하여야 한다.",
      "guideContext": "관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-086",
      "text": "과도한 독성의 비-치사 징후를 보이는 실험동물들은 시험기간이 종료되기 전에 인도적으로 희생시켜야 한다.",
      "guideContext": "관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-087",
      "text": "혈액 시료는 보증 및 기타 노출 자료들이 존재하지 않는 경우 시험물질이 골수에 노출되었음을 증명하기 위해 시험물질의 혈장에서 시험물질을 검출하기에 적절한 시간에 채취하여야 한다.",
      "guideContext": "표적 조직 노출 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "표적 조직 노출 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.14",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-088",
      "text": "인도적 희생 이후 즉시 골수 세포들은 실험동물의 대퇴골 또는 경골에서 채취되고 저장성 용액에 노출하여 고정시킨다.",
      "guideContext": "골수 및 염색체 표본 제작 (법령 근거 미확인)",
      "additionalDetail": "중기 세포들은 이후 슬라이드에 도포하고 확립된 방법을 이용하여 염색한다.",
      "workProcessPhase": "골수 및 염색체 표본 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.15",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-089",
      "text": "양성 및 음성대조군을 포함하는 모든 슬라이드들은 분석 이전에 독립적으로 코딩해야 하고 처리 조건을 인식하지 못하도록 무작위적으로 접수한다.",
      "guideContext": "분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.16",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-090",
      "text": "유사분열지수는 모든 처리 동물들(양성대조군 포함), 미처리 또는 매개물질/용매 음성대조 동물들에서 적어도 실험동물 당 1,000개의 세포들에서 세포독성을 측정함으로써 결정하여야 한다.",
      "guideContext": "분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.16",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-091",
      "text": "적어도 200개의 중기세포들은 각 실험동물에서 갭(gap)을 포함 및 제외하는 구조적 염색체이상이 분석하여야 한다.",
      "guideContext": "분석 (법령 근거 미확인)",
      "additionalDetail": "실험실의 과거 음성대조 데이터베이스가 평균 배경 구조 염색체이상 빈도가 1% 미만으로 나타난 경우는 추가 세포의 계수에 주의해야 한다.",
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.16",
      "basedOn": null
    },
    {
      "identifier": "CI-T17-092",
      "text": "염색분체 및 염색체-형 이상은 별도로 기록되고 하위 유형(분절, 교환)을 분류하여야 한다.",
      "guideContext": "분석 (법령 근거 미확인)",
