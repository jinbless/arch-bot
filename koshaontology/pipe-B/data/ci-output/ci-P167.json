  "checklistItems": [
    {
      "identifier": "CI-P167-001",
      "text": "안전한 출입로가 있는 장소에서 화학물질은 취급하고 시료를 채취하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 취급 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-002",
      "text": "적당한 조명과 통풍 시설을 갖춘 안전한 곳에서 작업하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 취급 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-P167-003",
      "text": "화학물질을 취급하거나 시료를 채취(이하 \"화학물질 취급\"이라 한다.)하는 곳에는 물질안전보건자료를 비치하고, 주요한 내용을 현장에 게시하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 취급 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P167-004",
      "text": "운반 중에 떨어지거나 운반설비나 다른 설비들에 의한 손상을 방지할 수 있는 예방조치를 하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-005",
      "text": "유체의 시료 채취는 밸브를 통해 흘러나오는 유체의 양과 유속을 조절할 수 있어야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-006",
      "text": "액체 시료의 경우에는 액체가 유출될 수 있음을 가정하여 유출된 액체를 받을 수 있도록 사전에 준비하고 작업하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-007",
      "text": "액체와 기체 시료채취작업은 사고예방을 위하여 가능한 멀리 떨어진 안전한 곳에서 밸브를 조절하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-008",
      "text": "화학물질 취급작업은 시료채취 용기를 세척할 때는 세척 시 쓰이는 물질을 버릴 수 있는 알맞은 장소가 제공되어야 하며, 가스인 경우 시료 채취 및 그 주변 작업자들의 작업장은 환기가 잘 되어야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-P167-009",
      "text": "시료의 용기는 시료 용기가 깨짐으로써 발생될 위험을 줄이기 위해 최적의 상태에서 운반하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-010",
      "text": "시료의 물리·화학적 성질과 화재, 폭발, 독성유무 등에 따른 고유의 잠재 위험성을 사전에 파악하여 안전대책 수립하고, 안전교육을 하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항",
      "additionalDetail": "예를 들어 벤젠은 발암성 물질이며, 공기 중에 누출되면 화재, 폭발의 위험이 있고, 어는점이 5.5 ℃로 겨울철에는 유리병이 깨질 수 있다.",
      "workProcessPhase": "화학물질 취급 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P167-011",
      "text": "작업자는 작업 전에 관리감독자에게 사전에 작업내용을 보고하고, 안전작업허가를 받아야 하고, 이상이 발생되면 즉시 관리감독자에게 그 사실을 보고하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 취급 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-012",
      "text": "필요한 이상으로 너무 크거나, 필요한 양 이상의 정도로 취급하여서는 안 된다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-013",
      "text": "작업자는 위험한 물질의 특성을 완전히 파악하고 있어야 하며, 작업자는 안전을 위하여 누출시 안전하게 회수할 수 있는 준비, 적절한 소화기 비치, 보호구 착용 등의 사전 안전조치를 하고 작업을 하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 취급 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P167-014",
      "text": "도구와 용기를 포함한 장비는 시료 채취 및 물질 운반 등에 적합해야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": "예를 들어, 시료 용기는 단단히 조여지고 압력 변화에도 견딜 수 있어야 한다.",
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-015",
      "text": "시료는 다른 화학물질들과의 화학반응을 막기 위해 다른 화학물질과 가까이 두어서는 안 된다.",
      "guideContext": "화학물질 취급 및 시료채취 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-016",
      "text": "시료채취작업은 안전작업을 위하여 가능한 한 2인 1조로 시료를 채취하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-017",
      "text": "작업자는 응급상황 발생 시 우선 경고음을 올려야 하며 극한 상황이 아닐 경우 단독으로 모든 응급처리를 하고자 해서는 안 된다.",
      "guideContext": "화학물질 취급 및 시료채취 작업",
      "additionalDetail": null,
      "workProcessPhase": "비상 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P167-018",
      "text": "심한 눈 손상성/눈 자극성 물질을 취급하는 모든 장소에서는 눈을 보호하는 보안경 등을 항상 착용하고 있어야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 작업",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-019",
      "text": "작업자는 안전작업수칙과 행동요령을 숙지하고 있어야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 작업",
      "additionalDetail": null,
      "workProcessPhase": "화학물질 취급 사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P167-020",
      "text": "독성을 가지거나 위험한 물질을 시료로 취하려 할 때에는 안전작업을 감독하는 작업자 역시 시료를 취급하는 작업자와 마찬가지로 각 상황에서 해야 하는 행동에 대해서 숙지하고 있어야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 작업",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P167-021",
      "text": "만약 독성물질을 채취할 경우 작업자는 안전작업허가 내용을 잘 파악하고 있어야 하며, 조금이라도 이상한 경우 관리감독자에게 즉시 보고하여야 한다.",
      "guideContext": "화학물질 취급 및 시료채취 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-022",
      "text": "불안정한 물질은 물이나 알콜 등의 안정된 다른 액체 안에 보관한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-023",
      "text": "용기는 내용물의 손실과 용기 내 탈수를 방지하도록 만들어져야 하되, 용기의 폐쇄는 압력의 변화에 안전하게 이루어지도록 되어야 한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-024",
      "text": "시료는 열이나 충격을 주는 것을 금지하고, 시료의 손상이나 변질을 방지하도록 제작된 운반 수단으로만 시료를 운반해야 한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P167-025",
      "text": "시료를 흘렸을 때는 그 즉시 보고하고, 안전하게 처리하여야 한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-026",
      "text": "빛, 연기 및 스파크를 일으키는 장비에 노출되는 것을 막아야 한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P167-027",
      "text": "보안경과 보호의를 반드시 착용해야 한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-028",
      "text": "경보장치와 방화 장비의 위치를 알고 있어야 한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P167-029",
      "text": "폭발성 물질은 도난을 방지할 수 있도록 별도의 장소에 열쇠를 채워서 보관하여야 한다.",
      "guideContext": "폭발성 및 유기과산화물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폭발성 물질 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-030",
      "text": "산화성 물질, 물, 공기 및 화기와 접촉을 금지하고, 가열, 마찰 및 충격을 금지하여야 한다.",
      "guideContext": "물반응성 물질 및 인화성 고체 취급",
      "additionalDetail": null,
      "workProcessPhase": "물반응성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "CI-P167-031",
      "text": "소량이 누출되면 다량의 물을 뿌려 진화할 수 있으나, 다량이 누출되면 물을 뿌리는 것을 금지하고, 모래 등으로 덮어 공기와 접촉을 차단하고, 주위로 확산을 방지하고, 다 탈 때까지 기다린다.",
      "guideContext": "물반응성 물질 및 인화성 고체 취급",
      "additionalDetail": null,
      "workProcessPhase": "물반응성 물질 누출 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "CI-P167-032",
      "text": "석유 등의 용제 속에 밀봉하여 보관한다.",
      "guideContext": "물반응성 물질 및 인화성 고체 취급",
      "additionalDetail": null,
      "workProcessPhase": "물반응성 물질 보관",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "CI-P167-033",
      "text": "통풍이 잘되는 건조한 실내에서 시료를 채취하여야 한다.",
      "guideContext": "물반응성 물질 및 인화성 고체 취급",
      "additionalDetail": null,
      "workProcessPhase": "물반응성 물질 시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-P167-034",
      "text": "취급하는 장소에서는 화기, 불꽃, 마찰, 충격, 아크 및 고열체 등에 접근되지 않도록 하고, 증발시키거나 가열하지 말아야 한다.",
      "guideContext": "인화성 가스 및 액체 취급",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P167-035",
      "text": "고압의 도시가스, LPG 등의 고압가스 시료는 내압력과 기밀성이 유지되어야 한다.",
      "guideContext": "인화성 가스 및 액체 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-036",
      "text": "화재발생 시에는 소화기 또는 폼 소화제를 사용하여 진화하여야 한다.",
      "guideContext": "인화성 가스 및 액체 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 비상 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-037",
      "text": "시료는 통풍이 잘 되고, 그늘진 곳에 밀봉하여 화기가 없는 장소에 보관한다.",
      "guideContext": "인화성 가스 및 액체 취급",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 보관",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-P167-038",
      "text": "유리 용기는 최대 15 ℓ를 초과할 수 없고, 플라스틱병은 사용할 수 없다.",
      "guideContext": "인화성 가스 및 액체 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-039",
      "text": "시료 채취는 정전기 발생을 최소화하기 위하여 유속은 1 m/s 이하가 되도록 하고, 채취기는 바닥에 가능한 가깝게 하며, 금속용기는 접지하여야 한다. 만약 접지가 어려운 경우에는 채취 후에 20분 이상 정체시켜 축적된 정전기를 완화시켜야 한다.",
      "guideContext": "인화성 가스 및 액체 취급",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P167-040",
      "text": "시료 채취자는 제전복과 제전화를 착용하여야 한다.",
      "guideContext": "인화성 가스 및 액체 취급",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P167-041",
      "text": "액상의 고압시료는 누출시 기화열에 의한 동상의 위험이 있으므로, 보호장갑을 착용하여야 한다.",
      "guideContext": "인화성 가스 및 액체 취급",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-042",
      "text": "폐기물은 별도의 금속용기에 담아 점화원이 없고, 가연성 물질이 없는 곳에 통풍이 잘되고, 직사광선을 피하여, 서늘한 곳에 보관하고, 당일에 적법하게 처리하여야 한다.",
      "guideContext": "인화성 가스 및 액체 취급",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P167-043",
      "text": "다량의 시료를 보관할 때는 폭발위험장소로 구분하고, 안전하게 관리되는 곳에 보관하여야 한다.",
      "guideContext": "인화성 가스 및 액체 취급",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 보관",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-006"
      ]
    },
    {
      "identifier": "CI-P167-044",
      "text": "용기는 보호캡을 씌워서 보관 및 운송하여야 한다.",
      "guideContext": "인화성 가스 및 액체 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-045",
      "text": "수송 열차로부터의 시료채취는 불꽃이 발생할 수 있기 때문에 화재나 폭발로 이어질 수 있는 모든 차량운행이 없는 상태에서만 실시하여야 한다.",
      "guideContext": "인화성 가스 및 액체 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-046",
      "text": "산화성 물질 소화에 적합한 소화장비를 비치하고, 화재시 즉시 사용이 가능하도록 하여야 한다.",
      "guideContext": "산화성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "산화성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-047",
      "text": "산화성 물질을 운반하는 장비는 인화성 또는 가연성 물질 등과 함께 운반하여서는 안 된다.",
      "guideContext": "산화성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "산화성 물질 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-048",
      "text": "시료를 운반하는 장비는 불연성 재질이어야 한다.",
      "guideContext": "산화성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "산화성 물질 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-049",
      "text": "산화성 물질 취급에 적합한 보호구, 보호의 등을 반드시 착용해야 한다.",
      "guideContext": "산화성 물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "산화성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-050",
      "text": "작업장의 산소 농도가 23.5 %를 초과하면 사소한 마찰, 충격 등에 의하여 화재가 발생할 수 있으므로, 환기 또는 통풍이 잘 되는 곳에서 취급하여야 한다.",
      "guideContext": "산화성 물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "산화성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P167-051",
      "text": "작업자는 적절한 보호구를 착용하고, 외부로 누출되지 않도록 가능한 밀폐상태에서 시료채취 위치와 가능한 멀리 떨어진 곳에서 하여야 한다.",
      "guideContext": "경구 및 흡입 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "독성물질 시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P167-052",
      "text": "시료를 취하는 작업을 하는 작업자는 작업자의 안전작업을 감독할 수 있는 사람과 함께 작업을 같이 해야 한다.",
      "guideContext": "경구 및 흡입 독성물질 취급 (법령 근거 미확인)",
      "additionalDetail": "안전작업을 감독하는 작업자는 시료가 있는 근처의 유해위험요인을 확인해야 하고 작업 과정을 지켜보아야 한다.",
      "workProcessPhase": "독성물질 시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-053",
      "text": "채취한 시료 또는 빈 용기는 운반이나 보관 중에 누출되지 않도록 잘 밀봉하여 안전한 곳에 보관하여야 한다.",
      "guideContext": "경구 및 흡입 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "독성물질 보관",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-P167-054",
      "text": "시료가 외부로 유출되거나 분실되었을 경우에는 관리감독자에게 즉시 보고하고, 가능한 빨리 안전하게 회수·처리하여야 한다.",
      "guideContext": "경구 및 흡입 독성물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "독성물질 누출 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-055",
      "text": "용기에 담은 후 작업자는 깨끗이 몸을 씻고, 시료를 다루었던 장비 역시 씻어야 한다.",
      "guideContext": "경구 및 흡입 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "독성물질 시료채취 후 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P167-056",
      "text": "비상조치 시에는 송기마스크, 공기호흡기 등을 착용하여야 하고, 공기정화 용량이 충분하지 않은 대피용 방독마스크를 착용해서는 안 된다.",
      "guideContext": "경구 및 흡입 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "독성물질 비상 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P167-057",
      "text": "독성물질 주위에서 물이나 음식 섭취, 흡연을 금지하여야 한다.",
      "guideContext": "경구 독성물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "독성물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-058",
      "text": "산소결핍 위험이 있는 곳에서 시료채취 작업장은 환기가 잘 되어야 한다.",
      "guideContext": "흡입 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "독성물질 시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-P167-059",
      "text": "접촉에 의해 중독되는 독성물질을 취급할 때는 외부에서 오는 피해를 완전히 막아낼 수 있는 적절하고 충분한 기능이 있는 보호복, 앞치마, 장갑, 장화, 보안면 및 방독마스크를 착용하고 작업해야 한다.",
      "guideContext": "경피 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "경피 독성물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-060",
      "text": "차가운 물과 따뜻한 물이 모두 나오는 세척설비 등이 준비되어 있어야 하며, 시료 채취 전에 제대로 작동하는지 점검해야 한다.",
      "guideContext": "경피 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "경피 독성물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-061",
      "text": "오염된 옷은 오염 즉시 제거해야 한다.",
      "guideContext": "경피 독성물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경피 독성물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-062",
      "text": "시료를 취급하는 작업자는 시료가 있는 근처에서 안전작업을 감독할 수 있는 작업 감독자와 함께 작업을 같이 해야 한다.",
      "guideContext": "경피 독성물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경피 독성물질 시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-063",
      "text": "응급상황 발생 시, 검사하는 작업자는 대처해야 하는 방법을 알고 있어야 하며, 응급상황 발생 즉시 경보 장치를 작동시켜야 한다.",
      "guideContext": "경피 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "경피 독성물질 비상 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P167-064",
      "text": "극단적인 상황이 아니면 혼자서 응급 대처를 하려 하면 안 된다.",
      "guideContext": "경피 독성물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경피 독성물질 비상 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-065",
      "text": "시료가 나오는 밸브는 시료가 주위로 튀거나 흘러 나가게 하지 않도록 조작하여야 한다. 시료는 밸브와 가까이 위치하면 안 되고 천천히 조작하여야 한다.",
      "guideContext": "경피 독성물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "경피 독성물질 시료채취",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-P167-066",
      "text": "접촉에 의한 경피 독성물질에 대한 예방책과 비슷하게 부식성 물질, 자극성 물질의 예방책도 정해져야 한다. 특히, 경피 독성물질과 달리 강조될 점이 있다면 눈을 보호하기 위해 반드시 보안경을 착용해야 한다는 점이다.",
      "guideContext": "부식성 및 자극성 물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "부식성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.7",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-067",
      "text": "부식성 물질 및 자극성 물질 등이 피부에 접촉된 경우에는 흐르는 물로 씻을 수 있도록 시료 작업장 근처에 세안설비, 샤워 시설 등을 갖추어 놓는다.",
      "guideContext": "부식성 및 자극성 물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "부식성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.7",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-068",
      "text": "작업 중에 부식성 및 자극성 물질에 의해 홈이 발생되지 않도록 하여야 하고, 국소배기장치를 설치하고, 작업 중에는 작동시켜야 한다.",
      "guideContext": "부식성 및 자극성 물질 취급",
      "additionalDetail": null,
      "workProcessPhase": "부식성 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.7",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-P167-069",
      "text": "재료가 눈에 튀는 것을 막기 위해서 눈을 보호하는 장비를 착용하여야 한다.",
      "guideContext": "물리적 상태에 따른 위험 물질 - 온도 위험",
      "additionalDetail": null,
      "workProcessPhase": "극한온도 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.8",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P167-070",
      "text": "고온의 물질에 대해서, 그것이 방출하는 고온의 열로부터 얼굴과 목 그리고 눈을 보호할 수 있는 보호구를 착용하여야 한다.",
      "guideContext": "물리적 상태에 따른 위험 물질 - 온도 위험",
      "additionalDetail": null,
      "workProcessPhase": "극한온도 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P167-071",
      "text": "물질을 다루기 이전에 손에 튀어 피해를 입는 것을 방지하기 위해 손을 보호할 수 있는 보호구를 착용하여야 한다.",
      "guideContext": "물리적 상태에 따른 위험 물질 - 온도 위험",
      "additionalDetail": null,
      "workProcessPhase": "극한온도 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P167-072",
      "text": "앞치마를 착용해야 하며 신발을 단단히 매어 물질이 신발 속으로 들어오지 못하도록 하여야 한다.",
      "guideContext": "물리적 상태에 따른 위험 물질 - 온도 위험",
      "additionalDetail": null,
      "workProcessPhase": "극한온도 물질 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P167-073",
      "text": "시료를 다루는 장비는 고압 하에서도 시료의 유출 속도를 안전한 수치로 유지되게 제어할 수 있고, 장비 자체도 유체의 유출에 의해 피해를 입지 않도록 배치되어야 한다.",
      "guideContext": "물리적 상태에 따른 위험 물질 - 압력 위험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고압 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.8",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-074",
      "text": "시료를 담는 용기는 액체로 채워져야 하며, 최고 온도에서 액체의 부피가 전체 부피의 90 % 미만이 되도록 채워져야 한다.",
      "guideContext": "물리적 상태에 따른 위험 물질 - 압력 위험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고압 물질 시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.8",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-075",
      "text": "방사성 물질은 오염 요소에 대처할 수 있고 관련 면허를 가지고 있는 전문적인 사람만이 다루어야 한다.",
      "guideContext": "방사성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.9",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-076",
      "text": "어떠한 환경 하에서도 그 물질에 접근해서는 안 되고, 방사성 물질에 대한 사전 조사가 충분히 이루어질 때까지는 그 물질을 다루어서는 안 된다.",
      "guideContext": "방사성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.9",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-077",
      "text": "적합한 보호구를 착용한다.",
      "guideContext": "방사성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": "방사성 물질 취급 작업 전 안전 필수사항",
      "workProcessPhase": "방사성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.9",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-078",
      "text": "방사성을 측정할 수 있는 장비로 측정한다.",
      "guideContext": "방사성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": "방사성 물질 취급 작업 전 안전 필수사항",
      "workProcessPhase": "방사성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.9",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-079",
      "text": "방사성 물질 앞에서는 흡연 및 음식물 섭취를 금한다.",
      "guideContext": "방사성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.9",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-080",
      "text": "오염 방지를 위해 장갑, 신발 및 옷 등의 방사성을 미리 검사해야 한다.",
      "guideContext": "방사성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사성 물질 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.9",
      "basedOn": null
    },
    {
      "identifier": "CI-P167-081",
      "text": "오염의 확산을 방지하기 위해서 관리감독자는 오염원이 유출되었을 때 관련기관에 즉시 보고해야 한다.",
      "guideContext": "방사성 물질 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사성 물질 비상 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.9",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P167-001",
      "term": "화학물질",
      "definition": "원소 및 원소간의 화학반응에 의하여 생성된 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-002",
      "term": "용기",
      "definition": "고체, 액체 또는 기체의 화학물질 또는 화학물질을 함유한 제제를 직접 담은 강제, 플라스틱, 저장탱크, 유리, 비닐포대, 종이포대 등으로 된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-003",
      "term": "시료",
      "definition": "대상제품에서 채취한 하나 또는 그 이상 단위의 추출물로 대상제품에 대한 정보를 제공할 것으로 여겨지고, 그 대상제품에 대해 결정을 내리거나 또는 그 대상제품의 생산과정에 대한 정보를 담고 있는 것으로 판단하는 근거가 되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-004",
      "term": "폭발성 물질",
      "definition": "자체의 화학반응에 의하여 주위 환경에 손상을 줄 수 있는 온도·압력 및 속도를 가진 가스를 발생시키는 고체, 액체 또는 혼합물을 말한다. 다만 화공품은 가스를 발생시키지 않더라도 폭발성 물질에 포함된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-005",
      "term": "산화성 물질",
      "definition": "일반적으로 산소를 발생시켜 다른 물질의 연소를 촉진하거나 연소에 기여하는 산화성 가스, 액체 또는 산화성 고체 등의 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-006",
      "term": "인화성 물질",
      "definition": "쉽게 연소되거나 마찰에 의하여 화재를 일으키거나 연소에 기여할 수 있는 인화성 가스, 인화성 액체 또는 인화성 고체 등 연소할 수 있는 성분을 포함한 물질을 총칭한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-007",
      "term": "부식성 물질",
      "definition": "화학적 작용에 의한 금속 부식, 인체 접촉 등에 의한 피부염, 자극을 일으키는 금속부식성 물질, 피부부식성 물질 및 피부자극성 물질 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-008",
      "term": "독성물질",
      "definition": "섭취, 피부접촉 또는 호흡기를 통하여 유해한 영향을 끼칠 수 있는 급성 독성물질, 호흡기과민성 물질, 흡인유해성 물질, 특정표적장기 독성물질 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-009",
      "term": "방사성물질",
      "definition": "핵연료물질, 사용 후의 핵연료, 방사성동위원소 및 원자핵분열생성물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P167-010",
      "term": "방사선",
      "definition": "전자파나 입자선 중 직접 또는 간접적으로 공기를 전리(電離)하는 능력을 가진 것으로서 알파선, 중양자선, 양자선, 베타선, 그 밖의 중하전입자선, 중성자선, 감마선, 엑스선 및 5만 전자볼트 이상(엑스선 발생장치의 경우에는 5천 전자볼트 이상)의 에너지를 가진 전자선을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
