  "checklistItems": [
    {
      "identifier": "CI-G110-001",
      "text": "작업에 대한 위험성을 평가하고, 안전작업절차에 대해 모든 근로자들이 교육을 받을 수 있도록 해야 한다.",
      "guideContext": "폐지 선별작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-002",
      "text": "개인위생에 대한 중요성을 주지시켜 식사, 음주, 흡연, 화장실 가기 전에 손을 철저하게 세척할 수 있도록 해야 한다.",
      "guideContext": "폐지 선별작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-003",
      "text": "의료용 주사기 등의 감염성 폐기물은 전문 처리 업체에 의해서 안전한 수거가 이루어질 수 있도록 전용 보관함을 제공하여야 한다.",
      "guideContext": "폐지 선별작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-004",
      "text": "선별작업을 하는 근로자들에게 개인 보호구를 제공하고, 착용할 수 있게 해야 한다.",
      "guideContext": "폐지 선별작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-005",
      "text": "안전작업절차와 안전수칙에 따라 개인보호구의 착용 여부를 확인하고, 정기적으로 개인보호구의 손상 여부를 검사한다. 개인보호구의 교체가 필요한 경우 즉시 교체해야 한다.",
      "guideContext": "폐지 선별작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-006",
      "text": "선별라인에서 분진 등이 발생하는 작업을 할 때에는 근로자들은 방진마스크를 반드시 착용하고 작업을 실시하고, 필요한 경우 호흡기 보호구함을 비치하여 보관할 수 있도록 한다.",
      "guideContext": "폐지 선별작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-007",
      "text": "미끄러지거나, 발을 헛디디거나 넘어질 수 있는 위험을 예방하기 위해 주기적으로 청소를 실시해야 한다.",
      "guideContext": "폐지 선별작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-008",
      "text": "제어 장치(적합한 비상정지장치 및 기타 제어 장치)는 반드시 선명히 볼 수 있고, 적합하게 표시되어 신뢰할 수 있는 것이어야 하며 안전 운전에 필요한 모든 작업을 수행할 수 있어야 한다.",
      "guideContext": "압착기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-009",
      "text": "모든 기계들은 접근 가능한 위치에서 전원을 분리할 수 있어야 하고, 시건조치에 대한 규정이 있어야 한다.",
      "guideContext": "압착기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-010",
      "text": "작업 전에 반드시 기계장치의 전체 조립 상태 혹은 함께 작동하도록 설계된 기계 부품을 확인해야 한다.",
      "guideContext": "압착기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-011",
      "text": "안전장치는 정상적으로 작동해야 하며, 작동 시 안전 제어, 비상정지장치 그리고 제어장치가 모든 관련 장비 기계를 중지시킬 수 있는지 확인해야 한다.",
      "guideContext": "압착기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-012",
      "text": "작업자는 사람이나 차량이 잠재적인 위험 지역으로 들어올 때 발생 가능한 위험성, 재료 블록(폐지 묶음)을 제거하기 위한 절차, 비상 절차의 중요성에 대해 인지하고 있어야 한다.",
      "guideContext": "압착기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-013",
      "text": "작업자가 조작하는 조작반 주변에 차량이 이동하는 경우 방호울을 설치하여 이동 중인 차량과의 부딪힘을 예방해야 한다.",
      "guideContext": "압착기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-014",
      "text": "컨베이어 및 포장기에 비상정지장치를 설치해야 한다. 사람들이 작업하는 장소 그리고 컨베이어 구동부 등과 같이 말릴 수 있는 장소의 주변에 설치해야 한다.",
      "guideContext": "압착기 작업 - 비상정지장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-015",
      "text": "작업지역에서 작업자나 주변 작업자가 신속하게 도달 할 수 있도록 비상정지버튼을 설치해야 한다.",
      "guideContext": "압착기 작업 - 비상정지버튼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-016",
      "text": "비상정지버튼은 눌러서 작동하고, 돌려서 복귀되는 형식의 버튼을 사용해야 한다.",
      "guideContext": "압착기 작업 - 비상정지버튼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-017",
      "text": "비상정지버튼은 작업자가 작업을 하거나 작업할 수 있는 모든 곳에서 쉽게 접근 할 수 있어야 한다.",
      "guideContext": "압착기 작업 - 비상정지버튼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-018",
      "text": "작업자를 감지하는 시스템은 신호 송신기를 착용한 작업자가 확인되고, 감지기가 몸의 열을 인식하는 경우 장비를 정지하도록 설계되어야 한다.",
      "guideContext": "압착기 작업 - 감지 시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-019",
      "text": "고정식 또는 인터록 가드를 사용하여 기계의 움직이는 부분에서 위험을 예방할 수 있다.",
      "guideContext": "압착기 작업 - 물림점 방호",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-020",
      "text": "출입문이 설치된 컨베이어에 정렬/비틀림과 같이 기계적인 조절이 필요한 경우와 같이 정기적으로 접근이 필요한 장소에는 인터록 장치를 설치하여야 한다.",
      "guideContext": "압착기 작업 - 물림점 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-021",
      "text": "인터록 장치는 전기 스위치 형태와 기계적 '트랩키' 형식(잠금장치를 열쇠로 돌려서 열거나 잠그는 형식)의 유형 중 적합한 형태의 인터록 장치를 사용할 수 있다.",
      "guideContext": "압착기 작업 - 물림점 방호",
      "additionalDetail": null,
      "workProcessPhase": "압착기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-022",
      "text": "경사진 컨베이어에서 공급 또는 포장 작업을 할 때에는 경사진 컨베이어 상단에 의도적으로 직접 접근하는 작업자를 통제해야 한다.",
      "guideContext": "컨베이어 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-023",
      "text": "작동 중인 컨베이어에 접근하는 것은 어떤 경우에도 허용되지 않는다. 컨베이어 및 압착기는 반드시 격리하고, 시건조치를 취해야 하며, 경사진 컨베이어를 걸어가야 하는 불가피한 상황에서는 건널목 등을 설치하여 이동해야 한다.",
      "guideContext": "컨베이어 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-024",
      "text": "정기적으로 접근이 필요한 장소에는 방호울을 설치하고, 출입용 문에는 연동장치를 설치해야 한다.",
      "guideContext": "컨베이어 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-025",
      "text": "일부 컨베이어는 홀드투런(Hold-to-run)이 가능하거나 또는 작동을 제어할 수 있는 제어 장치가 장착되어 있다. 이 장치들은 반드시 제조업체 및 작업계획에 따라 허가 받은 유지·보수 기술자에 의해 목적에 맞게 사용 및 유지·보수되어야 한다.",
      "guideContext": "컨베이어 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-026",
      "text": "일부 급격하게 경사진 컨베이어 공급 압착기는 단층 피트(화물 자동차 또는 스키드 로더에 의해 적재되는 형식)를 가지고 있다. 피트로 추락하거나 차량이 철골 구조물에 부딪히는 사고를 예방하기 위한 조치가 있어야 한다.",
      "guideContext": "컨베이어 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-027",
      "text": "작업자들이 인력으로 컨베이어에 소재 등을 공급하는 경우, 모서리에 부딪히지 않도록 고정식 또는 이동식 모서리 보호대를 제공해야 한다.",
      "guideContext": "컨베이어 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-028",
      "text": "위치 이동 중 피트로 미끄러지는 작업자를 방지하기 위해 경고 표시 및 특수 바닥재를 설치 및 부착해야 한다.",
      "guideContext": "컨베이어 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "컨베이어 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-029",
      "text": "시야 확보를 위해 호퍼 측면으로 접근하거나, 이물질을 제거하기 위해 호퍼의 상부로 접근할 수 있는 작업발판 및 통로를 제공해야 한다.",
      "guideContext": "호퍼 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호퍼 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-030",
      "text": "호퍼 또는 압착기 덮개에 접근할 수 없어야 한다. 승강구는 위험한 부분에 대한 접근을 방지하기 위해 접근금지 조치를 취해야 한다.",
      "guideContext": "호퍼 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호퍼 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-031",
      "text": "영구적으로 안전하게 접근할 수 있는 조치가 되어 있지 않는 경우, 적절한 추락방지(Fall-arrest) 장비를 사용해야 한다.",
      "guideContext": "호퍼 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호퍼 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-032",
      "text": "랜야드(Lanyard)의 추락거리는 압착기 내부로의 떨어짐을 충분히 방지할 수 있을 만큼 짧아야 한다.",
      "guideContext": "호퍼 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호퍼 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-033",
      "text": "이물질 제거 작업 시 안전작업절차를 준수해야 하고, 호퍼 자체에 올라갈 필요 없이, 안전한 장소에서 이물질의 대부분을 제거할 수 있도록 해야 한다.",
      "guideContext": "호퍼 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호퍼 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-034",
      "text": "불필요한 발판을 제거하고, 떨어짐을 예방하기 위해 필요 시 추가적인 안전 난간을 설치해야 한다.",
      "guideContext": "호퍼 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호퍼 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-035",
      "text": "작업장 사업주는 안전 시스템의 관리 및 집행에 대한 책임이 있다. 호피, 압착기 덮개, 램으로 접근할 때에는 반드시 허가된 작업절차에 따라야 하고, 작업절차에 대해 작업자들을 교육시켜야 한다.",
      "guideContext": "호퍼 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호퍼 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-036",
      "text": "분배기는 반드시 다음과 같이 작동되어야 한다. 공급용 호퍼 내부에 있고 접근용 문이 폐쇄 될 때만 작동할 수 있다. 분배기 절단 날의 회전이 중지할 때까지 이동할 수 없다.",
      "guideContext": "분배기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분배기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-037",
      "text": "만약 호퍼의 안팎으로 분배기 이동을 위한 출입문이 작업자가 들어갈 수 있을 만큼 큰 경우에는 출입문에 연동장치를 설치해야 한다.",
      "guideContext": "분배기 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분배기 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-038",
      "text": "방호울을 설치하여 접근을 통제하거나 기계를 격리시켜야 한다. 그리고 유지·보수 작업을 위해 방호울을 제거할 때 설비의 작동이 정지되어 있는지 확인해야 한다.",
      "guideContext": "호거 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "호거 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-039",
      "text": "가드가 램의 전체 경로와 바늘구멍을 포함한 바늘 스트로크를 덮고 있는지 확인해야 한다.",
      "guideContext": "포장작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "포장작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-040",
      "text": "항상 와이어를 형성시키는 조립체를 둘러싸고 있는 고정 인터록 가드를 설치해야 한다.",
      "guideContext": "포장작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "포장작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-041",
      "text": "기계를 방전시키는 경우 운영자가 위험 부분에 도달하여 중지시킬 수 있도록 터널 가드를 가지고 있어야 한다.",
      "guideContext": "포장작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "포장작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-042",
      "text": "과대 포장을 방지하기 위해 컨베이어에 항상 균일하게 재료들을 투입해야 한다.",
      "guideContext": "막힘 제거 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "막힘 제거 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.10",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-043",
      "text": "근로자들을 위한 교육에는 다음과 같은 내용이 포함되어야 한다. 안전방호장치 점검에 관한 사항, 작업 시 문제점에 대한 보고 체계, 사용 중인 기계설비의 위험성, 기계 청소 작업 시 안전작업절차, 비상상황 시 대처 사항, 화재 및 응급상황 시 조치.",
      "guideContext": "근로자 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-044",
      "text": "장시간의 반복적인 동작, 단조롭고 반복적인 작업을 줄이기 위해 순환 업무를 실시한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-045",
      "text": "순환 업무가 불가능할 경우에는 휴식을 자주 취하게 하여 신체의 피로를 줄일 수 있도록 한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-046",
      "text": "인력작업 대신 기계·기구의 사용이 가능한 작업이면 기계·기구를 사용하여 작업을 할 수 있게 한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": "예를 들어, 테이블 트럭(Table truck)과 이동식 릴의 사용, 적재물이 큰 경우에는 기계로 이용할 수 있게 한다.",
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-047",
      "text": "근로자들에게 근골격계 질환을 발생시킬 수 있는 작업 자세, 동작 등에 대하여 주지시켜야 한다.",
      "guideContext": "근골격계 질환 예방 (법령 근거 미확인)",
      "additionalDetail": "근골격계 질환을 발생시킬 수 있는 작업: 부적절한 작업 자세, 엉거주춤하거나 움직임이 없는 자세, 과도한 힘의 사용, 신체의 반복적인 동작, 어려운 수작업, 허리를 자주 구부리거나 비트는 작업",
      "workProcessPhase": "폐지 선별작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-048",
      "text": "안전작업절차 교육을 위해 다음 내용은 반드시 포함되어야 한다. 작업공정 및 관련 작업자 작업 사항, 필요한 안전방호장치의 종류, 교육, 지도, 감독에 관한 사항, 파악된 위험에 대한 상세 내용과 작업을 완료하기 전까지의 올바른 작업 방법에 관한 사항.",
      "guideContext": "안전작업절차 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G110-049",
      "text": "안전작업절차는 반드시 다음을 포함해야 한다. 안전작업을 위한 지침서, 장비 사용 시 위험한 장소에 비치해야하는 위험 경고 표지, 안전작업절차를 준수하고 있는 지에 대한 정기적인 확인 사항.",
      "guideContext": "안전작업절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    }
  ],
