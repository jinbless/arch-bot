  "checklistItems": [
    {
      "identifier": "CI-M181-001",
      "text": "CNC 루터기는 안전거리를 유지하기 위해 고정식 가드가 설치되어야 한다.",
      "guideContext": "CNC 루터기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-002",
      "text": "방호울에 출입이 필요한 경우 절단날과 다른 위험한 부분의 작동을 멈추거나 접근을 방지할 수 있는 연동장치가 설치된 도어를 사용해야 한다.",
      "guideContext": "CNC 루터기 방호울 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-003",
      "text": "방호울은 바닥에서부터 최소한 1.8 m 까지 방호를 할 수 있어야 한다.",
      "guideContext": "CNC 루터기 방호울 규격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-004",
      "text": "가공물이나 기계의 부속품이 튀어나와도 파손되지 않도록 내충격성 재료로 제조되어야 한다.",
      "guideContext": "CNC 루터기 방호울 재질 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-005",
      "text": "기계 가동 전에 청각 또는 시각적인 경고를 할 수 있어야 한다.",
      "guideContext": "CNC 루터기 방호울 연동장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-006",
      "text": "비상정지장치를 설치해야 한다.",
      "guideContext": "CNC 루터기 방호울 연동장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-007",
      "text": "도어 연동장치를 재설정할 수 있는 제어 장치가 있어야 한다.",
      "guideContext": "CNC 루터기 방호울 연동장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-008",
      "text": "연동장치는 방호울의 외부에 명확하게 볼 수 있는 위치에 설치되어야 하고, 방호울 내부에서 작동할 수 없어야 한다.",
      "guideContext": "CNC 루터기 방호울 연동장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-009",
      "text": "기계의 소음 수준은 최대 90 dB(A)이하로 소음을 감소할 수 있어야 한다.",
      "guideContext": "CNC 루터기 소음 관리",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M181-010",
      "text": "분진과 칩을 제거 할 수 있는 시스템과 효과적인 국소배기장치가 있어야한다.",
      "guideContext": "CNC 루터기 분진 관리",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-M181-011",
      "text": "공구의 회전축이 10초 이내에 정지할 수 있는 제동장치가 있어야 한다.",
      "guideContext": "CNC 루터기 제동장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CNC 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-012",
      "text": "공구 교환 시 접촉을 예방하기 위해 절단 구간에 가드가 설치되어야 한다.",
      "guideContext": "CNC 루터기 공구 교환 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공구 교환",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-013",
      "text": "공구 교환 장치에 접근할 수 있는 가드는 공구 교환 장치와 연동되어 있어야 하고, 만약 절단 날에 접촉할 수 있다면 그 부분에도 연동장치가 설치되어 있어야 한다.",
      "guideContext": "CNC 루터기 공구 교환 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공구 교환",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-014",
      "text": "모든 방호장치는 적절한 교육을 받은 숙련된(필요한 기술, 지식과 경험을 가진 자) 자가 정기적으로 점검해야 한다.",
      "guideContext": "CNC 루터기 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-015",
      "text": "유지·보수 및 검사의 세부 사항을 기록하고, 관리자는 이 작업이 완료되었음을 확인해야 한다.",
      "guideContext": "CNC 루터기 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-016",
      "text": "정비작업 시에는 작업 전에 기계가 안전한 상태로 있는 지 확인해야 한다.",
      "guideContext": "CNC 루터기 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-017",
      "text": "윗면과 측면에서부터 공구에 대한 접촉을 방지할 수 있게 조절할 수 있고 밀폐된 링형 가드가 설치되어 있어야 한다.",
      "guideContext": "수동 공급 루터기 방호조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-018",
      "text": "비산의 위험을 최소화하기 위해, 링 가드는 비산되는 공작물을 막을 수 있을 정도의 강도를 가져야 한다.",
      "guideContext": "수동 공급 루터기 링형 가드 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-019",
      "text": "링 가드의 안지름은 최대 지름의 공구가 설치될 수 있도록 설계되어야 한다.",
      "guideContext": "수동 공급 루터기 링형 가드 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-020",
      "text": "링형 가드 지지대는 스핀들에 부착되어 있어야 한다.",
      "guideContext": "수동 공급 루터기 링형 가드 지지대 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-021",
      "text": "공구를 사용하지 않고도 조정이 가능해야 한다.",
      "guideContext": "수동 공급 루터기 링형 가드 지지대 (법령 근거 미확인)",
      "additionalDetail": "링형 가드 지지대의 조정 편의성",
      "workProcessPhase": "수동 공급 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-022",
      "text": "풋 스위치는 불시의 작동을 방지하기 위해 덮개가 설치되어 있어야 한다.",
      "guideContext": "수동 공급 루터기 풋 스위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-023",
      "text": "풋 스위치의 정상작동 여부를 작업 전에 점검해야 한다.",
      "guideContext": "수동 공급 루터기 풋 스위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 작업 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-024",
      "text": "풋 스위치는 페달에 발을 올려두고 작업을 해서는 안 된다.",
      "guideContext": "수동 공급 루터기 풋 스위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-025",
      "text": "공구 회전축이 10초 이내에 정지할 수 있도록 제동장치가 있어야 한다.",
      "guideContext": "수동 공급 루터기 제동장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M181-026",
      "text": "수동공급방식 및 통합공급방식의 루터기에서 사용하는 단일 스핀들의 모든 절단날은 지름 16 mm 이상 크기의 칩을 배출할 수 있는 날을 사용해야 한다.",
      "guideContext": "수동 공급 루터기 공구 규격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동 공급 루터기 공구 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    }
  ],
