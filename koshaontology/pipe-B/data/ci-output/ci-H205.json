  "domainTerms": [
    {
      "identifier": "DT-H205-001",
      "term": "건강장해 위험성평가",
      "definition": "사업장내에서 발생 가능한 모든 유해·위험요인을 파악하고 해당 유해·위험요인에 의한 질병 발생가능성과 중대성을 추정·결정하여 감소대책을 수립하여 실행하는 일련의 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-002",
      "term": "유해·위험요인(Hazard)",
      "definition": "유해·위험을 일으킬 잠재적 가능성이 있는 것의 고유한 특징이나 속성을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-003",
      "term": "유해·위험요인 파악",
      "definition": "유해요인과 위험요인을 찾아내는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-004",
      "term": "위험성(Risk)",
      "definition": "각 유해·위험요인이 어느 정도 위험한지 위험한 정도를 의미하는 것으로서, 부상·질병의 발생 가능성(확률)과 부상·질병이 발생하였을 때 초래되는 중대성(심각성)을 조합해서 나타낸 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-005",
      "term": "가능성(Probability)",
      "definition": "유해·위험요인에 대한 부상·질병 발생의 확률(빈도)를 의미하며, 노출빈도·시간, 유해·위험한 사건의 발생 확률 등을 고려하여 3~5단계 등급으로 구분하여 표시하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-006",
      "term": "중대성(Severity)",
      "definition": "유해·위험요인으로 인한 부상·질병이 발생했을 때 미치는 영향의 정도(강도 또는 심각성)을 의미하며, 건강영향(장해)의 정도, 치료기간 등을 고려하여 3~5단계 등급으로 구분하여 표시하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-007",
      "term": "위험성 추정",
      "definition": "유해·위험요인별로 부상 또는 질병으로 이어질 수 있는 가능성과 중대성의 크기를 각각 추정하여 위험성의 크기를 산출하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-008",
      "term": "위험성 결정",
      "definition": "유해·위험요인별로 추정한 위험성의 크기가 허용 가능한 범위인지 여부를 판단하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H205-009",
      "term": "위험성 감소대책 수립 및 실행",
      "definition": "위험성 결정 결과 허용 불가능한 위험성을 합리적으로 실천 가능한 범위에서 가능한 한 낮은 수준으로 감소시키기 위한 대책을 수립하고 실행하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H205-01",
      "processOrder": 1,
      "processName": "유해·위험요인 파악",
      "safetyMeasures": "사업장 순회점검, 산업보건관련 정보자료 확인, 근로자 면담을 통해 유해·위험요인을 찾아낸다. 관리자(책임자)는 현장 작업내용에 정통하고 각종 문서(자료) 열람 및 수집에 권한이 있어야 한다.",
      "requiredPPE": [],
      "sourceSection": "4.2.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H205-02",
      "processOrder": 2,
      "processName": "위험성 추정",
      "safetyMeasures": "유해·위험요인별로 부상·질병으로 이어질 수 있는 가능성과 중대성의 크기(등급)를 조합하여 위험성의 크기를 산출한다. 곱셈법(가능성 × 중대성) 적용, 3×3단계 예시 기준.",
      "requiredPPE": [],
      "sourceSection": "4.2.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H205-03",
      "processOrder": 3,
      "processName": "위험성 결정",
      "safetyMeasures": "미리 설정한 위험성 크기별(범위별) 허용가능 여부 기준과 비교하여 3단계(높음 5~9: 즉시 개선, 보통 3~4: 개선, 낮음 1~2: 필요에 따라 개선)로 결정한다.",
      "requiredPPE": [],
      "sourceSection": "4.2.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H205-04",
      "processOrder": 4,
      "processName": "위험성 감소대책 수립 및 실행",
      "safetyMeasures": "허용 불가능한 위험성을 낮추기 위해 작업조건 개선(가능성 관리), 작업환경 개선(가능성 및 중대성 관리), 관리적 사항 개선(중대성 관리), 근로자 개인특성 관리(중대성 관리)를 수행한다. 대책 실행 후 재평가하여 허용 가능한 수준인지 확인한다.",
      "requiredPPE": [],
      "sourceSection": "4.2.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H205-05",
      "processOrder": 5,
      "processName": "고온의 노출수준 분류",
      "safetyMeasures": "WBGT치에 따라 고온 노출수준을 분류한다: 하(25℃미만), 중(25℃이상~28℃미만), 상(28℃이상~31℃미만), 최상(31℃이상).",
      "requiredPPE": [],
      "sourceSection": "5.1.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H205-06",
      "processOrder": 6,
      "processName": "작업 강도 및 의복 수준 분류",
      "safetyMeasures": "작업 강도를 METs/RMR 기준으로 4단계(하/중/상/최상)로, 의복을 4단계(하: T셔츠~최상: 화학방호복)로 분류한 후, 작업 강도와 의복 수준을 조합하여 1~5의 5단계 등급을 예측한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H205-07",
      "processOrder": 7,
      "processName": "위험성 수준 평가 및 수정",
      "safetyMeasures": "고온 노출수준과 작업×의복 수준을 조합하여 위험성 수준을 I~V 5단계로 평가한다. 고온 작업 1주간 이상 미실시, 자율 휴식 불가, 수분·염분 미비치 시 위험성 수준을 한 단계 상승시킨다.",
      "requiredPPE": [],
      "sourceSection": "5.1.5",
      "relatedSR": null
    }
  ],
