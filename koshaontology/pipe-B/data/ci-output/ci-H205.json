  "checklistItems": [
    {
      "identifier": "CI-H205-001",
      "text": "유해·위험요인을 찾는 관리자(책임자)는 현장 작업내용에 정통하고, 각종 문서(자료) 열람 및 수집에 권한이 있어야 한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유해·위험요인 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-002",
      "text": "사업장 순회점검을 통해 작업특성(조건) 파악, 취급 화학물질 파악, 위험작업이나 설비 특이점 파악, 설비의 정상 작동유무, 작업장 환경점검 등을 실시한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유해·위험요인 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-003",
      "text": "산업보건관련 정보자료로서 작업공정도, 화학물질의 물질안전보건자료(MSDS) 및 취급량, 작업환경측정결과, 건강진단결과, 근골격계부담작업 유해·위험요인조사 결과, 작업허가서, 작업표준절차서, 재해사례 현황, 교육일지, 표지사용 현황 등을 확인한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유해·위험요인 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-004",
      "text": "근로자 면담을 통해 건강관련 증상호소 유무, 작업내용 및 작업환경 관련 불편내용, 근로자 개인특성(흡연, 음주, 질병 등)을 파악한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": "개인정보의 경우 비밀보호",
      "workProcessPhase": "유해·위험요인 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-005",
      "text": "유해·위험요인별로 부상·질병으로 이어질 수 있는 가능성과 중대성의 크기(등급)을 조합하여 위험성의 크기를 산출한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 추정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-006",
      "text": "위험성의 크기 산출은 가능성과 중대성의 각 등급수준에 대해 행렬법, 곱셈법, 덧셈법 등의 방법으로 수행한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": "이 지침에서는 곱셈법(가능성 × 중대성)을 적용",
      "workProcessPhase": "위험성 추정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-007",
      "text": "유해·위험요인별로 추정한 위험성의 크기가 허용 가능한 범위인지 여부를 판단한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": "미리 설정한 위험성 크기별(범위별) 허용가능 여부 기준과 비교",
      "workProcessPhase": "위험성 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-008",
      "text": "개선·관리 대책 실행 후 위험성 재평가하여 위험성의 크기가 허용 가능한 수준인지 확인하고, 허용 불가능할 경우 가능한 크기가 될 때까지 추가 대책을 실행한다.",
      "guideContext": "건강장해 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 감소대책 수립 및 실행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-009",
      "text": "작업시간 및 노출수준과 같은 가능성(P) 등급이 고정적이거나 변경이 어려우면 건강영향 정도인 중대성(S) 등급을 낮추기 위한 작업환경, 관리적 사항 개선 및 개인특성 관리를 통해 위험성을 감소시킨다.",
      "guideContext": "건강장해 위험성평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 감소대책 수립 및 실행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-010",
      "text": "고온 작업을 직전 1주간 이상 실시하지 않은 경우 위험성 수준을 한 단계 상승시킨다.",
      "guideContext": "고열작업 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 수준 수정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-011",
      "text": "근로자 스스로의 판단으로 잠시 휴식을 취하는 것이 안 되는 경우 위험성 수준을 한 단계 상승시킨다.",
      "guideContext": "고열작업 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 수준 수정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-012",
      "text": "직장에 수분, 염분(나트륨)이 준비되어 있지 않은 경우 위험성 수준을 한 단계 상승시킨다.",
      "guideContext": "고열작업 위험성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험성 수준 수정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-013",
      "text": "작업 개시 전에 식사할 것. 설사나 탈수 상태, 수면 부족을 확인하고 이러한 문제가 있는 근로자는 작업 중 지속적으로 감시할 것",
      "guideContext": "고열작업 위험성 수준 I(극히 미세한 위험성) 이상",
      "additionalDetail": "위험성 수준 I~V 공통 적용 사항",
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-014",
      "text": "자율신경영향약(파킨슨치료제, 항간질제, 항우울제, 항불안제, 수면제, 항부정맥제 등)을 복용하고 있는 자 및 염분 섭취 제한자(고혈압, 신부전, 심부전등), 갑상선 질환자는 직업환경의학 전문의 또는 주치의의 의견에 따를 것",
      "guideContext": "고열작업 위험성 수준 I(극히 미세한 위험성) 이상",
      "additionalDetail": "위험성 수준 I~V 공통 적용 사항",
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-015",
      "text": "작업을 정기적으로 감시하고, 휴식시간 마다 근로자의 자각증상을 조사할 것",
      "guideContext": "고열작업 위험성 수준 II(허용 가능한 위험성) 이상",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-016",
      "text": "열, 직사광선, 반사광을 차단하는 지붕 설치, 통풍·냉방·제습 설비 설치 등으로 작업장의 온도, 습도, 기류, 복사 등 환경을 개선해서 위험성 수준 II이하로 저감하도록 노력",
      "guideContext": "고열작업 위험성 수준 III(중간 정도의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-017",
      "text": "작업의 위치, 총체하중, 연속 작업시간, 복장, 보호구의 재검토 등을 통해 위험성 수준 II이하로 저감하도록 노력",
      "guideContext": "고열작업 위험성 수준 III(중간 정도의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-018",
      "text": "직사광선이 닿지 않고 통풍이 잘 되는 곳에 휴게실을 두고 근로자에게 휴식을 취하도록 함. 수분과 나트륨 보급",
      "guideContext": "고열작업 위험성 수준 III(중간 정도의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-019",
      "text": "작업을 연속적으로 감시하고 휴식시간 마다 근로자의 자각 증상 및 심박수 모니터링",
      "guideContext": "고열작업 위험성 수준 III(중간 정도의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-020",
      "text": "설사나 탈수 상태, 수면 부족을 확인하고 이러한 문제가 있는 근로자는 원칙적으로 위험성 수준 III의 작업에 종사하지 못하도록 조치",
      "guideContext": "고열작업 위험성 수준 III(중간 정도의 위험성) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-021",
      "text": "고령이나 비만(체지방율 30% 이상)인 경우 연속적 작업 감시가 어려운 위험성 수준 III의 작업에 종사하지 않도록 권고",
      "guideContext": "고열작업 위험성 수준 III(중간 정도의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-022",
      "text": "임시 휴게시간을 두고, 휴게실에 에어컨을 설치하여 24~26℃정도의 기온을 유지. 근로자에게 휴식을 취하게 하고 수분과 나트륨 보급",
      "guideContext": "고열작업 위험성 수준 IV(높은 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-023",
      "text": "에어컨이 설치되어 있지 않은 휴게실의 경우에는 선풍기나 물 미스트의 분사 장치를 이용하거나 통풍이 좋은 그늘을 확보",
      "guideContext": "고열작업 위험성 수준 IV(높은 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-024",
      "text": "체온을 내릴 수 있도록 음용수를 항상 준비",
      "guideContext": "고열작업 위험성 수준 IV(높은 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-025",
      "text": "위험성 수준 IV의 작업에 7일 이상 종사하지 않은 근로자를 해당 작업에 배치할 때에는 작업 개시 후 3일간은 연속 작업시간을 다른 근로자보다 단축함",
      "guideContext": "고열작업 위험성 수준 IV(높은 위험성)",
      "additionalDetail": "순화 기간 설정",
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-026",
      "text": "방진마스크나 방독마스크는 근로자에게 부담이 되므로 전동팬이 부착된 호흡용 보호구나 송기마스크 등 호흡에 부담이 되지 않는 마스크로 변경하는 것이 바람직",
      "guideContext": "고열작업 위험성 수준 V(최고의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-027",
      "text": "냉각 효과가 있는 작업복(냉각조끼 등) 사용",
      "guideContext": "고열작업 위험성 수준 V(최고의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-028",
      "text": "휴식 시 근로자는 체온, 체중, 심박수, 자각 증상을 체크하여 관리감독자에게 신고하고, 관리감독자는 근로자에게 스스로 신고하도록 지도",
      "guideContext": "고열작업 위험성 수준 V(최고의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H205-029",
      "text": "귀, 입 안, 혀 밑의 체온 중 하나라도 38.5℃미만(겨드랑이 체온의 경우 38.0℃ 미만)인 경우 고열 작업을 연속 수행해도 되나, 작업을 계속적으로 감시하고 휴식 시간 마다 근로자의 자각증상과 체중을 확인",
      "guideContext": "고열작업 위험성 수준 V(최고의 위험성)",
      "additionalDetail": null,
      "workProcessPhase": "고온 위험성 관리",
