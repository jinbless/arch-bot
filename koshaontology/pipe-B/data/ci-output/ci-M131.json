  "checklistItems": [
    {
      "identifier": "CI-M131-001",
      "text": "효과적인 보수유지를 위해서는 기계에서 발생될 수 있는 결함의 가능성에 따라 진단을 실시하여야 한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "진단 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-002",
      "text": "기계의 상태감시 시스템 및 진단시스템을 구축하기 위하여 예비조사를 수행한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예비조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-003",
      "text": "예비조사 결과를 종합하여 진단요구사항 보고서를 작성한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예비조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-004",
      "text": "보고서에는 기계를 적당히 분할한 부품, 부품에 관련된 결함들의 목록, 각 결함에서 관찰할 수 있는 증상, 사용되어질 상태감시 특징설명인자, 특징설명인자의 계산을 위하여 사용될 매개변수와 측정방법, 진단시스템의 성능에 대한 내용을 포함시킨다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예비조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-005",
      "text": "상태감시에 의하여 모든 중요한 결함들이 다 나타나는 것은 아니며 나타나지 않는 결함들은 진단할 수 없으므로 보고서에 결함으로 나타나는 것과 나타나지 않는 것을 명확히 구분한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예비조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-006",
      "text": "기계에 발생된 결함이력, 운전이력, 유지보수이력을 기록하여 진단에 참고하여야 한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "상태감시 자료 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-007",
      "text": "이상상태의 검출은 기계의 현재 특징설명인자와 경험, 제작사 사양, 시운전으로부터 선택되거나 통계자료로부터 선택된 기준값을 비교함으로써 이루어진다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이상상태 검출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-008",
      "text": "결함에 필요한 증상들을 확인하여 모든 증상들이 확인되면 그 결함가설은 확정된다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결함가설 확정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-009",
      "text": "하나 또는 그 이상의 필요한 증상이 확인되지 않으면 그 결함가설은 제거한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결함가설 확정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-010",
      "text": "진단보고서에 평가되고 확인된 결함요소들을 기재한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": "진단을 시작하게 한 이상상태, 확인된 전체적인 증상, 확인되지 않는 증상으로 제거된 결함, 확인된 결함과 그들의 예상확률을 포함",
      "workProcessPhase": "진단 종합 및 판단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-011",
      "text": "결론으로 결함을 표기하고 수정운전이나 보수작업을 제안한다. 또는 보수작업이 필요하나 운전을 고려하여 언제까지 연기할 수 있다는 것을 권고한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "진단 종합 및 판단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M131-012",
      "text": "인과트리(Causal tree)구조를 사용하여 원인의 인과관계를 연결하고 분석한다.",
      "guideContext": "기계 결함진단 자료해석 (법령 근거 미확인)",
      "additionalDetail": "인과관계 진단법은 결함·증상진단법보다 깊이 있는 진단을 수행할 때 사용",
      "workProcessPhase": "인과관계 진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M131-001",
      "term": "경고(Alarm)",
      "definition": "선택된 이상상태 또는 이상상태의 조합이 발생되어 수정조치가 요구될 때 운전자에게 정보를 줄 수 있도록 고안된 신호나 의사전달을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M131-002",
      "term": "이상상태(Anomaly)",
      "definition": "기계의 비정상적인 상태나 거동을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M131-003",
      "term": "특징설명인자(Descriptor)",
      "definition": "사람이 관찰하거나 직접 측정된 것 또는 공정자료로부터 도출된 값으로, 증상을 설명하는데 사용되는 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M131-004",
      "term": "고장(Failure)",
      "definition": "기계의 주기능 또는 여러 가지 기능이 더 이상 작동되지 못하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M131-005",
      "term": "결함(Fault)",
      "definition": "부품이나 조립품의 상태가 열화되거나 비정상 거동을 보이는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M131-006",
      "term": "증상(Symptom)",
      "definition": "사람의 관측이나 측정에 의하여 감지되는 비정상 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
