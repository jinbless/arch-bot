  "domainTerms": [
    {
      "identifier": "DT-P28-001",
      "term": "코일 용기",
      "definition": "열매로 열 오일(Thermal oil)을 사용하는 폐쇄계의 가열코일(Heating coil)을 사용하는 탱크 용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P28-002",
      "term": "인화성 압축가스",
      "definition": "수송을 목적으로 압축, 액화 또는 압축 액화된 것으로, 증기압이 2.76 × 10⁵ Pa(40 psia)를 초과하는 인화성 가스를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P28-003",
      "term": "중공 구조물",
      "definition": "빈 공간으로 용기에 부착된 러더(Rudder), 러더 스톡(Rudder stock), 스케그(Skeg), 캐스팅(Casting), 돛대와 붐(Boom), 레일 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P28-004",
      "term": "선박안전(화학)관리자",
      "definition": "위험과 관련된 선박용기의 제조, 개조, 수리 및 폐기가 안전하게 수행될 수 있는지를 판단할 자격이 부여된 자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P28-005",
      "term": "탱크선박",
      "definition": "탱크에 액체 벌크 화물을 운반하기 위해 특별히 건조되거나 전환된 선박을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P28-01",
      "processOrder": 1,
      "processName": "상태 확인",
      "safetyMeasures": "선박안전(화학)관리자가 작업절차를 문서로 발급하고, 화재 위험 또는 분위기 결정 시 육안검사를 수행하며, 작업기간 동안 물리적 상태 및 공간이 충분한지 확인한다.",
      "requiredPPE": [],
      "sourceSection": "4.1",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-P28-02",
      "processOrder": 2,
      "processName": "점검전 준비",
      "safetyMeasures": "모든 계기의 교정을 사용 전 확인·기록하고, 작업공간에 대해 과거 3회 운송 화물, 작업 성질 및 한계, 시작시간·지속시간, 벤트라인·개구부 시험, 위험물질 누출 가능 배관 확인, 밸브 개폐 예방조치, 화물 가열코일 시험을 육안검사 및 시험으로 확인한다.",
      "requiredPPE": [],
      "sourceSection": "4.2",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-P28-03",
      "processOrder": 3,
      "processName": "안전 지시 및 조건 설정",
      "safetyMeasures": "작업자 안전을 위해 산소농도 19.5~22%, 인화성 물질 농도 폭발하한 10% 미만, 독성물질 허용농도 이내를 확인하고, 조건 미달 시 '작업자 위험지역' 또는 '출입제한지역'으로 표지하여 출입을 제한한다.",
      "requiredPPE": [],
      "sourceSection": "4.3.1",
      "relatedSR": [
        "SR-CONFINED-001",
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "WP-P28-04",
      "processOrder": 4,
      "processName": "열 작업 안전 확인",
      "safetyMeasures": "산소농도 22% 이하, 인화성 물질 폭발하한 10% 미만 확인하고, 인화성 물질 저장 인접공간의 청결 또는 불활성 상태를 확인한다. 조건 미달 시 '열 작업 위험' 표시 후 작업을 제한한다. 열 작업 공간은 불활성화 요구사항을 만족하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "4.3.3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-009",
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "WP-P28-05",
      "processOrder": 5,
      "processName": "불활성화",
      "safetyMeasures": "불활성 가스로 폐쇄 공간의 산소 함량을 8% 이하로 유지하고, 수면 0.9m 이하 열 작업 시 인화성 가스 농도 폭발하한 10% 미만 유지한다. 선박안전(화학)관리자가 불활성 가스 주입을 직접 감독하고, 밸브에 꼬리표를 부착하며, 모든 개구부를 밀폐한다.",
      "requiredPPE": [],
      "sourceSection": "4.3.5",
      "relatedSR": [
        "SR-CONFINED-010",
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-P28-06",
      "processOrder": 6,
      "processName": "탱크선박 청소",
      "safetyMeasures": "모든 펌프·배관·소화설비 배관 등을 물로 세척하고 수증기·공기로 불어내거나 불활성 가스를 주입한다. 모든 화물칸 및 인접 공간은 작업자 안전 및 열 작업 기준에 적합하도록 청소한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "WP-P28-07",
      "processOrder": 7,
      "processName": "전기용접 준비",
      "safetyMeasures": "접지케이블은 장치의 특정 최대출력 이상의 안전 전류 용량으로 용접지점과 가능한 가까운 선박 구조물에 연결한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "WP-P28-08",
      "processOrder": 8,
      "processName": "지정 정박구역 이용",
      "safetyMeasures": "청소·가스 제거·불활성화 미완료 선박은 분리된 지정 정박장으로 인도하고, 가스 제거·청소·불활성화 완료 후 다른 정박장으로 이동한다. 선박안전(화학)관리자 미허가 시 연료탱크 안·밖 열 작업을 금지한다.",
      "requiredPPE": [],
      "sourceSection": "5.5",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "WP-P28-09",
      "processOrder": 9,
      "processName": "대량 화학물질 운반 탱크선박 작업",
      "safetyMeasures": "열 작업 및 밀폐공간 출입 시 안전 지시 조건(4.3항) 만족 확인하고, 위험성 미상 물질 운송 공간에 '작업자 위험지역' 표시한다. 화학물질 위험성 시험결과를 작업 전 확인하고, 운송 공간은 안전한 상태에서 청소한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-CHEMICAL-013",
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "WP-P28-10",
      "processOrder": 10,
      "processName": "초저온 인화성 액체 운반선 작업",
      "safetyMeasures": "산소 19.5% 이상, 인화성 가스 폭발하한 10% 미만 확인하고, 미충족 시 가스 위험 없는 장소에서 수리한다. 작업 전 인화성 물질 존재 및 증기농도를 확인하고, 수리 전 가스 공급라인 불활성화 확인 및 설비 개방 전 퍼지·환기를 실시한다.",
      "requiredPPE": [],
      "sourceSection": "7.1",
      "relatedSR": [
