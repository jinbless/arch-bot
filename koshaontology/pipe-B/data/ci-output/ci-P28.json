  "checklistItems": [
    {
      "identifier": "CI-P28-001",
      "text": "선박안전(화학)관리자는 선박에 지시된 작업이 안전하게 수행될 수 있도록 작업절차를 문서로 발급하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 상태 확인",
      "additionalDetail": null,
      "workProcessPhase": "상태 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-002",
      "text": "선박안전(화학)관리자는 화재의 위험 또는 분위기를 결정할 필요가 있는 경우에는 육안검사를 수행하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 상태 확인",
      "additionalDetail": null,
      "workProcessPhase": "상태 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-003",
      "text": "선박안전(화학)관리자는 작업기간 동안 적용 가능한 요구사항을 충족하고, 물리적 상태 및 공간이 충분한 지를 확인하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 상태 확인",
      "additionalDetail": null,
      "workProcessPhase": "상태 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-004",
      "text": "사용하는 모든 계기(Instrument)의 교정(Calibration)은 사용 전에 확인하고, 기록하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 점검전 준비사항",
      "additionalDetail": null,
      "workProcessPhase": "점검전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-005",
      "text": "작업공간 또는 주변에 대해 육안검사 및 시험을 통해 과거 3회 운송 화물, 작업의 성질 및 한계, 작업의 시작시간 및 지속시간, 화물 및 다기관(Manifold)에 접속된 벤트 라인 및 접근 개구부의 시험, 위험물질의 누출이 가능한 배관의 확인, 밸브의 개폐 및 작동을 알릴 수 있도록 예방조치 확인, 화물 가열코일의 시험 사항을 확인해야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 점검전 준비사항",
      "additionalDetail": null,
      "workProcessPhase": "점검전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-006",
      "text": "대기중 산소농도는 19.5% 내지 22% 이하이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 작업자 안전",
      "additionalDetail": null,
      "workProcessPhase": "안전 지시 및 조건",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-007",
      "text": "공기 중 인화성 물질의 농도는 폭발하한의 10% 미만이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 작업자 안전",
      "additionalDetail": null,
      "workProcessPhase": "안전 지시 및 조건",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-008",
      "text": "화물, 연료, 탱크 도료, 불활성 매체 또는 훈증제(Fumigant)와 관계된 분위기에서 독성물질은 허용농도 이내이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 작업자 안전",
      "additionalDetail": null,
      "workProcessPhase": "안전 지시 및 조건",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-009",
      "text": "작업 허가서에 의해 허용된 작업에서는 독성물질이 배출되지 않도록 관리하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 작업자 안전",
      "additionalDetail": null,
      "workProcessPhase": "안전 지시 및 조건",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-010",
      "text": "4.3.1항의 (1)호 내지 (4)호의 조건에 해당하지 않는다면 \"작업자 위험지역\" 또는 \"출입제한지역\"을 표지하여 출입을 제한하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 작업자 안전",
      "additionalDetail": null,
      "workProcessPhase": "안전 지시 및 조건",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P28-011",
      "text": "\"작업자 위험지역(Not safe for workers)\"으로 표시된 구획실 또는 공간에는 허가되지 않은 작업자들의 출입을 금지하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 위험지역의 출입",
      "additionalDetail": null,
      "workProcessPhase": "안전 지시 및 조건",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P28-012",
      "text": "\"출입제한지역(Enter with restrictions)\"으로 표시된 구획실 또는 공간에는 보호장비, 복장, 시간 등 조건이 적합할 경우에만 작업을 위한 출입을 허가하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 위험지역의 출입",
      "additionalDetail": null,
      "workProcessPhase": "안전 지시 및 조건",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-013",
      "text": "열 작업 시 공기 중의 산소농도는 22 vol%를 넘지 않아야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "CI-P28-014",
      "text": "열 작업 시 공기 중 인화성 물질의 농도는 폭발하한의 10% 미만이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P28-015",
      "text": "잔류물이 확인서의 지시에 따라 유지 관리되는 경우에는 화기작업 중 고농도를 유발할 가능성이 없어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P28-016",
      "text": "인화성 물질을 저장하고 있거나 저장하였던 모든 인접공간은 화재의 확산을 막을 수 있도록 충분히 깨끗하거나 불활성이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P28-017",
      "text": "선박의 연료탱크, 윤활유 탱크, 엔진실, 기관실 밑바닥 및 기타 기계실은 선박안전(화학)관리자의 요구사항에 따라 작업하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P28-018",
      "text": "4.3.3항의 (1)호 내지 (5)호의 조건에 해당하지 않는다면 \"열 작업 위험(Not safe for hot work)\"을 표시하여 작업을 제한하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P28-019",
      "text": "구획실 또는 공간에 \"열 작업 위험\"으로 표시되어 있으면 열 작업은 허용되지 않는다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P28-020",
      "text": "열 작업을 하기 위한 공간은 5.1항의 (3)호와 4.3.3항의 (1)호 내지 (4)호의 요구조건을 만족하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P28-021",
      "text": "열 작업을 하기 위한 장소는 4.3.5항에 따라 불활성화하고, 인접공간은 4.3.3항의 (4)호의 요구조건을 만족하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 열 작업",
      "additionalDetail": null,
      "workProcessPhase": "열 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P28-022",
      "text": "폐선작업(Shipbreaking)을 하기 위해서는 4.3.3항의 (1)호 내지 (4)호의 요구사항을 충족시켜야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 폐선작업",
      "additionalDetail": null,
      "workProcessPhase": "폐선작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P28-023",
      "text": "해당 인화성 잔류물은 사용 중인 소화설비 능력 이상의 화재를 유발할 가능성이 없어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 폐선작업",
      "additionalDetail": null,
      "workProcessPhase": "폐선작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P28-024",
      "text": "이산화탄소와 같은 불활성 가스로 폐쇄된 공간의 산소 함량을 8% 이하로 유지시키거나 연소를 유지하기 위해 필요한 공기량의 50% 중에서 적은 양으로 공간을 불활성화 하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.5",
      "basedOn": [
        "SR-CONFINED-010"
      ]
    },
    {
      "identifier": "CI-P28-025",
      "text": "열 작업이 수면보다 최소 0.9 m(3 ft) 아래에서 수행되거나 물위 공간이라면 공기 중 인화성 가스의 농도는 폭발하한의 10%를 초과하지 않도록 하여야 하며, 공간은 물로 가득 차 있어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P28-026",
      "text": "모든 화물탱크에는 화물이 하역된 후의 공기 중 잔류물 농도가 폭발하한의 10% 미만이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 정박",
      "additionalDetail": null,
      "workProcessPhase": "정박",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.6",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-027",
      "text": "모든 화물탱크는 산소 함량이 8% 미만이거나 연소를 유지하기 위해 필요한 공기량의 50% 미만까지 불활성 상태로 유지하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 정박",
      "additionalDetail": null,
      "workProcessPhase": "정박",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.6",
      "basedOn": [
        "SR-CONFINED-010"
      ]
    },
    {
      "identifier": "CI-P28-028",
      "text": "선박은 안정될 때까지 매일 재점검하고, 산소함량을 기록·보관하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 정박",
      "additionalDetail": null,
      "workProcessPhase": "정박",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3.6",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-029",
      "text": "모든 펌프, 배관, 불활성 가스 배관, 원유세척 배관, 소화설비 배관, 증기 제어 및 회수 배관, 벤트 배관은 물로 세척하고, 수증기나 공기로 불어내거나 불활성 가스를 주입하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 탱크선박 청소",
      "additionalDetail": null,
      "workProcessPhase": "청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-030",
      "text": "모든 화물칸 및 인접 공간은 4.3.1항과 4.3.3항에 적합하도록 청소하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 탱크선박 청소",
      "additionalDetail": null,
      "workProcessPhase": "청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-031",
      "text": "내화 잔류물 또는 보존 코팅이 있는 탱크 또는 구획실은 인화점이 82.2 ℃(180 ℉) 이상인 잔류물이 있는 탱크나 구획실은 소량의 열 작업을 위해 부분적으로 청소할 수도 있다.",
      "guideContext": "선박용기 가스위험 제어 - 탱크선박 청소 (법령 근거 미확인)",
      "additionalDetail": "청소지역은 화재 확산을 방지하기 위해 열 작업으로부터 충분한 거리를 가져야 하고, 열 작업에 따른 스파크 또는 슬래그를 예방할 수 있는 방법으로 청소해야 한다.",
      "workProcessPhase": "청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P28-032",
      "text": "선박안전(화학)관리자는 공간으로 불활성 가스를 주입 시에는 직접 감독하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-010"
      ]
    },
    {
      "identifier": "CI-P28-033",
      "text": "불활성 공간의 산소농도는 8% 이하이거나 연소를 위해 필요한 공기량의 50 % 중에서 적은 것이어야 하며, 주기적으로 측정하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-034",
      "text": "화물탱크와 벤트 배관 내 연결된 화물 소화시스템은 모두 물로 세척하고, 수증기나 공기로 불어내거나 불활성화 하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-035",
      "text": "불활성 공간에 연결된 모든 밸브에는 꼬리표를 부착하여 우발적인 개방이나 작동을 막기 위한 안전조치가 되어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P28-036",
      "text": "모든 펌프, 배관, 불활성 가스 배관 및 원유세척 배관은 물로 세척하고, 수증기나 공기로 불어내거나 불활성화 하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-037",
      "text": "불활성화 하는 모든 공간은 불활성 가스에 견딜 수 있는 구조이어야 하고, 모든 밸브, 해치 및 기타 불활성 공간으로 통하는 개구부는 밀폐되어 안전한 구조이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-P28-038",
      "text": "내부 수리나 개조를 하고자 하는 구획실이나 공간은 5항의 요구사항에 따라 청소하여야 하고, 5.1항의 (3)호에 기술된 탱크를 제외한 모든 공간은 4.3.5항 또는 4.3.6항의 요구사항에 따라 불활성화 하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 불활성화",
      "additionalDetail": null,
      "workProcessPhase": "불활성화",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-039",
      "text": "모든 증기 공급에 의한 화물 가열코일은 찌거나(Steaming) 물로 세척, 공기 또는 불활성 가스 주입 등에 의하여 안전하도록 하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 화물 가열코일",
      "additionalDetail": null,
      "workProcessPhase": "화물 가열코일 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-040",
      "text": "물 또는 증기에 반응하는 화학물질을 사용하는 화물탱크안의 코일은 6.2항의 (2)호의 요구사항에 따라 청소하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 화물 가열코일",
      "additionalDetail": null,
      "workProcessPhase": "화물 가열코일 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "CI-P28-041",
      "text": "260 ℃(500 ℉) 이상의 열매를 사용하는 코일 선박에서 가열코일은 건전성(Integrity)을 유지하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 화물 가열코일 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화물 가열코일 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P28-042",
      "text": "전기용접 접지케이블은 사용하는 장치의 특정 최대출력 이상의 안전 전류 용량으로 용접지점과 가능한 가까운 선박 구조물에 연결하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 전기용접",
      "additionalDetail": null,
      "workProcessPhase": "전기용접",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-P28-043",
      "text": "청소, 가스 제거 또는 불활성화가 완료되지 않은 선박은 위치상의 위험과 인접재산에 대한 위험을 적절히 고려하여 선택한 분리된 지정 정박장으로 인도하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 지정 정박구역 이용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정박구역 이용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P28-044",
      "text": "지정 정박장에 있는 선박의 가스 제거, 청소 및 불활성화는 5.1항 또는 5.2항의 요구사항에 따라 다른 정박장으로 옮겨지기 전에 실시하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 지정 정박구역 이용",
      "additionalDetail": null,
      "workProcessPhase": "정박구역 이용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-045",
      "text": "보일러나 기계실이 아닌 열 작업과 관련된 수리는 5.1항 및 5.2항의 요구사항에 따라 가스 제거, 청소 및 불활성화 될 때까지 해당 지정 정박지에 있는 어떠한 선상에서도 실시되어서는 안 된다.",
      "guideContext": "선박용기 가스위험 제어 - 지정 정박구역 이용",
      "additionalDetail": null,
      "workProcessPhase": "정박구역 이용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P28-046",
      "text": "청소 또는 불활성화 되지 않았거나 선박안전(화학)관리자가 허가하지 않은 선박의 연료탱크 안, 밖 또는 주변에서 열 작업을 하여서는 안 된다.",
      "guideContext": "선박용기 가스위험 제어 - 지정 정박구역 이용",
      "additionalDetail": null,
      "workProcessPhase": "정박구역 이용",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P28-047",
      "text": "대량 화학물질을 운반하거나 노출된 공간에서 열 작업 및 밀폐공간 출입 작업을 하기 위해서는 4.3항을 만족하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-P28-048",
      "text": "화학적 위험성을 모르는 물질을 운송하였던 공간에는 \"작업자 위험지역\"을 표시하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P28-049",
      "text": "작업 전에 화학물질의 위험성 시험결과를 확인하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P28-050",
      "text": "대량 화학물질을 운송하였던 공간은 안전한 상태에서 청소하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박 최소조건",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-051",
      "text": "가열코일, 소화시스템 및 벤트 라인을 포함하는 배관은 청결하게 유지하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박 최소조건",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-052",
      "text": "이전의 운송 화학물질과 함께 사용할 수 있도록 청소나 불활성화 방법 및 물질 선택은 주의를 해야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박 최소조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P28-053",
      "text": "벌크 화학물질을 운송 후 청소를 해야 하는 화물칸은 구획실 내의 분위기가 가능하다면 4.3.1항과 4.3.3항에 적합하도록 청소하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박 최소조건",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-054",
      "text": "구획실의 잔류물은 4.3.1항과 4.3.3항의 조건에 충족되도록 처리하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 대량 화학물질 운반용 탱크선박 최소조건",
      "additionalDetail": null,
      "workProcessPhase": "대량 화학물질 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-055",
      "text": "초저온 인화성 액체나 증기를 운반하였거나 노출된 공간에서 열 작업 및 밀폐공간 출입 작업을 하기 위해서는 4.3항의 요구사항을 만족하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 초저온 인화성 액체 운반선",
      "additionalDetail": null,
      "workProcessPhase": "초저온 인화성 액체 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-P28-056",
      "text": "구획실 또는 작업공간의 공기는 산소가 19.5% 이상이고, 공기 중 인화성 가스의 농도는 폭발하한의 10% 미만이어야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 초저온 인화성 액체 운반선",
      "additionalDetail": null,
      "workProcessPhase": "초저온 인화성 액체 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-057",
      "text": "인화성 액체의 저장설비가 7.1항의 (2)호를 충족시키지 못한 경우 제한된 특정 수리는 가스 위험이 없는 장소에서 수행하여야 하고, 수리를 위한 선박은 위치 및 인접 재산의 위험을 고려한 장소에 정박하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 초저온 인화성 액체 운반선",
      "additionalDetail": null,
      "workProcessPhase": "초저온 인화성 액체 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P28-058",
      "text": "누출된 인화성 액체증기가 내부 구획공간이나 단열재 내에 존재하지 않도록 작업 시작 전에 인화성 물질의 존재와 증기농도를 확인하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 초저온 인화성 액체 운반선",
      "additionalDetail": null,
      "workProcessPhase": "초저온 인화성 액체 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-P28-059",
      "text": "선박이 수리중일 때에는 선박안전(화학)관리자의 허가 없이 불활성 가스 또는 인화성 증기가 포함된 탱크, 시스템 또는 공간에 대한 환기작업을 할 수 없다.",
      "guideContext": "선박용기 가스위험 제어 - 초저온 인화성 액체 운반선 최소조건",
      "additionalDetail": null,
      "workProcessPhase": "초저온 인화성 액체 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-P28-060",
      "text": "연료 저장용기는 수리 전에 가스 공급라인이 불활성화 또는 다른 적합한 방법으로 안전한 상태가 되었는지를 확인하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 초저온 인화성 액체 운반선 최소조건",
      "additionalDetail": null,
      "workProcessPhase": "초저온 인화성 액체 운반 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-P28-061",
      "text": "기계 또는 설비는 수리를 위해 개방하기 전에 퍼지하고, 용기의 증기 또는 불활성 가스를 제거하기 위한 환기를 하여야 한다.",
      "guideContext": "선박용기 가스위험 제어 - 초저온 인화성 액체 운반선 최소조건",
      "additionalDetail": null,
