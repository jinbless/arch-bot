  "checklistItems": [
    {
      "identifier": "CI-M89-001",
      "text": "모든 운전실 그밖의 검사, 정기적인 정비 등을 필요로 하는 크레인의 부분은 계단, 사다리, 통로, 참 등에 의하여 접근 가능해야 한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-CRANE-010"
      ]
    },
    {
      "identifier": "CI-M89-002",
      "text": "조립, 분해, 운전, 검사, 일상적 유지보수, 부품교환 등의 작업을 하기 위하여 지상에 위치한 타워 크레인과 지브 크레인은 작업자의 안전과 작업장소로의 접근을 위해 지지 장비, 안전난간, 손잡이, 플랫폼, 안전장치 및 그밖의 장비들을 갖추어야 한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-FALL-001",
        "SR-CRANE-010"
      ]
    },
    {
      "identifier": "CI-M89-003",
      "text": "크레인 타워의 사다리에는 규칙적으로 설치된 참이 있어야 하며, 사다리의 길이가 10m 이상인 경우에는 5m 이내마다 계단참을 설치하여야 한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "CI-M89-004",
      "text": "그밖의 모든 경우에는 지브를 따라 최소 300mm의 통행 폭에 양쪽에 높이 30mm의 발끝막이를 갖춘 통행로를 설치하여야 한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치",
      "additionalDetail": "지브의 높이가 850mm 이하이거나 육안검사를 위해 높이를 조절할 수 있는 경우는 제외",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-M89-005",
      "text": "추락방지를 위해 난간이나 작업자의 안전벨트가 부착되는 방호용 와이어는 통행로의 수직 지지대를 따라 설치하여야 한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FALL-002",
        "SR-FALL-003"
      ]
    },
    {
      "identifier": "CI-M89-006",
      "text": "통행로는 지브의 크기와 배치에 맞추어 지브의 내부 혹은 꼭대기에 설치하여야 한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-M89-007",
      "text": "지브의 틈 높이가 1,800mm 이상인 경우의 통행로는 <그림 6>의 규격에 맞추어야 한다.",
      "guideContext": "타워크레인 삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-M89-008",
      "text": "안전난간은 통행로 바닥으로부터 1,000mm 상부에 최소한 한쪽은 설치해야 하며, 가능하면 양쪽에 모두 설치한다.",
      "guideContext": "타워크레인 삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-M89-009",
      "text": "지브의 높이가 850mm 이상이면서 지브내의 틈이 1,800mm가 되지 않을 경우에는 통행로는 <그림 7>과 <그림 8>에 제시된대로 지브의 측면을 따라 설치하여야 한다.",
      "guideContext": "타워크레인 삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-M89-010",
      "text": "지브의 높이가 1,500mm 이상일 경우의 안전난간은 <그림 7>과 같이 통행로 바닥에서 1,000mm 높이에 맞추어야 한다.",
      "guideContext": "타워크레인 삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-M89-011",
      "text": "지브가 1,800mm 이상의 틈 높이 h를 유지할 경우, 통행로는 <그림 9>와 같이 지브에 맞추어져야 한다.",
      "guideContext": "타워크레인 역삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-M89-012",
      "text": "안전난간은 통행로 상부 1,000mm 지점에 최소한 한쪽은 설치해야 하며 가능하면 양쪽에 모두 설치하여야 한다.",
      "guideContext": "타워크레인 역삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-M89-013",
      "text": "지브의 높이가 낮아 7.3의 요구사항을 충족시키지 못할 경우의 통행로는 <그림 11>과 같이 지브의 상부에 설치하여야 한다.",
      "guideContext": "타워크레인 역삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-M89-014",
      "text": "안전난간은 통행로의 상부 바깥쪽에 1,000mm의 위치에 설치하여야 한다.",
      "guideContext": "타워크레인 역삼각형 지브 통행로",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-M89-015",
      "text": "계단이나 사다리의 발판 깊이는 200mm로 권장한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE M-129-2013에서 정해진 치수 이외의 권장치수",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-M89-016",
      "text": "계단이나 사다리의 발판 폭은 500mm로 권장한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE M-129-2013에서 정해진 치수 이외의 권장치수",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-M89-017",
      "text": "발끝 여유 틈(사다리 가로대의 중심선으로부터 측정된 치수)은 160mm 이상이 확보되도록 권장한다.",
      "guideContext": "타워크레인 접근통로 및 방책설치 (법령 근거 미확인)",
      "additionalDetail": "KOSHA GUIDE M-129-2013에서 정해진 치수 이외의 권장치수",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M89-001",
      "term": "사다리(Ladder)",
      "definition": "수평면에서 50°이상 90°이하의 연속된 동일간격의 발판이나 디딤대로 구성되어 한발 또는 양발을 지지하기에 적합한 구조로 된 경사진 접근장치(수단) 또는 그 일부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "DT-M89-002",
      "term": "수직사다리(Vertical ladder)",
      "definition": "수평면으로부터 75°이상의 경사각을 가진 사다리로서, 양발을 편리하게 지지할 수 있도록 수직 또는 수직에 가까운 측면 난간(Side rail)과 연속된 동일간격의 디딤대로 구성된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-004"
      ]
    },
    {
      "identifier": "DT-M89-003",
      "term": "계단(Stair)",
      "definition": "수평면으로부터 경사도 65°를 초과하지 않는 곳에 사용되는 것으로서 여러 개의 평면 발판으로 구성된 접근장치 또는 수단을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "DT-M89-004",
      "term": "통로(Walkway)",
      "definition": "크레인의 상부에서 어떠한 두 지점 사이를 걷거나 기어갈 수 있도록 허용된 수평바닥으로 된 접근장치의 일부를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-PASSAGE-003",
        "SR-CRANE-010"
      ]
    },
    {
      "identifier": "DT-M89-005",
      "term": "참(Landing)",
      "definition": "접근로의 중간 또는 끝에 마련된 수평 바닥이 있는 부분으로서 휴식을 하거나 다른 접근수단으로 이동할 때 대기하기 위하여 마련된 장소를 말하며, 대응하는 접근수단과 안전하게 연결시켜 주는 가교의 역할을 하는 부분을 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M89-006",
      "term": "통로 참(Access landing)",
      "definition": "임의의 위치에 안전하게 접근할 수 있도록 크레인 몸체 또는 고소에 위치한 통로의 일부분에 마련된 수평바닥면 또는 그 구성요소를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M89-007",
      "term": "안전난간(Guard rail)",
      "definition": "신체를 지지하거나 균형을 유지하기 위하여 손으로 잡을 수 있는 부분이 있는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "DT-M89-008",
      "term": "작업발판(Platform)",
      "definition": "크레인의 운전, 정비, 검사 또는 보수작업을 위한 작업자를 지탱해 주는 수평 바닥면 또는 그 구성요소를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-001",
        "SR-SCAFFOLD-003"
      ]
    },
    {
      "identifier": "DT-M89-009",
      "term": "발관(디딤판, Step)",
      "definition": "사다리나 계단에서 양발을 지지할 수 있도록 평평한 수평면을 가진 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M89-010",
      "term": "손잡이(Hand hold)",
      "definition": "신체를 지탱하기 위하여 한 손으로 움켜잡을 수 있는 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M89-011",
      "term": "발끝막이(Toe board)",
      "definition": "이탈된 부품이나 작업 중인 공구가 발끝에 차여 아래로 떨어지는 것을 막기 위하여 접근로 바닥면 주변을 따라 수직으로 둘러쳐진 판을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-002"
      ]
    }
  ],
