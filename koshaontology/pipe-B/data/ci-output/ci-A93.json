    {
      "identifier": "WP-A93-04",
      "processOrder": 4,
      "processName": "기기분석 (가스크로마토그래프)",
      "safetyMeasures": "GC 제조회사 권고에 따라 기기를 작동시키고 조건을 설정한다. 주입량 1 μL, 운반가스 헬륨 2.5-3.0 mL/min, 오븐 80℃에서 180℃까지 8℃/분 승온, 주입구 250℃, 검출기 300℃ 조건을 참고한다.",
      "requiredPPE": [],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A93-05",
