  "domainTerms": [
    {
      "identifier": "DT-G131-001",
      "term": "폐기물",
      "definition": "쓰레기, 연소재, 오니, 폐유, 폐산, 폐알칼리 및 동물의 사체 등으로서 사람의 생활이나 사업활동에 필요하지 않게 된 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G131-002",
      "term": "생활폐기물",
      "definition": "폐기물관리법에 따라 배출시설을 설치·운영하는 사업장이나 대통령령으로 정하는 사업장에서 발생하는 사업장 폐기물을 제외한 폐기물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G131-003",
      "term": "암롤트럭(Arm roll truck)",
      "definition": "차량 적재함을 탈·부착하기 위한 장치로 견인도구인 암과, 가이드 장치인 롤이 장착된 차량으로 생활폐기물 운송에 사용되는 트럭을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G131-004",
      "term": "집게차",
      "definition": "특장차의 일종으로 손가락과 같은 집게가 달려있어 오무렸다 폈다 하는 기능이 있는 차량으로 생활폐기물의 수거와 운반에 사용되는 중장비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G131-005",
      "term": "로더 버킷(Loader Bucket)",
      "definition": "트랙터 앞에 블레이드를 부착한 도저와는 달리 블레이드 대신 버킷을 부착한 것을 로더라 하는데, 이때 부착되는 바가지 모양의 도구를 로더 버킷이라 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G131-006",
      "term": "트랙터 수거함",
      "definition": "트랙터에 장착되는 생활폐기물의 수거함 또는 수집함을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G131-007",
      "term": "방호덮개",
      "definition": "위험한 기계나 기구 등의 위험요인으로부터 근로자를 보호하기 위해 기계나 기구 부분을 덮어 불필요한 접촉을 막아 보호하는 덮개를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-G131-01",
      "processOrder": 1,
      "processName": "생활폐기물 수거작업 사전 점검",
      "safetyMeasures": "수거작업 전 체크리스트(별표 1)를 활용하여 자가 점검을 실시한다. 주위 확인, 차량 접근 여부, 작업장 미끄러움, 장애물 유무, 개인보호구 착용 여부 등을 점검한다. 수거작업 전·후에 스트레칭을 실시한다.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보호장갑"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-G131-02",
      "processOrder": 2,
      "processName": "도로변 생활폐기물 수거",
      "safetyMeasures": "발판 등 임의 구조물 탑승 금지, 가까운 거리는 도보 이동. 빙판길·장애물 확인. 반사판 부착 작업복 착용, 차량 후면·측면 반사시트 부착, 정차 시 비상등 점등. 수거용기 손잡이 물기 제거 후 취급.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "미끄럼 방지 장갑",
        "반사판 부착 작업복"
      ],
      "sourceSection": "4.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-G131-03",
      "processOrder": 3,
      "processName": "수거차량 적재 및 운반",
      "safetyMeasures": "적재함 위 탑승 이동 금지, 차량 좌석 탑승 후 이동. 수거차량 뒤 매달림 금지. 회전관 작동 시 접근 금지, 압축판 작동 시 접근 금지 및 레일 덮개 설치. 리프트 탑승 금지, 비상정지 스위치 설치. 트랙터 수거함 방호덮개 설치. 후진 시 유도자 배치 및 후방 감시카메라 설치.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보호장갑"
      ],
      "sourceSection": "4.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-G131-04",
      "processOrder": 4,
      "processName": "대형·위험 폐기물 수거",
      "safetyMeasures": "대형 폐기물(가구, 유리문 등)은 보호장갑 착용, 유리문은 진공 흡착기 사용. 깨진 유리는 별도 용기에 분리 수거. 무거운 물건은 적정 인원 투입 또는 리프트 사용. 인화성 물질 포함 폐기물은 사전 분리수거. 화학물질 잔류 폐기물은 분리작업 후 수거, 반팔·반바지 착용 금지.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보호장갑",
        "보안경"
      ],
      "sourceSection": "4.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-G131-05",
      "processOrder": 5,
      "processName": "생활폐기물 분류·분리 처리",
      "safetyMeasures": "폐지 압축기 작동 시 밀어넣기 금지, 집게 등 도구 사용. 폐품 자루 지게차 적재 시 지게차 작동 금지. 못·유리조각 등 위험물 사전 제거. 파상풍 예방주사 접종. 1m 이상 적재 더미 위 작업 금지.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보호장갑",
        "보안경"
      ],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-G131-06",
      "processOrder": 6,
      "processName": "파쇄물 이송 및 컨베이어 작업",
      "safetyMeasures": "컨베이어 끼임 위험지점에 방호덮개 설치. 작업 전 벨트 이물질 제거. 이물질 제거 시 집게 등 보조기구 사용. 컨베이어 가동 중 끼인 물품 제거 금지, 정지 후 제거.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보호장갑"
      ],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-G131-07",
      "processOrder": 7,
      "processName": "차량계 중장비(집게차·로더) 작업",
      "safetyMeasures": "집게차 작업 시 작업자 적재함 탑승 금지, 동시작업 금지. 집게차·로더 작업 시 작업자와 충분한 안전거리 확보. 로더의 허용적재하중 범위 내 적재.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "WP-G131-08",
      "processOrder": 8,
      "processName": "소각 처리작업",
      "safetyMeasures": "소각 중 청소작업 금지. 불가피 시 방열복·방열장갑 착용. 소각로에 화상주의 경고표지 부착. 빈 드럼통 절단 전 내부 인화성 물질 확인, 잔류 시 화기 사용 절대 금지.",
      "requiredPPE": [
        "방열복",
        "방열장갑",
        "안전모",
        "안전화"
      ],
      "sourceSection": "5.8",
      "relatedSR": null
    },
    {
      "identifier": "WP-G131-09",
      "processOrder": 9,
      "processName": "압축기 정비·청소",
      "safetyMeasures": "주 전원을 차단한 후 작업. 운전패널에 조작금지 경고판 부착 및 시건장치 설치. 감시인 배치.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보호장갑"
      ],
      "sourceSection": "5.4",
      "relatedSR": [
        "SR-CONSTRUCTION_EQUIP-010"
      ]
    }
  ],
