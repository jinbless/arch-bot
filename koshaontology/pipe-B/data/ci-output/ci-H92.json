  "checklistItems": [
    {
      "identifier": "CI-H92-001",
      "text": "사업주는 모든 작업공정에 대한 표준작업지침서를 작성하고 근로자들이 이를 준수하도록 관리 감독한다.",
      "guideContext": "전기도금 사업장 작업관리 (법령 근거 미확인)",
      "additionalDetail": "표준 작업관리지침은 유해물질 발생 억제조치 설비의 설치, 환기장치 가동요령, 보호구 착용 및 관리방법, MSDS 활용 유해성 정보와 응급조치, 근로자 노출방지 사항 등을 포함한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-002",
      "text": "표준작업으로부터 벗어나는 상황은 관리감독자에게 반드시 보고하고 원인 파악과 대책이 수립된 이후에 다시 작업을 시작한다.",
      "guideContext": "전기도금 사업장 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-003",
      "text": "세척조의 청소 및 수리 등 노출 증가가 예상되는 비상시작업에는 반드시 안면보호구, 보안경, 고무장갑, 고무재질의 앞치마, 고무장화 등의 착용을 확인한다.",
      "guideContext": "전기도금 사업장 위험작업 관리",
      "additionalDetail": null,
      "workProcessPhase": "세척조 청소 및 수리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H92-004",
      "text": "독성물질이 발생할 가능성이 있는 주변에서의 위험 작업을 금지한다.",
      "guideContext": "전기도금 사업장 위험작업 관리 (법령 근거 미확인)",
      "additionalDetail": "트리클로로에틸렌을 사용하는 탈지조 주변에서 용접을 하는 경우 염소가스, 염산가스, 그리고 포스겐이 발생할 수 있으므로 용접작업을 금지해야한다.",
      "workProcessPhase": "탈지공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-005",
      "text": "사업주는 도금작업장 특성상 각종 유해물질, 크레인 줄걸이, 작업도구 등이 주변에 널려 있으므로 일정 폭 이상의 안전한 작업장 통로를 개설해 놓아야 한다.",
      "guideContext": "전기도금 사업장 작업장 정리정돈 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-006",
      "text": "사업주는 작업장 바닥에 기름이나 물이 있어 보행시 전도재해가 발생하지 않게 청소와 주변 정리를 관리 감독해야 한다.",
      "guideContext": "전기도금 사업장 작업장 정리정돈",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H92-007",
      "text": "사업주는 보호구를 구입할 때 성능한계성, 검정합격품 여부 등을 사전에 검토하여 구입하고 보호구의 공동사용으로 인한 질병감염을 방지하기 위하여 개인전용의 것을 지급한다.",
      "guideContext": "전기도금 사업장 개인보호구 선택 및 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H92-008",
      "text": "사업주는 유해물질을 취급하는 근로자에게 지급한 개인 보호구가 작업장의 유해물질에 오염되는 것을 방지하고 청결한 상태를 유지하기 위해 적절한 보관함을 설치한다.",
      "guideContext": "전기도금 사업장 개인보호구 선택 및 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H92-009",
      "text": "사업주는 도금사업장에서 발생하는 증기 및 가스상 물질에 맞는 마스크를 지급해야 하며 호흡용보호구의 사용한도시간(파과시간)이 지나면 정화통을 교체해 주어야 한다.",
      "guideContext": "전기도금 사업장 호흡용 보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H92-010",
      "text": "사업주는 호흡용 보호구의 올바른 착용방법에 대해 교육해야 한다.",
      "guideContext": "전기도금 사업장 호흡용 보호구",
      "additionalDetail": "목 끈을 먼저 채운 후 마스크를 턱밑에서 위쪽으로 끼우듯이 착용, 머리끈 채우기, 사이즈 조절, 얼굴 형태에 맞게 조절, 고정, 착용검사 실시 순서로 교육한다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H92-011",
      "text": "사업주는 호흡용 보호구의 사용한도시간(파과시간)과 보호구 교체시기 결정방법에 대해 교육하여야 한다.",
      "guideContext": "전기도금 사업장 호흡용 보호구",
      "additionalDetail": "냄새나 맛 감지 시, 호흡저항 증가 시, 고온·고습도·고호흡량 작업 시 교체시기 단축, 냄새 감지 불가 물질은 사용한도시간과 유해물질 농도 참고하여 주기적 교체",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H92-012",
      "text": "사업주는 눈, 안면, 피부에 튀어 피부 내부로 흡수될 가능성이 높은 산, 알칼리류를 취급하는 근로자에게 눈, 안면 그리고 피부 보호구를 지급해야 한다.",
      "guideContext": "전기도금 사업장 눈·안면·피부 보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H92-013",
      "text": "앞치마는 고무장화의 맨 윗부분보다 아래로 내려와 있어야 하고 이러한 보호구는 적어도 여벌이 하나 더 있어서 갈아입을 수 있도록 해야 한다.",
      "guideContext": "전기도금 사업장 눈·안면·피부 보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H92-014",
      "text": "사업주는 소음이 많이 발생하는 공정에서 작업하는 근로자에게 방음보호구를 지급해야 하며 착용법을 교육해야 한다.",
      "guideContext": "전기도금 사업장 방음보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-015",
      "text": "귀마개는 개인의 외이도에 맞는 것을 사용해야 하며 삽입시 깨끗한 손으로 외이도 형태에 맞게 삽입하고 귀의 염증을 예방하기 위해 청결을 유지해야한다.",
      "guideContext": "전기도금 사업장 방음보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-016",
      "text": "사업주는 허가 및 관리대상 유해물질(트리클로로에틸렌, 1,1,2-트리클로로에탄, 염산, 황산, 초산, 시안화화합물(시안화나트륨, 시안화칼륨), 크롬, 니켈, 카드뮴) 취급 작업을 하는 근로자에게 그 업무와 관계되는 안전·보건에 관한 특별 교육을 실시한다.",
      "guideContext": "전기도금 사업장 특별안전보건교육",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.5.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H92-017",
      "text": "사업주는 밀폐공간에서 이루어지는 폐기물 처리 작업을 하는 근로자에게 그 업무와 관계되는 안전·보건에 관한 특별 교육을 실시한다.",
      "guideContext": "전기도금 사업장 특별안전보건교육",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.5.1",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-H92-018",
      "text": "일용근로자인 경우 2시간 이상 특별안전보건교육을 실시한다.",
      "guideContext": "전기도금 사업장 특별안전보건교육",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.5.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H92-019",
      "text": "일용근로자가 아닌 경우 16시간 이상 교육해야 하며 최초 작업에 종사하기 전 4시간 이상 실시하며 12시간은 3개월 이내에서 분할하여 실시가 가능하다.",
      "guideContext": "전기도금 사업장 특별안전보건교육",
      "additionalDetail": "단기간 작업 또는 간헐적 작업인 경우에는 2시간 이상 교육한다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.5.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H92-020",
      "text": "사업주는 도금, 세척, 탈지공정별 체크리스트를 활용하여 표준작업지침, 보호구 착용, 교육 효과 등에 대한 모니터링을 실시하고 개선해야 할 점을 파악한다.",
      "guideContext": "전기도금 사업장 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-021",
      "text": "사업주는 MSDS를 화학물질을 취급하는 해당 근로자들이 쉽게 볼 수 있는 위치에 비치 및 관리한다.",
      "guideContext": "전기도금 사업장 유해물질 안전관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H92-022",
      "text": "사업주는 각 유해물질을 담고 있는 용기에 유해물질의 이름, 사용상 유의점 등을 적어 놓은 경고표지를 부착 및 관리한다.",
      "guideContext": "전기도금 사업장 유해물질 안전관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H92-023",
      "text": "사업주는 유해물질 취급근로자를 대상으로 MSDS에 대한 교육을 정기적으로 실시한다.",
      "guideContext": "전기도금 사업장 유해물질 안전관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H92-024",
      "text": "사업주는 화학물질저장소는 폭발의 위험이 있으므로 작업장과 격리시켜야 한다.",
      "guideContext": "전기도금 사업장 유해물질 안전관리 (법령 근거 미확인)",
      "additionalDetail": "산과 시안화화합물은 다른 장소에 보관해야 하며 산과 알칼리의 경우에는 서로 다른 색으로 표시하여 실수로 도금조에 첨가하는 일이 없도록 해야 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-025",
      "text": "사업주는 전체 환기장치를 설치 할 경우, 송풍기만으로 전체 환기를 할 경우 원활한 환기를 위하여 배기구를 설치하고, 배풍기만으로 전체 환기를 할 경우 발생원 가까운 곳에 배풍기를 설치하고, 근로자의 후위에 급기구나 급기시설을 설치해야 한다.",
      "guideContext": "전기도금 사업장 환기 대책",
      "additionalDetail": "외부공기 유입 송풍기/급기구에는 필터나 흡착시설 설치, 배출 공기 재유입 방지 조치, 노출기준 미만 유지를 위한 적정 필요 환기량 산정 필요",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2.1",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-H92-026",
      "text": "사업주는 탈지, 산세, 중화, 도금과 같이 유해물질을 취급하는 공정에 대해 기중 오염물질의 감소를 위해 국소배기장치를 설치하여야한다.",
      "guideContext": "전기도금 사업장 국소배기장치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H92-027",
      "text": "사업주는 전처리, 중화, 도금시설이 완전 밀폐되어 있지 않은 경우 국소배기장치의 후드 설치시 반드시 적절한 형태로 설치해야한다.",
      "guideContext": "전기도금 사업장 국소배기장치",
      "additionalDetail": "도금사업장에 가장 권장할만한 형태는 푸쉬풀 형이며 근로자에게 오염물질의 노출이 더 증가될 위험이 있는 캐노피 형은 피해야 한다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H92-028",
      "text": "사업주는 국소배기장치의 제어풍속이 규정 속도 이상으로 가동되고 있는지 확인하여야 하며 규정 속도는 산업안전기준에 관한 보건규칙 [별표 13] 관리대상 유해물질 관련 국소배기장치 후드의 제어풍속(제429조 관련)의 기준을 따라야 한다.",
      "guideContext": "전기도금 사업장 국소배기장치",
      "additionalDetail": "가스 상태: 포위식 0.4m/sec, 외부식 측방/하방 0.5m/sec, 상방 1.0m/sec. 입자 상태: 포위식 0.7m/sec, 외부식 측방/하방 1.0m/sec, 상방 1.2m/sec",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-H92-029",
      "text": "사업주는 산업안전보건법 제36조 및 동법 시행규칙 제74조에 의거하여 작업 중 국소배기장치(제진장치 및 배출가스 처리장치포함)가 효과적으로 작동하고 있는지 확인하기 위해 노동부령이 정하는 자격을 가진 자로 하여금 매년 1회 이상 정기적으로 안전검사를 실시하고 그 결과를 기록, 보존하여야 한다.",
      "guideContext": "전기도금 사업장 국소배기장치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-H92-030",
      "text": "사업주는 근로자대표의 요구가 있을 때에는 자체검사에 근로자대표를 입회시켜야 한다.",
      "guideContext": "전기도금 사업장 국소배기장치 안전검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-031",
      "text": "사업주는 작업환경 실태를 파악하기 위하여 해당 근로자 또는 작업장에 대해 작업환경측정의 계획을 수립하고 시료를 채취하고 분석 평가해야한다.",
      "guideContext": "전기도금 사업장 작업환경평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-032",
      "text": "사업주는 작업환경측정을 하기 전에 예비조사를 실시해야 한다.",
      "guideContext": "전기도금 사업장 작업환경평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-033",
      "text": "작업환경측정은 작업이 정상적으로 이루어져 작업시간과 유해인자에 대한 근로자의 노출 정도를 정확히 평가할 수 있을 때 실시해야 한다.",
      "guideContext": "전기도금 사업장 작업환경평가 (법령 근거 미확인)",
      "additionalDetail": "모든 측정은 개인시료 채취방법으로 하되, 곤란한 경우 지역시료 채취방법으로 실시 가능하나 그 사유를 작업환경측정 결과표에 분명하게 밝혀야 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-034",
      "text": "사업주는 작업환경측정에 관한 서류를 3년간 보존하여야 한다.",
      "guideContext": "전기도금 사업장 작업환경평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-035",
      "text": "크롬, 니켈 등의 발암물질은 노출기준을 초과하면 3개월에 1회 이상 작업환경 측정을 실시하여야 한다.",
      "guideContext": "전기도금 사업장 작업환경평가 (법령 근거 미확인)",
      "additionalDetail": "시안화화합물(시안화나트륨, 시안화칼륨), 트리클로로에틸렌, 1,1,2-트리클로로에탄의 화학적 인자가 노출기준을 2배 이상 초과하면 3개월에 1회 이상",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-036",
      "text": "사업주는 산업안전보건법 제43조에 따라 일반건강진단 외에 특수건강진단과 배치전 건강진단을 반드시 실시해야 한다.",
      "guideContext": "전기도금 사업장 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-037",
      "text": "사업주는 특수건강진단 대상 업무에 종사할 근로자에 대하여 배치 예정업무에 대한 적합성 평가를 위하여 배치전 건강진단을 실시해야 한다.",
      "guideContext": "전기도금 사업장 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-038",
      "text": "사업주는 작업환경측정 결과 또는 특수건강진단 결과에 따라 작업환경측정 결과 노출기준 이상인 작업공정에서 해당 유해인자에 노출되는 모든 근로자, 직업병 유소견자가 발견된 작업공정에서 해당 유해인자에 노출되는 모든 근로자, 또는 의사의 판정을 받은 근로자에 대해서는 다음 회에 한정하여 관련 유해인자별로 특수건강진단 주기를 2분의 1로 단축해서 실시하여야 한다.",
      "guideContext": "전기도금 사업장 근로자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-039",
      "text": "사업주는 응급급성중독, 감전, 폭발 등의 응급 상황에 대비하여 응급처치체계의 구축 및 응급조치 요령의 교육을 실시한다.",
      "guideContext": "전기도금 사업장 응급처치 (법령 근거 미확인)",
      "additionalDetail": "재해구조팀 구성·운영, 비상연락망·비상통신망 구축, 의료기관 응급처치 능력 정보 파악, 예비후송수단 확보, 상호협조체계 구축",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-040",
      "text": "사업주는 재해대비 훈련을 매 분기별 1회 이상 정기적으로 실시하고 평가한다.",
      "guideContext": "전기도금 사업장 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-041",
      "text": "사업주는 응급처치를 위한 구급용구를 비치하고 사용방법을 교육시킨다.",
      "guideContext": "전기도금 사업장 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-042",
      "text": "사업주는 산과 알칼리류에 의한 눈과 피부접촉이 발생했을 때 즉시 오염물을 제거하기 위해 근로자가 쉽게 사용할 수 있는 위치에 긴급 세척시설과 세안설비를 설치한다.",
      "guideContext": "전기도금 사업장 긴급 세척시설",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H92-043",
      "text": "도금조 근처에서 음식물을 먹지 않는다.",
      "guideContext": "전기도금 사업장 개인위생 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "도금공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-044",
      "text": "도금조 근처에서 흡연을 하지 않는다.",
      "guideContext": "전기도금 사업장 개인위생 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "도금공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-045",
      "text": "식사 및 귀가시 반드시 손과 얼굴을 깨끗이 씻는다.",
      "guideContext": "전기도금 사업장 개인위생 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-046",
      "text": "사업주는 환기시설, 작업장 격리와 같은 공정개선이 불가능할 경우 적절한 양질의 보호구를 제공하는 것을 차선책으로 고려해야한다.",
      "guideContext": "전기도금 사업장 개인보호구 선택 및 관리",
      "additionalDetail": "유해요인에 대한 가장 바람직하고 우선적인 대책은 작업설비의 개선을 통한 노출의 감소이다. 개인보호구를 절대적 보호의 개념으로 사용할 경우 더 큰 위험이 발생할 수 있다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H92-047",
      "text": "사업주는 현장 근로자들이 응급처치를 할 수 있도록 채용시 교육과 정기교육시 응급처치에 관한 교육을 포함하여 실시한다.",
      "guideContext": "전기도금 사업장 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H92-001",
      "term": "전기도금",
      "definition": "상품에 내식성과 장식성, 기계적 강도 등을 주기 위한 목적으로 전기에너지를 이용하여 금속 또는 비금속의 표면을 얇은 금속막으로 밀착 피복시키는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H92-002",
      "term": "사용한도시간(파과시간)",
      "definition": "호흡용 보호구의 포집효율의 저하가 없고, 호흡저항의 현저한 상승이 없고, 변형 등에 의한 안면과의 밀착성의 저하가 없는 상태에서 보호구의 기능을 손상하는 일 없이 사용 가능한 시간을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H92-003",
      "term": "푸쉬풀 후드(Push-pull Hood)",
      "definition": "배기에 의한 흡입 기류의 생성 이외에 급기를 위한 분출구를 병설한 후드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H92-004",
      "term": "캐노피 후드(Canopy Hood)",
      "definition": "고온의 오염원으로부터 발생되는 물질의 제거에 적합한 형식의 후드로 오염원의 상부에 설치하여 배기를 하는 후드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
