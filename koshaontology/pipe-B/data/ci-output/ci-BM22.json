  "checklistItems": [
    {
      "identifier": "CI-BM22-001",
      "text": "테일 게이트 안쪽부분의 회전관과 호피와의 틈새(A)는 호피 바닥부에 있어서의 회전관과 호피와의 틈새(B)와 같거나 넓어야 한다.",
      "guideContext": "압착(회전판)식 생활폐기물수거차량 끼임 방지 구조",
      "additionalDetail": null,
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-MACHINE-043"
      ]
    },
    {
      "identifier": "CI-BM22-002",
      "text": "억회전 방지핀이 설치되어있는 생활폐기물수거차량에 있어서는 회전관과 입입관 사이 또는 호피와 회전관 사이에 쓰레기가 물려 들어간 경우에 억회전 방지핀을 쉽게 뺄 수 있어야 한다.",
      "guideContext": "압착(회전판)식 생활폐기물수거차량 끼임 방지 구조",
      "additionalDetail": "억회전 방지핀은 설치되어 있지 않을 수도 있음",
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-MACHINE-043"
      ]
    },
    {
      "identifier": "CI-BM22-003",
      "text": "입입관을 단독으로 조작하여 원상복귀를 최대로 한 경우에는 입입관과 회전관의 회전축과의 틈새(C)가 있어야 한다.",
      "guideContext": "압착(회전판)식 생활폐기물수거차량 끼임 방지 구조",
      "additionalDetail": null,
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-MACHINE-043"
      ]
    },
    {
      "identifier": "CI-BM22-004",
      "text": "테일게이트를 상승시키기 위한 전용동력장치의 밀기 전용실린더(Push cylinder) 등을 구비하여야 한다.",
      "guideContext": "테일게이트 구조",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-005",
      "text": "테일게이트는 불의의 낙하를 방지하기 위해 확실하게 장착할 수 있는 안전 바를 구비하거나 이와 동등 이상의 조치를 취하여야 한다.",
      "guideContext": "테일게이트 구조",
      "additionalDetail": "밀기 전용유압실린더 등이 임의의 위치에 고정(Lock)될 수 있는 기능을 갖추고 있는 것 등이 동등 이상의 조치에 해당",
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-006",
      "text": "압입관이 정상적인 위치에 있지 아니하면 테일게이트를 상승시킬 수 없도록 하는 연동장치가 설치되어 있어야 한다.",
      "guideContext": "테일게이트 구조",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-007",
      "text": "점검, 정비, 청소, 쓰레기 배출 등의 작업을 위해 테일게이트를 상승시킨 경우에 불의의 낙하를 방지하기 위해 자동으로 또는 수동으로 확실하게 장착할 수 있는 안전 바를 갖추거나 이와 동등 이상의 조치를 취하여야 한다.",
      "guideContext": "테일게이트 구조",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-008",
      "text": "상승시킨 테일게이트 아래에 근로자가 들어가서 점검, 정비, 수리, 청소 등의 작업을 수행하는 경우에 생활폐기물수거차량의 운전석에서는 테일게이트를 하강시킬 수 없도록 연동장치가 적재함 후방에 설치되어 있어야 한다.",
      "guideContext": "테일게이트 구조",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 하부 점검·정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009",
        "SR-CONSTRUCTION_EQUIP-010"
      ]
    },
    {
      "identifier": "CI-BM22-009",
      "text": "테일게이트를 상승시키기 위한 동력장치로 유압을 사용하는 경우에는 테일게이트가 상승 중이거나 상승 후 정지한 경우에 동력장치의 유압용 고무호스의 파손, 피팅의 분리 등에 의해 유압이 비정상적으로 저하될 때 테일게이트가 낙하하지 않는 기능을 가져야 한다.",
      "guideContext": "테일게이트 구조",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-010",
      "text": "테일게이트의 낙하를 방지하기 위해 안전 바는 충분한 강도를 가져야 한다.",
      "guideContext": "안전 바 요건",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-011",
      "text": "안전 바의 재료는 한국산업표준 KS D 3542 고 내후성 압연 강재에 적합한 것 또는 이와 동등 이상의 방청재료이거나, 방청을 위한 도금 코팅, 방청 도장 등이 되어있어야 한다.",
      "guideContext": "안전 바 요건",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-012",
      "text": "사람이 적재함과 테일게이트 사이에 끼이는 것을 방지하기 위하여 안전 바의 길이가 충분하여야 한다.",
      "guideContext": "안전 바 요건",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-013",
      "text": "안전바의 균열 등 결함 여부를 외관 검사로 확인하여야 한다.",
      "guideContext": "안전 바 요건",
      "additionalDetail": null,
      "workProcessPhase": "점검·정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-014",
      "text": "유압에 의해 자동으로 정해진 위치에 장착되는 방식의 안전 바에 있어서는 테일게이트가 상승 중이거나 상승 후 정지한 경우에 유압용 고무호스의 손상, 피팅 분리 등에 의해 압력이 비정상적으로 저하될 때 테일게이트가 낙하하지 않는 기능을 가져야 한다.",
      "guideContext": "안전 바 요건",
      "additionalDetail": null,
      "workProcessPhase": "테일게이트 상승·점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-009"
      ]
    },
    {
      "identifier": "CI-BM22-015",
      "text": "회전관과 호피 입구부분의 내벽 사이에는 쓰레기를 투입하는 근로자의 손이 말려들지 않도록 적절한 틈새(D)가 있어야 한다.",
      "guideContext": "압착(회전판)식 생활폐기물수거차량 끼임 방지 구조",
      "additionalDetail": null,
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-MACHINE-043"
      ]
    },
    {
      "identifier": "CI-BM22-016",
      "text": "적입 작동 방식은 1사이클 정지 방식, 회전관 일단 정지 방식, 또는 광전관에 의해 감지되어 회전관이 즉시 자동 정지하는 광전관 방식 중 어느 하나에 적합한 것이어야 한다.",
      "guideContext": "적입 작동",
      "additionalDetail": "광전관 방식의 경우 연속 작동 방식으로 할 수 있음",
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-MACHINE-043"
      ]
    },
    {
      "identifier": "CI-BM22-017",
      "text": "회전관의 적입 사이클은 10초 이상 13초 이내이며, 이 범위에서 사이클을 설정한 경우에는 이것을 변경하지 못하도록 봉인하거나, 이와 동등 이상의 조치를 강구하여야 한다.",
      "guideContext": "적입 사이클 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-018",
      "text": "생활폐기물수거차량의 후방 조작반에 설치된 적입 조작 버튼 스위치는 적입 기동스위치, 회전관 억회전 기동스위치, 압입관 압입 기동스위치, 압입관 원상복귀 기동스위치, 비상정지스위치의 순서대로 위에서 아래로 설치되어 있어야 한다.",
      "guideContext": "적입 조작용 버튼 스위치 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-019",
      "text": "적입 기동스위치에서 압입관 원상복귀 기동스위치까지의 기동 스위치는 흑색의 머리 묻힘형으로 하고 각각 1개만 설치하여야 한다.",
      "guideContext": "적입 조작용 버튼 스위치 구조 (법령 근거 미확인)",
      "additionalDetail": "정지 스위치를 겸용하는 것을 포함",
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-020",
      "text": "비상 정지 스위치는 빨간색의 버섯(돌출)형이어야 한다.",
      "guideContext": "적입 조작용 버튼 스위치 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-021",
      "text": "쓰레기를 투입하는 근로자가 쓰레기 투입구의 어느 위치에 있어도 작동시킬 수 있는 비상정지장치를 설치하여야 한다.",
      "guideContext": "비상정지장치 (법령 근거 미확인)",
      "additionalDetail": "가압도전 고무제 감압 센서 방식, 플랙시블 센서 방식, 소형 감압 고무 스위치 방식, 기계식 또는 동등 이상의 기능을 갖는 방식",
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-022",
      "text": "쓰레기 투입구의 양쪽 끝에 각각 1개 이상의 비상정지 스위치를 갖추고 있어야 한다.",
      "guideContext": "비상정지장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-023",
      "text": "생활폐기물수거차량의 후진 시에 경보음 및 경광등을 작동할 것",
      "guideContext": "경보장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-024",
      "text": "테일 게이트 상승 중 및 하강 중에 경보음 및 경광등을 작동할 것",
      "guideContext": "경보장치 (법령 근거 미확인)",
      "additionalDetail": "확실하게 수동으로 장착할 수 있는 안전바를 갖추고 있는 것에 있어서는 테일게이트가 상승하여 안전바가 장착될 때까지를 포함",
      "workProcessPhase": "테일게이트 상승·하강",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-025",
      "text": "압축식 생활폐기물수거차량의 적입사이클은 10초 이상 23초 이내로 하되, 최대적재하중이 2톤을 초과하는 것에 있어서는 13초 이상 18초 이내로 할 수 있다.",
      "guideContext": "압축식 생활폐기물수거차량 (법령 근거 미확인)",
      "additionalDetail": "회전관을 압축관으로 대체 적용",
      "workProcessPhase": "쓰레기 투입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-026",
      "text": "생활폐기물 수거차량의 후미에 매달린 상태에서 차량을 운행하지 않도록 한다.",
      "guideContext": "기타 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-027",
      "text": "소화기를 비치하여야 한다.",
      "guideContext": "기타 안전사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM22-028",
      "text": "차량 주변의 작업자에 대한 충돌·끼임 방지조치를 마련한다.",
      "guideContext": "기타 안전사항",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BM22-001",
      "term": "생활폐기물",
