# docker-compose.airgap.yml 용 환경변수.
#   서버에서 이 파일을 ".env"로 복사 후 값을 채운다:  cp .env.example .env
# (compose가 같은 폴더의 .env를 자동으로 읽어 ${...} 치환 + 컨테이너 주입한다.)

# ── OpenAI (런타임 필수) ─────────────────────────────────────────────
# Vision(gpt-4.1) + 임베딩(text-embedding-3-small) + rerank(gpt-4.1-mini)에 사용.
# ★ 서버가 api.openai.com 으로 아웃바운드 HTTPS가 가능해야 서비스가 동작한다.
#   (레지스트리/GitHub는 막혀도 무방하지만 OpenAI API는 열려 있어야 함.)
OPENAI_API_KEY=sk-여기에-키

# ── 서버의 기존 PostgreSQL(kosha) 접속 ───────────────────────────────
# ★ 운영은 강한 비밀번호 사용(아래는 placeholder).
# (A) PG가 호스트 5432 포트를 publish → host.docker.internal (기본, extra_hosts로 매핑됨):
DATABASE_URL=postgresql://kosha:CHANGE_ME@host.docker.internal:5432/kosha
# (B) PG가 docker 네트워크에만 있음 → compose의 kosha-shared 네트워크 주석 해제 후 컨테이너명 사용:
# DATABASE_URL=postgresql://kosha:CHANGE_ME@<pg-컨테이너명>:5432/kosha

# ── 업로드한 ChromaDB 디렉토리의 서버상 절대경로 ─────────────────────
# load_and_up.sh가 ohs-chromadb.tar.gz를 이 경로에 풀고, compose가 /app/data/chromadb로 mount.
CHROMADB_HOST_DIR=/srv/ohs/chromadb

# ── shared/reference (canonical_vocab.py + JSON, 런타임 import·SSOT) ──
# load_and_up.sh가 ohs-shared-reference.tar.gz를 이 경로에 풀고, compose가 /app/shared/reference로 mount(ro).
SHARED_REF_HOST_DIR=/srv/ohs/shared-reference

# ── (옵션) 서빙 플래그 — 미지정 시 코드 기본값(hybrid on, rerank on, guide_section off) ──
# OHS_ENABLE_HYBRID_SEARCH=true
# OHS_ENABLE_SEMANTIC_RERANK=true
# OHS_ENABLE_GUIDE_SECTION=false
