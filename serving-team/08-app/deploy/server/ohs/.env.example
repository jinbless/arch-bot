# ohs 스택 환경변수 — 서버에서 ".env"로 복사 후 채우기:  cp .env.example .env
# (compose가 같은 폴더 .env를 자동으로 읽어 ${...} 치환 + 컨테이너 주입)

# OpenAI — 런타임 필수 (Vision gpt-4.1 + 임베딩 + rerank). 서버가 api.openai.com 나갈 수 있어야 함.
OPENAI_API_KEY=sk-여기에-진짜-키

# 전용 PG 비밀번호 (DATABASE_URL과 자동 일치). 그대로 둬도 됨(내부망 전용).
POSTGRES_PASSWORD=1229

# 업로드·압축해제한 ChromaDB 디렉토리의 서버상 절대경로. /app/data/chromadb로 mount됨.
CHROMADB_HOST_DIR=/srv/ohs/chromadb
