sr:SR-PILOT_MACHINE-007 a sr:SafetyRequirement ;
    kosha:coApplicable sr:SR-PILOT_MACHINE-008,
        sr:SR-PILOT_MACHINE-009,
        sr:SR-PILOT_MACHINE-010,
        sr:SR-PILOT_MACHINE-011 ;
    kosha:identifier "SR-PILOT_MACHINE-007"^^xsd:string ;
    kosha:text "사업주는 원심기에는 덮개를 설치하여 회전 중 발생할 수 있는 비산물의 충격 및 회전부 접촉으로 인한 근로자의 위험을 방지하여야 한다."^^xsd:string ;
    kosha:title "제87조 제7항: 원심기 덮개 설치 의무"^^xsd:string ;
    sr:addressesHazard hazard:CAUGHT_IN,
        hazard:STRUCK_BY ;
    sr:derivedFromNS law:NS-RULE87-6 ;
    sr:directlyAppliesToArticle law:RULE_제87조 ;
    sr:hasBindingForce kosha:Mandatory ;
    sr:hasRequirementType sr:PhysicalProtection .

sr:SR-PILOT_MACHINE-008 a sr:SafetyRequirement ;
    kosha:coApplicable sr:SR-PILOT_MACHINE-009,
        sr:SR-PILOT_MACHINE-010,
        sr:SR-PILOT_MACHINE-011 ;
    kosha:identifier "SR-PILOT_MACHINE-008"^^xsd:string ;
    kosha:text "사업주는 분쇄기등을 가동하거나 원료가 흩날려 근로자가 위험해질 우려가 있는 경우 해당 부위에 덮개를 설치하는 등 필요한 조치를 하여야 하며, 가동 중 덮개를 열어야 하는 경우에는 정지·연동장치·감응형 방호장치 등 각 호의 어느 하나 이상의 안전조치를 하여야 한다."^^xsd:string ;
    kosha:title "제87조 제8항: 분쇄기 덮개 설치 및 가동 중 안전조치"^^xsd:string ;
    sr:addressesHazard hazard:CAUGHT_IN,
        hazard:STRUCK_BY ;
    sr:derivedFromNS law:NS-RULE87-7 ;
    sr:directlyAppliesToArticle law:RULE_제87조 ;
    sr:hasBindingForce kosha:Mandatory ;
    sr:hasRequirementType sr:PhysicalProtection .

