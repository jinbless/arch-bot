          "hasSubjectRole": "사업주",
          "hasAction": "사람이 없는지 미리 확인한 후 작업을 실시해야 하고, 관계 근로자가 아닌 사람의 출입을 금지해야 한다",
          "hasObject": "해체작업 반경 내 안전 확인 및 출입 금지",
          "hasCondition": {
            "conditionType": "QUALITATIVE",
            "text": "구축물등의 해체작업 시 무너뜨리는 작업을 하는 경우"
          }
        },
