      "category": "WORKPLACE",
      "nsGroup": [
        {
          "identifier": "NS-RULE3-0",
          "paragraphRef": "제3조 제1항",
          "text": "사업주는 근로자가 작업장에서 넘어지거나 미끄러지는 등의 위험이 없도록 작업장 바닥 등을 안전하고 청결한 상태로 유지하여야 한다.",
          "hasModality": "OBLIGATION",
          "hasSubjectRole": "사업주",
          "hasAction": "유지하여야 한다",
          "hasObject": "작업장 바닥 등의 안전하고 청결한 상태",
          "hasCondition": {
            "conditionType": "QUALITATIVE",
            "text": "근로자가 작업장에서 넘어지거나 미끄러지는 등의 위험이 없도록"
          }
        },
        {
          "identifier": "NS-RULE3-1",
          "paragraphRef": "제3조 제2항",
          "text": "사업주는 제품, 자재, 부재(部材) 등이 넘어지지 않도록 붙들어 지탱하게 하는 등 안전 조치를 하여야 한다.",
          "hasModality": "OBLIGATION",
          "hasSubjectRole": "사업주",
          "hasAction": "안전 조치를 하여야 한다",
          "hasObject": "제품, 자재, 부재 등의 전도 방지",
          "hasCondition": null
        }
      ],
      "exemptionNS": [
        {
          "identifier": "NS-RULE3-2",
          "text": "근로자가 접근하지 못하도록 조치한 경우에는 그러하지 아니하다.",
          "hasModificationLink": {
