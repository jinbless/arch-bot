          "violation_employer": {
            "law": "산업안전보건법 제168조 제1호 (제39조 경유)",
            "penalty": "5년 이하의 징역 또는 5천만원 이하의 벌금"
          },
          "violation_contractor": {
            "law": "산업안전보건법 제169조 제1호 (제63조 경유)",
