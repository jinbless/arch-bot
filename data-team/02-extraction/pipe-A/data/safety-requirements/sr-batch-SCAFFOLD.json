    {
      "identifier": "SR-SCAFFOLD-003",
      "title": "높이 2m 이상 비계 작업발판 구조기준",
      "text": "사업주는 비계(달비계, 달대비계 및 말비계 제외)의 높이가 2미터 이상인 작업장소에 작업발판을 설치하여야 한다. 발판재료는 작업하중을 견딜 수 있도록 견고한 것으로 하고, 작업발판의 폭은 40센티미터 이상, 발판재료 간의 틈은 3센티미터 이하로 하여야 한다. 추락 위험이 있는 장소에는 안전난간을 설치하고, 작업발판 지지물은 하중에 의하여 파괴될 우려가 없는 것을 사용하며, 작업발판재료는 뒤집히거나 떨어지지 않도록 둘 이상의 지지물에 연결하거나 고정시켜야 한다.",
      "requirementType": "PHYSICAL_PROTECTION",
      "bindingForce": "MANDATORY",
      "referencesArticle": ["제56조"],
      "mandatedBy": ["NS-RULE56-0"],
      "addressesHazard": ["FALL", "SCAFFOLDING"],
      "structuralRequirements": {
        "items": [
          {"parameter": "비계 높이", "condition": ">=", "value": 2, "unit": "m", "source": "제56조 본문"},
          {"parameter": "작업발판 폭", "condition": ">=", "value": 40, "unit": "cm", "source": "제56조 제2호"},
          {"parameter": "발판재료 간 틈", "condition": "<=", "value": 3, "unit": "cm", "source": "제56조 제2호"}
