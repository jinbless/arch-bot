      "nsGroup": [
        {
          "identifier": "NS-RULE422-0",
          "paragraphRef": "제422조 본문",
          "text": "사업주는 근로자가 실내작업장에서 관리대상 유해물질을 취급하는 업무에 종사하는 경우에 그 작업장에 관리대상 유해물질의 가스ㆍ증기 또는 분진의 발산원을 밀폐하는 설비 또는 국소배기장치를 설치하여야 한다.",
          "hasModality": "OBLIGATION",
          "hasSubjectRole": "사업주",
          "hasAction": "밀폐하는 설비 또는 국소배기장치를 설치하여야 한다",
          "hasObject": "밀폐설비 또는 국소배기장치",
          "hasCondition": {
            "conditionType": "QUALITATIVE",
            "text": "근로자가 실내작업장에서 관리대상 유해물질을 취급하는 업무에 종사하는 경우"
          }
        }
      ],
      "exemptionNS": [
        {
          "identifier": "NS-RULE422-1",
          "text": "분말상태의 관리대상 유해물질을 습기가 있는 상태에서 취급하는 경우에는 밀폐설비나 국소배기장치를 설치하지 아니할 수 있다.",
          "hasModificationLink": {
            "modificationType": "PROVISO",
