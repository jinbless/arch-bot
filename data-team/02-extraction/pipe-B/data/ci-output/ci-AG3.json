  "domainTerms": [
    {
      "identifier": "DT-AG3-001",
      "term": "머플러",
      "definition": "오토바이에서 배기 가스가 배출될 때 나는 폭음을 줄이거나 없애는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG3-002",
      "term": "보차도 경계석",
      "definition": "차량의 무단 인도 진입을 막아 보행자를 보호하기 위해 설치한 돌을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-AG3-01",
      "processOrder": 1,
      "processName": "운행 전 점검",
      "safetyMeasures": "매일 오토바이 운행 전에 브레이크, 변속기 등에 대한 안전점검을 실시하고, 타이어 상태를 점검하며, 페달 등에 신발이 끼지 않도록 확인한다. 이상 발견 시 즉시 보수, 교체 등 안전조치를 한다. 운전 전에 신발 끈, 복장 등을 단정히 한다.",
      "requiredPPE": [
        "승차용 안전모",
        "무릎보호대",
        "보호장갑",
        "팔꿈치보호대"
      ],
      "sourceSection": "4.4",
      "relatedSR": [
        "SR-SPECIAL_WORKER-002"
      ]
    },
    {
      "identifier": "WP-AG3-02",
      "processOrder": 2,
      "processName": "오토바이 운행",
      "safetyMeasures": "전방 주시를 확실히 하고, 교통신호를 철저히 준수하며, 안전거리를 유지한다. 골목길에서는 서행운전을 하고, 중앙선 침범과 과속을 금한다. 겨울철에는 결빙상태를 확인하고 서행운전한다. 주위가 어두울 때는 전조등을 켠다.",
      "requiredPPE": [
        "승차용 안전모",
        "무릎보호대",
        "보호장갑",
        "팔꿈치보호대"
      ],
      "sourceSection": "4.3",
      "relatedSR": [
        "SR-SPECIAL_WORKER-002"
      ]
    },
    {
      "identifier": "WP-AG3-03",
      "processOrder": 3,
      "processName": "도보 배달 (건물 출입 및 계단 이동)",
      "safetyMeasures": "계단을 내려갈 때는 뛰지 말고 난간을 잡고 천천히 내려간다. 어두운 장소에서는 휴대용 손전등을 사용한다. 빙판 위를 지나야 할 경우 모래 또는 흙을 뿌리는 등 조치를 한다. 문 개폐 시 손잡이를 이용하여 끼임을 방지한다. 배달통에서 음식을 꺼낼 때 머플러 화상에 주의한다.",
      "requiredPPE": [
        "미끄럼 방지 신발",
        "휴대용 손전등"
      ],
      "sourceSection": "4.1.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-AG3-04",
      "processOrder": 4,
      "processName": "운행 후 정비",
      "safetyMeasures": "평소 오토바이를 철저하게 정비하고, 사업주는 정기적으로 오토바이를 점검하여 이상 발견 시 즉시 수리 또는 교체한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-SPECIAL_WORKER-002"
      ]
    }
  ],
