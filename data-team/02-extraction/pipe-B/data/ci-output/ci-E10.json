  "domainTerms": [
    {
      "identifier": "DT-E10-001",
      "term": "축전지(Electric storage batteries)",
      "definition": "전기에너지를 화학에너지로 바꿔 모아두고, 필요할 때 다시 전기에너지로 바꿔 쓰는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E10-002",
      "term": "알칼리축전지(Alkaline batteries)",
      "definition": "수산화물질과 같은 알칼리용액으로 전해액이 구성된 축전지를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E10-003",
      "term": "연축전지",
      "definition": "양극판(PbO2), 음극판(Pb), 격리판, 전해액(H2SO4) 및 전조(Container)로 되어 있는 축전지를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E10-004",
      "term": "개방 축전지(Vented batteries)",
      "definition": "가스제거장치 없이 대기로 가스가 방출되는 구조의 축전지를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E10-005",
      "term": "단자(Terminal)",
      "definition": "전기회로에서 전류가 흘러 들어가거나, 나오도록 만든 장치를 말하며, 하나 또는 그 이상의 회로요소가 단자에 연결되어 복잡한 회로망을 구성한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E10-006",
      "term": "무정전 전원장치(Uninterruptible power supply)",
      "definition": "상용전원에서의 전원 장애를 극복하고자, 좋은 품질의 안정된 교류전력을 공급하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    }
