  "domainTerms": [
    {
      "identifier": "DT-E139-001",
      "term": "비상 조명(Emergency lighting)",
      "definition": "정상적인 전원 공급이 중단되었을 때 사용되는 조명을 말하며, 비상구 조명, 위험지역작업조명, 대기조명을 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E139-002",
      "term": "지속형 비상 등기구(Maintained emergency luminaries)",
      "definition": "정상 조명 또는 비상 조명이 항상 동작하는 비상조명 램프를 내장한 등기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E139-003",
      "term": "비지속형 비상 등기구(Non-maintained emergency luminaries)",
      "definition": "일반 조명이 고장 났을 경우에만 동작하는 비상조명 램프를 내장한 등기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E139-004",
      "term": "복합형 비상 등기구(Combined emergency luminaries)",
      "definition": "적어도 하나의 램프는 비상 전원으로부터 공급받고, 나머지는 정상 전원으로부터 공급받는 2개 또는 그 이상의 램프를 가진 등기구를 말하며, 복합형 등기구는 지속형 비상 등기구거나 또는 비지속형 비상 등기구이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E139-005",
      "term": "자체 내장형 비상 등기구(Self-contained emergency luminaries)",
      "definition": "배터리, 램프, 제어장치 그리고 자체 진단과 모니터 시설과 같은 모든 구성 요소가 등기구 또는 그것에 인접하여 포함되어 있는 지속형 또는 비직속형 비상 조명을 제공하는 등기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E139-006",
      "term": "중앙전원 공급형 비상 등기구(Centrally supplied emergency luminaries)",
      "definition": "중앙비상 전력시스템으로부터 전원을 공급받는 지속형 또는 비지속형 비상 등기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E139-007",
      "term": "비상 등기구의 정격 광출력(Emergency luminaries rated lumen output)",
      "definition": "정상 전원이 고장난 후에 동작의 정격 시간에서 등기구 제조자에 의해 60 초(위험작업지역 등기구에 대해 0.25 초) 동안 제시되는 광출력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E139-008",
      "term": "비상 모드(Emergency mode)",
      "definition": "정상전원이 고장났을 때 내부 전원에 의해 조명을 하는 자체 내장 비상 등기구의 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E139-01",
      "processOrder": 1,
      "processName": "비상 등기구 분류 및 표시 확인",
      "safetyMeasures": "형식, 동작모드, 부수장치, 정격기간을 등기구에 명확히 표시하고, 분류 코드(형태, 동작 모드, 장치, 비상모드 최소 기간)를 해당 칸에 문자 또는 그림으로 완성한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-E139-02",
      "processOrder": 2,
      "processName": "비상 등기구 표시사항 검사",
      "safetyMeasures": "정격전압, 세부 분류 사항, 대체 램프 정보, 주위 온도 범위, 퓨즈/지시 램프, 배터리 정보, 제조년월, 복합형 램프 구분(녹색 점 지름 5mm), 경고표시 등 표시사항을 육안 검사로 확인한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-E139-03",
      "processOrder": 3,
      "processName": "전원 내장형 등기구 광출력 시험",
      "safetyMeasures": "최소 정격 전압의 0.9배로 24시간 충전 후 내부 배터리로부터 비상 모드로 동작시키며, 새로운 램프를 사용하여 정격 광출력(5초 내 50%, 60초 후 100%)을 측정한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-E139-04",
      "processOrder": 4,
      "processName": "중앙 전원 공급형 등기구 광출력 시험",
      "safetyMeasures": "안정한 열 조건에 이르렀을 때 최소 정격 전압의 0.85배에서 동작시키며, 새로운 램프를 사용하고 케이블 전압 강하를 고려하여 광출력을 측정한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-E139-05",
      "processOrder": 5,
      "processName": "비상 안전표지 휘도 측정",
      "safetyMeasures": "휘도는 각 색의 표면에 대해 10mm 지름 영역에서 측정하고, 2개 인접 색 사이의 휘도비 측정 시 경계면 15mm 거리에서 수행하며, 계측기 오차 10% 이하를 확인한다. 측정값은 규격 값 이상이어야 한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    }
  ],
