  "domainTerms": [
    {
      "identifier": "DT-C88-001",
      "term": "NTR공법",
      "definition": "강관을 압입과 동시에 내부토사를 굴착하여, 강관 내부에 작업공간을 확보한 다음 강관과 강관 사이 측부를 단계별로 절단하고, 절단된 단면 사이를 강판을 이용하여 용접에 의한 구조물 시공단면을 만든 상태에서, 철근조립 및 콘크리트 타설로 지중에 비개착식 터널을 축조하는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C88-002",
      "term": "그라우팅",
      "definition": "균열이나 공동(空洞) 등의 틈새에 그라우트(주입액)를 주입하거나 충전(充填)하는 일을 말한다. 토목공사에서 누수방지 공사(漏水防止工事)나 토질안정(土質安定) 등을 위하여 지반의 갈라진 틈・공동(空洞) 등에 충전재를 주입하는 일을 말하며, 또한 그때 주입하는 주입재도 그라우트 또는 그라우트재라고 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C88-003",
      "term": "유압슉",
      "definition": "펼프에 의해 압력유를 실린더로 보내 램을 움직여 강관을 시공 전면에 압입시키는 추진 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C88-004",
      "term": "발진기지",
      "definition": "강관을 추진하기 위하여 토류 가시설을 설치하고 지반을 굴착한 작업장소를 말하며, 이 추진기지에는 강관 추진을 위한 반력벽이 설치된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C88-005",
      "term": "반력벽",
      "definition": "강관 추진을 위해 추진기지에 설치되는 콘크리트 벽체를 말하며, 유압슉의 최대압력과 소요의 안전율을 고려한 설계압력에 저항할 수 있는 구조와 규모로 설치된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C88-006",
      "term": "TRM공법",
      "definition": "강관을 유압슉으로 압입한 후 강관내부 및 구조물의 벽체와 강관내에 콘크리트를 타설하여 완성시키는 공법이다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
