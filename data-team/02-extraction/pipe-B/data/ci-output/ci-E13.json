  "domainTerms": [
    {
      "identifier": "DT-E13-001",
      "term": "정전기",
      "definition": "전계의 영향은 크나 자계의 영향이 상대적으로 미미한 전기를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E13-002",
      "term": "정전기 방전",
      "definition": "대전체로 인한 방전, 불꽃방전, 브리시방전 등의 형태로 정전기를 방출시키는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E13-003",
      "term": "도전성",
      "definition": "전하의 흐름을 허용하는 정도를 말하며, 이 지침에서는 도전율 10⁴ pS/m 이상(또는 저항율 10⁸ Ω·m 이하)을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E13-004",
      "term": "본딩",
      "definition": "둘 또는 그 이상의 도전성 물질이 같은 전위를 갖도록 도체로 접속하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E13-005",
      "term": "제전복",
      "definition": "합성섬유 및 인조섬유에 정전기 축적을 방지하고 도전율을 높이기 위해 도전성 섬유를 혼입한 작업복을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    }
  ],
