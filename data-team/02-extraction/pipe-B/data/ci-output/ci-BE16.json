  "checklistItems": [
    {
      "identifier": "CI-BE16-001",
      "text": "사업주는 근로자가 노출된 충전부 또는 그 부근에서 작업함으로써 감전될 우려가 있는 경우에는 작업에 들어가기 전에 해당 전로를 차단하여야 한다.",
      "guideContext": "전기설비 정비 시 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "다만, 생명유지장치·비상경보설비 등의 가동 중지로 사고 위험 증가, 기기 설계상 전로차단 불가능, 감전·아크 등 위험이 없는 것으로 확인된 경우는 제외",
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-002",
      "text": "전기기기등에 공급되는 모든 전원을 관련 도면, 배선도 등으로 확인할 것",
      "guideContext": "전로 차단 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-003",
      "text": "전원을 차단한 후각 단로기 등을 개방하고 확인할 것",
      "guideContext": "전로 차단 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-004",
      "text": "차단장치나 단로기 등에 잠금장치 및 꼬리표를 부착할 것",
      "guideContext": "전로 차단 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-005",
      "text": "개로된 전로에서 유도전압 또는 전기에너지가 축적되어 근로자에게 전기위험을 끼칠 수 있는 전기기기등은 접촉하기 전에 잔류전하를 완전히 방전시킬 것",
      "guideContext": "전로 차단 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-006",
      "text": "검전기를 이용하여 작업 대상 기기가 충전되었는지를 확인할 것",
      "guideContext": "전로 차단 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-007",
      "text": "전기기기등이 다른 노출 충전부와의 접촉, 유도 또는 예비동력원의 역송전 등으로 전압이 발생할 우려가 있는 경우에는 충분한 용량을 가진 단락 접지기구를 이용하여 접지할 것",
      "guideContext": "전로 차단 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-008",
      "text": "작업기구, 단락 접지기구 등을 제거하고 전기기기등이 안전하게 통전될 수 있는지를 확인할 것",
      "guideContext": "전원 복구 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 후 전원 복구",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-009",
      "text": "모든 작업자가 작업이 완료된 전기기기등에서 떨어져 있는지를 확인할 것",
      "guideContext": "전원 복구 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 후 전원 복구",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-010",
      "text": "잠금장치와 꼬리표는 설치한 근로자가 직접 철거할 것",
      "guideContext": "전원 복구 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 후 전원 복구",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-011",
      "text": "모든 이상 유무를 확인한 후 전기기기등의 전원을 투입할 것",
      "guideContext": "전원 복구 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 후 전원 복구",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-012",
      "text": "사업주는 근로자가 전기위험에 노출될 수 있는 정전전로 또는 그 인근에서 작업하거나 정전된 전기기기 등(고정 설치된 것으로 한정한다)과 접촉할 우려가 있는 경우에 작업 전에 제319조제2항제3호의 조치를 확인하여야 한다.",
      "guideContext": "정전전로 인근 전기작업 (법령 근거 미확인)",
      "additionalDetail": "제319조제2항제3호: 차단장치나 단로기 등에 잠금장치 및 꼬리표를 부착할 것",
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-013",
      "text": "통전상태에서 정비작업을 하여서는 아니 된다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": "다만, 정전상태에서의 정비작업이 오히려 더 큰 위험을 초래할 수 있을 경우 사전 안전조치를 실시한 후 통전상태에서 작업할 수 있다.",
      "workProcessPhase": "정비작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-014",
      "text": "활선근접작업인 경우에는 로프, 고무담요 등으로 위험지역을 격리시켜야 하며, 절연모, 절연장갑, 절연공구를 사용하는 등 사전 안전조치를 하여야 한다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "활선근접 정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-015",
      "text": "절연모, 절연장갑, 절연공구, 고무담요 같은 절연기구는 주기적으로 이상 유무를 시험하여야 한다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-016",
      "text": "활선 또는 활선근접장소에서 정비작업을 하는 경우 해당 작업에 적합한 개인보호구를 착용하여야 한다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "활선근접 정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-017",
      "text": "전원개폐기에는 개방된 상태에서 잠금장치를 설치하고, 담당자의 이름, 연락처 등의 정보가 기입된 꼬리표(Tag)를 부착하여야 한다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-018",
      "text": "정비작업 시 단락접지를 시행하는 경우에는 작업시작 전 단락접지에 관한 안전교육을 실시하여야 한다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-019",
      "text": "전기적 불꽃이나 아크에 의한 화상의 우려가 높은 장소에서 작업을 하는 경우에는 방염처리된 작업복 또는 난연(難燃)성능을 가진 작업복을 착용하여야 한다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "활선근접 정비작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-020",
      "text": "배전반, 전기관넬, 전동기제어반 등 통전상태에서 전기작업을 할 가능성이 높은 설비에는 섬락(Flashover)의 위험을 경고하는 표지가 설치되어야 한다.",
      "guideContext": "예방정비 계획 - 작업자 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-021",
      "text": "정비 작업은 사전 계획된 생산 중단 일정을 감안하여 실시하여야 한다.",
      "guideContext": "예방정비 계획 - 생산 영향 (법령 근거 미확인)",
      "additionalDetail": "생산설비 및 전원의 이중화는 운전 중단으로 인한 생산 손실을 최소화 시킬 수 있다.",
      "workProcessPhase": "정비작업 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-022",
      "text": "임시전원 공급설비는 현재와 미래의 중설부하까지 만족할 수 있도록 용량을 선정하여야 한다.",
      "guideContext": "예방정비 계획 - 생산 영향 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-023",
      "text": "정비 작업은 안전작업지침과 작업절차에 관한 교육을 이수한 숙련 작업자에 의해 수행되어야 한다.",
      "guideContext": "예방정비 계획 - 숙련 정비작업자 확보 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-024",
      "text": "정비작업자는 해당 전기장비 또는 시스템과 관련된 특정 정비 작업, 시험 방법, 시험 장비, 개인보호장비(PPE) 사용법(해당되는 경우) 및 위험원에 대한 교육을 받아야 한다.",
      "guideContext": "예방정비 계획 - 숙련 정비작업자 확보 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-025",
      "text": "사업주는 최소 연 1회의 점검을 통해 모든 작업자가 규정에서 요구하는 전기설비의 정비 절차 및 시험을 준수하고 있는지 확인해야 한다.",
      "guideContext": "예방정비 계획 - 숙련 정비작업자 확보 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-026",
      "text": "전기설비의 정비를 담당하는 작업자는 다음 조건 중 하나라도 해당이 되면 추가 교육(또는 재교육)을 받아야 한다.",
      "guideContext": "예방정비 계획 - 숙련 정비작업자 확보 (법령 근거 미확인)",
      "additionalDetail": "조건: 정비 절차 미준수, 새로운 기술·장비·절차 변경, 연 1회 미만 수행 업무, 비정규 절차 필요 업무, 직무 내용 변경, 관련 규정 변경",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-027",
      "text": "교육의 결과는 다음과 같이 문서화하여야 한다.",
      "guideContext": "예방정비 계획 - 숙련 정비작업자 확보 (법령 근거 미확인)",
      "additionalDetail": "교육생 능숙함 입증 시 문서 발급, 고용기간 동안 재교육 시행 및 문서 발급, 문서에 교육 내용·담당자 이름·교육 날짜 명시",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-028",
      "text": "예방정비계획은 안전성을 확보하고 전기설비 고장을 감소시키는데 역점을 두어야 하며, 최소한 다음 사항을 포함하여야 한다.",
      "guideContext": "예방정비계획 일반사항 (법령 근거 미확인)",
      "additionalDetail": "숙련된 인력확보, 규정에 따른 점검·시험 및 정비절차, 객관적 판단기준, 기록 확보 방안 포함",
      "workProcessPhase": "예방정비 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-029",
      "text": "예방정비 계획에는 주변 환경에 의해 전기설비의 성능에 악영향을 미치는 다음의 사항이 고려되어야 한다.",
      "guideContext": "예방정비계획 일반사항 (법령 근거 미확인)",
      "additionalDetail": "금속 부식, 화학약품 영향, 보호 도장 유무, 내구성·손상 가스켓, 진동에 의한 볼트·너트 이완·케이블 과열 여부",
      "workProcessPhase": "예방정비 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-030",
      "text": "전기설비의 예방정비 시에는 다음의 기본자료를 확보하여야 한다.",
      "guideContext": "예방정비계획 수립 (법령 근거 미확인)",
      "additionalDetail": "기존 정비보고서, 관련 도면, 명판 자료, 주변 환경 내용, 설비 목록·위치·예비품 문서, 공급자 카탈로그·취급설명서, 보고서 서식",
      "workProcessPhase": "예방정비 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-031",
      "text": "예방정비 절차는 전 사업장에 동일하게 적용이 가능하도록 작성하여야 한다.",
      "guideContext": "예방정비계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예방정비 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-032",
      "text": "정비 작업 보고서에는 사고나 재해에 관한 기록과 주의사항 등이 포함되도록 한다.",
      "guideContext": "예방정비계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-033",
      "text": "정비 작업 시에는 정비 작업 일정 등을 사전에 공표하도록 하고, 운전과 관련된 다음의 주의사항이 포함되어야 한다.",
      "guideContext": "예방정비계획 수립 (법령 근거 미확인)",
      "additionalDetail": "정비로 인한 설비 영향, 통보 대상 부서·대상자, 운전설비 가동중지 기간 포함",
      "workProcessPhase": "정비작업 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-034",
      "text": "비상 상황을 가정하여 정비작업자가 비상절차에 따라 반복훈련을 실행할 수 있도록 계획이 수립되어야 한다.",
      "guideContext": "비상절차 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상절차 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-035",
      "text": "비상절차와 관련된 작업자가 그들이 수행하여야 할 임무를 숙지할 수 있도록 주기적인 반복 교육·훈련을 실시하여야 한다.",
      "guideContext": "비상절차 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상절차 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-036",
      "text": "부품 카탈로그, 정비 매뉴얼 및 도면은 한글로 작성하여야 하며, 번역된 서류는 정비가 이루어질 때 활용할 수 있도록 도착 즉시 그 내용을 확인하여야 한다.",
      "guideContext": "수입 전기설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-037",
      "text": "전기설비는 사용 개시 전에 최초 점검을 하여야 한다.",
      "guideContext": "예방정비와 정비 주기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "최초 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-038",
      "text": "전기설비는 정기적 점검을 통하여 양호한 상태로 유지되고 있음을 확인하여야 하며, 필요시에는 정비를 실시하여야 한다.",
      "guideContext": "예방정비와 정비 주기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정기 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-039",
      "text": "예방정비 주기는 제조자가 권장하는 정비 주기와 설비에서 예상되는 성능저하 시기를 고려하여 결정하여야 한다.",
      "guideContext": "예방정비와 정비 주기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예방정비 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-040",
      "text": "정비 시 전기설비를 해체한 경우에는 조립 시에 원래의 성능이 악화되지 않도록 유의하여야 한다.",
      "guideContext": "예방정비와 정비 주기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-041",
      "text": "안전공구 및 개인보호구는 의무적으로 사용·착용하여야 한다.",
      "guideContext": "안전공구 및 개인보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-042",
      "text": "정비작업 시의 방호대상과 방호범위가 예방정비계획에 규정되어야 하며, 특히 고압 및 특고압 회로에 대한 정비작업은 높은 수준의 방호가 이루어져야 한다.",
      "guideContext": "단락접지 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "단락접지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-043",
      "text": "정비작업 중 정전된 회로가 실수로 재통전 될 수 있으므로, 적절한 단락접지를 수행하여 작업자를 보호하여야 한다.",
      "guideContext": "단락접지 방법과 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "단락접지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-044",
      "text": "단락접지 기구를 설치하기 전 전선의 손상, 클램프 단자의 풀림, 클램프의 결함, 기구의 결함 여부 등을 점검하여야 한다.",
      "guideContext": "단락접지 기구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "단락접지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-045",
      "text": "단락접지 기구는 정전 상태에서 정비작업을 수행하는 지점마다 설치하여야 한다.",
      "guideContext": "단락접지 기구 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "단락접지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-046",
      "text": "설치하는 모든 단락접지 기구에는 식별번호를 부여하여 기록하고, 철거할 때 설치 시 기록된 번호를 지워 나간다.",
      "guideContext": "단락접지 기구 철거 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "단락접지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-047",
      "text": "단락접지 기구가 배전반 내에 설치된 곳에는 문을 닫거나 덮개를 덮어서는 아니 되며, 만일 접지 기구가 잘 보이지 않는 곳에 설치될 때에는 단락접지 기구가 안쪽에 있다는 사실을 알리기 위하여 문이나 덮개에 표지를 부착하여야 한다.",
      "guideContext": "단락접지 기구 철거 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "단락접지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-048",
      "text": "재통전하기 전 모든 도체에 접지된 부분이 있는지 확인하기 위하여 절연저항 측정기로 절연시험을 하여야 한다.",
      "guideContext": "단락접지 기구 철거 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정전작업 후 전원 복구",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE16-049",
      "text": "폭발위험장소에서 사용하는 방폭전기설비는 제조자의 권고에 따라 정기적인 점검, 시험 및 수리를 통해 관리되어야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE16-050",
      "text": "방폭전기설비의 예방정비를 위한 문서에는 위험장소 구분, 부품의 수리가 가능한 제조사나 대리인, 사용자가 수행할 수 있는 점검 및 수리작업 등을 명확히 기술하여야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE16-051",
      "text": "방폭전기설비의 정비작업자는 고온표면, 전기에너지, 정전기 방전 등의 점화에너지를 평가하고, 이를 제거하기 위한 교육·훈련을 받아야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011",
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-BE16-052",
      "text": "폭발위험장소에서의 정비작업은 사전 승인을 받아 수행하여야 하며, 전기설비의 정전과 정비기간 동안 위험분위기가 제거된 상태에서 실시하여야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE16-053",
      "text": "폭발위험장소에 있는 전기설비를 정비하기에 앞서 전원을 개방한 후, 부품의 온도를 낮추고 전기적인 전하가 빠져나가도록 충분한 정지 시간이 주어져야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE16-054",
      "text": "방폭관련 규정과 제조자의 명세에 적합한 전선관이나 밀봉 상태(Seal)를 유지하여야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE16-055",
      "text": "전기기기의 덮개, 볼트, 스크류 등은 제조자가 권장하는 적절한 토크를 유지하여야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-BE16-056",
      "text": "방폭전기설비의 변경과 부품의 교체는 제조자와 방폭기기 인증기관의 승인을 받아야 한다. 방폭전기설비의 임의 변경은 공인시험기관에 의한 인증이나 검정을 무효화하므로 신중히 판단하여야 한다.",
      "guideContext": "폭발위험장소 전기설비의 정비",
      "additionalDetail": null,
      "workProcessPhase": "방폭전기설비 정비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BE16-001",
      "term": "전기설비",
      "definition": "전기기계·기구, 배선, 접속 자재, 선로용 부품, 조명기구, 소형 전기기기 등을 말하며 제어·보호·감시장치 등을 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE16-002",
      "term": "예방정비",
      "definition": "전기설비에 관련된 기술사양을 만족하고, 요구되는 기능을 충족시키기 위하여 설비를 점검, 시험 또는 수리하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE16-003",
      "term": "점검",
      "definition": "전기설비의 신뢰성 확보를 위하여 분해를 하지 않거나, 필요에 따라 부분적인 분해를 통하여 정밀조사를 실시하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE16-004",
      "term": "육안점검",
      "definition": "장비나 공구를 사용하지 않고, 볼트의 분실 등과 같이 육안으로 결함을 확인하기 위한 점검을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE16-005",
      "term": "최초점검",
      "definition": "전기설비를 사용하기 전에 실시하는 점검을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BE16-01",
