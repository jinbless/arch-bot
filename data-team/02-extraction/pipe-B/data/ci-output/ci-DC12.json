  "domainTerms": [
    {
      "identifier": "DT-DC12-001",
      "term": "가설벤트(Temporary Bent)",
      "definition": "교량거더나 상부구조물을 일시적으로 지지하기 위해 설치하는 임시구조물로 철재로 구성된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-002",
      "term": "조립강주 동바리",
      "definition": "규격화·부품화된 수직재, 수평재 및 가새재 등의 부재를 현장에서 조립하여 거푸집을 지지하는 형식의 동바리로 H형강 또는 원형강을 사용한 대형 동바리를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-SHORING-002"
      ]
    },
    {
      "identifier": "DT-DC12-003",
      "term": "지주(Post, Column)",
      "definition": "가설벤트를 구성하는 수직부재로 하중을 지지하며, 강관, H형강, 각형강 등이 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-004",
      "term": "헤드 트러스(Head Truss)",
      "definition": "가설벤트 상단에서 하중을 수평으로 분산시키는 구조물로 상부거더를 직접 받친다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-005",
      "term": "지지력(Bearing Capacity)",
      "definition": "가설벤트가 설치된 지반이나 받침 구조물이 견딜 수 있는 하중 능력을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-006",
      "term": "받침판(Base Plate)",
      "definition": "지주하부에 설치되어 하중을 넓게 분산시키고 지반과의 접촉을 돕는 판재를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-007",
      "term": "침하방지판(Settlement Plate)",
      "definition": "지반이 약할 경우 침하를 방지하기 위해 받침판 아래에 설치하는 보강판을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-008",
      "term": "잭서포트(Jack Support)",
      "definition": "높이 조절 및 미세 수평 조정을 위한 유압 또는 나사식 지지대를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-009",
      "term": "조립식지주(Prefabricated Post)",
      "definition": "현장 용접 없이 조립 가능한 형태로 제작된 강관 지주를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-010",
      "term": "체결핀(Connecting Pin)",
      "definition": "조립식 지주간 연결을 위한 금속핀으로 하중 조건에 따라 볼트나 너트를 병행 사용한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-011",
      "term": "수평재(Horizontal Brace)",
      "definition": "지주 사이에 연결되어 횡방향 강성을 확보하는 부재로 흔들림을 방지하는 역할을 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-DC12-012",
      "term": "대각재(Diagonal Brace)",
      "definition": "지주의 수직성 및 가설벤트 전체 안정성 확보를 위한 대각선 보강재를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
