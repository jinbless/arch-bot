  "checklistItems": [
    {
      "identifier": "CI-DC12-001",
      "text": "교량의 설치·해체 또는 변경 등의 작업을 위한 조립 강주 설치, 조립, 해체 작업을 하는 경우 근로자의 위험을 방지하기 위하여 작업장의 지반 상태와 작업 공간 및 지장물 간섭 등에 대한 사전조사를 하고, 그 결과를 기록·보존하여야 하며, 그 결과를 반영한 조립 강주 설치·해체에 대한 작업계획서를 작성하여야 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제38조에 따른 사전조사 및 작업계획서 작성 의무",
      "workProcessPhase": "사전조사 및 계획",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-DC12-002",
      "text": "높이가 3.5미터를 초과하는 경우에는 높이 2미터 이내마다 수평연결재를 2개 방향으로 만들고 수평연결재의 변위를 방지하도록 되어 있으며, 동바리로 사용하는 조립강주의 경우 조립강주의 높이가 4미터를 초과하는 경우에는 높이 4미터 이내마다 수평연결재를 2개 방향으로 설치하고 수평연결재의 변위를 방지하도록 규정되어 있다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제332조의2에 따른 동바리 유형별 수평연결재 설치 기준",
      "workProcessPhase": "조립 및 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-SHORING-002"
      ]
    },
    {
      "identifier": "CI-DC12-003",
      "text": "사업주는 작성한 작업계획서의 내용을 해당 근로자에게 알려야 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "사전조사 및 계획",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-DC12-004",
      "text": "조립 강주를 지지할 수 있는 건고한 기초를 확보할 수 있도록 조치를 취하여야 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "기초 및 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-DC12-005",
      "text": "조립 강주 설치 전 위치의 지반 지내력을 반드시 확인하여야 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "기초 및 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-DC12-006",
      "text": "부등침하를 방지하기 위해 버림 콘크리트 타설 또는 필요시 하부 H빔 설치 등의 보강 조치를 취해야 합니다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "기초 및 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-DC12-007",
      "text": "지반과 기초의 접촉부에 특별히 유의하여 각부가 이동하지 않도록 충분한 강도와 안전성을 확보할 수 있도록 한다.",
      "guideContext": "조립 강주 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 및 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-DC12-008",
      "text": "작업 시작 전 관리감독자를 지정하여 작업을 지휘하도록 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제39조 작업지휘자 지정에 해당",
      "workProcessPhase": "작업 관리 및 감독",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-DC12-009",
      "text": "관리감독자는 위험 요인과 안전수칙을 근로자에게 주지시켜야 합니다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리 및 감독",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-DC12-010",
      "text": "작업 중에는 감시자를 배치하여 조립 강주의 변형, 변위, 침하 유무 등을 수시로 확인하여야 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리 및 감독",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-DC12-011",
      "text": "산업안전보건기준의 순간풍속 기준 및 기상 상황에 따른 작업 중지 기준을 따라야 하며, 비·눈 등 기상악화 발생 시 안전관리 책임자가 위험도 평가 후 즉각 작업을 중지하여야 함",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리 및 감독",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-DC12-012",
      "text": "추락의 위험이 있는 작업 발판에는 안전난간을 설치하고, 안전하게 승강할 수 있는 설비를 갖추어야 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "추락 및 낙하물 방지",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-FALL-001",
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-DC12-013",
      "text": "작업자 및 근로자의 안전을 고려하여 추락 및 낙하물 방지 시설을 설치하도록 하여야 한다.",
      "guideContext": "조립 강주 안전작업",
      "additionalDetail": null,
      "workProcessPhase": "추락 및 낙하물 방지",
