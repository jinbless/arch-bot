  "checklistItems": [
    {
      "identifier": "CI-H149-001",
      "text": "혈액 시료는 당일 작업종료 2 시간 전부터 작업종료 사이에 채취한다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-002",
      "text": "근로자의 정맥혈을 EDTA(Ethylenediaminetetraacetic acid) 또는 헤파린이 미리 처리된 튜브와 1 회용 주사기 또는 진공 채혈관을 이용하여 2 mL 이상 채취한다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-003",
      "text": "채취한 시료는 시료 채취 용기에 밀봉하여 채취 후 5일 이전에 분석하면 4 ℃(2~8 ℃)에서 냉장 보관한다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-004",
      "text": "분석까지 보관 기간이 5일 이상 걸리는 경우에는 시료를 냉동보관용 저온바이알에 옮겨 -20 ℃이하에서 냉동 보관한다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-005",
      "text": "사용하는 모든 초자기구는 20% 질산에 4 시간 이상 담가두었다가 탈이온수로 5 회 행구어 사용한다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기구 및 시약 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(3)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-006",
      "text": "트리톤 X-100, 망간 표준용액, 질산과 기포방지제는 최초 개봉일로부터 3 년 이내의 것을 사용하도록 하며, 초과 시는 새로운 시약과 비교실험을 실시하여 오차가 10% 이내일 경우 1 년간 연장 사용할 수 있다.",
      "guideContext": "망간 생물학적 노출지표 분석",
      "additionalDetail": null,
      "workProcessPhase": "기구 및 시약 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(3)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-007",
      "text": "산을 취급할 때는 보호안경, 장갑, 마스크를 착용 후 후드에서 작업한다.",
      "guideContext": "망간 생물학적 노출지표 분석",
      "additionalDetail": null,
      "workProcessPhase": "기구 및 시약 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5-(3)",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H149-008",
      "text": "모든 시료는 거품이 발생하지 않도록 40분간 롤러 믹서로 균질화시킨다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-009",
      "text": "산처리가 끝난 시험관에 <표 1>과 같이 시료를 순서대로 주입 후 마개로 막은 후 롤러 믹서로 30초간 혼합한다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-H149-010",
      "text": "분석 조건은 장비제조회사의 권고 방법을 사용한다.",
      "guideContext": "망간 생물학적 노출지표 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "원자흡광도기 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-(6)",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H149-001",
      "term": "생물학적 노출평가",
      "definition": "혈액, 소변 등 생체시료로부터 유해물질 자체 또는 유해물질의 대사산물이나 생화학적 변화산물 등을 분석하여 유해물질 노출에 의한 체내 흡수정도나 건강영향 가능성 등을 평가하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H149-002",
      "term": "생물학적 노출지표 물질",
      "definition": "생물학적 노출평가를 실시함에 있어 체내 흡수정도를 반영하는 물질로서 유해물질 자체나 그 대사산물, 생화학적 변화물 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H149-003",
      "term": "정밀도",
      "definition": "일정한 물질에 대하여 반복측정·분석을 했을 때 나타나는 자료분석치의 변동크기가 얼마나 되는가를 나타낸다. 이 경우 같은 조건에서 측정했을 때 일어나는 우연오차(Random error)에 의한 분산(Dispersion)의 정도를 측정값의 변이계수(Coefficient of variation)로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H149-004",
      "term": "정확도",
      "definition": "분석치가 참값에 얼마나 접근하였는지를 수치로 표현한 것이다. 다만, 인증표준물질이 있는 경우는 상대오차로 표시하고, 인증표준물질이 없는 경우는 시료에 첨가한 값으로부터 구한 평균회수율로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H149-005",
      "term": "검출한계",
      "definition": "공시료 신호값(Blank signal, background signal)과 통계적으로 유의하게 다른 신호값(Signal)을 나타낼 수 있는 최소의 농도를 말한다. 이 경우 가장 널리 사용하는 공시료 신호값과의 차이가 공시료 신호값 표준편차의 3배인 경우로 한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
