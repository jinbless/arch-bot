  "domainTerms": [
    {
      "identifier": "DT-P30-001",
      "term": "완충 탱크 (Buffer storage tank)",
      "definition": "수소 발생기와 압축기 사이에 위치한 가압 탱크를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-002",
      "term": "제어장치 (Control system)",
      "definition": "정상적인 운전 매개 변수에 따라 수소충전소에서 수소 제조, 지장, 충전을 제어하기 위한 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-003",
      "term": "설계압력 (Design pressure)",
      "definition": "고압가스용기 등 각부의 계산두께 또는 기계적 강도를 결정하기 위하여 허용할 수 있는 최대 게이지 압력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-004",
      "term": "충전설비 (Dispenser)",
      "definition": "수소충전소에서 가압 지장된 수소를 자동차에 충전하는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-005",
      "term": "수소충전소 (Hydrogen fuelling station)",
      "definition": "다양한 원료를 사용하여 수소를 제조하고 압축기, 지장설비, 충전설비 등을 통하여 수소연료전지 자동차에 수소를 공급하는 시설을 말하며, 수소를 운반하는 배관, 액체수소 지장·펌프·기화장치, 기체수소 압축·정화·주입장치·완충탱크 등을 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-006",
      "term": "지장설비",
      "definition": "고압가스를 충전·지장하기 위한 설비로써 지장탱크 및 충전용기 보관설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-007",
      "term": "안전거리 (Safety distance)",
      "definition": "사고 발생 시 사고의 위험으로부터 인명 및 재산을 보호하기 위하여 수소충전소 설비 또는 사업소와 공공장소 간에 유지하여야 하는 거리를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-008",
      "term": "지장탱크",
      "definition": "고압가스를 충전·지장하기 위하여 지상 또는 지하에 고정 설치된 탱크를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-009",
      "term": "커플링 (Coupling)",
      "definition": "호스의 끝 부분이 결합된 니플과 소켓의 결합 구조를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-010",
      "term": "호스 어셈블리 (Hose assembly)",
      "definition": "피팅, 굽힘 방지장치 및 표시(marking) 등 포함한 호스 및 끝단 연결부를 포함한 조립체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P30-011",
      "term": "충전호스 (Fuelling hose)",
      "definition": "노즐을 통해 기체 수소를 차량에 전달하는데 사용되는 호스 조립체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
