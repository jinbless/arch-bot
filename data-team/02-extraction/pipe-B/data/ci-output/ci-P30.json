    {
      "identifier": "WP-P30-03",
      "processOrder": 3,
      "processName": "환기설비 설치",
      "safetyMeasures": "환기속도 명시, 가스설비실 및 지장설비실 환기설비 설치, 공기보다 가벼운 가스는 상부 2방향 이상 개구부, 공기보다 무거운 가스는 바닥면 개구부 또는 기계환기설비, 수소 부피비 1% 이하 유지",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
