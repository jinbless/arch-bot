  "checklistItems": [
    {
      "identifier": "CI-A182-001",
      "text": "메탄올은 인화성물질로 화재와 폭발의 위험성이 있다. 경구, 호흡, 경피나 눈을 통해 흡수되며 고농도의 증기에 노출되면 시력손실을 일으키므로 반드시 보호장갑 및 보호안경을 착용하고 흄후드 내에서 사용하여야 한다.",
      "guideContext": "아크릴산 작업환경측정·분석 시 메탄올 취급",
      "additionalDetail": "메탄올은 시료 전처리 탈착액으로 사용됨",
      "workProcessPhase": "시료 전처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-A182-002",
      "text": "아크릴산은 눈, 피부, 점막에 자극성이 있으며 피부를 통하여 흡수된다. 이에 보호장갑 및 보호복을 착용하고 흄후드 안에서 사용하여야 한다.",
      "guideContext": "아크릴산 작업환경측정·분석 시 아크릴산 취급",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리 및 분석",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-A182-003",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급이상의 것을 사용하여야 한다. 분석에 사용하는 시약은 제조회사에서 표시하는 농도 함량을 따른다.",
      "guideContext": "아크릴산 작업환경측정·분석 시약 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-004",
      "text": "광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의해야 하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.",
      "guideContext": "아크릴산 작업환경측정·분석 시약 순도 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-005",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 칭량할 수 있어야 하며, 화학 분석용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 칭량할 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "아크릴산 작업환경측정·분석 기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-006",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 한국산업규격 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "아크릴산 작업환경측정·분석 유리기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-007",
      "text": "노출기준과 비교 시는 작업환경 측정 시의 온도와 압력을 실측하여 정상상태의 농도로 환산하여야 한다.",
      "guideContext": "아크릴산 작업환경측정 농도 환산 (법령 근거 미확인)",
      "additionalDetail": "정상상태(NTP): 25℃, 1기압",
      "workProcessPhase": "농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-008",
      "text": "시료의 시험, 바탕시험 및 표준액에 대한 일련의 동일시험을 행할 때 사용하는 시약 또는 시액은 동일 롯트(LOT)로 조제된 것을 사용한다.",
      "guideContext": "아크릴산 작업환경측정·분석 시약 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-009",
      "text": "표준원액으로 사용될 원액의 순도, 제조일자, 유효기간 등을 잘 파악해야 한다.",
      "guideContext": "아크릴산 작업환경측정 검량선 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-010",
      "text": "표준용액, 탈착효율 등에 사용되는 시약은 같은 롯트(Lot)번호를 가진 것을 사용하여야 한다.",
      "guideContext": "아크릴산 작업환경측정 검량선 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-011",
      "text": "검량선은 시료 분석조건과 주입방법에 따라 작성하고 검량선이 적정하다고 판정하면 시료를 분석한다. 검량선은 분석할 시료의 농도를 포함해야 하며 외삽(extrapolation)법은 피한다. 검량선의 적정성은 제시된 분석기기의 매뉴얼을 참조하거나 상관계수가 0.99이상의 것을 사용하도록 한다.",
      "guideContext": "아크릴산 작업환경측정 검량선 작성",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-012",
      "text": "탈착효율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다. 탈착효율에 대한 평가는 분석자가 해야 한다.",
      "guideContext": "아크릴산 작업환경측정 탈착효율 검정 (법령 근거 미확인)",
      "additionalDetail": "12개의 탈착효율 실험결과를 근거로 탈착효율값간의 일정성을 판단하여야 함",
      "workProcessPhase": "탈착효율 검정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-013",
      "text": "만일 뒤 층에서 검출된 양이 앞 층에서 검출된 양의 10%를 초과하면(Wb > Wf/10), 시료 파과가 일어난 것이므로 해당 자료는 사용할 수 없다.",
      "guideContext": "아크릴산 작업환경측정 농도 계산 시 시료 파과 판정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "IV",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-014",
      "text": "시료채취 후 흡착관을 플라스틱 마개로 막아 냉장 보관하여 운반한다.",
      "guideContext": "아크릴산 작업환경측정 시료 운반",
      "additionalDetail": "실온(24℃) 보관과 냉장(-4℃) 보관 모두에서 2주간 안정",
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A182-015",
      "text": "계량기구 중 측정값을 분석결과의 계산에 사용할 목적으로 사용되는 것은 모두 보정하는 것을 원칙으로 한다.",
      "guideContext": "아크릴산 작업환경측정 기구 보정",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A182-001",
      "term": "밀폐",
      "definition": "취급 또는 보관 상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A182-002",
      "term": "밀봉",
      "definition": "취급 또는 보관 상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A182-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A182-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ± 10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A182-005",
      "term": "즉시",
      "definition": "30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A182-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A182-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A182-008",
      "term": "탈착효율",
      "definition": "채취한 유기화합물 등의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 매체에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-A182-01",
      "processOrder": 1,
      "processName": "시료채취",
      "safetyMeasures": "개인시료채취펌프를 시료채취매체와 연결하여 보정한다. 시료채취 바로 전에 흡착관의 양끝을 절단한 후 유연성 튜브를 이용하여 펌프에 연결한다. 0.1 L/min의 유량으로 총 24 L의 공기를 채취한다. 시료채취 후 흡착관을 플라스틱 마개로 막아 냉장 보관하여 운반한다.",
      "requiredPPE": [
        "보호장갑"
      ],
      "sourceSection": "I",
      "relatedSR": null
    },
    {
      "identifier": "WP-A182-02",
      "processOrder": 2,
      "processName": "시료 전처리",
      "safetyMeasures": "메탄올 취급 시 반드시 보호장갑 및 보호안경을 착용하고 흄후드 내에서 사용하여야 한다. 2개의 흡착관 앞 층과 뒤 층을 각각 다른 4 mL 바이알에 담는다. 각각의 바이알에 메탄올 2 mL를 넣고 즉시 뚜껑을 닫는다. 계속 흔들어 주면서 1시간 동안 탈착한다.",
      "requiredPPE": [
        "보호장갑",
        "보호안경"
      ],
      "sourceSection": "II",
      "relatedSR": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "WP-A182-03",
      "processOrder": 3,
      "processName": "검량선 작성 및 기기분석",
      "safetyMeasures": "최소 5개의 표준용액으로 검량선을 작성한다. 시료 및 공시료를 함께 분석한다. 탈착효율을 구한다. 액체크로마토그래피 제조회사가 권고하는 대로 기기를 작동시키고 조건을 설정한다. 시료를 정량적으로 정확히 주입한다.",
      "requiredPPE": [
        "보호장갑",
        "보호안경"
      ],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A182-04",
      "processOrder": 4,
      "processName": "농도 계산 및 결과 평가",
      "safetyMeasures": "뒤 층에서 검출된 양이 앞 층에서 검출된 양의 10%를 초과하면 시료 파과가 일어난 것이므로 해당 자료는 사용할 수 없다. 노출기준 비교 시 측정 시의 온도와 압력을 실측하여 정상상태(25℃, 1기압)의 농도로 환산하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "IV",
      "relatedSR": null
    }
  ],
