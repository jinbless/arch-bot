    },
    {
      "identifier": "CI-AG4-004",
      "text": "이동식 사다리를 통로로 사용하는 경우 폭은 30센티미터 이상으로 할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제24조(사다리식 통로 등의 구조) 제1항 제5호",
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-005",
      "text": "사다리가 넘어지거나 미끄러지는 것을 방지하기 위한 조치를 할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제24조(사다리식 통로 등의 구조) 제1항 제6호",
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-006",
      "text": "사다리의 상단은 걸쳐놓은 지점으로부터 60센티미터 이상 올라가도록 할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제24조(사다리식 통로 등의 구조) 제1항 제7호",
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-007",
      "text": "사다리식 통로의 기울기는 75도 이하로 할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제24조(사다리식 통로 등의 구조) 제1항 제9호",
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-008",
      "text": "접이식 사다리 기둥은 사용 시 접혀지거나 펼쳐지지 않도록 철물 등을 사용하여 견고하게 조치할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제24조(사다리식 통로 등의 구조) 제1항 제10호",
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-009",
      "text": "사다리의 각 접합 부분이 어긋나 있는 등 결점이 없는지 여부를 점검하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-010",
      "text": "인체 및 작업복이 닿는 부분에 날카로운 부분이 없는지 점검하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-011",
      "text": "사다리 각 부분에 녹이 발생할 우려가 있는 경우 녹 방지처리가 되어있는지 확인하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-012",
      "text": "사다리 조립 구성품인 볼트, 너트, 용접부 및 기타 접합부는 현저히 돌출되지 않았는지 점검하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-013",
      "text": "발판은 수평으로 버팀대에 부착되어야 하고 발 또는 신발이 닿는 면에는 미끄럼 방지 처리가 되어있는지 점검하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-014",
      "text": "버팀대가 바닥과 닿는 끝에는 미끄럼 방지 처리가 되어있어야 하며, 버팀대에 확실하게 부착되어있는지 점검하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-015",
      "text": "사다리의 발판과 접하는 양쪽 버팀대는 전체적으로 평행이거나, 바닥과 닿는 쪽에서 넓혀져 있고 그 밖의 부분에서는 평행이어야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-016",
      "text": "접이식 사다리의 접히거나 펴지는 조인트 부분은 작동이 원활하고 견고한 구조여야 한다. 또한 벌어짐 방지 기구, 사다리 고정기구가 정상적인 기능을 하는지 점검하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-017",
      "text": "사다리 각 발판의 간격은 230mm~400mm 이내에서 균등한지 점검하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-018",
      "text": "이동식 사다리의 버팀대, 발판에 사용하는 금속 재료는 산업표준에서 정하는 기계적 성질과 동등하거나 그 이상이어야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-019",
      "text": "평탄하고 견고하며 미끄럽지 않은 바닥에 이동식 사다리를 설치할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제42조(추락의 방지) 제4항 제1호",
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-020",
      "text": "이동식 사다리의 넘어짐을 방지하기 위해 다음 각 목의 어느 하나 이상에 해당하는 조치를 할 것. 가. 이동식 사다리를 견고한 시설물에 연결하여 고정할 것. 나. 아웃트리거(outrigger, 전도방지용 지지대)를 설치하거나 아웃트리거가 붙어있는 이동식 사다리를 설치할 것. 다. 이동식 사다리를 다른 근로자가 지지하여 넘어지지 않도록 할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제42조(추락의 방지) 제4항 제2호",
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-021",
      "text": "이동식 사다리의 제조사가 정하여 표시한 이동식 사다리의 최대사용하중을 초과하지 않는 범위 내에서만 사용할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제42조(추락의 방지) 제4항 제3호",
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-022",
      "text": "이동식 사다리를 설치한 바닥면에서 높이 3.5미터 이하의 장소에서만 작업할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제42조(추락의 방지) 제4항 제4호",
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-023",
      "text": "이동식 사다리의 최상부 발판 및 그 하단 디딤대에 올라서서 작업하지 않을 것. 다만, 높이 1미터 이하의 사다리는 제외한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제42조(추락의 방지) 제4항 제5호",
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-024",
      "text": "안전모를 착용하되, 작업 높이가 2미터 이상인 경우에는 안전모와 안전대를 함께 착용할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제42조(추락의 방지) 제4항 제6호",
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-025",
      "text": "이동식 사다리 사용 전 변형 및 이상 유무 등을 점검하여 이상이 발견되면 즉시 수리하거나 그 밖에 필요한 조치를 할 것",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "제42조(추락의 방지) 제4항 제7호",
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-026",
      "text": "사다리 사용 시 작업장 주변에 쓰러질 수 있는 물질을 제거하고 작업환경을 개선하여 사용해야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-027",
      "text": "작업장의 높이에 적합한 사다리를 사용하고, 작업높이가 사다리보다 높을 때 벽돌이나 박스 등을 이용하여 높이를 높여서는 안 된다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-028",
      "text": "출입문이 열린 상태로 확실하게 고정되어있거나, 닫힌 상태에서 잠겨 있는 경우가 아니라면, 사다리를 출입문 앞에 설치해서는 안 된다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-029",
      "text": "짧은 사다리 길이를 늘이기 위해 2개 이상의 사다리를 겹쳐 이어서 사용해서는 안 된다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-030",
      "text": "사다리는 원래 의도된 목적 이외의 용도로 사용해서는 안 된다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-031",
      "text": "사다리를 오르내리거나, 사다리에서 작업을 하는 경우 사다리의 발판 중앙에서 해야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-032",
      "text": "이동식 사다리는 측면 하중에 취약하므로 작업거리가 사다리 중심으로부터 먼 경우 과도하게 몸을 뻗지 않도록 한다. 이러한 경우 작업자가 사다리를 내려온 후 사다리를 적정 위치로 다시 배치해야한다.",
      "guideContext": "이동식 사다리의 사용",
      "additionalDetail": null,
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-033",
      "text": "작업을 위해 사다리에 오르내리는 경우 사다리를 마주보고 사다리를 단단히 잡아야 한다. 또한 하나의 사다리 위에서 다른 사다리 위로 이동해서는 안된다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-034",
      "text": "접이식 사다리 작업 전에 잠금장치가 완전히 펼쳐진 상태이며, 모든 버팀대 끝이 평평한 바닥면에 지지되어 있는지 확인해야한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-035",
      "text": "사다리는 항상 안전하고 사용 가능한 조건에서 보관하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 보관 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-036",
      "text": "사다리가 넘어졌다면 버팀대 등에 구부러지거나 손상된 부위가 없는지 조사하고 지나치게 움폭 들어간 곳과 이에 연결된 부분을 모두 점검한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": "사다리가 넘어졌을 때 즉시 점검 실시",
      "workProcessPhase": "사다리 보관 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-037",
      "text": "사다리에 기름과 유지 등이 묻었다면 기름, 유지 또는 미끄러운 물질을 용제 또는 물 세척으로 제거하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 보관 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-038",
      "text": "잠금장치, 휠, 도르래 등은 자주 기름칠을 해 주어야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 보관 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-039",
      "text": "사다리가 화재와 같은 극심한 열에 노출되면 강도가 약해질 수 있으므로 사다리를 시각적으로 검사하고, 휨과 강도 특성에 대해 테스트해야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 보관 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-040",
      "text": "사다리가 특정 산 또는 알칼리 물질에 노출되면 화학적 부식 및 강도 감소가 발생할 수 있으므로 사용 전에 제조업체에게 문의하여야 한다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 보관 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-041",
      "text": "사다리는 사용하지 않을 때 사다리를 보호할 수 있도록 설계된 선반이나 랙에 보관해야 하며, 사다리를 보관 중일 때 그 위에 자재를 놓아서는 안된다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 보관 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG4-042",
      "text": "사다리에 체결된 모든 볼트와 리벳은 사다리를 사용하기 전에 제자리에 있어야 하고, 견고해야 하며, 볼트나 리벳이 없거나 발판과 측면 버팀대 사이의 연결부가 느슨할 경우 사다리를 사용해서는 안된다.",
      "guideContext": "이동식 사다리의 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사다리 선정 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    }
  ],
