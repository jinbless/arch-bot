  "checklistItems": [
    {
      "identifier": "CI-EM5-001",
      "text": "포름알데히드 노출을 줄이기 위해 포름알데히드가 사용된 검체와 포르말린을 이용하는 곳에는 국소배기시설을 갖춘다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-002",
      "text": "적은 양의 포름알데히드는 취급하기 편한 소형의 통에 들어 있는 제품을 구매하는 것이 좋다.",
      "guideContext": "의료기관 포름알데히드 관리방안",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-003",
      "text": "응급상황에 대비하기 위해 흡착포를 준비한다. 부주의하게 쏟았을 경우, 쏟아진 포름알데히드가 사람에게 노출되지 않도록 신속하게 흡착포를 덮어 제거한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-004",
      "text": "포름알데히드에 피부와 눈이 노출되는 것을 피하며, 포름알데히드가 쏟아지거나 뒤었을 경우에 대비하여 보안경, 안면보호구, 앞치마, 호흡보호구, 장화 등을 사용한다. 천연고무 재질의 장갑은 찢어지기 쉬우므로 적절한 화학물질용 보호장갑을 착용한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-005",
      "text": "포름알데히드에 대한 화학물질 위험성평가를 실시하고, 개선대책을 모색한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-006",
      "text": "물질안전보건자료를 비치하여 포름알데히드가 인체에 미치는 영향, 취급 상 주의사항, 착용해야 할 보호구, 응급조치 방법 등을 확인할 수 있게 한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-007",
      "text": "포름알데히드 사용을 최소화하고, 포름알데히드 농도를 정기적으로 측정하여 허용 기준 이하를 유지하도록 한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-008",
      "text": "포름알데히드를 보관할 때는 통풍이 잘되는 18~32℃의 저장소에 밀폐 보관한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-009",
      "text": "포름알데히드에 노출되는 근로자의 건강상태를 정기적으로 모니터링하고, 포름알데히드 노출로 인한 증상이 나타나지 않도록 주의깊게 관리한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EM5-010",
      "text": "포름알데히드의 건강 영향에 대해 주기적으로 근로자 교육을 실시한다.",
      "guideContext": "의료기관 포름알데히드 관리방안 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-EM5-001",
      "term": "의료기관 근로자",
      "definition": "의료기관에서 의사, 간호사, 약사, 방사선사, 임상병리사, 간호조무사 등 의료행위를 직접 수행하거나 보조업무를 하는 근로자와, 시설 관리, 청소, 세탁, 인쇄, 음식료의 준비 및 배식, 폐기물의 수집이나 처리 등의 업무를 수행하는 근로자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EM5-002",
      "term": "화학물질",
      "definition": "산업안전보건법 시행규칙 [별표 21] 작업환경측정 대상 유해인자 및 [별표 22] 특수건강진단 대상 유해인자에서 분류한 기준을 토대로 의료기관에서 사용하는 화학물질을 제시한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
