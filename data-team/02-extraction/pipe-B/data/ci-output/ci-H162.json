  "checklistItems": [
    {
      "identifier": "CI-H162-001",
      "text": "사업주와 근로자는 작업관련성 질환 예방을 포함하여 근로자의 건강을 최상의 상태로 유지하기 위한 건강증진활동을 추진해야 한다.",
      "guideContext": "사업장 건강증진활동 계획 수립 및 시행 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-002",
      "text": "사업주는 근로자의 건강증진을 적극적으로 추진한다는 의사를 경영방침 등을 통해 표명한다.",
      "guideContext": "사업장 건강증진활동 기본방향",
      "additionalDetail": null,
      "workProcessPhase": "경영방침 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-003",
      "text": "사업주는 건강증진활동에 근로자를 참여시키고, 근로자는 건강증진활동의 모든 단계에 적극적으로 참여한다.",
      "guideContext": "사업장 건강증진활동 기본방향",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-004",
      "text": "사업주는 건강증진활동에 필요한 인력, 시설, 장비, 예산 등을 지원한다.",
      "guideContext": "사업장 건강증진활동 기본방향",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-005",
      "text": "사업주는 건강증진활동을 추진하기 위하여 외부 전문가 또는 전문기관의 자문을 받거나 협력 체계를 마련한다.",
      "guideContext": "사업장 건강증진활동 기본방향",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-006",
      "text": "근로자 건강증진활동은 사업장 내의 협력업체 근로자를 포함하여 추진한다.",
      "guideContext": "사업장 건강증진활동 기본방향",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-007",
      "text": "건강증진활동의 계획 수립, 프로그램 운영내용, 결과 등에 관한 모든 사항을 기록하고 보존한다.",
      "guideContext": "사업장 건강증진활동 기본방향",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-008",
      "text": "근로자 건강증진활동을 추진하기 위해서는 사업장 특성에 맞게 건강증진활동 추진 체계를 구축하고 추진 팀을 조직해야 한다.",
      "guideContext": "사업장 건강증진활동 추진모형 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "추진체계 구축",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-009",
      "text": "사업주는 건강증진활동이 지속적이고 효율적으로 추진될 수 있도록 사업장의 특성에 맞게 건강증진활동 총괄 부서를 정하고, 건강증진활동 추진자를 정하여야 한다.",
      "guideContext": "건강증진활동 총괄부서 및 추진자 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "추진체계 구축",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-010",
      "text": "건강증진활동 총괄 부서에 건강증진활동 추진 팀을 구성한다. 추진 팀은 건강증진활동 추진자가 운영하며, 업종, 규모 등 사업장의 특성에 따라 적정인력이 참여하도록 구성한다. 이 때 근로자 대표와 예산 등에 대한 결정 권한이 있는 자가 반드시 참여하도록 하고, 사업장의 여건에 따라 관리감독자, 인사 및 노무 담당자, 산업보건의, 보건관리자, 영양사, 운동지도사, 심리상담사 등이 참여하게 한다.",
      "guideContext": "건강증진활동 총괄부서 및 추진자 선정",
      "additionalDetail": null,
      "workProcessPhase": "추진체계 구축",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-011",
      "text": "사업주는 건강증진활동에 필요한 부서별 실무 담당자를 정하고, 그 담당자와 건강증진활동 추진자가 협력하여 해당 부서의 건강증진활동 계획에 관한 실시 체계를 확립하도록 한다.",
      "guideContext": "건강증진활동 총괄부서 및 추진자 선정",
      "additionalDetail": null,
      "workProcessPhase": "추진체계 구축",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-012",
      "text": "산업안전보건위원회가 구성된 사업장은 산업안전보건위원회에서 건강증진활동 계획을 심의·의결하여야 하며, 산업안전보건위원회가 구성되지 않은 사업장은 노사협의회 등 근로자대표와 논의하여야 한다.",
      "guideContext": "건강증진활동 총괄부서 및 추진자 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-013",
      "text": "사업주는 건강증진활동 추진과 관련이 있는 사람에게 그 활동에 필요한 교육을 받을 수 있도록 지원한다.",
      "guideContext": "사업주의 역할",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-014",
      "text": "건강증진활동 추진자는 건강증진활동의 추진방침 및 목표를 명확히 이해하고, 사업장의 건강증진활동 추진에 관한 종합계획을 수립하여 시행한다.",
      "guideContext": "건강증진활동 추진자의 역할",
      "additionalDetail": null,
      "workProcessPhase": "계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-015",
      "text": "경영자가 근로자건강증진 활동을 기업경영의 한 분야로 인식하고 경영방침으로 표명한다.",
      "guideContext": "경영방침 수립",
      "additionalDetail": null,
      "workProcessPhase": "경영방침 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-016",
      "text": "이러한 방침을 전 직원에게 공지하여 전 직원이 알 수 있도록 한다.",
      "guideContext": "경영방침 수립",
      "additionalDetail": null,
      "workProcessPhase": "경영방침 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-017",
      "text": "건강증진활동 추진을 위한 중장기 종합계획을 수립한다.",
      "guideContext": "중장기 종합계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "중장기 종합계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-018",
      "text": "수립된 계획은 문서로 작성한다",
      "guideContext": "중장기 종합계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "중장기 종합계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-019",
      "text": "산업안전보건위원회 또는 노사협의회에서 건강증진활동 계획을 심의한다.",
      "guideContext": "중장기 종합계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-020",
      "text": "건강증진 사업을 수행하기 위하여 사업장의 현황을 분석한다.",
      "guideContext": "사업장 현황 분석",
      "additionalDetail": null,
      "workProcessPhase": "사업장 현황 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-021",
      "text": "현황 분석을 위해 사업장의 물리적 환경, 사회심리적 요인, 개인 건강관리를 위한 자원, 사업장의 외부요인을 분석한다.",
      "guideContext": "사업장 현황 분석",
      "additionalDetail": null,
      "workProcessPhase": "사업장 현황 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-022",
      "text": "현황 분석 자료를 토대로 SWOT 분석을 실시한다. SWOT 분석은 내부 환경의 강점(Strengths)과 약점(Weaknesses)을 파악하고, 외부 환경요인에 의해 만들어지는 기회(Opportunities)와 위협(Threats) 요인을 파악하는 것으로, 이를 통해 장점을 강화하고, 약점을 개선하며, 기회를 살리고, 위협요인을 감소시키는 전략수립이 가능하다.",
      "guideContext": "사업장 현황 분석",
      "additionalDetail": null,
      "workProcessPhase": "사업장 현황 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-023",
      "text": "건강증진에 대한 근로자의 요구도를 조사한다.",
      "guideContext": "건강증진 요구도 조사",
      "additionalDetail": null,
      "workProcessPhase": "건강증진 요구도 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-024",
      "text": "건강증진 요구도는 직무스트레스 관리, 작업관련 뇌심혈관계질환, 작업관련 근골격계질환, 금연·절주·운동·영양개선 등의 생활습관에 대한 내용을 파악한다.",
      "guideContext": "건강증진 요구도 조사",
      "additionalDetail": null,
      "workProcessPhase": "건강증진 요구도 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-025",
      "text": "건강증진 요구도 파악 시 건강진단 결과, 결근 및 이직 자료, 산업재해 자료, 근골격계 유해요인조사 결과, 뇌심혈관계질환 발병위험도 평가 결과, 건강관리실 이용현황 등에 대한 자료를 수집하고, 부서별 건강증진 실무 담당자 및 근로자의 의견을 청취하는 등 종합적인 정보를 통합하여 정리한다.",
      "guideContext": "건강증진 요구도 조사",
      "additionalDetail": null,
      "workProcessPhase": "건강증진 요구도 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-026",
      "text": "건강증진 요구도 파악 조사 결과를 토대로 건강증진 활동의 우선순위를 정한다.",
      "guideContext": "우선순위 설정",
      "additionalDetail": null,
      "workProcessPhase": "우선순위 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-027",
      "text": "건강증진활동의 목표를 구체적이고 명확하게 설정한다.",
      "guideContext": "목표 설정",
      "additionalDetail": null,
      "workProcessPhase": "목표 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-028",
      "text": "건강증진활동의 목표는 SMART 방법에 따라 구체적이고(Specific), 측정가능하고(Measurable), 성취가능하고(Achievable), 합리적이고(Reasonable), 시간에 대한 기준을 설정(Timely)하여 작성한다.",
      "guideContext": "목표 설정",
      "additionalDetail": null,
      "workProcessPhase": "목표 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-029",
      "text": "건강증진활동의 세부 실행 계획을 수립한다.",
      "guideContext": "실행 계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-030",
      "text": "프로그램을 수행하는데 필요한 인적자원, 교육자료, 장소, 장비와 물품, 재정자원의 검토 및 근로자 건강센터, 정신건강복지센터, 보건소 등 관할 지자체 내의 유용한 외부자원을 검토한다.",
      "guideContext": "실행 계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-031",
      "text": "사업계획서를 작성한다.",
      "guideContext": "실행 계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-032",
      "text": "실행계획을 수립할 때 평가 계획도 함께 수립한다.",
      "guideContext": "실행 계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-033",
      "text": "건강증진활동을 시행하는 데 필요한 게시판 운영, 자료제공, 교육, 홍보, 생활습관 개선, 이벤트, 캠페인, 외부기관 연계 등의 다양한 활동을 추진한다.",
      "guideContext": "프로그램의 시행",
      "additionalDetail": null,
      "workProcessPhase": "프로그램 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-034",
      "text": "건강증진활동을 실행할 때는 체계적으로 모니터링하고, 실행 내용을 빠짐없이 기록한다.",
      "guideContext": "프로그램의 시행",
      "additionalDetail": null,
      "workProcessPhase": "프로그램 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-035",
      "text": "건강증진활동의 가장 핵심적인 사항은 근로자와 관리자의 참여이므로, 건강증진활동 시행의 모든 단계에 근로자와 관리자가 적극적으로 참여할 수 있도록 한다.",
      "guideContext": "프로그램의 시행",
      "additionalDetail": null,
      "workProcessPhase": "프로그램 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-036",
      "text": "건강증진활동이 추진된 이후 효과를 파악할 수 있도록 건강증진활동을 실행하기 이전에 사전 조사를 시행한다.",
      "guideContext": "프로그램의 시행",
      "additionalDetail": null,
      "workProcessPhase": "프로그램 시행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-037",
      "text": "건강증진활동 시행 후 건강증진활동에 대한 평가를 실시하여 건강증진활동 시작 시 시행한 사전 조사 결과와 비교한다.",
      "guideContext": "건강증진활동의 평가",
      "additionalDetail": null,
      "workProcessPhase": "평가 및 환류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-038",
      "text": "건강증진활동 평가는 구조, 과정, 결과의 영역으로 평가한다.",
      "guideContext": "건강증진활동의 평가",
      "additionalDetail": "구조평가(자원투입 적절성), 과정평가(계획대로 운영 여부), 결과평가(사업효과)",
      "workProcessPhase": "평가 및 환류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-039",
      "text": "기업건강증진지수(EHP) 산출 통해 건강증진수준을 파악하고 건강증진 분야별 우선순위와 잠재위험도를 평가한다.",
      "guideContext": "건강증진활동의 평가",
      "additionalDetail": null,
      "workProcessPhase": "평가 및 환류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-040",
      "text": "평가에서 나타난 문제점을 검토하여 건강증진활동을 지속적으로 수행할 지 여부와 수정보완점을 결정한다.",
      "guideContext": "건강증진활동 평가 결과의 반영",
      "additionalDetail": null,
      "workProcessPhase": "평가 및 환류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-041",
      "text": "건강증진활동 평가 결과를 반영하여 다음에 시행할 건강증진활동에 보완하여 적용한다.",
      "guideContext": "건강증진활동 평가 결과의 반영",
      "additionalDetail": null,
      "workProcessPhase": "평가 및 환류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H162-042",
      "text": "건강증진활동의 평가와 피드백을 위해 사업주, 부서장, 근로자 대표, 근로자 등 다양한 사람들의 의견을 청취한다.",
      "guideContext": "건강증진활동 평가 결과의 반영",
      "additionalDetail": null,
      "workProcessPhase": "평가 및 환류",
