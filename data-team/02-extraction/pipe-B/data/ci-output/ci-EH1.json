  "domainTerms": [
    {
      "identifier": "DT-EH1-001",
      "term": "밀폐",
      "definition": "취급 또는 보관 상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EH1-002",
      "term": "밀봉",
      "definition": "취급 또는 보관 상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EH1-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EH1-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ± 10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EH1-005",
      "term": "즉시",
      "definition": "시험조작 중 30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EH1-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EH1-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EH1-008",
      "term": "탈착효율",
      "definition": "채취한 분석대상물질의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 매체에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-EH1-01",
      "processOrder": 1,
      "processName": "시료채취 기구 및 측정방법 선택",
      "safetyMeasures": "시료채취의 목적과 시료채취시간, 방해인자, 예상되는 오염농도 및 실험실에서 보유하고 있는 분석장비의 능력 등을 종합적으로 고려하여 최적의 시료채취기구 및 분석 방법을 선택한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-EH1-02",
      "processOrder": 2,
      "processName": "검량선 작성을 위한 표준용액 제조",
      "safetyMeasures": "대상물질의 순도와 특성(분자량, 비중, 노출기준)을 파악하고, 채취시료의 예상농도의 0.1~2배 수준에서 분석대상물질의 양을 결정한다. 최소한 5개 수준의 표준용액을 제조하며, 표준원액의 순도·제조일자·유효기간을 파악하고, 같은 롯트 번호의 시약을 사용한다. 검량선의 상관계수는 0.99 이상을 확보한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-EH1-03",
      "processOrder": 3,
      "processName": "내부표준물질 사용 및 보정",
      "safetyMeasures": "내부표준물질은 머무름 시간이 분석대상물질과 적절히 가깝고, 피크가 중첩되지 않으며, 양이 적절하고, 검출기 반응이 양호한 물질로 선정한다. 내부표준물질은 표준용액 등으로 사용하기 전에 탈착액에 일정량을 넣는다. 검량선 작성 시 면적비로 회귀식을 구하고 분석시료의 면적비를 대입하여 농도를 구한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-EH1-04",
      "processOrder": 4,
      "processName": "탈착효율 검정",
      "safetyMeasures": "예상 농도와 공기채취량에 따라 주입량을 계산하고, 5개 농도 수준(0.5~2배)의 양을 3반복(9개)과 공시료 3개를 준비한다. 흡착관의 뒤 층을 제거하고, 마이크로실린지로 앞 층에 주입 후 즉시 마개로 막고 하루 방치한다. 탈착 후 분석하여 탈착효율(분석량/주입량)을 산출하며, 최소 0.75 이상(권장 0.90 이상)을 확보한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-EH1-25",
      "processOrder": 5,
      "processName": "시료채취",
      "safetyMeasures": "시료채취펌프를 시료채취매체로 보정 후, 활성탄관 양단을 절단하여 유연성 튜브로 펌프와 연결한다. 물질별 표 3을 참조하여 정확한 유량(0.01~0.2 ℓ/min)으로 채취하고, 채취 후 활성탄관을 플라스틱 마개로 밀봉하여 운반한다. 습도가 높으면 시료파과 현상에 유의하여 채취용량을 결정한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-EH1-26",
      "processOrder": 6,
      "processName": "시료 전처리",
      "safetyMeasures": "활성탄관의 앞 층과 뒤 층을 각각 다른 바이알에 분리 담고, 탈착액(CS₂) 1 mℓ를 넣은 후 즉시 뚜껑을 닫는다. 가끔 흔들면서 30분간 방치한다. CS₂는 독성 및 인화성이 강하므로(인화점 -30℃) 반드시 보호 장비를 착용하고 후드 안에서 실험을 수행한다.",
      "requiredPPE": [
        "보호 장비"
      ],
      "sourceSection": "6",
      "relatedSR": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "WP-EH1-27",
      "processOrder": 7,
      "processName": "검량선 작성 및 탈착효율 시험",
      "safetyMeasures": "최소 5개 표준물질로 검량선을 작성한다. 탈착효율 시험은 각 시료군 배치 당 최소 1회 실시하며, 3개 농도 수준에서 각각 3개씩과 공시료 3개를 준비한다. 현장시료 및 공시료를 함께 분석한다.",
      "requiredPPE": [
        "보호 장비"
      ],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-EH1-28",
      "processOrder": 8,
      "processName": "GC-FID 기기분석",
      "safetyMeasures": "가스크로마토그래피 제조사 권고에 따라 기기를 작동시키고 조건을 설정한다(주입부 250℃, 컬럼 35℃→230℃ 승온, 검출부 300℃). 시료를 정량적으로 정확히 주입하며, flush injection technique 또는 자동주입기를 이용한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-EH1-29",
      "processOrder": 9,
      "processName": "농도 계산",
      "safetyMeasures": "C = (Wf + Wb - Bf - Bb) / (V × DE) × 24.45 / MW 공식을 적용하여 분석물질의 농도(ppm)를 산출한다. Wf/Wb는 시료 앞·뒤 층의 양, Bf/Bb는 공시료 앞·뒤 층의 양, V는 공기채취량, DE는 탈착효율, MW는 분자량이다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    }
  ],
