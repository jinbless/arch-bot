  "domainTerms": [
    {
      "identifier": "DT-BE5-001",
      "term": "상용전원",
      "definition": "정상적인 상태에서 외부로부터 전력을 공급받아 사용하고 있는 전력공급원을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE5-002",
      "term": "비상전원",
      "definition": "상용전원이 사고나 고장에 의해 공급되지 못할 경우에 사용하기 위한 전력공급원으로, 비상발전기·축전지 설비·무정전전원공급장치 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "DT-BE5-003",
      "term": "비상전원공급시스템",
      "definition": "비상전원의 전원장치에서부터 부하단자까지 사이에 설치된 전선·단로장치·과전류 보호장치·절환스위치 등 비상전원 공급을 위한 제어·감시·지원장치로 구성된 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "DT-BE5-004",
      "term": "비상발전기",
      "definition": "상용전원의 공급이 정지되었을 경우 비상전원을 필요로 하는 중요 기계·설비에 대하여 전원을 공급하기 위한 발전장치를 말하며, 디젤 엔진형·가솔린 엔진형·가스터빈 엔진형·스팀터빈 엔진형, 연료전지 발전설비 등이 있다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "DT-BE5-005",
      "term": "축전지",
      "definition": "전기에너지를 화학에너지로 바꾸어 모아 두었다가 필요한 때에 전기에너지를 사용하는 전지(2차전지)를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE5-006",
      "term": "축전지설비",
      "definition": "축전지, 충전장치, 기타 장치로 구성된 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE5-007",
      "term": "전기저장장치",
      "definition": "주야간의 전력사용량과 시간대별 전력 생산의 변동이 불가피한 태양광·태양력·풍력 등과 같은 신재생에너지의 전력을 모아 두었다가 필요한 시간에 사용 할 수 있도록 하는 대용량 축전장치를 말하며, 축전지설비, 전력 수요의 감지 및 역송전 제어 장치 등으로 구성된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE5-008",
      "term": "무정전 전원공급장치",
      "definition": "축전지설비, 컨버터(교류/직류 변환장치), 인버터(직류/교류 변환장치)와 제한된 시간동안에 정현파 전원을 확보할 수 있도록 설계된 제어회로로 구성된 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE5-009",
      "term": "자동절환스위치",
      "definition": "하나 이상의 부하를 한 전원에서 다른 전원으로 자동 절환할 수 있는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE5-010",
      "term": "비상전용 수전설비",
      "definition": "상용전원과는 별도로 외부에서 비상전원을 공급받기 위한 예비 수전설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BE5-01",
      "processOrder": 1,
      "processName": "비상전원 종류 선정",
      "safetyMeasures": "사업장에서 필요한 발전기용량과 시설 투자비 등을 고려하여 비상발전기설비, 축전지설비, 비상전원용 수전설비 중 적합한 종류를 선정한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-02",
      "processOrder": 2,
      "processName": "비상전원 시설 설치",
      "safetyMeasures": "저압·고압 발전기 전로에 개폐기, 과전류차단기, 전압계, 전류계 등을 시설하고 금속 외함 등을 접지한다. 축전지 전로에 개폐기 또는 과전류차단기를 시설하고, 개방형 축전지는 절연물질 프레임에 애자로 지지하여 시설한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-03",
      "processOrder": 3,
      "processName": "상용전원 절환 시설 설치",
      "safetyMeasures": "배전반에 절환스위치를 설치하여 상용전원과 비상전원이 상호 혼촉되지 않도록 하고, 역송전을 방지하도록 시설한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-04",
      "processOrder": 4,
      "processName": "비상전원 운전방법 결정 및 보호계전기 설치",
      "safetyMeasures": "단독운전 또는 병렬운전 방법을 결정하고, 병렬운전 시 전압·주파수·위상 일치 조건과 동기투입 설비를 갖춘다. 기동시간 지연장치(타이머)를 설치하여 우발적 기동을 방지한다. 필요시 보호(역전력)계전기를 설치한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-05",
      "processOrder": 5,
      "processName": "비상전원 공급대상 부하설비 선정",
      "safetyMeasures": "공정기술자가 전기기술자의 협조를 얻어 비상부하설비를 선정한다. 비상전원 공급 부하, 자동충전기 공급 부하, 무정전원 공급 부하로 분류하여 비상발전기와 축전지설비 또는 무정전 전원공급장치를 상호 보완 운전한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-20",
      "processOrder": 6,
      "processName": "비상발전기 용량산정",
      "safetyMeasures": "GP법(KDS 31 60 20:2021)을 적용하여 용량을 산정한다. 계산된 용량 이상의 표준정격을 선정하고, 고조파 발생 부하가 많은 경우 제조업체 계산방식을 참조한다. 전동기는 직입기동으로 계산하되 동시 기동을 배제한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-21",
      "processOrder": 7,
      "processName": "비상발전기실 구획 및 설치",
      "safetyMeasures": "내화도 2시간 이상 방화구획 전용실에 설치한다. 침수·홍수·하수구 역류 등 재난으로부터 손상 가능성이 최소화되는 곳에 위치시킨다. 옥외 설치 시 눈·비 침입 방지 조치를 한다. 창고 등 타용도 사용을 금지한다.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-22",
      "processOrder": 8,
      "processName": "비상발전기 배관 및 기계 설치",
      "safetyMeasures": "연료·배기·윤활유 배관의 처짐과 누출을 방지하도록 견고하게 받침대에 설치한다. 진동방지장치를 회전장치와 미끄럼방지 기초 사이에 설치한다. 소음 제어장치를 고려한다.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보안경"
      ],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-23",
      "processOrder": 9,
      "processName": "비상발전기 환기 및 냉각 설비 설치",
      "safetyMeasures": "발전기실 온도 상승 방지를 위한 환기조치를 강구한다. 충분한 연소용 공기를 공급한다. 냉각설비는 전부하 정격에서 엔진 냉각에 충분한 용량으로 한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-24",
      "processOrder": 10,
      "processName": "비상발전기 배기 및 연료 설비 설치",
      "safetyMeasures": "배기설비는 기밀구조로 하여 독성 연무가 건물 내 환류되지 않도록 한다. 연료탱크는 4~8시간 운전 가능한 용량으로 선정한다. 연료탱크 공급배관은 탱크 바닥까지 연장하거나 접지케이블을 연결하고, 연료 인화점에 따라 방폭구역을 설정한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-ELECTRIC-008",
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "WP-BE5-25",
      "processOrder": 11,
      "processName": "비상발전기 전기 및 보호 설비 설치",
      "safetyMeasures": "비상조명을 축전지로 확보하며 조도 100룩스 이상으로 한다. 낙뢰 손상 방지를 위한 보호 조치를 한다. 축전지 충전 시 발생 가스 제거를 위한 환기장치를 설치한다. 운전절차 및 비상전원 공급계통도를 비치한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-ELECTRIC-008",
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "WP-BE5-26",
      "processOrder": 12,
      "processName": "비상발전기 정기 운전시험",
      "safetyMeasures": "월 1회 무부하 상태에서 30분 이상 운전을 실시한다. 대기오염경보 또는 비상저감조치 발령 시 해제 이후 운전을 실시한다. 유지관리 계획을 서면으로 정하여 구내에 비치한다.",
      "requiredPPE": [
        "보안경"
      ],
      "sourceSection": "6.3",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-27",
      "processOrder": 13,
      "processName": "연료계통 유지관리 점검",
      "safetyMeasures": "주공급 탱크 액위, 일일탱크 레벨 및 액위스위치, 공급/전환펌프 작동, 솔레노이드 밸브 작동을 정기 점검한다. 여과기·필터를 점검·청소하고, 유연 호스 및 접속기, 탱크 통기관 및 오버플로우 배관을 확인한다.",
      "requiredPPE": [],
      "sourceSection": "부록2",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-28",
      "processOrder": 14,
      "processName": "윤활·냉각·배기계통 유지관리 점검",
      "safetyMeasures": "윤활유 액위 점검 및 오일교환(50시간 또는 매년), 오일필터 교체를 실시한다. 냉각계통 수위·동결방지 보호레벨·냉각수 적합성을 확인하고, 팬/벨트를 점검한다. 배기설비 누출·드레인·단열·화재위험·배압을 점검한다.",
      "requiredPPE": [],
      "sourceSection": "부록2",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-BE5-29",
      "processOrder": 15,
      "processName": "축전지·전기설비 유지관리 점검",
      "safetyMeasures": "축전지 전해액 액위, 단자 조임, 부식 제거, 비중/충전상태, 충전기/충전률, 균등충전을 점검한다. 전기설비 배선 접속부 조임, 안전장치/경보기 작동 시험, 회로차단용 퓨즈 점검을 실시한다.",
      "requiredPPE": [
        "절연장갑"
