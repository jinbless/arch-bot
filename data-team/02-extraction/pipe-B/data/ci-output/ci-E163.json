  "checklistItems": [
    {
      "identifier": "CI-E163-001",
      "text": "도체는 견고한 금속 배관, 금속 튜브, 비금속 배관, 케이블 트레이, 버스웨이, 케이블 버스, 기타 적합한 금속피복케이블(Metal-clad cable) 등에 설치해야한다.",
      "guideContext": "600 V 이상 전력시스템 지상 배선",
      "additionalDetail": null,
      "workProcessPhase": "지상 배선 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-002",
      "text": "유자격자만이 접근 할 수 있는 장소에서는 케이블, 나도체 및 버스 바의 노출 설치가 허용된다. 버스 바는 구리 또는 알루미늄이어야 한다.",
      "guideContext": "600 V 이상 전력시스템 지상 배선",
      "additionalDetail": null,
      "workProcessPhase": "지상 배선 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E163-003",
      "text": "외장(Bare lead sheath or a braided outer covering) 절연 전선 및 케이블은 편조 또는 외장이 물리적으로 손상되지 않도록 설계되어야 한다.",
      "guideContext": "600 V 이상 전력시스템 지상 배선",
      "additionalDetail": null,
      "workProcessPhase": "지상 배선 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-004",
      "text": "지상으로 나오는 도체는 인증된 배관 내에 설치되어야 한다.",
      "guideContext": "600 V 이상 전력시스템 지상 배선",
      "additionalDetail": null,
      "workProcessPhase": "지상 배선 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E163-005",
      "text": "편조 절연도체를 노출 설치하는 경우, 편조선은 난연성이거나 설치한 후에 난연처리해야 한다.",
      "guideContext": "편조 절연도체 노출 설치",
      "additionalDetail": null,
      "workProcessPhase": "편조 절연도체 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-006",
      "text": "난연 조치된 편조피복은 사용 전압에 따라 단자에서 안전거리만큼 벗겨야 한다.",
      "guideContext": "편조 절연도체 노출 설치",
      "additionalDetail": null,
      "workProcessPhase": "편조 절연도체 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-007",
      "text": "차폐 케이블의 금속 및 반도체 절연차폐부(Semiconductor insulation shielding components)는 전압의 크기와 절연정격에 따라 이격거리를 확보하고 제거한다.",
      "guideContext": "절연차폐 처리",
      "additionalDetail": null,
      "workProcessPhase": "절연차폐 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-008",
      "text": "응력 감소조치는 차폐(Factory-applied shielding)된 모든 단자에 조치되어야한다.",
      "guideContext": "절연차폐 처리",
      "additionalDetail": null,
      "workProcessPhase": "절연차폐 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-009",
      "text": "테이프, 연선, 편조 또는 이들의 조합과 같은 도전성 및 반도체성 부품과 같은 금속 차폐 부품은 접지하여야한다.",
      "guideContext": "절연차폐 처리",
      "additionalDetail": null,
      "workProcessPhase": "절연차폐 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E163-010",
      "text": "케이블 도체가 금속 외장을 뚫고 나오는 경우와 습기 또는 물리적 손상으로부터 도체의 절연 보호가 필요한 경우에는 케이블 외장 말단장치(Cable sheath terminating device)에 의해 보호하여야한다.",
      "guideContext": "금속 피복 케이블 보호",
      "additionalDetail": null,
      "workProcessPhase": "케이블 보호 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-011",
      "text": "옥내 설치되는 차단장치는 금속외함이거나 내화성의 셀(Fire-resistant cell mounted units)로 구성되어야 한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-012",
      "text": "유자격자만이 접근 할 수 있는 위치에서는 차단기의 노출 설치가 허용되며, 차단기의 개폐 여부를 나타내는 표시가 있어야 한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-013",
      "text": "도체 및 장비를 보호하기 위해 퓨즈를 사용하는 경우, 접지되지 않은 도체에 퓨즈를 설치해야한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-014",
      "text": "방출형 파워퓨즈(Power fuses of the vented type)는 옥내, 지하 또는 금속외함 등 위험이 가중되는 밀폐된 공간 등에서 사용은 가급적 억제하도록 한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-015",
      "text": "건물 또는 변압기실에 설치된 퓨즈형 컷아웃(Cutout)은 용도에 적합한 구조이어야 한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E163-016",
      "text": "배전용 컷아웃(Cutout)은 옥내, 지하 또는 금속외함에 사용해서는 아니 된다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E163-017",
      "text": "퓨즈는 쉽게 교체 할 수 있어야한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-018",
      "text": "퓨즈형 컷아웃이 전 부하(Full load)로 운전중 전로를 단로하는 데 적합하지 않은 경우 전체 부하를 단로하기 위한 인증된 단로장치를 설치해야한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "CI-E163-019",
      "text": "부하상태에서 퓨즈형 컷아웃이 개방되는 것을 방지하기 위하여 연동된 스위치가 설치되어 있음에도 이러한 컷아웃에는 눈에 잘 띄는 곳에 다음과 같은 표시를 하여야 한다. \"경고 – 부하상태에서는 조작하지 마세요\"",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-020",
      "text": "유입 컷아웃의 충전부 또는 차폐되지 않은 케이블과 접촉되는 것을 방지하기 위하여 적합한 배리어 또는 외함(Enclosures)이 구비되어야한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-021",
      "text": "부하 인터럽터 스위치(Load interrupter switches)는 고장전류를 차단하기 위한 적합한 퓨즈 또는 이러한 장치에 접속된 전로에만 사용할 수 있다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-022",
      "text": "이들 장치를 조합하여 사용하는 경우에는 규정된 최대 단락정격의 전류를 투입, 또는 차단에 따른 영향을 안전하게 견딜 수 있도록 전기적으로 협조되어야한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": "부하 인터럽터 스위치와 퓨즈 조합 사용 시",
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-023",
      "text": "서로 다른 전원도체에 대한 대체 접속을 위해 상호 접속된 부하 단자가 있는 스위치가 두 개 이상 설치되는 경우, 각 스위치에는 다음과 같은 명확한 표시가 있어야한다. \"경고 – 스위치는 역류(BACK FEED)에 의해 충전 될 수 있습니다.\"",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-024",
      "text": "검사 및 정비를 위하여 기기를 완전히 분리시키기 위한 장치(퓨즈 홀더 및 퓨즈)를 설치하여야 한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "CI-E163-025",
      "text": "전로의 부하전류를 차단하도록 설계되지 않은 분리장치는 인증된 차단장치와 연동시키거나 부하 하에 개로에 대한 경고 표지를 구비하여야한다.",
      "guideContext": "차단 및 단로장치 설치",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "CI-E163-026",
      "text": "이동 기계에는 전원 케이블의 단자를 감싸기 위한 금속 외함(Enclosure)을 설치하여야한다. 외함에는 기계 프레임을 효과적으로 접지시키기 위한 접지단자가 있어야한다.",
      "guideContext": "모바일 및 휴대 장비",
      "additionalDetail": null,
      "workProcessPhase": "이동 장비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E163-027",
      "text": "사용된 케이블 단말처리방법은 케이블에 가해지는 어떠한 응력(Strain or pull)이라도 전기 접속부에 가해지지 않도록 하여야한다.",
      "guideContext": "모바일 및 휴대 장비",
      "additionalDetail": null,
      "workProcessPhase": "이동 장비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-028",
      "text": "외함 등은 잠금장치를 설치하여 인가된 사람만 열 수 있도록 하고 충전부에 대한 경고표시를 해야 한다.",
      "guideContext": "모바일 및 휴대 장비",
      "additionalDetail": null,
      "workProcessPhase": "이동 장비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-029",
      "text": "충전되는 모든 개폐 및 제어부는 효과적으로 접지된 금속 캐비닛 또는 외함으로 감싸야 한다.",
      "guideContext": "모바일 및 휴대 장비",
      "additionalDetail": null,
      "workProcessPhase": "이동 장비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-030",
      "text": "차단기 및 보호장비는 잠긴 문을 열지 않고도 설정 할 수 있도록 금속캐비닛 또는 외함을 통해 조작장치를 돌출시켜야한다.",
      "guideContext": "모바일 및 휴대 장비",
      "additionalDetail": null,
      "workProcessPhase": "이동 장비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-031",
      "text": "외함 및 금속 캐비닛은 허가 된 사람만이 접근할 수 있도록 잠귀야하고 충전부가 있음을 알리는 경고표지가 있어야한다.",
      "guideContext": "모바일 및 휴대 장비",
      "additionalDetail": null,
      "workProcessPhase": "이동 장비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-032",
      "text": "회전식 기계(삽, 굴착기 등)의 컬렉터링조립체(Collector ring assemblies)는 방호되어야한다.",
      "guideContext": "모바일 및 휴대 장비",
      "additionalDetail": null,
      "workProcessPhase": "이동 장비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-033",
      "text": "터널 내의 전선은 다음 중 하나 이상이어야 한다. (가) 금속전선관 등(Metal conduit or other metal raceway) (나) 유형 MC 케이블(Type MC cable) (다) 기타 승인 된 다극 전선(기타 인증된 다심케이블)",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-034",
      "text": "도체 및 케이블은 물리적 손상으로부터 보호될 수 있는 위치에 설치하거나 보호되어야한다.",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-035",
      "text": "전기기기의 접지도체는 금속관 내부 또는 다심케이블 재킷 내부의 도체와 함께 시설하여야 한다. 기기 접지도체는 절연도체 또는 나도체로 할 수 있다.",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E163-036",
      "text": "변압기, 스위치, 전동기 컨트롤러 및 기타 장비의 절연되지 않은 단자는 우발적으로 충전부에 접촉되지 않도록 감싸야 한다.",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E163-037",
      "text": "터널에서 사용하는 외함은 환경조건에 따라 방수형(Drip-proof), 내후형(Weather proof) 또는 수중형(Submersible)이어야한다.",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E163-038",
      "text": "스위치 또는 접촉기 외함은 그 목적에 적합한 공간을 확보하기 위해 특별히 설계되지 않는 한, 다른 스위치의 도체를 연결하거나 빼는 정선박스 또는 전선관용으로 할 수 없다.",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E163-039",
      "text": "모든 비접지도체를 동시에 개방하는 단로장치는 각각의 변압기 또는 전동기 위치에 설치되어야한다.",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "CI-E163-040",
      "text": "전기기기, 금속전선관 및 케이블 피복의 모든 비충전 금속부분은 터널 입구 및 터널(전체 길이) 300 m 이내의 간격으로 모든 금속파이프 및 레일을 효과적으로 접지 및 본딩시켜야한다.",
      "guideContext": "터널 설비",
      "additionalDetail": null,
      "workProcessPhase": "터널 전기설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E163-041",
      "text": "비상전로 배선은 다른 배선 및 장비와 완전히 독립적이어야 하며, 목적에 적합한 공통전로가 필요한 경우를 제외하고는 동일 전선관, 케이블, 박스 또는 캐비닛 또는 기타 배선에 인입되어서는 아니 된다.",
      "guideContext": "비상 전원시스템",
      "additionalDetail": null,
      "workProcessPhase": "비상전원시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-E163-042",
      "text": "비상조명에는 출구 조명, 비상구 표시 및 기타 필요한 조명에 요구되는 모든 수단을 포함하여야 한다.",
      "guideContext": "비상 전원시스템",
      "additionalDetail": null,
      "workProcessPhase": "비상전원시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-E163-043",
      "text": "비상조명이 필요한 곳에서는 전구가 터지는 것과 같은 개별 조명기구의 고장에 의하여 어두운 공간이 생기지 않도록 시스템을 배치해야한다.",
      "guideContext": "비상 전원시스템",
      "additionalDetail": null,
      "workProcessPhase": "비상전원시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-E163-044",
      "text": "현장 비상전원의 종류와 위치를 나타내는 표지는 입구 측에 설치되어야한다.",
      "guideContext": "비상 전원시스템",
      "additionalDetail": "개별 단위 장비에는 표지가 필요하지 않다",
      "workProcessPhase": "비상전원시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-E163-045",
      "text": "비상전원에 연결된 접지도체가 비상전원에서 멀리 떨어진 곳에서 접지전극에 접속되어있는 경우, 접속된 모든 비상 및 정상전원을 나타내는 표시가 접지위치에 있어야한다.",
      "guideContext": "비상 전원시스템",
      "additionalDetail": null,
      "workProcessPhase": "비상전원시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-E163-046",
      "text": "비전력제한화재경보(NPLFA, Nonpower-limited fire alarm)회로의 전원은 공칭전압이 600 V 이하이어야 한다.",
      "guideContext": "화재경보시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재경보시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-047",
      "text": "전력제한화재경보(PLFA, Power-limited fire alarm) 회로의 전원은 PLFA 전원으로 표시하여야 한다.",
      "guideContext": "화재경보시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재경보시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-048",
      "text": "전원공급장치 및 화재경보회로 도체는 같은 장비에 접속된 경우에만 같은 외함, 케이블 또는 전선관에서 사용할 수 있다.",
      "guideContext": "화재경보시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재경보시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-049",
      "text": "전력제한전로케이블 및 도체는 전등, 전원, 비전력제한화재경보 회로도체 또는 중간전력 광대역통신회로 등의 케이블, 케이블 트레이, 외함, 이웃랫 박스, 전선관 또는 이와 유사한 피팅 내에 설치하지 않도록 한다.",
      "guideContext": "화재경보시스템",
      "additionalDetail": null,
      "workProcessPhase": "화재경보시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-050",
      "text": "전원제한화재경보회로도체는 전등, 전력선, 비전력제한화재경보 또는 중간전력 광대역통신회로의 도체로부터 최소한 50.0 ㎜ 이상 이격시켜야 한다.",
      "guideContext": "화재경보시스템 (법령 근거 미확인)",
      "additionalDetail": "특별한 목적을 위하여 적합한 보호조치를 하고 승인을 받은 경우에는 제외",
      "workProcessPhase": "화재경보시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-051",
      "text": "화재경보회로는 시험 및 정비 중 신호회로와의 의도하지 않은 간섭을 방지하기 위한 방법으로 단자 및 접합부 위치에서 식별되어야한다.",
      "guideContext": "화재경보시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재경보시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-052",
      "text": "전원제한화재경보회로는 말단에서 보이는 곳에 명확하게 표시를 한다.",
      "guideContext": "화재경보시스템 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재경보시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-053",
      "text": "1차측 보호장치(Primary protector)는 일정 블록 내로 제한되지 않는 가공전선 또는 가공 케이블에 부분적 또는 전체적으로 설치하여야한다.",
      "guideContext": "통신시스템 보호장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-054",
      "text": "1차측 보호장치는 건물 내 일정 블록 내의 전로위치가 대지전압 300 V를 넘는 전등 또는 전력선의 우발적인 접촉에 노출되어있는 각각 가공 또는 지하전로에 또한 설치해야 한다.",
      "guideContext": "통신시스템 보호장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-055",
      "text": "낙뢰가 우려되는 곳에서는 추가적으로 건물 내 전로의 각 끝 부분에 나열된 1차 보호장치로 보호되어야한다.",
      "guideContext": "통신시스템 보호장치",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "CI-E163-056",
      "text": "건물 또는 구조물에 대한 최초 설치지점을 포함하여 기둥이나 다른 지지대의 인입선 또는 인하선 케이블은 전등, 전력 또는 비전력제한화재경보 등의 도체와 우발적인 접촉 가능성을 없애기 위해 충분히 이격시켜야한다.",
      "guideContext": "통신시스템 도체위치",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E163-057",
      "text": "건물과 피뢰도체 위의 통신선과 케이블 사이에는 최소 1.8 m의 간격을 유지해야 한다.",
      "guideContext": "통신시스템 도체위치",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "CI-E163-058",
      "text": "하나의 전주 위에서 통신선 및 통신케이블은 전등선 또는 전력선 아래 위치해야한다.",
      "guideContext": "통신시스템 도체위치 (법령 근거 미확인)",
      "additionalDetail": "통신선, 통신 케이블, 전등 또는 전력도체가 같은 전주에 의해 지지되거나 다른 간격으로 병렬로 놓이는 경우",
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-059",
      "text": "통신선 및 통신케이블은 전등선 또는 전력선과 같은 완금(Cross arm)에 설치해서는 아니 된다.",
      "guideContext": "통신시스템 도체위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-060",
      "text": "옥내 통신선과 통신케이블은 전등, 전력, 비전력제한화재경보 또는 중전력 광대역통신 등의 도체에서 최소 50.0 ㎜ 이상 떨어져 있어야한다.",
      "guideContext": "통신시스템 도체위치 (법령 근거 미확인)",
      "additionalDetail": "특별한 목적을 위하여 적합한 보호조치를 하고 승인을 받은 경우에는 제외",
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-061",
      "text": "수직 또는 쌍극안테나 구조물과 같은 자체지지 안테나뿐만 아니라 옥외 안테나 금속지지물 등은 대지전압 150 V 이상의 전등 및 전력선 등 가공전로와의 우발적인 접촉을 피하기 위하여 멀리 이격시켜야한다.",
      "guideContext": "통신시스템 장비 위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-062",
      "text": "만약 통신선 등이 전등 및 전력 도체와 접촉될 우려가 있다면, 건물에 인입된 가공 케이블의 금속 외장을 접지시키거나 절연 조인트 또는 이와 동등한 장치로 건물 입구 가까이에서 차단하여야한다.",
      "guideContext": "통신시스템 접지",
      "additionalDetail": "보호장치를 사용하는 경우에는 승인된 방식으로 접지해야한다",
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.4",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E163-063",
      "text": "안테나를 지지하는 기둥 및 금속 구조물은 접지도체에 스플라이스 또는 접속없이 효과적으로 영구 접지되어야한다.",
      "guideContext": "통신시스템 접지",
      "additionalDetail": null,
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.4",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E163-064",
      "text": "송신기(Transmitter)는 금속 프레임 또는 그릴로 둘러싸거나 배리어로 작동공간을 분리시키되, 모든 금속 부분은 효과적으로 접지에 접속하여야한다.",
      "guideContext": "통신시스템 접지",
      "additionalDetail": "운전자가 접근 할 수 있는 모든 외부 금속 손잡이 및 제어기는 효과적으로 접지되어야한다",
      "workProcessPhase": "통신시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.4",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E163-065",
      "text": "광전지 전원회로 및 광전지 출력회로는 같은 전선관, 케이블 트레이, 케이블, 아웃렛 박스, 정선 박스 또는 다른 시스템의 모선 또는 분기회로와 같은 피팅 등에 같이 인입해서는 아니 된다.",
      "guideContext": "태양광 발전시스템 (법령 근거 미확인)",
      "additionalDetail": "다른 시스템의 도체가 같이 접속되거나 격벽(Partition)으로 분리된 경우에는 제외",
      "workProcessPhase": "태양광발전시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-066",
      "text": "광전지 전원의 모든 도체는 건물 또는 기타 구조물의 모든 도체로부터 분리시키는 장치를 설치하여야한다.",
      "guideContext": "태양광 발전시스템",
      "additionalDetail": null,
      "workProcessPhase": "태양광발전시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "CI-E163-067",
      "text": "통합 전기시스템에서 아주 중요한 과전류차단장치는 승인되지 않은 자의 조작을 못하는 높이에 설치되어 있다면, 근로자가 쉽게 접근 하지 못하도록 한다.",
      "guideContext": "통합전기시스템",
      "additionalDetail": "KOSHA GUIDE E-85의 '과전류보호장치' 규정에 따름",
      "workProcessPhase": "통합전기시스템 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.2",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E163-068",
      "text": "순차적인 정지 프로세스는 근로자의 위험 및 기기의 손상을 최소화시킬 수 있다.",
      "guideContext": "통합전기시스템 (법령 근거 미확인)",
      "additionalDetail": "통합 전기시스템 범위 조건",
      "workProcessPhase": "통합전기시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-069",
      "text": "정비 및 관리감독의 조건은 유자격자만이 시스템에 관여한다는 것을 보증하는 것이다.",
      "guideContext": "통합전기시스템 (법령 근거 미확인)",
      "additionalDetail": "통합 전기시스템 범위 조건",
      "workProcessPhase": "통합전기시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-070",
      "text": "효과적인 안전조치가 수립되고 정비된다.",
      "guideContext": "통합전기시스템 (법령 근거 미확인)",
      "additionalDetail": "통합 전기시스템 범위 조건",
      "workProcessPhase": "통합전기시스템 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E163-071",
      "text": "두 개의 퓨즈가 동일한 정격인 경우, 동일한 부하를 보호하기 위해 두 개의 전원 퓨즈를 병렬로 사용할 수 있으며 두 개의 퓨즈가 전류를 똑같이 나누는 전기접속으로 공통 설치할 수 있다.",
      "guideContext": "차단 및 단로장치 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차단장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E163-001",
      "term": "특수전력시스템",
      "definition": "600 V를 넘는 전력시스템, 비상전원시스템, 화재경보시스템, 통신시스템, 태양광발전시스템, 통합전기시스템 등의 전기시스템을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-002",
      "term": "전기기계·기구",
      "definition": "전기설비의 일부로 사용되거나, 전기설비에 접속하는 피팅, 전기기구, 조명기구 등을 총칭하는 일반적인 용어를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "DT-E163-003",
      "term": "본딩(Bonding)",
      "definition": "서로 다른 도전성 물체를 저항이 작은 물질로 전기적으로 연결하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-E163-004",
      "term": "나도체(Bare conductor)",
      "definition": "전기 절연물 등으로 피복되지 않은 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-005",
      "term": "절연도체",
      "definition": "이 지침에서 인정하는 성분 또는 두께의 절연물질 내에 인입된 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "DT-E163-006",
      "term": "단로장치(Disconnecting means)",
      "definition": "전기기기 등을 전원으로부터 분리시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "DT-E163-007",
      "term": "차단기(Circuit breaker)",
      "definition": "비자동적으로 전로를 열거나 닫고, 정격 내에서 사용될 경우, 사전 결정된 과전류에서 자동으로 회로를 개방하도록 설계된 기기를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "DT-E163-008",
      "term": "컷아웃(Cutout)",
      "definition": "정격전압 600 V 이상의 전로에서 퓨즈 홀더(Fuse holder), 퓨즈 캐리어(Fuse carrier) 또는 단로 칼날(Disconnecting blade)로 퓨즈의 조립체를 말한다. 퓨즈 홀더 또는 퓨즈 캐리어는 도전성요소 (퓨즈 링크) 또는 녹지 않는 차단칼날일 수도 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-009",
      "term": "(밀폐)외함(Enclosure)",
      "definition": "충전부와의 접촉 사고로부터 작업자를 보호하거나 또는 물리적인 파손으로부터 장비를 보호하기 위해 설비 주위에 설치한 기구의 수납, 외함, 울타리, 벽 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-E163-010",
      "term": "컬렉터링(Collector ring)",
      "definition": "고정자에서 회전자 등으로 전기에너지를 전달하기 위한 슬립링 조립체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-011",
      "term": "컨트롤러(Controller)",
      "definition": "연결되어있는 장치로 전달되는 전력을 일부 사전 결정된 방식으로 제어하는 장치 또는 장치 그룹을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-012",
      "term": "간선",
      "definition": "인입구에서 분기과전류차단기에 이르는 배선으로서 분기회로의 분기점에서 전원측까지의 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-013",
      "term": "분기회로",
      "definition": "말단회로 보호용 과전류 보호장치와 수구 사이의 전기회로를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "DT-E163-014",
      "term": "접지",
      "definition": "전기선로나 설비를 대지 또는 지중 도전성 물체 등과 전기적으로 접속하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-E163-015",
      "term": "접지도체",
      "definition": "접지전극에 설비나 다른 접지도체를 연결하기 위한 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-E163-016",
      "term": "비접지시스템",
      "definition": "절연변압기 또는 전로의 격리를 위한 감시장치를 설치하는 등의 방법으로 전원측의 중성점 또는 전원계통의 공급단이 접지되지 않은 선로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-017",
      "term": "수구(Outlet)",
      "definition": "부하설비에 전류를 공급하기 위한 접속기구의 한 부분으로 소켓, 리셉터클 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E163-018",
      "term": "과부하",
      "definition": "설비의 손상이나 과열 우려가 있는 정격 이상의 부하를 일정 시간 이상동안 사용하는 경우를 말하며, 단락이나 지락 고장과 같은 사고는 과부하에 속하지 않는다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "DT-E163-019",
      "term": "유자격자(Qualified person)",
      "definition": "전기설비의 시공, 운전 및 기타 전기작업에 관련된 국가기술자격, 공인자격을 보유하거나 교육훈련을 받아 기능 및 지식을 보유한 사람을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E163-01",
      "processOrder": 1,
      "processName": "600 V 이상 전력시스템 지상 배선 설치",
      "safetyMeasures": "도체는 견고한 금속 배관, 금속 튜브, 비금속 배관, 케이블 트레이, 버스웨이, 케이블 버스, 기타 적합한 금속피복케이블 등에 설치. 유자격자만 접근 가능한 장소에서만 나도체 및 버스 바 노출 설치 허용. 버스 바는 구리 또는 알루미늄 사용. 지상으로 나오는 도체는 인증된 배관 내에 설치.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-ELECTRIC-013",
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "WP-E163-02",
      "processOrder": 2,
      "processName": "편조 절연도체 노출 설치",
      "safetyMeasures": "편조선은 난연성이거나 설치 후 난연처리. 난연 조치된 편조피복은 사용 전압에 따라 단자에서 안전거리만큼 벗김.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "WP-E163-03",
      "processOrder": 3,
      "processName": "절연차폐 처리",
      "safetyMeasures": "차폐 케이블의 금속 및 반도체 절연차폐부는 전압의 크기와 절연정격에 따라 이격거리를 확보하고 제거. 응력 감소조치는 차폐된 모든 단자에 조치. 금속 차폐 부품은 접지.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": [
        "SR-ELECTRIC-002",
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "WP-E163-04",
      "processOrder": 4,
      "processName": "차단 및 단로장치 설치",
      "safetyMeasures": "옥내 차단장치는 금속외함이거나 내화성의 셀로 구성. 차단기 개폐 여부 표시 필수. 접지되지 않은 도체에 퓨즈 설치. 검사 및 정비를 위한 완전 분리장치 설치. 경고 표시 부착.",
      "requiredPPE": [],
      "sourceSection": "5.5",
      "relatedSR": [
        "SR-ELECTRIC-005",
        "SR-ELECTRIC-019"
      ]
    },
    {
      "identifier": "WP-E163-05",
      "processOrder": 5,
      "processName": "모바일 및 휴대 장비 전기설비 설치",
      "safetyMeasures": "이동 기계에 전원 케이블 단자용 금속 외함 설치 및 접지단자 구비. 케이블 단말처리 시 응력이 전기 접속부에 가해지지 않도록 처리. 외함에 잠금장치 설치 및 충전부 경고표시. 충전되는 개폐 및 제어부는 접지된 금속 캐비닛 또는 외함으로 보호. 컬렉터링조립체 방호.",
      "requiredPPE": [],
      "sourceSection": "5.6",
      "relatedSR": [
        "SR-ELECTRIC-001",
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "WP-E163-06",
