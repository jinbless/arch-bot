  "checklistItems": [
    {
      "identifier": "CI-CC38-001",
      "text": "사고예상질문분석 기법으로 대상 공정의 위험성을 완전히 평가할 수 없는 경우에는 체크리스트기법으로 보완하여야 한다.",
      "guideContext": "사고예상질문분석(WHAT-IF) 적용 대상공정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC38-002",
      "text": "다음은 산업안전보건법령에 관한 사항으로써 반드시 준수하여야 한다.",
      "guideContext": "공정안전보고서 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조(공정안전보고서의 세부 내용 등) 제1항 제2호에 따라 공정위험성평가서를 작성하여야 하며, 사고예상질문분석(What-if) 등 위험성평가 기법을 사용하여야 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC38-003",
      "text": "사고예상질문분석의 결과는 목록의 형태로 나타내며 다음 사항을 반드시 포함하여야 한다.",
      "guideContext": "사고예상질문분석 결과 작성 (법령 근거 미확인)",
      "additionalDetail": "포함 사항: (가) 사고예상질문, (나) 사고 및 결과, (다) 위험등급, (라) 개선권고사항, (마) 조치계획",
      "workProcessPhase": "결과 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC38-004",
      "text": "유해·위험물질의 누출량, 인명 및 재산피해, 가동정지 기간 등의 치명도와 발생빈도를 감안하여 1에서 5까지 위험등급을 표시한다.",
      "guideContext": "위험등급 평가",
      "additionalDetail": null,
      "workProcessPhase": "결과 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC38-005",
      "text": "위험등급, 발생빈도, 치명도는 [불임1]에서 예시한 바를 참고하여 사업장의 특성에 맞도록 표준을 정한다.",
      "guideContext": "위험등급 기준 설정",
      "additionalDetail": null,
      "workProcessPhase": "결과 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC38-006",
      "text": "위험등급이 1이나 2인 경우 경영자는 회사의 표준에 따라 반드시 조치를 취해야 하며 나머지 등급의 것에 대한 조치도 강구한다.",
      "guideContext": "사고예상질문분석 후속조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-CC38-007",
      "text": "경영자는 공정안전관리 추진팀에게 평가결과보고서의 내용들이 적절하게 추진되어 있는지를 감시하게 하여야 한다.",
      "guideContext": "사고예상질문분석 후속조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-CC38-008",
      "text": "후속조치의 책임부서는 회사의 특성에 따라 정비부, 기술부, 사업부 등에서 각각 시행할 수 있도록 책임부서를 지정하여야 한다.",
      "guideContext": "사고예상질문분석 후속조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC38-001",
      "term": "사고예상질문분석(WHAT-IF)",
      "definition": "공정위험성평가서를 작성하기 위한 위험성평가 기법으로, 공장전반에 대하여 적용할 수 있으며, 주로 공정 및 설비의 이상과 공정의 변화에 대하여 적용한다.",
      "sourceSection": "1",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC38-002",
      "term": "검토구간(Node)",
      "definition": "공정의 흐름을 따라서 설정하는 위험성평가 단위로, 기계장치와 배관류, 기계류, 전기계통 등이 모여서 하나의 공정을 구성하는 경우에는 세부 공정단위 또는 공정부문별로 묶어서 설정할 수 있다.",
      "sourceSection": "7",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC38-003",
      "term": "위험등급",
      "definition": "유해·위험물질의 누출량, 인명 및 재산피해, 가동정지 기간 등의 치명도와 발생빈도를 감안하여 1에서 5까지 표시하는 등급으로, 치명도와 빈도의 조합으로 결정된다.",
      "sourceSection": "9",
      "relatedSR": null
    }
  ],
