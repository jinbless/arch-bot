  "checklistItems": [
    {
      "identifier": "CI-BE15-001",
      "text": "사업주는 근로자가 작업이나 통행 등으로 인하여 전기기계, 기구 또는 전로 등의 충전부분에 접촉하거나 접근함으로써 감전 위험이 있는 충전부분에 대하여 감전을 방지하기 위하여 다음 각 호의 방법 중 하나 이상의 방법으로 방호하여야 한다.",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제1항 본문",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-002",
      "text": "충전부가 노출되지 않도록 폐쇄형 외함이 있는 구조로 할 것",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제1항 제1호",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-003",
      "text": "충전부에 충분한 절연효과가 있는 방호망이나 절연덮개를 설치할 것",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제1항 제2호",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-004",
      "text": "충전부는 내구성이 있는 절연물로 완전히 덮어 감쌀 것",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제1항 제3호",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-005",
      "text": "발전소·변전소 및 개폐소 등 구획되어 있는 장소로서 관계 근로자가 아닌 사람의 출입이 금지되는 장소에 충전부를 설치하고, 위험표시 등의 방법으로 방호를 강화할 것",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제1항 제4호",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-006",
      "text": "전주 위 및 철탑 위 등 격리되어 있는 장소로서 관계 근로자가 아닌 사람이 접근할 우려가 없는 장소에 충전부를 설치할 것",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제1항 제5호",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-007",
      "text": "사업주는 근로자가 노출 충전부가 있는 맨홀 또는 지하실 등의 밀폐공간에서 작업하는 경우에는 노출 충전부와의 접촉으로 인한 전기위험을 방지하기 위하여 덮개, 울타리 또는 절연 칸막이 등을 설치하여야 한다.",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제2항",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-008",
      "text": "사업주는 근로자의 감전위험을 방지하기 위하여 개폐되는 문, 경첩이 있는 패널 등(분전반 또는 제어반 문)을 견고하게 고정시켜야 한다.",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제301조 제3항",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-009",
      "text": "사업주는 전기기계·기구의 조작부분을 점검하거나 보수하는 경우에는 근로자가 안전하게 작업할 수 있도록 전기기계·기구로부터 폭 70센티미터 이상의 작업공간을 확보하여야 한다. 다만, 작업공간을 확보하는 것이 곤란하여 근로자에게 절연용 보호구를 착용하도록 한 경우에는 그러하지 아니하다.",
      "guideContext": "전기작업시의 작업공간 확보",
      "additionalDetail": "제310조 제1항",
      "workProcessPhase": "전기기기 점검·보수",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-010",
      "text": "사업주는 전기적 불꽃 또는 아크에 의한 화상의 우려가 있는 고압 이상의 충전전로 작업에 근로자를 종사시키는 경우에는 방염처리된 작업복 또는 난연성능을 가진 작업복을 착용시켜야 한다.",
      "guideContext": "전기작업시의 작업공간 확보 (법령 근거 미확인)",
      "additionalDetail": "제310조 제2항. candidateSR에 방염작업복 관련 SR 미확인",
      "workProcessPhase": "고압 충전전로 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE15-011",
      "text": "모든 전기기기 주위는 해당기기의 안전운전과 보수작업을 용이하게 할 수 있도록 작업자의 통로 및 작업공간을 충분히 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-012",
      "text": "자물쇠와 열쇠로 관리되고, 폐쇄된 장소에 설치된 전기기기의 작업공간에는 유자격자만 출입하도록 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-013",
      "text": "1,000 V 이하인 충전부의 점검·조정·수리 등 활선 상태에서의 전기작업이 필요할 경우, 작업공간(폭×깊이×높이)의 깊이는 접근 방향에서 <표 1>의 최소거리 이상을 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": "표 1 참조: 대지전압별·조건별 최소거리 90~150cm",
      "workProcessPhase": "저압 전기기기 점검·보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-014",
      "text": "통전되지 않은 전기부품을 작업하기 위해 뒷면 접근로가 필요한 경우에는 최소한 수평거리 70 cm 이상의 작업공간이 필요하다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "저압 전기기기 점검·보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-015",
      "text": "작업공간의 폭은 전기장치 전면에 최소한 70 cm 혹은 70 cm 이상인 전기설비의 경우에는 그 폭을 확보하여야 하고, 배전반 등 전기설비의 문을 90° 이상 열 수 있어야 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-016",
      "text": "배전반, 분전반, 전동기 제어반 등의 작업공간 높이는 바닥으로부터 최소 2 m 이상을 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-017",
      "text": "전기기기의 높이가 2 m를 초과하는 경우 전기기기 상단으로부터 작업자가 작업하기 위한 최소 여유공간 이상을 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-018",
      "text": "이 규정에 의거 확보된 작업공간은 물품 저장소 등 타 용도로 사용되어서는 안 된다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-019",
      "text": "평상시에는 외함으로 격리되어 있으나 점검 또는 보수 시에 충전부가 노출될 우려가 있고, 작업공간이 통로로 사용되거나 일반인에게 개방되는 곳이면 덮개·차폐·매트 등에 의한 방호조치를 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "저압 전기기기 점검·보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-020",
      "text": "전기기기가 있는 작업공간에서 외부로의 작업자 이동을 위한 통로(Gangway)에는 출입구를 1개 이상 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-021",
      "text": "통로의 길이가 10 m 이상인 장소에서 전기기기로 인해 한쪽 면의 통로가 막힌 경우에는, 출입문을 설치하고 벽면으로부터 최소 70 cm 이상의 접근 공간을 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-022",
      "text": "통로의 길이가 20 m 이상인 장소에서는 양쪽 출입문에 의하여 접근이 가능하도록 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-023",
      "text": "전기기기가 설치된 옥내 작업공간에는 전기기기의 조작부분이 150 럭스 이상이 되도록 조명장치를 설치하고, 전기기기실 내에서의 조명은 자동으로 제어되지 않도록 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 저압",
      "additionalDetail": null,
      "workProcessPhase": "전기기기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-024",
      "text": "전기기기의 충전부는 인체와의 접촉을 방지하기 위하여 캐비닛 또는 절연된 외함 내에 설치하거나, 노출된 충전부를 다음의 방법에 의해 방호조치를 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 충전부 방호",
      "additionalDetail": null,
      "workProcessPhase": "저압 충전부 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-025",
      "text": "구획된 장소에 설치하여 유자격자만이 출입하도록 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 충전부 방호",
      "additionalDetail": "충전부 방호 방법 (가)",
      "workProcessPhase": "저압 충전부 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-026",
      "text": "유자격자만이 충전부에 접근하도록 칸막이 또는 망으로 방호된 곳에 설치한다. 칸막이나 망은 일반작업자가 직접 또는 도전성 물체를 통해 충전부에 접촉되지 않는 구조로 설치한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 충전부 방호",
      "additionalDetail": "충전부 방호 방법 (나)",
      "workProcessPhase": "저압 충전부 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-027",
      "text": "일반인이 접근할 수 없도록 전주 위 또는 적절한 높이의 플랫폼(Platform) 위에 전기기기를 설치한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 충전부 방호",
      "additionalDetail": "충전부 방호 방법 (다)",
      "workProcessPhase": "저압 충전부 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-028",
      "text": "바닥이나 기타 작업표면으로부터 상부 2.5 m 이상의 높이에 전기기기를 설치한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 충전부 방호",
      "additionalDetail": "충전부 방호 방법 (라)",
      "workProcessPhase": "저압 충전부 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-029",
      "text": "외부의 기계적 충격에 의해 손상이 우려되는 장소에 설치된 전기기기의 외함이나 방호장치는 충격으로부터 보호될 수 있도록 충분한 강도를 갖게 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 충전부 방호",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-030",
      "text": "노출된 충전부가 있는 실내 또는 기타 방호되어 있는 장소에는 유자격자 이외의 출입을 금지하는 경고표지를 부착한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 이하 충전부 방호",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-031",
      "text": "전기기기는 자물쇠 등 기타 승인된 방법에 의해 통제되는 구획된 장소에 설치하고, 유자격자만이 출입하도록 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 설치장소 구획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-032",
      "text": "구획된 장소의 울타리 높이는 2.1 m 이상 또는 1.8 m의 울타리 위에 3단 이상의 철조망을 30 cm 이상의 높이로 얹는다. 충전부에서 울타리까지의 거리는 <표 2>의 최소거리 값보다 크게 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": "표 2 참조: 전압별 울타리 최소거리 3.0~5.5m",
      "workProcessPhase": "고압 전기기기 설치장소 구획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-033",
      "text": "1,000 V를 초과하는 고압의 전기기기가 설치된 변전실의 벽, 천장, 바닥, 출입문은 3시간의 화재에 견딜 수 있는 충분한 강도의 건축구조로 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 설치장소 구획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BE15-034",
      "text": "노출된 너트나 볼트가 쉽게 제거되지 않고, 충전부분에 쉽게 접근할 수 없도록 제작한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압, 밀폐함 수납 전기기기",
      "additionalDetail": "일반작업자 접근 허용 밀폐함 설치 요건 (가)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-035",
      "text": "일반인이 쉽게 접근할 수 있고 밀폐함의 바닥이 지표면에서 2.5 m 이하에 설치될 경우 밀폐함은 잠금 상태를 유지한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압, 밀폐함 수납 전기기기",
      "additionalDetail": "일반작업자 접근 허용 밀폐함 설치 요건 (나)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-036",
      "text": "밀폐함의 환기구 또는 이와 유사한 개구부는 이를 통해 들어간 이물질이 충전부분으로 향하지 않도록 제작한다. 차량으로 물리적 손상을 입을 위험이 있는 경우 적절한 방호조치를 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압, 밀폐함 수납 전기기기",
      "additionalDetail": "일반작업자 접근 허용 밀폐함 설치 요건 (다)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-037",
      "text": "전기기기 주위는 운전 및 유지보수 작업을 안전하게 수행할 수 있도록 충분한 작업공간을 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 작업공간 확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-038",
      "text": "충전부가 노출되어 있는 설비의 최소 작업공간은 높이 2.0 m (바닥에서 수직으로 측정한 값), 폭 0.9 m (설비에서 수평으로 측정한 값) 이상이어야 하고, <표 3>에 의한 설비와의 최소거리 이상의 깊이를 확보한다. 모든 경우에 있어서 문은 90° 이상 열릴 수 있도록 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": "표 3 참조: 대지전압별·조건별 최소거리 90~370cm",
      "workProcessPhase": "고압 전기기기 작업공간 확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-039",
      "text": "전기기기 등이 설치되어 있는 작업공간에는 적어도 1개 이상의 출입구를 확보하고, 그 크기는 폭 0.6 m, 높이 2 m 이상이어야 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 작업공간 확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-040",
      "text": "폭이 1.8 m 이상인 배전반 또는 제어반이 있는 경우 가능하다면 작업공간 양쪽에 출입구를 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 작업공간 확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-041",
      "text": "충전부분이 노출되어 있거나 1,000 V를 초과하는 절연된 충전부가 입구 가까이에 있으면 절연전선 및 절연 캡을 사용하여 보강하거나 충전부 주위에 투명프라스틱, 구획로프, 보호망 등 국부적인 방호시설을 설치하는 등의 적절한 방호조치를 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 작업공간 확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-042",
      "text": "전기기기가 플랫폼, 다락 등과 같이 높은 곳에 설치되어 있을 경우에는 전기기기 주변의 작업공간에 안전하게 접근할 수 있는 고정 사다리나 계단을 설치한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 작업공간 확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-043",
      "text": "배전반, 차단기, 계전기, 전동기 제어반 등과 이와 유사한 전기기기 전면에서의 작업공간은 <표 3>의 최소거리를 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": "표 3 참조: 노출 시 충전부, 밀폐 시 외함/개구부로부터 측정",
      "workProcessPhase": "고압 전기기기 작업공간 확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-044",
      "text": "통전되지 않은 전기부품을 작업하기 위해 뒷면 접근로가 필요한 경우에는 최소한 수평거리 75 cm 이상의 작업공간이 필요하다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 점검·보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-045",
      "text": "구획된 장소에 1,000 V 이하의 전기기기와 1,000 V를 초과하는 노출전선 또는 충전부분이 있는 전기기기를 함께 설치할 경우에는 칸막이나 울, 격리판 등을 사용하여 방호하고, 고압기기와 저압기기의 설치장소를 격리시킨다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": null,
      "workProcessPhase": "고압 전기기기 설치장소 구획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-046",
      "text": "1,000 V를 초과하는 충전부분 또는 노출전선이 있는 건물, 방, 밀폐구역 등의 입구는 잠금 상태를 유지한다. 다만, 유자격자가 출입구에 상주하는 장소는 예외로 한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-047",
      "text": "1,000 V를 초과하는 전기기기를 설치한 장소에는 \"위험-고전압-출입금지\"라고 쓴 표지판을 눈에 띄는 곳에 영구적으로 부착한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-048",
      "text": "전기기기 주위의 작업공간에는 전기기기의 조작부분이 150 럭스 이상이 되도록 조명장치를 설치하고, 전구의 교체 또는 수리작업 시에 작업자가 노출충전부나 타 설비의 작동부위에 접촉될 우려가 없도록 설치한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE15-049",
      "text": "작업공간 상부에 위치한 노출 충전부분은 방호조치가 되어 있지 않으면 작업장 바닥으로부터 <표 4>의 최소 높이 값 이상을 확보한다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": "표 4 참조: 전압별 최소 높이 2.7~2.9m+α",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-BE15-050",
      "text": "전기기기의 설치, 유지보수 등과 관계없는 배관과 덕트는 금속제 배전반, 제어반의 주변에 설치하지 않는다. 다만 전기설비 보호를 위한 방재설비인 경우는 그러하지 아니하다.",
      "guideContext": "전기작업시의 작업공간 확보 - 1,000V 초과 고압 세부사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BE15-001",
      "term": "전기기계·기구(전기기기)",
      "definition": "전동기·변압기·접속기·개폐기·분전반·배전반 등 전기를 통하는 기계·기구, 기타의 설비 중 배선 및 이동전선 외의 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-BE15-002",
      "term": "노출",
      "definition": "안전거리 이내로 가깝게 접근하거나 접촉될 우려가 있는 것으로서, 충전부분에 절연, 방호 등이 되어 있지 않은 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-BE15-003",
      "term": "방호",
      "definition": "작업자 또는 물체가 충전부분에 접촉되지 않도록 덮개·차폐·장벽·매트 등에 의하여 둘러싸인 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-BE15-004",
      "term": "격리",
      "definition": "특별한 수단을 이용하지 않고는 사람이 쉽게 접근할 수 없는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE15-005",
      "term": "분전반",
      "definition": "캐비닛이나 컷-아웃 박스 내에 모선(Bus-bar), 과전류 차단장치, 스위치 등이 단일 판넬 형태로 설치된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE15-006",
      "term": "배전반",
      "definition": "대형 판넬 또는 프레임의 앞면이나 뒷면, 또는 양면 모두에 모선, 과전류 차단장치, 스위치, 계측기 등이 부착된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE15-007",
      "term": "유자격자",
