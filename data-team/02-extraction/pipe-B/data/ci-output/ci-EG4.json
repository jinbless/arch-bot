  "domainTerms": [
    {
      "identifier": "DT-EG4-001",
      "term": "근골격계질환",
      "definition": "반복적인 동작, 부적절한 자세, 과도한 힘의 사용, 날카로운 면과의 신체 접촉, 진동 및 온도 등의 요인에 의하여 발생하는 건강장해로서 목, 어깨, 허리, 상하지의 신경근육 및 그 주변 신체 조직 등에 나타나는 질환을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG4-002",
      "term": "근골격계질환 예방관리 프로그램",
      "definition": "유해요인조사, 작업환경개선, 의학적 관리, 교육 및 훈련, 평가에 관한 사항 등이 포함된 근골격계질환을 예방관리하기 위한 종합적인 계획을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-EG4-01",
      "processOrder": 1,
      "processName": "유해요인 조사자 선정",
      "safetyMeasures": "중·소규모 사업장은 근로자 대표 또는 명예산업안전감독관을 포함하여 관리자(예산결정권자), 정비·보수담당자, 보건·안전담당자, 구매담당자 등이 참여하도록 구성하고, 대규모 사업장은 추가로 기술자(생산, 설계, 보수기술자), 노무담당자 등이 참여하도록 구성한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-EG4-02",
      "processOrder": 2,
      "processName": "유해요인 조사",
      "safetyMeasures": "유해요인조사표를 활용하여 조사개요, 작업장 상황조사, 작업조건 조사를 실시하며, 세부적인 분석·평가가 필요한 경우 인간공학적 평가도구를 활용한다. 근골격계질환 증상조사표를 활용하여 근로자의 작업력, 근무형태, 징후 또는 증상 특징 등의 정보를 파악한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-EG4-03",
      "processOrder": 3,
      "processName": "작업환경개선",
      "safetyMeasures": "유해요인조사 결과를 바탕으로 공학적 개선(설비·작업방법·작업도구 재설계, 재배열, 수정, 교체), 관리적 개선(작업절차·작업노출 수정 및 관리), 행동 개선(태도, 행동, 지식, 생활패턴 등 개선)을 실시한다.",
