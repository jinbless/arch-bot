  "checklistItems": [
    {
      "identifier": "CI-EG4-001",
      "text": "조사자는 중·소규모 사업장인 경우, 근로자 대표 또는 명예산업안전감독관을 포함하여 그가 위임하는 자, 관리자(예산결정권자), 정비·보수담당자, 보건·안전담당자, 구매담당자 등이 참여하도록 구성하고, 대규모 사업장인 경우, 중·소규모 사업장 조사팀원 이외의 기술자(생산, 설계, 보수기술자), 노무담당자 등이 참여하도록 구성한다.",
      "guideContext": "근골격계질환 예방관리 - 유해요인 조사자 선정",
      "additionalDetail": null,
      "workProcessPhase": "유해요인 조사자 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-002",
      "text": "유해요인조사는 유해요인조사표를 활용하여 조사개요, 작업장 상황조사, 작업조건 조사를 실시하며, 작업조건 조사를 실시할 때 세부적인 분석·평가 등이 필요하다고 판단되는 경우 인간공학적 평가도구를 활용하여 조사대상 근골격계부담작업 또는 근로자의 근골격계질환 유해요인에 대해 분석·평가한다.",
      "guideContext": "근골격계질환 예방관리 - 유해요인 조사",
      "additionalDetail": null,
      "workProcessPhase": "유해요인 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-003",
      "text": "근골격계질환 증상조사표를 활용하여 근로자의 작업력, 근무형태, 근골격계질환의 징후 또는 증상 특징 등의 정보를 파악한다.",
      "guideContext": "근골격계질환 예방관리 - 유해요인 조사",
      "additionalDetail": null,
      "workProcessPhase": "유해요인 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-004",
      "text": "유해요인조사 결과 근골격계질환이 발생할 우려가 있는 경우에 유해요인조사의 결과를 바탕으로 작업환경개선 조치를 하여야 한다.",
      "guideContext": "근골격계질환 예방관리 - 작업환경개선 (법령 근거 미확인)",
      "additionalDetail": "작업환경개선은 공학적 개선(설비·작업방법·작업도구 재설계, 재배열, 수정, 교체), 관리적 개선(작업절차·작업노출 수정 및 관리), 행동 개선(태도, 행동, 지식, 생활패턴 등 개선)으로 구분한다.",
      "workProcessPhase": "작업환경개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-005",
      "text": "유해요인조사 결과 근골격계질환이 발생할 우려가 있는 경우에 유해요인조사의 결과를 바탕으로 의학적관리를 하여야 한다.",
      "guideContext": "근골격계질환 예방관리 - 의학적관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "의학적관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-006",
      "text": "의학적관리는 근골격계질환 예방을 위한 기술지원규정에 따라 무증상기, 초기증상기, 급성기로 구분하여 의학적관리를 실시하여야 한다.",
      "guideContext": "근골격계질환 예방관리 - 의학적관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "의학적관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-007",
      "text": "사업주는 근골격계질환 예방관리 절차에 대하여 매년 해당 부서 또는 사업장 전체를 대상으로 다음과 같은 평가지표를 활용하여 평가하여야 한다.",
      "guideContext": "근골격계질환 예방관리 - 평가 (법령 근거 미확인)",
      "additionalDetail": "평가지표: 근골격계질환 증상자 발생빈도, 발생률 비교, 근로손실일수 비교, 작업개선 전후 유해요인 노출 특성 변화, 근로자 만족도 변화, 제품 불량률 변화",
      "workProcessPhase": "평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-008",
      "text": "평가 결과 문제점이 발견될 경우에는 이를 보완하여 개선하여야 한다.",
      "guideContext": "근골격계질환 예방관리 - 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-126",
      "text": "위보기 또는 아래보기 자세 작업은 하루 누적 2시간 이내로 제한한다.",
      "guideContext": "근골격계질환 예방 - 부적절한 자세 개선 (법령 근거 미확인)",
      "additionalDetail": "목 부위 부적절한 자세로 인한 근골격계질환 예방을 위한 작업시간 제한",
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-127",
      "text": "목지지 보호용품 등을 활용한다.",
      "guideContext": "근골격계질환 예방 - 부적절한 자세 개선",
      "additionalDetail": null,
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-128",
      "text": "작업 시 시선이 작업 정면을 향하도록 한다.",
      "guideContext": "근골격계질환 예방 - 목 자세 개선",
      "additionalDetail": null,
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-129",
      "text": "높낮이 조절 작업대, 좌식 보조의자 등을 활용한다.",
      "guideContext": "근골격계질환 예방 - 어깨 자세 개선",
      "additionalDetail": null,
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-130",
      "text": "작업대 및 작업점의 높이를 조절한다.",
      "guideContext": "근골격계질환 예방 - 허리 자세 개선",
      "additionalDetail": null,
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-131",
      "text": "가슴받침대, 하부작업용 보조도구를 활용한다.",
      "guideContext": "근골격계질환 예방 - 허리 자세 개선",
      "additionalDetail": null,
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-132",
      "text": "작업 시 몸의 방향이 작업 정면을 향하도록 한다.",
      "guideContext": "근골격계질환 예방 - 허리 자세 개선",
      "additionalDetail": null,
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-133",
      "text": "무릎 보호대, 쿠션매트, 보조의자 등을 활용한다.",
      "guideContext": "근골격계질환 예방 - 무릎 자세 개선",
      "additionalDetail": null,
      "workProcessPhase": "부적절한 자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-134",
      "text": "발의 피로를 최소화하는 신발을 착용한다.",
      "guideContext": "근골격계질환 예방 - 장시간 서서 일하는 작업 개선",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-135",
      "text": "다리 부분이 편안하게 움직일 수 있는 공간을 확보하도록 하고, 피로예방매트를 설치한다.",
      "guideContext": "근골격계질환 예방 - 장시간 서서 일하는 작업 개선",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-136",
      "text": "입좌식 의자(Sit-stand)나 작업 중 잠시 앉아 휴식을 취할 수 있는 의자를 제공한다.",
      "guideContext": "근골격계질환 예방 - 장시간 서서 일하는 작업 개선",
      "additionalDetail": "입좌식 의자의 높이, 좌면 각도 조절 가능 및 안정적 지지 구조 요구",
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-137",
      "text": "입좌식 의자의 높이는 편안하게 서 있을 때 엉덩이를 의자의 앉는 면에 걸칠 수 있도록 허벅지에서 엉덩이 전·후가 되도록 조절할 수 있어야 한다.",
      "guideContext": "근골격계질환 예방 - 입좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-138",
      "text": "입좌식 의자의 앉는 면(좌면) 각도는 조절할 수 있어야 한다.",
      "guideContext": "근골격계질환 예방 - 입좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-139",
      "text": "입좌식 의자는 몸을 기댈 때 뒤로 밀리거나 흔들리지 않고 지지할 수 있는 구조이어야 한다.",
      "guideContext": "근골격계질환 예방 - 입좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-140",
      "text": "만약 공간이 협소하여 의자를 제공하기 어려운 경우에는 발걸이/발받침대 등을 제공한다.",
      "guideContext": "근골격계질환 예방 - 장시간 서서 일하는 작업 개선",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-141",
      "text": "의자: 높이 조절이 가능해야 하고, 의자의 크기는 몸집이 큰 사람이 앉기에 충분할 만큼 커야 하며, 키 큰 사람의 다리가 들어가도록 충분히 길어야 한다.",
      "guideContext": "근골격계질환 예방 - 좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-142",
      "text": "등받이: 높이 조절이 가능해야 하고, 등 부분을 견고하게 지지할 수 있어야 한다.",
      "guideContext": "근골격계질환 예방 - 좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-143",
      "text": "팔걸이: 너무 높거나 낮지 않도록 적절한 높이를 유지해야 한다.",
      "guideContext": "근골격계질환 예방 - 좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-144",
      "text": "발걸이는 발이 땅에 닿지 않는 근로자의 발 움직임이 쉽도록 커야 하고 높이 조절이 가능해야 한다.",
      "guideContext": "근골격계질환 예방 - 좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-145",
      "text": "가스식 의자: 의자의 높이 조절을 위해 실린더에 압축가스가 채워진 의자는 취급에 주의를 요한다. 가능한 한 충격을 가하지 말고, 보통 몸무게 100kg 이상의 근로자는 사용을 금하게 한다.",
      "guideContext": "근골격계질환 예방 - 좌식 의자 안전 사용 (법령 근거 미확인)",
      "additionalDetail": "가스식 의자 사용 제한 및 주의사항",
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-146",
      "text": "의자, 팔걸이, 등받이 등은 안락성을 고려하고 신체가 직접 접촉하지 않도록 커버로 덮어야 한다.",
      "guideContext": "근골격계질환 예방 - 좌식 의자 설계 기준",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-147",
      "text": "작업영역은 정상작업영역 이내에서 이루어지도록 하고 부득이한 경우에는 최대작업영역에서 하되 그 작업이 최소화되도록 한다.",
      "guideContext": "근골격계질환 예방 - 작업환경 설계",
      "additionalDetail": null,
      "workProcessPhase": "정적인 작업자세 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-148",
      "text": "망치, 스패너 등의 수공구를 사용할 경우 과도한 힘이 들어가는 것을 예방하기 위해 작업특성에 알맞은 크기와 형태의 수공구를 선택한다.",
      "guideContext": "근골격계질환 예방 - 수공구 사용 개선",
      "additionalDetail": null,
      "workProcessPhase": "과도한 힘의 사용 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-149",
      "text": "수공구 손잡이는 손목이 꺾이지 않도록 손잡이가 꺾인 것을 선택한다.",
      "guideContext": "근골격계질환 예방 - 수공구 사용 개선",
      "additionalDetail": null,
      "workProcessPhase": "과도한 힘의 사용 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-150",
      "text": "수공구는 가능한 가벼운 것을 사용하여 손과 손목, 팔꿈치의 부담을 줄인다.",
      "guideContext": "근골격계질환 예방 - 수공구 사용 개선",
      "additionalDetail": null,
      "workProcessPhase": "과도한 힘의 사용 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-151",
      "text": "수공구를 잡을 때 손목이 비틀리지 않고 팔꿈치를 들지 않아도 되는 형태의 공구를 사용한다.",
      "guideContext": "근골격계질환 예방 - 수공구 사용 개선",
      "additionalDetail": null,
      "workProcessPhase": "과도한 힘의 사용 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-152",
      "text": "수공구의 손잡이는 손바닥 전체 압력이 골고루 분포되도록 너무 크거나 작지 않도록 하고, 미끄러지지 않는 재질(예: 폼 슬리브(foam sleeve))을 사용한다.",
      "guideContext": "근골격계질환 예방 - 수공구 사용 개선",
      "additionalDetail": null,
      "workProcessPhase": "과도한 힘의 사용 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-153",
      "text": "무리한 힘을 요구하는 공구는 동력을 사용하는 공구로 교체하거나 지그를 활용하되 소음 및 진동을 최소화하고 주기적으로 유지보수한다.",
      "guideContext": "근골격계질환 예방 - 수공구 사용 개선",
      "additionalDetail": null,
      "workProcessPhase": "과도한 힘의 사용 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-154",
      "text": "진동공구는 진동의 크기가 작고, 진동의 인체전달이 작은 것을 선택하고 연속적인 사용시간을 제한한다.",
      "guideContext": "근골격계질환 예방 - 수공구 사용 개선",
      "additionalDetail": null,
      "workProcessPhase": "과도한 힘의 사용 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-155",
      "text": "주로 취급하는 물품에 대하여 근로자가 쉽게 알 수 있도록 물품의 중량과 무게중심에 대하여 작업장 주변에 안내표시를 한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-156",
      "text": "주로 취급하는 물품의 무게중심이 수시로 바뀔 경우에는 주된 작업에 따른 무게 중심을 표시하되 작업에 따라 무게중심이 바뀐다는 사실을 근로자에게 주지시켜야 한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-157",
      "text": "취급하기 곤란한 물품에 대해서는 손잡이를 붙이거나 걸고리, 진공빨판 등 적절한 보조도구를 활용한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-158",
      "text": "인력으로 중량물을 취급하는 경우에는 작업점의 높이에 따라 작업영역을 설계해야 하고, 올바른 작업방법에 따라 작업하여야 한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-159",
      "text": "중량물에 몸의 중심을 가깝게 한다.",
      "guideContext": "근골격계질환 예방 - 올바른 중량물 취급방법",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-160",
      "text": "발을 어깨너비 정도로 벌리고 몸은 정확하게 균형을 유지한다.",
      "guideContext": "근골격계질환 예방 - 올바른 중량물 취급방법",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-161",
      "text": "등을 반듯이 유지하면서 무릎의 힘으로 일어난다.",
      "guideContext": "근골격계질환 예방 - 올바른 중량물 취급방법",
      "additionalDetail": "무릎을 굽히고, 가능하면 중량물을 양손으로 잡으며, 목과 등이 거의 일직선이 되도록 한다.",
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-162",
      "text": "중량물의 폭은 일반적으로 75cm 이상이 되지 않도록 하고, 부적절한 작업자세 및 동작을 피할 수 있도록 작업 공간(권장 넓이: 125~140cm)을 확보하여야 한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-163",
      "text": "운반구의 손잡이가 잡기에 불편하지 않도록 길이, 두께, 깊이 등을 고려하고 미끄러지지 않도록 마찰력이 높은 재질과 구조를 사용한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-164",
      "text": "적정중량을 초과하는 물건을 취급하는 경우에는 2인 이상이 함께 작업하도록 하고, 이 경우 가능한 한 각 근로자에게 중량이 균일하게 전달되도록 한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-165",
      "text": "중량물을 취급하는 작업장의 바닥은 요철부위가 없고 잘 미끄러지지 않으며 쉽게 움푹 들어가지 않도록 탄력성과 내충격성이 뛰어난 재료를 사용한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 작업장 환경",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-166",
      "text": "가능한 한 중량물 취급 작업 전부 또는 일부를 자동화하거나 기계화하여 근로자의 허리부담을 경감시키도록 노력한다. 다만, 이것이 곤란한 경우에는 운반용 대차 등 적절한 보조기기를 사용하도록 하며 보조기기는 작업자가 사용하기에 불편하지 않도록 한다.",
      "guideContext": "근골격계질환 예방 - 중량물 취급 개선",
      "additionalDetail": null,
      "workProcessPhase": "중량물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-167",
      "text": "반복적인 작업을 연속적으로 수행하는 근로자에게는 해당 작업 이외의 작업을 중간에 넣거나 다른 근로자로 순환시키는 등 장시간의 연속작업이 수행되지 않도록 한다.",
      "guideContext": "근골격계질환 예방 - 반복작업 개선",
      "additionalDetail": null,
      "workProcessPhase": "반복작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-168",
      "text": "반복의 정도가 심한 경우에는 공정을 자동화하거나 다수의 근로자들이 교대하도록 하여 한 근로자의 반복작업 시간을 가능한 한 줄이도록 한다.",
      "guideContext": "근골격계질환 예방 - 반복작업 개선",
      "additionalDetail": null,
      "workProcessPhase": "반복작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-169",
      "text": "반복횟수를 감소시킬 수 있는 설비 및 보조도구를 활용한다.",
      "guideContext": "근골격계질환 예방 - 반복작업 개선",
      "additionalDetail": null,
      "workProcessPhase": "반복작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-170",
      "text": "자주 사용하는 물건은 작업자가 쉽게 접근할 수 있는 위치에 배치하여 반복적인 불필요한 동작을 줄이도록 한다.",
      "guideContext": "근골격계질환 예방 - 반복작업 개선",
      "additionalDetail": "가장 빈번하게 사용되는 물품은 가장 사용하기 편리한 곳에, 연속해서 사용해야 하는 물품은 서로 옆에 놓거나 순서를 반영하여 위치시킨다.",
      "workProcessPhase": "반복작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-171",
      "text": "신체부위가 지속적으로 접촉이 되는 부분에 쿠션패드를 설치하거나 날카롭지 않도록 개선하여 접촉스트레스를 최소화한다.",
      "guideContext": "근골격계질환 예방 - 접촉스트레스 개선",
      "additionalDetail": null,
      "workProcessPhase": "접촉스트레스 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-172",
      "text": "작업 시 신체부위가 접촉이 발생하지 않도록 작업환경을 여유있게 설계한다.",
      "guideContext": "근골격계질환 예방 - 접촉스트레스 개선",
      "additionalDetail": null,
      "workProcessPhase": "접촉스트레스 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-173",
      "text": "좌석이 존재한다면, 좌석 밑 부분에 수직 완충장치를 설치한다.",
      "guideContext": "근골격계질환 예방 - 전신진동 개선",
      "additionalDetail": "지게차, 농기계 등 차량 탑승 시 전신진동 저감 대책",
      "workProcessPhase": "진동 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-174",
      "text": "진동공구는 진동의 크기가 작고, 진동의 인체전달이 작은 것을 선택하고 연속적인 사용시간을 제한하여야 한다.",
      "guideContext": "근골격계질환 예방 - 국소진동 개선 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "진동 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-175",
      "text": "진동공구를 이용하여 작업할 때 작업시간당 10분 이상의 휴식시간을 제공하여야 한다.",
      "guideContext": "근골격계질환 예방 - 국소진동 개선 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "진동 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-176",
      "text": "방진장갑 착용: 진동을 최소화할 수 있는 진동방지 장갑을 착용한다. 방진장갑의 재료는 고무의 탄성을 이용한 특수탄성고무, 물체의 기포 충격성을 이용한 네오프렌 발포제 등이 있다.",
      "guideContext": "근골격계질환 예방 - 국소진동 개선",
      "additionalDetail": null,
      "workProcessPhase": "진동 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-177",
      "text": "사업주는 근로자를 대상으로 정기적인 안전보건 교육을 실시하고 다음의 내용을 포함하여 근골격계질환 예방교육을 실시한다.",
      "guideContext": "근골격계질환 예방 - 사업주 의무",
      "additionalDetail": null,
      "workProcessPhase": "의학적 및 관리적 개선",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-EG4-178",
      "text": "근골격계부담작업 유해요인조사 결과 근골격계질환이 발생할 우려가 있을 경우 근골격계질환 예방, 관리 정책수립, 교육 및 훈련, 의학적 관리 작업환경개선활동 등 근골격계질환 예방활동을 체계적으로 수행하도록 권장한다.",
      "guideContext": "근골격계질환 예방 - 예방관리 프로그램",
      "additionalDetail": null,
