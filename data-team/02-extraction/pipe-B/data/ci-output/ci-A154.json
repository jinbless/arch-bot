  "checklistItems": [
    {
      "identifier": "CI-A154-001",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": "분석에 사용하는 시약은 제조회사에서 표시하는 농도 함량을 따른다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-002",
      "text": "광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의해야 하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.",
      "guideContext": "불화수소 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-003",
      "text": "분석에 사용하는 지시약은 특이한 것을 제외하고는 KS M 0015(화학 분석용 지시약 조제방법)에 규정된 지시약을 사용한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-004",
      "text": "시험에 사용하는 표준품은 원칙적으로 특급시약을 사용하며, 표준용액을 조제하기 위한 표준용 시약은 따로 규정이 없는 한 적절히 보관되어 오염 및 변질이 안 된 상태로 보존된 것을 사용한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-005",
      "text": "계량기구 중 측정값을 분석결과의 계산에 사용할 목적으로 사용되는 것은 모두 보정하는 것을 원칙으로 한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-006",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 달수 있어야 하며, 화학분석 용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 달 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "불화수소 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-007",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등 이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "불화수소 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-008",
      "text": "시료채취의 목적과 시료채취시간, 방해인자, 예상되는 오염농도 및 실험실에서 보유하고 있는 분석장비의 능력 등을 종합적으로 고려하여 최적의 시료채취기구 및 분석방법을 선택한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료채취 기구 및 측정방법 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-009",
      "text": "표준용액, 탈착효율 검정 등에 사용되는 시약은 같은 롯트(Lot)번호를 가진 것을 사용하여야 한다.",
      "guideContext": "불화수소 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-010",
      "text": "검량선은 시료 분석조건과 주입방법에 따라 작성하고 검량선이 적정하다고 판정하면 시료를 분석한다. 검량선은 분석할 시료의 농도를 포함해야 하며 외삽법은 피한다. 검량선의 적정성은 제시된 분석기기의 매뉴얼을 참고하거나 상관계수가 0.99이상의 것을 사용하도록 한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-011",
      "text": "탈착효율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다. 탈착효율에 대한 평가는 분석자가 해야 한다. 즉 12개의 탈착효율 실험결과를 근거로 판단해야 할 사항은 탈착효율간의 일정성이다. 만일 탈착효율간의 차이가 크고 변이가 심하여 일정성이 없으면 정확한 보정이 될 수가 없다. 따라서 그 원인을 찾아 교정하고 다시 실험을 실시해야 한다.",
      "guideContext": "불화수소 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탈착효율 검정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-012",
      "text": "모든 화학제품의 피부접촉과 흡입을 피하고 보호장갑 및 보호복을 착용하고 흄후드 안에서 사용하여야 한다.",
      "guideContext": "불화수소 취급 시 안전보건 예방조치",
      "additionalDetail": "불화수소는 피부, 눈, 점막 등을 강하게 자극할 수 있으며, 유리제품에 손상을 입히므로 플라스틱 초자기구 사용이 권장된다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-A154-013",
      "text": "시료 채취 시와 동일한 연결상태에서 각 시료채취펌프를 보정한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-014",
      "text": "시료채취 바로 전에 흡착관의 양끝을 절단한 후 유연성 튜브를 이용하여 펌프에 연결한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-015",
      "text": "0.2~0.5 L/분에서 정확한 유량으로 3 ~ 100 L 정도 시료를 채취한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-016",
      "text": "시료채취가 끝나면 흡착관을 플라스틱 마개로 밀봉하여 운반한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-017",
      "text": "흡착관의 앞 층과 뒤 층을 각각 다른 15 mL 원심분리관에 넣는다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": "만약 공기 중에 염산, 브롬화수소, 불화수소, 질산염 이온이 존재하면 이 물질은 유리섬유 플러그에 채취되므로, 이런 염들의 농도를 알고자 하면 유리섬유 플러그를 다른 원심분리관에 넣고 분석한다.",
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "II",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-018",
      "text": "각 원심분리관에 2~8 mL의 탈착용액을 넣고 마개를 닫는다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "II",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-019",
      "text": "끓고 있는 수욕조에서 10분간 가열한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "II",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-020",
      "text": "상온에서 냉각시킨 후 최종 탈착용액으로 맞춘다.(2~10 mL)",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "II",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-021",
      "text": "원심분리관을 마개로 막고 격리히 흔들어 준 뒤, 시린지 필터와 주사기를 이용하여 여과하여 분석에 사용한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "II",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-022",
      "text": "탈이온수를 이용하여 분석기기의 최적범위내에서 표준용액을 제조한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": "분석범위 1 - 300 ug/mL",
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-023",
      "text": "시료와 공시료를 함께 분석한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-024",
      "text": "이온크로마토그래프 제조회사가 권고하는 대로 기기를 작동시키고 조건을 설정한 후 표준용액, 탈착효율시료, 현장시료를 분석한다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-025",
      "text": "시료를 정량적으로 정확히 주입한다. 시료 주입법은 자동주입기를 이용하는 방법이 있다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-026",
      "text": "만일 뒤 층에서 검출된 양이 앞 층에서 검출된 양의 10%를 초과하면(Wb > Wf/10), 시료 파과가 일어난 것이므로 이 자료는 사용할 수 없다.",
      "guideContext": "불화수소 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "IV",
      "basedOn": null
    },
    {
      "identifier": "CI-A154-027",
      "text": "시약류의 피부 접촉이나 흡입을 피해야 하며, 실험실에서는 실험복 및 보호장비의 착용이 필요하다.",
      "guideContext": "불화수소 취급 시 건강영향 및 예방조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A154-001",
      "term": "밀폐",
      "definition": "취급 또는 보관상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A154-002",
      "term": "밀봉",
      "definition": "취급 또는 보관 상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A154-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A154-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ± 10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A154-005",
      "term": "즉시",
      "definition": "시험조작 중 30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A154-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A154-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
