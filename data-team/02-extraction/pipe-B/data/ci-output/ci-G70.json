  "checklistItems": [
    {
      "identifier": "CI-G70-001",
      "text": "사다리 작업은 간단한 작업 시에만 제한적으로 실시되어야 한다.",
      "guideContext": "동물원 추락사고 예방 (법령 근거 미확인)",
      "additionalDetail": "동물들이 접근하고 제한된 공간 혹은 지면이 고르지 않는 곳에서는 특히 위험하다.",
      "workProcessPhase": "추락 위험 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-002",
      "text": "사용되는 사다리는 작업에 적절한 구조와 기능을 지닌 것이어야 한다.",
      "guideContext": "동물원 추락사고 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "추락 위험 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-003",
      "text": "차량은 사용 목적 및 지형에 적절한 것이어야 하고, 유지관리 및 차량점검에 만전을 기해야 한다.",
      "guideContext": "동물원 차량사고 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-004",
      "text": "차량에는 경보 장치가 장착되어야 하고, 운전자는 유자격자이어야 한다.",
      "guideContext": "동물원 차량사고 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-005",
      "text": "차량의 주차는 안전한 곳에서만 하고, 열쇠는 반드시 수거한다.",
      "guideContext": "동물원 차량사고 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-006",
      "text": "차량 통행이 가능한 곳에는 적절한 안내 또는 경고판을 설치한다.",
      "guideContext": "동물원 차량사고 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-007",
      "text": "차량 이동은 동물들의 접근이 차단된 이후에 해야 한다.",
      "guideContext": "동물원 차량사고 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-008",
      "text": "차량 이동로에는 장애물이 없도록 하고, 적절한 조명 및 보행로와 구별시키는 차단 방책이 설치되어야 한다.",
      "guideContext": "동물원 차량사고 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 운행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-009",
      "text": "총기는 반드시 경찰서에 등록하고, 사용허가를 받아야 하며 정기적으로 안전 유지 및 관리 상태에 대해 점검을 받아야 한다.",
      "guideContext": "동물원 총기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "총기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-010",
      "text": "총기는 반드시 허가된 유자격자만이 관리·사용하여야 하며, 총기에 대한 관리·사용에 관한 모든 사항이 기록되어야 한다.",
      "guideContext": "동물원 총기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "총기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-011",
      "text": "허가받은 총기 사용자는 정기적으로 교육을 받아야 한다.",
      "guideContext": "동물원 총기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "총기 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-012",
      "text": "잠수작업은 반드시 교육받은 유자격자만이 해야 되며, 해당 작업자는 작업 전 위험요소를 점검하고, 안전장비를 갖춘 후 감독자의 입회하에 안전하게 작업을 실행하여야 한다.",
      "guideContext": "동물원 수중작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수중작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-013",
      "text": "근로자는 적절한 교육을 받아야 하고, 감독에 따라야 한다.",
      "guideContext": "동물원 동물 접촉 작업 (법령 근거 미확인)",
      "additionalDetail": "동물과 직접 접촉하는 근로자 대상",
      "workProcessPhase": "동물 접촉 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-014",
      "text": "근로자는 동물의 질병에 대한 충분하고 정확한 지식을 지니고 있어야 한다.",
      "guideContext": "동물원 동물 접촉 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 접촉 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-015",
      "text": "개별 동물의 특성에 대해 숙지하여야 한다.",
      "guideContext": "동물원 동물 접촉 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 접촉 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-016",
      "text": "필요시 적절한 보호 장비 및 도구를 갖추어야 한다.",
      "guideContext": "동물원 동물 접촉 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 접촉 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-017",
      "text": "고 위험군의 동물을 격리하기 위해 사용되는 문과 시설들은 적절한 강도를 지녀야 하고, 외부에서 개폐할 수 있어야 한다. 또한 자동문의 경우 근로자가 동물 막사로부터 신속히 대피할 수 있도록 조절되어야 한다.",
      "guideContext": "동물원 동물 접촉 작업 사전점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 접촉 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-018",
      "text": "근로자가 막사에 들어가기 전 동물들이 격리되어 있는지를 확인하여야 하며, 작업 후에는 동물들이 방사되기 전 근로자들이 모두 그 지역을 벗어났는지를 확인하여야 한다.",
      "guideContext": "동물원 동물 접촉 작업 사전점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 접촉 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-019",
      "text": "다음의 경우에는 반드시 감독자 혹은 책임자의 허가를 받아 작업을 실행한다. (1) 동물 울타리에 들어가거나 작업 환경이 익숙하지 않은 경우 (2) 위험성이 큰 동물이 있는 울타리 가까이에서 유지·보수 작업을 할 경우 (3) 해당 동물원 환경에 익숙하지 않은 외부인이 맹독성 동물이 있는 울타리 근처에서 작업할 경우 (4) 작업 시 총기를 사용할 경우 (5) 살충제 혹은 살균제 사용 시 (6) 관람객이 있는 장소에서 특정도구 및 장비를 사용할 시",
      "guideContext": "동물원 작업 허가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물 접촉 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-020",
      "text": "동물원 입장 시 접촉 동물의 성격과 위험성을 외부 관람객에게 안내 표지판과 팜플릿을 통해서 혹은 근로자가 직접 알림으로서 주의를 환기시킨다.",
      "guideContext": "동물원 관람객 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-021",
      "text": "위험도에 따라 가이드라인을 정해 동물과의 일정거리를 유지하도록 한다.",
      "guideContext": "동물원 관람객 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-022",
      "text": "동물과의 직접 접촉이 가능한 곳에는 세면시설을 설치하여 접촉 직후 항균성 비누를 사용하여 손 씻기를 할 수 있도록 한다.",
      "guideContext": "동물원 감염 예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-023",
      "text": "동물원 내에 긴급 상황 전담 부서를 둔다. 이 부서는 책임자와 전문가들로 구성된다.",
      "guideContext": "동물원 긴급 상황 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급 상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-024",
      "text": "경찰서와 소방서 그리고 병원 등 유관 기관과의 긴밀한 협조체계를 마련한다.",
      "guideContext": "동물원 긴급 상황 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급 상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-025",
      "text": "가축병 치료 전담 수의사, 다트건(dart gun) 및 총기 담당자등은 상시 연락 가능하여야 한다.",
      "guideContext": "동물원 긴급 상황 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급 상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-026",
      "text": "긴급 상황 별 대응 절차 계획을 마련한다.",
      "guideContext": "동물원 긴급 상황 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급 상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-027",
      "text": "근로자는 자신의 위치를 쉽게 파악할 수 있는 색상과 형태의 작업복을 입고, 무전기 또는 휴대폰을 소지하여야 한다.",
      "guideContext": "동물원 통신 체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급 상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-028",
      "text": "동물원 전역에서 듣기 쉬우며 크게 청취할 수 있는 방송시스템을 갖추어야 한다.",
      "guideContext": "동물원 통신 체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급 상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G70-029",
      "text": "방송시스템과 근로자 개인이 사용하는 무전기 등의 개인 통신기구는 상시 점검을 통해 그 기능을 확인하여야 한다.",
      "guideContext": "동물원 통신 체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급 상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    }
  ],
