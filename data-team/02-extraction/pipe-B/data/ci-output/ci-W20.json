  "checklistItems": [
    {
      "identifier": "CI-W20-001",
      "text": "근로자의 안전보건을 위한 조치사항은 유해·위험성 평가결과에 따라 결정되고, 조치하여야 한다.",
      "guideContext": "나노물질 제조취급 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-002",
      "text": "나노입자 또는 나노 구조물질은 상대적으로 일반적 마이크로미터 범위의 입자와는 인체에 대한 영향이 다를 수 있으므로 기존의 노출기준이 있는 물질은 이 보다 강한 수준으로 관리하여야 하며, 근로자 노출을 최소화하여야 한다.",
      "guideContext": "나노물질 제조취급 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-003",
      "text": "나노물질의 취급공정은 나노물질이 근로자에게 노출되지 않도록 설계단계부터 근원적인 조치가 이루어져야 한다.",
      "guideContext": "나노물질 작업환경관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-004",
      "text": "나노물질을 취급하는 설비는 밀폐구조로 설치하여야 한다. 다만, 밀폐가 불가능한 경우에는 자동화 등의 조치 또는 작업과 관리공간이 격리되도록 배치하여야 한다.",
      "guideContext": "나노물질 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-003"
      ]
    },
    {
      "identifier": "CI-W20-005",
      "text": "나노물질을 취급하는 밀폐설비의 내부는 음압을 유지하도록 하여 나노입자가 작업장에 확산되지 않도록 한다.",
      "guideContext": "나노물질 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W20-006",
      "text": "나노물질 취급 작업 장소에는 국소배기장치 등 환기설비를 설치하여 발생되는 나노물질을 배기하여야 한다.",
      "guideContext": "나노물질 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W20-007",
      "text": "환기설비를 설치할 경우는 입자, 에어로졸, 증기 또는 가스 등의 상태를 고려하여 공기정화장치를 설치한다.",
      "guideContext": "나노물질 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W20-008",
      "text": "공기정화장치로부터 배출되는 공기는 작업장의 내부로 재 유입되지 않도록 배기구를 작업장 외부에 설치하여야 한다.",
      "guideContext": "나노물질 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W20-009",
      "text": "나노물질을 취급하는 작업 장소에서는 표준작업 절차, 유해·위험성 및 예방 조치사항, 환기장치의 가동 절차 및 요령, 보호구 착용 및 관리방법, 나노물질 노출방지를 위한 조치사항 등을 포함하는 표준 작업관리지침을 제정하고, 작업 근로자가 준수하도록 한다.",
      "guideContext": "나노물질 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W20-010",
      "text": "분말 나노물질은 액체 또는 고체 매개물에 응집시켜 관리한다. 기술적으로 가능한 경우 분말 대신 분산, 반죽형태(Paste), 또는 화합물 형태로 사용한다.",
      "guideContext": "나노물질 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-011",
      "text": "나노물질을 취급하는 작업 장소에는 관계자 외의 출입을 금지시키고, 출입하는 근로자에 대하여는 안전보건 조치사항 교육을 실시하여야 한다.",
      "guideContext": "나노물질 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W20-012",
      "text": "나노물질 취급업무에 종사하는 근로자는 전용의 작업복을 착용하도록 하여야 하며, 작업복과 개인 의복은 분리하여 보관한다.",
      "guideContext": "나노물질 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W20-013",
      "text": "나노물질 취급 작업장은 기류이동에 따른 입자의 비산을 방지하기 위한 조치를 하여야 한다.",
      "guideContext": "나노물질 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-014",
      "text": "작업장내에 퇴적 또는 누출된 나노물질을 제거하는 경우에는 고성능필터의 진공청소기 등 흡입장치를 사용하거나 정전기의 발생 등을 예방할 수 있도록 젖은 천으로 닦아내도록 하고 흘날리게 제거해서는 안 된다.",
      "guideContext": "나노물질 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-W20-015",
      "text": "나노물질을 취급하는 장소에서는 음식물의 저장, 섭취, 흡연 등을 금지한다.",
      "guideContext": "나노물질 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-016",
      "text": "발생되는 폐기물 및 청소 걸레 등은 지정된 밀폐된 장소에 보관하고, 규정된 절차에 따라 처리한다.",
      "guideContext": "나노물질 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W20-017",
      "text": "나노물질을 취급하는 작업장에는 손과 피부를 씻을 수 있는 세척설비를 갖추어야 하며, 옷이나 피부에 부착되어 나노물질이 다른 장소로 비산 전파되는 것을 막기 위하여 목욕 및 세탁 설비 등도 설치한다.",
      "guideContext": "나노물질 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W20-018",
      "text": "나노물질을 취급하는 근로자에 대하여는 특수건강진단기관을 통하여 건강진단을 실시한다.",
      "guideContext": "나노물질 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-019",
      "text": "건강진단에는 간장, 신장, 조혈기능, 폐기능 및 피부장해 등에 대한 검사와 나노물질 성분에 따른 표적장기에 대한 검사가 이루어져야 한다.",
      "guideContext": "나노물질 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-020",
      "text": "건강진단에는 나노물질의 대사산물 등에 대한 생물학적 모니터링 방법을 이용할 수 있다.",
      "guideContext": "나노물질 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-021",
      "text": "건강진단기록은 5년 이상 보관하고, 검진결과 건강이상 소견이 발견된 근로자에 대하여는 작업전환, 근무 중 치료 등의 적절한 사후관리를 한다.",
      "guideContext": "나노물질 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-022",
      "text": "나노물질을 취급하는 근로자는 호흡기 노출을 방지하기 위하여 특급이상의 개인전용 호흡용보호구를 착용하여야 한다.",
      "guideContext": "나노물질 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-W20-023",
      "text": "근로자의 피부노출을 방지하기 위한 보호장갑은 나노물질의 피부 부착을 방지할 수 있는 재질의 보호구를 사용하여야 한다.",
      "guideContext": "나노물질 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W20-024",
      "text": "작업 근로자의 눈을 보호하기 위하여 고글형 보호안경을 착용하도록 한다.",
      "guideContext": "나노물질 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W20-025",
      "text": "나노물질을 취급하는 작업에 종사하는 근로자는 전용의 개인보호의를 착용하여야 한다.",
      "guideContext": "나노물질 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W20-026",
      "text": "개인보호구의 수는 종사근로자 수 이상으로 비치하고, 보호구함 등을 설치하여 관리하여야 한다.",
      "guideContext": "나노물질 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-W20-027",
      "text": "나노물질에 오염된 개인보호구를 작업장 밖으로 반출할 경우는 밀봉하여 나노물질이 근로자에게 노출되지 않도록 하여야 한다.",
      "guideContext": "나노물질 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "개인보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W20-028",
      "text": "분말상 나노물질은 입자의 비표면적이 크므로 폭발성과 인화성을 가질 수 있으므로 화재와 폭발 예방에 필요한 조치를 취하여야 한다.",
      "guideContext": "나노물질 안전관리",
      "additionalDetail": null,
      "workProcessPhase": "안전관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-W20-029",
      "text": "분말상 나노물질은 비표면적이 커서 촉매작용을 통하여 통제불능의 반응을 유발 할 수 있으므로 취급전에 이에 대한 위험을 사전에 시험하고, 파악된 위험성에 대하여 예방조치 후에 작업을 실시하여야 한다.",
      "guideContext": "나노물질 안전관리",
      "additionalDetail": null,
      "workProcessPhase": "안전관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-W20-030",
      "text": "가스상 나노물질에 대하여는 불활성 가스를 충진하거나 수분이 제거된 상태로 저장하는 등 화재와 폭발 등의 위험을 예방하기 위한 조치를 취하여야 한다.",
      "guideContext": "나노물질 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-031",
      "text": "금속 나노물질은 산화 또는 폭발의 위험성이 있으므로 공기와의 접촉을 차단하는 등의 조치를 한다.",
      "guideContext": "나노물질 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-032",
      "text": "나노물질을 취급하는 과정에서 다량의 불활성가스를 사용하는 경우 누출에 의한 질식사고 위험성이 있으므로 해당가스에 대한 측정장비를 구비하여 주기적인 측정을 실시하고, 이에 대한 안전조치를 취하여야 한다.",
      "guideContext": "나노물질 안전관리",
      "additionalDetail": null,
      "workProcessPhase": "안전관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-W20-033",
      "text": "나노물질을 제조하는 과정에서 고전류를 이용하여 플라즈마를 발생시키고 이를 이용하는 경우 감전 예방 조치를 취하여야 한다.",
      "guideContext": "나노물질 안전관리",
      "additionalDetail": null,
      "workProcessPhase": "안전관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-W20-034",
      "text": "나노물질을 취급하는 근로자에 대하여는 나노물질의 특성, 유해 가능성 및 잠재적 건강장해 영향, 작업 시 주의사항, 노출방지 및 안전대책 등에 대하여 안전보건교육을 실시하여야 한다.",
      "guideContext": "나노물질 안전보건교육",
      "additionalDetail": null,
      "workProcessPhase": "안전보건교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.7",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W20-035",
      "text": "나노물질 취급 근로자에 대하여 안전보건교육을 실시한 경우 이를 기록하고 보관 관리한다.",
      "guideContext": "나노물질 안전보건교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전보건교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.7",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-036",
      "text": "나노물질의 저장 또는 폐기물 처리는 유해성과 양 등을 고려하여 저장 등의 계획을 수립하고 준수한다.",
      "guideContext": "나노물질 저장 및 폐기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장 및 폐기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.8",
      "basedOn": null
    },
    {
      "identifier": "CI-W20-037",
      "text": "나노물질 폐기물은 전용의 용기에 보관하였다가 나노물질 전문가의 지도를 받아 처리한다.",
      "guideContext": "나노물질 저장 및 폐기",
      "additionalDetail": null,
      "workProcessPhase": "저장 및 폐기",
      "bindingForce": "MANDATORY",
