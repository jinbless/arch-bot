  "checklistItems": [
    {
      "identifier": "CI-H93-001",
      "text": "사업주 또는 병원 대표자는 의료기관 근로자의 채용 또는 업무배치 시에 적절한 검사나 예방접종 등 보건조치를 실시한다.",
      "guideContext": "의료기관 근로자 공기매개 감염병 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-002",
      "text": "채용 또는 배치 시에 흉부 방사선 촬영을 통하여 결핵의 감수성과 결핵이환 유무를 확인한다.",
      "guideContext": "결핵 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-003",
      "text": "결핵환자 격리병동, 호흡기내과병동, 응급실이나 폐기능 검사실, 결핵균 검사실 등에 근무하는 의료기관 근로자는 결핵균 감염을 예방하기 위한 적절한 주의사항에 대하여 교육을 받아야 한다.",
      "guideContext": "결핵 관리",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-004",
      "text": "의사, 간호사, 간호조무사 등 환자와 직접 접촉하는 의료기관 근로자는 채용 시 신체검사를 할 때 수두를 앓았는지 확인하고, 기억이 확실치 않거나 과거력이 없을 경우에는 수두대상포진바이러스 면역글로블린 G(Varicella-Zoster virus IgG) 검사를 한다.",
      "guideContext": "수두 및 대상포진 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-005",
      "text": "수두대상포진바이러스 면역글로블린 G가 음성인 의료기관 근로자는 수두환자나 파종성 대상포진(Disseminated herpes zoster) 환자 병실에 출입하지 않도록 한다.",
      "guideContext": "수두 및 대상포진 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-006",
      "text": "면역력 저하 환자가 많은 병동의 의료기관 근로자는 근무시작 전에 수두대상포진바이러스에 대한 면역력 여부를 확인하고 가능하면 예방접종을 한다.",
      "guideContext": "수두 및 대상포진 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-007",
      "text": "의사, 간호사, 간호조무사 등 풍진 환자와 접촉할 가능성이 크거나, 소아환자, 면역저하환자, 임산부를 다루는 의료기관 근로자는 반드시 풍진 예방접종을 한다.",
      "guideContext": "풍진 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-008",
      "text": "소아환자, 면역저하환자, 중환자, 노인환자, 이식환자 등의 고위험 환자를 직접 돌보는 의료기관 근로자는 반드시 예방접종을 실시한다.",
      "guideContext": "인플루엔자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-009",
      "text": "(1)항 외 환자와 대면하는 모든 의료기관 근로자는 되도록 예방접종을 한다.",
      "guideContext": "인플루엔자 관리",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-010",
      "text": "예방접종은 매년 가을에 한다.",
      "guideContext": "인플루엔자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "채용 또는 배치 시 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-011",
      "text": "피부반응검사가 음성인 의료기관 근로자가 특별한 보호 조치 없이 결핵환자와 접촉이 있었으면 10주 후 피부반응검사를 받아야 한다.",
      "guideContext": "결핵 노출 후 관리",
      "additionalDetail": null,
      "workProcessPhase": "결핵 노출 후 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-012",
      "text": "피부반응검사에서 양성으로 나타나면 흉부 방사선 검사를 하고, 흉부 방사선 결과 이상이 있으면 해당 이상(혹은 증상)에 따른 추가적인 검사를 한다.",
      "guideContext": "결핵 노출 후 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결핵 노출 후 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-013",
      "text": "최근 3개월 이내에 피부반응검사를 하지 않은 경우는, 가능한 한 빨리 기저 피부반응검사를 하여 10주 후 피부반응검사와 비교하여 검사결과를 해석한다.",
      "guideContext": "결핵 노출 후 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결핵 노출 후 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-014",
      "text": "폐결핵이나 후두결핵이 있는 의료기관 근로자의 객담 도말 및 배양에서 양성일 경우는 치료 후 객담도말 검사를 각각 다른 날 시행하여 3회의 검사에서 음성일 때까지 근무를 제한하며, 그 외의 결핵은 근무를 제한할 필요가 없다.",
      "guideContext": "결핵 감염 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": "업무 복귀 후에도 성실한 복약을 돕고 근무 중 약물 부작용 발생여부를 확인하는 한편 접촉자들의 결핵 발병여부를 모니터링 한다.",
      "workProcessPhase": "결핵 감염 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-015",
      "text": "도말 양성인 의료기관 근로자는 최소 2주 이상 항결핵제 투약 후 객담 도말검사에서 음성이 확인된 경우 또는 의사가 전염성 상실에 대한 소견서를 발부한 경우에 출근 제한을 해제한다.",
      "guideContext": "결핵 감염 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결핵 감염 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-016",
      "text": "항결핵제가 투여되고 있지 않은 상황에서 배양 양성이 확인되거나 항결핵제를 임의로 중단한 의료기관 근로자는 근무를 제한하는데, 특히 고위험 환자와 접촉하지 않도록 세심하게 고려한다.",
      "guideContext": "결핵 감염 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결핵 감염 근로자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-017",
      "text": "모든 수두 환자에 대해 '공기매개 경계'와 '접촉 경계'를 실시한다.",
      "guideContext": "수두 노출 관리 (법령 근거 미확인)",
      "additionalDetail": "부록1 참고",
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-018",
      "text": "수두에 면역이 없이 노출된 환자가 계속 입원해 있어야 하는 경우, 노출된 날에서 10일 이후부터 21일까지 '공기매개 경계'를 실시한다. 수두-대상포진 바이러스에 대한 면역글로불린을 투여받은 환자는 잠복기가 길어질 수 있으므로 '공기매개 경계'를 28일까지로 연장한다.",
      "guideContext": "수두 노출 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-019",
      "text": "수두환자의 병실에는 수두에 면역이 있는 사람만 출입을 허용한다.",
      "guideContext": "수두 노출 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-020",
      "text": "환자에 대한 모든 처치와 치료는 가능하면 병실 안에서 한다. 불가피하게 병실 밖으로 나가야 할 경우에는 적절한 마스크를 씌운다.",
      "guideContext": "수두 노출 관리",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H93-021",
      "text": "환자가 가게 되는 부서의 의료기관 근로자에게 환자가 전염성이 있음을 알려주어 적절한 주의를 기울인다.",
      "guideContext": "수두 노출 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-022",
      "text": "노출된 의료기관 근로자는 노출 후 즉시 과거에 수두를 앓았는지 확인하고, 확실하지 않거나 앓지 않았으면 혈청검사를 한다.",
      "guideContext": "수두 노출 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-023",
      "text": "혈청검사 상 음성일 때 수두대상포진바이러스에 대한 면역글로블린의 접종을 고려한다. 또한 노출된 의료기관 근로자는 노출 후 10일부터 21일까지 진료에 참여하지 않는다. 만약 수두대상포진바이러스에 대한 면역글로블린 접종을 받았다면 노출 후 28일까지 진료에 참여하지 않는다.",
      "guideContext": "수두 노출 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-024",
      "text": "감염관리실에서는 노출된 의료기관 근로자와 환자의 명단을 파악하고 관리가 적절하게 되고 있는지 확인한다.",
      "guideContext": "수두 노출 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-025",
      "text": "임신한 의료기관 근로자는 감염으로 태아에게 선천성 기형을 유발할 수 있기 때문에 감염된 환자와의 접촉을 제한한다.",
      "guideContext": "수두 노출 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-026",
      "text": "홍역에 걸렸거나 의심되는 입원환자는 발진이 있기 4일 전부터 6일 후까지 '공기매개 경계'를 적용하여 치료한다.",
      "guideContext": "홍역 관리 (법령 근거 미확인)",
      "additionalDetail": "부록1 참고",
      "workProcessPhase": "홍역 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-027",
      "text": "면역이 있는 의료기관 근로자만 환자를 진료할 수 있으며, 출입 시에는 반드시 마스크를 착용하여야 한다.",
      "guideContext": "홍역 관리",
      "additionalDetail": null,
      "workProcessPhase": "홍역 노출 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H93-028",
      "text": "면역이 있는 의료기관 근로자가 홍역에 노출된 경우에는 감염예방 조치를 취하기 전에 홍역에 대한 항체가를 검사하여야 한다.",
      "guideContext": "홍역 노출 근로자 관리",
      "additionalDetail": null,
      "workProcessPhase": "홍역 노출 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-029",
      "text": "면역이 없는 병원 근로자가 예방접종이나 면역글로블린을 맞았다라도 노출 후 6일째부터 20일까지는 다른 환자들과 가능한 한 접촉하지 않도록 한다.",
      "guideContext": "홍역 노출 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "홍역 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-030",
      "text": "홍역에 걸린 경우 발진이 나타난 후 최소한 4일에서부터 6일까지는 근무를 제한한다.",
      "guideContext": "홍역 감염 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "홍역 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-031",
      "text": "이하선염에 이환된 후 9일 동안은 다른 환자의 진료에 참여하지 않는다.",
      "guideContext": "유행성 이하선염 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유행성 이하선염 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-032",
      "text": "감염원에 노출된 의료기관 근로자는 노출된 후 5일부터 27일까지 다른 환자들과 접촉하지 않는다.",
      "guideContext": "유행성 이하선염 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유행성 이하선염 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-033",
      "text": "모든 의료기관 근로자는 반드시 풍진에 면역이 되어 있어야 하며, 면역성은 혈청 검사 양성이거나 예방접종을 했던 기록으로 확인할 수 있다.",
      "guideContext": "풍진 관리",
      "additionalDetail": null,
      "workProcessPhase": "풍진 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-034",
      "text": "감염되었거나 감염이 의심되는 환자를 접촉한 임신 중인 의료기관 근로자는 혈청검사를 실시하고, 산부인과 의사와 상의하여야 한다.",
      "guideContext": "풍진 노출 근로자 관리",
      "additionalDetail": null,
      "workProcessPhase": "풍진 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-035",
      "text": "풍진에 노출되었으나 면역이 없는 의료기관 근로자는 노출 후 7일부터 21일째가 되는 기간 동안에는 다른 환자들과의 직접적인 접촉을 피해야 한다.",
      "guideContext": "풍진 노출 근로자 관리",
      "additionalDetail": null,
      "workProcessPhase": "풍진 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-036",
      "text": "풍진의 증상이 나타난 의료기관 근로자는 발진이 나타난 후 5일까지는 다른 사람과의 직접적인 접촉을 피해야 한다.",
      "guideContext": "풍진 감염 근로자 관리",
      "additionalDetail": null,
      "workProcessPhase": "풍진 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-037",
      "text": "적절한 보호조치 없이 백일해 환자와 접촉한 의료기관 근로자는 즉시 예방적 항생제를 투여 받는다.",
      "guideContext": "백일해 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "백일해 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-038",
      "text": "병원 내에서 인플루엔자 감염관리에서 가장 중요한 것은 의료기관 근로자와 고위험군 환자에 대한 예방접종이다. 또한 환자를 일찍 발견하여 '공기매개 경계'를 실시하는 것이다.",
      "guideContext": "인플루엔자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인플루엔자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-039",
      "text": "유행이 의료기관 내에서 발생하기 시작하면, 위험성이 있는 모든 사람에게 인플루엔자에 대한 예방적 치료를 실시하며 동시에 인플루엔자 예방접종도 실시한다.",
      "guideContext": "인플루엔자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인플루엔자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-040",
      "text": "의료기관 근로자에게 폐렴 등의 합병증이 발생하거나 지병이 악화된 경우, 호흡기계 증상이 심한 경우는 증세가 없어질 때까지(또는 증세시작부터 최소한 5-7일) 휴무조치를 하고 일주일 경과 후 임상증상에 따라 업무복귀를 결정한다.",
      "guideContext": "인플루엔자 감염 근로자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인플루엔자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-041",
      "text": "병원 내 대유행을 예방하기 위하여 접촉자 관리도 중요하다. 같은 공간 근무자에 대해 인플루엔자 유사 증상이 발생할 때 검사를 시행하여 확진될 경우 휴무조치를 실시하며, 환자와의 접촉을 제한한다.",
      "guideContext": "인플루엔자 접촉자 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인플루엔자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-042",
      "text": "감염된 환자나 감염이 의심되는 환자는 '비말매개 경계'를 실시한다.",
      "guideContext": "파르보바이러스 B19 관리 (법령 근거 미확인)",
      "additionalDetail": "부록1 참고",
      "workProcessPhase": "파르보바이러스 B19 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-043",
      "text": "임신 5개월까지의 임산부는 감염된 환자나 감염이 의심되는 환자와 접촉하지 않아야 한다.",
      "guideContext": "파르보바이러스 B19 관리",
      "additionalDetail": "부록2 참고",
      "workProcessPhase": "파르보바이러스 B19 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.8",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-044",
      "text": "감염된 환자에 노출된 의료기관 근로자는 증세가 나타나는지 계속 확인해야 한다.",
      "guideContext": "파르보바이러스 B19 관리",
      "additionalDetail": null,
      "workProcessPhase": "파르보바이러스 B19 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-045",
      "text": "감염이 의심되는 의료기관 근로자도 감염될 경우 후유증이 우려되는 환자들의 진료에는 참가하지 않아야 한다.",
      "guideContext": "파르보바이러스 B19 관리",
      "additionalDetail": null,
      "workProcessPhase": "파르보바이러스 B19 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.8",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H93-046",
      "text": "감염된 의료기관 근로자는 증세가 없어진 후에도 3-4일간 근무를 제한할 필요가 있다.",
      "guideContext": "파르보바이러스 B19 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "파르보바이러스 B19 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-047",
      "text": "적절한 보호조치 없이 수막구균 감염 환자와 가까운 접촉(예: 안지검사, 구강대구강 소생술)을 한 의료기관 근로자와 검사실에서 적절한 보호 장구 없이 균을 다룬 검사실 의료기관 근로자는 예방적인 항생제를 투여한다.",
      "guideContext": "수막염 관리 (법령 근거 미확인)",
      "additionalDetail": "보호 장구로는 가운, 장갑이 필요하며, 균이 분무되는 상황이라면 후드 안에서 취급하여야 함",
      "workProcessPhase": "수막염 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-048",
      "text": "사업주 또는 병원대표자는 이 지침에 정하지 않은 기타의 공기매개 감염성 질환자로부터 의료기관 근로자의 건강을 보호할 필요가 있을 경우에 관계 전문가 또는 기관을 통해 조치한다.",
      "guideContext": "기타 공기매개 감염병 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-049",
      "text": "환자의 방은 음압을 유지하고, 시간당 최소한 6회 이상 공기를 교환하여야 한다.",
      "guideContext": "공기매개 경계",
      "additionalDetail": null,
      "workProcessPhase": "공기매개 경계 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "부록1-1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H93-050",
      "text": "환자의 방문은 항상 닫아 둔다.",
      "guideContext": "공기매개 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기매개 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "부록1-1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-051",
      "text": "1인용 병실을 사용할 수 없는 경우는 같은 균을 가진 환자끼리 병실을 사용한다.",
      "guideContext": "공기매개 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기매개 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-052",
      "text": "결핵에 감염되었거나 의심되는 환자의 방에 들어갈 때는 항산균(Acid fast bacilli, AFB)용 마스크(예, KF94)를 착용한다.",
      "guideContext": "공기매개 경계",
      "additionalDetail": null,
      "workProcessPhase": "공기매개 경계 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "부록1-1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H93-053",
      "text": "수두, 홍역에 감수성이 있는 사람은 가능하면 환자의 방에 들어가지 않는다.",
      "guideContext": "공기매개 경계",
      "additionalDetail": null,
      "workProcessPhase": "공기매개 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-054",
      "text": "환자의 이동을 최소화한다.",
      "guideContext": "공기매개 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기매개 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-1",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-055",
      "text": "이동이 불가피할 경우에는 환자에게 일반 마스크보다는 여과력이 큰 수술용 마스크를 착용하게 한다.",
      "guideContext": "공기매개 경계",
      "additionalDetail": null,
      "workProcessPhase": "공기매개 경계 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "부록1-1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H93-056",
      "text": "가능한 독방을 쓰거나 같은 질환을 앓는 환자끼리 동일한 방을 사용한다. 그러나 다른 질환의 환자와 동일한 방을 사용하게 될 경우에는 2m 이상의 간격을 두어야 한다.",
      "guideContext": "비말매개 경계",
      "additionalDetail": null,
      "workProcessPhase": "비말매개 경계 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "부록1-2",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-H93-057",
      "text": "환자와의 거리가 2m 이내일 경우는 마스크를 착용한다.",
      "guideContext": "비말매개 경계",
      "additionalDetail": null,
      "workProcessPhase": "비말매개 경계 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "부록1-2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H93-058",
      "text": "환자의 이동을 최소화하며, 환자를 이동할 때에는 환자에게 마스크를 착용하게 한다.",
      "guideContext": "비말매개 경계",
      "additionalDetail": null,
      "workProcessPhase": "비말매개 경계 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "부록1-2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H93-059",
      "text": "방에 들어갈 때 반드시 장갑을 착용한다.",
      "guideContext": "접촉 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "부록1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-060",
      "text": "환자 처치 후 오염된 장갑으로 다른 환자나 기구를 만지지 않는다.",
      "guideContext": "접촉 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-061",
      "text": "환자의 방을 나오기 전에 반드시 손을 씻고, 씻을 수 없을 때는 손 소독제를 사용한다.",
      "guideContext": "접촉 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-062",
      "text": "깨끗하게 세탁된 가운을 착용한다.",
      "guideContext": "접촉 경계 (법령 근거 미확인)",
      "additionalDetail": "환자를 처치할 때 감염원과 접촉하여 옷이 오염될 가능성이 있는 경우에 입는다.",
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "부록1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-063",
      "text": "입었던 가운이 주위 환경에 닿아 환경을 오염시키지 않도록 하며, 처치 후 환자가 있는 병실을 떠나기 전에 가운을 벗고 나온다.",
      "guideContext": "접촉 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-064",
      "text": "가능한 한 환자의 이동을 제한하고 이동시 환경을 오염시키지 않도록 주의한다.",
      "guideContext": "접촉 경계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-065",
      "text": "환자가 사용했던 물건이나 만졌던 것은 매일 깨끗이 청소한다.",
      "guideContext": "접촉 경계",
      "additionalDetail": null,
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H93-066",
      "text": "청진기, 혈압계, 이동변기, 직장체온계와 같은 기구는 다른 환자와 같이 사용하지 않는다.",
      "guideContext": "접촉 경계 (법령 근거 미확인)",
      "additionalDetail": "재사용 물품은 소독 후 다른 환자에게 사용할 수 있다.",
      "workProcessPhase": "접촉 경계 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1-3",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-067",
      "text": "노출된 의료기관 근로자는 근무하지 않도록 하거나 환자와 직접 접촉하지 않고, 수두에 면역이 있는 사람들과만 함께 일하며, 회의나 미팅에 참석하지 않고, 본인이 근무하는 의료기관 식당을 이용하지 않으며, 본인이 근무하는 의료기관 출입시 가장 빠르고 안전한 통로만 이용하는 방법으로 근무를 제한한다.",
      "guideContext": "수두 노출 근로자 근무 제한 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수두 및 대상포진 노출 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H93-068",
      "text": "감염된 환자에 노출된 임산부는 이전에 감염된 적이 있는지 확인하기 위하여 검사를 실시하며, 혈청 면역글로블린 G가 양성이면 면역력이 있음을 나타낸다.",
      "guideContext": "파르보바이러스 B19 임산부 관리 (법령 근거 미확인)",
      "additionalDetail": "이 바이러스에 노출된 면역력이 없는 임산부는 산부인과에서 진료를 받아 면역글로블린 M의 존재여부를 확인해야 한다.",
      "workProcessPhase": "파르보바이러스 B19 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H93-001",
      "term": "의료기관 근로자",
      "definition": "의사, 간호사, 간호조무사, 방사선사, 임상병리사 등 의료행위를 직접 하거나 보조업무를 하는 근로자와 병원에서 시설관리, 청소, 세탁, 인쇄, 음식료의 준비 및 배식, 폐기물의 수집이나 처리 등의 업무를 수행하는 근로자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H93-002",
      "term": "공기매개 감염병",
      "definition": "결핵·수두·홍역 등 공기 또는 비말핵 등을 매개로 호흡기를 통하여 전염되는 감염병을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H93-01",
      "processOrder": 1,
      "processName": "채용 또는 배치 시 의료기관 근로자 검사 및 예방접종",
      "safetyMeasures": "채용 또는 업무배치 시 결핵 흉부 방사선 촬영, 수두 면역력 확인(IgG 검사), 풍진 예방접종, 인플루엔자 예방접종(매년 가을) 등 감염병별 적절한 검사 및 예방접종 실시",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
