  "checklistItems": [
    {
      "identifier": "CI-G4-001",
      "text": "배관장치의 이송물질에 대한 표시는 이송물질의 명칭을 모두 다 나타내거나 또는 약자 형태로 나타내는 표지로 표시한다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "표지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-002",
      "text": "표지명은 최대의 효율성을 위해 간략하고 정보 제공성이 있는 글머리로 간결하게 표시한다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "표지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-003",
      "text": "표지는 밸브, 플랜지, 앨보우, 분기관, 배관이 벽이나 바닥을 관통하는 부위에 근접하여 부착하고 직선 배관에는 일정한 간격으로 충분하게 부착한다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "표지 부착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-004",
      "text": "물질의 유동방향을 표시하기 위해 화살표를 사용한다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "표지 부착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-005",
      "text": "이송물질의 위험성을 확인하기 위하여 온도, 압력 등의 충분한 추가 정보를 표지명에 포함한다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "표지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-006",
      "text": "이송물질의 종류에 따라 위험도 특성을 쉽게 확인하기 위해 <표 1>과 같이 색상으로 구분하여 나타낸다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": "인화성/폭발성·산화성/독성·극한온도압력·방사성 물질은 노란색 바탕에 검정색, 위험도 낮은 액체는 녹색 바탕에 하얀색, 가스는 파란색 바탕에 하얀색, 소화성 물질은 빨간색 바탕에 하얀색",
      "workProcessPhase": "색상 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-007",
      "text": "색상은 배관 위 혹은 가까이에 부착하는 방법을 이용하여 표시하여야 하며, 표지에 나타나게 한다.",
      "guideContext": "배관내 이송물질 표시 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "색상 표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-008",
      "text": "색상은 연속으로 배관의 전체 길이에 걸쳐 표시하거나 또는 일부 구간만 표시할 수 있다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "색상 표시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-009",
      "text": "배관이 시야보다 높거나 낮게 위치하는 경우 문자 표시가 배관의 수평 중심선 위나 아래에 표시되도록 배관 표지의 가시성에 주의를 기울여야 한다.",
      "guideContext": "배관내 이송물질 표시 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "표지 부착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-010",
      "text": "알기 쉽게 색상과 표지 사이에는 대비 효과가 있어야 한다.",
      "guideContext": "배관내 이송물질 표시 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "표지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-011",
      "text": "15mm 이상 크기의 문자 사용을 권장하며 세부 크기 권장 사항은 <표 2>를 참조한다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "표지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-012",
      "text": "직경 20mm 미만의 배관 내 물질과 밸브 및 관 부속품에 관한 표시에는 영구적인 꼬리표(Tag)의 사용이 권장된다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": null,
      "workProcessPhase": "표지 부착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G4-013",
      "text": "접근하기 어렵거나 대단히 복잡한 제한지역에서 배관 배치를 해야 할 경우, 이러한 배치 구획은 명확한 식별을 위해 대용기술이 필요할 수 있다.",
      "guideContext": "배관내 이송물질 표시",
      "additionalDetail": "대용기술의 사용은 해당 구획에 제한되며, 표지·색상 및 이송물질 종류에 따른 식별 개념에서 벗어나지 않아야 함",
      "workProcessPhase": "표지 부착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G4-001",
      "term": "배관",
      "definition": "가스, 액체, 반 액체 혹은 분체의 이송을 위한 관을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G4-002",
      "term": "원천적으로 위험한 물질",
      "definition": "인화성 혹은 폭발성 물질과 산화성 또는 독성 물질 그리고 온도 및 압력 위험물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G4-003",
      "term": "인화성 또는 폭발성 물질",
      "definition": "각각 대기압 하에서 인화점이 65℃ 이하인 가연성 물질과 가열, 마찰, 충격 또는 다른 화학물질과의 접촉 등으로 인하여 산소나 산화제의 공급이 없더라도 폭발 등 격렬한 반응을 일으킬 수 있는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G4-004",
      "term": "산화성 혹은 독성 물질",
      "definition": "산화력이 강하고 가열, 충격 다른 화학물질과의 접촉 등으로 인해 격렬하게 분해되거나 반응하는 물질과 독성이 강한 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G4-005",
      "term": "온도 및 압력 위험물질",
      "definition": "배관에서 배출될 경우 분사 충돌 혹은 기체상태의 섬광에 의해 부상 혹은 물적 손상을 초래할 가능성이 있는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G4-006",
      "term": "방사성 물질",
      "definition": "이온화된 방사선을 방사하는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G4-007",
      "term": "원천적으로 위험도가 낮은 물질",
      "definition": "물질방출시에도 대기 압력과 온도와 비슷하여 이들 물질을 이송하는 시스템에서 작업하는 근로자에게 위험성이 적은 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
