  "checklistItems": [
    {
      "identifier": "CI-G117-001",
      "text": "새로운 물질로 대체할 경우 또 다른 유해인자가 존재하는지 평가해야 한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "대체물질 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-002",
      "text": "가능하면 점차 증가하고 있는 수용성 코팅제로 대체한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "대체물질 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-003",
      "text": "스프레이 부스나 격리실은 내화시간이 30분을 견디는 내화성 재질로 만들어져야 한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "구획관리 및 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-004",
      "text": "부분적으로 격리된 장소에서 스프레이 도장작업을 하여 화재 발생 시 인접공간으로 화재가 번지는 것을 막을 수 있도록 구획관리가 되어야 한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "구획관리 및 격리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-005",
      "text": "클리어런스 시간을 스프레이 부스/작업장의 출입문에 게시한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "클리어런스 시간 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-006",
      "text": "측정시간동안은 방진마스크를 착용한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "클리어런스 시간 측정 시 호흡보호",
      "workProcessPhase": "클리어런스 시간 측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G117-007",
      "text": "스프레이 부스나 공간에서 최대 인화성 물질의 농도는 폭발하한계(LEL)의 25%를 초과해서는 안 된다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "가스 모니터링 기기가 작동하는 자동 부스의 경우 LEL 50%까지 가능",
      "workProcessPhase": "환기관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G117-008",
      "text": "전면 개방(Open-fronted) 부스: 최소 평균속도는 0.7 m/sec",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "횡단방해풍(Cross draft)을 극복할 수 있는 충분한 제어풍속 유지",
      "workProcessPhase": "환기관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-009",
      "text": "측방형 부스 후드 안에서 작업할 경우: 작업자가 서 있는 곳 0.5 m/sec, 최소 평균 속도 0.4 m/sec",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "환기관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-010",
      "text": "하방형 부스 후드 안에서 작업할 경우: 피도장물 주위 0.4 m/sec, 최소 평균 0.3 m/sec",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "환기관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-011",
      "text": "스프레이 도장 작업이 끝나도 증기를 효과적으로 제거하기 위해서는 수 분 동안 송풍기 작동을 지속시킨다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "환기관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-012",
      "text": "점심시간, 잠시 휴식시간 또는 작업을 마친 후 환기장치의 가동을 중단한 상태에서 젖은 피도장물을 부스에 놓아두어서는 안 된다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "이 경우 인화성 분위기로 발전할 수 있다",
      "workProcessPhase": "환기관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-G117-013",
      "text": "점화원은 항상 스프레이 도장작업 지역에 없어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "스프레이 작업을 하지 않더라도 인화성 잔류물, 오염된 물질, 건조 및 세척작업은 항상 화재의 위험성을 안고 있다",
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "CI-G117-014",
      "text": "스프레이 도장작업 장소에서는 전기기계·기구는 사용하지 말아야 한다. 기타 모든 점화원은 폭발위험장소에서 제거되어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "CI-G117-015",
      "text": "정전기 발생으로 인화성 증기에 스파크가 발생하지 않도록 해야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-G117-016",
      "text": "인화성 혹은 가연성 액체에 대한 대전방지대책을 수립해야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-G117-017",
      "text": "취급하는 장치, 용기, 배관 등을 부도체로 하지 말고 금속성 혹은 도전성 재료로 된 것을 사용하고 접지시킨다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "인화성·가연성 액체 대전방지대책",
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-G117-018",
      "text": "플라스틱용기를 사용할 때에는 정전기방지 플라스틱용기인지 확인하고 사용한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-G117-019",
      "text": "기체나 증기의 대전방지를 위해서는 녹, 먼지, 미스트 등의 이물질을 가능한 한 제거한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-G117-020",
      "text": "정전기방지 안전화를 사용한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "인화성·가연성 액체 대전방지대책",
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-G117-021",
      "text": "도장 블록과 인접한 블록에서는 화기작업을 금지한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "점화원 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G117-022",
      "text": "밀폐공간에서의 스프레이 도장작업은 안전에 대한 충분한 교육을 받은 사람만이 투입되어야 한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-023",
      "text": "밀폐공간 작업 시에는 반드시 서면으로 된 출입허가증 혹은 작업허가증을 발부받은 사람만 출입해야 하며 진입할 때 입구에 증빙서를 게시해야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-013"
      ]
    },
    {
      "identifier": "CI-G117-024",
      "text": "밀폐공간 내 구석구석에 안전한 수준의 공기가 혼합되도록 기계에 의한 강제환기를 시켜야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G117-025",
      "text": "환기는 반드시 급기 위주로 시켜야 하며 급기량이 배기량보다 통상적으로 10% 더 많도록 공급해야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G117-026",
      "text": "충분한 양의 외부의 공기가 작업자에게 공급되기 위해서는 이동식 급기 덕트를 이용한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G117-027",
      "text": "인화성 액체의 증기농도는 LEL의 25%를 절대 초과해서는 안 되며 보다 안전을 기하기 위해서는 LEL의 10% 미만을 유지시킨다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "탱크 세척작업에는 LEL의 10%를 유지하도록 하고 있음",
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G117-028",
      "text": "스프레이 도장작업에서 발생한 증기는 바닥에 깔려 있으므로 이 지점에서 제거작업을 실시해야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G117-029",
      "text": "건물, 작업지역 혹은 점화원에서 안전한 장소에 출구점을 만든다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-030",
      "text": "붓칠이나 롤러 도장작업 역시 동일한 환기설비가 필요적이다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G117-031",
      "text": "인화증기농도가 증가하면(LEL의 10% 이상) 즉각적으로 감지할 수 있어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "통상적으로 사용하는 기기로는 경보기능이 있는 가스감지기나 폭발감지기(Explosimeter)이다",
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G117-032",
      "text": "폭발감지기를 사용하는 작업자는 기기의 사용법과 결과 해석에 대해 철저한 교육이 필요하다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-033",
      "text": "주기적인 체크로 환기가 효과적으로 이루어진다고 하더라도 계속적인 감시를 권장한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "스프레이 작업자의 수가 증가하거나 보다 증발이 잘 되는 물질을 사용할 경우 등 공정이 변하면 환기방식을 재평가할 필요가 있다",
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-034",
      "text": "경보음은 밀폐공간에 있는 모든 사람들에게 명확하게 들려야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-G117-035",
      "text": "일단 작업장소를 나온 뒤에는 증기가 안전 수준까지 내려가지 전에는 절대 재진입하면 안 된다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-G117-036",
      "text": "경보음은 환기가 잘못된 경우가 주된 원인이므로 열선풍속계를 이용하여 배기 및 급기상태를 확인한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G117-037",
      "text": "밀폐공간에서 점화원은 절대 사용금지이며 방폭조명기구를 사용해야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-G117-038",
      "text": "송풍기 모터, 압축기, 스위치와 경보기 등 비방폭기계·기구는 인화증기농도에 노출되지 않는 밀폐공간 밖의 안전한 장소에 위치시켜야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-G117-039",
      "text": "밀폐공간에서는 도장작업이 끝났어도 도장 코팅이 건조하여 인화성분위기가 더 이상 존재하지 않을 때까지 환기를 계속해야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "밀폐공간에서 인화성 증기의 축적은 외부의 고열작업에 의해서도 발화될 수 있다",
      "workProcessPhase": "밀폐공간 도장작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G117-040",
      "text": "도장작업장 혹은 근처에서 화기작업(용접, 절단, 가열)을 금지한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "인화점이 27℃ (80°F) 이상인 액체/물질 취급 시",
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G117-041",
      "text": "용제에 젖은 헝겊은 뚜껑이 있는 금속용기에 보관한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-042",
      "text": "사용하지 않는 페인트, 신나 및 용제는 뚜껑이 있는 내화성 용기에 넣어 둔다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-043",
      "text": "흡연과 개방 소각을 금지한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": "인화점이 27℃ 이상인 액체/물질 취급 시",
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-044",
      "text": "아크나 스파크 장비/도구의 사용을 금지한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "CI-G117-045",
      "text": "환기장치와 같이 정전기가 발생하는 장치는 접지시킨다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-G117-046",
      "text": "오로지 방폭 전등만 사용한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-G117-047",
      "text": "혼합, 저장, 이동 시에는 충분한 환기가 유지되어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-048",
      "text": "도장작업을 하는 동안 LEL의 25% 미만인지 수시로 점검하고 기록으로 남겨둔다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G117-049",
      "text": "적절한 소화장비가 비치되어 있어야 한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-050",
      "text": "인화성 혹은 독성 액체가 들어 있는 30 gallon (112 L)의 드럼은 물리적인 손상을 받지 않을 장소에 보관한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-051",
      "text": "인화성 혹은 독성 액체가 들어 있는 55 gallon (206 L)의 드럼은 방벽이 있는 장소에 보관한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-052",
      "text": "반드시 전기기사가 전선의 전기적 위험성을 점검해야하며 작업장에서 15 m 이내에 커넥터가 있어서는 안 된다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-G117-053",
      "text": "엎질러진 용제는 즉시 수거 되어 청소가 이루어져야 한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-054",
      "text": "충분히 환기하여 유기증기의 농도가 LEL 10% 미만이 되게 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "인화점이 27℃ (80°F) 미만인 페인트, 도포제 및 유기용제 취급 시",
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-055",
      "text": "만약 LEL이 10%를 넘으면 작업을 중지하고 10% 미만이 될 때까지 기다린다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-G117-056",
      "text": "도장작업이 끝난 후 작업공간이나 구조물에서 증기발생이 없을 때까지 환기장치를 계속 가동한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-057",
      "text": "배기 덕트는 점화원에서 멀리 떨어진 깨끗한 곳으로 연결되어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-G117-058",
      "text": "정기적으로 배기된 증기가 다른 지역이나 건조 도크 혹은 용기에 축적되는지 점검한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G117-059",
      "text": "방폭 모터, 송풍기, 휴대용 덕트는 비철로 만들어져 있어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "인화점 27℃ 미만 물질 취급 시",
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-G117-060",
      "text": "도장작업 중 사용하는 모든 안전화는 정전기방지용으로 스파크가 발생하지 않아야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-G117-061",
      "text": "개인보호장구(PPE) 역시 정전기 방지용이어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-G117-062",
      "text": "성냥, 담배, 시가, 라이터, 기타 금속성 물품의 반입을 금지한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": "인화점 27℃ 미만 물질 취급 시",
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-063",
      "text": "도장 작업을 수행하는 구조물과 연결된 중 모든 용제 드럼은 비철표면에 놓여 있어야 하고 선박에 접지가 되어 있어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-G117-064",
      "text": "모든 스프레이 도장장비의 금속부분은 전기적으로 접지되어 있어야 한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-G117-065",
      "text": "혼합전용장소는 격리되고 환기가 잘되며 내화성의 벽으로 만들어져야 한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "원료 혼합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-066",
      "text": "점화원이 존재해서는 안 되며 전기기계·기구도 적합 인증을 받은 것을 사용한다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": "원료 혼합전용장소",
      "workProcessPhase": "원료 혼합",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-G117-067",
      "text": "작업장에 신나와 같은 인화성 액체의 보관은 최소화 하고 사용하지 않을 때에는 용기를 밀봉하여 금속의 캐비닛이나 유출방지용 통에 보관한다.",
      "guideContext": "선박내부 도장작업 안전 (법령 근거 미확인)",
      "additionalDetail": "양이 많으면 격리된 내화방지 저장소에 보관한다",
      "workProcessPhase": "인화성 액체 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G117-068",
      "text": "빈 드럼이나 통은 작업장에서 제거하여 안전장소로 운반하는 금속 통에 집어넣는다.",
      "guideContext": "선박내부 도장작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "인화성 액체 보관",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
