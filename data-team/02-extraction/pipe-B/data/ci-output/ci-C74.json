  "domainTerms": [
    {
      "identifier": "DT-C74-001",
      "term": "고소작업대",
      "definition": "작업대, 연장구조물(지브), 차대로 구성되며 근로자를 작업위치로 이동시켜주는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-002",
      "term": "작업대",
      "definition": "안전난간이 설치되어 있는 플랫폼 또는 케이지로 화물을 싣고 필요한 작업위치로 이동이 가능하며 그 곳에서 작업이 수행될 수 있는 곳을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-003",
      "term": "연장구조물 또는 지브",
      "definition": "차대에 연결되어 작업대를 지탱하며 필요한 위치로 이동할 수 있게 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-004",
      "term": "차대",
      "definition": "작업대의 하부체로서 필요한 위치로 이동할 수 있게 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-005",
      "term": "안정기",
      "definition": "아웃트리거 등 고소작업대 전체 혹은 연장구조물을 지지 또는 수평을 유지토록 하여 고소작업대를 안정시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-006",
      "term": "운반위치",
      "definition": "고소작업대가 작업위치로 이동된 상태에서의 작업대 위치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-007",
      "term": "전복선",
      "definition": "고소작업대가 전복모멘트에 의하여 전도될 수 있는 수직의 기준선을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-008",
      "term": "정격하중",
      "definition": "설계상 고소작업대가 정상작동을 하면서 작업대에 수직으로 가해지는 인원, 공구 및 자재의 최대하중을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-009",
      "term": "적재위치",
      "definition": "연장구조물 및 안정기가 하강 또는 수축되어 있는 고소작업대의 상태로 제조자가 지정한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-010",
      "term": "풋스위치",
      "definition": "작업대의 바닥 등에 작동발판을 설치하여 비상시 작업자가 발을 떼면 작동이 멈추어 고소작업대의 전복 및 근로자의 협착 등을 예방하기 위한 장치를 말한다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-011",
      "term": "상승이동방지장치(주행차단장치)",
      "definition": "작업대의 운반위치에서 작업대가 벗어나면 상승을 방지하는 장치를 말한다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-012",
      "term": "비상안전장치(수동하강밸브)",
      "definition": "정전시 또는 비상배터리 방전 등의 비상시 작업대를 수동으로 하강시킬 수 있는 장치를 말한다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-013",
      "term": "과상승방지대",
      "definition": "고소작업대에 과상승방지 센서를 부착하여 과상승방지 센서가 상부 구조물에 접촉시 장비의 상승작동을 멈추게 하는 장치를 말한다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-014",
      "term": "비상정지장치",
      "definition": "각 제어반 및 비상정지를 필요로 하는 위치에 설치하고 비상시 작동하여 고소작업대를 정지시키는 장치를 말한다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-015",
      "term": "과부하방지장치",
      "definition": "정격하중을 초과하면 고정위치로부터 작업대가 움직이지 못하도록 하는 장치를 말한다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C74-016",
      "term": "아웃트리거",
      "definition": "전도 사고를 방지하기 위하여 장비의 측면에 부착하여 전도 모멘트를 효과적으로 지탱할 수 있도록 한 장치를 말한다.",
      "sourceSection": "5",
      "relatedSR": null
    }
  ],
