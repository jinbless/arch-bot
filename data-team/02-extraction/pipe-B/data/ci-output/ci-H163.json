    {
      "identifier": "DT-H163-002",
      "term": "감정노동(Emotional labor)",
      "definition": "고객 응대 등 업무수행과정에서, 말투나 표정, 몸짓 등 드러나는 감정 표현을 직무의 한 부분으로 하여, 자신의 감정을 절제하고 자신이 실제 느끼는 감정과는 다른 특정 감정을 표현하도록 업무상, 조직상 요구되는 노동형태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H163-003",
      "term": "측정도구",
      "definition": "한국산업안전보건공단 산업안전보건연구원이 외부 연구진과 공동 개발하여 표준화한 '한국형 감정노동 평가도구'를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
