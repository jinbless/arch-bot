  "checklistItems": [
    {
      "identifier": "CI-H163-001",
      "text": "개별 근로자의 감정노동에 대하여는 <부록 1>과 <부록 2>를 참조하여, 직종별, 계층별, 연령별로 고위험 집단을 파악한다.",
      "guideContext": "고객응대 근로자의 감정노동평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고위험 집단 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H163-002",
      "text": "평가는 매년 연말 또는 연초에 시행할 수 있으며, 관리상 필요시 추가적으로 평가할 수 있다.",
      "guideContext": "고객응대 근로자의 감정노동평가",
      "additionalDetail": null,
      "workProcessPhase": "감정노동 평가 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H163-003",
      "text": "해당 사업장의 보건관리자나 사업주가 지정한 고객응대 근로자 건강보호 업무를 담당하는 부서의 실무담당자가 담당한다.",
      "guideContext": "고객응대 근로자의 감정노동평가 (법령 근거 미확인)",
      "additionalDetail": "감정노동 평가 수행 주체를 보건관리자 또는 지정 실무담당자로 규정",
      "workProcessPhase": "감정노동 평가 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H163-004",
      "text": "각 영역별로 단순 합산하여 점수화하여 사용한다.",
      "guideContext": "고객응대 근로자의 감정노동평가 (법령 근거 미확인)",
      "additionalDetail": "한국형 감정노동평가도구(K_ELS®11) 4개 하위 영역별 점수 산정 방식",
      "workProcessPhase": "점수 산정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H163-005",
      "text": "감정노동의 영역별 환산점수는 <부록 2>에 제시된 한국형 감정노동 평가도구의 요인별 성별 참고치와 비교하여 평가를 내릴 수 있다.",
      "guideContext": "고객응대 근로자의 감정노동평가",
      "additionalDetail": "성별 참고치는 절대적 기준이 아니며, 집단 평균이 주의 수준에 해당하면 개선 우선순위로 판단",
      "workProcessPhase": "결과 해석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H163-006",
      "text": "근로자의 감정노동으로 인한 건강장해나 업무성과 저하를 예방하기 위해서는 감정노동으로 발생 가능한 부정적 증상이나 징후가 나타나기 이전이라도 감정노동 요인에 더 많이 노출되고 있는 부서의 감정노동의 강도나 빈도를 줄여주거나 소속 직원들의 감정노동에 대한 대처능력을 키워주는 적극적인 노력이 필요하다.",
      "guideContext": "고객응대 근로자의 감정노동평가",
      "additionalDetail": null,
      "workProcessPhase": "사후 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
