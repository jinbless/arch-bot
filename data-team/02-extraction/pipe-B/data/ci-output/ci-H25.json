  "domainTerms": [
    {
      "identifier": "DT-H25-001",
      "term": "근골격계질환",
      "definition": "반복적인 동작, 부적절한 작업자세, 무리한 힘의 사용, 날카로운 면과의 신체 접촉, 진동 및 온도 등의 요인에 의하여 발생하는 건강장해로서 목, 어깨, 허리, 상·하지의 신경근육 및 그 주변 신체 조직 등에 나타나는 질환을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H25-002",
      "term": "청소작업",
      "definition": "청소도구 운반, 벽면 및 천정의 먼지제거, 손걸레 청소 바닥 및 계단 쓸기, 대걸레 청소, 진공청소기 사용, 바닥 광택, 쓰레기 수거 기타 청소를 위한 가구나 장비의 이동 등 수작업 및 기계사용을 포함하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H25-01",
      "processOrder": 1,
      "processName": "청소도구 운반",
      "safetyMeasures": "청소를 위한 도구, 세제를 수레 등에 적재 후 운반작업. 무리한 힘(중량물) 사용에 의한 어깨·허리 부담, 부적절한 작업자세에 의한 어깨·허리·다리 부담, 접촉스트레스에 의한 손/손목 부담, 미끄러짐/넘어짐에 의한 다리·허리 부담에 주의. 바퀴 달린 전용 운반도구를 사용하고, 미끄럼방지 장화를 착용한다.",
      "requiredPPE": [
        "미끄럼방지 장화",
        "보호장갑"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H25-02",
      "processOrder": 2,
      "processName": "벽면 및 천정 먼지제거",
      "safetyMeasures": "건물 내 벽면/천정의 먼지를 빗자루 또는 전용도구를 사용하여 제거 작업. 부적절한 작업자세(목, 어깨, 팔), 반복동작(목, 어깨, 팔), 정적인 자세(목, 어깨), 접촉스트레스(손/손목)에 주의. 높은 곳은 사다리 이용 또는 손잡이가 긴 작업도구를 이용한다.",
      "requiredPPE": [
        "방진마스크",
        "보안경"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H25-03",
      "processOrder": 3,
      "processName": "손걸레 청소",
      "safetyMeasures": "벽면, 바닥, 계단 난간 등을 손걸레를 사용하여 청소 작업. 부적절한 작업자세(목, 어깨, 팔, 허리), 반복동작(손/손목, 어깨, 팔), 접촉스트레스(손/손목), 화학물질(세제) 노출(눈, 피부)에 주의. 꺾인 손잡이의 도구를 사용하고, 세제 취급 시 보호장갑을 착용한다.",
      "requiredPPE": [
        "보호장갑",
        "보안경"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H25-04",
      "processOrder": 4,
      "processName": "바닥 및 계단 쓸기",
      "safetyMeasures": "빗자루와 쓰레받기를 사용하여 바닥 먼지를 쓸어내거나 담는 작업. 부적절한 작업자세(손/손목, 어깨, 팔, 허리), 반복동작(손/손목, 팔, 어깨), 접촉스트레스(손/손목), 미끄러짐/넘어짐(다리, 허리)에 주의. 꺾인 손잡이 빗자루를 사용하고, 미끄럼방지 장화를 착용한다.",
      "requiredPPE": [
        "미끄럼방지 장화"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H25-05",
      "processOrder": 5,
      "processName": "대걸레 청소",
      "safetyMeasures": "대걸레를 물, 세제에 적셔 바닥, 계단 등을 닦는 작업. 부적절한 작업자세(손/손목, 어깨, 팔, 허리), 반복동작(손/손목, 어깨), 접촉스트레스(손/손목), 화학물질(세제) 노출(눈, 피부), 미끄러짐/넘어짐(다리, 허리)에 주의. 보조 손잡이가 있는 대걸레, 손잡이가 긴 탈수기를 사용한다.",
      "requiredPPE": [
        "미끄럼방지 장화",
        "보호장갑"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H25-06",
      "processOrder": 6,
      "processName": "진공청소기 사용",
      "safetyMeasures": "진공청소기를 사용하여 실내 바닥 등을 청소하는 작업. 부적절한 작업자세(손/손목, 팔, 어깨), 반복동작(손/손목, 팔, 어깨), 접촉스트레스(손/손목)에 주의. 협소한 공간에서는 배낭형 진공청소기를 사용한다.",
      "requiredPPE": [
        "방진마스크"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H25-07",
      "processOrder": 7,
      "processName": "바닥 광택",
      "safetyMeasures": "전동광택기 등을 사용하여 바닥에 광택을 내는 작업. 반복동작(손/손목, 팔, 어깨), 접촉스트레스(손/손목), 진동(손/손목, 팔, 어깨)에 주의. 손잡이 부분에 패드를 부착하거나 방진장갑을 착용하고, 계단이동용 바퀴를 부착하여 사용한다.",
      "requiredPPE": [
        "방진장갑"
      ],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H25-08",
      "processOrder": 8,
      "processName": "쓰레기 수거",
      "safetyMeasures": "청소도구 정리 및 쓰레기 분리수거 작업. 무리한 힘(중량물)(어깨, 허리), 부적절한 작업자세(어깨, 허리, 다리), 미끄러짐/넘어짐(다리, 허리), 베임/찔림(손/손목, 무릎, 다리)에 주의. 날카로운 물건은 집게를 이용하고, 2인 이상 작업 또는 보조도구를 사용한다.",
      "requiredPPE": [
        "보호장갑",
        "안전장화",
        "베임 방지 바지"
      ],
      "sourceSection": "4",
      "relatedSR": null
    }
  ],
