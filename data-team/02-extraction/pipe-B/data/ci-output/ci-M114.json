  "checklistItems": [
    {
      "identifier": "CI-M114-001",
      "text": "부적합한 윤활유가 섞이거나 투입되면 기계의 정상 성능 발휘에 문제가 생기며, 적정 윤활유와 물리적·화학적으로 반응을 일으키게 되므로 저장 탱크에 투입시 주의한다.",
      "guideContext": "윤활유 품질관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-002",
      "text": "하나의 설비에서는 사용하는 윤활유의 종류를 최소화한다.",
      "guideContext": "윤활유 품질관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-003",
      "text": "새로운 장비를 설치할 때에는 이미 사용되고 있는 윤활유를 사용할 수 있도록 장비사양서에 기록하여 발주한다.",
      "guideContext": "윤활유 품질관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-004",
      "text": "윤활유 지장탱크의 투입구, 윤활유 보관 용기에는 사용 또는 저장되는 윤활유의 이름을 표시한다.",
      "guideContext": "윤활유 품질관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-005",
      "text": "기계·장비 이력서 또는 기계관리 대장에는 윤활유의 종류와 윤활유 공급 방법 및 시기 등이 기록되어 있어야 한다.",
      "guideContext": "윤활유 품질관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-006",
      "text": "새로 구매되어 반입된 윤활유는 시료를 채취하고 분석하여 잘못된 제품의 공급을 막고, 사용한 윤활유를 분석함으로써 새로운 윤활유에서 얻어지는 결과를 기존 윤활유의 성질과 비교한다.",
      "guideContext": "윤활유 품질관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-007",
      "text": "윤활유 공급장치를 사용하여 기계적으로 저장탱크에서 일정량을 공급할 수 있는 설비를 갖추어야 한다.",
      "guideContext": "윤활유 품질관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-008",
      "text": "시료를 분석하는 실험실에서 요구하는 절차에 따라 시료를 채취한다.",
      "guideContext": "윤활유 시료채취",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-009",
      "text": "시료는 일반적으로 기계 작동온도에서 윤활유가 정체하지 않고 흐르는 부분에서 채취한다. 윤활펌프의 출구 또는 필터나 스트레이너의 전 부분에서 채취한다.",
      "guideContext": "윤활유 시료채취",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-010",
      "text": "시료는 청결한 용기에 채취한다.",
      "guideContext": "윤활유 시료채취",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-011",
      "text": "대상기계가 정상적으로 가동되는 동안이나 기계가 정지한 후 15분 내에 채취한다.",
      "guideContext": "윤활유 시료채취",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-012",
      "text": "시료채취는 항상 같은 방법으로 한다.",
      "guideContext": "윤활유 시료채취",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-013",
      "text": "기계의 성능을 최적화하고 사고를 예방하기 위한 윤활유 시료채취 일정을 만들어 시행한다.",
      "guideContext": "윤활유 시료채취 주기",
      "additionalDetail": "시료채취 주기는 공정상 중요도에 따라 빈도를 증가시키며 기계제작자의 지침을 참조한다.",
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-014",
      "text": "관련기계의 특성을 포함하여 각 부품, 기계이력, 제출된 모든 시료의 분석 결과가 컴퓨터 데이터베이스로 유지관리되도록 한다.",
      "guideContext": "윤활유 분석관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-015",
      "text": "한 기계에서 매 번의 시료가 자동적으로 경향관리로 해석될 수 있도록 프로그램 체계를 갖춘다.",
      "guideContext": "윤활유 분석관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-016",
      "text": "결과보고서와 결론은 각 시료와 이전의 모든 시료의 경향을 포함하여 작성되어져야 한다.",
      "guideContext": "윤활유 분석관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-017",
      "text": "샘플분석은 신속하고, 신뢰성 있고, 정확하게 이루어져야 하며, 만약 심각한 상태가 발견되면 즉시 책임자에게 통보한다.",
      "guideContext": "윤활유 분석관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-018",
      "text": "심각한 상태의 발생원인에 대한 적절한 이유를 포함하여 추가 조사가 필요한 위치와 취해야 할 대책을 명확히 제시한다.",
      "guideContext": "윤활유 분석관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-019",
      "text": "모든 해석 결과는 각 기계의 보수자료철에 기록유지한다.",
      "guideContext": "윤활유 분석관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-020",
      "text": "일반적으로 점도가 정상보다 10% 이상 변화되면 윤활유를 교환한다.",
      "guideContext": "윤활유 점도분석",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석 결과조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-021",
      "text": "높은 유동점을 가진 윤활유를 예비로 설치된 기계나 낮은 온도에서 사용할 때에는 저장탱크에 가열장치를 설치한다.",
      "guideContext": "유동점 관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 품질관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-022",
      "text": "하나의 설비에는 그 설비에 적합한 시험방법과 결과 해석법이 정립되어 있어야 한다.",
      "guideContext": "물오염 분석 (법령 근거 미확인)",
      "additionalDetail": "윤활유에 포함된 물 양의 미세한 변화를 측정하기 위한 시험방법 정립",
      "workProcessPhase": "윤활유 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-023",
      "text": "일반적으로 수분함량이 0.2 %보다 큰 경우에는 윤활유 교환 등 조치를 취하여야 한다.",
      "guideContext": "물오염 분석 (법령 근거 미확인)",
      "additionalDetail": "심한 응력을 받는 구름 베어링의 경우에는 0.01 %의 수분오염에도 수명이 절반으로 감소될 수 있다.",
      "workProcessPhase": "윤활유 분석 결과조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-024",
      "text": "윤활유에 산화와 질화가 측정되면 즉시 대책을 세워 조치하여야 한다.",
      "guideContext": "산화 및 질화 분석 (법령 근거 미확인)",
      "additionalDetail": "산화가 시작되면 윤활유의 막이 두꺼워지고 침전물과 부식성 물질이 생성된다.",
      "workProcessPhase": "윤활유 분석 결과조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.9",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-025",
      "text": "첨가제의 성분이 냉각제 오염으로 판정될 수 있으므로 시험결과는 새 윤활유의 성능자료와 비교하여야 한다.",
      "guideContext": "냉각제 오염 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-026",
      "text": "현장에서 사용되는 감각시험들은 매우 주관적이어서 잘못된 결과를 초래할 수 있음에 유의한다.",
      "guideContext": "시료윤활유의 현장시험",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.16",
      "basedOn": null
    },
    {
      "identifier": "CI-M114-027",
      "text": "기계이상의 초기단계 경고로써 미량원소의 비율이 증가되나, 고장 진행 중에는 대부분 커다란 입자들이 생성되므로 큰 입자에 미량원소가 가려져 스펙트럼 분석에서 검출되는 비율이 감소됨에 유의하여야 한다.",
      "guideContext": "스펙트럼 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.14",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M114-001",
      "term": "산가",
      "definition": "시료에 함유되어 있는 산성성분을 중화하는데 소요되는 염기의 수량으로서 시료 1g당 수산화칼륨의 소요량은 mg 단위로 표시한 수를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M114-002",
      "term": "염기가",
      "definition": "시료에 함유되어 있는 염기성분을 중화하는데 소요되는 산의 수량으로서 시료 1g당 염산의 소요량은 mg 단위로 표시한 수를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M114-003",
      "term": "점도지수",
      "definition": "온도에 따른 석유제품의 점도변화를 특정화하기 위하여 높은 점도지수는 작은 점도변화를, 낮은 점도지수는 큰 점도변화를 나타내는데 사용되는 일반적인 등급의 수를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M114-004",
      "term": "유동점",
      "definition": "시료를 45℃로 가열한 후 시료를 교반하지 않고 냉각했을 때 시료가 유동하는 최저온도이며 0℃를 기점으로 하여 2.5℃의 정수배로 표시한 수를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M114-01",
      "processOrder": 1,
      "processName": "윤활유 선정",
      "safetyMeasures": "윤활성과 열전달 성질, 세정작용, 반응성, 내산성, 물과의 친화성 및 분리성, 발포성, 내산화성, 열안정도를 고려하여 기계에 적합한 윤활유를 선정한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-M114-02",
      "processOrder": 2,
      "processName": "윤활유 품질관리",
      "safetyMeasures": "부적합한 윤활유 혼입 방지, 윤활유 종류 최소화, 저장탱크 투입구 및 보관 용기에 윤활유 이름 표시, 기계관리 대장에 윤활유 종류·공급 방법·시기 기록, 윤활유 공급장치로 일정량 공급 설비 구비",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-M114-03",
      "processOrder": 3,
      "processName": "시료채취",
      "safetyMeasures": "실험실 요구 절차에 따라 채취, 기계 작동온도에서 윤활유가 흐르는 부분(윤활펌프 출구 또는 필터·스트레이너 전)에서 채취, 청결한 용기 사용, 기계 가동 중 또는 정지 후 15분 내 채취, 항상 같은 방법으로 채취",
      "requiredPPE": [],
      "sourceSection": "7.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-M114-04",
