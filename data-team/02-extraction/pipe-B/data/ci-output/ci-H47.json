  "checklistItems": [
    {
      "identifier": "CI-H47-001",
      "text": "하루에 11시간 이상의 연장근로와 야간 근로는 최소한으로 하여야 한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-002",
      "text": "생리주기와 수면주기를 고려하고 졸음을 방지하기 위해서는 연속적인 야간근로가 4회를 넘지 않아야 한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-003",
      "text": "가능하면 근무시간 종료 후 11시간 이상의 휴식시간은 확보되어야 식사와 이동 시간을 제외하고 최소한 6시간의 수면시간을 확보할 수 있다.",
      "guideContext": "장시간 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-004",
      "text": "가능하면 최소한 1주일에 한 번 정도는 온전한 하루 즉 연속된 24시간을 쉴 수 있도록 일정을 짜야 한다.",
      "guideContext": "장시간 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-005",
      "text": "일주일 7일의 근무를 해야 하는 상황에서도 한 달에 두 번은 이틀을 충분히 쉴 수 있는 휴일을 제공한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-006",
      "text": "근무 중 적절한 휴식시간을 제공한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-007",
      "text": "정기적이며 예측할 수 있는 일정을 확보하는 것이 좋다.",
      "guideContext": "장시간 근로자 보건관리",
      "additionalDetail": "비정기적인 근무일정으로 수면부족과 피로가 발생하므로 가능한 비정기적인 근무일정은 피하는 것이 좋다.",
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-008",
      "text": "근무일정은 최소 1주일 전에는 알 수 있도록 하여야 하며, 근로자 본인의 동의를 구해야 가족생활과 다른 사회생활에 어려움을 최소화 할 수 있다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-009",
      "text": "사업주는 근로자의 1개월간 주당 평균 52시간 이상인 경우 근로자의 신청을 받아 보건관리자에 의한 면접지도를 실시하도록 하며 면접지도를 할 때에는 다음 사항을 고려한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면접지도",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-010",
      "text": "작업환경, 작업내용, 근로시간 등 피로와 스트레스 요인에 대하여 평가하고 근로시간단축, 장ㆍ단기순환작업 등 개선대책 필요성 검토",
      "guideContext": "면접지도 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면접지도",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-011",
      "text": "작업량과 작업일정 등에 대한 근로자의 의견 수렴",
      "guideContext": "면접지도 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면접지도",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-012",
      "text": "작업과 휴식의 배분 등 근로시간과 관련된 근로조건 검토",
      "guideContext": "면접지도 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면접지도",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-013",
      "text": "근로시간 이외의 근로자 활동에 대한 복지차원의 지원 필요성 검토",
      "guideContext": "면접지도 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면접지도",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-014",
      "text": "건강진단결과와 상담자료 등을 참고하여 적정하게 근로자를 배치하고 피로와 스트레스 요인, 건강문제 발생가능성 및 대비책 등에 대하여 당해 근로자에게 충분히 설명할 것",
      "guideContext": "면접지도 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면접지도",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-015",
      "text": "사업주는 면접지도결과, 필요하다고 인정되는 때에는 취업 장소의 변경, 작업의 전환, 근로시간의 단축, 야간 근무의 감소 등의 필요한 조치를 실시한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "면접지도 후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-016",
      "text": "사업주는 작업장에 적절한 휴식공간을 조성한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": "휴식시간에 간단한 음료를 마시고 앉아서 쉴 수 있는 편이시설이 있는 공간, 야간 근무 시에 사이잠을 잘 수 있는 가수면실을 포함한다.",
      "workProcessPhase": "휴식공간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-017",
      "text": "사업주는 야간 근무 시에 작업환경에 관심을 기울여 주의력 부족 등으로 인한 재해발생을 예방하도록 한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간 근무 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-018",
      "text": "부족한 조명이 있거나 소음이 있는 곳에서 근무하는 것은 피한다.",
      "guideContext": "야간 근무 작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간 근무 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-019",
      "text": "적절한 온도를 유지하도록 난방 및 냉방 장치가 필요하다.",
      "guideContext": "야간 근무 작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간 근무 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-020",
      "text": "근로자 1인 근무는 사고 위험이 증가하기 때문에 피하도록 한다.",
      "guideContext": "야간 근무 작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간 근무 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-021",
      "text": "유해물질 노출 작업을 하는 경우에는 12시간 근무를 피하도록 한다.",
      "guideContext": "야간 근무 작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간 근무 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-022",
      "text": "야간 근무 중 매점이나 따뜻한 음식과 음료를 제공해 주는 이용시설을 갖추도록 해야 한다.",
      "guideContext": "야간 근무 작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "야간 근무 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-023",
      "text": "보건관리자는 근로자의 근무시간을 관리하고, 근로자의 근무상황, 피로의 축적 정도, 그 밖의 정신 건강을 포함한 근로자의 건강 상태에 관하여 확인하고 근로자 본인에게 필요한 사항을 지도해야 한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리자 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-024",
      "text": "수면 위생에 대해 교육하고, 필요할 경우 의사에 의한 진료를 받도록 한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수면 위생 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-025",
      "text": "근로자의 1개월간의 근로시간을 파악하여 주당 평균 52시간을 초과하였고, 극심한 육체적 피로나 정신적 불안을 호소하는 경우, 수면장애를 호소하는 경우, 장시간 근로로 인해 심신의 피로가 있는 근로자가 의사의 진료를 원하는 경우에는 산업의학전문의에게 의뢰한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "산업의학전문의 의뢰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-026",
      "text": "상담지도에 관여하는 보건관리자는 근로자나 사업주로부터 얻은 정보에 대해 비밀을 지켜야 한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리자 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-027",
      "text": "장시간 근무로 인한 피로와 저하된 신체 능력의 회복을 위해 근로자는 6시간 이상의 수면을 취해야 한다.",
      "guideContext": "장시간 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-028",
      "text": "피로감이 심하게 느껴질 경우 휴식시간을 이용하여 낮잠을 자는 것이 좋다.",
      "guideContext": "장시간 근로자 보건관리",
      "additionalDetail": "15분 이내의 낮잠은 오히려 더 졸리게 만들게 되므로 낮잠은 가능하면 20분에서 30분 정도 취하는 것이 좋다.",
      "workProcessPhase": "개인 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-029",
      "text": "피로 회복과 스트레스 해소를 위해 카페인과 술을 섭취하는 것은 되도록 삼가도록 한다.",
      "guideContext": "장시간 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "개인 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H47-030",
      "text": "정기적이고 적절한 운동은 심혈관질환의 발병 위험을 낮추고, 피로로부터 쉽게 회복할 수 있도록 도움을 준다.",
      "guideContext": "장시간 근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "개인 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H47-001",
      "term": "법정기준근로시간",
      "definition": "근로기준법 제50조에 의해 주 단위 및 1일 단위로 정하여져 있는 기준근로시간을 말하며, 1주간의 근로시간은 휴게시간을 제외하고 40시간, 1일의 근로시간은 휴게시간을 제외하고 8시간을 초과할 수 없음을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H47-002",
      "term": "장시간 근로",
      "definition": "근로기준법 제50조와 근로기준법 제67조에서 정한 법정기준근로시간을 초과하는 근로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H47-01",
      "processOrder": 1,
      "processName": "근로시간 파악 및 관리",
