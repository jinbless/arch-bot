      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC29-008",
      "term": "유해·위험문구",
      "definition": "화학물질의 분류에 따라 유해·위험의 내용을 나타내는 문구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
