  "checklistItems": [
    {
      "identifier": "CI-AG20-001",
      "text": "발판재료는 작업할 때의 하중을 견딜 수 있도록 견고한 것으로 할 것",
      "guideContext": "그레이팅 설치 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제56조제1호",
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-002",
      "text": "작업발판의 폭은 40센티미터 이상으로 하고, 발판재료 간의 틈은 3센티미터 이하로 할 것",
      "guideContext": "그레이팅 설치 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제56조제2호",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-003",
      "text": "추락의 위험이 있는 장소에는 안전난간을 설치할 것",
      "guideContext": "그레이팅 설치 관련 법적 필수사항",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제56조제4호. 작업의 성질상 안전난간 설치가 곤란한 경우 추락방호망 설치 또는 안전대 착용 등 추락위험 방지 조치를 한 경우 예외",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-AG20-004",
      "text": "작업발판의 지지물은 하중에 의하여 파괴될 우려가 없는 것을 사용할 것",
      "guideContext": "그레이팅 설치 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제56조제5호",
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-005",
      "text": "사업주는 작업발판 및 통로의 끝이나 개구부로서 근로자가 추락할 위험이 있는 장소에는 안전난간, 울타리, 수직형 추락방지 또는 덮개 등의 방호 조치를 충분한 강도를 가진 구조로 튼튼하게 설치하여야 하며, 덮개를 설치하는 경우에는 뒤집히거나 떨어지지 않도록 설치하여야 한다",
      "guideContext": "그레이팅 설치 관련 법적 필수사항",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제43조제1항",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-CARGO-004",
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-006",
      "text": "어두운 장소에서도 알아볼 수 있도록 개구부임을 표시해야 하며, 수직형 추락방지망은 한국산업표준에서 정하는 성능기준에 적합한 것을 사용해야 한다",
      "guideContext": "그레이팅 설치 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제43조제1항 후단",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-007",
      "text": "사업주는 난간등을 설치하는 것이 매우 곤란하거나 작업의 필요상 임시로 난간등을 해체하여야 하는 경우 추락방호망을 설치하여야 한다",
      "guideContext": "그레이팅 설치 관련 법적 필수사항",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제43조제2항. 추락방호망 설치 곤란 시 안전대 착용 등 조치",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-008",
      "text": "추락방호망의 설치위치는 가능하면 작업면으로부터 가까운 지점에 설치하여야 하며, 작업면으로부터 망의 설치지점까지의 수직거리는 10미터를 초과하지 아니할 것",
      "guideContext": "그레이팅 설치 관련 법적 필수사항",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 제2항제1호",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-009",
      "text": "추락방호망은 수평으로 설치하고, 망의 처짐은 짧은 변 길이의 12퍼센트 이상이 되도록 할 것",
      "guideContext": "그레이팅 설치 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 제2항제2호",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-010",
      "text": "건축물 등의 바깥쪽으로 설치하는 경우 추락방호망의 내민 길이는 벽면으로부터 3미터 이상 되도록 할 것",
      "guideContext": "그레이팅 설치 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 제2항제3호",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-011",
      "text": "화학·정유 플랜트, 해양·습윤 환경 등 부식 요인이 큰 작업장은 스테인리스 또는 FRP 재질을 우선 적용하며, 탄소강 적용 시에는 반드시 방청처리를 실시한다",
      "guideContext": "그레이팅 재질 및 표면처리 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-012",
      "text": "탄소강 그레이팅은 용융아연도금(HDG)을 원칙으로 한다",
      "guideContext": "그레이팅 표면처리 기준",
      "additionalDetail": "필요 시 분체도장, 에폭시 코팅 등 추가 방청처리 가능",
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-013",
      "text": "스테인리스 또는 알루미늄 소재는 표면 산화피막 또는 부동태(Passivation) 처리를 실시한다",
      "guideContext": "그레이팅 표면처리 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-014",
      "text": "산·알칼리·용제 등과 직접 접촉될 가능성이 있는 구역은 내화학성 FRP 또는 SUS316 재질을 적용한다",
      "guideContext": "그레이팅 내화학성 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-015",
      "text": "인력이 이동하는 통로, 계단, 설비 접근구역, 고소 작업대 등 추락 또는 미끄럼 사고 위험이 있는 모든 구역에는 미끄럼방지 기능을 갖춘 그레이팅을 설치한다",
      "guideContext": "그레이팅 미끄럼방지 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-016",
      "text": "미끄럼 방지 기능 유지 목적을 위하여 정기적으로 진흙, 오염물, 기름, 분진 등을 제거하고 마모 상태를 점검한다",
      "guideContext": "그레이팅 미끄럼방지 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-017",
      "text": "강한 부식·고온·유증기 환경에서는 FRP 또는 SUS316을 우선 적용한다",
      "guideContext": "화학·정유 플랜트 적용 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-018",
      "text": "누액 가능성이 있는 지점은 미끄럼방지 기능을 강화한다",
      "guideContext": "화학·정유 플랜트 적용 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-019",
      "text": "화학물질 탱크 주변은 내화학성 및 미끄럼 지항성 시험 기준을 충족해야 한다",
      "guideContext": "화학·정유 플랜트 적용 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-020",
      "text": "임시 통로 또는 작업발판은 안전하중 및 활동 하중 기준을 충족해야 한다",
      "guideContext": "건설현장 및 일반 산업 설비 적용 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-021",
      "text": "지게차, 트럭 등 하중이 큰 장비가 통행하는 구역은 고강도 강재 또는 강화형 그레이팅을 사용한다",
      "guideContext": "중장비·차량 통행 구역 적용 기준",
      "additionalDetail": "차량 축하중을 포함한 구조설계를 수행해야 한다",
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-022",
      "text": "베어링 바(Bearing Bar)는 반드시 지지보(Support Beam)와 직각 방향으로 배치한다",
      "guideContext": "그레이팅 지지구조 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-023",
      "text": "지지보 간격(Span)은 제작사가 제시하는 허용간격(Allowable Span)을 초과할 수 없으며, 일반 작업 통로 기준 지지보 간격은 300~600 mm 범위로 한다",
      "guideContext": "그레이팅 지지구조 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-024",
      "text": "보행자 통행구역은 최소 1.5 kN 이상의 집중하중을 견딜 것",
      "guideContext": "그레이팅 집중하중 기준 (법령 근거 미확인)",
      "additionalDetail": "장비·차량 통행구역은 해당 장비의 축하중을 설계하중으로 적용",
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-025",
      "text": "그레이팅의 처짐기준(Deflection)은 설계하중에서 L/200 이하를 만족해야 한다",
      "guideContext": "그레이팅 처짐기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-026",
      "text": "클립 또는 볼트 체결 시 이탈·낙하가 없도록 최소 4점 체결을 원칙으로 한다",
      "guideContext": "그레이팅 체결 기준",
      "additionalDetail": "고정클립(Fixing Clip), 볼트-너트 체결 등 사용",
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-027",
      "text": "용접은 화재·폭발 위험평가 후 제한적으로 시행한다",
      "guideContext": "그레이팅 체결 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-028",
      "text": "그레이팅 및 지지구조는 인장, 전단, 휨모멘트 등 모든 하중 조건에서 허용응력 이하가 되도록 설계한다",
      "guideContext": "그레이팅 최소 구조 안전 성능 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-029",
      "text": "반복 하중이 예상되는 구역은 내구성·피로수명(Fatigue Life)을 검토한다",
      "guideContext": "그레이팅 최소 구조 안전 성능 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-030",
      "text": "부식·산화·탈락 등으로 인한 단면 감소가 확인되는 경우 즉시 교체 또는 보강한다",
      "guideContext": "그레이팅 부식·열화 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-031",
      "text": "최소 구조안전 기준을 만족하지 못할 경우 보강 플레이트, 보강보 추가, Clip 교체 등을 통해 즉시 보강 조치한다",
      "guideContext": "그레이팅 최소 구조 안전 성능 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-032",
      "text": "폭발위험장소에서는 FRP 또는 알루미늄과 같이 스파크 발생 위험이 낮은 재질을 우선 적용한다",
      "guideContext": "폭발위험장소 그레이팅 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-AG20-033",
      "text": "도전성(Conductive) 소재 FRP 또는 정전기 방지 기능을 갖춘 재질을 적용하며 접지(Grounding)를 실시한다",
      "guideContext": "폭발위험장소 그레이팅 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-AG20-034",
      "text": "체결부인 볼트·너트·클립은 방폭 등급에 적합한 재질(스테인리스 또는 황동 등)을 사용한다",
      "guideContext": "폭발위험장소 그레이팅 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-AG20-035",
      "text": "장비·배관 주변 설치 시 정전기·충격·부식에 의한 파손 위험이 있으므로 주기적 점검 및 추가 고정 조치를 수행한다",
      "guideContext": "폭발위험장소 그레이팅 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-AG20-036",
      "text": "산·알칼리·유기용제 등과 접촉 가능성이 있는 설비 주변은 내화학성 소재인 FRP 또는 SUS316 재질을 우선 적용한다",
      "guideContext": "화학공장 특수 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-037",
      "text": "화학물질 누액 시 미끄럼 및 부식이 동시에 발생할 수 있으므로 미끄럼방지 타입과 방청처리를 반드시 적용한다",
      "guideContext": "화학공장 특수 설치 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-038",
      "text": "화학공정 구역은 일반 구역보다 짧은 점검주기를 적용하며, 그레이팅 변형·부식·체결 상태를 매월 이상 확인하는 등 점검주기를 강화한다",
      "guideContext": "화학공장 특수 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-039",
      "text": "배관·밸브·펌프처럼 진동이 큰 장비 주변은 체결 클립 강화형 또는 볼트 체결을 적용한다",
      "guideContext": "화학공장 특수 설치 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-040",
      "text": "물질 흐름을 허용하며 근로자가 걸을 수 있는 그레이팅은 정사각형 형태의 격자 간격이 60 mm × 60 mm을 넘지 않도록, 직사각형 형태의 격자 간격이 120 mm × 40 mm을 넘지 않도록 조성되어야 한다",
      "guideContext": "그레이팅 격자 간격 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-041",
      "text": "작업 플랫폼 및 그 접근로에 설치되는 그레이팅의 격자 간격은 34 mm × 51 mm를 초과해서는 안 된다",
      "guideContext": "그레이팅 격자 간격 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-042",
      "text": "최대 허용 가능한 탄성 휨처짐은 지지 간격의 1/200 까지 허용되며, 나사 고정된 영역에도 해당된다",
      "guideContext": "그레이팅 처짐 한계 기준",
      "additionalDetail": "그레이팅의 구성 요소들은 접합 부위에서 인접한 바닥재와의 높이 차가 4 mm를 초과하지 않아야 한다",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-043",
      "text": "운영 중에는 걷기 가능한 표면의 미끄러짐 방지 특성을 유지하거나 특별한 청소 조치로 보장해야 한다",
      "guideContext": "그레이팅 미끄러짐 방지 유지",
      "additionalDetail": "마찰에 의한 미끄러짐 방지 변화가 가능하며, 이로 인해 그레이팅 교체가 필요할 수 있다",
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-044",
      "text": "그레이팅의 대규모 배치는 미리 설정한 설치 계획에 따라 이루어져야 한다",
      "guideContext": "그레이팅 설치 계획 (법령 근거 미확인)",
      "additionalDetail": "그레이팅 배치에 대한 전문가가 회사에 없는 사업주는 제조업체나 공급업체에게 설치 계획을 제작하도록 요청",
      "workProcessPhase": "설치 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-045",
      "text": "설치 계획에서는 보강방향이 명시되어야 한다",
      "guideContext": "그레이팅 설치 계획 (법령 근거 미확인)",
      "additionalDetail": "정사각형 개별 그레이팅은 설치 시 보강방향을 혼동하지 않기 위해 피하는 것이 좋다",
      "workProcessPhase": "설치 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-046",
      "text": "그레이팅에 기반을 둔 계획된 지지 길이는 최소 30 mm 이상이어야 한다",
      "guideContext": "그레이팅 지지 기준 (법령 근거 미확인)",
      "additionalDetail": "운영 중에는 지지 길이가 25 mm 미만으로 줄어들어서는 안 된다",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-047",
      "text": "인접한 그레이팅 간의 설치 간격 a는 4 mm여야 한다",
      "guideContext": "그레이팅 설치 간격 기준",
      "additionalDetail": "가장자리 강화나 이동 방지장치로 인해 더 큰 설치 간격을 피할 수 없는 경우에는 운용 상태에서도 a < 20 mm임이 보장되어야 한다",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-048",
      "text": "작업 플랫폼이나 걷는 통로의 바닥재로서 그레이팅이 사용되는 경우, 이 그레이팅은 지름 35 mm의 구체가 통과하지 못할 정도의 개구를 가져야 한다",
      "guideContext": "떨어지는 물체로부터의 보호",
      "additionalDetail": "아래에 작업 공간이 있는 바닥재는 지름 20 mm의 구체가 통과하지 못할 정도의 개구를 최대한 가질 수 있다",
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-049",
      "text": "금속 그레이팅와 구조물 간의 거리가 30 mm를 초과하는 경우 발관은 필요하다",
      "guideContext": "떨어지는 물체로부터의 보호 (법령 근거 미확인)",
      "additionalDetail": "그레이팅의 가장자리나 잘린 부분 가장자리와 인접한 구조물 사이 간격 기준",
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-050",
      "text": "그레이팅은 각각 최소한 네 개의 모서리 지점에서 형태학적으로 고정되어야 하며, 이로써 이동 방향에서의 이동 및 들어 올림을 방지한다",
      "guideContext": "그레이팅 고정 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-051",
      "text": "추락위험이나 빠져들어가는 위험이 있는 지역에서 고정장치는 나사 풀림에도 격자가 지지대에서 미끄러지지 않도록 하는 방식으로 되어야 한다",
      "guideContext": "그레이팅 고정 기준",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-052",
      "text": "추락 위험이 있는 영역에서는 로스트의 고정 장치를 효과적으로 검토해야 한다",
      "guideContext": "그레이팅 고정 점검",
      "additionalDetail": "검사를 수행하는 기한은 운영 조건에 따라 결정되며, 진동이 발생하는 경우 등이 해당",
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-053",
      "text": "고정 부품의 재질은 로스트의 재질과 조화되어야 한다",
      "guideContext": "그레이팅 고정 기준",
      "additionalDetail": "다른 금속 조합의 경우 이온 이동이 발생하여 부식이 촉진될 수 있다",
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-054",
      "text": "그레이팅 구조의 환풍구 덮개 및 지지 구조는 건축구조기준(KDS)에 따른 등분포활하중 5.0 kN/㎡ 이상을 적용하여 구조적 안전성을 확보해야 한다",
      "guideContext": "환풍구 덮개 붕괴 방지",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-055",
      "text": "진동이나 외력에 의해 지지구조물로부터 이탈하지 않도록 전용 클립, 볼트 체결 또는 용접 등의 방법으로 견고하게 고정하여야 한다",
      "guideContext": "환풍구 덮개 붕괴 방지",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 고정",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-056",
      "text": "다수 인원이 그레이팅 구조의 환풍구에 올라서지 못하도록 2 m 이상 높게 설치하거나, 주변에 높이 1.2 m 이상 출입 차단 울타리를 설치하고, 야간에도 식별 가능한 추락 위험 경고 표지판을 부착하여야 한다",
      "guideContext": "환풍구 덮개 추락 방지",
      "additionalDetail": null,
      "workProcessPhase": "그레이팅 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10",
      "basedOn": [
        "SR-CARGO-004",
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-AG20-057",
      "text": "후속적인 변경 작업 시에는 그레이팅의 제조업체를 참여시킬 것",
      "guideContext": "그레이팅 변경 시 위험성 관리",
      "additionalDetail": "사후 변경은 종종 충분한 전문 지식 없이 이루어지며, 견고성 상실로 심각한 추락 사고를 유발할 수 있다",
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-058",
      "text": "부식 위험 지역에서는 부식 요소에 따라 고정 장치를 선택하고 금속 그리드의 안전한 걷기 가능성을 평가하며 지지대와 고정 장치를 점검하고 필요한 경우 교체해야 한다",
      "guideContext": "금속 그레이팅 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-059",
      "text": "검사를 수행하는 주기는 제조업자의 규정과 업무 경험을 고려하여 위험 평가 결과에 따라 결정된다",
      "guideContext": "그레이팅 주기적 점검",
      "additionalDetail": "영향 요인으로는 진동, 동적 하중, 온도, 화학 또는 기계적 하중, 날씨 등이 있다",
      "workProcessPhase": "유지보수 및 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-AG20-060",
      "text": "의심스러운 손상 및 결함은 전문 업체 또는 제조업자에 의해 판단되어야 한다",
