  "domainTerms": [
    {
      "identifier": "DT-AG20-001",
      "term": "그레이팅 (Grating)",
      "definition": "옥외 배수구 덮개 등에 쓰이는 격자 모양의 철재 구조물이며, 차량 등의 하중에도 견딜 수 있는 안정성을 가지고 있어야 하며 최근에는 플랜트 분야에도 널리 활용되고 있으며 용도에 따라 비교적 큰 하중에도 견딜 수 있는 강도 구조를 요구한다",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG20-002",
      "term": "베이링 바 (Bearing Bar)",
      "definition": "강철 스트립, 슬릿 시트, 압연 또는 압출 알루미늄으로 만들어지고 그레이팅 간격으로 확장하며 굽힘 하중을 지지하는 막대를 말한다",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG20-003",
      "term": "크로스 바 (Cross Bar)",
      "definition": "강철 스트립, 슬릿 시트, 압연막대 또는 압출 알루미늄으로 만든 연결 막대를 말하며 일반적으로 베어링 바에 수직으로 연결한다",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-AG20-01",
      "processOrder": 1,
      "processName": "그레이팅 재질 선정 및 규격 결정",
      "safetyMeasures": "설치 환경, 부식 가능성, 기계적 하중, 화학물질 노출 여부를 종합적으로 고려하여 적절한 재질을 선정한다. 폭발위험장소는 FRP 또는 알루미늄, 화학공장은 내화학성 FRP 또는 SUS316을 우선 적용한다. 보행자 통행구역은 최소 1.5 kN 이상의 집중하중을 견딜 수 있어야 하며 처짐기준은 L/200 이하를 만족해야 한다.",
      "requiredPPE": null,
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-AG20-02",
      "processOrder": 2,
      "processName": "설치 계획 수립",
      "safetyMeasures": "그레이팅의 대규모 배치는 미리 설정한 설치 계획에 따라 이루어져야 한다. 설치 계획에서는 보강방향이 명시되어야 한다. 전문가가 회사에 없는 사업주는 제조업체나 공급업체에게 설치 계획을 제작하도록 요청해야 한다.",
      "requiredPPE": null,
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-AG20-03",
      "processOrder": 3,
      "processName": "그레이팅 설치",
      "safetyMeasures": "지지 길이는 최소 30 mm 이상이어야 하며, 운영 중 25 mm 미만으로 줄어들어서는 안 된다. 인접 그레이팅 간 설치 간격은 4 mm여야 한다. 베어링 바는 반드시 지지보와 직각 방향으로 배치한다. 추락 위험이 있는 장소에는 안전난간을 설치할 것.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "8",
      "relatedSR": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "WP-AG20-04",
      "processOrder": 4,
      "processName": "그레이팅 고정 및 체결",
      "safetyMeasures": "최소 4개 모서리 지점에서 고정하여 이동 및 들어 올림을 방지한다. 추락위험 지역에서는 나사 풀림에도 격자가 미끄러지지 않도록 고정한다. 고정 부품의 재질은 그레이팅 재질과 조화되어야 한다. 폭발위험장소에서는 방폭 등급에 적합한 재질을 사용한다.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "9",
      "relatedSR": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "WP-AG20-05",
      "processOrder": 5,
      "processName": "유지보수 및 정기 점검",
      "safetyMeasures": "부식 위험 지역에서는 부식 요소에 따라 고정 장치를 선택하고 지지대와 고정 장치를 점검하고 필요 시 교체한다. 점검 주기는 제조업자의 규정과 위험 평가 결과에 따라 결정한다. 화학공정 구역은 매월 이상 점검한다. 손상 및 결함은 전문 업체 또는 제조업자에 의해 판단한다.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "11",
      "relatedSR": null
    }
  ],
