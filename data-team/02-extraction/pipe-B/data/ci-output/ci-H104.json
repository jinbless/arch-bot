  "checklistItems": [
    {
      "identifier": "CI-H104-001",
      "text": "모든 작업공정에 대한 표준작업지침서를 작성하고 이를 준수하도록 관리 감독해야 한다.",
      "guideContext": "세탁업 작업관리 (법령 근거 미확인)",
      "additionalDetail": "표준작업관리지침은 유해물질 발생 억제조치 설비의 설치, 환기장치의 적절한 가동요령, 보호구의 착용방법 및 관리방법, MSDS를 활용한 유해성 정보와 응급조치 등에 관한 사항을 포함한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-002",
      "text": "표준작업으로부터 벗어나는 상황은 원인 파악과 대책이 수립된 이후에 다시 작업을 시작한다.",
      "guideContext": "세탁업 작업관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-003",
      "text": "세탁소의 특성상 각종 기계, 유해물질 및 세탁물 등이 주변에 널려 있으므로 일정 폭 이상의 안전한 작업장 통로를 개설해 놓아야 한다.",
      "guideContext": "세탁소 작업장 정리정돈 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-004",
      "text": "작업장 바닥에 기름이나 물이 있거나, 전선 등에 걸려서 넘어지지 않게 청소와 주변 정리를 하도록 한다.",
      "guideContext": "세탁소 작업장 정리정돈",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-005",
      "text": "소화기를 비치하도록 한다.",
      "guideContext": "세탁소 작업장 정리정돈",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-006",
      "text": "세탁기(드라이클리닝기)를 접지하도록 한다.",
      "guideContext": "세탁소 작업장 정리정돈",
      "additionalDetail": "드라이클리닝에 사용하는 인화성 세탁용제의 정전기에 의한 화재·폭발 방지를 위한 접지 조치",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-H104-007",
      "text": "한 번에 많은 세탁물을 인력으로 운반하려고 하지 않는다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": "세탁물 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-008",
      "text": "세탁물 투입구 높이는 작업자의 허리에서 어깨사이의 높이가 좋다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": "본세",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-009",
      "text": "작업대가 높으면 발받침을 사용하거나 작업대를 낮춰야 한다.",
      "guideContext": "근골격계 질환 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "다림질",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-010",
      "text": "어깨를 들고 작업하지 않도록 다림질대를 낮추거나 작업발판을 사용한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": "다림질",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-011",
      "text": "허리를 구부리고 작업하지 않도록 다림질대를 높인다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": "다림질",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-012",
      "text": "장시간 허리를 구부리지 않고 작업하도록, 보조도구나 작업자세를 바꾼다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-013",
      "text": "한 자세로 오랫동안 유지하지 않고 수시로 근육을 풀어준다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-014",
      "text": "작업 중 틈틈이 짧은 휴식을 갖고, 스트레칭을 한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-015",
      "text": "세탁물을 걸 경우 걸이대를 제공한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": "점검 및 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-016",
      "text": "손목에 자주 큰 힘이 가해지면 보호대를 착용한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-017",
      "text": "허리 충격을 완화할 수 있는 신발을 착용한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-018",
      "text": "도구나 세탁 시설의 예방적인 보수 유지를 하여 항상 도구나 시설에 문제가 없게 한다.",
      "guideContext": "근골격계 질환 예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-019",
      "text": "유해물질에 대한 정보 및 노출되었을 때 대처하는 방법이 포함되어 있는 물질안전보건자료를 쉽게 볼 수 있는 위치에 비치한다.",
      "guideContext": "취급물질 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-020",
      "text": "새로운 유해물질을 사용하거나 물질안전보건자료가 소실되었을 때 즉시 새롭게 보충한다.",
      "guideContext": "취급물질 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-021",
      "text": "유해물질 취급 작업자를 대상으로 물질안전보건자료에 대한 교육을 정기적으로 실시하여야 한다.",
      "guideContext": "취급물질 관리 (법령 근거 미확인)",
      "additionalDetail": "자영업자는 스스로 학습하도록 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-022",
      "text": "유해물질을 담고 있는 용기에 유해물질의 이름, 사용상 유의점, 유해성을 기술한 경고표지 등을 적어 놓은 경고표지를 부착한다.",
      "guideContext": "유해물질 용기 경고표지 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-023",
      "text": "경고표시가 떨어졌을 때는 즉시 새롭게 보충한다.",
      "guideContext": "유해물질 용기 경고표지 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-024",
      "text": "덜어 쓰는 중간 용기에도 화학물질명을 기술하고 경고표지를 부착하도록 한다.",
      "guideContext": "유해물질 용기 경고표지 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-025",
      "text": "화학물질은 지정된 저장소를 확보하고, 저장소는 화재와 폭발의 위험이 있으므로 작업장과 격리시켜야 한다.",
      "guideContext": "화학물질 보관 및 폐기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-026",
      "text": "사용 후 빈 용기는 폐기하거나 지정된 옥외에 보관하고, 보관용기 및 보관장소에 경고표지를 부착한다.",
      "guideContext": "화학물질 보관 및 폐기",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-027",
      "text": "세탁용제의 폐기물은 단단히 밀폐된 용기에 보관하도록 한다.",
      "guideContext": "화학물질 보관 및 폐기",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-028",
      "text": "드라이크리닝 중에는 기계의 문을 열지 말고, 가능한 한 기계의 문을 닫아 둔다.",
      "guideContext": "노출평가와 주요 노출원 관리",
      "additionalDetail": null,
      "workProcessPhase": "본세",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-029",
      "text": "드라이클리닝이 끝나기 전에 옷을 기계에서 빼내는 등 건조 과정을 단축하지 않도록 한다.",
      "guideContext": "노출평가와 주요 노출원 관리",
      "additionalDetail": null,
      "workProcessPhase": "건조",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-030",
      "text": "드라이클리닝기와 부분 얼룩제거 작업은 그 외 일반 작업과는 격리하도록 한다.",
      "guideContext": "작업환경 격리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-031",
      "text": "세탁소에서 사용하는 화학물질과 폐기물은 격리된 장소에 보관하도록 한다.",
      "guideContext": "작업환경 격리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-032",
      "text": "유해물질을 취급하는 공정에 대해 기중 오염물질의 감소를 위해 국소배기장치를 설치하여야 한다.",
      "guideContext": "환기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-033",
      "text": "작업을 수행할 때 국소배기장치의 제어풍속이 규정속도 이상으로 가동되고 있는지 확인하여야 하며 제어풍속의 규정 속도는 산업안전보건기준에 관한 규칙 [별표 13] 관리대상 유해물질 관련 국소배기장치 후드의 제어풍속(제429조 관련)에 준한다.",
      "guideContext": "환기 관리 (법령 근거 미확인)",
      "additionalDetail": "가스 상태 포위식 포위형 0.4m/sec, 외부식 측방흡인형 0.5m/sec, 외부식 하방흡인형 0.5m/sec, 외부식 상방흡인형 1.0m/sec",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-034",
      "text": "작업 중 국소배기장치가 정상적 가동이 되는지 확인하기 위해 주기적으로 자체검사를 실시하여야 한다.",
      "guideContext": "환기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-035",
      "text": "작업특성상 국소배기장치의 설치가 곤란하여 전체 환기장치를 설치하여야 할 경우에는 필요 환기량(작업장 환기횟수 : 15~20회/시간)을 충족시킬 것",
      "guideContext": "환기 관리 (법령 근거 미확인)",
      "additionalDetail": "유입공기가 오염장소를 통과하되 작업자 쪽으로 오지 않도록 위치를 선정하고, 청정공기를 공급하며, 배출된 공기가 재유입 되지 않도록 배출구 위치를 선정한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-036",
      "text": "드라이클리닝과정에서 발생하는 유해물질의 노출을 줄이기 위해서 솔벤트 회수기를 설치하도록 한다.",
      "guideContext": "작업환경관리",
      "additionalDetail": "솔벤트 회수기는 건조기에서 세탁용제가 대기중으로 기화되어 날아가는 것을 회수하여 다시 새 용제로 재활용 할 수 있게 해주는 장치이다.",
      "workProcessPhase": "건조",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-037",
      "text": "세탁소에서 사용하는 유해물질 흡입을 방지하기 위하여 양질의 보호구를 준비하고 작업 중에 착용하도록 한다.",
      "guideContext": "보호구 관리",
      "additionalDetail": "세탁작업에 필요한 보호구는 작업복, 호흡용 보호구, 보호장갑, 보호 장화 및 보호 앞치마 등이다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-038",
      "text": "세탁기의 개폐와 세탁기의 청소 및 수리와 같은 유해물질노출의 증가가 예상되는 비상시 작업에는 반드시 호흡보호구와 보호장갑을 착용한다.",
      "guideContext": "보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본세",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-039",
      "text": "보호구를 구입할 때 성능한계성, 검정합격품 여부 등을 사전에 검토하여 구입한다.",
      "guideContext": "보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-040",
      "text": "보호구는 작업장의 유해물질에 오염되는 것을 방지하고 청결한 상태를 유지하기 위해 적절한 보관함을 마련하도록 한다.",
      "guideContext": "보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-041",
      "text": "호흡용 보호구의 사용한도시간(파과시간)이 지나면 정화통을 교체해야 한다.",
      "guideContext": "보호구 관리 (법령 근거 미확인)",
      "additionalDetail": "냄새나 맛을 느낄 수 있는 유해물질의 경우 보호구를 착용한 상태에서 냄새나 맛을 감지할 수 있으면 교체하고, 처음 착용시보다 많은 호흡저항이 느껴질 때 교체한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-042",
      "text": "피부에 흡수 가능성이 높은 산, 알칼리 및 유기용제를 취급하는 경우에는 눈, 안면 그리고 피부보호구를 착용해야 한다.",
      "guideContext": "보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-043",
      "text": "유해요인이나 작업부담요인에 대한 산업안전보건교육을 실시하도록 한다.",
      "guideContext": "안전보건교육",
      "additionalDetail": "교육 내용: 대상화학물질의 명칭, 물리적 위험성 및 건강 유해성, 취급상의 주의 사항, 적절한 보호구, 응급조치 요령 및 사고시 대처방법",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-044",
      "text": "일반건강진단, 특수건강진단 외에 반드시 배치전 건강검진을 실시한다.",
      "guideContext": "건강진단 (법령 근거 미확인)",
      "additionalDetail": "사용하는 유해물질에 대해 6개월에 1회 이상 특수건강진단을 받도록 하고 새롭게 배치 받는 근로자에 대해서 반드시 배치전 건강검진을 받도록 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-045",
      "text": "특수건강진단 대상물질을 취급하는 근로자에 대해서는 특수건강진단을 실시하고 사후관리를 실시한다.",
      "guideContext": "건강진단",
      "additionalDetail": "각 유해인자별로 산업안전보건법 시행규칙 별표 13에서 정한 검사항목이 누락되지 않도록 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-046",
      "text": "유해물질을 취급하는 세탁소 내에서는 음식물을 먹거나 흡연을 하지 않는다.",
      "guideContext": "개인위생 준수",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-047",
      "text": "세탁작업 후 식사를 하는 경우에는 손이나 얼굴을 깨끗이 씻고, 별도의 장소에서 식사한다.",
      "guideContext": "개인위생 준수",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-048",
      "text": "작업을 종료한 경우에는 샤워시설 등을 이용하여 손, 얼굴 등을 씻거나 목욕을 한다.",
      "guideContext": "개인위생 준수",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-049",
      "text": "작업을 종료하면 작업복을 벗고 평상복으로 갈아입는다.",
      "guideContext": "개인위생 준수",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-050",
      "text": "오염된 피부를 세척하는 경우에는 피부에 영향을 주지 않는 비누 등을 사용한다.",
      "guideContext": "개인위생 준수",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-051",
      "text": "병원이나 보육시설 또는 사회복지시설의 세탁물 등과 같이 특수한 세탁물인 경우에는 A형 간염, 이질, 장티프스 등과 같은 여러 가지 생물학적 유해인자에 노출될 가능성이 있는 작업시에 개인보호구(보호의, 장갑 등)를 착용하여야 한다.",
      "guideContext": "기타 의학적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H104-052",
      "text": "세탁소의 노출평가는 세탁업무량이 많지 않고, 출입문 및 창문 등이 개방된 상태로 작업이 이루어지는 7~9월 사이와 세탁량이 많고 출입문과 창문을 닫고 작업하는 2~4월경에 노출평가를 하도록 한다.",
      "guideContext": "노출평가",
      "additionalDetail": "노출평가는 세탁기 가동 중에 배기구위치, 세탁물 투입구 위치에서 측정한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H104-001",
      "term": "세탁업",
      "definition": "세탁물을 수거하여 세탁을 하는 것으로 자영업과 공장형으로 나눌 수 있다. 자영업은 세탁소 소유자가 직접 세탁소를 운영하고, 공장형은 사업주가 다수의 근로자를 고용하여 소비자가 직접 의뢰하는 세탁물뿐만 아니라 여러 곳에서 다량의 세탁물을 수거하여 세탁을 하는 형태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H104-002",
      "term": "전처리",
      "definition": "세탁물을 세탁기에 넣기 전에 제거하기 어려운 오점이나 심한 오염부분에 전처리용 화학물질을 묻힌 솔로 두드리거나 가볍게 문질러 넣으로써 본세 할 때의 부담을 적게 하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H104-003",
      "term": "본세",
      "definition": "전처리가 끝난 세탁물을 세탁기에 넣고 세탁용제를 사용하여 세척하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H104-004",
      "term": "탈액",
      "definition": "세척 후 세탁물에 묻어 있는 세탁용제를 제거하기 위해 원심분리하는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H104-005",
      "term": "프레스기",
      "definition": "세탁된 넓은 포나 천 같은 것을 압착하여 다리는데 사용하는 기기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H104-006",
      "term": "석유계 솔벤트",
      "definition": "산업안전보건법에 규정되어 있는 스토다드 용제에 해당하는 탄화수소 성분을 가지고 있는 세탁용제를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H104-007",
      "term": "파과시간",
      "definition": "방독마스크의 정화통이 포화되어 흡수능력을 상실하는 데까지 걸리는 시간을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H104-01",
      "processOrder": 1,
      "processName": "세탁물 접수 및 분류",
      "safetyMeasures": "세탁물을 의뢰받아 섬유 종류, 오염 정도에 따라 분류한다. 특수한 세탁물(병원, 보육시설 등)인 경우 생물학적 유해인자 노출 가능성이 있으므로 개인보호구(보호의, 장갑 등)를 착용한다.",
      "requiredPPE": [
        "작업복",
        "보호장갑"
      ],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H104-02",
      "processOrder": 2,
      "processName": "전처리",
      "safetyMeasures": "제거하기 어려운 오점이나 심한 오염부분에 전처리용 화학물질을 묻힌 솔로 두드리거나 가볍게 문질러 넣는 작업으로, 유기용제에 직접 노출되므로 호흡보호구와 보호장갑을 착용하고 국소배기장치를 가동한다. 부분 얼룩제거 작업은 일반 작업과 격리하도록 한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "보호장갑",
        "보호 앞치마",
        "피부보호구"
      ],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H104-03",
      "processOrder": 3,
      "processName": "본세(드라이클리닝기 가동)",
      "safetyMeasures": "세탁물을 세탁기에 넣고 세탁용제를 사용하여 세척하는 과정으로, 1차 급유, 1차 세탁, 배유, 2차 급유, 2차 세탁, 배유, 탈유의 과정을 거친다. 드라이크리닝 중에는 기계의 문을 열지 말고 닫아 두며, 세탁기 투입구가 완전히 밀폐되지 않을 경우 증기가 새어 나올 수 있으므로 국소배기장치를 가동한다. 세탁기를 접지한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "보호장갑"
      ],
      "sourceSection": "4.2",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-H104-04",
      "processOrder": 4,
      "processName": "탈액",
      "safetyMeasures": "세척 후 세탁물에 묻어 있는 세탁용제를 제거하기 위해 원심분리하는 과정으로, 고속회전 기계 사용 시 안전장치를 확인한다. 드라이클리닝이 끝나기 전에 옷을 기계에서 빼내는 등 건조 과정을 단축하지 않도록 한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "보호장갑"
      ],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H104-05",
      "processOrder": 5,
      "processName": "건조",
      "safetyMeasures": "건조기에서 세탁용제가 대기중으로 기화되어 날아가므로 솔벤트 회수기를 설치하여 유해물질 노출을 줄인다. 건조기에 의한 화상에 주의한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "보호장갑"
      ],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H104-06",
      "processOrder": 6,
      "processName": "다림질(프레스)",
      "safetyMeasures": "프레스기에 직접 접촉하거나 스팀에 접촉하여 화상이 발생할 수 있으므로 주의한다. 프레스기의 작동을 발로 밟는 경우 손이 프레스기에 눌리거나 접촉하게 되어 화상이나 압궤손상을 당할 수 있다. 어깨를 들고 작업하지 않도록 다림질대를 조절하고, 반복 작업에 의한 근골격계 질환 예방을 위해 틈틈이 휴식과 스트레칭을 한다.",
      "requiredPPE": [
        "보호장갑",
        "작업복"
      ],
      "sourceSection": "4.2",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "WP-H104-07",
      "processOrder": 7,
      "processName": "점검 및 배송",
      "safetyMeasures": "세탁물을 점검하여 의뢰자에게 배송한다. 옷걸이(행거)가 천정에 부착되어 있어 팔을 어깨 위로 올리는 자세가 많으므로 걸이대를 제공하여 근골격계 부담을 줄인다. 한 번에 많은 세탁물을 인력으로 운반하지 않는다.",
      "requiredPPE": [
        "작업복"
      ],
      "sourceSection": "4.2",
      "relatedSR": null
    }
  ],
