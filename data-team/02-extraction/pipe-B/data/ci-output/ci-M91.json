  "checklistItems": [
    {
      "identifier": "CI-M91-001",
      "text": "타워크레인을 벽체 지지·고정할 때는 설계검사 서류 또는 제조사의 설치작업 설명서 등에 따라 설치하며, 계산의 예시는 <붙임 1>과 같다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M91-002",
      "text": "건물의 높이 등 설치여건의 변화가 생길 경우에는 구조전문가의 확인을 받아 설치한다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M91-003",
      "text": "벽체 지지·고정시 H-빔 등으로 임의 제작 사용하여서는 아니되며 반드시 전용 프레임을 사용하고, 벽체 지지대는 벽체와의 간격 조절이 가능한 구조로 제작·설치한다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-004",
      "text": "전용프레임 및 벽체 지지대의 용접 및 가공은 적정한지 점검한다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-M91-005",
      "text": "설치상태에서 벽체 지지점의 위치가 적정한지 점검한다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-M91-006",
      "text": "건물구조의 콘크리트 슬라브 또는 철골구조 등의 강도는 충분한지 확인한다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M91-007",
      "text": "콘크리트 구조물에 고정시키는 경우에는 매립이나 관통 또는 이와 동등 이상의 방법으로 충분히 지지되도록 한다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-008",
      "text": "전용프레임 및 지지대의 설치 상태는 수평 및 수직도가 유지되고 있는지, 조립볼트, 핀 등의 이완은 없는지 <붙임 2>의 타워크레인 붕괴사고 예방점검표에 따라 점검한다.",
      "guideContext": "타워크레인 벽체 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "벽체 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-M91-009",
      "text": "타워크레인을 와이어로프로 지지·고정할 때는 설계검사 서류 또는 제조사의 설치작업 설명서 등에 따라 설치한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M91-010",
      "text": "건물의 높이 등 설치여건의 변화가 생길 경우에는 구조전문가의 확인을 받아 설치한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M91-011",
      "text": "와이어로프 지지·고정 시에는 반드시 전용프레임을 사용하여 균등하게 하중을 걸어야 하며 프레임이 흘러내리지 않도록 지지장치를 고정시킨다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-012",
      "text": "지지 와이어로프의 안전율은 4 이상인지 여부를 확인한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-013",
      "text": "마스트와 와이어로프의 고정각도는 30∼60°이내로 설치하는 것이 바람직하며, 가장 이상적인 각도는 45°이다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-014",
      "text": "와이어로프 지지·고정시 턴버클 또는 긴장장치(Tensioning device), 클립, 샤클 등은 한국산업규격(KS) 이상의 규격품을 사용하고 설치된 긴장장치, 클립 등이 이완되지 않도록 한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-015",
      "text": "긴장장치의 아이(Eye) 부분은 와이어로프의 인장력에 충분한 강도를 가진 기초고정 블록(Deadman)에 고정한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-016",
      "text": "이중구조(2단)의 와이어로프 지지·고정은 마스트가 수직 변형 또는 S자 형태로 휘어질 수 있는데 이 경우에는 매우 위험한 상태이므로 사용을 중지하고 구조 검토 등의 조치를 취한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-M91-017",
      "text": "와이어로프를 마스트에 직접 감아서 샤클로 채워주는 형태의 지지·고정이 되지 않도록 현장 관계자는 철저히 관리 감독하여야 한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-M91-018",
      "text": "지지·고정 후에 와이어로프의 이상유무, 긴장장치와 클립의 체결상태 등을 매일 확인하고, 쌍방향으로 지지된 와이어로프의 긴장상태(Tension)가 일정하게 유지되는지 점검한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 설치",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-M91-019",
      "text": "늘어난 와이어로프는 타워크레인의 수직도 변형을 유발시킬 수 있을 뿐만 아니라 마스트에 비정상적인 변형 및 하중 부담을 줄 수 있어 타워크레인의 전도 사고를 일으킬 수 있으므로 유의하여야 한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-020",
      "text": "와이어로프 지지·고정은 유지관리가 중요하므로 정기적으로 <붙임 2>의 타워크레인 붕괴사고예방 점검표에 따라 점검한다.",
      "guideContext": "타워크레인 와이어로프 지지·고정 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 지지·고정 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "CI-M91-021",
      "text": "타워크레인의 안전을 위하여 최대순간풍속이 매초당 10 m를 초과하는 바람이 불 경우에는 설치·점검·수리 또는 해체작업을 중지한다.",
      "guideContext": "타워크레인 풍속 작업제한",
      "additionalDetail": null,
      "workProcessPhase": "풍속 확인 및 작업제한",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M91-022",
      "text": "안전운전을 위하여 최대순간풍속이 매초당 20 m를 초과하는 경우에는 타워크레인의 운전작업을 중지한다.",
      "guideContext": "타워크레인 풍속 작업제한",
      "additionalDetail": null,
      "workProcessPhase": "풍속 확인 및 작업제한",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M91-023",
      "text": "타워크레인의 풍속계는 상단의 높은 곳에 설치하고, 기록계는 운전실에서 운전자가 쉽게 볼 수 있는 곳에 설치한다.",
      "guideContext": "타워크레인 풍속 관리",
      "additionalDetail": null,
      "workProcessPhase": "풍속 확인 및 작업제한",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M91-024",
      "text": "타워크레인의 안전한 작업을 위하여 타워크레인의 설치·해체 및 상승작업을 할 때에는 <붙임 3>을 참조하여 다음 사항이 포함된 작업계획서를 작성한다.",
      "guideContext": "타워크레인 설치·해체 작업계획",
      "additionalDetail": "작업계획서에 포함할 사항: 타워크레인의 종류 및 형식, 설치·조립 및 해체순서, 설치용 장비, 작업도구·가설설비 및 방호설비, 작업근로자의 역할, 안전보건규칙의 규정에 의한 지지방법",
      "workProcessPhase": "작업계획서 작성",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M91-025",
      "text": "타워크레인의 사다리에 미끄럼 방지 조치를 할 것.",
      "guideContext": "타워크레인 설치·해체 작업계획",
      "additionalDetail": "작업계획서에 포함되어야 할 사항",
      "workProcessPhase": "작업계획서 작성",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-M91-026",
      "text": "작업계획서를 작성할 때에는 작업계획의 내용을 실제 작업을 담당할 근로자에게 주지시키고 이를 준수하는지의 확인이 필요하다.",
      "guideContext": "타워크레인 설치·해체 작업계획 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-027",
      "text": "운전자는 매달은 하물을 지상에 내리고 훅(Hook)을 가능한 한 높이 올린다.",
      "guideContext": "타워크레인 작업종료 후 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업종료 후 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-M91-028",
      "text": "바람이 심하게 불면 지브가 흔들려 훅 등이 건물 또는 족장 등에 부딪힐 우려가 있으므로 지브의 최소작업반경이 유지되도록 트롤리를 가능한 한 운전석 가까운 위치로 이동시킨다.",
      "guideContext": "타워크레인 작업종료 후 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "작업종료 후 안전조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M91-029",
      "text": "타워크레인의 고소 위치에는 풍압의 영향으로 구조부에 직접적으로 부가응력을 발생시킬 수 있으므로 타워크레인 제조자가 허용하지 않는 광고판 등을 부착하여서는 아니된다.",
      "guideContext": "타워크레인 작업종료 후 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "작업종료 후 안전조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M91-030",
      "text": "타워크레인의 운전정지 시에는 선회치차(Slewing gear)의 회전을 자유롭게 한다. 따라서 운전자가 운전석을 떠날 때는 항상 선회기어 브레이크를 풀어 놓아 자유롭게 선회될 수 있도록 한다.",
      "guideContext": "타워크레인 작업종료 후 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "작업종료 후 안전조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M91-031",
      "text": "선회기어 브레이크는 단지 콘트롤 레버가 \"0\" 점의 위치에 있을 때만 작동되므로 운전을 마칠 때는 모든 제어장치를 \"0\" 점 또는 중립에 위치시키며 모든 동력 스위치를 끄고 키를 잠근 후 운전석을 떠나도록 한다.",
      "guideContext": "타워크레인 작업종료 후 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업종료 후 안전조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M91-001",
      "term": "마스트",
      "definition": "타워크레인을 지지해주는 기둥 역할을 하는 강재(Steel)구조물로서 단위 마스트를 볼트로 연결시켜 설치 높이를 상승시킬 수 있도록 된 구조를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M91-002",
      "term": "지브",
      "definition": "메인 지브와 카운터 지브로 구성된 외팔보 형태의 트러스 구조물을 말하며, 선회축을 중심으로 한 선회반경에 따라 권상용량이 결정된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M91-003",
      "term": "선회장치",
      "definition": "마스트 상부에 있는 운전석 하부에 위치하며 회전 치차로 구성되어 지브를 선회시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M91-004",
      "term": "최대풍속",
      "definition": "지상 10 m의 높이에서 하루 중 임의의 10분간의 평균값 중에서 최대값을 말하며 최대평균풍속이라고도 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M91-005",
      "term": "최대순간풍속",
      "definition": "하루 중 바람이 순간적으로 가장 세게 불었던 때의 풍속을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M91-01",
      "processOrder": 1,
      "processName": "작업계획서 작성",
      "safetyMeasures": "타워크레인의 종류 및 형식, 설치·조립 및 해체순서, 설치용 장비, 작업도구·가설설비 및 방호설비, 작업근로자의 역할, 안전보건규칙의 규정에 의한 지지방법을 포함한 작업계획서를 작성하고 근로자에게 주지시킨다.",
      "requiredPPE": [
        "안전대",
        "안전모",
        "안전화"
      ],
      "sourceSection": "7",
      "relatedSR": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "WP-M91-02",
      "processOrder": 2,
      "processName": "벽체 지지·고정 설치",
      "safetyMeasures": "설계검사 서류 또는 제조사의 설치작업 설명서에 따라 설치하며, 전용 프레임을 사용하고 H-빔 등 임의 제작 사용을 금지한다. 벽체 지지대의 용접·가공 적정성, 지지점 위치, 건물구조 강도를 점검·확인하고, 수평·수직도 유지 및 볼트·핀 이완 여부를 붕괴사고 예방점검표에 따라 점검한다.",
      "requiredPPE": [
        "안전대",
        "안전모",
        "안전화"
      ],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-COLLAPSE-002",
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "WP-M91-03",
      "processOrder": 3,
      "processName": "와이어로프 지지·고정 설치",
      "safetyMeasures": "설계검사 서류 또는 제조사의 설치작업 설명서에 따라 설치하며, 전용프레임을 사용하여 균등하게 하중을 건다. 와이어로프 안전율 4 이상 확인, 마스트와 고정각도 30~60° 이내 설치, KS 이상 규격품 사용, 긴장장치 아이 부분을 기초고정 블록에 고정한다. 마스트에 직접 감아 샤클로 채우는 형태를 금지한다.",
      "requiredPPE": [
        "안전대",
        "안전모",
        "안전화"
      ],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-COLLAPSE-002",
        "SR-COLLAPSE-004"
      ]
    },
    {
      "identifier": "WP-M91-04",
      "processOrder": 4,
      "processName": "풍속 확인 및 작업제한 관리",
      "safetyMeasures": "풍속계를 타워크레인 상단 높은 곳에 설치하고, 기록계를 운전실에 설치한다. 최대순간풍속 10 m/s 초과 시 설치·점검·수리·해체작업 중지, 20 m/s 초과 시 운전작업 중지한다. 지형별 계수를 적용하여 최대순간풍속을 예측한다.",
      "requiredPPE": [
        "안전모"
      ],
      "sourceSection": "6",
      "relatedSR": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "WP-M91-05",
      "processOrder": 5,
      "processName": "작업종료 후 안전조치",
      "safetyMeasures": "매달은 하물을 지상에 내리고 훅을 높이 올린다. 트롤리를 운전석 가까운 위치로 이동시킨다. 제조자가 허용하지 않는 광고판 등 부착을 금지한다. 선회기어 브레이크를 풀어 자유선회 상태로 두고, 모든 제어장치를 중립에 위치시키며 동력 스위치를 끄고 키를 잠근 후 운전석을 떠난다.",
      "requiredPPE": [
        "안전모"
      ],
      "sourceSection": "8",
      "relatedSR": [
        "SR-CRANE-005"
      ]
    }
  ],
