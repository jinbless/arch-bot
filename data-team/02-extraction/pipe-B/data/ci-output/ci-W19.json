  "checklistItems": [
    {
      "identifier": "CI-W19-001",
      "text": "작업을 시작하기 전에 농약의 방제기술과 지켜야 할 안전조치에 대하여 교육을 실시하여야 한다. 이 때 근로자가 농약용기에 부착된 경고표지를 이용하여 약제의 종류, 사용상의 주의사항과 독성정도, 중독되었을 때 응급처치요령 등을 확인하도록 한다.",
      "guideContext": "농약 살포·주입 작업",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W19-002",
      "text": "방제기구에 농약을 충전하는 경우에는 넘쳐 흐르거나 역류하지 않도록 한다.",
      "guideContext": "농약 살포·주입 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-003",
      "text": "농약원재료를 혼합하는 경우에는 농약사용설명서 등을 검토하여 화학반응 등의 위험성이 있는지를 확인하여야 한다.",
      "guideContext": "농약 살포·주입 작업",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-W19-004",
      "text": "농약원재료를 취급하는 경우에는 흡연하거나 음식물을 먹지 않도록 한다.",
      "guideContext": "농약 살포·주입 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-005",
      "text": "방제기구의 막힌 분사구를 뚫기 위하여 입으로 불어내지 않도록 한다.",
      "guideContext": "농약 살포·주입 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-006",
      "text": "농약이 들어있는 용기와 기기들은 개방된 상태로 방치하여서는 아니 된다.",
      "guideContext": "농약 살포·주입 작업",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W19-007",
      "text": "압축용기에 들어있는 농약원재료를 취급하는 경우에는 폭발방지조치를 하여야 한다.",
      "guideContext": "농약 살포·주입 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-008",
      "text": "농약을 훈증하는 경우에는 유해가스가 외부로 누출되지 않도록 한다.",
      "guideContext": "농약 살포·주입 작업",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W19-009",
      "text": "농약의 살포작업 시 어린이와 가축 등 살포작업과 관계없는 사람이나 동물이 접근하지 않도록 조치를 취하여야 한다.",
      "guideContext": "농약 살포·주입 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "살포 및 주입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-010",
      "text": "작업을 시작하기 전에 농약의 방제기술과 지켜야 할 안전조치에 대한 교육을 실시하여야 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-W19-011",
      "text": "근로자가 단독으로 작업하지 않도록 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-012",
      "text": "근로자 상호간에 연락이 가능하도록 무전기나 이동전화 등을 휴대하도록 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-013",
      "text": "압축용기에 들어있는 농약을 취급하는 경우에는 폭발이나 누출에 주의하여야 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-014",
      "text": "농약이 들어있는 용기와 기기들은 개방된 상태로 방치하여서는 아니 된다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W19-015",
      "text": "작업 중 유해가스가 외부로 누출되지 않도록 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-W19-016",
      "text": "농약훈증 작업 중임을 알리는 경고표지를 설치하여야 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-W19-017",
      "text": "농약을 취급하는 경우에는 흡연하거나 음식물을 먹지 않도록 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-018",
      "text": "호흡용 보호구와 불침투성 보호복 등 개인보호구를 착용하고 작업하여야 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-W19-019",
      "text": "훈증작업을 실시한 시설에는 농약을 훈증하였음을 알리는 경고표지를 부착하여야 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-W19-020",
      "text": "훈증제 주입 후 살충효과를 내기 위한 시간이 지나면 해당 시설 내의 훈증제 농도가 노출기준 이하가 되기 전까지 해당 밀폐시설에 관계자외의 사람이 출입하지 않도록 조치하여야 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": null,
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-W19-021",
      "text": "선박을 소유한 사업주나 선박 내에서 근로자를 사용하여 화물의 이송 등을 하는 사업주는 농약 훈증을 실시하는 작업 기간이나 훈증작업이 끝난 후 훈증제의 농도가 근로자의 건강에 영향을 주지 못하는 농도 이하가 되기 전까지 해당 선박 등에 근로자가 출입하지 못하도록 하여야 한다.",
      "guideContext": "선박 등 밀폐공간 훈증작업",
      "additionalDetail": "다만, 근로자에게 필요한 보호구를 지급하고, 근로자가 이를 착용하도록 하는 등 근로자의 건강보호를 위하여 필요한 조치를 취한 경우에는 그러하지 아니하다.",
      "workProcessPhase": "선박 등에서의 훈증",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-W19-022",
      "text": "배합작업은 가능하면 밀폐된 시설을 이용하여야 한다.",
      "guideContext": "농약 배합작업",
      "additionalDetail": null,
      "workProcessPhase": "배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W19-023",
      "text": "측정용기, 깔대기, 교반기 등 배합기구들의 사용방법 및 배합비율 등을 주지시켜야 한다.",
      "guideContext": "농약 배합작업",
      "additionalDetail": null,
      "workProcessPhase": "배합",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W19-024",
      "text": "농약이 들어있는 용기와 배합기구는 정리·정돈 후 사용하여야 한다.",
      "guideContext": "농약 배합작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배합",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-025",
      "text": "배합된 농약을 방제기에 주입하는 경우에는 농약분진이나 미스트의 발생을 최소화하고, 분진이나 미스트가 심하게 발생하는 경우에는 이동식 국소배기장치 등을 이용하여야 한다.",
      "guideContext": "농약 배합작업",
      "additionalDetail": null,
      "workProcessPhase": "배합",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W19-026",
      "text": "사용한 용기들은 물로 3 번 이상 세척하는 등 남은 농약을 제거한 후, 일정한 장소에 보관함으로서 2차 오염이 발생하지 않도록 처리하여야 하며, 용기를 세척한 물을 유수 등에 버려서는 아니된다.",
      "guideContext": "농약 배합작업",
      "additionalDetail": null,
      "workProcessPhase": "배합",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-W19-027",
      "text": "사업주는 시중에 유통되고 있는 농약원액을 다른 용기에 옮겨 담아서는 아니 된다.",
      "guideContext": "농약 용기 이송",
      "additionalDetail": "다만, 작업의 성질상 부득이하게 옮겨 담는 경우에는 안전조치를 하여야 한다.",
      "workProcessPhase": "용기 이송",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W19-028",
      "text": "옮겨 담는 용기는 같은 농약을 담았던 용기이거나 안전성이 확인된 것을 사용하여야 한다.",
      "guideContext": "농약 용기 이송 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-029",
      "text": "옮겨 담는 용기에는 적합한 경고표지를 부착하여야 한다.",
      "guideContext": "농약 용기 이송",
      "additionalDetail": null,
      "workProcessPhase": "용기 이송",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-W19-030",
      "text": "깨끗이 세척된 빈 용기에 옮겨 담아야 하며 특히 음료용기 등에 옮겨 담아서는 아니된다.",
      "guideContext": "농약 용기 이송 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-031",
      "text": "부피 팽창 등으로 유출되지 않도록 지나치게 충전하여서는 아니 된다.",
      "guideContext": "농약 용기 이송 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용기 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-032",
      "text": "사용하고 남은 농약과 빈 용기는 창고 등 일정한 장소에 보관하여야 한다.",
      "guideContext": "방제 후 조치",
      "additionalDetail": null,
      "workProcessPhase": "방제 후 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W19-033",
      "text": "오염된 기구는 깨끗이 세척하는 등 오염을 제거하여야 한다.",
      "guideContext": "방제 후 조치",
      "additionalDetail": null,
      "workProcessPhase": "방제 후 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-W19-034",
      "text": "오염된 작업복은 세탁 후에 보관하여야 한다.",
      "guideContext": "방제 후 조치",
      "additionalDetail": null,
      "workProcessPhase": "방제 후 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-W19-035",
      "text": "농약의 방제날짜, 장소, 사용량, 명칭, 사용자, 재출입 제한기간 등을 기록하여 입구에 게시하여야 한다(방제장소가 옥외인 경우에는 제외한다).",
      "guideContext": "방제 후 조치",
      "additionalDetail": null,
      "workProcessPhase": "방제 후 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-W19-036",
      "text": "살포한 후의 약제는 뚜껑을 닫고, 빈병과 구별하여 보관하여야 한다.",
      "guideContext": "농약 보관",
      "additionalDetail": null,
      "workProcessPhase": "보관 및 폐기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W19-037",
      "text": "농약을 보관하는 장소는 잠금장치가 부착된 전용의 농약보관함이어야 하며, 어린이 등 관계자외의 사람의 손이 닿지 않는 곳이어야 한다.",
      "guideContext": "농약 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 및 폐기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-038",
      "text": "사용 후 남은 농약 및 빈병은 전용의 수거합을 통하여 수거하여야 하며, 빈 용기를 다른 용도로 다시 사용하지 않도록 한다.",
      "guideContext": "농약 보관",
      "additionalDetail": null,
      "workProcessPhase": "보관 및 폐기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-W19-039",
      "text": "사업주는 농약을 방제한 지역에는 일정기간 동안 근로자의 출입을 금지시켜야 한다.",
      "guideContext": "재출입 제한 (법령 근거 미확인)",
      "additionalDetail": "다만, 작업의 성질상 근로자를 출입하도록 하는 경우에는 적절한 호흡용 보호구, 보호의 등을 착용하도록 하고 감시자를 배치한 후 작업하도록 하여야 한다.",
      "workProcessPhase": "재출입 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-040",
      "text": "사업주는 방제업무에 근로자를 종사하도록 하는 경우에는 농약의 성질과 상태에 따라 불침투성 보호의·보호장갑·보안경·보호장화, 유기가스용 방독마스크, 방진마스크 또는 송기마스크 등을 근로자에게 지급하여 착용하도록 하여야 한다.",
      "guideContext": "보호구 지급",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W19-041",
      "text": "지급하는 보호구 등은 개인전용의 것을 지급하여야 한다.",
      "guideContext": "보호구 지급",
      "additionalDetail": "다만, 송기마스크의 경우에는 공동사용으로 인한 근로자의 질병감염 위험이 없도록 세척·소독 등 필요한 조치를 취하면 그러하지 아니하다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-W19-042",
      "text": "사업주는 근로자에게 보호구를 지급하는 경우에는 별도의 깨끗한 보관시설을 제공하여야 한다.",
      "guideContext": "보호구 지급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-043",
      "text": "분진이나 미스트용 방진마스크는 호흡저항이 지나친 경우, 여과재가 손상을 입은 경우, 제조자가 권고하는 유효기간에 이른 경우, 제조자가 권고하는 유효기간이 없는 경우에는 작업일마다 여과재를 교환하여야 한다.",
      "guideContext": "보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-044",
      "text": "증기나 가스용 방독마스크는 최초로 맛이나 냄새를 느낀 경우, 정화통이 손상을 입은 경우, 제조자가 권고하는 유효기간에 이른 경우, 제조자가 권고하는 유효기간이 없는 경우에는 작업일마다 여과재를 교환하여야 한다.",
      "guideContext": "보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-045",
      "text": "사업주는 지급하는 보호구는 작업 후 매일 따뜻한 물과 세제를 사용하여 세척하여야 한다.",
      "guideContext": "보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-046",
      "text": "근로자는 지급받은 보호구 등은 작업 전에 오염이나 누출 등에 대한 확인을 실시하고, 필요시 부품을 교환하거나 해당 보호구를 교체하여야 한다.",
      "guideContext": "보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-047",
      "text": "사업주는 방제업무에 근로자를 종사하도록 하는 경우에는 해당 근로자 중 산업보건과 농약에 관한 지식과 경험이 있는 사람을 담당자로 지정하여야 한다.",
      "guideContext": "관리체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-048",
      "text": "사업주는 지정된 담당자에게 작업방법 결정 및 지휘, 보호구 착용상황 감시, 농약 중독 우려 시 대피 및 의학적 조치, 농약이 인체에 미치는 영향에 관한 내용 주지, 빈 용기 및 남은 농약의 처리방법 주지 및 감시 업무를 수행하도록 하여야 한다.",
      "guideContext": "관리체계 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-049",
      "text": "사업주는 방제업무를 하는 작업장소 또는 농약, 방제기구 등을 보관하는 장소에는 관계 근로자외의 사람의 출입을 금지시키고, 그 뜻을 보기 쉬운 장소에 게시하여야 한다.",
      "guideContext": "출입 관리",
      "additionalDetail": "게시내용에는 \"출입금지\"를 표시하고, 농약의 명칭과 유효성분·살포기간 등이 포함되어야 한다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-W19-050",
      "text": "사업주는 근로자가 농약에 중독될 우려가 있는 경우에는 즉시 작업을 중지시키고, 안전한 장소로 대피할 수 있도록 한다.",
      "guideContext": "사고 시 대피",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-W19-051",
      "text": "사업주는 방제업무를 하는 도중 농약 중독자가 발생하면 해당 근로자를 즉시 가까운 병원시설로 이송하여 응급조치를 받도록 하여야 한다.",
      "guideContext": "중독 정보 제공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-052",
      "text": "사업주는 응급처치활동을 위하여 필요한 정보인 농약명, 농약방제 작업상황, 농약노출상황, 경고표지 상의 응급처치요령 등을 해당 병원시설에 제공하여야 한다.",
      "guideContext": "중독 정보 제공 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-053",
      "text": "사업주는 방제업무에 근로자를 종사하도록 하는 경우에는 작업이 끝난 후 즉시 해당 근로자에게 목욕을 하도록 하여야 한다.",
      "guideContext": "작업 후 오염제거",
      "additionalDetail": null,
      "workProcessPhase": "방제 후 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W19-054",
      "text": "사업주는 오염제거활동에 필요한 목욕시설과 비누 및 수건 등 필요한 용품을 지급하여야 한다.",
      "guideContext": "작업 후 오염제거",
      "additionalDetail": null,
      "workProcessPhase": "방제 후 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-W19-055",
      "text": "사업주는 방제업무를 하는 장소에 세안액, 비누, 구토제, 활성백토·톱밥 등을 비치하여야 한다.",
      "guideContext": "구급약품 비치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-W19-056",
      "text": "사업주는 준비한 구급약품 등의 사용 용도, 사용 방법 등을 근로자에게 주지시켜야 한다.",
      "guideContext": "구급약품 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-W19-001",
      "term": "농약",
      "definition": "농작물(수목 및 농·임산물을 포함한다. 이하 같다)을 해하는 균·곤충·응애·선충·바이러스·잡초(이하 \"병해충\"이라 한다), 그밖에 농림수산부령이 정하는 동·식물의 방제에 사용하는 살균제·살충제·제초제 그 밖에 농림수산식품부령이 정하는 약제와 농작물의 생리기능을 증진하거나 억제하는데 사용하는 약제를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W19-002",
      "term": "방제업무",
      "definition": "농약을 사용하여 병해충을 방제하거나 농작물의 생리기능을 증진 또는 억제시키는 업무로서, 농약의 살포·훈증·주입 등을 하는 업무, 농약 또는 원제를 혼합·충진하는 업무, 농약을 살포·훈증 또는 주입하기 위하여 이송하는 업무, 농약을 다른 용기에 옮겨 담는 업무, 그 밖에 근로자가 농약에 심각하게 노출될 우려가 있는 업무를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W19-003",
      "term": "훈증",
      "definition": "밀폐된 장소에 가스 또는 증기상태의 유효성분을 채워 병해충의 호흡시 기공을 통하여 체내에 흡입시킴으로써 병해충을 죽게 하는 방제방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W19-004",
      "term": "주입",
      "definition": "농약을 수목 등에 천공하여 주입하는 행위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W19-005",
      "term": "출입제한기간",
      "definition": "농약방제작업을 실시한 후, 농약으로 인한 중독을 예방하기 위하여 해당 지역에 근로자의 출입을 제한하는 기간으로 농약제품의 제조자가 농약용기 등에 부착한 경고표지 등에 기록한 기간을 말한다. 다만, 제조자가 이 기간을 경고표지 등을 통하여 지정하지 아니한 경우에는 30일로 한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
