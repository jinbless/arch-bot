  "domainTerms": [
    {
      "identifier": "DT-AG1-001",
      "term": "추락방호망",
      "definition": "건설공사 현장에서 고소 작업 중 작업자가 추락할 위험 및 위험 발생의 우려가 있는 장소에 수평으로 설치하는 방호망을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "DT-AG1-002",
      "term": "수직형 추락방망",
      "definition": "건설현장에서 작업자가 위험장소에 접근하지 못하도록 수직으로 설치하여 추락의 위험을 방지하는 방망을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "DT-AG1-003",
      "term": "그물코",
      "definition": "그물의 구멍부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG1-004",
      "term": "테두리 로프",
      "definition": "방망 4변의 가장자리에 방망 각각의 그물코를 관통시키는 방법으로 방망과 일체로 설치하는 로프를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG1-005",
      "term": "재봉사",
      "definition": "테두리 로프와 방망을 재봉하여 일체화하기 위한 실(인조섬유 등)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG1-006",
      "term": "달기 로프",
      "definition": "테두리 로프의 모서리에 결속된 로프로 방망을 지지점에 부착하기 위하여 설치하는 로프를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-AG1-007",
      "term": "정격설치하중",
      "definition": "달기로프의 양끝을 당겨서 설치하는 하중을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
