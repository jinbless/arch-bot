  "workProcesses": [
    {
      "identifier": "WP-CC60-01",
      "processOrder": 1,
      "processName": "사고시나리오 선정",
      "safetyMeasures": "최악의 누출사고시나리오 활용, 위험과 운전분석기법(HAZOP) 결과 활용(위험등급 1·2·3 해당 시나리오), 과거 사고사례 활용(아차사고 포함 모든 형태) 등 다양한 방법을 통해 가상 사고시나리오를 선정한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "WP-CC60-02",
      "processOrder": 2,
      "processName": "사고시나리오 구체화 (누출위치·누출공·누출시간 결정)",
      "safetyMeasures": "누출위치는 입·출입 배관 부위, 용기 부식, 펌프씰 파손, 안전밸브 작동 등에서 선정하고, 누출공은 공정 압력·온도에 따라 A·B·C형으로 분류하여 결정하며, 누출시간은 최대 10분 기준으로 검출·차단 시스템 등급을 고려하여 산출한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "WP-CC60-03",
      "processOrder": 3,
      "processName": "피해범위 파악 및 공정도면 표시",
      "safetyMeasures": "확산범위(가연범위, 가스감지 범위), 복사열 피해범위(4·12.5·37.5 kW/㎡ 기준), 폭풍압 피해범위(0.07·0.21·0.84 bar 기준)를 공정도면 상에 표시하고 피해범위 내 가동 설비를 검토한다.",
      "requiredPPE": [],
      "sourceSection": "7.4.1",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-006"
      ]
    },
    {
      "identifier": "WP-CC60-04",
      "processOrder": 4,
      "processName": "초기 대응 및 진압 전략 수립",
      "safetyMeasures": "누출 차단 시스템(인터록, DCS) 효율성 검토, 가스감지기 위치·유지관리·신뢰성 검증, 비상경보장치 설치, 초기발견자 사전교육 강화, 화재·폭발 대응지침 작성을 포함한다.",
      "requiredPPE": [],
      "sourceSection": "7.1",
      "relatedSR": [
