  "checklistItems": [
    {
      "identifier": "CI-CC60-001",
      "text": "다음은 산업안전보건법령에 관한 사항으로써 반드시 준수하여야 한다.",
      "guideContext": "비상조치계획 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "공정안전보고서에 비상조치를 위한 장비·인력 보유현황, 비상연락체계, 조직 임무 및 수행 절차, 교육계획, 주민홍보계획 등을 포함하여야 함",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC60-002",
      "text": "사업장내의 모든 장치에 대하여 누출방지 및 초기진압시스템이 구성되어 있는지를 분석한다.",
      "guideContext": "초기 대응시간 단축",
      "additionalDetail": null,
      "workProcessPhase": "누출방지 시스템 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-CC60-003",
      "text": "사고의 피해범위를 최소화하기 위해서는 누출사고를 감지하는 순간 최대한 빠른 시간 안에 누출을 제어할 수 있도록 다음사항을 검토한다.",
      "guideContext": "초기 대응시간 단축",
      "additionalDetail": "누출 차단 시스템, 누출 감지 시스템, 초기발견자 행동요령 및 비상대응 절차 검토 포함",
      "workProcessPhase": "누출 감지 및 차단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-CC60-004",
      "text": "인터록 혹은 제어시스템의 효율성 재검토",
      "guideContext": "누출 차단 시스템 기술적 검토",
      "additionalDetail": null,
      "workProcessPhase": "누출 차단",
