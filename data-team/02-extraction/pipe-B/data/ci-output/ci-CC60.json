    {
      "identifier": "CI-CC60-022",
      "text": "폭발압력의 최소화를 위한 기술적 대책",
      "guideContext": "가압 가연성 물질 폭발 대비",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
