    },
    {
      "identifier": "WP-CC60-05",
      "processOrder": 5,
      "processName": "인명피해 최소화 및 대피 전략 수립",
      "safetyMeasures": "급성 독성물질 대비 양압설비 도입, 출입문·창호 밀폐, 개인보호장구 현장비치, 위험설비 주변 이동사무실 배치 금지, 건물·셸터 분산 배치, 비상대피장소 지정(사고 중심선 기준 분할), 폭발 사전 대피시점 산정을 검토한다.",
      "requiredPPE": [
        "호흡용 보호구",
