      ],
      "sourceSection": "7.4.3",
      "relatedSR": [
        "SR-CHEMICAL-025",
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "WP-CC60-06",
      "processOrder": 6,
      "processName": "물리적 보호 설비 설치",
      "safetyMeasures": "방유제 분할 설치를 통한 피해범위 최소화, 수막(Water curtain)을 이용한 화재발생 지점과 주변 설비 격리, 스팀막(Steam curtain) 설치, 독성물질 중화설비 및 이동용 중화설비 도입을 검토한다.",
      "requiredPPE": [],
      "sourceSection": "7.4.4",
