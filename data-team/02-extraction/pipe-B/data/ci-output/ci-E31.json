  "checklistItems": [
    {
      "identifier": "CI-E31-001",
      "text": "60 A 이하의 모든 배선기구는 전 부하에서 접속 또는 차단성능에 대하여 시험받아야 하고, 60 A를 넘는 배선기구는 운전 모드에 대해 명시되어 있는지의 여부를 표시하여야 한다.",
      "guideContext": "배선기구 일반사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-002",
      "text": "용접기, 전동기와 같이 부하 상태에서 유도성 전기기기를 차단하기 위해 배선기구를 사용하는 것은 위험할 수 있으므로 용도에 적합한 다른 부하 차단수단을 사용하여야 한다.",
      "guideContext": "배선기구 일반사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    },
    {
      "identifier": "CI-E31-003",
      "text": "전기기기 용기 내의 플러그나 접속기가 균열이 갔거나 손상되었을 경우, 그 부품들이 유실 또는 손상되었을 경우, 플러그 핀이나 접속기의 접촉부가 휘었을 경우 등에는 용기 내의 기구 전체를 교체하여야 한다.",
      "guideContext": "배선기구 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "배선기구 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-004",
      "text": "부식 환경, 고온 장소 또는 폭발위험장소의 경우에는 당해 장소에 적합한 배선기구를 사용하여야 한다.",
      "guideContext": "배선기구 일반사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-E31-005",
      "text": "접속기 또는 콘센트는 접속력이 적합지에 대하여 점검하여야 하고, 만약 외함이 변색되었거나 접촉부에 심각한 부식이 있을 경우에는 전체를 교체하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": "불충분한 접속력은 접촉부의 아크나 불완전 접촉에 의하여 접촉부의 부식을 촉진시킬 수 있다.",
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E31-006",
      "text": "코드 접지의 연속성을 유지하기 위하여 접지도체(녹색선)를 접속하기 위한 접지단자가 배선기구에 부착되어 있어야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E31-007",
      "text": "콘센트, 플러그 또는 접속기 등의 접속부는 깨끗하게 수시로 닦아야 한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-008",
      "text": "균열이 가거나 휘거나 부서진 스프링 도어 또는 덮개는 교체하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-009",
      "text": "모든 부착 및 조립용 나사는 조임 정도를 확인하기 위하여 점검하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-010",
      "text": "개스킷이 있는 경우, 접속기 등의 기능이 유지되는지 확인하기 위해 점검하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-011",
      "text": "교체하여야 할 부품의 적절한 선정을 위하여 명판은 읽을 수 있도록 청결하게 유지하여야한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-012",
      "text": "기기와 외부 표면, 핀 또는 슬리브 등의 표면은 접지 폐회로가 원활히 구성되도록 도장(페인트칠)을 해서는 안 된다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E31-013",
      "text": "기계적 및 전기적으로 연동된 모든 플러그 및 콘센트는 제대로 작동되는지와 부품이 과도하게 닳았는지 또는 부서진 것은 없는지를 점검하고 필요할 경우에는 교체한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-014",
      "text": "배선기구의 모든 부품 및 표면은 깨끗이 유지하여 이물질이나 부식이 없도록 한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-015",
      "text": "본체에 콘센트를 고정시키는 모든 나사, 덮개 및 나사 접합부는 단단하게 조여야 한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-016",
      "text": "내압방폭구조에서 접촉면의 안전간극이 규정 값을 넘지 않고 긁힌 부분이 없는지 화염경로(Flame path)를 점검한다.",
      "guideContext": "폭발위험장소 배선기구 점검",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-E31-017",
      "text": "플러그 및 콘센트는 폭발등급, 그룹 등이 해당 지역에 적합하게 표시되어 있는지를 확인하여야 한다.",
      "guideContext": "폭발위험장소 배선기구 점검",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-E31-018",
      "text": "콘센트가 많이 낡았거나 균열이 나있거나 파손되거나 접촉부가 노출되어 있으면 교체하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E31-019",
      "text": "콘센트의 접촉부는 플러그가 견고하게 삽입되고 유지되어야 하며, 플러그가 콘센트로부터 쉽게 탈락될 경우에는 콘센트를 교환하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": "계속적인 사용이 필요하면 잠금형 기구의 설치를 고려해야 한다.",
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E31-020",
      "text": "전기기기의 확실한 접지를 포함한 접속부의 극성과 콘센트의 올바른 전선 접속 등을 점검하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-002",
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E31-021",
      "text": "콘센트 면에 비정상적인 과열이 있다면 단자처리가 느슨한지를 점검하여 수리하거나 교체한다. 만약, 배선기구에 아크나 탄화 흔적 또는 다른 손상이 있으면 교체하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E31-022",
      "text": "제어 접촉부(Control contact part)는 때때로 동력 핀(Power pin)과 결합하여 사용하는데, 이 제어 접촉부는 선 차단 후 분리되는지를 점검하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "접속기 및 콘센트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-023",
      "text": "600 V 이하, 200 A 이하의 플러그, 코드 접속기, 콘센트는 다른 전압, 전류 또는 주파수를 갖는 기구와의 위험한 상호접속을 방지하기 위해 서로 다른 모양의 기구로 구비되어야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-024",
      "text": "같은 구역 내에서는 다른 전압, 전류 또는 주파수를 가진 회로에 접속된 배선기구는 상호 호환성이 없어야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-025",
      "text": "호환되지 않도록 하는 적어도 두 가지 방법 중, 즉 접촉면의 크기와 위치로 하는 방법 또는 플러그 슬리브와 콘센트 함의 배열을 조정하는 방법 중 하나 이상을 사용하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-026",
      "text": "정비용 전원 확보에 주로 사용하는 잠금/풀림 기능의 어댑터에서 기기 접지를 생략하여 사용해서는 안 된다.",
      "guideContext": "어댑터 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E31-027",
      "text": "직류-교류(T-정격) 스위치는 해당 정격의 50 %를 넘는 형광등 또는 전동기와 같은 유도성 부하를 제어하는데 사용하여서는 안 된다.",
      "guideContext": "스냅스위치 정비",
      "additionalDetail": "교류전용 스위치는 유도성 부하에 대해 정격의 100 %, 전동기 부하는 정격의 80 %까지 제어할 수 있다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-028",
      "text": "스위치가 파손되거나 정상적으로 작동하지 않으면 스위치를 교체하여야 한다. 반복적으로 오조작되는 경우, 스위치의 설치위치를 변경하거나 작동 방식을 다르게 하거나 보다 작은 스위치로의 교체를 검토하여야 한다.",
      "guideContext": "스냅스위치 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "스냅스위치 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-029",
      "text": "스위치는 전기적 및 기계적인 건전성을 확보하기 위해 박스에 견고하게 고정하여야 한다.",
      "guideContext": "스냅스위치 정비",
      "additionalDetail": null,
      "workProcessPhase": "스냅스위치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-030",
      "text": "비정상적인 과열 흔적이 있으면 단자가 느슨하거나 오작동에 대해서 스위치를 점검하고 수리 또는 교체해야 한다.",
      "guideContext": "스냅스위치 정비",
      "additionalDetail": null,
      "workProcessPhase": "스냅스위치 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E31-031",
      "text": "모든 스위치와 콘센트는 주위 환경 및 위치에 적합한 벽부착 형 판이나 덮개에 설치하여야 한다.",
      "guideContext": "덮개판 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E31-032",
      "text": "균열이 나있거나 구부러지거나 손상된 벽부착 형 판, 스프링 문 또는 덮개는 교체하여야 한다.",
      "guideContext": "덮개판 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덮개판 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-033",
      "text": "콘센트, 스위치 등의 수납용으로 사용되는 박스들은 정 위치에 견고하게 고정하여야 한다.",
      "guideContext": "박스 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "박스 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-034",
      "text": "로크너트와 피팅들은 잘 조여야 하고, 도체가 적절하게 박스에 인입되었는지를 관찰하여야 한다.",
      "guideContext": "박스 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "박스 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-035",
      "text": "코드 클램프와 변형 완화 피팅(Strain relief fitting)이 조여져 있는지와 코드 외부 덮개가 클램프 지역에 있는지를 확인한다.",
      "guideContext": "플러그 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "플러그 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-E31-036",
      "text": "절연체의 탈색이나 접촉면의 패임에 대해 육안 점검을 하고, 다른 부분도 탈색이나 패인 곳이 있으면 점검하여야 한다.",
      "guideContext": "플러그 정비",
      "additionalDetail": "플러그 표면의 비정상적인 과열은 느슨한 단자처리, 과부하, 높은 주위온도, 기기 오작동 등에 기인할 수 있다.",
      "workProcessPhase": "플러그 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E31-037",
      "text": "정기적으로 각 도체의 조립품을 단자까지 점검하되, 개별 도체 소선은 적절하게 수납되어야 하고, 단자 부위는 단단하게 조여야 한다.",
      "guideContext": "플러그 정비",
      "additionalDetail": null,
      "workProcessPhase": "플러그 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E31-038",
      "text": "도체 소선은 과열을 방지하기 위해 묶음 헤드나사를 사용하는 경우, 납땜을 사용하지 않아야 한다.",
      "guideContext": "플러그 정비",
      "additionalDetail": null,
      "workProcessPhase": "플러그 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E31-039",
      "text": "플러그나 접속기 외피 또는 내부가 손상되거나 또는 핀이나 접촉면이 구부러지거나 탈색되면 내부 전체를 교체하여야 한다. 특히 부식성이나 고온이 있는 장소 또는 폭발위험장소와 같은 악영향이 있는 환경에서는 해당 용도로 제조된 배선기구를 사용하여야 한다.",
      "guideContext": "플러그 정비",
      "additionalDetail": null,
      "workProcessPhase": "플러그 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-E31-040",
      "text": "콘센트 또는 플러그의 절연부에 균열, 파손, 탈색 등의 결함이 있는 부품은 교체하여야 한다.",
      "guideContext": "플러그 정비",
      "additionalDetail": null,
      "workProcessPhase": "플러그 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E31-041",
      "text": "콘센트 접촉면은 삽입된 플러그를 견고하게 유지하여야 한다. 부식, 변형 또는 기계적으로 손상된 접촉면은 교체하여야 한다. 콘센트에서 전선접속이 적합한지와 기기의 확실한 접지를 포함하여 접속의 극성이 적합한지를 점검하여야 한다.",
      "guideContext": "플러그 정비",
      "additionalDetail": null,
      "workProcessPhase": "플러그 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-002",
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E31-042",
      "text": "콘센트, 플러그 또는 접속기 절연부의 비정상적인 과열이 있으면 단자 부위의 느슨함이나 접촉부 사이 불충분한 압력 여부를 점검하고, 필요시에는 수리나 교체한다. 아크나 절연부의 탄화 흔적 또는 기타 손상이 있으면 교체하여야 한다.",
      "guideContext": "플러그 정비",
      "additionalDetail": null,
      "workProcessPhase": "플러그 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E31-043",
      "text": "배선기구들은 사용상의 편의로 많이 사용되지만, 전부하 또는 회전자 구속 전류에서 전기기기를 차단하기 위해서 배선기구의 조합이 사용되어야 한다. 이 조립품이 적합하지 않으면 연동기구가 있는 콘센트 같은 기타 부하차단방법을 사용하여야 한다.",
      "guideContext": "접속기 및 콘센트 정비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-005"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E31-001",
      "term": "배선기구",
      "definition": "전기회로의 일부분으로 전력을 연결하거나 차단해 주는 스위치, 콘센트, 코드 접속기, 소켓, 탭 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E31-002",
      "term": "플러그",
      "definition": "코드와 배선의 접속 기구로 기기나 접속기에 연결되는 유연 케이블에 직접 연결되거나 합쳐지는 부분을 말한다. 코드 끝에 부착하여 콘센트 등에 접속하도록 되어 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E31-003",
      "term": "콘센트",
      "definition": "고정된 전선이나 기기의 병합에 장착되기 위한 부분을 말하며 전기 기구와 배선과의 접속에 사용하는 배선측에 설치되는 접속기이다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
