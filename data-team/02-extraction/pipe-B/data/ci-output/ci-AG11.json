  "checklistItems": [
    {
      "identifier": "CI-AG11-001",
      "text": "용접방화포등은 소방청 고시(「방화포의 성능인증 및 제품검사의 기술기준」)에서 정하는 재료 및 성능기준을 충족해야한다.",
      "guideContext": "용접방화포 성능기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 성능 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-002",
      "text": "「화학물질의 분류표시 및 물질안전보건자료에 관한 기준 고시」에 따른 피부, 눈, 호흡기계등에 급성 손상을 유발하는 급성독성 구분1~3, 피부 부식성 구분1, 심한 눈 손상성 구분1로 분류되는 유해물질이 원재료에 1 % 이상 포함되지 않아야 한다.",
      "guideContext": "용접방화포 재료 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 성능 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-003",
      "text": "준불연재료 성능 시험법인 연소성능시험 KS F ISO 5660-1, 10분 시험결과 착화되지 않고(착화시간 0초) 방화상 구멍 및 용융이 없으며 총방출열량이 8 MJ/㎡ 이하, 최대열방출률이 10초 이상 연속으로 200 kW/㎡를 초과하지 않은 공인시험기관의 시험성적서를 보유하여야 한다.",
      "guideContext": "용접방화포 착화 및 화염·열지향 성능기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 성능 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-004",
      "text": "전기로(히터) 1,200 ℃ 조건에서 60초 동안 내열성 시험결과 용융되지 않은 공인시험기관의 시험성적서를 보유하여야 한다.",
      "guideContext": "용접방화포 내열성 성능기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 성능 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-005",
      "text": "공인시험기관의 시험성적서는 최근 2년 이내의 성적서로 관리하여야 한다.",
      "guideContext": "용접방화포 시험성적서 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 성능 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-006",
      "text": "수직 보호망의 난연성 시험방법(KS F 2298)에 따라 자체 시험결과 발염이 없고 관통하지 않는 자체 시험성적서를 보유하여야 한다.",
      "guideContext": "용접방화포 불티관통 성능기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 성능 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-007",
      "text": "불티가 인접지역으로 비산하는 것을 방지하기 위해 용접방화포의 종류에 따라 불티 비산거리내의 벽, 바닥, 덕트의 개구부 또는 틈새에 빈틈없이 설치하여야 한다.",
      "guideContext": "용접방화포 설치기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-008",
      "text": "작업 반경 11 m 이내에 이동이 불가한 가연성물에 대해 개구부 또는 틈새가 없도록 설치하여야 한다.",
      "guideContext": "비산방지덮개 설치기준 (법령 근거 미확인)",
      "additionalDetail": "비산방지덮개(Welding Blanket) 적용",
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-009",
      "text": "작업 반경 11 m 이상 떨어져 있지만 비산불티에 의해 쉽게 발화될 우려가 있는 가연물에 개구부 또는 틈새가 없도록 설치하여야 한다.",
      "guideContext": "비산방지덮개 설치기준 (법령 근거 미확인)",
      "additionalDetail": "비산방지덮개(Welding Blanket) 적용, 11m 초과 범위",
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-010",
      "text": "작업 반경 11 m 이내에 작업장 하부 바닥면에 설치하여야 한다.",
      "guideContext": "수평형 용접방화포 설치기준 (법령 근거 미확인)",
      "additionalDetail": "수평형 용접방화포(Welding Pad) 적용",
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-011",
      "text": "수직형 용접방화포가 바닥면부터 용접·용단 작업면 2 m 높이까지 설치된 경우 수직형 용접방화포 설치된 부분 바닥면까지 설치하여야 한다.",
      "guideContext": "수평형 용접방화포 설치기준 (법령 근거 미확인)",
      "additionalDetail": "수평형 용접방화포(Welding Pad) 적용, 수직형 병용 시",
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-012",
      "text": "바람 등의 영향으로 비산불티가 작업 반경 11 m 이상 비산될 경우 최대 비산거리 하부 바닥면까지 설치하여야 한다.",
      "guideContext": "수평형 용접방화포 설치기준 (법령 근거 미확인)",
      "additionalDetail": "수평형 용접방화포(Welding Pad) 적용, 바람 등 영향 시 확장",
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-013",
      "text": "작업 반경 11 m 이내에 수평형 용접방화포가 설치되어 측면으로 비산되는 비산불티 방지를 위해 설치한 경우 바닥면으로부터 용접·용단 작업면 2 m 높이까지 설치하여야 한다.",
      "guideContext": "수직형 용접방화포 설치기준 (법령 근거 미확인)",
      "additionalDetail": "수직형 용접방화포(Welding Curtain) 적용",
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-014",
      "text": "금속 칸막이, 벽 등의 반대면에 가연물이 인접한 경우 비산된 용접불티의 고온의 온도가 금속 칸막이, 벽 등의 반대면으로 열전도 되거나 복사열이 전달되어 가연물이 발화될 수 있는 경우에는 금속 칸막이, 벽 등의 수직면에 수직형 용접방화포를 설치하여야 한다.",
      "guideContext": "수직형 용접방화포 설치기준 (법령 근거 미확인)",
      "additionalDetail": "수직형 용접방화포(Welding Curtain) 적용, 열전도·복사열 차단",
      "workProcessPhase": "용접방화포 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-015",
      "text": "용접방화포가 기름, 도료 등의 가연물에 오염되어 있는지 확인한다.",
      "guideContext": "용접방화포 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 사용 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-016",
      "text": "용접방화포의 굴곡 부위에 균열 등의 손상이 없는지 확인한다.",
      "guideContext": "용접방화포 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 사용 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-017",
      "text": "용접방화포에 관통 부분이 없는지 확인한다.",
      "guideContext": "용접방화포 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 사용 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-018",
      "text": "반복적인 사용으로 용접방화포 성능 상실 시 즉시 교체한다.",
      "guideContext": "용접방화포 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-019",
      "text": "용접방화포에서 발생된 유해분진에 노출되는 작업자에게 호흡기계 및 피부질환 등에 대한 특수건강진단과 작업환경측정(임시 및 단시간 작업 제외)을 실시한다.",
      "guideContext": "용접방화포 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-AG11-020",
      "text": "용접방화포 성능기준 시험성적서 등은 최근 2년 이내의 성적서로 관리하여야 한다.",
      "guideContext": "용접방화포 사용 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접방화포 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    }
  ],
