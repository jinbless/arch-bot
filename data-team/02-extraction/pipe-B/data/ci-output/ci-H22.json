  "checklistItems": [
    {
      "identifier": "CI-H22-001",
      "text": "야간작업은 연속하여 3일을 넘기지 않도록 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-002",
      "text": "야간반 근무를 모두 마친 후 아침반 근무에 들어가기 전 최소한 24시간 이상 휴식을 하도록 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-003",
      "text": "가정생활이나 사회생활을 배려할 때 주중에 쉬는 것보다는 주말에 쉬도록 하는 것이 좋으며 하루씩 띄어 쉬는 것보다는 주말에 이틀 연이어 쉬도록 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-004",
      "text": "교대작업자 특히 야간작업자는 주간작업자보다 연간 쉬는 날이 더 많이 있어야 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-005",
      "text": "근무반 교대방향은 아침반→저녁반→ 야간반으로 정방향 순환이 되게 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-006",
      "text": "아침반 작업은 너무 일찍 시작하지 않도록 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-007",
      "text": "야간반 작업은 잠을 조금이라도 더 오래 잘 수 있도록 가능한 한 일찍 작업을 끝내도록 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-008",
      "text": "교대작업일정을 계획할 때 가급적 근로자 개인이 원하는 바를 고려하도록 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-009",
      "text": "교대작업일정은 근로자들에게 미리 통보되어 예측할 수 있도록 한다.",
      "guideContext": "교대작업자의 작업설계 권장사항",
      "additionalDetail": null,
      "workProcessPhase": "교대작업 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-010",
      "text": "야간작업의 경우 작업장의 조도를 밝게 하고 작업장의 온도를 최고 27℃가 넘지 않는 범위에서 주간작업 때보다 약 1℃ 정도 높여 주어야 한다.",
      "guideContext": "교대작업자의 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "CI-H22-011",
      "text": "야간작업동안 사이잠(Napping)을 자게 하면 졸림을 방지하는 데 효과적이므로 특히 사고위험이 높은 작업에서는 짧은 사이잠을 자게 하는 것이 좋다. 사이잠을 위하여 수면실을 설치하되 소음 또는 진동이 심한 장소를 피하고 남・여용으로 구분하여 설치하도록 한다.",
      "guideContext": "교대작업자의 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-012",
      "text": "야간작업동안 대부분의 회사 식당이 문을 닫기 때문에 규칙적이고 적절한 음식이 제공될 수 있도록 배려하여야 한다. 야간작업자에게 적절한 음식이란 칼로리가 낮으면서 소화가 잘 되는 음식이다.",
      "guideContext": "교대작업자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-013",
      "text": "교대작업자에 대하여 주기적으로 건강상태를 확인하고 그 내용을 문서로 기록․보관한다.",
      "guideContext": "교대작업자의 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-014",
      "text": "교대작업에 배치할 근로자에 대하여 교대작업에 대한 교육과 훈련을 실시하여 근로자가 교대작업에 잘 적응할 수 있도록 지도해 준다.",
      "guideContext": "교대작업자의 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-015",
      "text": "교대작업자의 작업환경・작업내용・작업시간 등 직무스트레스요인조사와 뇌・심혈관질환 발병위험도평가(KOSHA GUIDE H-200-2018 참조)를 실시하고 그 결과에 따라 근로자 건강증진활동 지침(고용노동부고시제2015-104호 참조) 등을 참고하여 적절한 조치를 실시한다.",
      "guideContext": "교대작업자의 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-016",
      "text": "신규입사자를 산업안전보건법 시행규칙 별표12의2의 야간작업(2종)에 배치 시 배치예정업무에 대한 적합성 평가를 위하여 배치전 건강진단을 실시하고, 배치 후 6개월 이내 특수건강진단을 실시한다.",
      "guideContext": "교대작업자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": "야간작업(2종): 가. 6개월간 밤 12시부터 오전 5시까지의 시간을 포함하여 계속되는 8시간 작업을 월 평균 4회 이상 수행하는 경우, 나. 6개월간 오후 10시부터 다음날 오전 6시 사이의 시간 중 작업을 월 평균 60시간 이상 수행하는 경우",
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-017",
      "text": "재직자는 배치 후 첫 번째 특수건강진단(6개월 이내)을 받은 이후 12개월 주기로 검진을 진행한다.",
      "guideContext": "교대작업자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-018",
      "text": "다음과 같은 건강상태의 근로자를 교대작업에 배치하고자 할 때는 의사인 보건관리자 또는 산업의학전문의에게 의뢰하여 업무적합성평가를 받은 후 배치하도록 권장한다.",
      "guideContext": "교대작업자 업무적합성평가",
      "additionalDetail": "대상: 간질증상 조절 불량, 불안정 협심증/심근경색 병력, 스테로이드 의존 천식, 혈당 미조절 당뇨, 혈압 미조절 고혈압, 약물치료 곤란 환자, 반복성 위궤양, 과민성대장증후군, 만성 우울증, 교대제 부적응 경력자",
      "workProcessPhase": "근로자 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-019",
      "text": "야간작업자는 작업 후 가능한 한 빨리 잠자리에 든다.",
      "guideContext": "교대작업자의 개인 생활습관관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-020",
      "text": "개인 차이는 있지만 최소 6시간 이상 연속으로 수면을 취한다.",
      "guideContext": "교대작업자의 개인 생활습관관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-021",
      "text": "교대작업자는 잠들기 전 3시간 이내에 운동을 하지 않도록 한다. 지나치게 운동하면 잠을 빨리 깨게 되어 회복에 방해를 받기 때문이다.",
      "guideContext": "교대작업자의 개인 생활습관관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H22-022",
      "text": "야간작업 후 잠들기 전에는 과량의 식사, 커피 및 음주는 피하는 것이 좋다. 위에서 음식이 소화될 때까지의 부담이 수면을 방해할 수 있기 때문이다.",
      "guideContext": "교대작업자의 개인 생활습관관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    }
  ],
