      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D53-003",
      "term": "압력탱크",
      "definition": "설계압력이 103 ㎪을 초과하는 수용액 저장탱크를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D53-004",
