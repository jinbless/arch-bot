  "checklistItems": [
    {
      "identifier": "CI-A53-001",
      "text": "추출용액을 사용할 때는 실험실 후드 내부에서 진행하도록 하며, 호흡기 노출과 피부노출을 방지할 수 있는 보호구를 착용하여야 함.",
      "guideContext": "금속가공유 측정·분석 시 추출용액(테트라하이드로퓨란, 메탄올, 톨루엔) 취급 안전",
      "additionalDetail": "테트라하이드로퓨란은 자극, 두통 등을 발생시킬 수 있으며, 메탄올과 톨루엔은 자극, 중추신경장해 등을 일으킬 수 있음",
      "workProcessPhase": "시료 분석",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A53-002",
      "text": "추출과정 및 필터 건조과정은 흄후드 내에서 실시하도록 한다.",
      "guideContext": "금속가공유 측정·분석 시 추출용액 취급 환경",
      "additionalDetail": null,
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "9",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-A53-003",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": "분석에 사용하는 시약은 제조회사에서 표시하는 농도함량을 따른다",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-004",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 달수 있어야 하며, 화학분석 용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 달 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-005",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등 이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-006",
      "text": "핀셋이나 필터가 정전기를 나타낼 때에는 정전기 제거제 위를 반복 통과시켜 정전기를 제거한 후 무게를 재야한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": "마이크로 전자저울 사용에 있어 가장 큰 영향을 미치는 것 중의 하나는 필터와 저울간의 정전기에서 오는 저울의 안정화 문제이다",
      "workProcessPhase": "시료 채취전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-007",
      "text": "필터가 일정한 무게를 나타낼 때까지 반복하여 시료채취용 필터(W₁) 및 공시료 필터(B₁) 무게를 잰다(연속하여 잰 필터의 무게 차이가 10 ug 이내어야 하며 이를 평균하여 무게로 사용한다.)",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-008",
      "text": "2단 카세트에 패드와 함께 PTFE 필터를 장착시키고 카세트의 양쪽 구멍을 마개로 막고 카세트 연결부위는 시료채취 시 누설되지 않도록 셀룰로즈 밴드 등으로 밴딩 처리를 한다.",
      "guideContext": "금속가공유 측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-009",
      "text": "시료채취시 채취되는 입자상 물질의 무게가 약 2 mg을 초과하지 않도록 시료채취 시간을 조정하여 시료를 채취하도록 한다.",
      "guideContext": "금속가공유 측정·분석",
      "additionalDetail": "작업환경 중의 금속가공유 농도가 0.5 mg/m³일 경우 최소한 1,000 L 시료채취가 필요함",
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-010",
      "text": "동일 현장에서 채취되는 시료 세트당 최소 5개의 현장 공시료를 분석실에 제출하여야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": "현장 공시료의 경우 시료채취를 하지 않는다는 점을 제외하고는 현장 시료와 모든 면에서 동일하게 취급해야 한다",
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-011",
      "text": "시료는 냉장보관하고, 시료채취 후 2주 이내에 분석하여야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-012",
      "text": "데시케이터 안에 보관하는 시간은 2시간을 초과하지 않도록 해야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": "카세트 마개를 열고 카세트를 황산칼슘이 들어 있는 데시케이터 안에 넣어 수분을 제거한다",
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-013",
      "text": "무게를 달기 전에 전자저울은 반드시 0점을 맞추어야 하며, 시료채취 전, 시료채취 후, 그리고 시료추출 후에 사용되는 모든 전자저울은 동일한 것이어야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-014",
      "text": "전자저울은 주기적으로 검·교정을 실시한 후 사용하여야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-015",
      "text": "진공이 걸린 상태에서는 절대로 필터를 추출 깔대기로부터 꺼내서는 안 되며, 필터의 건조시간은 최소 2시간 이상이 되도록 하여야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-016",
      "text": "회수율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": "회수율간의 차이가 크고 변이가 심하여 일정성이 없으면 정확한 보정이 될 수가 없다. 따라서 그 원인을 찾아 교정하고 다시 실험을 실시해야한다.",
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-017",
      "text": "검량선은 시료 분석조건과 주입방법에 따라 작성하고 검량선이 적정하다고 판정하면 시료를 분석한다. 검량선에 사용된 표준용액의 농도보다 높은 시료의 경우는 희석하여 재분석 하거나 시료농도를 포함할 수 있는 표준용액을 추가로 제조하여 검량선을 다시 작성한다. 검량선의 적정성은 제시된 분석기기의 매뉴얼을 참조하거나 상관계수가 0.99이상의 것을 사용하도록 한다.",
      "guideContext": "금속가공유 측정·분석",
      "additionalDetail": "검량선은 분석할 시료의 농도를 포함해야 한다",
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-018",
      "text": "표준용액, 회수율 등에 사용되는 시약은 같은 롯트(Lot)번호를 가진 것을 사용하여야 한다.",
      "guideContext": "금속가공유 측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-019",
      "text": "시료의 시험, 바탕시험 및 표준액에 대한 일련의 동일시험을 행할 때 사용하는 시약 또는 시액은 동일 롯트(LOT)로 조제된 것을 사용한다.",
      "guideContext": "금속가공유 측정·분석",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A53-020",
      "text": "현장에서 사용 중인 금속가공유에 대한 추출용매의 용해성 시험을 위해 벌크시료를 10 mL 정도 채취하여 PTFE 마개가 달린 유리재질의 용기에 담는다.",
      "guideContext": "금속가공유 측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A53-001",
      "term": "밀폐",
      "definition": "취급 또는 보관상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A53-002",
      "term": "밀봉",
      "definition": "취급 또는 보관상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A53-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A53-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ±10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A53-005",
      "term": "즉시",
      "definition": "시험조작 중 30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A53-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A53-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A53-008",
      "term": "회수율",
      "definition": "채취한 금속 등의 분석 값을 보정하는데 필요한 것으로, 시료채취매체와 동일한 재질의 여과지에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
