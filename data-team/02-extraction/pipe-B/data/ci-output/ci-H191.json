  "checklistItems": [
    {
      "identifier": "CI-H191-001",
      "text": "보건관리자는 해당 종사자의 신원 및 건강 상황을 확인하고, 연령이 만 20세 미만이거나 만 65세 이상인 경우, 임신부, 신분증(주민등록증 등) 미소지자, 신원확인 및 연락처 확인 불가능자(외국인), 38℃이상 고열 등의 감기증상이 있는 자, 폐 질환·심장 질환·당뇨·신장 질환·만성간 질환·악성종양·면역 저하증 및 혈색소병증(hemoglobinopathy) 환자로 진단받은 자는 살처분 업무에 종사하지 않도록 한다.",
      "guideContext": "살처분 매몰처리 작업자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "살처분 참여자 선별",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-002",
      "text": "조절이 되지 않는 고혈압 환자(3기 고혈압, 180/110 이상)는 야근, 철야 등 장시간 근로를 제한할 수 있다.",
      "guideContext": "살처분 매몰처리 작업자 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "살처분 참여자 선별",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-003",
      "text": "보건관리자는 종사자들이나 예비 종사자들에게 건강장해의 이해 및 예방방법에 대하여 실제 살처분을 하기 전이나 평상시에, 문서나 기타 시청각 자료 등을 통해 교육하며, 살처분 작업 시 필요한 도구나 시설 구비 시 아래에 열거된 사항을 참고한다.",
      "guideContext": "살처분 매몰처리 작업자 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-004",
      "text": "살처분 작업자들은 감염된 조류나 물건과 접촉하는 동안 내내 매일 항바이러스제를 복용한다. 현재 오셀타미비르 인산염(Oseltamivir phosphate, 상품명 타미플루)이 가장 적합하며 1일 1회 1알씩 살처분 완료 후 7일간 복용한다.",
      "guideContext": "살처분 매몰처리 인체감염 예방 (법령 근거 미확인)",
      "additionalDetail": "복용 시 구토 등 부작용이 있을 수 있으며 이때는 보건소로 연락한다.",
      "workProcessPhase": "인체감염 예방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-005",
      "text": "타미플루 복용 종료 후 2주 후까지 헌혈을 하지 않는다.",
      "guideContext": "살처분 매몰처리 인체감염 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인체감염 예방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-006",
      "text": "살처분 작업자들은 당해 인플루엔자 예방 접종을 시행하도록 권고한다.",
      "guideContext": "살처분 매몰처리 인체감염 예방",
      "additionalDetail": "항체를 생성하는 데에는 적어도 2주 이상 걸리며, 효과는 6개월 정도 지속된다.",
      "workProcessPhase": "인체감염 예방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-007",
      "text": "인플루엔자 백신은 항체를 생성하는 데에 적어도 2주 이상 걸리므로 살처분 시작 2주 전에 접종을 권고한다.",
      "guideContext": "살처분 매몰처리 인체감염 예방",
      "additionalDetail": null,
      "workProcessPhase": "인체감염 예방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-008",
      "text": "살처분 작업자들은 작업 중 호흡기 증상의 발생 시 가족이나 타인과의 접촉을 최소화 하고 관할지역 보건소 또는 1339(질병관리 본부)로 신고한다.",
      "guideContext": "살처분 매몰처리 인체감염 예방 (법령 근거 미확인)",
      "additionalDetail": "감염증상: 38도 이상의 열, 기침, 인후 통증, 결막염, 근육통",
      "workProcessPhase": "인체감염 예방",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-009",
      "text": "방진 보안경, 일반 보안경 이상 중 되도록 완전 밀폐형 고글을 고른다. 구제역과 같이 바이러스의 사람 감염 가능성이 없는 경우에는 통기성 고글을 착용할 수 있다.",
      "guideContext": "살처분 매몰처리 보호장구 선택",
      "additionalDetail": "안경 착용자는 안경 위에 착용하는 고글을 쓰거나 도수 처리된 고글을 사용한다.",
      "workProcessPhase": "보호장구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-010",
      "text": "렌즈 착용 자는 될 수 있으면 렌즈를 쓰지 않으며, 도수 처리된 고글을 사용하는 것을 권고한다.",
      "guideContext": "살처분 매몰처리 보호장구 선택",
      "additionalDetail": null,
      "workProcessPhase": "보호장구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-011",
      "text": "올바른 마스크를 선택 후 밀착검사 또는 밀착도 자가 점검을 시행한다.",
      "guideContext": "살처분 매몰처리 보호장구 선택",
      "additionalDetail": "마스크 선택 요령은 KOSHA GUIDE H-82-2015를 참조한다.",
      "workProcessPhase": "보호장구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H191-012",
      "text": "구제역 살처분 시 가스 질식법(질소가스 또는 이산화탄소)에는 방독 방진 겸용 마스크 또는 방진 마스크(N95/KP94 등)를 단독 착용하고, 타격법·약물법에는 방진 마스크를 단독 착용한다. 조류 인플루엔자 살처분 시 가스 질식법에는 방독 방진 겸용 마스크 또는 방진 마스크를 단독 착용한다.",
      "guideContext": "살처분 매몰처리 보호장구 선택",
      "additionalDetail": null,
      "workProcessPhase": "보호장구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H191-013",
      "text": "D급(바이러스 불 침투) 보호복을 선택한다.",
      "guideContext": "살처분 매몰처리 보호장구 선택",
      "additionalDetail": null,
      "workProcessPhase": "보호장구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H191-014",
      "text": "라텍스로 된 이중재질의 1회용 장갑을 속장갑으로 사용한다. 고무로 된 재활용 가능한 장갑(18 mil 또는 그 이상)을 겉 장갑으로 사용한다.",
      "guideContext": "살처분 매몰처리 보호장구 선택",
      "additionalDetail": "민감하거나 알레르기가 있는 경우 목장갑을 안에 낄 수 있다.",
      "workProcessPhase": "보호장구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H191-015",
      "text": "1회용 장화 커버나 소독이 가능한 장화(목이 보호복의 바지 아랫단 위로 올라오는 것)를 사용한다.",
      "guideContext": "살처분 매몰처리 보호장구 선택",
      "additionalDetail": null,
      "workProcessPhase": "보호장구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H191-016",
      "text": "살처분 작업장과 접근성이 좋은 곳에 적정한 간이 휴게 공간 및 샤워시설을 설치한다.",
      "guideContext": "살처분 매몰처리 작업환경",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H191-017",
      "text": "휴게 공간은 침대, 소파 등 누워서 쉴 공간을 적어도 해당 종사자 인원의 1/3 이상이 동시에 쉴 수 있어야 한다.",
      "guideContext": "살처분 매몰처리 작업환경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-018",
      "text": "샤워시설은 전신을 씻을 수 있는 곳과 손 세정을 할 수 있는 곳을 분리하여 설치한다.",
      "guideContext": "살처분 매몰처리 작업환경",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H191-019",
      "text": "원액을 희석할 때 반드시 고무장갑과 마스크를 착용한다.",
      "guideContext": "소독제 취급 작업",
      "additionalDetail": null,
      "workProcessPhase": "소독제 혼합",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H191-020",
      "text": "고농도일수록 효과가 좋다는 이유로 사용 농도를 지키지 않을 경우에는 자극성이 강해 살포시 피해를 줄 수 있으므로 반드시 희석배수에 따라서 적정한 농도로 사용한다.",
      "guideContext": "소독제 취급 작업",
      "additionalDetail": null,
      "workProcessPhase": "소독제 혼합",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H191-021",
      "text": "소독제의 살포는 가능한 바람을 등진 방향으로 작업하는 것이 좋다.",
      "guideContext": "소독제 취급 작업",
      "additionalDetail": null,
      "workProcessPhase": "소독제 살포",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-022",
      "text": "장갑을 끼고 있다 하더라도 소독제가 묻어있기 때문에 소독제가 담배에 묻어 입안으로 흡수될 수 있으므로, 흡연을 하고자 한다면 반드시 손과 얼굴을 비누로 씻고 입안을 한 번 헹군 다음 흡연한다.",
      "guideContext": "소독제 취급 작업",
      "additionalDetail": null,
      "workProcessPhase": "소독제 살포",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H191-023",
      "text": "땀을 닦은 수건은 비닐 주머니에 따로 넣어 재사용하지 않는다.",
      "guideContext": "소독제 취급 작업 (법령 근거 미확인)",
      "additionalDetail": "또는 아이스박스에 얼린 수건을 몇 개 준비해서 땀을 닦는다.",
      "workProcessPhase": "소독제 살포",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-024",
      "text": "소독제를 섭취 시 입에 묻었거나 입안으로 들어갔으면 즉시 물로 양치를 하며, 항상 물을 담은 물통을 준비해 놓는다. 소독제를 마셨을 경우에는 물이나 식염수를 2-3잔 먹고 구토를 하도록 한다. 위의 내용물이 나오지 않을 때까지 반복한다. 구토를 하게 한 다음 장으로 들어간 소독제가 흡수되지 않도록 흡착제(활성탄도는 목초액 등)를 복용한다.",
      "guideContext": "소독제 급성 중독 시 응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H191-025",
      "text": "소독제 흡입 시 즉시 신선한 공기가 있는 곳으로 옮기고 옷을 헐겁게 하고 심호흡을 시킨다. 호흡이 약하고 침이 많이 고였을 때는 중독자를 옆으로 눕여서 머리를 옆으로 돌려 침이 입 밖으로 나오기 쉽도록 한다. 호흡이 멈추었을 경우에는 심폐 소생술을 시작한다.",
      "guideContext": "소독제 급성 중독 시 응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H191-026",
      "text": "소독제 피부접촉 시 접촉된 피부를 15분 이상 비누로 잘 씻어내어 소독제를 제거한다. 방수가 안 되는 옷에 소독제가 묻었을 때는 즉시, 속옷까지 전부 벗어서 피부를 비누로 씻은 다음 다른 옷으로 갈아입는다.",
      "guideContext": "소독제 급성 중독 시 응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H191-027",
      "text": "소독제 눈 접촉 시 적어도 15분 이상 깨끗한 흐르는 물로 눈을 씻는다. 가능하면 세안기를 준비해놓고 즉시 물로 닦는다. 눈을 절대로 손으로 비비지 않도록 하고, 거즈를 가볍게 눈에 대고 병원을 방문한다.",
      "guideContext": "소독제 급성 중독 시 응급처치",
      "additionalDetail": null,
      "workProcessPhase": "응급처치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    },
    {
      "identifier": "CI-H191-028",
      "text": "보건관리자 및 산업보건의는 방역 작업 종사자들이 구제역 등 방역작업을 수행하며 소독제 등에 노출되어 발생할 수 있는 건강장해를 예방하기 위하여 평소 근로자들이 안전 의식을 가질 수 있도록 교육한다.",
      "guideContext": "소독제 취급 작업",
      "additionalDetail": null,
      "workProcessPhase": "소독제 살포",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H191-029",
      "text": "실제 방역작업을 실시할 경우에는 살포 전, 중, 후에 따른 주의사항들을 숙지시키도록 한다.",
      "guideContext": "소독제 취급 작업",
      "additionalDetail": "자가 체크리스트는 KOSHA GUIDE H-94-2012의 <표4>를 참조한다.",
      "workProcessPhase": "소독제 살포",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H191-030",
      "text": "살처분 시 사용되는 가스 중 이산화탄소 가스는 사람에게도 중독을 일으킬 수 있으므로 살처분이 끝난 후 피복한 비닐을 제거하고 30분 이상 충분히 환기 시킨 후 다음 작업을 수행한다.",
      "guideContext": "살처분 가스(CO2) 건강장해 예방",
      "additionalDetail": null,
      "workProcessPhase": "가스 살처분",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-H191-031",
      "text": "급히 가스 처리한 장소에 출입을 하여야 할 경우 호흡 보호구(방독 방진 겸용 마스크)를 착용한다.",
      "guideContext": "살처분 가스(CO2) 건강장해 예방",
      "additionalDetail": null,
      "workProcessPhase": "가스 살처분",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H191-032",
      "text": "이산화탄소 가스 주요증상이 나타나는 경우에는 즉시 일을 중단하고 살처분 장소에서 벗어난다.",
      "guideContext": "살처분 가스(CO2) 건강장해 예방",
      "additionalDetail": null,
      "workProcessPhase": "가스 살처분",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-H191-033",
      "text": "준비된 산소마스크를 이용, 신선한 공기를 흡입한다.",
      "guideContext": "살처분 가스(CO2) 건강장해 예방",
      "additionalDetail": null,
      "workProcessPhase": "가스 살처분",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-H191-034",
      "text": "살처분 작업이 시작됨과 동시에 즉시 직무 스트레스 회복 센터를 구성하여 면담, 고위험군 선별, 외부 의뢰, 스트레스 관리 교육 등 살처분 작업자에게 필요한 서비스를 제공할 수 있는 계획을 수립한다.",
      "guideContext": "직무 스트레스 예방 (법령 근거 미확인)",
      "additionalDetail": "외부 전문가 집단과의 협력이 가능해야 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-035",
      "text": "센터 내에 핫라인을 설치하고 운영을 즉각 홍보한다. 살처분 업무가 공식적으로 종료 될 때까지 운영한다.",
      "guideContext": "직무 스트레스 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-036",
      "text": "심리상담은 살처분 업무를 수행한 자 모두를 대상으로 실시한다. 시행 시기는 각자의 당해 살처분 업무 수행을 최종 마친 직후부터 1주 이내에 시행한다.",
      "guideContext": "직무 스트레스 예방 (법령 근거 미확인)",
      "additionalDetail": "면담도구는 KOSHA GUIDE H-36-2011의 부록 <표 1>, <표 2>를 이용한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-037",
      "text": "1차 선별검사에서 이상을 보인 경우 2차 선별검사를 이용하여 고위험군을 선별한다. 고위험군 선별 후에는 살처분 작업의 영향이 큰 것으로 판단하고, 연계된 외부 전문가에게 의뢰한다.",
      "guideContext": "직무 스트레스 예방 (법령 근거 미확인)",
      "additionalDetail": "고위험군 선별 도구는 KOSHA GUIDE H-36-2011의 부록 <표 3>에서 <표 6>을 이용한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-038",
      "text": "작업 전 굴착구간 사전조사 실시 후 작업계획서를 작성한다.",
      "guideContext": "매몰 작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전조사 및 작업계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-039",
      "text": "건설기계 진입로 확보, 부등 침하방지 및 신호수를 배치한다.",
      "guideContext": "매몰 작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건설기계 및 자재반입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-040",
      "text": "건설기계 운전원 유자격 여부를 확인한다.",
      "guideContext": "매몰 작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건설기계 및 자재반입",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-041",
      "text": "매몰 장소 굴착 작업 시 토질에 적합한 굴착 기울기를 준수한다.",
      "guideContext": "매몰 작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "매몰 장소 굴착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-042",
      "text": "굴착토사는 선단부에서 수평방향으로 굴착 깊이 이상 이격하여 적치한다.",
      "guideContext": "매몰 작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "매몰 장소 굴착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-043",
      "text": "굴착기 버켓 장착 후 탈락 방지 핀 등 사전 점검을 실시한다.",
      "guideContext": "매몰 작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "매몰 장소 굴착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-044",
      "text": "굴착 선단부에는 추락방지를 위해 안전 난간 설치 또는 접근 방지책을 설치한다.",
      "guideContext": "매몰 작업 안전보건",
      "additionalDetail": null,
      "workProcessPhase": "매몰 장소 굴착",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FALL-001",
        "SR-FALL-007"
      ]
    },
    {
      "identifier": "CI-H191-045",
      "text": "굴착 면 하부 이동용 가설통로를 확보한다.",
      "guideContext": "매몰 작업 안전보건",
      "additionalDetail": null,
      "workProcessPhase": "혼합토 도포 및 비닐설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-PASSAGE-003"
      ]
    },
    {
      "identifier": "CI-H191-046",
      "text": "굴착 선단부에는 전락 방지 토사를 설치한다.",
      "guideContext": "매몰 작업 안전보건",
      "additionalDetail": null,
      "workProcessPhase": "혼합토 도포 및 비닐설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FALL-007"
      ]
    },
    {
      "identifier": "CI-H191-047",
      "text": "비닐 설치 시 추락방지를 위해 안전대 부착 설비에 안전대 걸고 작업한다.",
      "guideContext": "매몰 작업 안전보건",
      "additionalDetail": null,
      "workProcessPhase": "혼합토 도포 및 비닐설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-H191-048",
      "text": "소각작업시 작업복 등 목적물 이외의 다른 용기등과 함께 소각되지 않도록 확인을 실시한다.",
      "guideContext": "매몰 작업 안전보건 (법령 근거 미확인)",
      "additionalDetail": "부탄가스통 등 위험 설비와 함께 소각하면 폭발 위험이 있다.",
      "workProcessPhase": "마무리 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-049",
      "text": "수면위생에 대하여 교육하고 필요한 경우 의사에 의한 진료를 받게 한다.",
      "guideContext": "장시간 근로 건강장해 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H191-050",
      "text": "근로자의 1개월간 근로시간을 파악하여 주당 평균 52시간을 초과하고 극심한 육체적 피로나 정신적 불안, 수면장애 및 근로자가 원하는 경우 직업환경의학 전문의에게 의뢰한다.",
      "guideContext": "장시간 근로 건강장해 예방 (법령 근거 미확인)",
      "additionalDetail": "기타 사항은 KOSHA GUIDE H-47-2011을 따른다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H191-001",
      "term": "가축전염병",
      "definition": "<부록 1>의 제1종 가축전염병, 제2종 가축전염병 및 제3종 가축전염병을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H191-002",
      "term": "구제역(FMD)",
      "definition": "소, 돼지, 양, 염소, 사슴 및 야생 반추류 등과 같이 발굽이 둘로 갈라진 우제류 동물에서 체온이 급격히 상승하고 입, 혀, 발굽 또는 젖꼭지 등에 물집이 생기며, 식욕이 저하되어 심하게 앓거나 죽게 되는 급성 전염병을 말한다. 자세한 정의나 감염경로, 방역 등에 대한 사항은 <부록 2>에 정리되어 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H191-003",
      "term": "조류 인플루엔자(AI)",
      "definition": "닭, 오리, 야생 조류에서 조류 인플루엔자 바이러스(Avian influenza virus)의 감염으로 인해 발생하는 급성 바이러스성 전염병이며 드물게 사람에게서도 감염증을 일으키는 고병원성 바이러스(H5N1, H7N9, H5N8 등)와 저병원성 바이러스를 포함한다. 자세한 정의나 감염경로, 인체 감염, 방역 등에 대한 사항은 <부록 2>에 정리되어 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H191-004",
      "term": "살처분 매몰처리 작업자",
      "definition": "전염병이 퍼지는 것이 우려되는 지역 안에 있는 감수성 가축을 죽이고 매몰하는 작업을 하는 근로자를 말한다. <부록 3>, <부록 4>에 방역체계도가 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H191-005",
      "term": "소독",
      "definition": "전염병 병원체를 사멸시키기 위해 실시하는 작업을 뜻하며, 동물, 가축분뇨 또는 동물 유래의 생산물 등에 의해 직접 혹은 간접적으로 오염될 수 있는 동물, 사람, 시설, 수송차량 및 기타 대상물에 대해 실시한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
