  "checklistItems": [
    {
      "identifier": "CI-CC14-001",
      "text": "공정안전보고서에 취급·저장하고 있거나 취급·저장하려는 유해·위험물질의 종류 및 수량을 포함하여야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조제1항제1호가목",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-002",
      "text": "공정안전보고서에 유해·위험물질에 대한 물질안전보건자료를 포함하여야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조제1항제1호나목",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-003",
      "text": "공정안전보고서에 유해하거나 위험한 설비의 목록 및 사양을 포함하여야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조제1항제1호다목",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-004",
      "text": "공정안전보고서에 유해하거나 위험한 설비의 운전방법을 알 수 있는 공정도면을 포함하여야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조제1항제1호라목",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-005",
      "text": "공정안전보고서에 각종 건물·설비의 배치도를 포함하여야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조제1항제1호마목",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-006",
      "text": "공정안전보고서에 폭발위험장소 구분도 및 전기단선도를 포함하여야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조제1항제1호바목",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-007",
      "text": "공정안전보고서에 위험설비의 안전설계·제작 및 설치 관련 지침서를 포함하여야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조제1항제1호사목",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-008",
      "text": "공정흐름도(Process Flow Diagram, PFD)에는 주요 동력기계, 장치 및 설비의 표시 및 명칭, 주요 계장설비 및 제어설비, 물질 및 열 수지, 운전온도 및 운전압력 등의 사항들이 포함되어야 한다.",
      "guideContext": "공정흐름도 작성 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "고용노동부고시 공정안전보고서의 제출·심사·확인 및 이행상태평가 등에 관한 규정 제22조제2항",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-009",
      "text": "공정흐름도에는 공정설계 개념을 파악하는데 필요한 기본적인 제조공정 개요와 공정흐름, 공정제어의 원리, 제조설비의 종류 및 기본사양 등이 표현되어야 한다.",
      "guideContext": "공정흐름도(PFD) 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-010",
      "text": "공정흐름도에 회분식 공정인 경우에는 작업순서 및 작업시간을 포함하여야 한다.",
      "guideContext": "공정흐름도(PFD) 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-011",
      "text": "제조공정을 한눈에 알아볼 수 있도록 정확하고 알기 쉽게 만들어져야 하며 가능한 한 전체 시스템을 한 장에 나타내는 것이 좋다.",
      "guideContext": "공정흐름도(PFD) 작성",
      "additionalDetail": "공정설비가 복잡한 경우 여러 장으로 분할하여 작성할 수 있다.",
      "workProcessPhase": "도면 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-012",
      "text": "공정흐름 순서에 따라 좌측에서 우측으로 장치 및 동력기계를 배열하고 물질수지와 열수지는 도면의 하단부에 표시한다.",
      "guideContext": "공정흐름도(PFD) 작성",
      "additionalDetail": null,
      "workProcessPhase": "도면 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-013",
      "text": "도면에는 공정 또는 지역 등을 포함하여 고유의 도면번호를 부여한다.",
      "guideContext": "공정흐름도(PFD) 작성",
      "additionalDetail": null,
      "workProcessPhase": "도면 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-014",
      "text": "연속적인 공정벤트나 드레인도 빠짐없이 포함시켜 원료 및 부원료의 총 투입량과 중간 손실을 포함한 제품의 총 생산량 등이 일치하도록 하여야 한다.",
      "guideContext": "공정흐름도(PFD) 작성 - 물질수지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "물질수지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC14-015",
      "text": "다품종의 제품을 생산하는 공정인 경우에는 원료, 제품 등 구성성분 및 운전조건의 변경에 따라 공정흐름도와 물질수지를 별도로 작성하여야 한다.",
      "guideContext": "공정흐름도(PFD) 작성 - 물질수지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "물질수지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2.5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC14-001",
      "term": "공정흐름도 (PFD, Process Flow Diagram)",
      "definition": "공정계통과 장치설계기준을 나타내주는 도면이며 주요 장치, 장치간의 공정연관성, 운전조건, 운전변수, 물질·에너지 수지, 제어 설비 및 연동장치 등의 기술적 정보를 파악 할 수 있는 도면을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC14-002",
      "term": "공정배관계장도 (P&ID, Piping & Instrument Diagram)",
      "definition": "공정의 시운전(Start-up operation), 정상운전(Normal operation), 운전정지(Shutdown) 및 비상운전(Emergency operation) 시에 필요한 모든 공정장치, 동력기계, 배관, 공정제어 및 계기등을 표시하고 이들 상호간에 연관 관계를 나타내 주며 상세설계, 건설, 변경, 유지보수 및 운전 등을 하는 데 필요한 기술적 정보를 파악 할 수 있는 도면을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC14-003",
      "term": "물질수지 (Material balance)",
      "definition": "공정중에 사용되는 주원료 및 부원료의 양과 제품이나 부산물의 양 또는 폐가스, 폐액 등으로 배출되는 손실량간의 수지계산을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC14-004",
      "term": "열수지 (Heat balance)",
      "definition": "원하는 공정조건을 충족시키기 위하여 가열, 냉각시키거나 화학반응의 결과로 반응열이 발생 또는 흡수되는 등 공정중 물질계의 상태변화에 따른 열 및 에너지 변화량에 대한 수지 계산을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
