  "checklistItems": [
    {
      "identifier": "CI-P143-001",
      "text": "용해로의 설치 시에는 제조자가 제공한 검지기 설치 매뉴얼을 충분히 이해하고, 그 방법을 준수하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-002",
      "text": "건물의 재질은 불연성이어야 한다.",
      "guideContext": "용해로 설치 건물 요건",
      "additionalDetail": "수증기 폭발 및 화재 예방",
      "workProcessPhase": "용해로 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-003",
      "text": "바닥은 물이 고이지 않는 구조이어야 한다.",
      "guideContext": "용해로 설치 건물 요건 (법령 근거 미확인)",
      "additionalDetail": "수증기 폭발 예방",
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-004",
      "text": "지붕·벽·창 등은 빗물이 새어들지 않는 구조이어야 한다.",
      "guideContext": "용해로 설치 건물 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-005",
      "text": "용탕이 담긴 용해로, 래들 등이 전도, 파손 및 넘쳐서 누출된 용탕이 건물의 주요 구조부와 직접 접촉되지 않도록 내화조치 등을 하여야 한다.",
      "guideContext": "용해로 설치 건물 요건",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-006",
      "text": "유해가스 및 중금속 흄을 배출할 수 있는 전체환기설비를 설치하여야 한다.",
      "guideContext": "용해로 설치 건물 요건",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-P143-007",
      "text": "용탕 취급설비는 작업자가 고열로부터 가능한 멀리 떨어져 안전하게 작업할 수 있도록 자동원격조작설비를 설치하거나, 방호벽, 스크린 등을 격리설비 설치하여 작업자가 용탕으로부터 충분한 안전거리를 유지하여야 한다.",
      "guideContext": "용해로 설치 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-P143-008",
      "text": "용해로 및 래들은 제작 및 보수를 한 후에는 필요시 열응력을 제거하기 위하여 KS B 6750 \"압력용기－설계 및 제조 일반\"에서 규정한 대로 열처리를 하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-009",
      "text": "경보장치는 작업자가 경고음을 잘 청취할 수 있고, 경광등은 잘 보이는 곳에 설치하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-010",
      "text": "전기기계기구 및 전선은 내열성이 충분한 것을 사용하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-011",
      "text": "전원공급장치는 분진이 들어가지 않는 방진성능이 있어야 하고, 문을 열면 자동으로 전원이 차단될 수 있도록 연동장치를 설치하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-012",
      "text": "용해로, 래들, 경동장치 등의 설비는 작업자가 끼임, 떨어짐 등에 의한 재해를 예방하기 위하여 안전난간, 안전덮개, 안전거리 유지 등의 적절한 조치를 하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-013",
      "text": "용해로에서 발생하는 먼지, 유해화학물질 및 중금속 흄 등을 안전하게 처리할 수 있도록 국소배기장치를 설치하여야 한다.",
      "guideContext": "용해로 설치 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-P143-014",
      "text": "용탕의 상태는 장시간 확인하는 작업장소에는 폐쇄회로 TV 등을 설치하거나 차광스크린을 설치하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": "유해광선 노출 방지",
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-015",
      "text": "정전 등의 비상시 즉시 사용이 가능하고, 30분 이상 지속적인 공급이 가능한 예비동력원을 설치하여야 한다.",
      "guideContext": "용해로 설치 일반사항",
      "additionalDetail": "비상용 냉각수는 가능한 고가수조 또는 엔진 구동에 의한 공급방법을 적극 권장",
      "workProcessPhase": "용해로 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-P143-016",
      "text": "시운전 전까지 안전운전절차서, 유지보수절차서 및 비상시 조치사항을 작성하고, 관련 작업자에게 교육을 하여야 한다.",
      "guideContext": "용해로 설치 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-017",
      "text": "용해로 및 래들은 운전 및 정비 중에 넘어지지 않도록 안정된 구조로 설치하여야 한다.",
      "guideContext": "용해로 누출방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-018",
      "text": "내화물은 운전 중에 과열되지 않도록 브리징, 이물질 혼입이 되지 않도록 하여야 한다.",
      "guideContext": "용해로 누출방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-019",
      "text": "용해로는 장입재가 중간에 잘 걸리지 않는 구조이어야 한다.",
      "guideContext": "용해로 누출방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-020",
      "text": "경동 장치의 부근에 물이 체류되어 있지 않는 구조이어야 한다.",
      "guideContext": "용해로 경동장치 누출방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-021",
      "text": "작업자의 신체 일부가 끼이지 않도록 안전덮개 등을 설치하여야 한다.",
      "guideContext": "용해로 경동장치 누출방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-022",
      "text": "수동 조작장치는 작업자가 조작할 때만 작동될 수 있도록 self-locking gear 방식으로 설치하여야 한다.",
      "guideContext": "용해로 경동장치 누출방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-023",
      "text": "자동 조작장치는 작업자가 스위치를 누르고 있을 때만 작동하도록 하여야 한다.",
      "guideContext": "용해로 경동장치 누출방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-024",
      "text": "정전 또는 설비 고장시 안전한 위치로 방향을 전환하기 위한 비상전원 공급 등의 설비를 설치하여야 한다.",
      "guideContext": "용해로 경동장치 누출방지",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-P143-025",
      "text": "용탕 배출 피트의 최대 부피는 용해로 최대 용량의 1.5배 이상이여야 한다.",
      "guideContext": "용해로 확산방지 (법령 근거 미확인)",
      "additionalDetail": "수증기 폭발 예방을 위한 피트 설치 요건",
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-026",
      "text": "용해로 바로 밑에서 피트까지 용탕이 잘 흐를 수 있는 구조이어야 한다.",
      "guideContext": "용해로 확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-027",
      "text": "피트 내부는 내화벽돌을 설치하여야 한다.",
      "guideContext": "용해로 확산방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-028",
      "text": "지하수가 내부로 새어들지 않도록 하여야 한다.",
      "guideContext": "용해로 확산방지 피트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-029",
      "text": "운전 중에 외부에서 빗물 등이 유입되지 않도록 격벽 등을 설치하여야 한다.",
      "guideContext": "용해로 확산방지 피트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-030",
      "text": "작업자 출입이 용이하게 계단 등을 설치하여야 한다.",
      "guideContext": "용해로 확산방지 피트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-031",
      "text": "냉각수가 새지 않고, 점검이 용이하게 설치하여야 한다.",
      "guideContext": "용해로 폭발방지 냉각수 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-032",
      "text": "작동 중 내부에 공기 또는 냉각수의 체류 등이 생기지 않는 구조로 하여야 한다.",
      "guideContext": "용해로 폭발방지 냉각수 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-033",
      "text": "고열에 노출되는 부분은 금속재의 재료로 된 것을 설치하여야 한다.",
      "guideContext": "용해로 폭발방지 냉각수 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-034",
      "text": "열팽창에 의한 과도한 압력상승을 방지하기 위하여 안전밸브를 설치하거나 배관 한쪽이 항상 열리는 구조이어야 한다.",
      "guideContext": "용해로 폭발방지 냉각수 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-035",
      "text": "급배수용 배관·밸브·계기 등은 경동장치·천정 선회장치 등이 기기의 작동부분 부근, 운반통로의 부근 등에는 설치해서는 안된다.",
      "guideContext": "용해로 폭발방지 냉각수 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-036",
      "text": "부식을 방지할 적절한 대책을 강구하여야 한다.",
      "guideContext": "용해로 폭발방지 냉각수 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-037",
      "text": "냉각수가 공급되지 않으면 경보하고, 가열을 중지토록 하여야 한다.",
      "guideContext": "용해로 폭발방지 냉각수 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-038",
      "text": "내화물은 용해금속, 용해 온도, 용해시간, 보온유지, 교반 정도, 첨가제, 축로방법 등을 고려하여 용해로, 래들 및 내화물 제조자와 상의하여 결정하여야 한다.",
      "guideContext": "용해로 폭발방지 내화물 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-039",
      "text": "내화물 제조자가 요구하는 시방서를 준수하여 설치하여야 한다.",
      "guideContext": "용해로 폭발방지 내화물 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-040",
      "text": "내화물 소결절차를 준수하여야 한다.",
      "guideContext": "용해로 폭발방지 내화물 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-041",
      "text": "밀도가 낮은 곳이나 공극이 있는 곳은 운전 중에 침식되어 용탕이 누출될 위험이 있으므로 균일하게 축로 되어야 한다.",
      "guideContext": "용해로 폭발방지 내화물 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-042",
      "text": "내화벽돌 등은 보관 중에 변형되지 않도록 제조자가 요구하는 방법으로 보관하여야 한다.",
      "guideContext": "용해로 폭발방지 내화물 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-043",
      "text": "내화물 손상 등으로 용탕이 코일 및 냉각수 배관 등에 닿거나 근접하면 전원을 차단할 수 있도록 누전감지장치를 설치하여야 한다.",
      "guideContext": "용해로 폭발방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해로 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-044",
      "text": "제조자가 제공한 안전운전절차서를 잘 이해하고, 조작 방법을 잘 아는 숙련된 작업자가 조작하여야 한다.",
      "guideContext": "용해작업 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-045",
      "text": "전기설비는 일정한 자격이 있는 전문가만이 문을 열거나 점검하여야 한다.",
      "guideContext": "용해작업 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-046",
      "text": "용탕 배출 피트 근처에는 항상 가연성이나 인화성 물질이 없어야 한다.",
      "guideContext": "용해작업 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-047",
      "text": "장입작업은 브리징이 발생하지 않도록 하여야 한다.",
      "guideContext": "용해작업 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장입작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-048",
      "text": "용탕을 래들에 옮길 때는 래들이 넘어지지 않도록 받침대 등으로 잘 고정하여야 한다.",
      "guideContext": "용해작업 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-049",
      "text": "유도용해로는 감전사고 및 누전차단기 오작동을 방지하기 위하여 용탕과 직접 접촉하는 온도측정, 시료채취 및 슬래그 제거작업은 반드시 사전에 용해로 전원을 차단하여야 한다.",
      "guideContext": "용해작업 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-050",
      "text": "경동 장치의 부근에 물이 체류되어 있지 않은 것을 확인하여야 한다.",
      "guideContext": "용해작업 경동장치 조작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-051",
      "text": "용용고열물의 출탕구와 용용고열물을 받아 넣을 용기와의 위치관계를 확인하여야 한다.",
      "guideContext": "용해작업 경동장치 조작",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-052",
      "text": "용용고열물을 받아 넣을 용기의 내부에 수분이 부착되어 있지 않은 것을 확인하여야 한다.",
      "guideContext": "용해작업 경동장치 조작",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-053",
      "text": "경동장치는 용탕이 외부로 유출되지 않도록 급격히 조작하지 말아야 한다.",
      "guideContext": "용해작업 경동장치 조작",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-054",
      "text": "래들·저장로·경련로 등의 경동작업을 2명 이상이 할 경우에는 신호자를 정하고 그 사람의 신호에 따라야 한다.",
      "guideContext": "용해작업 경동장치 조작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-055",
      "text": "뚜껑이 설치된 경우에는 닫고 경동시켜야 한다.",
      "guideContext": "용해작업 경동장치 조작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-056",
      "text": "용해로 근처 및 용탕취급 작업자는 안전모, 안전화, 보안경, 보안면, 방진마스크, 방열복 및 내열장갑 등을 착용하고 작업을 하여야 한다.",
      "guideContext": "용해작업 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-057",
      "text": "용해로 작업장 내에서 작업자는 난연성 작업복, 흡습성이 좋은 속옷, 양발 등을 착용하여야 한다.",
      "guideContext": "용해작업 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-058",
      "text": "프라스틱, 페인트 등이 함유된 장입재는 고온에서 열분해되어 유해가스가 발생할 수 있으므로 방독독스크를 착용하여야 한다.",
      "guideContext": "용해작업 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장입작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-059",
      "text": "용탕누출, 경보장치 작동, 폭발, 화재 등의 비상시 인명피해를 최소화 하도록 비상조치계획을 수립하여야 한다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-060",
      "text": "비상조치계획은 현장의 최고 선임자에게 안전조치를 위한 모든 권한을 부여하여야 한다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-061",
      "text": "작업자는 비상시 안전조치절차를 잘 이해하고, 준수하여야 한다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-062",
      "text": "비상시 조치사항을 요약하여 현장에 게시하고, 준수토록 지속적인 교육을 하여야 한다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-063",
      "text": "경보장치, 연동장치는 성능을 저하시키거나, 제거해서는 안된다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-064",
      "text": "경보장치 및 연동장치가 작동되면 절대로 용해작업을 계속해서는 안된다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-065",
      "text": "용해로에 폭발성 물질, 인화성 물질, 가연성 물질 및 기타 액체가 유입되지 않도록 장입재를 사전에 선별하고, 건조하여야 한다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장입작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-066",
      "text": "융점이 낮은 추가 장입재는 용탕에 직접 넣을 때 기화되어 용탕이 넘치거나 폭발할 위험이 있으므로 투입을 하여서는 안된다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장입작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-067",
      "text": "내부가 비어있는 고철 롤(Roll)은 표면과 내부의 팽창계수 차이로 가열시키면 표면이 분리되어 비산될 위험이 있으므로 파쇄하여 장입하여야 한다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장입작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-068",
      "text": "래들 등의 용탕 주입설비는 급격한 온도변화에 의한 수증기 폭발 및 열충격을 방지하기 위하여 용탕을 주입하기 전에 예열을 하여야 한다.",
      "guideContext": "용해작업 비상조치",
      "additionalDetail": null,
      "workProcessPhase": "출탕작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P143-069",
      "text": "인공관절, 틀니, 인공심장 박동기, 시계 등의 금속물질은 제조자가 제시하는 안전 거리를 유지하여야 한다.",
      "guideContext": "용해작업 비상조치 (법령 근거 미확인)",
      "additionalDetail": "유도용해로 전자기장 영향",
      "workProcessPhase": "용해작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-070",
      "text": "정비작업자는 용해로 설비의 작동원리를 정확히 이해하고, 안전운전 및 유지보수 절차서를 준수하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-071",
      "text": "용해로 등은 성능 유지 및 안전을 위하여 최초 제조자의 설계사양을 유지할 수 있도록 제조자가 권장하는 부품을 사용하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-072",
      "text": "다른 부품을 사용할 경우에는 사전에 설계사양 등을 충분히 검토를 하여 변경하고, 변경 내용 및 사유, 관련 도면 수정, 안전운전절차서 등을 보완하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-073",
      "text": "내화물 사양을 변경할 경우에는 내화물 제조자, 축로자 및 관련 설비의 전문가 의견을 반영하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-074",
      "text": "내화물은 다음과 같은 부위를 정기적으로 점검하여 제조자가 요구하는 두께 이상으로 유지하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": "슬래그와 용탕 경계부위, 급격한 굴곡이 있는 바닥과 측벽 경계, 내화물 보수부위, 외부 온도측정 결과 온도가 높은 부위",
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-075",
      "text": "용탕 배출 피트는 즉시 사용이 가능하도록 항상 건조된 상태로 유지하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-076",
      "text": "용해로와 래들에 부착된 슬래그 및 드로스는 국부적인 과열로 설비 파손으로 용탕이 누출될 수 있으므로 제거하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-077",
      "text": "도전성 분진에 의한 아크발생, 누전 및 감전사고 예방을 위하여 분진이 쌓이지 않도록 수시로 제거하여야 한다.",
      "guideContext": "용해로 성능유지",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P143-078",
      "text": "경보장치는 작동시 작업자에게 경보가 전달될 수 있도록 성능을 항상 유지하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-079",
      "text": "전원공급장치는 항상 문을 닫아 분진 등이 유입되지 않도록 하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-080",
      "text": "누전차단기, 경보장치, 연동장치는 항상 정상 기능이 유지될 수 있도록 작업 시작 전에 점검하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": "특히 누전차단장치는 매번 용해작업 시작 전에 정상작동 여부를 확인하여야 한다",
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-081",
      "text": "누전차단장치는 항상 정상 작동되어야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": "냉각코일에서 누전이 발생할 경우에는 대용량의 전류가 흘러 냉각코일의 온도 상승이 가속화되어 코일 손상으로 수증기 폭발이 일어날 수 있음",
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-082",
      "text": "수냉도체는 물이 응축되지 않도록 하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-083",
      "text": "안전운전과 정비에 관한 일일, 주간, 월간, 계간 및 연간 안전점검표를 작성하여 현장에 게시하고, 준수토록 하여야 한다.",
      "guideContext": "용해로 성능유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-084",
      "text": "예비동력원은 매주 작동시험을 실시하고, 그 기록을 보존하여야 한다.",
      "guideContext": "용해로 성능유지",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-P143-085",
      "text": "설비 보수를 위하여 필요한 자료는 운전자, 정비자 및 협력업체 작업자 등이 쉽게 열람할 수 있도록 항상 현장에 비치하여야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-086",
      "text": "내화물의 파손, 균열 및 마모 등은 용탕과 로체 및 래들 본체에 접촉·용해되어 용탕이 외부로 누출될 위험이 있으므로 반드시 보수하여야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-087",
      "text": "내화물 대신 보호피막만 설치 용해로는 피막손상으로 형성된 미세한 균열은 용탕이 침투되어 외부로 누출될 수 있으므로 반드시 보수하여야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-088",
      "text": "축로 보수작업은 용해하는 용탕에 적합한 내화물을 사용하고, 소결하여야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-089",
      "text": "내화물 제거작업은 진동, 충격 및 마찰 등으로 냉각코일 등이 손상되지 않도록 하여야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-090",
      "text": "내화물 건조작업은 국부가열 및 급속한 가열을 해서는 안된다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-091",
      "text": "수분이 남아있는 경우에는 내화물이 급격히 가열·팽창되어 스롤링이 발생하여 수명이 단축되고, 수증기 폭발이 일어날 수 있으므로 축로 작업이 끝난 후에는 완전하게 건조하여야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-092",
      "text": "내화물 등의 건조를 끝낸 용해로 및 래들 등은 건조 하지 않은 것과 구별하고 작업용수 또는 빗물의 침수·관수 등이 없도록 보관하여야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P143-093",
      "text": "전원을 차단하고 콘덴서 등에 남아있는 전하를 완전히 방전시킨 후에 전원공급장치 문을 열어야 한다.",
      "guideContext": "용해로 보수작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P143-001",
      "term": "용해로",
      "definition": "금속을 녹는점 이상으로 가열하여 용해시키는 용선로, 반사로, 평로, 전로, 전기로 등의 가마를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P143-002",
      "term": "래들",
      "definition": "용해로(融解爐)에서 나온 쇳물을 받아서 운반하여 주형에 주입하는 데 사용하는 용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P143-003",
      "term": "브리징",
      "definition": "추가하는 차가운 장입재가 중간에 걸려 하부의 용탕 사이에 공기층이 형성되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P143-004",
      "term": "스폴링",
      "definition": "소결된 내화물이 갑자기 부서져 떨어지는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P143-005",
      "term": "드로스",
      "definition": "용해된 금속의 안 또는 윗면에 떠오르는 산화물이나, 용용아연도금에서 노 바닥에서 발생하는 금속간 화합물 등의 침적물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
