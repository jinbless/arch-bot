  "checklistItems": [
    {
      "identifier": "CI-CC8-001",
      "text": "사업주는 화학설비 또는 그 배관의 덮개·플랜지·밸브 및 콕의 접합부에 대해서는 접합부에서 위험물질 등이 누출되어 폭발·화재 또는 위험물이 누출되는 것을 방지하기 위하여 적절한 개스킷(gasket)을 사용하고 접합면을 서로 밀착시키는 등 적절한 조치를 하여야 한다.",
      "guideContext": "플랜지 및 개스킷 등의 접합부 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제257조(덮개 등의 접합부)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-002",
      "text": "사업주는 관리대상 유해물질 취급설비의 뚜껑·플랜지(flange)·밸브 및 콕(cock) 등의 접합부에 대하여 관리대상 유해물질이 새지 않도록 개스킷(gasket)을 사용하는 등 누출을 방지하기 위하여 필요한 조치를 하여야 한다.",
      "guideContext": "플랜지 및 개스킷 등의 접합부 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제433조(누출의 방지조치)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-003",
      "text": "배관의 호칭지름이 DN 50/NPS 2 이상인 배관에는 맞대기 용접식 플랜지를 사용한다. 다만 호칭압력이 150(PN 20) 이하인 것은 그러하지 아니한다.",
      "guideContext": "플랜지 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "플랜지 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-004",
      "text": "배관의 호칭지름이 DN 50/NPS 2 미만인 배관이라도 취급하는 위험물질이 안전규칙 별표 1(위험물질의 종류)의 7호에서 규정하는 독성물질인 경우에는 맞대기 용접식 플랜지를 사용하고, 안전규칙 별표 1의 6호에서 규정하는 부식성 물질인 경우에는 맞대기 용접식 플랜지, 완전 삽입 용접식 플랜지 또는 랩 죠인트 플랜지를 사용한다.",
      "guideContext": "플랜지 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "플랜지 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-005",
      "text": "배관내에서 취급되는 위험물질의 온도가 260℃ 이상이거나 영하 45℃ 미만일 경우에는 일부 삽입 용접식 플랜지 또는 나삿니 연결식 플랜지를 사용하지 아니한다.",
      "guideContext": "플랜지 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "플랜지 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-006",
      "text": "완전 삽입 용접식 플랜지를 사용시에는 양면 용접을 실시하여야 한다.",
      "guideContext": "플랜지 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "플랜지 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-007",
      "text": "플랜지의 면이 평면(Flat face)인 것을 사용하여서는 아니된다.",
      "guideContext": "플랜지 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "플랜지 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-008",
      "text": "개스킷 해체 시 내부의 유체압은 대기압으로 하며, 관내 유체를 제거한 후 작업하여야 한다.",
      "guideContext": "개스킷 교체 취급요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개스킷 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-009",
      "text": "볼트, 너트를 제거하고 플랜지면이 손상되지 않도록 주의하여 개스킷을 탈착 후 플랜지면의 손상이나 부식 등을 확인 하여야 한다. 이때 플랜지면의 손상이나, 부식 그리고 플랜지의 평행도, 조정불량을 확인 하여야 한다.",
      "guideContext": "개스킷 교체 취급요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개스킷 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-010",
      "text": "취급하는 유체에 따라 보호안경, 보호장갑 등 적절한 개인 보호장구를 착용하여야 한다.",
      "guideContext": "개스킷 교체 취급요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개스킷 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-011",
      "text": "장착 사용한 개스킷을 재사용시 개스킷 본래의 재질이 가지고 있는 압축율, 복원율, 인장 등의 물성이 현저히 지하되므로 재사용은 원칙적으로 금지한다.",
      "guideContext": "개스킷 보관 취급요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개스킷 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-012",
      "text": "강판은 맹판(Blind flange)제작에만 사용하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "별표 2 재질분류표에서 ※ 표시된 강판 등급에 해당",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-013",
      "text": "455℃ 이상에서는 킬드강 만을 사용하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(2)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-014",
      "text": "불림(Normalized) 및 뜨임질(Tempered)한 재질을 사용하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(4)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-015",
      "text": "540℃ 이상에서는 탄소함량이 0.04% 이상인 재질만 사용하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(5)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-016",
      "text": "540℃ 이상에서 사용하는 경우에는 최소한 1040℃ 이상으로 가열한 후 물 또는 저질한 방법으로 급냉시키는 방법에 의하여 열처리를 실시한 재질을 사용하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(6)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-017",
      "text": "565℃ 이상에서 사용하는 경우에는 ASTM 6에서 규정하는 금속조직(Grain) 크기보다 커야 한다.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(7)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-018",
      "text": "풀림한 재질(Annealed material)을 사용하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(8)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-019",
      "text": "용체 풀림한 재질(Solution annealed material)을 사용하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(9)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-020",
      "text": "화학성분, 기계적 특성, 열처리 및 금속조직(Grain) 크기 등은 ASTM의 기준에 적합하여야 함.",
      "guideContext": "플랜지 재질 그룹별 재질분류 (법령 근거 미확인)",
      "additionalDetail": "재질분류표 주(10)에 해당하는 조건",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-038",
      "text": "선으로 구분되지 않은 부분의 수치는 좌우에 기록된 수치를 사용함",
      "guideContext": "호칭압력 300(PN 50)용 플랜지 온도-압력 등급표 사용 시 (법령 근거 미확인)",
      "additionalDetail": "별표 3-2 주1 규정으로, 표에서 해당 온도의 셀이 선으로 구분되지 않은 경우 좌우 인접 값을 적용한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 3-2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-039",
      "text": "최고 사용온도는 540℃",
      "guideContext": "호칭압력 300(PN 50)용 플랜지 재료그룹 1.1~1.4 적용 시 (법령 근거 미확인)",
      "additionalDetail": "별표 3-2 표 내 주석으로, 재료그룹 1.1·1.2·1.3·1.4에 해당하는 플랜지의 최고 사용온도 제한 사항이다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 3-2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-070",
      "text": "선으로 구분되지 않은 부분의 수치는 좌우에 기록된 수치를 사용함",
      "guideContext": "호칭압력 1500(PN 250)용 플랜지의 온도에 따른 최고허용 압력 표 적용 (법령 근거 미확인)",
      "additionalDetail": "별표 3-5 주1 사항으로, 온도-압력 표에서 명시적 수치가 없는 구간에 대한 값 적용 기준",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 3-5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-071",
      "text": "재질그룹 1.1, 1.2, 1.3, 1.4 재질의 호칭압력 1500(PN 250)용 플랜지 최고사용온도는 540℃이다",
      "guideContext": "호칭압력 1500(PN 250)용 플랜지의 온도에 따른 최고허용 압력 표 적용 (법령 근거 미확인)",
      "additionalDetail": "별표 3-5 표 내 주석으로, 해당 재질그룹의 사용온도 상한을 규정",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 3-5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-081",
      "text": "호칭압력 2500(PN 420)용 플랜지의 온도에 따른 최고허용 압력표에서 선으로 구분되지 않은 부분의 수치는 좌우에 기록된 수치를 사용 함",
      "guideContext": "플랜지 및 개스킷 등의 접합부에 관한 기술지원규정 (법령 근거 미확인)",
      "additionalDetail": "별표 3-6 주1에 해당하는 표 읽기 규칙",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 3-6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-082",
      "text": "호칭압력 2500(PN 420)용 탄소강(재질그룹 1.1) 플랜지의 최고사용온도는 500℃이다",
      "guideContext": "플랜지 및 개스킷 등의 접합부에 관한 기술지원규정 (법령 근거 미확인)",
      "additionalDetail": "별표 3-6 표 내 700℃ 행에 명시된 탄소강 사용 제한 온도",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 3-6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-174",
      "text": "최고사용 허용온도가 표기되어 있지 않은 재질은 <별표 3-1> 내지 <별표 3-6> 및 <별표 4-1> 내지 <별표 4-6>에 최고사용 압력이 표기되어 있는 온도로 한다.",
      "guideContext": "플랜지 및 개스킷 접합부 재질 그룹별 최고사용 허용온도 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-175",
      "text": "표기된 최고사용 허용온도까지 사용이 허용되나 장기간 425℃(800. F) 이상에서는 사용하지 않는 것이 좋음.",
      "guideContext": "플랜지 및 개스킷 접합부 재질 그룹별 최고사용 허용온도",
      "additionalDetail": "재질 그룹 1.1 등 C강 계열에 해당하는 주의사항",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-176",
      "text": "표기된 최고사용 허용온도까지 사용이 허용되나 장기간 540℃(850. F) 이상에서는 사용하지 않는 것이 좋음.",
      "guideContext": "플랜지 및 개스킷 접합부 재질 그룹별 최고사용 허용온도",
      "additionalDetail": "재질 그룹 1.5 등 C-½Mo강 계열에 해당하는 주의사항",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-177",
      "text": "<별표 3-1> 내지 <별표 3-6> 및 <별표 4-1> 내지 <별표 4-6>에서 허용되는 최고사용 허용온도까지 사용이 허용되나 장기간 595℃(1100. F) 이상에서는 사용하지 않는 것이 좋음.",
      "guideContext": "플랜지 및 개스킷 접합부 재질 그룹별 최고사용 허용온도",
      "additionalDetail": "재질 그룹 1.9, 1.10 등 Cr-Mo강 계열에 해당하는 주의사항",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-178",
      "text": "565℃(1050. F) 이상에서 사용하는 경우에는 ASTM 6에서 규정하는 금속조직(Grain) 크기보다 커야 한다.",
      "guideContext": "플랜지 및 개스킷 접합부 재질 그룹별 최고사용 허용온도 (법령 근거 미확인)",
      "additionalDetail": "재질 그룹 2.7 (25Cr-20Ni강) 등 고온 사용 재질에 해당",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-194",
      "text": "본 선정 지침은 취급하는 위험물질이 개스킷 재질에 대하여 비부식성이며 비반응성인 것을 기준으로 작성되었으므로 유체의 물리화학적 특성에 따라 최고 사용온도 및 압력을 조정하여야 한다.",
      "guideContext": "개스킷의 선정지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-195",
      "text": "스파이럴형 개스킷은 파형 박판 및 충진재의 사용온도를 동시에 만족할 수 있도록 재질을 선택하여야 한다.",
      "guideContext": "개스킷의 선정지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-196",
      "text": "고무로 제조된 개스킷을 사용하는 경우에는 고무의 특성에 따라 사용 온도를 결정하여야 한다.",
      "guideContext": "개스킷의 선정지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-197",
      "text": "본 선정 지침을 벗어난 온도·압력범위에서 사용하고자 할 때는 전문 제조업체와 상의하여 결정할 수 있다.",
      "guideContext": "개스킷의 선정지침",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC8-198",
      "text": "다음과 같은 조건에서 사용되는 가스킷은 내·외면 볼이가 있는 것이어야 한다. 1.호칭지름>600㎜(24\")이며, 호칭압력>900 (PN150) 2.350㎜<호칭지름<600㎜이며, 호칭압력>1500 (PN250) 3.100㎜<호칭지름<350㎜이며, 호칭압력>2500 (PN 420)",
      "guideContext": "스파이럴형 개스킷 선정지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "별표 6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC8-001",
      "term": "위험물질",
      "definition": "안전보건규칙 별표 1(위험물질의 종류)에서 규정하는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-002",
      "term": "맞대기 용접식 플랜지",
      "definition": "플랜지와 관을 맞대기 용접에 의하여 연결할 수 있도록 제작된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-003",
      "term": "완전 삽입 용접식 플랜지",
      "definition": "플랜지 내부에 관을 완전히 끼워 넣고 용접을 하여 연결할 수 있도록 제작된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-004",
      "term": "일부 삽입 용접식 플랜지",
      "definition": "플랜지 내부에 관을 일부만 끼워넣고 용접을 하여 연결할 수 있도록 제작된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-005",
      "term": "나삿니 연결식 플랜지",
      "definition": "플랜지 내부와 관의 외부에 나삿니를 만들어 연결할 수 있도록 제작된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-006",
      "term": "랩 죠인트 플랜지",
      "definition": "플랜지 내부에 관을 완전히 끼워 넣고 관의 일부를 플랜지 면에 접하도록 하여 연결할 수 있도록 제작된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-007",
      "term": "개스킷",
      "definition": "플랜지와 플랜지를 체결할 때 접합부에서 유체가 누출되지 않도록 하기 위하여 사용되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-008",
      "term": "호칭 압력",
      "definition": "플랜지의 등급을 나타내기 위하여 사용하는 수치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC8-009",
      "term": "호칭 지름",
      "definition": "플랜지의 크기를 나타내기 위하여 사용하는 수치를 말하며 표기방법은 별표 1과 같다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-CC8-01",
      "processOrder": 1,
      "processName": "개스킷 해체 및 유체 제거",
      "safetyMeasures": "내부의 유체압은 대기압으로 하며, 관내 유체를 제거한 후 작업한다. 볼트, 너트를 제거하고 플랜지면이 손상되지 않도록 주의하여 개스킷을 탈착한다.",
      "requiredPPE": [
        "보호안경",
        "보호장갑"
      ],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC8-02",
      "processOrder": 2,
      "processName": "플랜지면 점검 및 이물질 제거",
      "safetyMeasures": "플랜지면의 손상이나 부식, 평행도, 조정불량을 확인한다. 플랜지면의 이물질을 제거하고 표면조도, 부식 등을 점검한다. 볼트, 너트의 이물질을 제거하고 상태 등을 점검한다.",
      "requiredPPE": [
        "보호안경",
        "보호장갑"
      ],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC8-03",
      "processOrder": 3,
      "processName": "개스킷 조립 및 설치",
      "safetyMeasures": "플랜지의 접합면은 서로 평평하고, 차이가 없어야 하며 중심이 틀어지지 않고 접촉면에 비틀림이 없어야 한다. 플랜지의 조정불량을 확인하고 개스킷을 플랜지의 조립위치에 놓고 설치한다.",
      "requiredPPE": [
        "보호안경",
        "보호장갑"
      ],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC8-04",
      "processOrder": 4,
      "processName": "운전 중 누출 관리",
      "safetyMeasures": "운전 중 진동, 온도변화, 압력 등의 영향으로 볼트가 풀려서 체결력의 저하가 생기고 누설이 될 수 있으므로 정기적으로 누출 여부를 확인하고 누출이 의심될 경우 볼트의 풀림을 재체결한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
  ],
