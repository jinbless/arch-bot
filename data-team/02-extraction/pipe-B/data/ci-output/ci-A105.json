  "checklistItems": [
    {
      "identifier": "CI-A105-001",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "분석에 사용하는 시약은 제조회사에서 표시하는 농도 함량을 따른다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.11",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-002",
      "text": "중량분석 용 지울은 적어도 10⁻⁵ g(0.01 mg)까지 달수 있어야 하며, 화학분석 용 지울은 적어도 10⁻⁴ g(0.1 mg)까지 달 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-003",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등 이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-004",
      "text": "노출기준과 비교 시는 작업환경 측정 시의 온도와 압력을 실측하여 정상상태의 농도로 환산하여야 한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "정상상태(NTP)는 25℃, 1기압을 의미한다.",
      "workProcessPhase": "농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.10",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-005",
      "text": "표준용액, 탈착효율 검정 등에 사용되는 시약은 같은 롯트(Lot)번호를 가진 것을 사용하여야 한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-006",
      "text": "이황화탄소는 독성이 강하고 인화성이 강한 물질이므로(인화점: -30℃) 특히 주의해야 함. 실험 시 장갑, 보안경, 실험복 등의 개인보호구를 잘 착용하고 후드 안에서 해야 함.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 시 탈착액(이황화탄소) 취급",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.I",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A105-007",
      "text": "각 시료채취펌프를 보정한다(시료채취시와 동일한 연결 상태에서).",
      "guideContext": "디이소부틸케톤 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.I",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-008",
      "text": "시료채취가 끝나면 흡착관을 플라스틱 마개로 막아(고무마개는 피한다) 운반한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석",
      "additionalDetail": "고무마개 사용 금지",
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.I",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-009",
      "text": "시료농도가 포함될 수 있는 적절한 범위에서 최소한 5개의 표준물질로 검량선을 작성한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.III",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-010",
      "text": "각 시료군 배치 당 최소한 한번 씩은 행하여야 하며 3개 농도 수준에서 각각 3개씩과 공시료 3개를 준비한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 탈착효율 검정 (법령 근거 미확인)",
      "additionalDetail": "탈착효율(DE) 검정 절차",
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.III",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-011",
      "text": "탈착효율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다. 탈착효율에 대한 평가는 분석자가 해야 한다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "탈착효율간의 일정성이 없으면 원인을 찾아 교정하고 다시 실험을 실시해야 한다.",
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-012",
      "text": "만일 뒤 층에서 검출된 양이 앞 층에서 검출된 양의 10%를 초과하면(Wb > Wf/10) 시료 파과가 일어난 것이므로 이 자료는 사용할 수 없다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.IV",
      "basedOn": null
    },
    {
      "identifier": "CI-A105-013",
      "text": "건강영향 및 예방조치 : 시약류의 피부 접촉이나 흡입을 피해야 하며, 실험실에서는 실험복 및 보호장비의 착용이 필요하다.",
      "guideContext": "디이소부틸케톤 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.V",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A105-001",
      "term": "밀폐",
      "definition": "취급 또는 보관상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A105-002",
      "term": "밀봉",
      "definition": "취급 또는 보관 상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A105-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A105-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ± 10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A105-005",
      "term": "즉시",
      "definition": "시험조작 중 30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A105-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A105-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A105-008",
      "term": "탈착효율",
      "definition": "채취한 유기화합물 등의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 흡착관에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-A105-01",
      "processOrder": 1,
      "processName": "시료채취",
      "safetyMeasures": "각 시료채취펌프를 보정한다(시료채취시와 동일한 연결 상태에서). 시료채취 바로 전에 흡착관의 양끝을 절단한 후 유연성 튜브를 이용하여 펌프에 연결한다. 0.01~0.2 L/분에서 정확한 유량으로 1~10 L 정도 시료를 채취한다. 시료채취가 끝나면 흡착관을 플라스틱 마개로 막아(고무마개는 피한다) 운반한다.",
      "requiredPPE": [],
      "sourceSection": "6.I",
      "relatedSR": null
    },
    {
      "identifier": "WP-A105-02",
      "processOrder": 2,
      "processName": "시료 전처리",
      "safetyMeasures": "이황화탄소는 독성이 강하고 인화성이 강한 물질이므로(인화점: -30℃) 특히 주의해야 함. 실험 시 장갑, 보안경, 실험복 등의 개인보호구를 잘 착용하고 후드 안에서 해야 함. 흡착관 앞 층과 뒤 층을 각각 다른 바이엘에 넣고, 각 바이엘에 1mL의 탈착액을 넣고 즉시 마개를 한다. 가끔 흔들면서 30분 정도 방치한다.",
      "requiredPPE": [
        "장갑",
        "보안경",
        "실험복"
      ],
      "sourceSection": "6.II",
      "relatedSR": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "WP-A105-03",
      "processOrder": 3,
      "processName": "검량선 작성 및 탈착효율 검정",
      "safetyMeasures": "시료농도가 포함될 수 있는 적절한 범위에서 최소한 5개의 표준물질로 검량선을 작성한다. 탈착효율 검정은 각 시료군 배치 당 최소한 한번 씩은 행하여야 하며, 탈착효율은 최소한 0.75 이상이 되어야 한다.",
      "requiredPPE": [
        "장갑",
        "보안경",
        "실험복"
      ],
      "sourceSection": "6.III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A105-04",
      "processOrder": 4,
      "processName": "기기분석",
      "safetyMeasures": "가스크로마토그래프 제조회사가 권고하는 대로 기기를 작동시키고 조건을 설정한 후 표준용액, 탈착효율시료, 현장시료를 분석한다. 시료를 정량적으로 정확히 주입한다.",
      "requiredPPE": [],
      "sourceSection": "6.III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A105-05",
      "processOrder": 5,
      "processName": "농도 계산",
      "safetyMeasures": "C(mg/m³) = [(Wf + Wb - Bf - Bb) / (V × DE)] × 10³ 공식에 의하여 농도를 구한다. 뒤 층에서 검출된 양이 앞 층에서 검출된 양의 10%를 초과하면 시료 파과가 일어난 것이므로 이 자료는 사용할 수 없다. 노출기준 비교 시 작업환경 측정 시의 온도와 압력을 실측하여 정상상태(25℃, 1기압)의 농도로 환산하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "6.IV",
      "relatedSR": null
    }
