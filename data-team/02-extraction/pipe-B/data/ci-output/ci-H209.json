  "checklistItems": [
    {
      "identifier": "CI-H209-001",
      "text": "산을 취급할 때는 보호안경, 장갑, 마스크를 착용 후 후드에서 작업한다.",
      "guideContext": "인듐 분석용 시약 조제 시 산 취급 안전",
      "additionalDetail": "질산 등 특급시약 취급 시 개인보호구 착용 및 국소배기장치(후드) 내 작업 필수",
      "workProcessPhase": "시약 조제",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H209-002",
      "text": "사용하는 모든 초자기구는 20% 질산에 4 시간 이상 담가두었다가 탈이온수로 5 회 행구어 사용한다.",
      "guideContext": "인듐 분석 시 초자기구 오염 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시약 조제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-003",
      "text": "트리톤 X-100, 1000 mg/L 인듐 표준용액과 질산은 특급시약을 사용하되 최초 개봉일로부터 3 년 이내의 것을 사용하도록 하며, 초과 시는 새로운 시약과 비교실험을 실시하여 오차가 10% 이내일 경우 1 년간 더 사용할 수 있다.",
      "guideContext": "인듐 분석 시약 유효기간 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시약 조제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-004",
      "text": "탈이온수는 초순수 제조 장치로 제조한 비저항 18 MΩ이상의 것을 사용하거나 원자흡광광도계용 탈이온수를 사용한다.",
      "guideContext": "인듐 분석용 탈이온수 품질 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시약 조제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-005",
      "text": "근로자의 정맥혈을 주사기로 채취하여 응고용 튜브에 옮기거나 응고촉진제가 처리된 진공채혈관을 이용하여 채취한다.",
      "guideContext": "인듐 노출평가 시료채취 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-006",
      "text": "30분간 응고시킨 후 1,000 g(약 3,000 rpm)로 10분간 원심 분리하여 상층액을 분리한다.",
      "guideContext": "인듐 분석용 혈청 분리 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-007",
      "text": "분리한 시료는 바로 4℃(2~8℃)에서 보관하고, 채취 후 5일 이내에 분석한다.",
      "guideContext": "인듐 분석 시료 보관 및 분석 기한 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-008",
      "text": "시간당 2도 이상의 온도변화는 결과에 영향을 줄 수 있으므로 항온장치 가동을 확인한다.",
      "guideContext": "ICP-MS 분석 환경 온도 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "ICP-MS 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-009",
      "text": "최소 10개의 시료마다 blank시료를 분석하여 오염에 의한 신호값의 상승을 방지한다.",
      "guideContext": "ICP-MS 분석 품질관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "ICP-MS 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-010",
      "text": "혈청은 혈액혼합기(Blood mixer)로 3 분 정도 잘 섞어준 후 취한다. 혈액혼합기가 없는 경우는 거품이 나지 않게 주의하면서 천천히 튜브를 거꾸로-바로 번갈아 세워가며 내용물이 섞이게 한다.",
      "guideContext": "인듐 분석 시료 전처리 혼합 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H209-011",
      "text": "표준용액과 시료에 내부표준물을 넣고 희석액으로 50배 희석하여 분석용 검액을 만든다.",
      "guideContext": "인듐 분석 시료 희석 절차 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H209-001",
      "term": "생물학적 노출평가",
      "definition": "혈액, 소변 등 생체시료 중 생물학적 노출지표물질 분석값을 이용한 노출 유해물질 생체 흡수정도, 건강영향 가능성 등의 평가를 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H209-002",
      "term": "생물학적 노출지표물질",
      "definition": "생물학적 노출평가를 실시함에 있어 생체 흡수정도를 반영하는 물질로 유해물질 자체나 그 대사산물, 또는 생화학적 변화산물 등을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H209-003",
      "term": "생물학적 노출 기준 값",
      "definition": "일주일에 40시간 작업하는 근로자가 고용노동부고시에서 제시하는 작업환경 노출기준에 노출될 때 혈액 및 소변 중에서 검출되는 생물학적 노출지표물질의 값을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H209-004",
      "term": "정밀도",
      "definition": "일정한 물질에 대하여 반복측정·분석을 했을 때 나타나는 자료 분석치 변동의 크기를 의미한다. 이 경우 같은 조건에서 측정했을 때 일어나는 우연오차(Random error)에 의한 분산(Dispersion)의 정도를 측정값의 변이계수(Coefficient of variation)로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H209-005",
      "term": "정확도",
      "definition": "분석치가 참값에 접근한 정도를 의미한다. 다만, 인증표준물질이 있는 경우는 상대오차로 표시하고, 인증표준물질이 없는 경우는 시료에 첨가한 값으로부터 구한 평균회수율로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H209-006",
      "term": "검출한계",
      "definition": "공시료 신호값(Blank signal, background signal)과 통계적으로 유의하게 다른 신호값(Signal)을 나타낼 수 있는 최소의 농도를 의미한다. 이 경우 가장 널리 사용하는 공시료 신호값과의 차이가 공시료 신호값 표준편차의 3배인 경우로 한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
