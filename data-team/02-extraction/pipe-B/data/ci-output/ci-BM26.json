  "checklistItems": [
    {
      "identifier": "CI-BM26-001",
      "text": "영 별표 20 제1호에 따른 예초기: 날접촉 예방장치",
      "guideContext": "예초기 작업에 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제98조(방호조치) 제1항 제1호에 따른 방호장치",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-002",
      "text": "작동 부분의 돌기부분은 묻힘형으로 하거나 덮개를 부착할 것",
      "guideContext": "예초기 작업에 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제98조 제2항 제1호",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-003",
      "text": "동력전달부분 및 속도조절부분에는 덮개를 부착하거나 방호망을 설치할 것",
      "guideContext": "예초기 작업에 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제98조 제2항 제2호",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-004",
      "text": "회전기계의 물림점(롤러나 톱니바퀴 등 반대방향의 두 회전체에 물려 들어가는 위험점)에는 덮개 또는 울을 설치할 것",
      "guideContext": "예초기 작업에 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제98조 제2항 제3호",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-005",
      "text": "사업주는 다음 각 호의 어느 하나에 해당하는 작업을 하는 근로자에 대해서는 다음 각 호의 구분에 따라 그 작업조건에 맞는 보호구를 작업하는 근로자 수 이상으로 지급하고 착용하도록 하여야 한다.",
      "guideContext": "예초기 작업에 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제32조 제1항. 예초기 작업 시 안전모, 안전화, 보안경 등 해당",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-006",
      "text": "사업주는 소속 근로자에게 고용노동부령으로 정하는 바에 따라 정기적으로 안전보건교육을 하여야 한다.",
      "guideContext": "예초기 작업에 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 제29조 제1항",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-007",
      "text": "사업주는 근로자를 채용할 때와 작업내용을 변경할 때에는 그 근로자에게 고용노동부령으로 정하는 바에 따라 해당 작업에 필요한 안전보건교육을 하여야 한다.",
      "guideContext": "예초기 작업에 관련 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 제29조 제2항",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-008",
      "text": "다수의 작업자가 예초기 작업을 동시에 실시할 경우 각 작업자 사이에 안전거리를 유지하여야 한다.",
      "guideContext": "작업 전 교육내용 — 작업자 간 안전 반경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-009",
      "text": "작업 중지 또는 이동 등 작업 시간 외에는 반드시 엔진을 정지시켜야 하고 예초기를 들고 이동하는 작업자 사이에 안전거리를 유지하여야 하며 소음 환경에서 상호 의사소통을 확인하여야 한다.",
      "guideContext": "작업 전 교육내용 — 작업 일시 중지 및 이동 시 행동 규정",
      "additionalDetail": null,
      "workProcessPhase": "작업 중지 및 이동",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-NOISE-002"
      ]
    },
    {
      "identifier": "CI-BM26-010",
      "text": "작업 시작 전 근골격계 예방을 위한 스트레칭 방법을 교육한다.",
      "guideContext": "작업 전 교육내용",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-011",
      "text": "경사지 이동 중에는 미끄러지거나 넝쿨, 돌부리 등의 장애물에 걸려 넘어져서 자신 또는 주변 작업자에게 사고를 유발할 수 있으므로 주위를 잘 살피고 이동하도록 한다.",
      "guideContext": "작업 전 교육내용 — 안전한 경사지 이동요령",
      "additionalDetail": null,
      "workProcessPhase": "경사지 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-012",
      "text": "예초기 작업 중의 전도는 자신 또는 주변 보행자에게 매우 위험하므로 바닥을 잘 살피며 이동하여야 한다.",
      "guideContext": "작업 전 교육내용 — 도로변 제초작업 중 안전한 보행이동 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "도로변 제초작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-013",
      "text": "산짐승 등 아생동물이 갑자기 출현할 경우에는 침착하게 대응하여야 한다. 먼저 예초기 전원을 끄고 동물을 쫓아 낸 후에 작업을 다시 시작하여야 한다.",
      "guideContext": "작업 전 교육내용 — 유해동물 출현 시 대처요령 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-014",
      "text": "예초기 날과의 충돌에 의한 돌, 나무 등의 장애물 비래사고 예방을 위한 안전수칙을 교육하고 준수하도록 숙지시킨다.",
      "guideContext": "작업 전 교육내용 — 안전수칙 교육",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-015",
      "text": "안전모, 보안경, 보안면 등의 보호구 착용 방법을 교육하고 작업 전 개인보호구를 반드시 착용하도록 숙지시킨다.",
      "guideContext": "작업 전 교육내용 — 개인보호구 착용 방법",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-016",
      "text": "파편 등 비래사고 발생에 대비하여 안전모, 안전화, 보호 장갑, 보안경, 보안면 등 개인보호구를 착용한다.",
      "guideContext": "비래 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-017",
      "text": "예초기의 칼날은 안전인증을 받은 제품을 사용하고 마모 및 노후화가 진행된 것은 교체한다. 예초기 날 파손 시 작업자 쪽으로 비래하는 파편 조각을 막기 위해 안전덮개를 부착한다.",
      "guideContext": "비래 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-018",
      "text": "사용 전 예초기 각 부분의 볼트와 너트, 칼날의 조임 등 부착상태를 점검한다.",
      "guideContext": "비래 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-019",
      "text": "예초기 날에 의한 협착 또는 베임 사고 예방을 위해 보호 장갑을 착용한다.",
      "guideContext": "베임 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-020",
      "text": "예초기 운반 시에는 다른 작업자와 충분한 안전거리를 확보하고 날 접촉에 의한 사고를 방지하기 위해 예초기 날에 안전덮개를 부착하여야 한다.",
      "guideContext": "베임 예방대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-021",
      "text": "예초기 작업반경 내에는 다른 작업자의 접근을 금지한다. 비가 오고 난 뒤의 풀베기 작업 시에는 바닥이 미끄러우므로 물기가 마른 후에 작업을 실시하여야 한다.",
      "guideContext": "전도 예방대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-022",
      "text": "경사지 이동 시에는 뛰는 등의 불안전한 행동을 하지 않는다. 급경사지에서 작업 시는 안전대를 착용하는 등 전도방지를 위한 조치 후 작업을 진행한다.",
      "guideContext": "전도 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "경사지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-023",
      "text": "보행 이동 중에 바닥의 장애물에 발이 걸려 넘어지지 않도록 장애물 유무를 확인하면서 천천히 이동한다.",
      "guideContext": "전도 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "작업 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-024",
      "text": "작업 전에 충분한 준비운동을 하고 작업 중에 적절한 휴식과 작업에 적합한 스트레칭을 실시하면서 작업을 수행한다.",
      "guideContext": "근골격계 질환 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-025",
      "text": "차량이 통행하는 도로 인근에서 작업 시 그 도로와 충분한 안전거리를 확보하여야 한다.",
      "guideContext": "교통사고 예방대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "도로변 제초작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-026",
      "text": "부득이하게 충분한 안전거리를 확보하지 못할 경우에는 도로 상에 차량유도자를 배치하고 방책 및 안내표시관(\"작업 중 서행 운전\" 등)을 설치하는 등 작업자와 차량의 충돌사고 방지에 필요한 조치를 하여야 한다.",
      "guideContext": "교통사고 예방대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "도로변 제초작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-027",
      "text": "차량이 통행하는 도로 인근에서 작업 시 차량의 운전자가 작업자를 알아보기 용이하도록 안전 조끼 또는 형광 작업복을 착용한다.",
      "guideContext": "교통사고 예방대책",
      "additionalDetail": null,
      "workProcessPhase": "도로변 제초작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-028",
      "text": "엔진 시동 시 작업자는 칼날과 안전거리를 확보하고 칼날이 지면과 장애물에 닿지 않도록 하여야한다.",
      "guideContext": "예초기 작업 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예초기 시동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-029",
      "text": "올바른 작업자세를 유지하고 앞 방향(상단 → 하단, 우측 → 좌측)으로 작업한다.",
      "guideContext": "예초기 작업 방법",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-030",
      "text": "작업 시 안전공간(작업반경 10 m 이상)을 확보하면서 작업한다.",
      "guideContext": "예초기 작업 방법",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-031",
      "text": "일반적으로 예초기 날의 각도는 (5~10)° 로 하고 높이는 10 cm 내외를 유지한다.",
      "guideContext": "예초기 작업 방법",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-032",
      "text": "작업 중 예초기날이 돌 또는 굵은 나무 등에 부딪치지 않도록 주의한다. 돌 등에 부딪힌 경우에는 엔진을 정지시키고 톱날의 이상 유무를 확인한다.",
      "guideContext": "예초기 안전 수칙",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-033",
      "text": "발 끝에 예초기의 톱날이 접촉되지 않게 주의하고 작업자 간 안전거리는 10 m 이상 유지한다.",
      "guideContext": "예초기 안전 수칙",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-034",
      "text": "톱날이 넝쿨에 휘감기지 않도록 주의하고 넝쿨 위 부분을 1차로 작업한 후 아래 부분을 작업한다.",
      "guideContext": "예초기 안전 수칙",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-035",
      "text": "작업방향은 예초기 톱날의 회전방향이 좌측이므로 우측에서 좌측으로 실시한다.",
      "guideContext": "예초기 안전 수칙",
      "additionalDetail": null,
      "workProcessPhase": "예초 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    },
    {
      "identifier": "CI-BM26-036",
      "text": "경사방향으로 작업을 진행하고 급경사지에서는 작업을 금지한다.",
      "guideContext": "예초기 안전 수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경사지 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10",
      "basedOn": null
    }
  ],
