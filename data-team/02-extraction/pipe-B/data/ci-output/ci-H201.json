  "checklistItems": [
    {
      "identifier": "CI-H201-001",
      "text": "사업주는 기업의 건강증진 활동수준을 평가하기 위하여 <그림 1>과 같이 절차를 정하여 평가를 실시한다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": null,
      "workProcessPhase": "평가 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-002",
      "text": "<표 1>에 근거하여 근로자 비율에 따라 건강잠재 위험도를 1~5점 부여한다. 근로자 비율을 파악하지 못한 경우에는 3점을 부여한다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": "건강 잠재위험도 작성양식은 <별표 1>과 같다.",
      "workProcessPhase": "건강 잠재위험도 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-003",
      "text": "건강증진분야별로 건강증진 요구도를 산출한다. 요구도는 평가항목의 건강 잠재위험도 점수 중 가장 높은 점수로 한다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": "요구도 평가양식은 <별표 2>와 같다.",
      "workProcessPhase": "요구도 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-004",
      "text": "<표 2>에 근거하여 건강증진분야별로 활동도를 산출한다. 활동도는 10개 평가항목의 총점을 4로 나눈 값으로, 최대값은 5점이다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": "활동도 평가양식은 <별표 3>과 같다.",
      "workProcessPhase": "활동도 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-005",
      "text": "건강증진분야별 요구도 원점수에 20을 곱하여 환산점수를 산출한다. 종합한 요구도 환산점수는 분야별 요구도 환산점수의 산술평균 값이다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": null,
      "workProcessPhase": "기업건강증진지수 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-006",
      "text": "건강증진분야별 활동도 원점수에 20을 곱하여 환산점수를 산출한다. 종합한 활동도 환산점수는 분야별 활동도 환산점수의 산술평균 값이다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": null,
      "workProcessPhase": "기업건강증진지수 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-007",
      "text": "다음의 식에 의해 건강증진분야별 건강증진지수를 산출한다. 분야별 건강증진지수 = (분야별 활동도 환산점수 / 분야별 요구도 환산점수) × 100. 지수가 100점을 넘는 경우 100점으로 처리한다. 종합한 건강증진지수는 분야별 건강증진지수의 산술평균 값이다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": "기업건강증진지수 평가양식은 <별표 4>와 같다.",
      "workProcessPhase": "기업건강증진지수 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-008",
      "text": "산출된 건강증진지수에 따라 기업의 건강증진 활동수준을 미도입, 도입, 활성화, 우수단계로 분류한다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": "미도입(0~20점 미만), 도입(20~50점 미만), 활성화(50~80점 미만), 우수(80점 이상)",
      "workProcessPhase": "결과 해석 및 활용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-009",
      "text": "주기적으로 기업건강증진지수를 산출하여 건강잠재위험도, 요구도, 활동도의 변화수준을 파악하고 건강증진 활동수준의 진척도를 확인한다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": null,
      "workProcessPhase": "결과 해석 및 활용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-010",
      "text": "우선지원이 필요한 건강증진분야를 선택하여 지원을 결정한다.",
      "guideContext": "기업건강증진지수평가",
      "additionalDetail": null,
      "workProcessPhase": "결과 해석 및 활용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-H201-011",
      "text": "사업장 지원을 평가하기 위해서는 건강증진활동 추진을 위한 부서·전담인력·담당자 지정 여부, 예산 별도 편성 여부, 근로자 인센티브 제공 여부, 우수사례 벤치마킹 지원 여부, 추진자 외부 전문화교육·세미나·워크숍 참여 지원 여부를 고려하여야 한다.",
      "guideContext": "기업건강증진지수평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "활동도 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H201-001",
      "term": "기업건강증진지수",
      "definition": "사업장의 건강증진 활동수준을 나타내는 수치로서 요구도 대비 활동도를 계량화한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H201-002",
      "term": "건강증진 요구도",
      "definition": "사업장의 근로형태, 근로자의 건강실태를 평가하여 접수화한 것으로 해당 사업장에 필요한 건강증진활동의 정도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H201-003",
      "term": "건강증진 활동도",
      "definition": "사업장의 건강증진 활동실태를 평가하여 접수화한 것으로 사업장 건강증진활동의 추진 실태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H201-004",
      "term": "건강증진분야",
      "definition": "근로자 건강증진활동의 중점 영역을 말하며 근골격계질환 예방분야, 뇌심혈관질환 예방분야, 직무스트레스 관리분야, 생활습관 개선분야로 구분한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H201-005",
      "term": "전체 근로자",
      "definition": "일용직, 용역직, 협력사 소속 근로자는 제외하고 사업장 소속의 정규직, 비정규직을 모두 포함한 근로자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
