  "checklistItems": [
    {
      "identifier": "CI-G76-001",
      "text": "재킷은 좁은 공간에서 용접, 용단작업 시 불편함이 없도록 작업자가 편하게 착용할 수 있는 구조를 갖추어야 한다.",
      "guideContext": "공기재킷 제작 - 재킷 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-002",
      "text": "재킷의 안쪽 부분은 작업자가 착용하여 피부와 접촉하는 부분이므로 땀을 잘 흡수하는 재질의 원단을 사용한다.",
      "guideContext": "공기재킷 제작 - 재킷",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-003",
      "text": "재킷의 바깥쪽은 용접불티가 접촉하여도 견딜 수 있는 내열성 재질이나 또는 방염처리한 재질을 사용한다.",
      "guideContext": "공기재킷 제작 - 재킷",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-004",
      "text": "재킷은 작업자의 신체에 따라서 크기를 조절할 수 있는 구조이어야 한다.",
      "guideContext": "공기재킷 제작 - 재킷 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-005",
      "text": "호스는 용접 불티가 접촉하여도 쉽게 손상되지 않는 재질의 호스를 사용한다.",
      "guideContext": "공기재킷 제작 - 호스",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-006",
      "text": "호스는 공급되는 공기압력에 견딜 수 있는 충분한 강도의 호스를 사용한다.",
      "guideContext": "공기재킷 제작 - 호스",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-007",
      "text": "호스, 배관 및 매니폴드의 색상은 가스의 종류별로 서로 다른 색상을 사용하고, 동일한 가스를 취급하는 호스, 배관, 매니폴드의 색상은 동일한 색상으로 사용하여 작업자가 공기호스를 산소 또는 다른 가스용 매니폴드에 연결하지 않도록 하여야 한다.",
      "guideContext": "공기재킷 제작 - 호스 등",
      "additionalDetail": "공기=흑색, 산소=녹색, 탄산가스=청색, 에틸렌=연황색",
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009",
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-G76-008",
      "text": "호스에는 유량조절 밸브를 부착하여 재킷으로 공급되는 공기(Air)의 양을 조절한다.",
      "guideContext": "공기재킷 제작 - 유량조절 밸브",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-009",
      "text": "동일한 가스를 취급하는 플러그 및 커플링은 동일한 구경의 것을 사용하고, 서로 다른 가스를 취급하는 플러그 및 커플링의 구경은 서로 다른 구경의 것을 사용하여, 작업자가 실수로 공기호스의 플러그를 산소 또는 다른 가스용 커플링에 연결하지 않도록 하여야 한다.",
      "guideContext": "공기재킷 제작 - 플러그 및 커플링",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-G76-010",
      "text": "매니폴드의 색상은 가스의 종류별로 서로 다른 색상을 사용하여 작업자가 색상으로 취급하는 가스의 종류를 구별할 수 있어야 한다.",
      "guideContext": "공기재킷 제작 - 매니폴드",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G76-011",
      "text": "매니폴드에는 취급하는 가스의 종류별로 해당 가스명을 표기한 명찰을 부착하여야 한다.",
      "guideContext": "공기재킷 제작 - 매니폴드",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G76-012",
      "text": "매니폴드와 재킷을 연결하는 호스는 매니폴드에 공급되는 공기의 압력에 충분히 견딜수 있는 재질의 호스를 사용한다.",
      "guideContext": "공기재킷 제작 - 매니폴드",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-013",
      "text": "공기재킷 안으로 공급되는 공기(Air)의 양은 재킷과 호스의 연결부에 부착된 유량조절밸브로 조절한다.",
      "guideContext": "공기재킷 사용",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-014",
      "text": "원단이 찢어져 있거나 기름 등이 묻어 있는 재킷은 사용하지 않아야 한다.",
      "guideContext": "공기재킷 사용",
      "additionalDetail": "기름이 묻은 재킷은 용접 불티에 의해 화재 위험",
      "workProcessPhase": "공기재킷 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G76-015",
      "text": "결함이 있거나 외관이 손상된 호스는 사용하지 않아야 한다.",
      "guideContext": "공기재킷 사용",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-G76-016",
      "text": "호스의 색상이 공기공급 매니폴드의 색상과 동일한 색상인지를 확인한다.",
      "guideContext": "공기재킷 사용",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-017",
      "text": "플러그를 호스에 연결할 때는 쉽게 이탈하지 않도록 호스밴드, 호스클립 등의 조임기구로 확실하게 체결한다.",
      "guideContext": "공기재킷 사용",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-018",
      "text": "호스의 플러그는 반드시 공기공급 매니폴더의 커플링에 연결하여야 한다.",
      "guideContext": "공기재킷 사용",
      "additionalDetail": "산소 또는 다른 가스 매니폴드에 오연결 방지",
      "workProcessPhase": "공기재킷 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-G76-019",
      "text": "공기재킷 사용방법에 대한 안전수칙을 제정하여 교육한다.",
      "guideContext": "공기재킷 사용",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-020",
      "text": "공기재킷은 사용한 후 케비넷 등에 청결하게 보관하고 수시로 세탁하여 기름때가 묻지 않도록 한다.",
      "guideContext": "공기재킷 관리",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-021",
      "text": "오래 사용하여 호스의 색상이 변한 경우에는 새것으로 교체한다.",
      "guideContext": "공기재킷 관리",
      "additionalDetail": "색상 식별 불가 시 가스 오연결 위험 방지",
      "workProcessPhase": "공기재킷 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-022",
      "text": "오래 사용하여 매니폴드의 색상이 변한 경우에는 새로 페인트를 칠하여 관리한다.",
      "guideContext": "공기재킷 관리",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G76-023",
      "text": "매니폴드에 부착된 취급 가스의 종류를 표시하는 명찰은 글씨나 색상이 잘 보이도록 관리한다.",
      "guideContext": "공기재킷 관리",
      "additionalDetail": null,
      "workProcessPhase": "공기재킷 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G76-001",
      "term": "공기재킷",
      "definition": "선박용 블럭의 내부와 같은 공간에서 용접·용단 등의 작업을 하는 작업자의 작업복 안으로 시원한 공기(Air)를 공급하여 더위를 식히기 위한 것으로써 재킷, 호스, 플러그 등으로 구성되어 있으며, 매니폴더의 커플링에 플러그를 연결하여 공기를 공급받는 구조를 말한다",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G76-002",
      "term": "재킷",
      "definition": "작업자가 몸통에 착용하는 조끼 형태의 의복으로써 내부에는 공기를 공급하는 호스가 부착되어 있고, 이 호스에는 작은 구멍이 여러개 있어서 시원한 공기를 재킷 안으로 고루게 분산하는 구조를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G76-003",
      "term": "호스",
      "definition": "공기를 공급하는 고무재질의 관을 말한다",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G76-004",
      "term": "플러그 및 커플링",
      "definition": "호스와 매니폴드를 서로 연결하는 연결기구를 말한다. 플러그는 고무호스에 부착되어 있고, 커플링은 매니폴드에 부착되어 있으며 플러그를 커플링에 연결하면 매니폴드에 있는 공기가 호스를 통하여 공기재킷으로 공급된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G76-005",
      "term": "매니폴드",
      "definition": "공기, 산소, 이산화탄소, 에틸렌 등의 가스를 작업현장에 공급하기 위하여 이들 가스 공급배관의 끝부분에 설치한 다기관을 말하며 일반적으로 하나의 매니폴드에 여러 개의 커플링을 부착하여 사용한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
