  "domainTerms": [
    {
      "identifier": "DT-C82-001",
      "term": "현수교(Suspension Bridge)",
      "definition": "주탑에서 늘어뜨린 주케이블을 양 끝에 있는 앵커리지에 정착시킨 후 보강거더를 주케이블에 현수재로 연결 지지하는 교량형식을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C82-002",
      "term": "사장교(Cable Stayed Bridge)",
      "definition": "단순보 또는 연속보인 주형(Deck)을 사장재인 케이블로 지지시켜서 하중을 각 지점과 주탑의 기초를 통해 기초지반으로 전달하는 교량형식을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C82-003",
      "term": "주탑 기초",
      "definition": "현수교 및 사장교 주탑 상부로 부터 전달되는 하중을 지반에 전달시켜 주는 목적으로 설치되는 구조물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C82-004",
      "term": "RCD(Reverse Circulation Drill Method) 현장타설말뚝",
      "definition": "Drill Rod 끝부분에 특수한 Drill Rod Pipe를 통해 순환수가 배출되며 배출된 순환수는 침전지를 통해 다시 굴착공으로 순환시키는 역순환 굴착공법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C82-005",
      "term": "SCP(Sand Compaction Pile)",
      "definition": "지반 개량 공법의 하나로 진동 혹은 충격하중을 이용하여 지반 중에 압입하여 다진 모래말뚝, 또는 이와 같이 다진 모래말뚝을 조성하여 지반의 안정도를 높이는 공법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C82-006",
      "term": "CDM(Cement Deep Mixing)공법",
      "definition": "심층혼합처리공법으로서 연약지반의 흙 그 자체를 현위치에서 시멘트와 혼합, 교반, 고체화시켜 연약지반을 견고한 지반으로 개량하는 공법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-C82-01",
      "processOrder": 1,
      "processName": "지반보강(SCP, CDM)",
      "safetyMeasures": "인공섬 내부에서 말뚝의 지향능력을 향상시키기 위하여 SCP로 지반 보강하여 압밀침하를 조기에 완료시키고, 안벽 콘크리트 블록 하부지반에는 CDM 공법으로 보강하여 인공섬 전체의 강성을 증대시킨다. SCP 공사 완료 후 외측 CDM 지반보강 공사를 순차적으로 진행한다.",
      "requiredPPE": [
