  "checklistItems": [
    {
      "identifier": "CI-X43-001",
      "text": "설계도 등 공정안전 자료는 현장과 일치하여야 한다.",
      "guideContext": "원인결과분석(CCA) 수행 시 필요 자료 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "CCA에 필요한 자료 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X43-002",
      "text": "CCA의 문서화된 결과는 다음 사항을 포함하여야 한다: 분석한 시스템에 대한 설명, 분석한 초기사건을 포함한 문제 정의, 가정의 목록, 얻어진 원인결과 선도, 사건경로 최소 컷세트의 리스트, 사건경로에 대한 설명, 사건경로 최소 컷세트의 중요도에 대한 평가.",
      "guideContext": "원인결과분석(CCA) 결과 문서화 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과의 문서화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X43-003",
      "text": "문서화된 결과에는 CCA에 의해 얻어진 개선권고사항을 포함하여야 한다.",
      "guideContext": "원인결과분석(CCA) 결과 문서화 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과의 문서화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X43-004",
      "text": "고장에 의한 인적·물적 손실이 중대한 것으로 판단되는 경우에는 반드시 개선권고사항에 대한 후속조치를 하여야 한다.",
      "guideContext": "원인결과분석(CCA) 후속조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X43-005",
      "text": "경영자는 공정안전관리 담당부서로 하여금 평가결과 보고서의 내용들이 적절하게 추진되고 있는지를 감사하여야 한다.",
      "guideContext": "원인결과분석(CCA) 감사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "감사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X43-006",
      "text": "후속조치의 관리부서는 회사의 특성에 따라 정비부, 기술부, 사업부 등에서 각각 시행할 수 있도록 지정하여야 하며, 시행결과를 공정안전관리 담당 부서에 통보하여, 후속조치에 대한 적절한 사후관리가 이루어져야 한다.",
      "guideContext": "원인결과분석(CCA) 후속조치 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-X43-001",
      "term": "원인결과분석",
      "definition": "FTA 및 ETA를 결합한 것으로, 잠재된 사고의 결과 및 근본적인 원인을 찾아내고, 사고결과와 원인 사이의 상호관계를 예측하며, 리스크를 정량적으로 평가하는 리스크 평가기법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-002",
      "term": "사건수분석",
      "definition": "초기사건으로 알려진 특정한 장치의 이상 또는 운전자의 실수에 의해 발생되는 잠재적인 사고결과를 정량적으로 평가·분석하는 방법으로, 이 기법에 관한 자세한 기술적 사항은 안전보건기술지침 \"사건수 분석 기법\"을 참조한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-003",
      "term": "초기사건",
      "definition": "시스템 또는 기기의 결함, 운전원의 실수 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-004",
      "term": "안전요소",
      "definition": "초기의 사건이 실제 사건으로 발전되지 않도록 하는 안전장치, 운전원의 조치 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-005",
      "term": "결합수분석",
      "definition": "사고를 일으키는 장치의 이상이나 운전자 실수의 조합을 연역적으로 분석하는 방법으로, 이 기법에 관한 자세한 기술적 사항은 안전보건기술지침 \"결함수 분석 기법\"을 참조한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-006",
      "term": "정상사상",
      "definition": "FTA를 하기로 결정한 사고를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-007",
      "term": "기본사상",
      "definition": "더 이상 원인을 독립적으로 전개할 수 없는 기본적인 사고의 원인으로, 기기의 기계적 고장, 보수와 시험 이용 불능 및 작업자 실수 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-008",
      "term": "중간사상",
      "definition": "정상사상과 기본사상 중간에 전개되는 사상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-009",
      "term": "결합수 기호",
      "definition": "결함에 대한 각각의 원인을 기호로서 연결하는 표현수단을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-010",
      "term": "컷세트",
      "definition": "정상사상을 발생시키는 기본사항의 집합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X43-011",
      "term": "최소컷세트",
      "definition": "정상사상을 발생시키는 기본사항의 최소집합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-X43-01",
      "processOrder": 1,
      "processName": "발생 가능한 사건의 선정",
      "safetyMeasures": "FTA의 정상사상 또는 ETA의 초기사건을 CCA의 초기사건으로 선정하며, 정성적인 리스크 평가기법(HAZOP 등), 과거의 기록, 경험 등을 통해 초기사건을 선정한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-X43-02",
      "processOrder": 2,
      "processName": "안전요소의 확인",
      "safetyMeasures": "선정된 초기사건으로 인한 영향을 완화시킬 수 있는 모든 안전요소를 확인한다. 안전 시스템(조업정지 시스템), 경보 장치, 운전원의 조치, 완화장치(냉각시스템, 압력방출시스템, 세정시스템 등) 등을 포함한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-X43-03",
      "processOrder": 3,
      "processName": "사건수의 구성",
      "safetyMeasures": "확인된 모든 안전요소를 시간별 작동 및 조치 순서대로 성공과 실패로 구분하여 초기사건에서 결과까지의 사건경로(사건수)를 구성한다. 기호를 사용하여 사건경로를 나타낸다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-X43-04",
      "processOrder": 4,
      "processName": "초기사건과 안전요소 실패에 대한 결함수 구성",
      "safetyMeasures": "초기사건과 안전요소 실패에 대해 FTA 기법을 적용하여 기본원인(기본사상)에서 초기사건까지의 사건경로(결합수)를 구성한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-X43-05",
      "processOrder": 5,
      "processName": "각 사건경로의 최소 컷세트 평가",
      "safetyMeasures": "각 사건경로에 대한 최소 컷세트를 FTA 기법으로 결정하고, 사건경로를 공정안전에 대한 심각도와 중요도를 기준으로 순위를 매기며, 중요 사건경로에 대해 최소 컷세트의 순위를 매겨 가장 중요한 기본원인을 결정한다.",
      "requiredPPE": [],
      "sourceSection": "5.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-X43-06",
      "processOrder": 6,
      "processName": "결과의 문서화",
      "safetyMeasures": "분석한 시스템 설명, 초기사건을 포함한 문제 정의, 가정 목록, 원인결과 선도, 사건경로 최소 컷세트 리스트, 사건경로 설명, 최소 컷세트 중요도 평가 및 개선권고사항을 포함하여 문서화한다.",
      "requiredPPE": [],
      "sourceSection": "5.6",
      "relatedSR": null
    }
  ],
