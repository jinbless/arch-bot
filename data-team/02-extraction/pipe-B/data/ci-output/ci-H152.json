  "checklistItems": [
    {
      "identifier": "CI-H152-001",
      "text": "근로자의 정맥혈을 EDTA(Ethylenediaminetetraacetic acid) 또는 헤파린이 미리 처리된 튜브와 1 회용 주사기 또는 진공 채혈관을 이용하여 2 mL 이상 채취한다.",
      "guideContext": "질산 노출 근로자 생물학적 노출평가 시료채취 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-H152-002",
      "text": "채취한 시료는 시료 채취 용기에 밀봉하여 채취 후 바로 또는 1시간 이내에 분석하며, 분석 전까지 4 ℃(2~8 ℃)에서 냉장 보관한다.",
      "guideContext": "질산 노출 근로자 생물학적 노출평가 시료 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-H152-003",
      "text": "시안화칼륨은 맹독성 물질이므로 취급에 주의하고, 취급할 때는 보호안경, 장갑, 마스크를 착용한 후 후드에서 작업한다.",
      "guideContext": "질산 노출지표 분석 시 시안화칼륨 취급",
      "additionalDetail": null,
      "workProcessPhase": "시약 조제 및 시료 전처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(3)",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H152-004",
      "text": "채취한 시료는 채취 후 바로 또는 1시간 이내에 분석한다.",
      "guideContext": "질산 노출지표 분석 시 시료 취급 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(3)",
      "basedOn": null
    },
    {
      "identifier": "CI-H152-005",
      "text": "모든 시료는 거품이 발생하지 않도록 40분간 롤러 믹서로 균질화시킨다.",
      "guideContext": "질산 노출지표 분석 시료 전처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-H152-006",
      "text": "10 ml 시험관에 혈액 0.1 mL와 증류수 3.9 mL를 넣고 혼합하여 용혈시킨 후 인산 완충용액 4.0 ml를 가하여 혼합한다.",
      "guideContext": "질산 노출지표 분석 시료 전처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-H152-007",
      "text": "10 분간 방치 후 2,000 rpm에서 원심분리한다.",
      "guideContext": "질산 노출지표 분석 시료 전처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-H152-008",
      "text": "상층액을 두 개의 석영 cell에 3 mL씩 넣고 이 중 한 cell에만 페리시안화칼륨 용액 0.1 mL를 가하여 혼합한다. 혼합하여 2분 후 630 nm에서 증류수를 공시료로 측정 한 흡광도를 Aa와 Ba로 기록한다.",
      "guideContext": "질산 노출지표 분석 흡광도 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기기 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-H152-009",
      "text": "측정한 후의 석영 cell에 시안화칼륨 용액을 0.1 mL씩 첨가한 후 혼합하여 5분 후 다시 측정한다. 이 때의 흡광도를 Ab와 Bb로 기록한다.",
      "guideContext": "질산 노출지표 분석 흡광도 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기기 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(5)",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H152-001",
      "term": "생물학적 노출평가",
      "definition": "혈액, 소변 등 생체시료로부터 유해물질 자체 또는 유해물질의 대사산물이나 생화학적 변화산물 등을 분석하여 유해물질 노출에 의한 체내 흡수정도나 건강영향 가능성 등을 평가하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H152-002",
      "term": "생물학적 노출지표 물질",
      "definition": "생물학적 노출평가를 실시함에 있어 체내 흡수 정도를 반영하는 물질로서 유해물질 자체나 그 대사산물, 생화학적 변화물 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
