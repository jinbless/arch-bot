      ]
    },
    {
      "identifier": "CI-C14-021",
      "text": "사전 위험성평가를 실시하여 안전대책을 수립하여야 한다.",
      "guideContext": "밀폐공간 방수공사 작업안전계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업안전계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C14-022",
      "text": "작업자는 밀폐공간 방수작업 시 안전보건작업허가서를 작성하여 관리감독자에게 허가 승인을 받은 후에 작업을 실시하여야 한다.",
      "guideContext": "밀폐공간 방수공사 안전보건작업허가서 작성 (법령 근거 미확인)",
      "additionalDetail": "허가서 포함 항목: 작업개요, 안전담당자 지정 및 감시인 배치 유무, 산소농도측정 유무, 유해가스 부위별 측정 결과, 환기설비 설치 유무, 연락설비 구비 유무, 개인보호구 지급 및 점검 유무, 방폭용 전기기계·기구의 사용 유무, 소화기 비치 유무, 호흡용 보호구 비치 유무, 사고발생시 대응조치 계획, 조명 설치 계획, 안전교육 실시, 안전통로 확보",
      "workProcessPhase": "안전보건작업허가서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C14-023",
      "text": "작업 전에 작업장 내 유해가스를 측정하여 기준 농도 이하가 되도록 환기를 실시하여야 한다.",
      "guideContext": "밀폐공간 방수공사 작업 중 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 안전절차",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-C14-024",
      "text": "작업 전에 산소농도를 측정하여 산소농도가 18% 이상 23.5% 미만으로 유지될 수 있도록 하여야 한다.",
      "guideContext": "밀폐공간 방수공사 작업 중 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 안전절차",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-C14-025",
      "text": "작업장의 환기가 곤란한 경우에는 공기호흡기 또는 송기마스크 등 호흡용 보호구를 지급하고, 개인보호구 수시 점검 및 착용 여부를 확인한다.",
      "guideContext": "밀폐공간 방수공사 작업 중 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 안전절차",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-C14-026",
      "text": "밀폐공간 작업장의 환기를 위한 급기구는 외부의 신선한 공기를 공급할 수 있도록 설치하여야 하며, 배기구는 유해한 공기를 외부로 배출되도록 설치하되 배출된 유해한 공기가 다시 유입되지 않는 구조로 설치하여 작업장 내 공기를 적정한 공기 상태로 유지하여야 한다.",
      "guideContext": "밀폐공간 방수공사 작업 중 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 안전절차",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-C14-027",
      "text": "관리감독자는 작업 전에 근로자에게 작업위험요인과 이에 대한 대응방법, 응급처치 등에 대하여 교육을 실시하여야 한다.",
      "guideContext": "밀폐공간 방수공사 작업 중 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 안전절차",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-C14-028",
      "text": "작업자의 건강상태를 수시 확인하여야 한다.",
      "guideContext": "밀폐공간 방수공사 작업 중 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
