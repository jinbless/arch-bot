  },
  "checklistItems": [
    {
      "identifier": "CI-G5-001",
      "text": "사고를 사전에 방지하기 위해서는 위와 같은 발생 원인들에 대한 효과적인 위험관리대책들을 세워야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-002",
      "text": "법의 테두리 내에서 조사가 이루어지는지 확인해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-003",
      "text": "사업주는 법률에 따라 안전보건제도를 계획, 조직, 관리, 모니터링하고 검토해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-004",
      "text": "소송을 고려하여 사고를 당한 당사자에 대해 사고 당시의 환경을 완벽하게 조사하여 무엇이 잘못되었는지를 알아야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-005",
      "text": "사고조사와 이에 대한 분석은 사고발생 직후 가능한 한 신속히 이루어져야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-006",
      "text": "조사는 사고 현장의 방문과 목격자의 진술은 물론 위험평가, 작업절차, 지침, 업무가이드 등 모든 유용한 정보에 대한 분석을 포함해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-007",
      "text": "무엇이 잘못되었으며 동일한 사고가 재발되는 것을 예방하기 위해 어떤 조치를 취해야 하는지 등이 명시되어야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-008",
      "text": "이러한 조사과정은 공개적이고 진실하며 객관적이어야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-009",
      "text": "사고의 근본적인 원인들을 명확히 규명해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고원인 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-010",
      "text": "조사는 편견과 성급한 결론 도출을 피하기 위해 철저하고 체계적으로 수행되어야 하며 조사를 마치기 전에 예단은 금물이다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-011",
      "text": "알려진 것과 그렇지 않은 것을 명확히 하고 조사과정을 기록한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-012",
      "text": "누락되고 부적절하거나 혹은 미 사용된 위험관리대책을 점검한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험관리대책 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.11",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-013",
      "text": "이행될 수 있는 권고사항을 마련한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험관리대책 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.11",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-014",
      "text": "명확한 목적을 지닌 실행계획이 있어야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.12",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-015",
      "text": "위험평가에 대한 심사를 검토해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.12",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-016",
      "text": "조사결과와 이행계획은 알아야 할 필요가 있는 모든 사람들에게 공지해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 이행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.12",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-017",
      "text": "이행계획이 실행되고 그 과정이 모니터링되도록 준비를 해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실행계획 이행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.12",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-018",
      "text": "응급조치 등 신속한 긴급조치",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": "사고 인지 단계에서 가장 먼저 수행해야 하는 조치",
      "workProcessPhase": "사고 인지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-019",
      "text": "1차 대피장소 등 안전지역 확보",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 인지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-020",
      "text": "사고현장 확인 및 보존",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": "안전보건관리 책임자에게 보고 시 포함 내용",
      "workProcessPhase": "사고 인지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-021",
      "text": "사고 관련자들의 이름, 관련 장치 및 목격자 이름 등을 기록",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 인지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-022",
      "text": "사고에 대한 향후 조치를 결정할 안전보건관리책임자에게 즉시 보고",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": "부록 1의 양식에 따라 보고",
      "workProcessPhase": "사고 인지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-023",
      "text": "어떤 사고가 발생했는지 그리고 어떤 조건과 행위들이 사고에 영향을 주었는지를 가능한 한 즉시 밝힌다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-024",
      "text": "가능한 한 신속히 정보를 파악하는 것이 중요하며, 필요 시 작업을 멈추고 관계자가 아닌 자의 출입을 통제한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-025",
      "text": "직접적으로 사고와 연관된 공정과 장치 등 기인물은 분명하게 파악하여야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": "명판으로부터 모델번호, 제조자, 제조년도 또는 변경년도 등을 알아낸다",
      "workProcessPhase": "정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-026",
      "text": "개인보호구는 구비되어 있어야 하고, 적절하게 착용되어야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": "사고조사 시 안전장치·방호장치 적절성 확인 항목",
      "workProcessPhase": "정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-027",
      "text": "국소배기장치 등 환기장치는 적절하게 설치되어 있어야 하고, 가동되어야 한다.",
      "guideContext": "업무상 사고조사",
      "additionalDetail": "사고조사 시 안전장치·방호장치 적절성 확인 항목",
      "workProcessPhase": "정보 수집",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2.1",
      "basedOn": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-G5-028",
      "text": "위험 기계나 설비에 이중의 안전장치가 설치되어 있는지 확인한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": "사고조사 시 안전장치·방호장치 적절성 확인 항목",
      "workProcessPhase": "정보 수집",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-029",
      "text": "사고원인 분석 작업이 완료되면 위험관리 대책을 제시해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": "동종이나 유사 사고의 재발을 예방하기 위해 필수적",
      "workProcessPhase": "위험관리대책 제시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-030",
      "text": "안전보건관리 책임자는 조사팀에서 제시한 재발 방지 대책에 따라 실질적인 위험관리 대책에 관한 계획을 마련해야 한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계획 및 이행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-031",
      "text": "필요에 따라 위험성 평가와 안전작업 절차를 보완 또는 제정한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계획 및 이행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G5-032",
      "text": "사고의 세부내용과 조사를 통해 밝혀진 내용을 모두 기록하여 보존한다.",
      "guideContext": "업무상 사고조사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계획 및 이행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G5-001",
      "term": "불의의 사건",
      "definition": "업무상 재해나 질병의 결과를 초래하는 사건(Event)과 더불어 사고 위험이 있는 아차사고(Near Miss) 및 의도하지 않은 상태(Undesired Circumstance)를 포함하여 말한다. 이하 \"사고\"라 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G5-002",
      "term": "재해",
      "definition": "산업 현장에서 업무상 재해나 질병의 결과를 초래한 의도하지 않은 사건(Event)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G5-003",
      "term": "경미한 사고",
      "definition": "사고 위험이 있는 아차사고 및 의도하지 않은 상태로 인적 손실이 없는 사건을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-G5-01",
      "processOrder": 1,
      "processName": "사고 인지 및 긴급 대응",
      "safetyMeasures": "응급조치 등 신속한 긴급조치를 실시하고, 1차 대피장소 등 안전지역을 확보한다. 사고현장을 확인 및 보존하고, 사고 관련자들의 이름, 관련 장치 및 목격자 이름 등을 기록한다. 안전보건관리책임자에게 부록 1의 양식에 따라 즉시 보고한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-G5-02",
      "processOrder": 2,
      "processName": "사고원인 파악을 위한 정보 수집",
      "safetyMeasures": "사고 발생 조건과 행위를 즉시 파악하고, 필요 시 작업을 멈추고 관계자가 아닌 자의 출입을 통제한다. 목격자 및 관계자에게 우선적으로 질의·조사하고, 모든 유용하고 관련 있는 정보를 수집한다. 기인물, 재해자 행동, 작업조건 변경, 안전작업 절차 준수 여부, 부상 부위·정도, 위험 사전 인지 여부, 안전장치·방호장치 설치 적절성 등을 부록 2의 양식에 따라 작성한다.",
