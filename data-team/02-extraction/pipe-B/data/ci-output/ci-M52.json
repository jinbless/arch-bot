  "checklistItems": [
    {
      "identifier": "CI-M52-001",
      "text": "체인톱을 안전하게 사용하기 위해서, 작업자는 신체적 및 정신적으로 건강해야 한다.",
      "guideContext": "체인톱 사용의 적합성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업자 적합성 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-002",
      "text": "작업자는 약을 복용하고 있을 때에는 사업주에게 알려야 한다. 약 복용이 체인톱의 안전한 사용에 영향을 미치는지의 여부를 작업자의 주치의와 상담한다.",
      "guideContext": "체인톱 사용의 적합성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업자 적합성 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-003",
      "text": "사용자는 소음이나 손-팔 진동 노출을 안전한 수준으로 줄일 수 없는 경우 작업자들의 건강 검진을 행해야 한다.",
      "guideContext": "체인톱 사용 위험성 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-004",
      "text": "아무리 사소한 작업에서도 작업자는 적절한 개인용 보호구(Personal protection equipment)를 항상 착용해야 한다.",
      "guideContext": "개인용 보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인용 보호구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-005",
      "text": "보호복은 체인톱에 의한 절단(Cut-through)에 잘 견딜 수 있는 일관된 품질을 가져야 한다.",
      "guideContext": "개인용 보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인용 보호구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-006",
      "text": "보호복과 함께 착용하는 다른 의복은 몸에 꼡 맞아야 하며 느슨해서는 안 된다.",
      "guideContext": "개인용 보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인용 보호구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-007",
      "text": "혼자 체인톱으로 작업하는 것은 피한다.",
      "guideContext": "단독 작업",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-008",
      "text": "이 것이 불가능하다면, 문제가 발생할 경우 경보를 울릴 수 있는 절차를 세워야 하며 이에는 무선 또는 전화로 다른 작업자들과 주기적으로 접촉, 다른 작업자가 현장을 주기적으로 방문, 호루라기(Whistle) 휴대, 자동신호 장비 사용, 합의된 시간에 작업자 복귀 확인 등이 포함된다.",
      "guideContext": "단독 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-009",
      "text": "체인톱을 사용하는 작업자는 누구나 출혈을 억제하고, 압착 부상에 대처하는 방법을 배워야 한다.",
      "guideContext": "응급 조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-010",
      "text": "작업자가 응급조치 자격증을 보유하는 것이 바람직하다.",
      "guideContext": "응급 조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-011",
      "text": "작업자들이 항상 개인용 구급상자(상처를 감싸는 대형 봉대 포함)를 휴대하도록 하며, 보다 더 다양한 의약품 및 기구를 갖춘 키트에 쉽게 접근할 수 있도록 한다.",
      "guideContext": "응급 조치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-012",
      "text": "체인톱 사용을 준비할 때, 작업자는 일체의 나사, 너트 등이 견고하게 조여져 있는지 점검해야 한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-013",
      "text": "체인톱 사용을 준비할 때, 작업자는 톱 체인이 적절하게 팡팡하게 유지되어 있는지 점검해야 한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-014",
      "text": "체인톱 사용을 준비할 때, 작업자는 스로틀 잠금장치(Throttle lock out)에 압박을 가한 상태가 아닌 한 스로틀에 압력이 가해지지 않는지 점검해야 한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-015",
      "text": "체인톱 사용을 준비할 때, 작업자는 적절한 개인보호구를 착용해야 한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-016",
      "text": "톱 사용을 시작할 때 작업자는 다른 사람들로부터 안전한 거리를 확보하며, 톱 체인에 장애물이 없는지 확인한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-017",
      "text": "톱이 일단 작동하기 시작하면, 작업자는 엔진 회전 속도가 공회전(Idle) 상태로 돌아오면 톱 체인이 움직임을 멈추는지 점검한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-018",
      "text": "톱이 일단 작동하기 시작하면, 작업자는 최고 속도에서 또는 제조업체의 사양에 체인 브레이크가 효과적으로 작동하는지 점검한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-019",
      "text": "톱이 일단 작동하기 시작하면, 작업자는 톱이 임의의 방향으로 90도 회전될 때에도 엔진이 계속 작동하는지 점검한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-020",
      "text": "톱이 일단 작동하기 시작하면, 작업자는 정지 스위치가 제대로 작동하는지 점검한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-021",
      "text": "톱이 일단 작동하기 시작하면, 작업자는 가이드 바 및 체인에 대한 윤활 작업이 제대로 수행되는지 점검한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-022",
      "text": "위와 같은 점검은 매일 주기적인 간격으로 반복되어야 한다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-023",
      "text": "톱이 작동하기 시작하면, 작업자는 톱을 갖고 이동하기 전에 체인 브레이크를 누른다.",
      "guideContext": "체인톱 사용 준비 및 사전 점검",
      "additionalDetail": null,
      "workProcessPhase": "체인톱 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-024",
      "text": "작업자들이 가이드 바의 앞부분(Nose)이 나뭇가지, 통나무, 등 장애물과 부뗫치지 않도록 하여 킥백을 피하는 방식으로 톱을 사용하도록 한다.",
      "guideContext": "킥백(Kickback) 방지",
      "additionalDetail": null,
      "workProcessPhase": "체인톱 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-025",
      "text": "작업자들이 힘들여 팔을 빻지 않고, 톱을 가슴 아래로 유지하며, 왼손의 엄지 손가락을 정면 핸들의 뒤쪽에 놓고, 절단되는 물체에 대해 적절한 체인 속도를 유지하여 킥백을 피하도록 한다.",
      "guideContext": "킥백(Kickback) 방지",
      "additionalDetail": null,
      "workProcessPhase": "체인톱 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-026",
      "text": "작업의 종류를 불문하고 작업 현장을 샅샅이 점검하여 잠재적인 위험 요소들이 있는지 확인한다.",
      "guideContext": "체인톱 사용",
      "additionalDetail": null,
      "workProcessPhase": "작업 현장 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-027",
      "text": "체인톱을 사용하는 모든 작업에 대해 작업의 위험을 평가하고 제어한다.",
      "guideContext": "체인톱 사용",
      "additionalDetail": null,
      "workProcessPhase": "체인톱 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-028",
      "text": "체인톱을 사용하는 모든 작업에 대해 작업자가 해당 작업에 적합한 능력을 갖고 있는지 점검한다.",
      "guideContext": "체인톱 사용",
      "additionalDetail": null,
      "workProcessPhase": "체인톱 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-029",
      "text": "톱으로 절단작업을 하지 않을 때 작업자는 엔진을 정지하거나 체인 브레이크를 작동시킨다.",
      "guideContext": "체인톱 사용",
      "additionalDetail": null,
      "workProcessPhase": "체인톱 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-030",
      "text": "벌채할 나무 길이의 두 배에 해당하는 거리 내에 있는 전력선(Overhead power line) 소유자를 접촉하여 전력선을 아래로 내릴 것인지 아니면 전력 공급을 중단할 것인지 협의한다.",
      "guideContext": "목재 벌채",
      "additionalDetail": null,
      "workProcessPhase": "벌채 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-031",
      "text": "주의 조치에 대한 합의에 도달하기 전에 작업을 시작하지 않는다.",
      "guideContext": "목재 벌채 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벌채 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-032",
      "text": "나무가 땅에 떨어질 때 파손될 수 있는 전력선 또는 가스 파이프가 지하에 있는지 확인한다.",
      "guideContext": "목재 벌채",
      "additionalDetail": null,
      "workProcessPhase": "벌채 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-033",
      "text": "벌채할 나무 길이의 두 배에 해당하는 거리 내에 도로가 있는 경우, 도로 사용자 및 지역 주민들이 위험 구역에 들어가지 않도록 한다. 경고문을 붙이거나, 교통통제 또는 우회시킨다.",
      "guideContext": "목재 벌채",
      "additionalDetail": null,
      "workProcessPhase": "벌채 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-034",
      "text": "벌채시 나무가 썸지 않았는지 확인한다.",
      "guideContext": "목재 벌채",
      "additionalDetail": null,
      "workProcessPhase": "벌채 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-035",
      "text": "벌채시 바람 방향, 나무가 기울었는지 여부, 줄기가 고르지 않은지 등 나무가 떨어지는 방향에 영향을 미칠 수 있는 조건들을 평가한다.",
      "guideContext": "목재 벌채",
      "additionalDetail": null,
      "workProcessPhase": "벌채 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-036",
      "text": "벌채시 작업자가 적절한 장비를 갖고 있으며, 이를 사용할 수 있는 적합한 기술을 보유하고 있는지 확인한다.",
      "guideContext": "목재 벌채",
      "additionalDetail": null,
      "workProcessPhase": "벌채 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-037",
      "text": "이동식 승강 작업 플랫폼에서 작업 시 작업을 위해 제작한 플랫폼만을 사용한다.",
      "guideContext": "지상이 아닌 장소에서 체인톱 사용",
      "additionalDetail": null,
      "workProcessPhase": "고소 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-038",
      "text": "작업자들이 플랫폼 내 체인톱의 안전한 사용에 대한 적절한 교육을 받도록 한다.",
      "guideContext": "지상이 아닌 장소에서 체인톱 사용",
      "additionalDetail": null,
      "workProcessPhase": "고소 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-039",
      "text": "가급적 사다리 위에서 체인톱을 사용하는 것을 피한다.",
      "guideContext": "지상이 아닌 장소에서 체인톱 사용",
      "additionalDetail": null,
      "workProcessPhase": "고소 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-040",
      "text": "사다리를 사용하여 작업할 때, 작업자는 안전대를 사용하여 나무에 단단히 고정되어야 하며, 안정된 작업 위치를 확보해야 한다.",
      "guideContext": "지상이 아닌 장소에서 체인톱 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고소 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-041",
      "text": "체인톱은 모든 안전장치들이 효과적으로 작동하고, 모든 가드가 제 위치에 있도록 원래 제조된 상태로 유지보수되어야 한다.",
      "guideContext": "유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-042",
      "text": "작업자는 정확한 날세우기(Chain-sharpening) 기법 및 체인과 가이드 바의 유지보수에 대한 교육과 훈련을 받아 톱을 안전한 상태로 유지해야 한다.",
      "guideContext": "유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-M52-043",
      "text": "작업자는 일일 점검을 하며 On/off 스위치, 체인 브레이크, 체인캐철(Chain catcher), 소음기(Silencer), 가이드 바, 구동 스프로킷(Drive sprocket), 체인 링크(Chain link), 측면 플레이트, 정면 및 후면 핸드 가드, 방진 마운트(Anti-vibration mount), 기동코드(Starting cord)에 대한 손상 또는 과도한 마모가 발생하면 보고한다.",
      "guideContext": "유지보수",
      "additionalDetail": null,
      "workProcessPhase": "유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    }
  ],
