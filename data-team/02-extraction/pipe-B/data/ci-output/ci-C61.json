  "checklistItems": [
    {
      "identifier": "CI-C61-001",
      "text": "공사현장의 제반 여건과 터널 형상을 파악한 후 가시설물 설치계획, 수직터널 및 수평 보조 터널 등 세부작업 단계별 안전작업 방법과 순서, 장비에 대한 안전조치 사항 등이 포함된 작업계획을 수립하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-002",
      "text": "작업계획서는 본 공법에 풍부한 경험과 지식을 갖춘 자가 수립하여야 하며 공사 중 계획서의 내용이 제대로 이행되는지의 여부를 수시로 확인할 수 있도록 하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-003",
      "text": "공사 위치에 대한 지질조사 및 주변 지장물 조사를 실시하고 공사에 필요한 가설전기 설치위치 선정 등의 사항에 대한 사전 검토를 철저히 하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-004",
      "text": "Shield-T.B.M 장비는 전문 시공업체의 주기적인 검사를 실시하여야 하며 작업대차 이동 중 충돌사고 예방을 위한 대피장소 지정 및 장비 사용으로 인한 매연, 분진 발생에 따른 환기설비 설치 등 근로자 건강보호대책을 수립 후 시행하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-005",
      "text": "장비 반입 · 반출 등 크레인을 사용하여 조립, 해체 공정을 진행할 때에는 작업방법 및 순서 등이 포함된 중량물 취급 작업계획을 수립하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-006",
      "text": "지질 및 지층에 관한 조사를 실시하고 시추(보링) 위치, 토층 분포 상태, 투수계수, 지하수위, 지반의 지지력 등의 사항을 확인하여 시공계획에 반영하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 가설공사 (법령 근거 미확인)",
      "additionalDetail": "확인사항: 시추 위치, 토층 분포 상태, 투수계수, 지하수위, 지반의 지지력",
      "workProcessPhase": "가설공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-007",
      "text": "공사 전 작업구간 내에 기 설치되어 있는 상수도 및 하수관로, 송유관, 통신 및 전력 케이블, 도시 가스관, 지하갱도 등의 지하 지장물의 종류, 심도 및 크기를 파악하여 안전한 시공이 가능하도록 조치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 가설공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가설공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-008",
      "text": "수직구 굴착 시 세부공정표, 지반깊이별 굴착방법, 단계별 벽체 시공방법, 사용장비·굴착토사 인양·적재·운반·사토 방법 등이 포함된 작업계획을 작성하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-009",
      "text": "H-Pile 시공을 위한 항타기의 전도방지를 위해 작업하중에 적합한 지반의 평편성과 지내력을 확보하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-010",
      "text": "수직구 굴착단부에는 추락 및 낙하물방지를 위한 안전난간 및 발끝막이판을 설치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-011",
      "text": "굴착토사 인양 중 낙하재해 예방을 위하여 인양 버킷은 정량 적재 후 20 % 이상의 여유높이가 갖게 하거나, 덮개를 설치하고 하부에는 작업자 대피소를 확보하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-012",
      "text": "굴착지면에 투입되는 굴삭기의 운전석은 낙하물에 대비한 헤드가드를 설치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-013",
      "text": "흙막이지보공에 대한 계측을 실시하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-014",
      "text": "지면에서 굴착작업장소까지는 계단구조의 승강통로를 설치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-015",
      "text": "굴착작업 진행 중 용수량에 적합한 배수시설을 확보하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-016",
      "text": "발파작업 시 발파면이 습윤포화 상태의 경우 비전기식 뇌관을 사용하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴착공사 (법령 근거 미확인)",
      "additionalDetail": "기타사항은 KOSHA GUIDE C-46-2012(발파공사 안전보건작업 지침)에 따른다",
      "workProcessPhase": "굴착공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-017",
      "text": "보조터널에서의 장비조립을 위해서는 장비거치 및 굴진용 레일 설치 계획, 부재 투입순서 및 부재별 중량표 작성, 수직구 투입 인양장비 선정 및 보조기구 사용계획, 조립순서 및 방법, 조립작업용 발판 등 가시설 설치계획, 시운전 전·후 안전점검사항 등이 포함된 작업계획을 수립하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-018",
      "text": "수직구에는 근로자의 안전한 출입을 위해 가설통로를 설치하여야 한다. 또한 건설용 리프트를 설치 할 경우에는 사용 전 완성검사를 실시하고 하부의 건수(乾水)를 고려하여 바닥에서 일정높이를 이격하여 탑승구를 설치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-019",
      "text": "장비성능과 지반상태에 따른 굴진속도 기준을 설정하여 굴진하여야 하며, 지반상태는 막장관찰과 버력상태로 확인하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-020",
      "text": "터널 내·외부 연락을 위한 통신시설을 갖추어야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-021",
      "text": "작업 중 정전 및 비상사태에 대비하여 비상조명 설비를 설치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-022",
      "text": "굴진장비는 1회/일 점검표를 이용하여 점검하되 점검표에는 살수 및 유압설비 연결부 누수·누유 여부, 기계 회전부의 마모 및 소음 상태, 설비 연결부(볼트, 용접)의 이완여부, 운전실 게기 작동상태, 벨트컨베이어 롤러 및 벨트상태, 경암 천공 및 굴진 작업 중 진동 및 소음 상태가 포함되어야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-023",
      "text": "암판정 및 설계에 의한 무지보구간 이외에는 세그먼트가 조립되지 않은 상태로의 굴진은 금지하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-024",
      "text": "커터헤드부 회전판의 비트(Bit) 교체를 위해 막장면 진입 시에는 비트교체는 수명도달 전 안정지반에서 조기 교체, 진입 전 반드시 낙석 또는 붕락위험 여부 확인, 이상발견 시 안전한 위치로 추가 굴진, 막장과 커터헤드 이격 최소화, 부득이 한 경우 막장부 보강조치 후 진입 및 내부에 감시자 비상대기 등의 안전조치를 실시하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-025",
      "text": "벨트컨베이어에서 버력낙하 시 분진비산방지를 위해 살수 및 집진설비를 갖추어야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 (법령 근거 미확인)",
      "additionalDetail": "터널내부 환기·조명·배수시설은 KOSHA GUIDE C-45-2012 터널공사(NATM공법) 안전보건작업 지침을 따른다",
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-026",
      "text": "광차의 견인차는 축전 전동식을 원칙으로 하며 장비정지에 따른 예비견인 설비를 확보하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 버력처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-027",
      "text": "광차에는 비상정지장치, 경광등을 설치하고 근로자 탑승석에는 이탈방지 설비를 설치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 버력처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-028",
      "text": "광차의 운전속도는 10 km/h 로 제한하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 버력처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-029",
      "text": "광차의 운행공간과 근로자 이동통로는 반드시 분리 · 설치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 버력처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-030",
      "text": "광차는 브레이크 및 비상정지 장치 작동상태, 조명 및 경광등 상태, 차량간 연결부 및 바퀴 이상유무를 포함하여 1회/일 이상 점검을 통해 정상상태를 유지하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 버력처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-031",
      "text": "수직구에서 버력반출을 위한 크레인작업 시 상·하연락은 유·무선 수신기를 이용하고 인양작업 시 하부작업자는 대피장소에 대피하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 버력처리 (법령 근거 미확인)",
      "additionalDetail": "크레인작업은 KOSHA GUIDE M-85-2011(크레인 달기기구 및 줄걸이 작업에 관한 기술지침)에 따른다",
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-032",
      "text": "광차 등 운반설비에 세그먼트 블록 적재 및 운반 시에는 이탈방지를 위해 고임목 등의 고정기구를 사용하여 견고히 고정하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 세그먼트 조립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-033",
      "text": "운반설비에서 후방설비로 세그먼트 블록을 하역 시에는 전용 기계설비를 사용하되 작업자는 세그먼트 블록의 운반경로 이외의 장소에서 작업하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 세그먼트 조립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-034",
      "text": "세그먼트 블럭의 조립은 원격조정이 가능한 이렉터로 작업하되 이렉터 및 세그먼트 블록 운반구역에는 근로자 진입을 통제하기 위한 설비와 비상정치장치를 갖추어야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 굴진공사 세그먼트 조립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "굴진공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-035",
      "text": "기계해체 및 반출 시에는 안전작업 방법·해체순서 및 투입인력, 수직구 투입 인양장비 선정 및 보조기구 사용계획, 이동식 전기기계·기구 사용에 따른 감전재해예방 계획, 해체작업용 발판 등 가시설 설치계획 등이 포함된 작업계획을 수립하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 마감공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "마감공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-036",
      "text": "마감작업을 위해 사용하는 작업대는 추락재해예방을 위한 안전시설(승강설비, 안전난간, 안전대 부착설비 등)을 확보하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 마감공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "마감공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-C61-037",
      "text": "마감공사를 위해 유기용제 등을 사용 할 경우에는 환기시설을 설치해야 하며 가스농도측정기를 사용하여 수시로 점검하고, 유해화학물질이 함유된 물질을 취급하는 경우에는 화학물질의 명칭·성분, 함유량, 안전·보건상의 취급주의 사항 등이 포함된 물질안전보건자료(MSDS)를 작성하여 취급근로자가 쉽게 볼 수 있는 장소에 게시 또는 비치하여야 한다.",
      "guideContext": "터널공사(Shield-T.B.M공법) 마감공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "마감공사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-C61-001",
      "term": "Shield-T.B.M 공법",
      "definition": "T.B.M(Tunnel boring machine)장비의 전면부(커터헤드(암반굴착을 위한 원통형의 날))와 후면부에 쉴드장비를 연결하여 터널을 굴착하는 기계식 터널굴착 공법으로서 막장 후방에서 터널 벽면 형상의 원통형 세그먼트(Segment)를 조립하여 이를 지보공 겸 복공으로 이어나가 터널을 구축하는 공법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-002",
      "term": "전면부(Head part)",
      "definition": "커터헤드(Cutter head), 쉴드 주 본체(Shield main body, 막장부에 설치되는 굴진장비), 그립퍼(Gripper) 등으로 구성되어 터널 막장을 굴착하는 주요 기계부를 말하며, 장비의 특성에 따라 커터(Cutter)의 개수, 그립퍼(Gripper)의 유·무, 실린더(Cylinder)의 개수 등이 다르게 구성된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-003",
      "term": "그립퍼(Gripper)",
      "definition": "쉴드 주 본체(막장부에 설치되는 굴진장비)의 원통형면에 부착되어 있는 장비로서, 굴진 시 반력을 얻기 위해 장비를 지반에 고정시키는 기계장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-004",
      "term": "후방설비",
      "definition": "장비의 구동 및 조작을 위한 조작실, 변압기, 유압설비, 급수장치, 집진설비, 버력 반출용 벨트컨베이어 등이 설치된 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-005",
      "term": "세그먼트 블록(Segment block)",
      "definition": "터널 굴착 단면의 하중을 견디기 위한 동바리와 복공을 겸한 아치모양의 철근 콘크리트세그먼트 단편을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-006",
      "term": "이렉터(Erector)",
      "definition": "후방설비 내에 위치하여 후방설비 내로 운반된 세그먼트 블록을 굴착된 터널 벽면에 부착하여 세그먼트를 조립하는 기계장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-007",
      "term": "광차(Muck car)",
      "definition": "전방 커터헤드부에서 분쇄된 버력(암반, 토사 등)을 후방설비인 벨트컨베이어에서 버력처리용 횡갱(또는 수직갱)까지 운반하는 차량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-008",
      "term": "전방보조터널",
      "definition": "발진 수직구로 투입된 커터헤드 부 및 후방설비 등의 기계조립 공간이며, Shield-T.B.M 장비 구동을 위한 준비작업 공간으로서 NATM(New austrian tunnelling method)공법으로 시공된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C61-009",
      "term": "후방보조터널",
      "definition": "장비 발진을 위한 반력대 설치장소 및 초기 굴진 시 발생되는 버력 등을 처리하는 공간이며 통상 전방보조터널과 함께 NATM공법으로 시공된다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
