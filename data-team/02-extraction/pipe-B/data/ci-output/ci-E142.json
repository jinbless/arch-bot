  },
  "checklistItems": [
    {
      "identifier": "CI-E142-001",
      "text": "벨트 연마기에 대해서는 샌드벨트 구동용 롤러를 도전성으로 함으로써, 정전기의 발생량을 큰 폭으로 감소시키는 것이 가능하다. 단, 샌드벨트의 종류에 따라서는 충분한 효과를 얻지 못하는 경우도 있으므로(예를 들면, 나일론제로 도전성 뒷면이 없는 것을 사용했을 경우), 다른 대책을 병용해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-002",
      "text": "도전성 롤러에 요구되는 전기적 성능으로는 원주를 따라 동일 폭의 금속박을 휘감은 후, 롤러와 축 사이를 절연저항계로 측정한 저항이 1 MΩ 이하 이어야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-003",
      "text": "대전방지를 목적으로 한 접지극은 접지저항이 1 kΩ 이하가 되도록 설치해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 접지",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-004",
      "text": "공기압축기 등 전기기기의 접지극에 대한 접지저항은 3종접지로 하여야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": "대전방지 전용 접지극 설치가 어려운 경우 이용 가능한 접지설비",
      "workProcessPhase": "연마기 접지",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-005",
      "text": "금속제의 수도관, 건물의 철골 등으로 지중에 깊게 매설된 것은 통상 100 Ω 이하의 접지저항을 갖고 있어 접지극으로 이용할 수 있다. 단, 경질 비닐제품 수도관 등 절연성인 것이 있을 수 있으므로 사전에 확인해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 접지",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-006",
      "text": "간이 접지봉을 지면에 박아 접지극으로 사용할 수 있다. 설치 장소는 연중 습윤 토양이 있는 곳으로 하며, 설치 후에 접지저항을 측정해 1 kΩ 이하인지 확인해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": "접지공사 적합 접지설비 및 지중 매설 금속 부재를 이용할 수 없는 경우",
      "workProcessPhase": "연마기 접지",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-007",
      "text": "접지선은 유연성이 있으면서 쉽게 단선되지 않는 굵기를 가진 도선(예를 들면, 1.25 mm² 이상의 주석도금 동선)으로 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 접지선 접속",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-008",
      "text": "단선 유무를 쉽게 육안으로 확인할 수 있도록 피복이 없는 것 또는 투명한 피복을 가진 것을 사용한다. 단, 부식, 녹 등의 화학변화 또는 현지한 마찰 등의 물리적 작용으로 손상을 입을 가능성이 있을 경우에는 유연하고 튼튼한 피복을 가진 도선(예를 들면, 캡 타이어 케이블)으로 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 접지선 접속",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-009",
      "text": "접지선의 말단은 환형 단자로 처리하고, 이것을 연마기 본체 또는 조인트 금구(연마기 본체와 전기적으로 도통이 있는 경우에 한정한다)에 나사로 고정한다. 또한, 휴대형에 부착하는 경우에는 에어호스를 따라 접착테이프 등으로 고정해 일체화하고, 작업성의 확보와 접지선의 보호를 실시한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 접지선 접속",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-010",
      "text": "에어호스에 도전성 가공을 하고, 양단의 조인트 금구 사이의 전기저항이 1 MΩ 이하인 것을 말한다(전기저항은 제조업자가 발행한 성능표에 의해 확인하거나 또는 절연저항계를 이용해 실측한다).",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": "도전성 에어호스의 전기적 성능 기준",
      "workProcessPhase": "연마기 접지선 접속",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-011",
      "text": "공기압축기의 접지를 확인할 수 없는 경우에는 부속의 접지선을 이용해 접지극에 접속한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 접지선 접속",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-012",
      "text": "작업자는 정전기 대전방지복 및 정전화를 착용해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업자 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-013",
      "text": "정전화는 작업조건에 적당한 것을 선택하고, 구두끈을 황색으로 하거나 라벨을 붙이는 등 다른 신발과 명료하게 구별이 가도록 조치해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업자 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-014",
      "text": "정전화는 신발 창에 도전성을 부여한 것이기 때문에, 플라스틱으로 된 중간 깔개 등 도통을 저해하는 것을 병용해서는 안 된다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업자 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-015",
      "text": "맨발 또는 신발 창이 극단적으로 줄어든 신발의 착용은 저압전선로 혹은 누전기기에 접촉했을 때 감전의 우려가 있으므로 절대로 피해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업자 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-016",
      "text": "대전방지 작업바닥은 인체의 정전기를 신속하게 소멸시키기 때문에, 100 MΩ 이하의 누설 저항을 가져야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업바닥 도전화",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-017",
      "text": "바닥 면에 절연성의 도막, 시트 등이 존재하지 않으면 충분한 대전방지 성능을 가진다. 단, 혹한 겨울철 저습도 시에는 성능이 불충분해질 수 있으므로, 하루에 1~2회 정도는 살수, 물 분무 등에 의해 바닥의 표면에 습기를 주어야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": "흙, 목판 또는 콘크리트 바닥의 대전방지 성능 유지",
      "workProcessPhase": "작업바닥 도전화",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-018",
      "text": "대전방지용 매트는 카본블랙 등을 배합하여 도전성을 갖게 한 고무제의 매트이다. 절연성 도막이 없는 철, 알루미늄 등의 금속관도 이용할 수 있다. 사용하기 전에 코킹, 나사고정 등의 방법으로 접지선을 부착해 접지극에 연결하거나 본딩을 해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업바닥 도전화",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-019",
      "text": "의자에 착석하는 등 신발과 바닥의 접촉이 충분하지 않은 경우 또는 일시적으로 절연성 물체에서 연마작업을 할 경우에는 리스트 스트랩을 손목에 설치해 이것을 접지 또는 연마기에 본딩함으로써 인체의 대전방지를 실시한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업자 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-020",
      "text": "리스트 스트랩은 감전을 방지하기 위해 1 MΩ의 저항이 포함된 것을 선택한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업자 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-021",
      "text": "휴대형 연마기에 나일론 등의 수지제 연마포 종이를 부착하고, 금속부품 등을 연마할 경우에는 피연마물도 대전할 우려가 있으므로 접지해야 한다. 지그를 접지해 두거나, 피연마물에 클립을 부착해 접지를 할 수 있다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "피연마물 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-022",
      "text": "피연마물이 절연물(플라스틱 등)일 경우에는 접지 효과나 정전기 방전 가능성이 거의 없지만, 많은 먼지가 묻어 있거나 전격을 일으킬 경우에는 즉시 피연마물의 표면을 물로 적신 천이나 분무기로 닦아내어 제전시켜야 한다. 단, 시너, 알코올 등의 인화성 액체를 제전 목적으로 사용해서는 안 된다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "피연마물 정전기 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-023",
      "text": "가솔린, 시너, 알코올 등 인화성이 높은 액체를 연마작업 중에 사용해서는 안 된다. 만약, 인화성 액체를 사용한다면 사용 후 연마 작업 장소의 근처에 방치해서는 안 된다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "가연성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-024",
      "text": "스프레이 캔에는 부탄 및 프로판의 혼합물인 액화석유가스(LPG) 또는 디메틸에테르(DME)와 같은 가연성 가스가 대량으로 포함되어 있으므로 연마작업 중에 사용해서는 안 된다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "가연성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-025",
      "text": "공기보다 비중이 큰 가스 및 증기는 바닥면 부근에 체류하므로 작업 환경을 잘 통풍되도록 해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "가연성 물질 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-026",
      "text": "마그날륨, 알루미늄 등의 경금속 제품을 연마할 경우에는 충분한 흡입능력을 가진 제진장치를 갖추고, 습식 집진기를 이용해야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "경금속 분진 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-027",
      "text": "연마기 주변에 분진이 대량으로 퇴적하지 않도록 정기적으로 물기를 짜낸 걸레 혹은 종이 등으로 닦아내야 한다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "경금속 분진 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-028",
      "text": "전기 청소기는 경금속 분진을 흡입하면 더스트 박스 내에서 분진 폭발을 일으킬 우려가 있으므로, 절대 사용해서는 안 된다. 더불어, 철, 티타늄 등 다른 금속 분진에 대해서도 경금속과 마찬가지로 주의가 필요하다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "경금속 분진 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-029",
      "text": "고정형의 경우에는 연마기 전체를 하우징에 넣고 샌드벨트에 상시 물을 공급함으로써, 대전방지와 연마분진의 제거를 동시에 실시할 수 있다. 경금속 합금을 연마하는 공정에 권장되는 방법이다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "연마기 정전기 대책",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-030",
      "text": "양말의 착용에 관해서는 특별히 제한은 없지만, 혹한 겨울철에 두꺼운 양말을 착용했을 경우에는 발한으로 인해 섬유에 습기가 있을 때 까지 시간(10 분 정도)을 두는 것이 바람직하다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": "작업자 정전기 대책",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-031",
      "text": "전문가에 의해 시공하며, 적절한 방법으로 성능을 검사해 두는 것이 바람직하다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": "대전방지 작업바닥 시공 시",
      "workProcessPhase": "작업바닥 도전화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-032",
      "text": "대전방지 성능을 유지하기 위해 정기적으로 보수를 실시할 필요가 있다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": "대전방지 작업바닥",
      "workProcessPhase": "작업바닥 도전화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-033",
      "text": "도전성 에어호스를 이용했을 경우와 비교해, 단선에 의한 접지불량의 우려가 없으며, 작업성에도 거의 영향을 주지 않기 때문에 휴대형에 대해서는 특별히 권장하는 방법이다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": "도전성 에어호스를 이용한 접지",
      "workProcessPhase": "연마기 접지선 접속",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E142-034",
      "text": "연마작업에 있어서 정전기 대책은 연마기, 피연마물 및 작업자에 대해 동시에 실시해야만 충분한 효과는 기대할 수 있다.",
      "guideContext": "압축공기 구동식 연마기 정전기 대책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E142-001",
      "term": "정전기",
      "definition": "전계의 영향은 크나 자계의 영향이 상대적으로 미미한 전기를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E142-002",
      "term": "폭발성 분위기",
      "definition": "대기 상태에서 점화 후 혼합물을 통해 연소가 확산되는 가스, 증기, 미스트 또는 먼지 형태의 가연성 물질과 공기가 혼합된 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E142-003",
      "term": "인화점",
      "definition": "액체 표면에서 인화성 혼합물을 형성할 정도의 충분한 증기를 발생시키는 최소온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E142-004",
      "term": "정전기 방전",
      "definition": "인화성 혼합물을 점화시킬 수 있는 불꽃방전, 코로나방전, 브러시방전 등의 형태로 전하가 방출되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E142-005",
      "term": "본딩",
      "definition": "둘 또는 그 이상의 도전성 물질이 같은 전위를 갖도록 도체로 접속하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-E142-006",
      "term": "인화성 액체",
      "definition": "대기압에서 인화점이 60 ℃ 이하이거나 고온·고압의 운전조건으로 인하여 화재·폭발위험이 있는 상태에서 취급되는 액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E142-007",
      "term": "대전방지",
      "definition": "정전기 전하를 안전한 수준까지 방전시킨 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E142-01",
      "processOrder": 1,
      "processName": "접지극 확보 및 접지저항 확인",
      "safetyMeasures": "대전방지용 접지극의 접지저항이 1 kΩ 이하인지 확인한다. 접지공사 적합 접지설비, 지중 매설 금속 부재, 간이 접지봉 중 적합한 것을 선택한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-E142-02",
      "processOrder": 2,
      "processName": "연마기 접지 접속",
      "safetyMeasures": "접지선(1.25 mm² 이상 도선) 또는 도전성 에어호스(양단 1 MΩ 이하)를 이용하여 연마기를 접지극에 접속한다. 접지선 말단은 환형 단자로 처리하여 나사 고정한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-E142-03",
      "processOrder": 3,
      "processName": "작업자 대전방지 조치",
      "safetyMeasures": "정전기 대전방지복 및 정전화를 착용한다. 정전화에 도통을 저해하는 중간 깔개를 병용하지 않는다. 필요 시 리스트 스트랩(1 MΩ 저항 포함)을 장착한다.",
      "requiredPPE": [
        "정전기 대전방지복",
        "정전화",
        "리스트 스트랩"
      ],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-E142-04",
      "processOrder": 4,
      "processName": "작업바닥 대전방지 확인",
      "safetyMeasures": "대전방지 작업바닥(누설저항 100 MΩ 이하)을 확보한다. 흙·목판·콘크리트 바닥은 절연성 도막이 없는지 확인하고, 저습도 시 살수·물분무로 습기를 부여한다. 대전방지용 매트 사용 시 접지극에 연결한다.",
      "requiredPPE": [
        "정전화"
      ],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-E142-05",
      "processOrder": 5,
      "processName": "피연마물 접지 및 가연성 물질 관리",
      "safetyMeasures": "금속부품 연마 시 피연마물을 접지한다(지그 접지 또는 클립 부착). 절연물 연마 시 전격 발생 시 물로 제전한다. 연마작업 장소에서 인화성 액체·스프레이 캔 사용을 금지하고, 통풍을 확보한다.",
      "requiredPPE": [
        "정전기 대전방지복",
        "정전화"
      ],
      "sourceSection": "6.3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-E142-06",
      "processOrder": 6,
      "processName": "연마 작업 실시",
      "safetyMeasures": "연마기, 피연마물, 작업자에 대한 정전기 대책을 동시에 실시한 상태에서 작업한다. 벨트 연마기는 도전성 롤러를 사용한다. 고정형은 습식화를 권장한다.",
      "requiredPPE": [
        "정전기 대전방지복",
        "정전화"
      ],
      "sourceSection": "6",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-E142-07",
      "processOrder": 7,
      "processName": "경금속 분진 관리 및 청소",
      "safetyMeasures": "경금속 연마 시 충분한 흡입능력의 제진장치와 습식 집진기를 이용한다. 분진 퇴적 방지를 위해 정기적으로 물기를 짜낸 걸레로 닦아낸다. 전기 청소기는 분진 폭발 우려가 있으므로 절대 사용하지 않는다.",
      "requiredPPE": [
        "정전기 대전방지복",
        "정전화"
      ],
      "sourceSection": "7",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    }
