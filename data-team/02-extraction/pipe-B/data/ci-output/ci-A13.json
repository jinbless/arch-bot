  "checklistItems": [
    {
      "identifier": "CI-A13-001",
      "text": "모든 산 회화작업은 흄후드에서 이루어져야 한다.",
      "guideContext": "지르코니움 화합물 시료 전처리",
      "additionalDetail": "시약 및 기구 섹션의 특별 안전보건 예방조치 사항",
      "workProcessPhase": "시료 전처리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6-1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-A13-002",
      "text": "사용전 글러브, 마스크, 실험복 등의 보호구를 착용해야 하며, 실험 시 화재가 발생하지 않도록 주의해야 한다.",
      "guideContext": "지르코니움 화합물 취급 시 건강영향 및 예방조치",
      "additionalDetail": "호흡기, 피부접촉, 눈접촉 등으로 인해 흡수되며, 피부 및 점막의 자극 등을 일으킬 수 있음",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-A13-003",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.",
      "guideContext": "지르코니움 작업환경측정 분석 (법령 근거 미확인)",
      "additionalDetail": "분석에 사용하는 시약은 제조회사에서 표시하는 농도함량을 따른다",
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-004",
      "text": "광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의해야 하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.",
      "guideContext": "지르코니움 작업환경측정 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-005",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 달수 있어야 하며, 화학분석 용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 달 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "지르코니움 작업환경측정 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-006",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등 이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "지르코니움 작업환경측정 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-007",
      "text": "모든 유리기구는 사용 전에 질산으로 씻고 증류수로 헹구어 준다.",
      "guideContext": "지르코니움 작업환경측정 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6-1",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-008",
      "text": "2 L/min의 유량으로 총 480~960 L의 공기를 채취하며, 여과지에 채취된 먼지가 총 2 mg을 넘지 않도록 한다.",
      "guideContext": "지르코니움 작업환경측정 시료채취 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-009",
      "text": "채취가 끝난 여과지는 밀봉하여 먼지가 떨어지지 않도록 카세트를 바로 세워서 운반한다.",
      "guideContext": "지르코니움 작업환경측정 시료채취 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-010",
      "text": "지르코니움 0~1000 μg/mL가 되도록 100 mL 용량 플라스크에 4% HNO₃로 제조된 0.1 M NH₄F을 사용하여 최소 5개의 표준 용액을 제조한다.",
      "guideContext": "지르코니움 작업환경측정 검량선 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-011",
      "text": "표준용액의 흡광도 변이가 ±5%를 초과했다면 검량선을 재작성하여 시료를 분석한다.",
      "guideContext": "지르코니움 작업환경측정 정도관리 (법령 근거 미확인)",
      "additionalDetail": "작성한 검량선에 따라 보통 10개의 시료를 분석한 후 표준용액을 이용하여 분석기기 반응에 대한 재현성을 점검",
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-012",
      "text": "회수율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다.",
      "guideContext": "지르코니움 작업환경측정 회수율 검정 (법령 근거 미확인)",
      "additionalDetail": "회수율간의 차이가 크고 변이가 심하여 일정성이 없으면 그 원인을 찾아 교정하고 다시 실험을 실시해야 한다",
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-013",
      "text": "각 개인 시료채취펌프를 하나의 대표적인 시료채취매체로 보정한다.",
      "guideContext": "지르코니움 작업환경측정 시료채취 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-014",
      "text": "시료채취매체(막여과지)에 알고 있는 양의 분석대상물질을 첨가한 시료(spike 시료)로 회수율(recovery) 시험을 실시하여 현장 시료 분석값을 보정한다.",
      "guideContext": "지르코니움 작업환경측정 정도관리 (법령 근거 미확인)",
      "additionalDetail": "예상 시료량이 포함되도록 3가지 이상의 수준 및 각 수준별로 3개 이상의 시료를 만든다",
      "workProcessPhase": "검량선 작성 및 정도관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-015",
      "text": "계량기구중 측정값을 분석결과의 계산에 사용할 목적으로 사용되는 것은 모두 보정하는 것을 원칙으로 한다.",
      "guideContext": "지르코니움 작업환경측정 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A13-016",
      "text": "흡광도 기록을 저장한다.",
      "guideContext": "지르코니움 작업환경측정 분석 (법령 근거 미확인)",
      "additionalDetail": "만약 시료의 흡광도 값이 검량선 그래프 직선보다 위에 있다면 그 용액을 4% HNO₃로 제조된 0.1 M NH₄F으로 희석하여 재분석하고 농도계산 시 정확한 희석계수를 적용한다",
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A13-001",
      "term": "밀폐",
      "definition": "취급 또는 보관상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A13-002",
      "term": "밀봉",
      "definition": "취급 또는 보관상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A13-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A13-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ±10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A13-005",
      "term": "즉시",
      "definition": "30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A13-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A13-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A13-008",
      "term": "회수율",
      "definition": "채취한 금속 등의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 여과지에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-A13-01",
      "processOrder": 1,
      "processName": "시료채취 준비 및 보정",
      "safetyMeasures": "각 개인 시료채취펌프를 하나의 대표적인 시료채취매체로 보정한다. 시료채취 목적과 시료채취시간, 방해인자, 예상 오염농도 및 분석장비 능력을 종합적으로 고려하여 최적의 시료채취기구 및 분석방법을 선택한다.",
      "requiredPPE": [
        "글러브",
