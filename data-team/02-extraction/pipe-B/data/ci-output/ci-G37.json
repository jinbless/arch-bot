  "checklistItems": [
    {
      "identifier": "CI-G37-001",
      "text": "작업과정 전반에 상존하는 건강장해 요소를 찾아내어 근로자가 이에 노출되지 않도록 하고, 그 유해인자를 제거해야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.(1)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-002",
      "text": "관리감독자는 근로자가 그러한 유해인자에 노출되어 있는지를 항상 살펴야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.(1)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-003",
      "text": "건강관리는 유해인자가 상존하는 한 지속되어야 하며 그 노출정도에 따라 점검 및 조사 횟수와 기간을 조절하여야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-004",
      "text": "관련된 법규나 고시 또는 지침 등에 따라 조사 횟수를 정하여야 하고 사업장 자체 기준은 법적 기준 이상으로 정하는 것이 바람직하다.",
      "guideContext": "근로자의 일반적인 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "건강관리 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-005",
      "text": "사업주 등은 근로자 및 근로자 대표와 건강관리에 대한 충분한 논의를 선행함으로써 공감을 이루어야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": "근로자가 그 목적과 실행 방법 그리고 효과 등에 대해 확실히 인지하지 못하면 건강관리는 실패할 가능성이 높다.",
      "workProcessPhase": "건강관리 프로그램 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-006",
      "text": "사업주는 근로자의 건강과 안전에 전적인 책임을 져야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": "관련 법규와 규정에 따라 안전보건을 관리하고, 필요 시 외부 전문가의 도움을 요청해야 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-007",
      "text": "안전보건 전문가는 그 목적과 절차 등을 숙지하고 있는 경험자로서 실행능력을 갖추고 있어야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": "계속적인 전문적 훈련을 통해 요구되는 자질을 보유해야 한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.(4)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-008",
      "text": "유해인자에 직접 노출되어 있고 질병의 징후를 쉽게 인지할 수 있는 근로자는 자기 점검을 통해 이 사실을 즉시 보건관리자에게 알려야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자기 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(4).(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-009",
      "text": "유해위험물질 혹은 작업 과정상 유발되는 직접적인 유해위험요소 확인은 관리감독자가 담당하도록 하는 것이 좋다.",
      "guideContext": "근로자의 일반적인 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "유해요소 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(4).(나)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-010",
      "text": "유해인자 및 발생 징후에 대한 검사 혹은 조사는 자격을 갖춘 전문가가 수행하고, 그 결과에 대한 질의와 답변을 할 수 있게 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(4).(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-011",
      "text": "의학적 검사는 반드시 산업보건 의사에 의해 수행되고 관리되어야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": "결과에 대한 설명과 관련 질병 및 사후 조치에 대한 조언도 의사가 하여야 한다.",
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(4).(라)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-012",
      "text": "산업보건 의사는 생물학적 모니터링과 그 결과의 실행 및 관리를 하여야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "생물학적 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(4).(마)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-013",
      "text": "산업보건 의사는 근로자의 정신건강 및 산업심리 등을 고려한 모니터링을 실행하고 관리하여야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "병리학적 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(4).(바)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-014",
      "text": "건강관리 결과에 따라 유해인자에 대한 노출을 감소시키거나 제거하여 위해를 사전 방지하는 조치를 취한다. 특히 질병에 민감하거나 이미 영향을 받은 근로자를 우선적으로 조치한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4).(사)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-015",
      "text": "기존의 유해도 평가를 재검토하여 근로자를 보호하는 조치를 취하고 관리를 강화한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4).(사)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-016",
      "text": "건강관리 결과에 대한 평가는 그 프로그램 책임자에 의해 실행되어야 하며, 그 결과는 근로자 개인의 건강보호와 안전사고 예방을 위한 것이므로 충분히 설명하고 공지하여야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": "그 결과에 대한 철저한 분석과 논의를 통해 보다 효율적인 대응방안이 모색되도록 해야 한다.",
      "workProcessPhase": "결과 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4).(사)",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-017",
      "text": "건강관리 프로그램에는 개인별 건강기록이 반드시 포함되어야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": "건강관리가 요구되는 물질 및 과정에 노출되어 있는 작업에 대한 기록사항이며, 근로자의 작업 적합성과 제한사항에 따른 안전보건관리 절차의 이력을 포함하는 결과의 기록이다.",
      "workProcessPhase": "건강기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4).(사)-건강기록",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-018",
      "text": "개인신상에 관한 내용과 기록은 사생활 보호를 위해 비밀이 보장되도록 철저한 보안유지를 준수하여야한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4).(사)-건강기록",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-019",
      "text": "건강기록은 근로자가 건강관리를 받는 한, 그리고 유해위험요소 노출 후 오랜 기간 질병이 나타나지 않을 정도의 기간까지 계속 유지되어야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4).(사)-건강기록",
      "basedOn": null
    },
    {
      "identifier": "CI-G37-020",
      "text": "건강기록은 근로자에게 열람시켜 그 내용을 알도록 해야 한다.",
      "guideContext": "근로자의 일반적인 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(4).(사)-건강기록",
      "basedOn": null
    }
  ],
