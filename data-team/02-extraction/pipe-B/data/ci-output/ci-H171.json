  "checklistItems": [
    {
      "identifier": "CI-H171-001",
      "text": "밀폐설비나 국소배기장치 등의 환기장치를 설치해야 한다.",
      "guideContext": "TMAH 취급 전자산업 작업환경관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H171-002",
      "text": "TMAH를 직접 취급하거나 접액 등의 노출 위험이 있는 경우에는 불침투성 보호복, 보호장갑, 보호장화, 보안경, 방독마스크 등을 갖추고 적절한 보호구를 사용하도록 하여야 한다.",
      "guideContext": "TMAH 취급 전자산업 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-003",
      "text": "용액주입, 교체, 배관점검 등 TMAH 용액에 노출될 가능성이 있는 경우에는 전면형 방독마스크와 불침투성 보호의, 보안경 등을 착용해야 한다.",
      "guideContext": "TMAH 취급 전자산업 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H171-004",
      "text": "TMAH 정비보수 작업환경(낙하, 비래, 추락, 감전)을 고려하여 AB, AE, ABE 종 안전모를 착용한다.",
      "guideContext": "TMAH 설비 정비보수 보호구 (법령 근거 미확인)",
      "additionalDetail": "AB종: 낙하·비래·추락 충격 경감 / AE종: 낙하·비래 충격 경감, 감전방지 / ABE종: 낙하·비래·추락 충격 경감, 감전방지",
      "workProcessPhase": "정비보수 보호구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-005",
      "text": "TMAH 정비보수 작업 시 내화학 장화인 화학물질용 안전화를 착용한다.",
      "guideContext": "TMAH 설비 정비보수 보호구",
      "additionalDetail": "화학물질용 안전화: 물체의 낙하, 충격 또는 날카로운 물체에 의한 찔림 위험과 화학물질로부터 발을 보호하기 위한 것",
      "workProcessPhase": "정비보수 보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-006",
      "text": "TMAH 정비보수 작업시간을 고려하여 화학물질용 안전장갑의 성능수준을 선택한다.",
      "guideContext": "TMAH 설비 정비보수 보호구",
      "additionalDetail": "1~6의 성능 수준(Class), 숫자가 클수록 보호 시간이 길고 성능이 우수. 니트릴 내부 장갑과 외부에 화학물질용 안전장갑 착용 권고",
      "workProcessPhase": "정비보수 보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-007",
      "text": "TMAH로부터 호흡기 보호, 접액을 막기 위해 전면형 방독마스크를 착용한다. 정화통의 종류는 가급적 복합용 이상을 착용한다.",
      "guideContext": "TMAH 설비 정비보수 보호구",
      "additionalDetail": "복합용 정화통: 유기화합물용+암모니아 / 겸용 정화통: 방진1급+유기화합물용+암모니아",
      "workProcessPhase": "정비보수 보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H171-008",
      "text": "화학물질용 보호복(내화학복)은 작업공간이 밀폐공간일 경우 1형식, TMAH에 직접 노출될 위험이 있을 경우 가급적 3형식 이상을 착용한다.",
      "guideContext": "TMAH 설비 정비보수 보호구",
      "additionalDetail": null,
      "workProcessPhase": "정비보수 보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-009",
      "text": "취급 장소 주변에 즉시 사용할 수 있는 세면시설 및 목욕시설을 설치하여야 한다.",
      "guideContext": "TMAH 취급 비상세척시설",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-010",
      "text": "비상세척 및 세안설비를 설치하는 경우 잘 보이는 곳에 긴급샤워기 설치 안내표지판(경광등)을 설치해야 한다.",
      "guideContext": "TMAH 취급 비상세척시설",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-011",
      "text": "세척설비는 10초 이내에 도달할 수 있는 곳, 접근하는데 방해물이 없도록 설치해야 한다.",
      "guideContext": "TMAH 취급 비상세척시설",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-012",
      "text": "조작 밸브는 원터치로 1초 내로 조작 가능하여야 한다.",
      "guideContext": "TMAH 취급 비상세척시설",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-013",
      "text": "원래의 용기에만 보관한다.",
      "guideContext": "TMAH 취급 예방조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예방조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-014",
      "text": "분진, 흄 가스, 미스트, 증기, 스프레이를 흡입하지 않는다.",
      "guideContext": "TMAH 취급 예방조치",
      "additionalDetail": null,
      "workProcessPhase": "예방조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H171-015",
      "text": "눈, 피부, 의복에 묻지 않도록 한다.",
      "guideContext": "TMAH 취급 예방조치",
      "additionalDetail": null,
      "workProcessPhase": "예방조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H171-016",
      "text": "취급 후에는 취급 부위를 철저히 씻어낸다.",
      "guideContext": "TMAH 취급 예방조치",
      "additionalDetail": null,
      "workProcessPhase": "예방조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H171-017",
      "text": "TMAH가 함유된 제품을 사용할 때에는 먹거나, 마시거나 흡연하지 않는다.",
      "guideContext": "TMAH 취급 예방조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "예방조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-018",
      "text": "옥외 또는 환기가 잘 되는 곳에서만 취급한다.",
      "guideContext": "TMAH 취급 예방조치",
      "additionalDetail": null,
      "workProcessPhase": "예방조치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H171-019",
      "text": "TMAH를 제조하거나 수입하는 사업장은 물질안전보건자료(MSDS)를 한글로 작성하여 제공하여야 한다.",
      "guideContext": "TMAH 유해성 정보 제공",
      "additionalDetail": null,
      "workProcessPhase": "정보 제공 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H171-020",
      "text": "TMAH를 사용하는 사업장은 취급하는 장소에 한글로 작성된 MSDS를 비치하고 게시하여야 한다.",
      "guideContext": "TMAH 유해성 정보 제공",
      "additionalDetail": null,
      "workProcessPhase": "정보 제공 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H171-021",
      "text": "현장에서 TMAH 취급 시 중요한 위험정보 및 관련 사고사례를 한눈에 쉽게 확인할 수 있는 One page sheet MSDS를 추가로 비치하는 것을 권장한다.",
      "guideContext": "TMAH 유해성 정보 제공",
      "additionalDetail": null,
      "workProcessPhase": "정보 제공 및 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-022",
      "text": "TMAH의 용기 및 포장, 작업장 벽면 등에는 한글로 작성된 시인성이 좋은 피부흡수 경고표지 및 작업 시 준수사항 등을 부착하여야 한다.",
      "guideContext": "TMAH 유해성 정보 제공",
      "additionalDetail": null,
      "workProcessPhase": "정보 제공 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H171-023",
      "text": "TMAH 취급근로자에 대한 MSDS(물질의 특성 및 유해성·위험성, 적절한 보호구, 응급조치 요령, 급성중독 사례, 피부흡수 위험성 등) 교육을 실시하여야 한다.",
      "guideContext": "TMAH 유해성 교육",
      "additionalDetail": null,
      "workProcessPhase": "정보 제공 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H171-024",
      "text": "산업안전보건법 제106조 및 제125조, 동법 시행규칙 제144조에 따른 화학물질 및 물리적 인자의 노출기준을 통해 TMAH에 대해 노출기준을 1 mg/㎥으로 설정하여 관리하는 법적 사항에 대하여 관리자 및 근로자에게 인지 및 교육을 실시하여야 한다.",
      "guideContext": "TMAH 유해성 법적 교육",
      "additionalDetail": "TMAH 노출기준: 1 mg/㎥ (고용노동부 고시 제2020-48호)",
      "workProcessPhase": "정보 제공 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H171-025",
      "text": "TMAH 취급 시 급성노출 발생 방지를 위하여 ASSA(Acute Substance Safety Assessment) 체크리스트를 통해 작업 중 유해성 및 위험성을 쉽고 간단하게 인지하고 평가할 수 있도록 한다.",
      "guideContext": "TMAH 취급 체크리스트 점검",
      "additionalDetail": null,
      "workProcessPhase": "체크리스트 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-026",
      "text": "눈에 TMAH가 들어갔을 때 주변 작업자(비노출자)는 즉시 비상 연락망으로 전화하여 구급차를 부른다.",
      "guideContext": "TMAH 노출 사고 응급조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-027",
      "text": "눈에 TMAH가 들어갔을 때 피재자(노출자)는 최대한 빠른 시간 내에 세척시설로 가서 즉시 씻는다. 구급차가 도착하면 인공호흡기를 하고 재빨리 응급실에 가 처치를 받는다.",
      "guideContext": "TMAH 노출 사고 응급조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-028",
      "text": "피부에 TMAH가 접촉했을 때 주변 작업자(비노출자)는 즉시 비상 연락망으로 전화하여 구급차를 부른다.",
      "guideContext": "TMAH 노출 사고 응급조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-029",
      "text": "피부에 TMAH가 접촉했을 때 피재자(노출자)는 오염된 모든 의복을 즉시 벗고 피부(또는 머리카락)를 최대한 빠른 시간 내에 씻는다. 구급차가 도착하면 인공호흡기를 하고 재빨리 응급실에 가 처치를 받는다.",
      "guideContext": "TMAH 노출 사고 응급조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-030",
      "text": "오염된 의복은 다시 사용하기 전 피부에 노출되지 않게 내화학(불침투성) 보호구를 착용 후 세척한다.",
      "guideContext": "TMAH 노출 사고 응급조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H171-031",
