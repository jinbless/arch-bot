  "checklistItems": [
    {
      "identifier": "CI-G9-001",
      "text": "사업주는 작업장에 위험이 어떤 형태로 존재하며 근로자들이 어떻게 위험에 노출될 수 있는지, 그리고 위험으로 인한 안전·보건상의 문제에 대한 응급서비스 체계는 어떻게 세워져 있는지 등을 설명해야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-002",
      "text": "응급상황이 발생했을 때 필요한 행동에 대한 정보를 미리 준비하고 있어야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-G9-003",
      "text": "사업주는 작업현장에 있는 위험물 종류와 총량을 예측하여 작업현장에 게시하여야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "위험물 종류·총량 파악 및 게시",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-004",
      "text": "위험물 총량은 위험물안전관리법에 규정되어 있는 위험물의 종류에 따라 허가받은 양을 넘지 않아야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": "단, 급성독성물질, 부식성물질, 인화성가스는 이 법의 적용을 받지 않는다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-G9-005",
      "text": "저장, 제조, 사용 또는 완성품이 저장되어 있는 양은 총량에 포함한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-G9-006",
      "text": "선박, 열차에서 하역하여 현장에 보관하는 탱크, 컨테이너, 드럼통에 저장된 양과 작업현장 내에서 운송용으로 이용되는 차량에 저장된 양도 총량에 들어가야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-G9-007",
      "text": "작업현장의 책임자는 특정상황에 대하여 소방기관과 관계기관에 서면으로 신고를 한 경우를 제외하고는 총량 기준 이상의 위험물이 어떤 순간에도 작업현장에 존재하지 않는 것을 확인하여야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "소방기관 신고",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-G9-008",
      "text": "게시에 변화가 생겼을 때 책임자는 소방기관과 관계기관에 그 변화에 대하여 알려야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": "변화 내용: (가) 위험물 보관 중지, (나) 취급·저장량 증감 변동",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-G9-009",
      "text": "작업현장에 허가받은 위험물의 종류별 기준량 이상이 되면 지역 소방기관과 관계기관에 신고해야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": "현재 실제 존재하는 위험물 총량의 합계뿐만 아니라 미래에 존재하게 될 예측 가능한 위험물의 양도 파악하여야 한다.",
      "workProcessPhase": "소방기관 신고",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-G9-010",
      "text": "안전관리자는 소방서로부터 허가받은 위험물 제조소 또는 저장소 자료를 토대로 현장에 위험물의 종류별로 기준 이상의 위험물이 존재하거나 앞으로 존재하게 될 것인지의 여부를 판단해야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "안전보건표지 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-G9-011",
      "text": "안전관리자는 표지를 통해 해당 현장에 위험물이 존재한다는 것을 근로자, 소방관, 기타 이해관계자들에게 경고할 필요가 있다는 합리적 근거를 가지고 있어야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "안전보건표지 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-012",
      "text": "안전관리자는 표지가 설치되어야 하는 현장이 규정에 명시된 표지들 중 어떤 부분에 해당하는지를 고려해야 한다. 표지의 제작은 금지, 경고, 지시, 안내 등 표지의 용도에 맞는 모형, 색상, 심볼, 문구를 사용한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "안전보건표지 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-013",
      "text": "현장의 책임자는 가능한 한 법령이나 규정에 의해 현장에 설치된 안전표지들이 장애물로부터 시야를 가리지 않도록 해야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "안전보건표지 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-014",
      "text": "표지들은 작업현장 또는 해당 위치에 근로자, 소방관, 기타 이해관계자들이 쉽게 볼 수 있고, 표지가 포함하고 있는 그림과 글귀를 알아볼 수 있도록 확실한 상태를 유지해야 한다. 따라서 물건 더미, 주차된 차량, 발판 등 표지의 명시성을 해치는 것들은 즉시 치워져야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "안전보건표지 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-015",
      "text": "경고표지는 위험물을 제조, 취급, 사용, 저장 등의 경우에 모든 작업현장의 입구 등 근로자, 소방관, 기타 이해관계자 등이 쉽게 알아볼 수 있는 장소·시설에 부착하거나 표시하여야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "경고표지 부착",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-016",
      "text": "경고 표지는 법령이나 규정에서 정한 모양과 색상으로 만들어져야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": null,
      "workProcessPhase": "경고표지 부착",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-017",
      "text": "경고표지는 강화 알루미늄, 강화 플라스틱, PVC 등 쉽게 파손되거나 변질되지 않는 소재로 제작되어야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": "현장의 상황을 고려하여 반사되거나 발광하게 할 수 있다.",
      "workProcessPhase": "경고표지 부착",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-018",
      "text": "경고표지들은 위급상황에 쓰일 용도로 특별히 만들어진 입구를 포함하여 모든 현장 입구나 근처의 잘 보이는 위치에 부착하거나 표시하여야 한다.",
      "guideContext": "위험물질 취급작업장 위험표시",
      "additionalDetail": "표지들은 단독으로 세우거나 펜스에 고정시킬 수 있으며, 건물의 전면에 놓을 수도 있다. 그러나 문이나 입구는 업무 시간 중에 주로 열어놓는 관계로 표지를 긴 시간 가릴 수 있는 문이나 입구 등의 자리는 피해야 한다.",
      "workProcessPhase": "경고표지 부착",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G9-019",
      "text": "안전관리자의 지시와 지시의 철회는 반드시 서면으로 하지 않아도 되지만, 간단한 경우를 제외하고는 서면으로 하는 것을 권장한다.",
      "guideContext": "위험물질 취급작업장 위험표시 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전보건표지 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G9-001",
      "term": "위험물질",
      "definition": "물질 중에서 화재, 폭발, 급성독성 등의 원인이 되는 위험성을 가진 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "DT-G9-002",
      "term": "폭발성물질",
      "definition": "가열, 마찰, 충격 또는 다른 화학물질과의 접촉 등으로 인하여 산소나 산화제의 공급이 없더라도 폭발 등 격렬한 반응을 일으킬 수 있는 고체나 액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "DT-G9-003",
      "term": "발화성물질",
      "definition": "스스로 쉽게 발화하거나 물과 접촉하여 발화하고 인화성가스를 발생할 수 있는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-002"
      ]
    },
    {
      "identifier": "DT-G9-004",
      "term": "산화성물질",
      "definition": "산화력이 강하고 가열, 충격 다른 화학물질과의 접촉으로 인하여 격렬하게 분해되거나 반응하는 고체나 액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "DT-G9-005",
      "term": "인화성액체",
      "definition": "대기압 하에서 인화점이 60℃이하인 인화성액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "DT-G9-006",
      "term": "인화성가스",
      "definition": "인화한계 농도의 최저한도가 13퍼센트 이하 또는 최고한도와 최저한도의 차가 12퍼센트 이상인 가스를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-EXCAVATION-012"
      ]
    },
    {
      "identifier": "DT-G9-007",
      "term": "부식성물질",
      "definition": "금속 등을 쉽게 부식시키고 인체에 접촉하면 심한 상해를 입히는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G9-008",
      "term": "급성독성물질",
      "definition": "독성이 강한 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G9-009",
      "term": "소방기관",
      "definition": "소방기본법에 따라 화재를 예방·경계하거나 진압하고 화재, 재난 그 밖의 위급한 상황에서의 구조·구급 활동에 관한 의무를 이행하는 기관을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G9-010",
      "term": "현장",
      "definition": "저수위표(Low water mark)위의 모든 땅과 대부분의 강 하류, 자연항 그리고 특정 만을 포함하는 한국의 모든 토지와 내륙수로를 포함한다. 이는 수상이든 지상이든 모든 건축물, 토지, 구조물, 부두, 방파제 등을 포함한 근로자의 통제 하에 있는 장소와, 저장, 가공 또는 처리의 목적으로 정박 중인 모든 선박, 승강장 등을 포함한 내륙 수로에서 근로자의 통제 하에 있는 구조물로 이루어져 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G9-011",
      "term": "게시",
      "definition": "사업주가 근로자에게 글이나 그림으로 써서 알리는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-017"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-G9-01",
      "processOrder": 1,
      "processName": "위험물 종류 및 총량 파악",
