  "checklistItems": [
    {
      "identifier": "CI-P122-001",
      "text": "가스 공급설비와 가스 누설검지기는 가스에 관한 충분한 지식을 가지고 있고, 교육을 받은 자에 한해 조작 및 관리가 이루어져야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P122-002",
      "text": "인화성 가스를 취급하는 가스 공급설비는 반드시 정전기 제거용 접지가 이루어져야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-ELECTRIC-024",
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-P122-003",
      "text": "비상시를 대비하여 충분한 보호구를 구비하여야 하며, 모든 근로자는 사용법을 숙지하여야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P122-004",
      "text": "실린더를 교체 시에는 전용공구를 사용하여 작업하여야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-005",
      "text": "가스 공급실 내의 온도는 23±2 ℃, 상대습도는 50±10 %를 유지하여 작업 시 발생할 수 있는 정전기에 의한 스파크를 방지하여야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-HEAT-001",
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P122-006",
      "text": "실린더 교체작업 절차서는 위험성 평가를 통해 도출된 위험요인과 이에 대한 안전대책을 충분히 반영하여 작성하여야 하며, 교체작업은 반드시 정해진 절차서를 준수하여 수행하여야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-007",
      "text": "실린더 교체 시에는 메인밸브(Main valve) 교체상태, 가스 이름, 모니터 상태, 가스킷(Gasket) 상태를 확인하고, 가스 캐비닛의 내부 청소를 실시한 후에 교체하여야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": "실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-008",
      "text": "배관에 설치되는 밸브는 개방시간이 지나치게 짧은 형식(Quick open type)을 사용해서는 아니 된다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-P122-009",
      "text": "점검실시 중 이상이 발생한 경우에는 반드시 이상발생을 조치완료한 후에 재점검을 실시하여야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-010",
      "text": "점검 중 불필요한 설비조작은 절대 금하여야 한다.",
      "guideContext": "가스 벌크시스템 일반 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-011",
      "text": "가스 보관소에서 가스 공급실과 작업장 내로 반입되는 실린더는 교체작업 전에 반드시 질소 및 와이퍼로 클리닝을 실시하여 이물질이 작업장 내로 유입되는 것을 방지한다. 특히, 작업장 내로 반입되는 가스 실린더는 외부를 깨끗하게 청소한 후 장착하여야 한다.",
      "guideContext": "가스 실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-012",
      "text": "가스 실린더를 운반할 때에는 지정된 대차를 사용하고, 안전고리를 체결한 상태로 이동하여야 한다.",
      "guideContext": "가스 실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-013",
      "text": "가스 실린더를 교체하기 전에 이전에 사용했던 실린더 내부의 가스가 완전히 제거되었는지 확인하여야 한다.",
      "guideContext": "가스 실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-014",
      "text": "공병 탈착 시 상태를 확인하고, 정해진 작업순서에 의해 탈착한 후 지정된 대차를 이용하여 운반하여야 한다.",
      "guideContext": "가스 실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-015",
      "text": "실병을 가스 공급설비에 장착한 후에는 가스 실린더의 밸브 보호캡 및 밸브 풀림 장지용 비닐을 제거하여야 한다.",
      "guideContext": "가스 실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-016",
      "text": "실린더 모니터 부위를 확인하고, 이상이 없으면 와이퍼로 먼지, 수분, 유분 등의 오염물을 제거하여야 한다.",
      "guideContext": "가스 실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-017",
      "text": "새로운 실린더를 장착할 때에는 가스 누설방지를 위해 새 가스킷을 와이퍼로 닦은 후 사용하여야 한다. 이때, 가스킷은 1회 사용 후 폐기하는 것을 원칙으로 한다.",
      "guideContext": "가스 실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-018",
      "text": "새로운 실린더를 장착한 후에는 배관내의 잔류 공기 및 배관 청소를 목적으로 질소로 사이크론퍼지(Cycle purge)를 실행하여야 한다.",
      "guideContext": "가스 실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-019",
      "text": "가스 실린더를 교체작업한 후에는 질소 또는 헬륨을 이용하여 가압누설시험을 실시하여야 한다.",
      "guideContext": "가스 실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-020",
      "text": "가스 실린더의 가압누설시험을 완료한 후에 공급준비 또는 공급을 실시하여야 한다.",
      "guideContext": "가스 실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-021",
      "text": "모든 작업은 최소한 2명 이상이 조를 이루어 실시하여야 하며, 감독자 1명이 입회하도록 하여야 한다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-022",
      "text": "실린더를 운반 시에는 지정된 대차를 사용하여 이동하여야 한다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-023",
      "text": "공병이 자동으로 교체되는 시스템으로 운전되는 경우에는 용기의 메인밸브를 단은 후 자동교체시스템을 가동하여야 하여야 한다. 이 경우 배관 내 잔류가스를 배출시키면 라인 퍼지(Line purge) 작업이 자동으로 실시된다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-024",
      "text": "자동교체시스템에서 실린더 교체단계에 도달하면 공병 체결부위를 분리하여야 한다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-025",
      "text": "공병에 설치된 히터재킷(Heater jacket)을 분리한 후 지정된 대차를 이용하여 실린더를 교체하여야 한다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-026",
      "text": "옥내 저장실로 반입되는 톤실린더는 교체작업 전 밸브 보호캡 및 비닐을 제거하고, 청소를 실시하여 이물질이 유입되는 것을 방지하여야 한다.",
      "guideContext": "톤실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-027",
      "text": "실병을 로드셀로 이동하여 체결 가능토록 위치를 설정한 후 대차를 고정시켜야 한다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-028",
      "text": "실병 체결 시 가스누설을 방지하기 위해서 가스킷을 사용하여야 한다. 다만, 가스킷은 1회 사용 후 폐기를 원칙으로 한다.",
      "guideContext": "톤실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-029",
      "text": "실병 체결 후에는 관세정(Line cleaning)을 위해 질소를 이용하여 사이클론 퍼지를 실시하여야 한다.",
      "guideContext": "톤실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-030",
      "text": "가압시험이 시작되면 실린더 연결부위를 헬륨검사기를 사용하여 누설검사를 실시하여야 한다.",
      "guideContext": "톤실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-031",
      "text": "퍼지가 완료된 후에는 자동진행순서에 따라 계속 진행하여야 한다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-032",
      "text": "가스를 배관 내에서 공급할 때 실린더 연결부위를 휴대용 누설검사기(Portable leak detector)를 사용하여 누설검사를 실시하여야 한다.",
      "guideContext": "톤실린더 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-033",
      "text": "교체작업이 완료되면 실린더 공급 현황판에 가스 명, 설치일자, 설치자, 압력 등 필요한 항목을 기입하여야 한다.",
      "guideContext": "톤실린더 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톤실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-034",
      "text": "모든 작업은 감독자 1명 입회하에 2인 1조로 작업을 실시하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-035",
      "text": "운반 시에는 운반용 기계를 사용하여 이동하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-036",
      "text": "옥외 저장실로 반입되는 트레일러는 교체작업 전 세정을 실시하여 이물질이 유입되는 것을 방지하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-037",
      "text": "공차는 자동교체 시 트레일러의 다기관메인밸브(Manifold main valve)와 다기관서브밸브(Manifold sub-valve)는 자동으로 닫히게 되지만, 트레일러 용기의 수동밸브는 수동작업으로 닫아야 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-038",
      "text": "공차는 자동진행 전에 반드시 설정값을 확인하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-039",
      "text": "독성 및/또는 인화성 가스의 교체작업을 할 경우, 자동진행 전 반드시 소형소각로(Burn box) 및/또는 중화설비가 가동되고 있는가를 확인한 후 배출 및 자동진행을 시작하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-P122-040",
      "text": "작업이 자동으로 진행되는 경우에는 '실린더 교체 단계'에서 트레일러와 플렉시블 호스(Flexible hose) 체결부위를 분리하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-041",
      "text": "운반용 기계를 이용하여 공차를 옥외저장실 밖으로 이동하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-042",
      "text": "실차를 옥외저장실 내로 이동하여 뒷바퀴에 고임목을 설치하고, 트레일러 뒷문을 열어 고정시킨 후 밸브 보호캡 및 비닐을 제거하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-043",
      "text": "실차 커넥터(Connector) 부위의 이상 유무를 확인하고, 이상이 있으면 와이퍼로 오염물을 제거하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-044",
      "text": "실차 체결 시 가스누설을 방지하기 위해 가스킷을 사용하여야 한다. 다만, 가스킷은 1회 사용 후 폐기를 원칙으로 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-045",
      "text": "실차 체결 후에는 트레일러의 모든 용기의 밸브를 열고, 송유관 세정을 위해 헬륨을 이용하여 사이클론 퍼지를 실시하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-P122-046",
      "text": "퍼지를 완료한 후에는 트레일러의 다기관메인밸브를 열고, 헬륨검사기로 누설검사를 실시하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-047",
      "text": "가스를 배관 내에 공급하기 위해 용기의 모든 밸브를 열어야 하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-048",
      "text": "트레일러 교체작업 중 누설발생 시에는 누설위치 및 조치 후 재시험을 실시하여야 한다. 이때, 조치가 불가능한 경우에는 발생 즉시 선임자에게 보고 조치토록 한다.",
      "guideContext": "튜브 트레일러 교체작업",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-049",
      "text": "교체작업이 완료되면 트레일러 공급 현황판에 가스 명, 설치일자, 설치자, 압력 등 필요한 항목을 기입하여야 한다.",
      "guideContext": "튜브 트레일러 교체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "튜브 트레일러 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-050",
      "text": "가스 실린더를 교체하기 전에 비상구, 소화기 비치위치, 비상샤워설비(Emergency shower) 또는 세안기(Eye shower) 위치 등을 확인하여야 한다.",
      "guideContext": "비상대응 및 개인보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-P122-051",
      "text": "교체하고자 하는 가스 실린더의 위험성을 고려하여 해당물질의 GHS-MSDS 제8항(노출방지 및 개인보호구)에 제시된 개인보호구를 비치하고, 작업 시 개인보호구를 착용하여야 한다.",
      "guideContext": "비상대응 및 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "가스 실린더 교체",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P122-052",
      "text": "<표 1>에 수록된 물질 중 염소, 불화수소, 포스핀 등은 노출농도에 따라 호흡용보호구의 종류가 달라지므로 특히 유의하여야 한다.",
      "guideContext": "비상대응 및 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P122-053",
      "text": "개인보호구 착용 시 호흡용보호구에 필터가 장착되는 경우에는 필터의 유효기한을 확인하여야 한다.",
      "guideContext": "비상대응 및 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P122-054",
      "text": "인화성 가스를 취급하는 경우에는 제전복과 제전화를 착용하여야 한다.",
      "guideContext": "비상대응 및 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P122-055",
      "text": "<표 1>에 수록된 물질 중 NFPA 화재위험성이 있는 물질뿐만 아니라 화재 위험성이 없다고 제시된 물질이라고 해도 해당물질과 관련하거나 인근에서 화재가 발생할 경우를 대비하여 해당물질의 GHS-MSDS 제5항(폭발·화재 시 대처방법)을 참조하여야 한다.",
      "guideContext": "비상대응 및 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P122-056",
      "text": "염화수소의 경우 NFPA 화재위험성은 0이지만 과열하면 폭발할 수 있으므로, 주의하여야 한다.",
      "guideContext": "비상대응 및 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P122-057",
      "text": "<표 1>에 수록된 물질 중 인화성이 높은 포스핀, 실란, 디보란 및 암모니아 등의 경우, 해당 물질과 관련된 화재 시 알콜포말, 이산화탄소 또는 물분무를 사용하여 화재를 진압하는 것이 바람직하다.",
      "guideContext": "비상대응 및 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P122-001",
      "term": "벌크시스템(Bulk system)",
      "definition": "사업장에서 사용하거나 취급하는 급성독성물질 및 인화성 가스를 대용량으로 저장·사용하기 위하여 튜브트레일러(Tube trailers), 탱크트레일러(Tank trailers), 저장탱크(Storage tank) 및 여러 개의 실린더를 저장하는 시스템을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-002",
      "term": "튜브트레일러(Tube trailers)",
      "definition": "고압가스를 저장 또는 이송하기 위한 용기의 하나로, 일반적으로 여러 개의 500 L 이상 대용량 수평형 실린더 용기를 차량 등에 적재한 형태를 말하며, 카트리지(Cartridges) 용기라고 불리기도 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-003",
      "term": "실린더(Cylinder)",
      "definition": "일반적으로 0.3 ∼ 0.7 m 정도의 내경을 가진 고압가스용기로, 내용량이 0.5톤 미만의 수직형 용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-004",
      "term": "톤실린더(Ton cylinder)",
      "definition": "내용량이 약 5톤 이상을 저장할 수 있는 고압가스용기로, 수평형과 수직형의 용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-005",
      "term": "실병",
      "definition": "실린더 또는 톤실린더에 고압가스가 충전된 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-006",
      "term": "공병",
      "definition": "실린더 톤실린더에 충전된 고압가스를 소비한 후 비어있는 실린더 또는 톤실린더를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-007",
      "term": "실차",
      "definition": "튜브트레일러 및 탱크 트레일러에 고압가스가 충전된 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-008",
      "term": "공차",
      "definition": "튜브트레일러 및 탱크 트레일러에서 내용물을 사용하고 난 후 비어있는 상태의 튜브트레일러 및 탱크트레일러 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P122-009",
      "term": "로드셀(Load cell)",
      "definition": "실린더 용기의 무게 감지용 저울을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
