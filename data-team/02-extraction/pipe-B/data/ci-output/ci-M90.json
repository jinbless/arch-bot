  "checklistItems": [
    {
      "identifier": "CI-M90-001",
      "text": "로프지름(d)은 d_min와 1.25×d_min의 범위 내 이어야 한다.",
      "guideContext": "크레인 및 권상장치의 와이어로프 선정 (법령 근거 미확인)",
      "additionalDetail": "d_min은 로프 선정계수(C)와 로프 최대장력(S)으로부터 산출된 최소로프지름",
      "workProcessPhase": "사용 로프 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-002",
      "text": "용융금속(Molten metal) 취급시에는 M5보다 낮은 분류그룹은 사용할 수 없다.",
      "guideContext": "위험조건에서의 와이어로프 사용제한 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-003",
      "text": "용융금속 취급시 로프 선정시, Z_P 값은 최대 9.0까지 25 %씩 증가되어야 하고, 혹은 대안으로 다음의 더 높은 분류그룹의 C 값을 채택한다.",
      "guideContext": "위험조건에서의 와이어로프 사용제한 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "로프 선정계수 산출",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-004",
      "text": "와이어로프의 정비는 권상장치와 사용, 환경, 관련된 로프의 유형에 따라 적절하게 수행되어야 한다.",
      "guideContext": "크레인 및 권상장치의 와이어로프 정비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-005",
      "text": "크레인 또는 로프 제조자에 의해 제시된 바가 없으면, 와이어로프는 청결해야 하고, 가능하다면, 도르래 위를 지나 휘어지는 길이 부분에는 그리스(Grease) 혹은 오일 같은 서비스 드레싱으로 발라야 하고, 서비스 드레싱은 와이어로프 제조자에 의해 사용된 원래의 윤활유에 상응하는 것이어야 한다.",
      "guideContext": "크레인 및 권상장치의 와이어로프 정비 (법령 근거 미확인)",
      "additionalDetail": "특히 크레인이 부식이 되는 환경에서 사용시 와이어로프의 정비가 부족하면 로프의 작업수명이 짧게되고, 어떤 경우에는 서비스 드레싱을 사용할 수 없는 곳에서의 운전으로 로프의 수명이 짧게된다.",
      "workProcessPhase": "와이어로프 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-006",
      "text": "가능한 한 로프의 보이는 모든 부분은 일반적인 변형이 탐지되도록 매일 검사되어야 한다.",
      "guideContext": "와이어로프 일일 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-007",
      "text": "정기적 점검의 주기를 결정하기 위하여 다음 사항을 고려하여야 한다. ⓐ 법적인 요건 ⓑ 크레인의 유형과 사용 환경조건 ⓒ 크레인의 등급 ⓓ 이전의 검사 결과 ⓔ 로프 사용기간",
      "guideContext": "와이어로프 정기적 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-008",
      "text": "비록 와이어로프의 전길이를 매일 점검했다 하더라도 다음과 같은 부분은 특별히 점검하여야 한다. ① 이동 및 고정 로프 끝의 연결지점 ② 블록 혹은 도르래를 지나는 로프부분 ③ 보상도르래를 지나는 로프부분 ④ 외부특징에 의해 마모되기 쉬운 로프부분 ⑤ 부식 및 피로에 대한 내부검사 ⑥ 열에 노출된 로프부분",
      "guideContext": "와이어로프 특별 점검 부위 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-M90-009",
      "text": "점검결과는 검사보고서에 기록하여야 한다.",
      "guideContext": "와이어로프 검사 기록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "와이어로프 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M90-001",
      "term": "스트랜드",
      "definition": "복수의 소선 등을 꼼 로프의 구성요소를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M90-002",
      "term": "회전저항로프(Rotation-resistant rope)",
      "definition": "하중 작용시 토크와 회전력을 줄일 수 있도록 설계된 로프를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M90-01",
      "processOrder": 1,
      "processName": "로프 선정계수(C) 산출",
      "safetyMeasures": "로프 구조에 따른 최소 파단하중의 실험계수(K′), 와이어로프의 최소인장강도(R_o), 최소 실질사용계수(Z_p)를 확인하여 C=√(Z_p/(K′·R_0)) 공식으로 산출한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-M90-02",
      "processOrder": 2,
      "processName": "최소로프지름 계산",
      "safetyMeasures": "d_min = C√S 공식으로 최소로프지름을 산출한다. 로프 최대장력(S) 산정 시 정격하중, 도르래 몸체 질량, 도르래 홀의 형상, 로프 도르래의 효율, 드럼축에 대한 로프 기울기(22.5° 초과 시 힘의 증가)를 고려한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-M90-03",
      "processOrder": 3,
      "processName": "사용 로프 결정",
      "safetyMeasures": "로프지름(d)은 d_min와 1.25×d_min의 범위 내에서 선정한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-M90-04",
      "processOrder": 4,
      "processName": "최소파단하중 계산",
      "safetyMeasures": "F_min = S · Z_P 공식으로 최소파단하중을 계산하고, 선정된 로프의 최소파단하중이 이 값 이상인지 확인한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-M90-05",
      "processOrder": 5,
      "processName": "로프드럼 및 도르래 지름 결정",
      "safetyMeasures": "D_1 ≥ h_1 · a · d_min (드럼), D_2 ≥ h_2 · a · d_min (도르래) 공식으로 최소피치원지름을 산출하고, 기계장치 분류에 따른 선정계수(h_1, h_2)와 로프형태계수(a)를 적용한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-M90-06",
      "processOrder": 6,
      "processName": "와이어로프 정비",
      "safetyMeasures": "권상장치 사용 환경 및 로프 유형에 따라 적절한 정비를 수행하고, 도르래 위를 지나는 부분에 그리스 또는 오일 등 서비스 드레싱을 도포한다. 서비스 드레싱은 원래 윤활유에 상응하는 것을 사용한다.",
      "requiredPPE": [],
      "sourceSection": "9",
      "relatedSR": null
    },
    {
      "identifier": "WP-M90-07",
      "processOrder": 7,
      "processName": "와이어로프 검사",
      "safetyMeasures": "일일 점검으로 로프의 보이는 모든 부분의 일반적 변형을 탐지하고, 정기적 점검 시 로프 끝 연결지점, 도르래 통과 부분, 마모 취약 부분, 내부 부식·피로, 열 노출 부분을 특별히 점검한다. 점검결과는 검사보고서에 기록한다.",
      "requiredPPE": [],
      "sourceSection": "9",
      "relatedSR": null
    }
  ],
