      ]
    },
    {
      "identifier": "WP-A25-04",
      "processOrder": 4,
      "processName": "검량선 작성 및 탈착효율 검정",
      "safetyMeasures": "최소한 6개의 표준물질로 검량선을 작성한다. 검량선의 상관계수는 0.99 이상이어야 한다. 탈착효율은 각 시료군 배치당 최소한 한 번씩 행하며, 5개 농도 수준에서 각각 3개씩과 공시료 3개를 준비한다. 탈착효율은 최소 0.75 이상이어야 한다.",
      "requiredPPE": [],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A25-05",
      "processOrder": 5,
      "processName": "GC/FID 기기분석",
      "safetyMeasures": "GC/FID 조건: 주입량 1 μL, 운반가스 N₂ 1 mL/min, 도입부 225℃, 컬럼 35℃(3 min)→8℃/min→190℃, 검출부 250℃. 시료를 정량적으로 정확히 주입한다.",
      "requiredPPE": [],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A25-06",
      "processOrder": 6,
      "processName": "농도 계산 및 결과 판정",
      "safetyMeasures": "농도 계산식 C = ((Wf+Wb-Bf-Bb)/(V×DE))×(24.45/MW)를 적용한다. Wb > Wf/10이면 시료 파과가 일어난 것이므로 해당 자료는 사용할 수 없다. 작업환경 측정 시의 온도와 압력을 실측하여 정상상태(25℃, 1기압)의 농도로 환산하여야 한다.",
      "requiredPPE": [],
      "sourceSection": "IV",
      "relatedSR": null
    }
  ],
