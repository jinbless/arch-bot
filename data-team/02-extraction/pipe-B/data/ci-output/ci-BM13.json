  "checklistItems": [
    {
      "identifier": "CI-BM13-001",
      "text": "벌목하려는 경우에는 미리 대피로 및 대피장소를 정해 둘 것",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제405조제1항제1호",
      "workProcessPhase": "벌목 전 안전확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-002",
      "text": "벌목하려는 나무의 가슴높이지름이 20센티미터 이상인 경우에는 수구(베어지는 쪽의 밑동 부근에 만드는 쐐기 모양의 절단면)의 상면·하면의 각도를 30도 이상으로 하며, 수구 깊이는 뿌리부분 지름의 4분의 1 이상 3분의 1 이하로 만들 것",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제405조제1항제2호",
      "workProcessPhase": "벌목 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-003",
      "text": "벌목작업 중에는 벌목하려는 나무로부터 해당 나무 높이의 2배에 해당하는 직선거리 안에서 다른 작업을 하지 않을 것",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제405조제1항제3호",
      "workProcessPhase": "벌목 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-004",
      "text": "나무가 다른 나무에 걸려있는 경우에는 걸려있는 나무 밑에서 작업을 하지 않을 것",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제405조제1항제4호가목",
      "workProcessPhase": "걸린 나무 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-005",
      "text": "나무가 다른 나무에 걸려있는 경우에는 받치고 있는 나무를 벌목하지 않을 것",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제405조제1항제4호나목",
      "workProcessPhase": "걸린 나무 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-006",
      "text": "사업주는 유입식 벌목기에는 견고한 헤드 가드(head guard)를 부착하여야 한다.",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제405조제2항",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-007",
      "text": "사업주는 벌목작업을 하는 경우에는 일정한 신호방법을 정하여 그 작업에 종사하는 근로자에게 주지시켜야 한다.",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제406조제1항",
      "workProcessPhase": "벌목 전 안전확보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-008",
      "text": "사업주는 벌목작업에 종사하는 근로자가 아닌 사람에게 벌목에 의한 위험이 발생할 우려가 있는 경우에는 벌목작업에 종사하는 근로자에게 미리 제1항의 신호를 하도록 하여 다른 근로자가 대피한 것을 확인한 후에 벌목하도록 하여야 한다.",
      "guideContext": "기계톱을 이용한 벌목작업 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제406조제2항",
      "workProcessPhase": "벌목 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM13-009",
      "text": "재해의 예방 또는 그 정도의 경감을 위하여 기계톱 작업자가 착용하는 보호구로 안전모(낙하·비래방지)를 착용한다.",
      "guideContext": "기계톱을 이용한 벌목작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 보호구 착용",
      "bindingForce": "RECOMMENDED",
