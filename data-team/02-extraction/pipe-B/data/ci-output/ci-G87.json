  "domainTerms": [
    {
      "identifier": "DT-G87-001",
      "term": "고령근로자",
      "definition": "만 55세 이상인 근로자를 말한다. (우리나라 고용촉진법에서는 55세 이상인 자를 고령근로자로 정의하고 있다.)",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-002",
      "term": "신체적 능력",
      "definition": "근력, 근지구력, 심폐지구력, 유연성, 순발력 등이 포함된 종합적인 신체 활동 능력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-003",
      "term": "근력",
      "definition": "근육수축에 의해 생기는 근육의 힘을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-004",
      "term": "근지구력",
      "definition": "작업이나 운동에 의한 근육에의 부하에 대하여 어느 정도 근육이 지속적으로 대응할 수 있는가를 나타내는 능력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-005",
      "term": "심폐지구력",
      "definition": "호흡기관이나 순환계가 오랜 시간 동안 계속되는 운동이나 작업에 건딜 수 있는 능력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-006",
      "term": "유연성",
      "definition": "인체의 하나 또는 복수의 관절과 근육에 관계된 관절을 둘러싼 근육이 최대한 어디 범위까지 관절을 움직일 수 있는가를 나타내는 능력을 말한다. 동작을 원활히 한다든가 부상을 예방 하는 것에 중요한 역할을 하는 능력이라고도 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-007",
      "term": "순발력",
      "definition": "근육 섬유가 순간적인 수축에 의하여 발휘하는 최대 근력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-008",
      "term": "인지",
      "definition": "지각, 문제해결, 기억, 사고(思考), 언어능력, 운동제어 등의 지적인 심적 기능의 총칭을 말한다. 인지에는 주의 집중, 개념 형성, 사고, 판단 등이 포함되며, 지식을 습득 또는 변형시키고, 부호화하고, 저장하는 과정 또는 그 내용을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-009",
      "term": "지각",
      "definition": "인간이 외부세계로부터 정보를 수집하고, 조직화하며, 해석하는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G87-010",
      "term": "기억력",
      "definition": "이전의 인상이나 경험을 의식 속에 간직해 두는 능력을 말한다. 일반적으로 어떤 시점에서의 지각, 체험, 의식내용 등을 보관하고 그것을 저장해 필요에 따라서 회상하는 능력으로 설명한다. 기억력은 장기기억과 단기기억으로 나누어지며 장기기억보다 단기기억이 연령증가에 의한 영향을 크게 받는다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
