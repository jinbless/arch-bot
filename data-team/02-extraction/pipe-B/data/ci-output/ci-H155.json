  "checklistItems": [
    {
      "identifier": "CI-H155-001",
      "text": "방사선 비파괴검사에서 방사선 피폭량을 줄이기 위해서는 작업자는 반드시 보호 휴대 안전장비를 사용하도록 해야 한다.",
      "guideContext": "방사선 비파괴검사 안전보건관리 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-002",
      "text": "방사선 노출을 예방하기 위해서는 검사자와 사업주에게 방사선 안전관리자가 방사선피해에 대한 확실한 이해를 높이고 지도감독 및 예방교육에 심혈을 기울여야 한다.",
      "guideContext": "방사선 비파괴검사 안전보건관리 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-003",
      "text": "방사선 노출 시간을 가능한 짧게 한다. 작업여건상 시간이 걸리는 경우 여러 사람이 교대로 작업하여 개인별 방사선 피폭선량을 관계 법령 규정에 따라 준수하여야 한다.",
      "guideContext": "방사선 안전의 3대 원칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-004",
      "text": "방사선원으로부터 거리는 가능한 멀게 한다. 방사선원으로부터 거리를 가능한 멀리 하여 피폭 방사선량을 감소시킨다. 피폭선량은 거리의 제곱에 반비례하기 때문이다.",
      "guideContext": "방사선 안전의 3대 원칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-005",
      "text": "사업주는 근로자가 방사선 비파괴검사 작업을 할 경우에는 콜리메이터 사용, 차폐벽 및 방호물 설치 등 필요한 조치를 하여야 한다.",
      "guideContext": "방사선 안전의 3대 원칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-006",
      "text": "사업주는 방사선 비파괴검사를 하는 장소에 대해 방사선 관리구역을 설정하고 다음 각 호의 사항을 게시하여야 한다.",
      "guideContext": "방사선 관리구역과 차폐",
      "additionalDetail": "게시사항: 방사선량 측정용구의 착용에 관한 주의사항, 방사선 업무상 주의사항, 방사선 피폭 등 사고 발생 시의 응급조치에 관한 사항, 그 밖에 방사선 건강장해 방지에 필요한 사항",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H155-007",
      "text": "사업주는 방사선 비파괴검사를 하는 근로자가 아닌 사람이 방사선 관리구역에 출입하는 것을 금지하여야 한다.",
      "guideContext": "방사선 관리구역과 차폐 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-008",
      "text": "근로자는 출입이 금지된 장소에 사업주의 허락 없이 출입해서는 아니된다.",
      "guideContext": "방사선 관리구역과 차폐 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-009",
      "text": "사업주는 방사성 동위원소의 종류 및 차폐벽의 재질에 따라 적절한 두께의 차폐벽(납, 철관, 콘크리트 재질) 또는 방호물을 설치하는 등 필요한 조치를 하여야 한다.",
      "guideContext": "방사선 관리구역과 차폐 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-010",
      "text": "방사선원은 반드시 사용시설 또는 방사선관리구역 안에서 사용한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-011",
      "text": "선량한도를 초과하지 않도록 방사선방호 3원칙(시간, 거리, 차폐)을 준수한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-012",
      "text": "사용시설 또는 방사선관리구역의 주변에 방사선구역표지 및 방사선 업무상 주의사항을 부착한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-013",
      "text": "사용시설에는 방사선작업 종사자외의 출입을 제한한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-014",
      "text": "방사선 비파괴검사장치를 사용하는 경우 반드시 콜리메이터를 사용한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-015",
      "text": "방사선조사장치 1대당 작업현장에 적합한 방사선측정기 1대 이상을 휴대한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-016",
      "text": "방사선작업, 작업대기 및 휴식 중에는 항상 감시인을 배치하여 감시한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-017",
      "text": "방사선작업은 반드시 2인 이상을 1조로 편성하여 작업을 수행한다(작업자 중 1인은 반드시 작업조장을 포함할 것).",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-018",
      "text": "현장에서 방사선안전을 책임지는 자는 방사선작업 전에 반드시 작업현장을 확인하고 방사선작업종사자에 대하여 충분한 교육을 실시한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-019",
      "text": "방사선조사장치에 대한 점검 절차서를 정하고 그 절차서에 따라 점검하고 작업을 수행한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-020",
      "text": "야간 방사선작업을 수행하는 경우에는 방사선 관리구역의 경계를 쉽게 식별할 수 있는 기구 및 작업수행에 필요한 조명기구 등을 확보한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-021",
      "text": "방사선작업을 종료하는 경우에는 방사선조사장치의 방사성동위원소 정상상태 확인, 개인피폭선량계 확인, 기타 안전장구 등에 대하여 상태를 점검한다.",
      "guideContext": "이동 사용 시 방사선 안전관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-022",
      "text": "사업주는 근로자가 방사선을 차폐할 수 있는 납안경, 납치마 등을 착용하도록 하여야 한다.",
      "guideContext": "개인용 보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H155-023",
      "text": "사업주는 근로자가 방사성 동위원소를 취급하는 때에는 방사성 물질이 흩날림으로써 근로자의 신체가 오염될 우려가 있으므로 보호복, 보호장갑, 신발덮개, 보호모 등의 보호구를 지급하고 착용하도록 하여야 한다.",
      "guideContext": "개인용 보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H155-024",
      "text": "근로자는 지급된 보호구를 사업주의 지시에 따라 착용하여야 한다.",
      "guideContext": "개인용 보호구 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-025",
      "text": "호흡용 보호구는 한국산업안전보건공단의 안전인증을 받은 것을 사용하여야 한다.",
      "guideContext": "개인용 보호구",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H155-026",
      "text": "전리방사선 노출 근로자에 대하여 배치전 및 주기적 건강진단을 실시하여 관찰하고자 하는 주요 소견은 눈, 피부, 조혈기 장해와 관련된 증상, 징후 및 검사소건이다.",
      "guideContext": "비파괴검사 작업자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-027",
      "text": "건강진단 결과를 관찰하여 연속적으로 혈액학적 이상이 나타나는 경향이 있거나, 참고치를 벗어나는 경우에는 방사선 피폭상황을 재확인하고, 과도한 피폭이 있으면 노출을 줄여야 한다.",
      "guideContext": "비파괴검사 작업자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-028",
      "text": "비파괴검사(X-선) 업무를 1년 이상 종사한 사람 또는 연간 누적선량이 20mSv 이상이었던 사람은 건강관리수첩을 발급받아 특수건강진단을 실시할 수 있도록 한다.",
      "guideContext": "비파괴검사 작업자의 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-029",
      "text": "도급인은 차폐 설비가 되어 있는 전용 방사선 비파괴검사실을 설치한다.",
      "guideContext": "도급인의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-030",
      "text": "이동 불가능한 대형 구조물이나 고소 작업일 경우는 이동 방사선 차폐체를 설치한다. 설치가 곤란한 경우는 방사선량과 1인 작업량을 제한하는 등 피폭 지감화 대책을 강구하여야 한다.",
      "guideContext": "도급인의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-031",
      "text": "도급인은 비파괴검사 사업주와 안전보건에 관한 협의체를 구성하여 운영하여야 한다(월 1회 이상 개최).",
      "guideContext": "도급인의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-032",
      "text": "도급인은 적절한 안전관리가 유지되는지 2일 1회 이상 방사선 작업장을 순회 점검하여야 한다.",
      "guideContext": "도급인의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-033",
      "text": "도급인은 비파괴검사에 대한 안전보건 지도 및 지원을 하여야한다.",
      "guideContext": "도급인의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-034",
      "text": "도급인은 수급자와 합동 안전보건점검을 분기별로 1회 이상 실시하여야 한다.",
      "guideContext": "도급인의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-035",
      "text": "사업주는 근로자가 전리 방사선에 노출되는 것을 가능한 한 최소화하도록 노력하여야 한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-036",
      "text": "사업주는 방사선 비파괴검사 업무를 수행하는 구역을 방사선 관리구역으로 명시해야 한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-037",
      "text": "사업주는 관계자 이외의 자를 관리구역에 출입하게 해서는 안된다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-038",
      "text": "사업주는 관리구역 내의 근로자가 보기 쉬운 장소에, 방사선 측정기 장착에 관한 주의사항, 방사성 동위원소의 취급상 주의사항, 사고가 발생한 경우의 응급조치 등 방사선에 의한 근로자의 건강 장해 방지에 필요한 사항을 게시하여야 한다.",
      "guideContext": "사업주의 역할",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H155-039",
      "text": "사업주는 원자력안전법 시행령 제2조제4호의 선량한도 별표 1(표 1)에 따라 방사선 비파괴검사업무에 종사하는 근로자가 받는 실효 선량이 5년마다 100 mSv를 초과하지 않음과 동시에 1년 당 50 mSv를 초과하지 않도록 해야 한다. 또한, 눈의 수정체에 받는 것에 대해서는 1년 당 150 mSv, 피부에 받는 것에 대해서는 1년 당 500mSv를 각각 초과하지 않도록 해야 한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-040",
      "text": "사업주는 방사선 비파괴 작업자 업무 수행 중에 받는 외부 피폭에 의한 선량 및 내부 피폭에 의한 선량을 측정해야 한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-041",
      "text": "사업주는 측정 또는 계산의 결과에 따라 방사선 비파괴검사 작업자의 선량을 법에서 정하는 방법에 따라 산정 및 기록하고 이를 30년간 보존하여야 한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-042",
      "text": "사업주는 방사선 비파괴검사 작업자에 대하여 방사선 안전관리에 대한 교육을 실시하여야 한다.",
      "guideContext": "사업주의 역할 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-043",
      "text": "방사선조사 후 선원안내튜브와 조사기의 방사선을 측정하여 선원의 위치를 확인한다.",
      "guideContext": "근로자의 역할 - 방사선측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사선 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-044",
      "text": "방사선측정은 작업 전, 후 및 작업 중 수시로 한다.",
      "guideContext": "근로자의 역할 - 방사선측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사선 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-045",
      "text": "제한구역 경계의 방사선량을 측정하여 외부 사람들이 피폭되지 않도록 한다.",
      "guideContext": "근로자의 역할 - 방사선측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사선 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-046",
      "text": "방사선관리구역 표지로 줄 울타리를 설치하여 외부인의 접근을 막는다.",
      "guideContext": "근로자의 역할 - 방사선 위험표지 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사선 위험표지 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-047",
      "text": "방사선작업종사자는 방사선원이 노출되어 있는 구역에 아무도 들어가지 않도록 감시해야 하고 출입을 통제해야 한다.",
      "guideContext": "근로자의 역할 - 방사선 위험표지 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사선 위험표지 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-048",
      "text": "경고등을 가능한 사방에 설치한다(1개인 경우는 선원의 위치에 설치).",
      "guideContext": "근로자의 역할 - 방사선 위험표지 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방사선 위험표지 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-049",
      "text": "개인은 필히 Pocket Dosimeter를 휴대하고 규정에 의한 측정을 실시하여 과피폭을 막는다.",
      "guideContext": "근로자의 역할 - 안전관리장비 휴대 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-050",
      "text": "공용 안전관리 장비인 Surveymeter나 Alarm monitor를 휴대하고 규정에 의한 측정을 실시하여 과피폭을 막는다.",
      "guideContext": "근로자의 역할 - 안전관리장비 휴대 및 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-051",
      "text": "방사선작업종사자는 선원의 도난, 분실 등에 대비해 적절한 조치를 한다.",
      "guideContext": "근로자의 역할 - 선원의 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-052",
      "text": "방사선조사장치는 시건 장치가 되어 있는 저장실에만 보관한다.",
      "guideContext": "근로자의 역할 - 선원의 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-053",
      "text": "방사선조사 후 선원안내튜브와 조사장치를 측정하여 선원의 위치를 확인한다.",
      "guideContext": "근로자의 역할 - 조사장치 점검 및 보존 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-054",
      "text": "원격조작장치의 이상 여부를 사용할 때마다 확인 후 사용한다.",
      "guideContext": "근로자의 역할 - 조사장치 점검 및 보존 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-055",
      "text": "이상이 발견된 장치에 대하여는 방사선 안전관리자에게 보고한다.",
      "guideContext": "근로자의 역할 - 조사장치 점검 및 보존 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H155-056",
      "text": "일반 도로나 주택가에서 방사선작업을 수행함으로 외부 일반인 노출에 주의를 하여야 한다.",
      "guideContext": "지하 배관의 방사선 비파괴검사 (법령 근거 미확인)",
      "additionalDetail": "예: 지역난방 배관, 가스 매설 배관, 송유관",
      "workProcessPhase": "지하 배관 비파괴검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H155-001",
      "term": "방사선 비파괴검사",
      "definition": "방사선을 이용하여 공업제품 내부의 기공이나 균열 등의 결함, 용접부의 내부 결함 등을 제품을 파괴하지 않고 외부에서 검사하는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H155-002",
      "term": "콜리메이터(collimater)",
      "definition": "방사선의 방향과 확산을 한정시키기 위하여 납이나 텅스텐과 같은 방사선을 흡수하는 물질로 만든 기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H155-003",
      "term": "방사선 발생장치",
      "definition": "하전입자를 가속시켜 방사선을 발생시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H155-004",
      "term": "선량한도",
      "definition": "외부에 피폭하는 방사선량과 내부에 피폭하는 방사선량을 합한 피폭방사선량의 상한 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H155-01",
      "processOrder": 1,
      "processName": "방사선 관리구역 설정 및 표지 설치",
      "safetyMeasures": "방사선 관리구역을 설정하고 방사선량 측정용구 착용 주의사항, 방사선 업무상 주의사항, 사고 발생 시 응급조치 사항 등을 게시한다. 줄 울타리를 설치하여 외부인 접근을 차단하고, 경고등을 가능한 사방에 설치한다.",
      "requiredPPE": [
        "개인피폭선량계",
        "Pocket Dosimeter"
      ],
      "sourceSection": "7.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H155-02",
      "processOrder": 2,
      "processName": "방사선 조사장치 설치 및 점검",
      "safetyMeasures": "방사선조사장치에 대한 점검 절차서를 정하고 그 절차서에 따라 점검한다. 휴대용 조사장치, 추진 케이블, 선원 유도관을 장치한 후 검사하려는 물체의 후면에 필름을 놓는다. 콜리메이터를 반드시 사용한다.",
      "requiredPPE": [
        "납안경",
        "납치마",
        "보호복",
        "보호장갑"
      ],
      "sourceSection": "7.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H155-03",
      "processOrder": 3,
      "processName": "방사선 조사 작업 수행",
      "safetyMeasures": "반드시 2인 이상을 1조로 편성하여 작업을 수행한다. 작업자는 보호구를 착용하거나 안전거리 이상 멀리 떨어져서 추진 케이블을 작동하여 조사장치 내의 선원을 선원 유도관 말단까지 이동시켜 일정시간 방사선을 조사한다. 방사선방호 3원칙(시간, 거리, 차폐)을 준수한다.",
      "requiredPPE": [
        "납안경",
        "납치마",
        "보호복",
        "보호장갑",
        "Pocket Dosimeter"
      ],
      "sourceSection": "7.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H155-04",
      "processOrder": 4,
      "processName": "방사선 측정 및 감시",
      "safetyMeasures": "방사선측정은 작업 전, 후 및 작업 중 수시로 한다. 제한구역 경계의 방사선량을 측정하여 외부 사람들이 피폭되지 않도록 한다. 방사선작업, 작업대기 및 휴식 중에는 항상 감시인을 배치하여 감시한다. 방사선조사장치 1대당 방사선측정기 1대 이상을 휴대한다.",
      "requiredPPE": [
        "Pocket Dosimeter",
        "Surveymeter",
        "Alarm monitor"
      ],
      "sourceSection": "8.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H155-05",
      "processOrder": 5,
      "processName": "작업 종료 및 선원 보관",
      "safetyMeasures": "방사선작업을 종료하는 경우에는 방사선조사장치의 방사성동위원소 정상상태 확인, 개인피폭선량계 확인, 기타 안전장구 등에 대하여 상태를 점검한다. 선원을 휴대용 조사장치 내로 이동시키고, 시건 장치가 되어 있는 저장실에만 보관한다.",
      "requiredPPE": [
        "Pocket Dosimeter"
      ],
      "sourceSection": "7.4",
      "relatedSR": null
    }
  ],
  "equipmentSpecs": [
