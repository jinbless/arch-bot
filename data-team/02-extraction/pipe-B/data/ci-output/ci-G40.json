  "checklistItems": [
    {
      "identifier": "CI-G40-001",
      "text": "포장에 대한 관리부서는 다음과 같은 내용을 훈련하고 감독을 시행하여야 한다.",
      "guideContext": "해상운송 포장관계자 교육 (법령 근거 미확인)",
      "additionalDetail": "훈련 내용: 포장화물의 동시 적재, 양립성이 낮은 물품의 분리, 포장화물의 하중 분산방법, 화물의 적재 시 고정방법에 관한 사항",
      "workProcessPhase": "화물 포장 및 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-002",
      "text": "모든 포장방법은 적절하여야 하며, 적절한 위험 표식이 있어야 하고, 양호한 포장상태를 유지하여야 한다.",
      "guideContext": "해상운송 포장회사 책무",
      "additionalDetail": null,
      "workProcessPhase": "화물 포장 및 표식",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G40-003",
      "text": "화물운송체는 양호한 상태를 유지해야 한다.",
      "guideContext": "해상운송 포장회사 책무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화물 운송 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-004",
      "text": "포장관계자가 포장한 상품이 화물운송체에서 안전하게 적재되도록 해야 한다.",
      "guideContext": "해상운송 포장회사 책무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화물 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-005",
      "text": "화물운송체와 그 내용물은 해상운송 전에 모든 관련 요구사항을 충족해야 한다.",
      "guideContext": "해상운송 선적관계자 책무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "선적 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-006",
      "text": "항구까지 화물운송체를 운송하는 운송관계자는 관련 서류를 소지하여야 하고, 안전한 운송을 위한 정보들을 숙지하여야 한다.",
      "guideContext": "해상운송 선적관계자 책무 (법령 근거 미확인)",
      "additionalDetail": "선적관계자가 그 소유자이거나 컨테이너 임차인일 때도 마찬가지이다.",
      "workProcessPhase": "육상 운송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-007",
      "text": "화물운송체 운송관계자는 화물의 위험요소에 관한 정보는 물론 도로 및 철도운송을 위한 적절한 규정도 숙지하여야 한다.",
      "guideContext": "해상운송 선적관계자 책무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "육상 운송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-008",
      "text": "선적관계자 혹은 적송인은 선박소유자에게 컨테이너 봉인증명서, 운송신고서, 서명된 위험물품 신고서 및 해양오염 신고서 등을 제공하여야 한다.",
      "guideContext": "해상운송 선적관계자 책무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "선적",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-009",
      "text": "선적관계자는 화물운송체가 적절히 표식되도록 하여야 한다.",
      "guideContext": "해상운송 선적관계자 책무",
      "additionalDetail": null,
      "workProcessPhase": "선적 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G40-010",
      "text": "운송관계자는 화물운송의 목적지 또는 운송지 명칭, 화물 번호, 화물의 양과 무게, 화물의 분류사항 및 기타 항만관계자가 요구하는 정보를 숙지하여야 한다.",
      "guideContext": "해상운송 운송관계자 책무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "육상 운송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-011",
      "text": "화물 컨테이너는 정보 표시를 위해 안내 표식을 부착하여야 한다.",
      "guideContext": "해상운송 운송관계자 책무 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화물 포장 및 표식",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-G40-012",
      "text": "차량 운전자는 차량 운송에 관한 관련 규정을 지키도록 하여야 하고, 운전자는 정보 숙지와 더불어 적합한 훈련을 받아야 한다. 또한 운전자는 화재·폭발 등의 사고에 대비한 예방조치를 취해야 한다.",
      "guideContext": "해상운송 운송관계자 책무",
      "additionalDetail": null,
      "workProcessPhase": "육상 운송",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    }
  ],
