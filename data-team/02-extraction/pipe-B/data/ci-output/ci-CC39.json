  "checklistItems": [
    {
      "identifier": "CI-CC39-001",
      "text": "다음은 산업안전보건법령에 관한 사항으로써 반드시 준수하여야 한다.",
      "guideContext": "결함수 분석 기법에 관한 기술지원규정 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건법 시행규칙 제50조에 따라 공정안전보고서에 공정위험성평가서를 포함해야 하며, 결함수 분석(FTA)은 위험성평가 기법 중 하나로 규정됨",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-002",
      "text": "결함수 분석에 사용되는 기본 사상의 고장률, 이용불능도 등의 신뢰도 자료는 다음의 이용가능한 자료중에서 신뢰성이 높은 것을 선택하여 사용한다.",
      "guideContext": "결함수 분석 정량화 시 신뢰도 자료 선택",
      "additionalDetail": "해당공정의 운전·정비 자료, 화학설비 신뢰도 자료, 국내·외 신뢰도 자료, 설비 제작자 제공 자료, 기타 객관적으로 증명 가능한 자료 중 선택",
      "workProcessPhase": "정량화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-003",
      "text": "각각의 조치권고사항은 신중히 고려되어야 하고 만약 시행하도록 받아들여진다면 실제로 조치가 될 수 있도록 최종 보고서에 포함하여 보고한다.",
      "guideContext": "결함수 분석 기록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-004",
      "text": "조치를 해야할 결과들의 위험정도와 결함수분석 결과로 산출된 이들이 발생 가능한 빈도를 조합하여 특정한 권고사항을 작성한다.",
      "guideContext": "결함수 분석 기록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-005",
      "text": "후속조치를 담당하는 다른팀이 이해할 수 있도록 다음과 같은 자료들을 권고사항에 포함시켜 전달한다.",
      "guideContext": "결함수 분석 기록 (법령 근거 미확인)",
      "additionalDetail": "팀이 검토하였던 정상 사상의 선정 과정, 팀에 의해 파악된 결과, 팀이 제안한 변경의 요지, 변경대상 또는 권고되는 검토사항을 포함",
      "workProcessPhase": "기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-006",
      "text": "결함수 분석시 사용하였던 기술자료의 사본과 팀 리더가 사용했던 주요기기가 표시된 공정배관계장도를 위험성평가 서류에 함께 첨부하고, 검토보고서의 후속조치, 재설계 서류, 부기적인 권고사항 등 권고사항을 제시하기 위해 작성된 모든 작업서류도 모아 함께 첨부한다.",
      "guideContext": "결함수 분석 참고자료 첨부 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보고서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-007",
      "text": "결함수 분석결과 최소 킷세트가 하나의 기본 사상으로 구성되어 있는 경우에는 반드시 개선권고사항에 대한 후속조치를 취해야 하며 나머지 개선권고사항에 대한 내용은 다음의 우선순위에 따라 적절한 조치를 강구하도록 한다.",
      "guideContext": "결함수 분석 후속조치 우선순위 (법령 근거 미확인)",
      "additionalDetail": "우선순위: (1) 발생확률, (2) 최소 킷세트에 포함되는 기본 사상의 빈도",
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-008",
      "text": "경영자는 공정안전관리 담당부서에게 평가결과 보고서의 내용들이 적절하게 추진되고 있는지를 감사하도록 한다.",
      "guideContext": "결함수 분석 후속조치 감사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-009",
      "text": "후속조치의 책임부서는 회사의 특성에 따라 정비부, 기술부, 사업부 등에서 각각 시행할 수 있도록 책임부서를 지정하여야 한다.",
      "guideContext": "결함수 분석 후속조치 책임부서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후속조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC39-010",
      "text": "기록은 한글과 영문을 혼용할 수 있다.",
      "guideContext": "결함수 분석 기록 작성",
      "additionalDetail": null,
      "workProcessPhase": "기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC39-001",
      "term": "정상 사상",
      "definition": "재해의 위험도를 고려하여 결함수 분석을 하기로 결정한 사고나 결과를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-002",
      "term": "기본 사상",
      "definition": "더 이상 원인을 독립적으로 전개할 수 없는 기본적인 사고의 원인으로서 기기의 기계적 고장, 보수와 시험 이용불능 및 작업자 실수사상 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-003",
      "term": "중간 사상",
      "definition": "정상 사상과 기본 사상 중간에 전개되는 사상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-004",
      "term": "결함수 기호",
      "definition": "결함에 대한 각각의 원인을 기호로서 연결하는 표현수단을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-005",
      "term": "킷세트",
      "definition": "정상 사상을 발생시키는 기본 사상의 집합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-006",
      "term": "최소 킷세트",
      "definition": "정상 사상을 발생시키는 기본 사상의 최소집합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-007",
      "term": "계통 분석",
      "definition": "계통의 기능상실을 초래하는 모든 사상 조합을 체계적으로 분석하고 그 발생가능성을 평가하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-008",
      "term": "고장률",
      "definition": "설비가 시간당 또는 작동 횟수 당 고장이 발생하는 확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC39-009",
      "term": "이용불능도",
      "definition": "주어진 시간에 설비가 보수 등의 이유로 인하여 이용할 수 없는 가능성을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
