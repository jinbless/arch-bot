  "domainTerms": [
    {
      "identifier": "DT-BE19-001",
      "term": "보호범위",
      "definition": "낙뢰의 영향으로부터 보호가 필요한 건축물의 일부 또는 그 지역을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-002",
      "term": "피뢰설비",
      "definition": "낙뢰의 영향으로부터 특정 공간을 보호하기 위한 설비로서 외부 및 내부 피뢰설비로 구분된다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "DT-BE19-003",
      "term": "외부 피뢰설비",
      "definition": "직격뢰를 받는 수뢰부, 뇌격전류를 접지전극으로 흐르게 하는 인하도선, 뇌격전류를 대지로 방류하는 접지시스템 등의 3요소로 구성된 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-004",
      "term": "내부 피뢰설비",
      "definition": "보호범위 내에서 뇌격전류에 의한 전자적 영향을 감소시키기 위하여 설치되는 본딩도체, 서지억제기 등 외부 피뢰설비 이외에 설치된 모든 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-005",
      "term": "등전위본딩",
      "definition": "내부 피뢰설비 중 뇌격전류에 의해 발생하는 전위치를 감소시키기 위하여 도전체 상호간을 전기적으로 연결하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-006",
      "term": "수뢰부",
      "definition": "뇌격전류를 받아들이기 위한 외부 피뢰설비의 일부분을 말하며, 돌침, 수평도체, 메시도체 등이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-007",
      "term": "인하도선",
      "definition": "수뢰부로부터 접지부로 뇌격전류를 흘리기 위한 외부 피뢰설비의 일부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-008",
      "term": "접지시스템",
      "definition": "뇌격전류를 대지로 흘려 분산시키기 위한 외부 피뢰설비의 일부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-009",
      "term": "접지전극",
      "definition": "뇌격전류를 대지로 분산시키기 위하여 지중에 매설한 도체 또는 도체군을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-010",
      "term": "환상 접지전극",
      "definition": "구조물의 지표면 또는 지중에서 폐루프를 형성하는 접지전극을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-011",
      "term": "기초 접지전극",
      "definition": "구조물의 콘크리트 기초에 매설된 접지전극을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-012",
      "term": "피뢰시스템의 자연적 구성부재",
      "definition": "외부 피뢰설비를 별도로 설치하지 않고, 구조물의 도전성 구성부재를 이용하여 낙뢰보호 기능을 갖도록 한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-013",
      "term": "금속설비",
      "definition": "배관, 계단실, 엘리베이터 가이드 레일, 환기·가열·공조 덕트, 상호 연결된 보강용 강재와 같이 뇌격전류 경로를 형성할 수 있는 보호대상 구조물 내의 금속제 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-014",
      "term": "본딩도체",
      "definition": "금속제 설비, 외부의 도체부분, 전력선 및 통신선 등 분리된 도전성 부분을 피뢰설비에 접속하는 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-015",
      "term": "보호등급",
      "definition": "피뢰설비가 낙뢰로부터 구조물을 보호할 수 있는 확률과 관련된 피뢰설비의 등급을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-016",
      "term": "보호대상 구조물과 분리된 외부 피뢰설비",
      "definition": "뇌격전류의 통전경로와 보호대상 구조물이 서로 접촉되지 않도록 수뢰부와 인하도선을 설치한 피뢰설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE19-017",
      "term": "보호대상 구조물과 접속된 외부 피뢰설비",
      "definition": "뇌격전류의 통전경로가 보호대상 구조물과 접속되도록 수뢰부와 인하도선을 설치한 피뢰설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BE19-15",
      "processOrder": 1,
      "processName": "수뢰부 배치 및 설치",
      "safetyMeasures": "보호등급에 따라 보호각법, 회전구체법, 메시도체법을 조합하여 수뢰부를 배치한다. 높이 60m 초과 구조물은 측면 낙뢰 보호 수뢰부를 구성하고, 120m 초과 부분은 전면 보호한다. 가연성 재료 지붕과 수뢰부 사이 거리 0.10m 이상 유지하고, 가연성이 높은 부분은 피뢰설비 구성요소와 접촉되지 않도록 한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "WP-BE19-16",
      "processOrder": 2,
      "processName": "자연적 구성부재의 수뢰부 적용 검토",
      "safetyMeasures": "금속관을 수뢰부로 사용할 경우 전기적 연속성을 확인하고, 금속관 두께가 <표 2> 기준 이상인지 확인한다. 절연물로 피복되어 있지 않아야 하며, 가연성 가스 또는 인화성 액체가 흐르는 배관의 비금속제 접속부는 수뢰부로 사용할 수 없다.",
      "requiredPPE": [],
      "sourceSection": "5.1.4",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "WP-BE19-17",
      "processOrder": 3,
      "processName": "인하도선 배치 및 설치",
      "safetyMeasures": "다수의 통전경로가 병렬로 구성되도록 하고 통전경로 길이를 최소로 유지한다. 보호대상 구조물과 분리된 피뢰설비는 각 지지대마다 1조 이상, 분리되지 않은 경우 <표 3>에 따른 간격으로 2조 이상 배치한다. 인하도선은 직선으로 설치하고 루프가 형성되지 않도록 하며, 가연성 벽과 0.1m 이상 이격한다. 홈통/낙수관 내 설치를 금지한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "WP-BE19-18",
      "processOrder": 4,
      "processName": "시험접속부 설치",
      "safetyMeasures": "자연적 구성부재 인하도선을 제외하고 각 인하도선과 접지설비 접속점에 시험용 접속부를 설치한다. 시험단자는 공구를 사용하여 열 수 있어야 하고, 평상시는 닫혀 있어야 한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.6",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "WP-BE19-19",
      "processOrder": 5,
      "processName": "접지시스템 구성 및 시공",
      "safetyMeasures": "A형(방사상·관상·수직 접지전극) 또는 B형(환상·메시·기초 접지전극) 중 적합한 형태를 선택한다. A형은 최소 2조 이상, B형은 평균반경 조건을 충족한다. 접지전극은 최소 0.5m 깊이에 매설하고, 환상접지전극은 벽과 1m 이상 이격한다. 재질이 다른 접지설비 상호 접속 시 부식문제를 검토한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "WP-BE19-20",
      "processOrder": 6,
      "processName": "조임부 설치 및 접속",
      "safetyMeasures": "수뢰부와 인하도선은 전자력·진동·빙설로 인한 균열로 도체가 절단되거나 늘어지지 않도록 견고하게 고정한다. 도체간 접속개소는 최소로 하고, 슬리브·용접·나사 조임·볼트 조임 등으로 전기적 연속성을 유지한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
    {
      "identifier": "WP-BE19-21",
      "processOrder": 7,
      "processName": "재료 및 굵기 선정",
      "safetyMeasures": "사용재료는 뇌격전류에 의한 전기·전자적 영향에 견디고, 부식 가능성을 고려하여 <표 4>의 재료 중 선정한다. 도체 최소 굵기는 <표 5>에 따르며, 부식위험 장소에서는 <표 4>와 5.5.2항에 따라 결정한다.",
      "requiredPPE": [],
      "sourceSection": "5.5",
      "relatedSR": [
        "SR-ELECTRIC-025"
      ]
    },
