  "domainTerms": [
    {
      "identifier": "DT-CC46-001",
      "term": "비상대응계획수립지침(ERPG)",
      "definition": "관심의 우선순위, 취급·저장평가, 누출시 확산지역의 파악 및 지역사회의 비상대응계획을 수립하는데 사용되는 지침을 말하며 이 지침에서 사용되는 농도는 공기중의 농도에 따라 ERPG-1, ERPG-2 및 ERPG-3 등으로 구분한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC46-002",
      "term": "ERPG-1",
      "definition": "거의 모든 사람이 한시간 동안 노출되어도 오염물질의 냄새를 인지하지 못하거나 건강상 영향이 나타나지 않는 공기중 최대 농도",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC46-003",
      "term": "ERPG-2",
      "definition": "거의 모든 사람이 한시간까지 노출되어도 보호조치 불능의 증상을 유발하거나 회복불가능 또는 심각한 건강상 영향이 나타나지 않는 공기중 최대 농도",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC46-004",
      "term": "ERPG-3",
      "definition": "거의 모든 사람이 한시간까지 노출되어도 생명의 위험을 느끼지 않는 공기중 최대 농도",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
