  "domainTerms": [
    {
      "identifier": "DT-X9-001",
      "term": "온열 작업 환경",
      "definition": "고열, 한랭, 다습 등 외부 조건과 작업복, 작업 부하 등의 작업 조건에 의해 결정되는 기후 관련 작업 환경을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "DT-X9-002",
      "term": "대기 온도",
      "definition": "작업장의 공기의 온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-003",
      "term": "상대 습도",
      "definition": "현재 공기가 포함하고 있는 수증기량과 그 온도에서 공기가 최대로 포함할 수 있는 수증기량(포화수증기량)의 비를 백분율로 나타낸 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-004",
      "term": "흑구 온도",
      "definition": "복사열이 체감에 미치는 영향을 평가하기 위해 흑구 온도계를 사용하여 측정한 온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-005",
      "term": "공기 속도",
      "definition": "작업장의 공기가 흐르는 속도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-006",
      "term": "대사율",
      "definition": "근육 부하의 에너지 소비를 측정하는 지수로 화학 에너지가 역학 열에너지로 변화하는 대사 작용의 지수를 말한다. 기타 구체적인 내용은 KS A ISO 8996:2005를 참조한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-007",
      "term": "기초 피복 단열",
      "definition": "정적이고, 바람이 없는 표준화된 조건 하에서의 피부로부터 피복 표면까지의 단열을 의미하며, 단위는 m²°C/W 이다. 기타 구체적인 내용은 KS A 5556:2006을 참조한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-008",
      "term": "합성 피복 단열",
      "definition": "주어진 조건 하에서 의복에 의해 제공되는 실제 단열을 의미하며, 단위는 m²°C/W 이다. 기타 구체적인 내용은 KS A 5557:2006을 참조한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-009",
      "term": "필요 피복 단열",
      "definition": "허용될 만한 신체 및 피부 온도에서 열평형 상태로 신체를 유지하기 위하여 요구되는 합성 피복 단열을 말한다. 기타 구체적인 내용은 KS A 5557:2006을 참조한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-004"
      ]
    },
    {
      "identifier": "DT-X9-010",
      "term": "예상 평균 온열감",
      "definition": "어떤 대규모 집단의 사람들이 다음의 7점 척도를 사용해 열 감각을 평가한 수치의 평균에 대한 예상 지수이다. 기타 구체적인 내용은 KS A ISO 7730:2005를 참조한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-011",
      "term": "예상 불만족율",
      "definition": "전체 응답자 중 7점 척도에서 +2 이상이나 -2 이하의 응답을 하는, 너무 덥거나 춥다고 느끼는 사람들의 백분율에 대한 예상치를 말한다. 7점 척도 등 기타 구체적인 내용은 KS A ISO 7730:2005를 참조한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X9-012",
      "term": "습구 흑구 온도",
      "definition": "통상의 습구 온도(Tnw)와 흑구 온도(Tg), 그리고 상황에 따라서는 대기 온도(건구 온도, Ta)를 결합한 온도로서 다음과 같이 계산된다. 기타 구체적인 내용은 KS A ISO 7243:2005를 참조한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "DT-X9-013",
      "term": "예상 열긴장",
      "definition": "스트레스 기준과 신체적 긴장 기준을 이용한 열에 대한 신체의 긴장의 예상 지수를 말한다. 기타 구체적인 내용은 KS A ISO 7933을 참조한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-003"
      ]
    },
    {
      "identifier": "DT-X9-014",
      "term": "허용 노출 시간",
      "definition": "특정한 고온 또는 저온 환경에서 노출이 허용되는 최대의 시간을 말한다. 기타 구체적인 내용은 KS A ISO 7933:2005, KS A 5557:2006을 참조한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-001"
      ]
    }
  ],
