  "checklistItems": [
    {
      "identifier": "CI-CC55-001",
      "text": "사업장의 안전보건총괄책임자는 보유설비와 취급하고 있는 위험물질에 의한 발생 가능한 비상사태를 체계적으로 검토한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 파악 및 분석",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-CC55-002",
      "text": "위험성 파악과 비상조치계획의 수립에 있어서는 발생 가능성이 큰 비상사태를 기준으로 하되 발생가능성은 적으나 심각한 결과를 초래할 수 있는 비상사태도 포함시킨다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 파악 및 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-003",
      "text": "발생 가능한 비상사태의 분석에는 공정별로 예상되는 비상사태, 비상사태 전개과정, 최대피해 규모, 피해 최소화대책, 과거 유사한 중대사고의 기록, 비상사태의 결과예측을 포함시킨다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 파악 및 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-004",
      "text": "각 공정별로 사용하는 원부재료와 중간제품 및 완제품에 대한 가연성, 유해성 등의 성상을 조사하고 그 물질의 저장, 취급 및 폐기에 관한 안전지침을 작성한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "유해·위험물질 성상조사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-CC55-005",
      "text": "근로자의 인명보호에 최우선 목표를 둔다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "비상조치계획 수립 원칙",
      "workProcessPhase": "비상조치계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-006",
      "text": "비상통제 조직의 업무분장과 임무를 분명하게 한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "비상조치계획 수립 원칙",
      "workProcessPhase": "비상조치계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-007",
      "text": "주요 위험설비에 대하여는 내부 비상조치계획 뿐만 아니라 외부 비상조치 계획도 포함시킨다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": "비상조치계획 수립 원칙",
      "workProcessPhase": "비상조치계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-CC55-008",
      "text": "비상조치계획은 문서로 작성하여 모든 근로자가 쉽게 활용할 수 있는 장소에 비치한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "비상조치계획 수립 원칙",
      "workProcessPhase": "비상조치계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-009",
      "text": "비상조치계획에는 근로자의 사전 교육, 비상시 대피절차와 비상대피로의 지정, 대피 전 안전조치를 취해야 할 주요 공정설비 및 절차, 비상대피 후 직원이 취해야 할 임무와 절차, 피해자에 대한 구조·응급조치 절차, 내·외부와의 연락 및 통신체계, 비상사태 발생시 통제조직 및 업무분장, 사고 발생시와 비상대피시의 보호구 착용 지침, 비상사태 종료 후 오염물질 제거 등 수습 절차, 주민 홍보 계획, 외부기관과의 협력체제를 포함한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "비상조치계획 최소 포함 사항",
      "workProcessPhase": "비상조치계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-010",
      "text": "비상조치계획 수립시에 부서별 비상대응체계를 작성 비치한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-011",
      "text": "비상조치계획의 수립과 검토시에는 근로자 및 근로자 대표의 의견을 청취하여 자발적인 참여가 이루어지도록 한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치계획 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-012",
      "text": "비상사태의 종류 및 비상사태의 전개에 따라 신속한 결정과 조치가 가능한지를 검토한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상조치계획 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-013",
      "text": "경보 발령절차, 비상통로 및 비상구의 명확한 표시, 근로자 등의 대피절차 및 대피장소의 결정, 대피장소별 담당자의 지정 및 그들의 임무와 책임사항, 비상통제센타의 위치 및 보고체계 확립, 임직원 명부 및 하도급업체 방문자 명단의 확보와 대피자의 확인체계 확립, 대피장소에서 근로자 및 일반대중의 행동요령, 임직원 비상연락망의 확보, 외부비상조치기관과의 연락수단 및 통신망 확보를 준비한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "비상대피 계획 준비 사항",
      "workProcessPhase": "비상대피 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-014",
      "text": "조업중 비상사태 발생을 확인한 임직원은 즉시 비상경보 발신기의 작동이나 통신망 등을 이용하여 비상사태 발생지역, 비상사태의 내용, 신고자의 소속과 성명을 조정실 또는 방재센터(당직실)로 신고해야 한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 발생 신고",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.1",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-CC55-015",
      "text": "비상사태 발생 신고를 접수한 조정실(방재센터)은 비상방송 및 경보를 취명해야 하며 해당 비상통제자는 비상 방송을 통해 비상사태 발생 상황을 방송하고 비상통제 조직에 의한 필요한 조치를 지시해야 한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 발신",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-CC55-016",
      "text": "설비의 규모에 따라 적절한 수의 경보시설을 확보한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상경보체계 구축",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.1",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-CC55-017",
      "text": "소음수준이 높은 곳에서는 시각적 경보시설을 고려한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상경보체계 구축",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.1",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-CC55-018",
      "text": "각종 비상경보는 주 1회 작동 테스트를 한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상경보체계 구축",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-019",
      "text": "경계경보 발령 시 모든 안전작업허가서는 효력을 상실하며 허가서는 발급자에게 반납한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상경보 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-020",
      "text": "경계경보 발령 시 흡연과 가열기구는 사용이 금지된다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상경보 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-CC55-021",
      "text": "독성가스 누출시는 비상방송의 안내에 따라 호흡보호 장비를 휴대하고 비상 지휘자의 지시에 따른다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": "가스누출 경보 발령 시 조치사항",
      "workProcessPhase": "비상경보 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "10.4",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-CC55-022",
      "text": "대피경보 발령 시 모든 작업을 중지한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": "폭발 또는 독성물질의 다량 누출 등 급박한 위험상황",
      "workProcessPhase": "비상대피",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.5",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-CC55-023",
      "text": "대피경보 발령 시 비상지휘자가 지명한 요원(비상운전반 등)을 제외한 모든 사람들은 지시에 따라 대피한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상대피",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.5",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-CC55-024",
      "text": "풍향을 고려하여 대피지역을 지정한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "대피경보 발령 시 조치사항",
      "workProcessPhase": "비상대피",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-025",
      "text": "필요한 경우 비상사태 발생지역의 진입을 통제하고 인근공장 및 주민의 대피를 지시한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "대피경보 발령 시 조치사항",
      "workProcessPhase": "비상대피",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-026",
      "text": "화재경보 발령 시 비상통제 조직의 구성원 외에는 비상발생 장소에 접근하거나, 진화작업에 지장을 주어서는 안된다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "화재 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "10.6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-CC55-027",
      "text": "비상사태의 종결은 비상지휘자의 결정에 의한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 종결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-028",
      "text": "각부서의 부서장은 각부서별로 정상체제에서 인원과 장비를 파악하고 인원을 비상통제단에 보고한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "비상사태 종결 시 조치사항",
      "workProcessPhase": "비상사태 종결",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "11",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-029",
      "text": "비상사태발생 부서장은 관계 부서와의 협의를 거쳐 사고발생 요약 보고서를 안전보건책임자(공장장)에게 제출한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "12",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-030",
      "text": "비상사태시 효과적으로 지휘 및 통제 할 수 있는 비상통제소를 위험이 적은 장소에 설치해야 한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상통제소 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-031",
      "text": "비상통제소에는 비상통제 일지를 비롯하여 적절한 수의 통화설비, 라디오 및 기타 통신장비, 개인보호구 및 기타 구조장비, 풍속 및 풍향계, 근로자·도급자 및 방문자의 명단, 비상조치 기관의 명부, 시설물 관련 도면 및 자료를 갖추어야 한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상통제소 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-032",
      "text": "비상통제소는 주 비상통제소가 기능을 상실 할 경우를 대비하여 제2의 비상 통제소를 마련한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상통제소 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "15",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-033",
      "text": "각 공정별로 비상사태시의 정지순서 등을 포함한 비상운전정지 절차를 작성하여 각 생산공정단위로 비치한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "운전정지 절차 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "16.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-CC55-034",
      "text": "작성된 비상운전계획을 작업자에게 배부하고, 비상운전 절차에 대한 연습을 월 1회 이상 시행한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운전정지 절차 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "16.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-035",
      "text": "새로운 원료의 도입이나 장치 및 설비의 변경, 공정의 변경 또는 운전절차의 변경시에는 반드시 작업자들에게 숙지시키고 비상운전정지 등 적절한 훈련을 실시한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "운전정지 절차 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "16.3",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-CC55-036",
      "text": "비상운전 절차에서부터 피난, 소방계획에 이르기 까지 전반적인 비상훈련을 월 1회 이상 각급 교대조 및 생산공정 단위로 실시하여 근로자들이 비상사태시 행동요령을 숙지토록 한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "17.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-037",
      "text": "비상훈련시에는 평가회를 실시하고 그 결과를 기록으로 비치해야 한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "평가기록에 따라 문제점을 보완하고 계획을 수정하여 현실적으로 적합한 계획을 수립 실행한다",
      "workProcessPhase": "비상훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "17.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-038",
      "text": "정부관계자의 참관에 의한 감사 훈련 및 소방지원단 합동훈련을 분기별 1회 실시하고 그 기록을 유지 보관한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "17.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-039",
      "text": "사업장은 비상사태 발생에 대비하여 인근 거주 주민에게 유해·위험설비에 관한 정보를 제공한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "주민홍보",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "18",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-CC55-040",
      "text": "비상사태가 발생했을 경우 주요위험시설 인근지역에 거주하는 주민 또는 작업자들에게 가능한 신속하게 중대사고 발생을 알리는 등 정보를 제공한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": "비상사태 중의 홍보",
      "workProcessPhase": "주민홍보",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "18",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-CC55-041",
      "text": "운전조치반은 비상지휘자의 지시를 받아 재난공정과 관련된 비상정지 조치 및 비상발전기, 소방펌프의 가동 등 필요 조치를 취하도록 한다.",
      "guideContext": "비상조치계획 수립",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "14.8",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-CC55-042",
      "text": "상해자 발생시 신속하게 인명 구조하여 응급처치 후 병원으로 후송 조치한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "인명구조 및 의료반 임무",
      "workProcessPhase": "비상사태 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "14.5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-043",
      "text": "화재 발생시에는 관할지역의 소방관서, 고용노동부, 한국산업안전보건공단 등에 지원 요청한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": "비상통제단 직무",
      "workProcessPhase": "비상사태 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "14.9",
      "basedOn": null
    },
    {
      "identifier": "CI-CC55-044",
      "text": "중대사고 이후 사고조사 결과 및 주민과 환경에 미칠 장·단기적 영향을 주민들에게 홍보한다.",
      "guideContext": "비상조치계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주민홍보",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "18",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC55-001",
      "term": "조업상의 비상사태",
      "definition": "중대한 화재사고가 발생한 경우, 중대한 폭발사고가 발생한 경우, 독성화학물질의 누출사고 또는 환경오염 사고가 발생한 경우, 인근지역의 비상사태 영향이 사업장으로 파급될 우려가 있는 경우를 말한다.",
      "sourceSection": "2",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "DT-CC55-002",
      "term": "자연재해",
      "definition": "태풍, 폭우 및 지진 등 천재지변이 발생한 경우를 말한다.",
      "sourceSection": "2",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC55-003",
      "term": "경계경보",
      "definition": "비상사이렌으로 3분간 장음으로 취명하며, 공정상의 이상 또는 독성물질의 누출위험이 없을 때까지 취명하는 경보이다.",
      "sourceSection": "10.3",
      "relatedSR": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "DT-CC55-004",
      "term": "가스누출경보",
      "definition": "고·저음의 파상음을 연속적으로 취명하며, 가스가 누출되는 동안 계속 취명하는 경보이다.",
      "sourceSection": "10.4",
      "relatedSR": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "DT-CC55-005",
      "term": "대피경보",
      "definition": "단음으로 연속 취명되며 비상사태 종료시까지 계속 취명되는 경보로, 폭발 또는 독성물질의 다량 누출 등 급박한 위험상황 일때에 취명한다.",
      "sourceSection": "10.5",
      "relatedSR": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "DT-CC55-006",
      "term": "화재경보",
      "definition": "5초 간격 중단음으로 계속 취명하며, 화재로 인한 비상사태에 발신되는 경보이다.",
      "sourceSection": "10.6",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "DT-CC55-007",
      "term": "해제경보",
      "definition": "1분간 장음으로 취명하며 비상방송을 통해 상황의 종료와 조치 사항에 대하여 안내하는 경보이다.",
      "sourceSection": "10.7",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-CC55-01",
      "processOrder": 1,
      "processName": "비상사태 파악 및 위험성 분석",
      "safetyMeasures": "보유설비와 취급 위험물질에 의한 발생 가능한 비상사태를 체계적으로 검토하고, 공정별 예상 비상사태, 전개과정, 최대피해 규모, 피해 최소화대책, 과거 중대사고 기록, 결과예측을 분석에 포함시킨다.",
      "requiredPPE": [],
      "sourceSection": "3",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "WP-CC55-02",
      "processOrder": 2,
      "processName": "유해·위험물질 성상조사",
      "safetyMeasures": "각 공정별로 사용하는 원부재료와 중간제품 및 완제품에 대한 가연성, 유해성 등의 성상을 조사하고 저장, 취급 및 폐기에 관한 안전지침을 작성한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "WP-CC55-03",
      "processOrder": 3,
      "processName": "비상조치계획 수립 및 검토",
      "safetyMeasures": "근로자 인명보호 최우선, 가능한 비상사태 모두 포함, 통제조직 업무분장 명확화, 내·외부 비상조치계획 포함, 문서 작성 후 비치. 근로자 및 대표의 의견을 청취하여 자발적 참여 유도.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC55-04",
      "processOrder": 4,
      "processName": "비상사태 발생 신고 및 경보 발령",
      "safetyMeasures": "비상사태 확인 즉시 비상경보 발신기 작동 또는 통신망을 이용하여 조정실/방재센터로 신고. 조정실은 비상방송 및 경보를 취명하고 비상통제 조직에 필요한 조치를 지시한다.",
      "requiredPPE": [],
      "sourceSection": "9",
      "relatedSR": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "WP-CC55-05",
      "processOrder": 5,
      "processName": "비상대피 실시",
      "safetyMeasures": "풍향을 고려하여 대피지역 지정, 비상지휘자 지명 요원 외 전원 대피, 비상사태 발생지역 진입 통제, 인근공장 및 주민 대피 지시. 독성가스 누출 시 호흡보호 장비 휴대.",
      "requiredPPE": [
        "호흡보호장비"
      ],
      "sourceSection": "10.5",
      "relatedSR": [
        "SR-CONFINED-021",
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-CC55-06",
      "processOrder": 6,
      "processName": "비상사태 대응 및 통제",
      "safetyMeasures": "비상통제 조직 동원, 재난공정 비상운전정지, 비상발전기·소방펌프 가동, 인명구조 및 응급처치, 소방반 화재진압, 외부기관 지원 요청.",
      "requiredPPE": [
        "개인보호구"
      ],
      "sourceSection": "14",
      "relatedSR": [
        "SR-CHEMICAL-011",
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-CC55-07",
      "processOrder": 7,
      "processName": "비상사태 종결 및 복귀",
      "safetyMeasures": "해제경보 취명으로 비상사태 종결, 비상지휘자 결정에 의함. 모든 직원 복귀 지시, 비상동원 조직 해체, 각 부서별 인원과 장비 파악 후 비상통제단에 보고.",
      "requiredPPE": [],
      "sourceSection": "11",
      "relatedSR": null
    },
    {
      "identifier": "WP-CC55-08",
      "processOrder": 8,
      "processName": "사고조사 및 재발방지대책 수립",
      "safetyMeasures": "비상사태발생 부서장이 관계 부서와 협의하여 사고발생 요약 보고서를 안전보건책임자에게 제출. 비상조치위원회가 사고조사반을 구성하여 사고조사 보고서 작성, 복구계획 및 예방대책 수립.",
      "requiredPPE": [],
      "sourceSection": "12",
      "relatedSR": null
    }
  ],
  "equipmentSpecs": [
    {
      "identifier": "ES-CC55-001",
      "equipmentName": "비상경보시설",
