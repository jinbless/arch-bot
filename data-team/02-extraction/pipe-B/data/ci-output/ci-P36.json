      "relatedSR": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "WP-P36-07",
      "processOrder": 7,
      "processName": "완정공정 (Finishing Process)",
      "safetyMeasures": "캘린더 성형, 압착, 제단 등 기계적 작업으로 협착·전단 위험. 방호장치 점검·검사 실시. 롤 제품 적재 시 받침대 고정, 상부부터 차례대로 운반.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전장갑"
      ],
      "sourceSection": "4.2.3",
      "relatedSR": null
    }
  ],
  "equipmentSpecs": [
    {
      "identifier": "ES-P36-001",
      "equipmentName": "포름알데하이드 (Formaldehyde)",
      "specifications": {
