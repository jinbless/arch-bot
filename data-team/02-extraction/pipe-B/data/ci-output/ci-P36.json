  "checklistItems": [
    {
      "identifier": "CI-P36-001",
      "text": "침지공정 및 표백공정은 인화성 물질을 취급하므로 이들 물질이 노출될 가능성이 있는 곳은 특히 다음과 같은 화재 및 폭발방지 대책을 수립하여야 한다.",
      "guideContext": "펄프 제조공정 안전대책 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "침지공정 및 표백공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-002",
      "text": "인화성 물질이 외부로 누출될 가능성을 줄이기 위하여 관련 설비 및 부속설비는 가능한 한 폐쇄계(Closed system)로 운영하는 것이 바람직하다.",
      "guideContext": "펄프 제조공정 침지·표백 설비",
      "additionalDetail": null,
      "workProcessPhase": "침지공정 및 표백공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-003",
      "text": "인화성 물질의 저장, 취급 장소는 노출 가능성에 따라 폭발위험장소로 구분하여 방폭전기기기·기구를 사용하도록 하여야 한다.",
      "guideContext": "펄프 제조공정 침지·표백 설비",
      "additionalDetail": null,
      "workProcessPhase": "침지공정 및 표백공정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P36-004",
      "text": "인화성 물질이 누출될 가능성이 있는 곳은 가스감지기를 설치하여 폭발하한의 10% 이상의 가스농도가 감지되는 경우 경보발생 및 조치계획을 수립하여 운영하는 것이 바람직하다.",
      "guideContext": "펄프 제조공정 누출 감시",
      "additionalDetail": null,
      "workProcessPhase": "침지공정 및 표백공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-005",
      "text": "펄프·지류 가공 시 분진이 발생할 수 있으므로 강제환기설비를 갖추거나 국소배기장치를 설치하는 것이 바람직하다. 다만, 이들 설비의 설치가 어려울 경우에는 호흡기보호구를 착용하도록 하며, 작업장 주변에 분진이 쌓이지 않도록 한다.",
      "guideContext": "펄프·지류 가공 분진 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-006",
      "text": "목재를 취급할 때에는 껍질 및 수액 등의 접촉으로 염증이 발생할 수 있으므로 소매가 긴 작업복을 입도록 하며, 얼굴, 목, 손 등이 가능한 한 접촉하지 않도록 개인보호구를 착용하는 등 주의하여야 한다.",
      "guideContext": "펄프 제조공정 목재 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "목재 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-007",
      "text": "지류 제조공정에서 사용되는 기기는 대부분 대형의 회전말림의 위험점을 가지므로, 이들 기계에 대한 방호장치를 법규 요구사항에 맞게 점검하고 검사하여야 한다.",
      "guideContext": "지류 제조공정 회전기기 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지류 제조공정 전반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-008",
      "text": "지류 제조공정에서 사용하는 화학약품은 대부분 건강상 악영향을 줄 수 있으므로 피부나 눈에 들어가지 않도록 개인보호구를 착용하여야 한다.",
      "guideContext": "지류 제조공정 화학약품 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지류 제조공정 전반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-009",
      "text": "화학약품의 취급 시 바닥에 쏟는 경우 바닥이 미끄러워 넘어지는 사고를 유발할 수 있으므로 바닥에 액체가 고이지 않도록 경사를 두거나 즉시 닦아낼 수 있는 방재용품을 인근에 비치하여야 한다.",
      "guideContext": "지류 제조공정 화학약품 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지류 제조공정 전반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-010",
      "text": "건조공정에서 사용되는 열풍이나 고온의 기기 표면에 운전자가 접촉하지 않도록 개인보호구를 착용하거나 단열처리(Insulation)를 하는 것이 바람직하다.",
      "guideContext": "지류 제조 건조공정 고온 접촉 방지",
      "additionalDetail": null,
      "workProcessPhase": "건조공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030",
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-P36-011",
      "text": "폐수처리설비 및 폐수 저장탱크에 인화성 가스의 발생우려가 있으므로 온도와 압력을 주기적으로 확인하고 관련 설비를 개방하여야 하는 경우에는, 개방 전 인화성 가스의 농도를 측정하는 것이 바람직하다.",
      "guideContext": "지류 제조 폐수처리설비 관리",
      "additionalDetail": null,
      "workProcessPhase": "폐수처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-012",
      "text": "소각설비에 사용되는 연료가 주변으로 누출되지 않도록 연결부 등의 밀폐성능을 주기적으로 점검하고 검사하여야 한다.",
      "guideContext": "지류 제조 소각설비 연료 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소각설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-013",
      "text": "연료의 누출 가능성이 높은 곳에는 가스감지기를 설치하는 것이 바람직하다.",
      "guideContext": "지류 제조 소각설비 누출 감시",
      "additionalDetail": null,
      "workProcessPhase": "소각설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-014",
      "text": "소각설비의 가동정지 후 재가동할 경우에는, 반드시 소각설비 내부를 불활성 분위기로 퍼지한 후 내부에 인화성 가스가 없다는 것을 확인하여야 한다.",
      "guideContext": "지류 제조 소각설비 재가동 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소각설비 운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-015",
      "text": "펄프 및 지류는 인화성 물질이므로 주변에 고온설비, 화염, 정전기, 스파크 등의 점화원이 존재하지 않도록 주의하여야 한다.",
      "guideContext": "펄프·지류 제조업 공통 화재예방",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P36-016",
      "text": "펄프·지류 가공 시 발생하는 분진은 8시간 노출 시 평균값으로 5 mg/m³ 이하의 양으로 관리하는 것이 바람직하다.",
      "guideContext": "펄프·지류 제조업 분진 농도 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-017",
      "text": "롤 형태의 제품은 경사가 없는 곳에 적재하고, 바닥에 받침대를 고정하여 예상치 못하게 굴러가지 않도록 하는 것이 바람직하다.",
      "guideContext": "펄프·지류 제조업 제품 적재",
      "additionalDetail": null,
      "workProcessPhase": "완정공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P36-018",
      "text": "제품 및 원료는 적재된 물품의 상부에서부터 차례대로 운반하며, 중간이나 바닥에 있는 제품을 먼저 꺼내지 않도록 하여야 한다.",
      "guideContext": "펄프·지류 제조업 적재물 운반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "완정공정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P36-001",
      "term": "펄프 (Pulp)",
      "definition": "목재나 그 밖의 섬유 식물에서 기계적·화학적 또는 그 중간 방법에 의하여 얻는 셀룰로오스 섬유의 집합체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P36-002",
      "term": "침지공정 (Digestion process)",
      "definition": "화학적 방법에 의한 펄프제조 공정 중 목재에 포함된 리그닌을 적절한 용액으로 녹여내어 셀룰로오스로부터 분리해내는 공정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P36-003",
      "term": "리그닌 (Lignin)",
      "definition": "목재에 포함된 성분으로 셀룰로오스를 결합시키는 접착제 역할을 하는 열경화성 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P36-004",
      "term": "셀룰로오스 (Cellulous)",
      "definition": "목재의 구성성분 중 하나로 통상 목재 중 40~50%를 차지하는 다당류를 말하며 섬유소라고도 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P36-005",
      "term": "표백",
      "definition": "염소, 차아염소산염, 이산화염소 혹은 산소와 과산화물 등을 이용하여 펄프의 색깔을 하얗게 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P36-01",
