  "checklistItems": [
    {
      "identifier": "CI-A181-001",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급이상의 것을 사용하여야 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "분석에 사용하는 시약은 제조회사에서 표시하는 농도 함량을 따른다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-002",
      "text": "광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의해야 하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-003",
      "text": "계량기구 중 측정값을 분석결과의 계산에 사용할 목적으로 사용되는 것은 모두 보정하는 것을 원칙으로 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-004",
      "text": "중량분석 용 저울은 적어도 10⁻⁵ g(0.01 mg)까지 칭량할 수 있어야 하며, 화학 분석용 저울은 적어도 10⁻⁴ g(0.1 mg)까지 칭량할 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-005",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 한국산업규격 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-006",
      "text": "각 개인 시료채취펌프를 하나의 대표적인 시료채취매체와 연결하여 보정한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-007",
      "text": "호흡성분진이 포집 가능한 사이클론의 제품 종류에 맞는 유량으로 총 15~2000 L의 공기를 채취하며, 여과지에 채취된 먼지가 총 2 mg을 넘지 않도록 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-008",
      "text": "사이클론을 사용할 때는 시료 채취장치가 전도되지 않도록 주의해야 한다. 필터 카세트와 수직으로 장착되어 있던 사이클론이 수평으로 방향이 바뀌면 사이클론 내부에 있던 큰 입자들이 필터에 침착하게 되어 분석결과에 영향을 미친다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-009",
      "text": "채취가 끝난 여과지는 밀봉하여 먼지가 떨어지지 않도록 카세트를 바로 세워서 운반한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-010",
      "text": "최소 5개의 표준 용액을 제조한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-011",
      "text": "작성한 검량선에 따라 보통 10개의 시료를 분석한 후 표준용액을 이용하여 분석기기 반응에 대한 재현성을 점검한다. 재현성이 나쁘면 검량선을 다시 작성한 후 시료를 분석한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "표준용액의 발광도 변이가 ±5%를 초과한 경우 검량선을 재작성하여 시료를 분석한다.",
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-012",
      "text": "시료채취매체에 알고 있는 양의 분석대상물질을 첨가한 시료(spike 시료)로 회수율(recovery) 시험을 실시하여 현장시료 분석값을 보정한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "예상 시료량이 포함되도록 3가지 이상의 수준 및 각 수준별로 3개 이상의 시료를 만든다.",
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-013",
      "text": "인듐은 호흡기를 통하여 폐에 침착하여 폐질환 등을 일으킬 수 있다. 사용 전 보호장갑, 방독마스크, 실험복 등의 보호구를 착용해야 하며, 실험 시 화재가 발생하지 않도록 주의해야 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "V",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-014",
      "text": "시료의 시험, 바탕시험 및 표준액에 대한 일련의 동일시험을 행할 때 사용하는 시약 또는 시액은 동일 롯트(LOT)로 조제된 것을 사용한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-015",
      "text": "회수율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다. 회수율에 대한 평가는 분석자가 해야 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "12개의 회수율 실험결과를 근거로 회수율간의 일정성을 판단해야 하며, 변이가 심하면 원인을 찾아 교정하고 다시 실험을 실시해야 한다.",
      "workProcessPhase": "분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-016",
      "text": "검량선의 적정성은 제시된 분석기기의 매뉴얼을 참조하거나 상관계수가 0.99이상의 것을 사용하도록 한다.",
      "guideContext": "인듐 작업환경측정·분석",
      "additionalDetail": "검량선은 분석할 시료의 농도를 포함해야 하며 외삽(extrapolation)법은 피한다.",
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A181-017",
      "text": "노출기준/허용기준이 호흡성/흡과성/흡입성으로 설정된 경우 해당 시료채취기를 사용하고 그에 설정된 유량을 적용하여야 한다.",
      "guideContext": "인듐 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "인듐 노출기준: 고용노동부 0.01 mg/m³(호흡성), ACGIH 0.1 mg/m³, NIOSH 0.1 mg/m³",
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-A181-001",
      "term": "밀폐",
      "definition": "취급 또는 보관 상태에서 고형(固形)의 이물(異物)이 들어가지 않도록 한 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A181-002",
      "term": "밀봉",
      "definition": "취급 또는 보관 상태에서 기체 또는 미생물이 침입할 염려가 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A181-003",
      "term": "정확하게 단다",
      "definition": "지시된 수치의 중량을 그 자릿수까지 단다는 것을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A181-004",
      "term": "약",
      "definition": "그 무게 또는 부피에 대하여 ± 10% 이상의 차가 있어서는 안 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A181-005",
      "term": "즉시",
      "definition": "시험조작 중 30초 이내에 표시된 조작을 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A181-006",
      "term": "검출한계",
      "definition": "주어진 분석절차에 따라 합리적인 확실성을 가지고 검출할 수 있는 가장 적은 농도나 양을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A181-007",
      "term": "정량한계",
      "definition": "주어진 신뢰수준에서 정량할 수 있는 분석대상물질의 가장 최소의 양으로, 단지 검출이 아니라 정밀도를 가지고 정량할 수 있는 가장 낮은 농도를 말한다. 일반적으로 검출한계의 3배 수준을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-A181-008",
      "term": "회수율",
      "definition": "채취한 금속류 등의 분석 값을 보정하는데 필요한 것으로, 시료채취 매체와 동일한 재질의 매체에 첨가된 양과 분석량의 비로 표현된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-A181-01",
      "processOrder": 1,
      "processName": "시료채취",
      "safetyMeasures": "개인 시료채취펌프를 시료채취매체와 연결하여 보정한다. 호흡성분진 포집 가능한 사이클론을 사용하여 15~2000 L의 공기를 채취하며, 여과지에 채취된 먼지가 총 2 mg을 넘지 않도록 한다. 사이클론이 전도되지 않도록 주의하고, 채취 완료 후 여과지는 밀봉하여 카세트를 바로 세워서 운반한다.",
      "requiredPPE": [
        "보호장갑",
        "방독마스크",
        "실험복"
      ],
      "sourceSection": "I",
      "relatedSR": null
    },
    {
      "identifier": "WP-A181-02",
      "processOrder": 2,
      "processName": "시료 전처리",
      "safetyMeasures": "카세트 홀더를 열고 시료와 공시료를 깨끗한 비커로 옮긴다. 가열관 방법(질산:염산 1:3 용액, 120℃ 가열) 또는 핫블록 방법(염산·질산, 95℃ 가열) 중 하나를 선택하여 처리한다. 용액을 식힌 후 25mL 용량플라스크에 옮기고 희석용액으로 표선을 맞춘다.",
      "requiredPPE": [
        "보호장갑",
        "방독마스크",
        "실험복"
      ],
      "sourceSection": "II",
      "relatedSR": null
    },
    {
      "identifier": "WP-A181-03",
      "processOrder": 3,
      "processName": "검량선 작성",
      "safetyMeasures": "최소 5개의 표준 용액을 제조하고, 표준용액을 공시료 및 시료와 함께 분석한다. 표준용액 농도에 따른 발광도 결과로 검량선 그래프를 작성하며, 상관계수 0.99 이상을 확보한다.",
      "requiredPPE": [
        "보호장갑",
        "실험복"
      ],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A181-04",
      "processOrder": 4,
      "processName": "ICP 분석 및 회수율 시험",
      "safetyMeasures": "제조사 권고에 따라 ICP 기기 조건을 설정하고 시험용액을 분석한다. 10개 시료 분석 후 표준용액으로 재현성을 점검하며, 발광도 변이 ±5% 초과 시 검량선을 재작성한다. 회수율 시험을 실시하여 현장시료 분석값을 보정한다.",
      "requiredPPE": [
        "보호장갑",
        "실험복"
      ],
      "sourceSection": "III",
      "relatedSR": null
    },
    {
      "identifier": "WP-A181-05",
      "processOrder": 5,
      "processName": "농도 계산",
      "safetyMeasures": "측정된 발광도로 시료 금속 농도(Cs)와 공시료 평균값(Cb)을 계산한다. C = (Cs × Vs - Cb × Vb) / (V × RE) 공식을 적용하여 최종 농도(mg/m³)를 산출한다. 발광도 기록을 저장한다.",
      "requiredPPE": [],
      "sourceSection": "IV",
      "relatedSR": null
    }
  ],
