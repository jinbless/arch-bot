  "domainTerms": [
    {
      "identifier": "DT-H178-001",
      "term": "휴게시설",
      "definition": "근로자들이 휴식시간 내에 신체적 피로와 정신적 스트레스를 해소할 수 있도록 마련한 공간을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H178-002",
      "term": "휴식시간",
      "definition": "근로기준법 제54조에서 규정하고 있는 휴게시간을 의미하는 것으로 근로시간이 4시간인 경우에는 30분 이상, 8시간인 경우에는 1시간 이상의 휴게시간이 근로시간 도중에 제공된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H178-003",
      "term": "도급인",
      "definition": "물건의 제조·건설·수리 또는 서비스의 제공 등의 업무를 도급하는 사업주를 말한다. 단, 건설공사 발주자는 제외한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H178-004",
      "term": "수급인",
      "definition": "도급인으로부터 물건의 제조·건설·수리 또는 서비스의 제공 등의 업무를 도급 받은 사업주를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H178-005",
      "term": "관계수급인",
      "definition": "도급이 여러 단계에 걸처 체결된 경우 각 단계별로 도급받은 사업주 전부를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H178-006",
      "term": "공동휴게시설",
      "definition": "휴게시설의 설치의무가 있는 사업장의 사업주가 다른 사업주와 공동으로 각 사업장의 근로자가 이용할 수 있도록 설치·운영하는 경우를 의미한다. 산업단지 또는 지식산업센터 내 다수 입주기업이나 대형유통센터(아울렛, 마트, 백화점, 면세점 등) 내 다수 입점업체가 공동으로 설치하는 경우를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H178-007",
      "term": "동시 사용인원",
      "definition": "동일한 휴식시간 내에 휴게시설을 이용하는 근로자 수의 최대 합을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H178-01",
      "processOrder": 1,
      "processName": "휴게시설 설치 계획 수립",
      "safetyMeasures": "사업장 특성(교대근무, 휴식형태, 휴식주기, 동시 사용인원)을 고려하여 근로자대표와 최소면적을 협의하고, 도급·파견근로자 포함 이용 대상을 확정한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H178-02",
      "processOrder": 2,
      "processName": "휴게시설 위치 선정",
      "safetyMeasures": "작업장소와 가까운 곳에 설치하되, 화재·폭발 위험장소, 유해물질 취급장소, 분진 발산장소, 소음 노출장소에서 떨어진 안전한 곳에 위치시킨다. 공동휴게시설은 왕복 이동시간이 휴식시간의 20%를 넘지 않는 곳에 위치시킨다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "WP-H178-03",
      "processOrder": 3,
      "processName": "휴게시설 공간 설계 및 시공",
      "safetyMeasures": "바닥면적 최소 6㎡ 이상, 천장 높이 2.1m 이상을 확보한다. 내화성, 내구성 있는 재료를 사용하고 청소하기 쉬운 마감재를 적용한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H178-04",
      "processOrder": 4,
      "processName": "환경 설비 설치",
      "safetyMeasures": "적정 온도(18~28℃) 유지를 위한 냉난방 기능, 적정 습도(50~55%) 유지를 위한 습도조절 기능, 적정 밝기(100~200Lux) 유지를 위한 조명조절 기능, 환기 설비를 설치한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "WP-H178-05",
      "processOrder": 5,
      "processName": "비품 구비 및 표지 부착",
      "safetyMeasures": "소파, 등받이 의자, 탁자 등 휴식 비품과 식수 설비를 구비하고, 기자재·청소도구·수납장은 별도 확보한다. 휴게시설 외부에 표지를 부착한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H178-06",
      "processOrder": 6,
      "processName": "관리 체계 수립 및 운영",
      "safetyMeasures": "관리 담당자를 지정하고 관리 규정을 마련한다. 주기적으로 청소·소독·세탁을 실시하고 관리대장을 작성·비치한다. 유지·관리에 필요한 예산을 배정한다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H178-07",
      "processOrder": 7,
      "processName": "이용 문화 조성 및 개선",
      "safetyMeasures": "직종·직급에 관계없이 자유롭게 이용할 수 있는 문화를 조성하고, 업무강도가 높은 근로자 우선 이용을 배려한다. 정기적으로 근로자 의견을 청취하여 불편사항을 개선하고, 휴게시설 주요 체크리스트를 활용하여 시정조치한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": null
    }
  ],
