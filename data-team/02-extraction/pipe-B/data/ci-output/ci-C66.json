  "domainTerms": [
    {
      "identifier": "DT-C66-001",
      "term": "천장 작업",
      "definition": "건축마감공사 중 반자의 겉면을 마감하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C66-002",
      "term": "내부벽체 작업",
      "definition": "건축마감공사 중 내부벽체에서 시공되는 단열재, 석고보드 등의 작업을 말한다.",
