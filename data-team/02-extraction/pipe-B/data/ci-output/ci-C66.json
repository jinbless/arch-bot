  "checklistItems": [
    {
      "identifier": "CI-C66-001",
      "text": "내장공사 작업단계별로 위험성평가를 실시하여, 유해·위험요인을 파악하고 해당 유해·위험요인에 의한 부상 또는 질병의 발생가능성(빈도)과 중대성(강도)을 추정·결정하고 감소대책을 수립하여야 한다",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-002",
      "text": "작업의 높이에 따른 작업발판의 설치 계획을 수립하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-003",
      "text": "전기기계·기구 사용을 위한 가설전기의 설치 계획을 수립하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-004",
      "text": "배전반 및 분전반의 접지 및 누전차단기 설치 계획을 수립하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-005",
      "text": "자재운반을 위한 양중 작업 및 소운반 작업에 대하여 안전대책을 수립하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-006",
      "text": "각 작업 단위별 필요한 안전시설물 설치순서와 방법, 시기 등을 정하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-007",
      "text": "안전보호구 지급계획(안전모, 안전대, 안전화, 방진마스크, 보안면, 귀마개 등)을 수립하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-008",
      "text": "근골격계질환 예방을 위한 2시간 연속 작업이 이루어지지 않도록 적합한 휴식시간 계획을 수립하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-009",
      "text": "도면 및 시방서를 검토하고, 마감 재료에 따른 유해·위험성을 검토하여 안전대책을 수립하여야 한다.",
      "guideContext": "내장공사 안전·보건작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전·보건작업계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-010",
      "text": "관리감독자는 작업 전에 위험성평가를 실시하고 근로자에게 작업위험요인과 이에 대한 대응방법, 화재 예방 등에 대하여 교육을 실시하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-011",
      "text": "관리감독자는 작업전 당일의 안전작업방법과 유해위험요인 등 근로자가 지켜야할 사항에 대하여 위험예지활동(TBM：Tool Box Meeting)을 실시하고 안전시설설치 및 관리감독자 배치 등 사전 안전조치를 하여야 하며 안전보건점검을 통해 이행여부를 확인하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-012",
      "text": "작업장 출입구 및 내부에는 충분한 조도를 확보(보통작업 150 럭스 이상)하여야 한다",
      "guideContext": "내장공사 안전작업 공통 사항",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C66-013",
      "text": "자재를 반입 및 반출 시 전동 지게차, 헨드 파레트 트럭(Hand Pallet Truck) 등을 이용하고 인력 운반을 최소화 하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-014",
      "text": "벽체, 천장 작업 시 이동식 비계를 사용하는 경우에는 작업발판을 설치하고 안전난간 등 떨어짐(추락)방지 시설을 설치하여야 하며 바퀴고정장치, 아웃트리거, 승강용사다리 등을 설치하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C66-015",
      "text": "작업 전에 근로자 이동통로, 자재보관장소 및 운반통로를 확보하여야 하며, 작업 중 자재에 걸려 넘어지지 않도록 정리·정돈하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C66-016",
      "text": "전기기계·기구 사용 시 누전, 합선, 과부하 등에 의한 감전 및 화재 등으로 인한 재해를 예방하기 위하여 사용 전에 점검하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-017",
      "text": "헨드그라인더, 조명 등 전기기계·기구 사용 시, 접지가 되어 있는 분전반의 누전차단기를 통하여 전원을 인출하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-018",
      "text": "헨드그라인더 및 절단기 커버 등의 방호장치를 점검하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-019",
      "text": "고속절단기 사용 시 안전덮개 설치 및 불티 비산방지 조치를 하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-020",
      "text": "안전모, 안전대, 보안면, 방진마스크 등 보호구를 착용하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-021",
      "text": "자재운반 작업 시에는 근골격계 질환예방을 위한 무게의 적정성이 유지(남자 20~30kgf, 여자 10~15kgf이하)되어야 하며, 5kgf이상의 자재를 들어서 운반하는 경우 취급 물품에 대하여 작업근로자가 쉽게 알아 볼 수 있도록 물품의 중량과 무게중심에 대하여 사전에 안전교육을 실시하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-022",
      "text": "작업높이에 따라 적합한 작업발판을 사용하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-023",
      "text": "떨어짐(추락)의 위험이 있는 작업발판에는 안전난간 등 떨어짐(추락) 방호조치를 하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-CARGO-004",
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C66-024",
      "text": "작업 종료 후 작업발판과 잔여자재에 대하여 정리 정돈 및 청소를 시행한다.",
      "guideContext": "내장공사 안전작업 공통 사항",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-025",
      "text": "화재의 위험이 있는 장소에는 소화기, 방화수 등을 비치하여 화재 발생시 초기에 소화할 수 있도록 하여야 한다.",
      "guideContext": "내장공사 안전작업 공통 사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전작업 공통",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-026",
      "text": "자재운반 시 작업 통로를 확보해야 한다.",
      "guideContext": "천장공사 자재운반",
      "additionalDetail": "그 밖의 작업 통로 설치에 관한 안전조치 사항은 작업장의 통로 및 계단 설치에 관한 기술지침(KOSHA GUIDE G-85-2015)에 따른다.",
      "workProcessPhase": "천장공사 자재운반",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.(가)",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C66-027",
      "text": "지게차 운반 시에는 급작스런 제동 및 방향전환을 금지하고, 운전원은 운행 경로 및 주변을 주시하여야 한다.",
      "guideContext": "천장공사 자재운반 (법령 근거 미확인)",
      "additionalDetail": "그 밖의 지게차 작업에 관한 안전조치 사항은 지게차의 안전작업에 관한 기술지침(KOSHA GUDIE M-185-2015)에 따른다.",
      "workProcessPhase": "천장공사 자재운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-028",
      "text": "천장의 높이를 고려하여 작업발판의 높이를 조정하여야 한다.",
      "guideContext": "천장공사 작업발판 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "천장공사 작업발판 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.(나)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-029",
      "text": "떨어짐(추락)위험이 있는 작업발판은 안전난간 등 떨어짐(추락)방지조치를 하여야 한다.",
      "guideContext": "천장공사 작업발판 설치",
      "additionalDetail": null,
      "workProcessPhase": "천장공사 작업발판 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.(나)",
      "basedOn": [
        "SR-CARGO-004",
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C66-030",
      "text": "작업발판 승하강용 통로의 답단의 높이는 25cm 이내로 설치하여야 한다.",
      "guideContext": "천장공사 작업발판 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "천장공사 작업발판 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.(나)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-031",
      "text": "층고가 높은 천장의 경우에는 비계 등을 조립하는 방법으로 작업발판을 설치하여야 하며 작업발판 위에 말비계, 사다리 등을 설치하는 것은 금지하여야 한다.",
      "guideContext": "천장공사 작업발판 설치",
      "additionalDetail": null,
      "workProcessPhase": "천장공사 작업발판 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.(나)",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C66-032",
      "text": "화약을 사용하는 타정총은 사전허가 여부를 확인하여야 한다.",
      "guideContext": "천장공사 슬라브 인서트 매립작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "슬라브 인서트 매립작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-033",
      "text": "타정총의 낙하격발안전장치, 방아쇠안전장치 등의 안전장치를 점검하여 오발사고를 예방하여야 한다.",
      "guideContext": "천장공사 슬라브 인서트 매립작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "슬라브 인서트 매립작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-034",
      "text": "타정총의 상향작업 시 수직(직각)을 유지하여 사용하여야 한다.",
      "guideContext": "천장공사 슬라브 인서트 매립작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "슬라브 인서트 매립작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-035",
      "text": "앵커볼트 설치를 위한 드릴작업 등의 상향 작업 시에는 안전모, 보안면, 방진마스크 등을 착용하여야 한다.",
      "guideContext": "천장공사 슬라브 인서트 매립작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "슬라브 인서트 매립작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-036",
      "text": "캐링채널(Carrying Channel), M-Bar 설치 시, 날카로운 부위에 인한 자상(刺傷) 등의 부상을 예방할 수 있도록 장갑을 착용하여야 한다.",
      "guideContext": "천장공사 캐링채널·M-Bar 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캐링채널·M-Bar 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.(라)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-037",
      "text": "단부 작업 시 작업발판과 벽체 사이의 끝부분에 안전시설을 설치하여 떨어짐(추락), 발빠짐 등에 의한 재해를 예방하여야 한다.",
      "guideContext": "천장공사 캐링채널·M-Bar 설치",
      "additionalDetail": null,
      "workProcessPhase": "캐링채널·M-Bar 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.(라)",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C66-038",
      "text": "전동공구, 전기기계기구 사용 시 절연상태 및 분전반을 점검하여 감전 재해를 방지하여야 한다.",
      "guideContext": "천장공사 천장재 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "천장재 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.(마)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-039",
      "text": "타정총의 낙하격발 안전장치, 방아쇠 안전장치, 밀착압력 안전장치 등 안전 장치를 작업전에 점검하고 안전 장치를 임의로 해제하여서는 아니 된다.",
      "guideContext": "천장공사 천장재 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "천장재 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.(마)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-040",
      "text": "건설용 리프트, 이삿짐운반용 리프트, 이동식크레인 등 작업에 적정한 양중 장비를 선정하여 자재 및 부재의 현장 반입은 작업공정 순서에 맞게 이루어질 수 있도록 한다.",
      "guideContext": "벽체공사 작업 전 준비",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-041",
      "text": "자재 소운반 시에는 부재별 형상에 적합한 소운반 장비를 선정하고 사용하여야 하며, 인력운반을 최소화 하여야 한다.",
      "guideContext": "벽체공사 작업 전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-042",
      "text": "작업장 및 통로 주변 개구부의 안전난간, 덮개 등 방호시설 설치 여부와 통로의 바닥 상태 등을 확인하고, 안전표지를 부착하여야 한다.",
      "guideContext": "벽체공사 작업 전 준비",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.(가)",
      "basedOn": [
        "SR-CARGO-004",
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C66-043",
      "text": "가연성 및 인화성 물질 관리, 유기용제 사용 및 밀폐공간 작업시 안전보건대책, 화재 예방을 위한 소화기 사용법 및 대피 요령 등에 대하여 안전보건 교육을 실시하여야 한다.",
      "guideContext": "벽체공사 작업 전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-044",
      "text": "말비계(간이작업대)사용 시에는 다음 사항을 준수하여야 한다.\n- 떨어짐(추락) 위험이 있는 개구부 주변에서 사용 금지\n- 수평을 유지하여 설치하고, 전도 예방조치 실시.",
      "guideContext": "벽체공사 작업 전 준비",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.(가)",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C66-045",
      "text": "타정총은 다음 사항을 준수하여야 한다.\n㉮ 타정총(화약총)에 대해서는 사전신고 여부를 확인하여야 한다.\n㉯ 타정총 등 화약을 사용하는 공구는 별도의 장소에 보관 하여야 한다.\n㉰ 타정총 사용 시에는 사람을 향하지 않도록 하고, 이동시에는 잠금장치를 하여야 한다.\n㉱ 타정총의 낙하격발 안전장치, 방아쇠 안전장치, 밀착압력 안전장치 등 안전 장치를 작업 전에 점검하고 안전 장치를 임의로 해제하여서는 아니 된다.",
      "guideContext": "벽체공사 작업 전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-046",
      "text": "절단기 사용 시에는 숫돌의 최고 사용회전속도를 준수하고, 방호장치(안전커버)의 부착을 확인하여야 한다.",
      "guideContext": "벽체공사 작업 전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-047",
      "text": "절단기 사용 시에 불티 비산방지 시설 설치, 방화 매트 깔기, 소화기 및 방화수 비치 등 화재 예방 조치를 취하여야 한다.",
      "guideContext": "벽체공사 작업 전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-048",
      "text": "근로자는 작업 시에 안전모, 안전화, 방진마스크, 보안면, 귀마개 등 작업에 적합한 개인 보호구를 착용하여야 한다.",
      "guideContext": "벽체공사 작업 전 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "벽체공사 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.(가)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-049",
      "text": "먹메김 작업 시 개구부 덮개 설치 여부를 확인하여야 한다.",
      "guideContext": "벽체공사 먹메김 및 석고보드 설치",
      "additionalDetail": null,
      "workProcessPhase": "먹메김 및 석고보드 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.(나)",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C66-050",
      "text": "핀 제거 시 비산물에 의한 눈 손상이 발생 가능하므로 보안경을 착용하여야 한다.",
      "guideContext": "벽체공사 먹메김 및 석고보드 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "먹메김 및 석고보드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.(나)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-051",
      "text": "접착제 혼합 시 감전위험이 있으므로 교반기(Mixer) 접지 및 절연상태를 점검하여야 한다.",
      "guideContext": "벽체공사 먹메김 및 석고보드 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "먹메김 및 석고보드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.(나)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-052",
      "text": "단열재 절단 시 칼에 의해 손가락이 다칠 위험이 있으므로 안전장갑을 착용하는 등 대비 하여야 한다.",
      "guideContext": "벽체공사 먹메김 및 석고보드 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "먹메김 및 석고보드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.(나)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-053",
      "text": "석고보드 재료에 따라 마스크, 보안면, 장갑 등 보호구를 착용하고 환기설비를 설치하여야 한다.",
      "guideContext": "벽체공사 먹메김 및 석고보드 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "먹메김 및 석고보드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.(나)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-054",
      "text": "작업발판(말비계) 사용 시 폭 40cm이상을 사용하여야 한다.",
      "guideContext": "벽체공사 경량벽체 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경량벽체 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-055",
      "text": "총기 사용 시 안전수칙을 사전에 교육하고 사용하도록 하여야 한다.",
      "guideContext": "벽체공사 경량벽체 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경량벽체 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-056",
      "text": "전동공구, 전기기계기구 사용 시 절연상태 및 분전반의 누전차단기와 접지 상태를 점검하고, 방호장치를 확인하여야 한다.",
      "guideContext": "벽체공사 경량벽체 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경량벽체 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-057",
      "text": "용접 및 절단작업 시 화재위험이 있으므로 가연물·인화물 제거, 불티 비산방지설비 설치, 소화기 비치 등을 하여 화재예방 조치를 하여야 한다.",
      "guideContext": "벽체공사 경량벽체 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경량벽체 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-058",
      "text": "절단작업 시 칩 비산에 의한 위험이 있으므로 보안면을 착용하여야 한다.",
      "guideContext": "벽체공사 경량벽체 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경량벽체 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.(다)",
      "basedOn": null
    },
    {
      "identifier": "CI-C66-059",
      "text": "석고보드 절단 시 공구에 의해 손가락이 다칠 위험이 있으므로 장갑을 착용하는 등 대비하여야 한다.",
      "guideContext": "벽체공사 경량벽체 설치 (법령 근거 미확인)",
      "additionalDetail": null,
