  "checklistItems": [
    {
      "identifier": "CI-BM23-001",
      "text": "관리대상 유해물질을 취급하는 장소나 설비를 매월 1회 이상 순회점검하고 국소배기장치 등 환기설비에 대해서는 후드(hood)나 덕트(duct)의 마모·부식, 그 밖의 손상 여부 및 정도를 점검하여 필요한 조치를 하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 관리감독자의 유해·위험 방지 업무",
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-002",
      "text": "송풍기와 배풍기의 주유 및 청결 상태를 점검하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 관리감독자의 유해·위험 방지 업무",
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-003",
      "text": "덕트 접속부가 헐거워졌는지 여부를 점검하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 관리감독자의 유해·위험 방지 업무",
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-004",
      "text": "전동기와 배풍기를 연결하는 벨트의 작동 상태를 점검하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 관리감독자의 유해·위험 방지 업무",
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-005",
      "text": "흡기 및 배기 능력 상태를 점검하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 별표2 관리감독자의 유해·위험 방지 업무",
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-006",
      "text": "사업주는 국소배기장치에 공기정화장치를 설치하는 경우 정화 후의 공기가 통하는 위치에 배풍기(排風機)를 설치하여야 한다. 다만, 빨아들여진 물질로 인하여 폭발할 우려가 없고 배풍기의 날개가 부식될 우려가 없는 경우에는 정화 전의 공기가 통하는 위치에 배풍기를 설치할 수 있다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제74조(배풍기)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-007",
      "text": "송풍기 또는 배풍기(덕트를 사용하는 경우에는 그 덕트의 흡입구를 말한다)는 가능하면 해당 분진등의 발산원에 가장 가까운 위치에 설치할 것",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제77조(전체환기장치)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-008",
      "text": "송풍기 또는 배풍기는 직접 외부로 향하도록 개방하여 실외에 설치하는 등 배출되는 분진등이 작업장으로 재유입되지 않는 구조로 할 것",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제77조(전체환기장치)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-009",
      "text": "송풍기 및 가드는 점검 및 보수유지가 가능하도록 설치되어야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-010",
      "text": "설치 전 회전 부품인 임펠러와 로터의 밸런스를 맞춘다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-011",
      "text": "제조사의 지침에 따라 부품을 설치하고, 움직이는 부품과 구동 장치를 올바르게 정렬한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-012",
      "text": "회전부위나 운동부위는 덮개나 울 등방호설비로 보호되어야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-013",
      "text": "노출된 송풍기의 흡입구(급기구)는 종이나 쓰레기 기타 이물질이 유입되지 않도록 금속으로 제작된 미세한 필터를 설치하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-014",
      "text": "흡입구(급기구) 및 토출구(배기구)는 사람이 접근할 수 없는 곳에 설치하거나 주위에 울 등을 설치하여 사람의 접근을 방지한다. 송풍기의 흡입구와 토출구에서 덕트 연결 여부에 따라 덕트 연결이 없는 곳에는 고정형 가드를 사용하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-015",
      "text": "고정형 가드는 진동에 의해 헐거워지지 않도록 고정하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-016",
      "text": "고정형 가드는 송풍기의 작동과 주변 환경조건에 견딜 수 있는 견고한 구조여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-017",
      "text": "고정형 가드는 위험한 부분에의 접근을 막을 수 있도록 해야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-018",
      "text": "송풍기 내부 검사 및 청소 시 접근할 수 있도록 고정식 가드는 제거 가능하여야 한다. 전원이 공급되는 동안에는 가드를 열거나 제거할 수 없도록 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-019",
      "text": "KOSHA GUIDE C-C-48-2026 「유해·위험설비의 점검·정비·유지관리에 관한 기술지원규정」에 따라 A 등급으로 분류되는 대형 송풍기에는 진동감시장치 및 베어링 부위에 온도측정장치를 설치하여 자동으로 경보가 울리고 차단이 되도록 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-020",
      "text": "풍량을 가변시켜 전범위에 걸쳐 사용되는 송풍기에는 서지(Surge)검출 및 방지장치를 설치한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-021",
      "text": "안전한 설치, 작동, 유지보수에 관해 제조업체로부터 제공된 지침을 따라야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-022",
      "text": "잠재적인 위험을 사용자에게 경고하는 안전 라벨을 송풍기의 쉽게 보이는 위치에 부착하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-023",
      "text": "베어링에는 지정된 윤활유가 적정한 양으로 채워져 있음을 확인한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "운전전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-024",
      "text": "송풍기 케이싱 내부에 고인 물이나 기름을 배출시킨다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "운전전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-025",
      "text": "케이싱 내부에 이물질이 없음을 확인한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "운전전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-026",
      "text": "운전이 시작되면 베어링 온도, 케이싱 내의 음향, 진동, 전류계 등의 상태가 정상인지를 확인한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "안전 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-027",
      "text": "전폐상태의 운전을 장시간 하면 케이싱내에 압축열이 축적되어 사고발생 우려가 있으므로 규정풍량의 10 % 이상을 유출시키도록 한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "안전 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-028",
      "text": "토출댐퍼를 조작할 때에는 소풍량의 범위에서 서지를 일으킬 수 있으므로 이 범위에서는 빨리 댐퍼를 열어 서지를 방지한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "안전 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-029",
      "text": "베어링의 온도는 주위온도보다 40 ℃ 높은 온도 또는 최대 70 ℃를 넘지 않도록 한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "안전 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-030",
      "text": "송풍기를 정상 성능곡선 한계 내에서 작동하도록 한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "안전 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-031",
      "text": "밀봉장치는 축의 회전속도, 풍압, 가스의 종류, 온도에 따라 선정되므로 제작자에 의하여 지정된 것을 사용하여야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": "독성가스 누출 시 사람이나 환경에 해를 끼치며, 가연성 가스 누출 시 폭발 위험이 있음",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-032",
      "text": "수봉식 글랜드(Gland)일 경우에는 케이싱 내부압력에 의하여 밀봉수입이 적당히 유지되지 않으면 밀봉수가 밖으로 누출되거나 안으로 침투되므로 송풍기의 흡입압에 따라 밀봉수입을 일정하게 유지하고 밸브로 조정하여 내부가스의 누출을 방지한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-033",
      "text": "운전중 이상이 발생되었을 경우에는 <별표1>을 참조하여 점검을 하고 확실한 원인을 파악한 후 그에 대한 보수를 시행한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "이상 발생 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-034",
      "text": "베어링 온도, 케이싱내의 음향, 진동, 전류계 상태, 전동기의 온도, 하중 등을 모니터링하여 운전대장에 기록한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "운전중 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-035",
      "text": "시동, 정지시간을 기록하여 가동율을 알 수 있도록 한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "운전중 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-036",
      "text": "풍량, 풍압, 가스의 종류 또는 온도 등 사용상태의 변화가 있을 때에는 이를 상세히 기록한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "운전중 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-037",
      "text": "송풍기의 중요도 등급, 설비의 내구연한, 외부공기조건, 순환공기중의 분진량 등에 따라 예방적인 점검 및 정비의 주기를 정한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-038",
      "text": "고장 발생시 사고의 위험이나 생산공정에 영향을 주는 송풍기는 1년에 1회 이상 예방점검 및 정비를 하는 것이 권장된다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-039",
      "text": "1년 중 일정 기간만 가동하는 송풍기는 가동전이나 작동 후에 점검 및 정비를 시행한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-040",
      "text": "기록된 진동치나 온도를 전체적으로 검토하고 분석을 통해 이상유무를 확인한다. 매일 기록된 측정치에 대한 추세를 확인하고, 제조업체가 제공한 한계치와 비교한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-041",
      "text": "이물질의 흡입, 먼지나 슬러지의 퇴적 유무, 막힘상태 등을 확인한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-042",
      "text": "구동벨트가 이화, 마멸, 손상된 곳이 있는가를 검사한다. 그리고, 벨트 구동식 송풍기의 구동벨트의 장력을 확인한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-043",
      "text": "전동기, 전선 등의 부식, 진동이나 습기 등에 의한 절연열화나 손상이 있는가를 검사한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-044",
      "text": "블레이드(날개), 축 등 운동부위에 부식, 변형, 마멸, 크랙, 홈 등이 발생되었는지를 검사한다. 용접부와 볼트의 상태에 특히 주의한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-045",
      "text": "일정 주기 혹은 진동분석이나 육안검사에서 이상징후가 발견되면 송풍기를 분해하고 모든 회전부에 대하여 액체침투탐상검사나 자분탐상검사, 초음파두께탐상검사 등의 비파괴검사를 실시한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-046",
      "text": "댐퍼를 작동시켜 헐거움이나 고착이 있는지 확인한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-047",
      "text": "이물질의 축적을 방지할 수 있도록 블레이드(날개), 임펠러 및 케이싱 내부를 청소한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-048",
      "text": "부식된 곳은 녹을 제거하고 손상부위를 보수한 후 부식방지를 위한 재도장 등의 조치를 한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-049",
      "text": "허브부시, 베어링 등 모든 구동부위 및 운동부위에는 재급유를 하고 그리스를 도포한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": "과열을 피하기 위해 사용되는 그리스의 양이 과도해서는 안 되며, 그리스 주입 전에 그리스 피팅을 철저히 청소한 후 릴리프 구멍이나 배수구를 열어야 한다.",
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-050",
      "text": "정기적인 검사를 통해 구동벨트의 장력을 조정하며, 과도한 마모, 취성 징후 등 이상이 발견될 때에는 즉시 구동벨트를 교체한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-051",
      "text": "베어링은 제조업체가 지정한 수명 제한에 따라 일정에 맞춰 교체한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": "베어링 오프셋 정렬 불량은 축 균열 뿐만 아니라 커플링 손상의 원인이므로 주기적으로 재정렬해야 한다.",
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-052",
      "text": "블레이드(날개)가 손상, 변경된 것은 밸런스 관계상 수정이 어려우므로 신품으로 교체한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": "블레이드(날개)에 상당한 부식이나 두께 감소가 확인되면 제조업체에 문의하여 교체 여부를 결정한다.",
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-053",
      "text": "댐퍼 베어링은 정기적으로 윤활한다. 댐퍼를 작동시켜 헐거움이나 고착이 있는지 확인하고, 이상이 있을 시 수정한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-054",
      "text": "가변피치 축류 팬 시스템의 오버홀은 <표 2>에 따라 매 2년 마다 시행을 권장한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "정기정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-055",
      "text": "점검 및 정비후에는 점검결과 및 정비내용을 정비이력기록서에 상세히 기록한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "점검 및 정비기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-056",
      "text": "정비이력기록서에는 제작자의 설치·운전·보수지침서, 기술정보, 점검기록, 정비이력 등이 포함되어 있어야 한다.",
      "guideContext": "송풍기의 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검 및 정비기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-057",
      "text": "정비이력기록서에는 발견된 비정상 상태, 복구방법 등을 상세히 기록하여 차후의 정비에 참조할 수 있도록 한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "점검 및 정비기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM23-058",
      "text": "정비이력기록은 KOSHA GUIDE C-C-48-2026 「유해·위험설비의 점검·정비·유지관리에 관한 기술지원규정」의 기기정비이력기록서 양식을 참조하여 기록한다.",
      "guideContext": "송풍기의 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "점검 및 정비기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BM23-001",
      "term": "송풍기(Industrial fan)",
      "definition": "임펠러 또는 로터의 회전 운동으로 기체를 압송하며, 공기압축기(압력비) 1.3 이하에 적용하는 것을 말한다. 국소배기장치의 일부로서도 사용되며, 오염공기를 후드에서 빨아들여 덕트 내로 유동시켜서 옥외로 배출하는 원동력을 만들어 내는 흡인장치이며, 배풍기, 팬, 블로워(Blower) 등으로도 불리운다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-002",
      "term": "댐퍼(Damper)",
      "definition": "유체가 흐르는 통로에 지항체를 넣어 유량을 조절하는 장치",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-003",
      "term": "임펠러(Impeller)",
      "definition": "깃, 주관, 측판, 허브 등으로 구성되고 있는 회전부품",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-004",
      "term": "로터(Rotor)",
      "definition": "임펠러를 주축에 붙여 일체로 한 것",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-005",
      "term": "래버린스(Labyrinth)",
      "definition": "다수의 교축편을 두어 기체의 누설을 감소시키는 기구",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-006",
      "term": "글랜드 래버린스(Gland labyrinth(seal))",
      "definition": "축 밀봉부에 부착한 래버린스. 래버린스를 이용한 축 밀봉의 방법 또는 부품",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-007",
      "term": "수봉(Water seal)",
      "definition": "수압력을 이용한 축 밀봉의 방법 또는 부품",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-008",
      "term": "케이싱, 하우징",
      "definition": "기계 내부의 밀폐를 위한 피복, 용기, 둘러싸기 등의 역할을 하는 부분. 각종 엘리먼트를 사용 압력에 맞는 용기 내에 수납하여 사용하는 용기",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-009",
      "term": "방호설비(Safeguard)",
      "definition": "가드와 방호장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-010",
      "term": "서징(Surging), 맥동 현상",
      "definition": "송풍기와 배관을 포함한 계가 특히 주기적인 부하변동을 주지 않았는데도 일종의 공력 진동을 발생하여 주기적으로 압력이나 유량이 변동하는 현상, 즉, 배압 불안정성에 의해 발생하는 유체의 진동 거동을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-011",
      "term": "공진(Resonance)",
      "definition": "매우 작은 양이라도 가진 주파수를 변화시켰을 때 계의 반응이 줄어드는 강제 요동하는 계의 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM23-012",
      "term": "플리터(Flutter)",
      "definition": "구조물이 주위의 기체나 유체와 동적으로 상호 작용하여 발생하는 자려 진동을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BM23-01",
      "processOrder": 1,
      "processName": "운전전 점검",
      "safetyMeasures": "베어링에 지정된 윤활유가 적정량 채워져 있음을 확인하고, 케이싱 내부에 고인 물이나 기름을 배출시키며, 케이싱 내부에 이물질이 없음을 확인한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM23-02",
      "processOrder": 2,
      "processName": "안전 운전",
