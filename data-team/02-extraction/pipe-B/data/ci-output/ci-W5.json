  "checklistItems": [
    {
      "identifier": "CI-W5-001",
      "text": "시험책임자는 운영책임자로부터 시험책임자로 지정되면 시험물질의 조제 등에 관한 자료를 확보하고 시험계획서를 작성한다.",
      "guideContext": "급성경구독성시험 시험계획서 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-002",
      "text": "시험책임자는 시험계획서가 운영책임자에 의하여 승인되면, 실험동물윤리위원회의 심의 및 동물구입 신청이 원활히 이루어 질 수 있도록 한다.",
      "guideContext": "급성경구독성시험 시험계획서 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-003",
      "text": "시험계획서에는 표지 및 시험개요, 시험세부계획이 포함되도록 한다.",
      "guideContext": "급성경구독성시험 시험계획서 작성 (법령 근거 미확인)",
      "additionalDetail": "시험세부계획에는 시험목적, 적용된 시험방법, 사용된 시험계, 동물사육환경, 사료, 음용수, 시험물질 및 매체대조물질, 투여방법, 시험항목, 통계처리, 보관될 기록 및 자료, GLP 대응 및 신뢰성 보증, 참고문헌, 첨부자료 등으로 구성한다.",
      "workProcessPhase": "시험계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-004",
      "text": "동물관리책임자는 사용할 동물실의 환경, 청소 소독, 설비를 점검하고 이상이 없도록 준비한다.",
      "guideContext": "급성경구독성시험 동물입수 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물입수 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-005",
      "text": "사용할 기자재가 완전히 갖추어 진 것을 확인한다.",
      "guideContext": "급성경구독성시험 동물입수 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물입수 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-006",
      "text": "개체식별카드는 미리 작성하여 사육상자 전면에 부착한다.",
      "guideContext": "급성경구독성시험 동물입수 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물입수 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-007",
      "text": "동물실 사용기록지를 작성하여 사용할 동물실의 전면에 부착한다.",
      "guideContext": "급성경구독성시험 동물입수 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "동물입수 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-008",
      "text": "연령이 8~12 주령 된 시험용 랫드(다른 설치류도 가능)를 사용하며 개체 간 체중 차이는 평균체중의 ±20 %를 넘지 않도록 한다.",
      "guideContext": "급성경구독성시험 시험동물 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험동물 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-009",
      "text": "시험은 한쪽 성을 사용하는데 암컷을 사용하는 것을 원칙으로 하며, 수컷을 사용할 경우 타당한 사유를 제시한다.",
      "guideContext": "급성경구독성시험 시험동물 선정",
      "additionalDetail": null,
      "workProcessPhase": "시험동물 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-010",
      "text": "암컷은 과거에 새끼를 낳은 적이 없고 현재 임신 중이지 않은 것을 사용한다.",
      "guideContext": "급성경구독성시험 시험동물 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험동물 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-011",
      "text": "시험에 사용할 개체는 시험 시작 전 최소 5 일 이상 실험실에서 순화시킨 건강한 동물 중에서 무작위로 선정한다.",
      "guideContext": "급성경구독성시험 시험동물 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험동물 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-012",
      "text": "사육실은 온도가 22℃±3℃, 습도가 30~70%가 유지되도록 한다.",
      "guideContext": "급성경구독성시험 사육조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사육환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-013",
      "text": "사육은 암·수를 구별하여 실시하며 각 개체의 상태 관찰이 용이하도록 밀도가 높지 않도록 한다.",
      "guideContext": "급성경구독성시험 사육조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사육환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-014",
      "text": "조명은 명/암이 12/12 시간이 되도록 조절하며, 사료와 물을 적절히 공급한다.",
      "guideContext": "급성경구독성시험 사육조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사육환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-015",
      "text": "사용하는 용매는 사전에 독성 여부와 특성이 잘 알려진 것을 사용한다.",
      "guideContext": "급성경구독성시험 시험물질 준비",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.4",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W5-016",
      "text": "경구 투여하는 시험물질의 양은 시험동물의 크기에 따라 다르나, 일반적으로 최대 1 ㎖ / 100 g(체중)을 넘지 않도록 한다. 다만 수용액의 경우는 2 ㎖/100 g까지 허용한다.",
      "guideContext": "급성경구독성시험 시험물질 투여 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-017",
      "text": "투여는 1회 투여를 원칙으로 하되 불가능할 경우 소량씩 나누어 실시한다. 이때 투여 간격은 24 시간이 넘지 않도록 한다.",
      "guideContext": "급성경구독성시험 시험물질 투여 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-018",
      "text": "시험물질을 투여하기 전날 저녁부터 물을 제외한 먹이 공급을 중단하고 체중을 측정한다(마우스의 경우는 투여 전 3~4시간 전부터 먹이 공급을 중단한다).",
      "guideContext": "급성경구독성시험 시험물질 투여 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-019",
      "text": "시험물질의 경구투여 후 3~4시간 후(마우스의 경우는 1~2시간 후)부터 먹이를 공급한다.",
      "guideContext": "급성경구독성시험 시험물질 투여 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 투여",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-020",
      "text": "관찰은 투여 후 30 분 이내에 적어도 한번 관찰하고, 특히 투여 후 처음 4시간은 특별한 주의를 기울여 관찰하도록 한다. 이후 14일까지 적어도 1회 이상 관찰한다.",
      "guideContext": "급성경구독성시험 본시험 관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-021",
      "text": "빈사 상태의 동물은 안락사 시킨다.",
      "guideContext": "급성경구독성시험 본시험 수행 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-022",
      "text": "독성 증상이 나타나기 시작한 시간과 소멸되기 시작한 시간은 매우 중요하므로 모든 관찰은 체계적으로 기록되어야 하며, 개체별로 기록하여야 한다.",
      "guideContext": "급성경구독성시험 본시험 관찰 기록",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W5-023",
      "text": "관찰은 피부 및 털, 눈 및 점막, 호흡계, 순환계, 자율 및 중추신경계, 행동 유형을 포함한다. 특히 경련, 설사, 유연, 혼수상태 등의 증상은 유의하여 관찰한다.",
      "guideContext": "급성경구독성시험 본시험 관찰 항목 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-024",
      "text": "체중은 시험물질 투여 직전과 종료 후 부검 직전 측정하며, 시험기간 중에는 주 1회 측정을 원칙으로 하는데 이때 체중 변화를 계산하여 반드시 기록하도록 한다.",
      "guideContext": "급성경구독성시험 본시험 체중 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-025",
      "text": "시험 중 사망 및 빈사동물을 포함하여 모든 시험동물은 부검 후 소견을 기록한다. 필요시 부검 후 조직병리학적 관찰을 통한 소견을 기록한다.",
      "guideContext": "급성경구독성시험 본시험 부검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-026",
      "text": "부식성이나 자극성이 큰 물질의 경우 시험동물에 고통을 주므로 되도록 시험을 피하도록 한다.",
      "guideContext": "급성경구독성시험 유의사항",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-W5-027",
      "text": "시작농도 선택에 신중을 기함으로써 시험동물의 수를 가능한 최소화 하여야 한다.",
      "guideContext": "급성경구독성시험 유의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-028",
      "text": "시험동물이 참기 힘들 정도로 고통스러워할 경우 안락사 시키며 시험 중 사망한 동물로 처리한다.",
      "guideContext": "급성경구독성시험 유의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-W5-029",
      "text": "시험용량, 시험동물 수, 독성증상을 보이는 시험동물 수, 시험기간 중 치사동물 수, 독성발현 및 시간, 용량-독성반응 관계, 부검결과 등을 기록한다.",
      "guideContext": "급성경구독성시험 결과 처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과 처리 및 보고",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-W5-001",
      "term": "급성경구독성",
      "definition": "시험물질을 24시간 이내에 1회 또는 수회 경구투여한 후 단시간 내에 나타나는 악영향(Adverse effects)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W5-002",
      "term": "투여량(Dose)",
      "definition": "투여하는 시험물질의 양을 말한다. 일반적으로 단위는 시험동물의 체중 당 시험물질의 무게(예, mg/kg)로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W5-003",
      "term": "빈사 상태(Moribund state)",
      "definition": "시험물질의 독성에 의하여 시험동물이 죽어가는 상태 또는 생존할 가망이 없는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W5-004",
      "term": "우수실험실 운영규정(Good Laboratory Practice, GLP)",
      "definition": "유해위험성 실험실운영규정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W5-005",
      "term": "GHS(Globally Harmonized Classification System for Chemical Substances and Mixtures)",
      "definition": "국제적으로 조화된 화학물질의 분류시스템을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-W5-01",
      "processOrder": 1,
      "processName": "시험계획서 작성",
      "safetyMeasures": "시험책임자가 시험물질의 조제 등에 관한 자료를 확보하고 시험계획서를 작성한다. 운영책임자 승인 후 실험동물윤리위원회 심의를 거친다. 시험계획서에는 표지 및 시험개요, 시험세부계획(시험목적, 시험방법, 시험계, 동물사육환경, 사료, 음용수, 시험물질, 투여방법, 시험항목, 통계처리, 보관 기록, GLP 대응 등)이 포함되도록 한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-W5-02",
      "processOrder": 2,
      "processName": "동물입수 및 사육환경 준비",
      "safetyMeasures": "동물관리책임자는 동물실의 환경, 청소 소독, 설비를 점검한다. 기자재 완비를 확인하고, 개체식별카드와 동물실 사용기록지를 작성·부착한다. 사육실은 온도 22℃±3℃, 습도 30~70%를 유지하고, 조명은 명/암 12/12시간을 조절한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-W5-03",
      "processOrder": 3,
      "processName": "시험동물 선정 및 순화",
      "safetyMeasures": "8~12주령 시험용 랫드를 사용하며 개체 간 체중 차이는 평균체중의 ±20%를 넘지 않도록 한다. 암컷 사용을 원칙으로 하며 시험 시작 전 최소 5일 이상 실험실에서 순화시킨 건강한 동물 중 무작위 선정한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-W5-04",
      "processOrder": 4,
      "processName": "시험물질 준비",
      "safetyMeasures": "시험물질은 적당한 용매에 용해 또는 현탁시키며, 수용성 액을 우선 권장한다. 사용하는 용매는 사전에 독성 여부와 특성이 잘 알려진 것을 사용한다.",
      "requiredPPE": [],
      "sourceSection": "5.1.4",
      "relatedSR": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "WP-W5-05",
      "processOrder": 5,
      "processName": "시험물질 투여",
      "safetyMeasures": "경구 투여량은 최대 1㎖/100g(체중)을 넘지 않도록 한다(수용액은 2㎖/100g까지 허용). 1회 투여를 원칙으로 하며, 투여 전날 저녁부터 절식시키고 체중을 측정한다. 투여 후 3~4시간 후부터 먹이를 공급한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-W5-06",
      "processOrder": 6,
      "processName": "한계시험 수행",
      "safetyMeasures": "독성이 비교적 낮거나 무독성으로 예상되는 경우에만 수행한다. 2,000㎎/㎏을 6마리 대상(3마리씩 2단계)으로 투여한다. 사망(또는 빈사상태) 개체수에 따라 다음 단계를 결정한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-W5-07",
      "processOrder": 7,
      "processName": "본시험 수행 및 관찰",
      "safetyMeasures": "고정 용량(5, 50, 300, 2,000㎎/㎏) 중 선택하여 3마리씩 투여한다. 투여 후 30분 이내 1회 이상 관찰하고, 처음 4시간은 특별히 주의하여 관찰한다. 관찰기간은 14일이며, 피부·털·눈·점막·호흡계·순환계·신경계·행동유형을 관찰한다. 빈사 상태의 동물은 안락사 시킨다. 모든 관찰은 체계적으로 개체별 기록한다.",
      "requiredPPE": [],
      "sourceSection": "5.2.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-W5-08",
      "processOrder": 8,
      "processName": "결과 처리 및 보고서 작성",
      "safetyMeasures": "시험용량, 시험동물 수, 독성증상 동물 수, 치사동물 수, 독성발현 시간, 용량-독성반응 관계, 부검결과 등을 기록한다. 시험보고서에는 시험기관, 시험책임자, 시험동물, 시험물질, 시험용매, 시험조건, 시험결과를 포함한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    }
  ],
