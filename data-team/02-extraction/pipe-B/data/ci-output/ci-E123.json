  "checklistItems": [
    {
      "identifier": "CI-E123-001",
      "text": "일반 작업 환경에서는 SF6의 최대농도를 1000 μL/L보다 낮은 농도로 관리하도록 하고 있다(근무시간 풀타임(8H/일, 5일/주) 기준임).",
      "guideContext": "SF6 가스 보건과 안전 일반사항",
      "additionalDetail": "이는 독성 가스에 관한 기준이 아니라, 정상적인 근무상태에서 존재하지 않는 모든 무독성 가스에 대한 설치기준이다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-E123-002",
      "text": "결과적으로 공기 중에 가능한 한 산소량이 줄어들지 않도록 해야 한다.",
      "guideContext": "SF6 사용 시 산소 결핍 주의사항",
      "additionalDetail": "SF6 가스는 공기보다 5배 정도 무거우며, 작업 환경에 대량으로 노출되는 경우는 지지대 영역에 축적될 수 있다. 산소 농도는 16 %보다 아래로 떨어지면 모든 작업에게 질식의 위험으로 나타난다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3.2.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-E123-003",
      "text": "기 사용된 SF6를 인클로저로부터 제거할 때에 주의사항으로는 특히 작업장내 대기 중으로 가스의 방출을 막을 수 있는 대책이 있어야 한다.",
      "guideContext": "SF6 가스 취급 장치 운용",
      "additionalDetail": null,
      "workProcessPhase": "SF6 인클로저 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-E123-004",
      "text": "가스는 통상적으로 압력을 받고 있어 저장할 수 있도록 하려면 가스 회수장치를 사용해야 한다. 이러한 장치는 가능한 한 많은 가스제거가 요구되는 인클로저로부터 이를 처리할 수 있는 용량을 갖추어야 한다.",
      "guideContext": "SF6 가스 취급 장치 운용",
      "additionalDetail": null,
      "workProcessPhase": "SF6 인클로저 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-E123-005",
      "text": "가스 회수장치는 인클로지 차단기로 부터 예를 들어 더 심하게 오염된 SF6의 제거를 위해 우선적으로 적용하여야 한다.",
      "guideContext": "SF6 가스 취급 장치 운용",
      "additionalDetail": "가스 회수장치는 SF6를 처리하도록 특별하게 설계되었고, 가스 상태로 고체 분해 생성물을 제거할 재생설비와 함께 제공된다.",
      "workProcessPhase": "SF6 인클로저 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-E123-006",
      "text": "기사용 SF6 취급에 종사하는 작업자에게는 개인 안전장구(장갑, 보안경 등을 포함)를 제공하여야 하며, 제조업체의 지침과 사용자 코드는 장비의 항목에 기재된 각 요건에 따라 정하도록 한다.",
      "guideContext": "SF6 일반적인 안전 요구사항",
      "additionalDetail": null,
      "workProcessPhase": "기사용 SF6 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-E123-007",
      "text": "기사용 SF6를 처리하는 작업자는 SF6 분해 생성물의 속성을 잘 알고 있어야 하며, 보건(예: 접촉, 흡입 등)의 위험을 인식하고 이를 최소화하기 위해 주의를 기울여야 한다.",
      "guideContext": "SF6 일반적인 안전 요구사항",
      "additionalDetail": null,
      "workProcessPhase": "기사용 SF6 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-E123-008",
      "text": "기사용 SF6를 처리하는 작업자에게는 특별히 정한 안전교육을 실시하여야 한다. 이는 작업자가 유자격이거나 또는 사전에 어떤 자격훈련 과정을 이수했는지는 고려하지 않는다.",
      "guideContext": "SF6 작업자 교육",
      "additionalDetail": null,
      "workProcessPhase": "기사용 SF6 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.3.1",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-E123-009",
      "text": "작업자는 저장조에 인클로저로 부터 가스를 전송하는데 적용되는 SF6 취급장치의 운전에 대하여 교육을 받아야 하며, 이러한 제작업체의 운전지침은 장치를 사용할 때마다 준수하여야 한다.",
      "guideContext": "SF6 작업자 교육",
      "additionalDetail": null,
      "workProcessPhase": "SF6 취급장치 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.3.1",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-E123-010",
      "text": "응급처리에 관한 지침은 안전 교육에 포함되어야 한다.",
      "guideContext": "SF6 작업자 교육",
      "additionalDetail": null,
      "workProcessPhase": "기사용 SF6 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.3.1",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-E123-011",
      "text": "기사용 SF6가 잔류된 인클로저를 비우거나 개방되는 장소에는 작업자가 세척시설을 이용할 수 있는 설비를 갖추어야 한다.",
      "guideContext": "SF6 부대시설",
      "additionalDetail": null,
      "workProcessPhase": "기사용 SF6 인클로저 개방",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-E123-012",
      "text": "작업자가 야외에서 작업할 경우 인클로저에서 사용된 SF6를 제거하는 동안, 사전에 특별한 조치로 SF6의 누설을 방지하고 분해 생성물이 직접 노출되지 않도록 하는 것이 중요하다.",
      "guideContext": "SF6 부대시설 - 야외작업",
      "additionalDetail": null,
      "workProcessPhase": "옥외 SF6 제거 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-E123-013",
      "text": "옥외 작업시 특별한 주의 사항은 인클로지에서 사용된 SF6를 제거하는 동안 분해 생성물에 직접 노출되지 않도록 하고, SF6가 방출하지 않도록 하여야 한다.",
      "guideContext": "SF6 옥외 작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "옥외 SF6 제거 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3.3",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-E123-014",
      "text": "옥내 설비는 충분한 환기구와 함께 안전이 확보되어야 한다.",
      "guideContext": "SF6 옥내 작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "옥내 SF6 처리 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3.4",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-E123-015",
      "text": "기사용 SF6가 옥내에 설치되어 있는 인클로지로부터 제거할 경우에는 잠재적으로 독성 분해 생성물(예: HF, SO2, SOF2, SO2F2)의 농도는 작업 영역에서 안전한 수준으로 유지되어야 한다.",
      "guideContext": "SF6 옥내 작업 안전",
      "additionalDetail": "분해의 중간레벨에서 보면 이들 화합물의 안전수준은 한 구역내에서 SF6의 200 μL/L 최대 농도로 표시된다.",
      "workProcessPhase": "옥내 SF6 처리 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3.4",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-E123-016",
      "text": "사전 예고통지가 필요한 난로불, 흡연, 200 ℃ 이상의 고열과 특별한 예방조치 없이 하는 용접은 금지되고, SF6가 옥내에서 처리되는 동안에는 주어진 응급조치 안내표시가 있어야 한다.",
      "guideContext": "SF6 옥내 작업 안전",
      "additionalDetail": null,
      "workProcessPhase": "옥내 SF6 처리 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3.4",
      "basedOn": [
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "CI-E123-017",
      "text": "SF6 가스를 대기중에 누설을 최소화면서 제거할 수 있도록 가스회수장치를 사용하여야 하며, 이 장치는 사용된 SF6 회수를 위해 적용해야 하는 기술로서 일반적으로 진공 펌프, 필터 카트리지, 압축기, 가스흐름과 저장을 제어하는 부분으로 구성되어 있다.",
      "guideContext": "SF6 인클로저 제거 작업",
      "additionalDetail": null,
      "workProcessPhase": "SF6 인클로저 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-E123-018",
      "text": "현장에서 가스회수장치로 재생 처리할 수 없는 가스는 가스제조업체, 재생 회사 또는 폐기 운영자에게 이송해야 한다.",
      "guideContext": "SF6 인클로저 제거 작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SF6 인클로저 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E123-019",
      "text": "신규, 미사용 그리고 기 사용된 SF6의 저장 및 운송은 현장요건에 맞도록 제시된 관련규정에 따라 철저히 관리되어야 한다.",
      "guideContext": "SF6 보관 및 운송 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SF6 보관 및 운송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E123-020",
      "text": "이 실린더에는 특수 컬러 코딩된 것을 사용하여 신규 SF6와 기사용 SF6 취급시 혼선을 주지 않도록 하여야 한다.",
      "guideContext": "SF6 보관 및 운송",
      "additionalDetail": null,
      "workProcessPhase": "SF6 보관 및 운송",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.6",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-E123-021",
      "text": "신규 SF6와 함께 제공된 실린더는 신규 실린더로 분류하여 어떤 경우에도 기사용 SF6의 저장에는 사용하지 말아야 한다.",
      "guideContext": "SF6 보관 및 운송",
      "additionalDetail": null,
      "workProcessPhase": "SF6 보관 및 운송",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.6",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-E123-022",
      "text": "현장 분석 장치를 사용할 경우 장치 규격은 대기권내 SF6의 방출을 방지하고, 작업자의 보건과 안전을 확보하기 위해 가능한 한 적은 양을 사용하도록 요구하고 있다.",
      "guideContext": "SF6 가스 현장 분석",
      "additionalDetail": null,
      "workProcessPhase": "SF6 현장 분석",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-E123-023",
      "text": "모든 현장의 분석을 시행하는 작업자는 분석 장치의 정확도에 관해서는 장치 제작사의 지침에 따른다.",
      "guideContext": "SF6 가스 현장 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "SF6 현장 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E123-001",
      "term": "전기장치",
      "definition": "발전, 송전, 변전, 배전 또는 이와 같은 목적을 위해 사용하는 전기 기계기구와 전기 에너지의 이용을 위한 변압기, 보호 장치, 측정계기, 배선재료 및 용품 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-E123-002",
      "term": "인클로지",
      "definition": "직접접촉 또는 외부의 어떤 영향으로부터 장비를 보호하도록 밀폐구조의 용기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-003",
      "term": "유지관리",
      "definition": "감독의 조치를 포함하여 모든 기술 및 행정적인 조치에 따라 그 상태로 유지하거나 제 기능을 수행할 수 있는 상태로 복원하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-004",
      "term": "절연재료",
      "definition": "전기적인 전도도가 서로 다른 부분은 분리하는데 사용되는 무시할 정도로 낮은 전기도전율을 가진 재료를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-005",
      "term": "절연가스",
      "definition": "전기적인 전도도가 서로 다른 부분은 분리하는데 사용되는 무시할 정도로 낮은 전기도전율을 가진 가스를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-006",
      "term": "전극",
      "definition": "서로 다른 전도성의 접점으로 상호 의도된 역할을 수행하는 도체부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-007",
      "term": "신규 SF6",
      "definition": "한 번도 사용한 적이 없는 SF6를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-008",
      "term": "기사용 SF6",
      "definition": "전기장치에 기 충전된 SF6를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-009",
      "term": "미사용 SF6",
      "definition": "전기장치에 한번도 충전된 적이 없는 SF6를 말한다.(예: 가스저장 탱크로 이송)",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-010",
      "term": "재활용",
      "definition": "순환공정을 통해서 이전단계로 돌아가기 위한 변경이나 처리를 하기 위한 일련의 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E123-011",
