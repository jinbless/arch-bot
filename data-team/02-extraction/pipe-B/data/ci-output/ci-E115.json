  "checklistItems": [
    {
      "identifier": "CI-E115-001",
      "text": "다음의 작업을 수행할 경우에는 절연 안전모를 착용하여야 한다. (가) 충전부에 근접하여 머리에 전기적 충격을 받을 우려가 있는 장소 (나) 활선과 근접한 주상, 철구상, 사다리, 나무 벌체 등 고소작업의 경우 (다) 건설현장 등 낙하물이 있는 장소 (라) 기타 머리에 상해가 우려될 때",
      "guideContext": "절연 안전모의 사용범위",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.(4)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-002",
      "text": "절연 안전모 착용 전 다음 사항을 확인하여야 한다. ① 보호구 관리요령에 따라 정기점검을 받았는지 여부 ② 흙, 기름, 물기 등이 있는지 또는 건조한 지 여부 ③ 충격의 흔적이 있는지 여부 ④ 변색되거나 변형되었는지 여부 ⑤ 장착제, 충격 흡수재 등의 손상이나 더러움 여부",
      "guideContext": "절연 안전모 사용 시 주의사항 - 착용 전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-003",
      "text": "한번이라도 큰 충격을 받았으면 사용하지 않음",
      "guideContext": "절연 안전모 사용 시 주의사항 - 착용 시",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-004",
      "text": "다음과 같은 작업의 경우 절연 고무장갑을 착용하여 감전사고를 방지하여야 한다. (가) 활선상태의 배전용 지지물에 누설전류의 발생 우려가 있을 때 (나) 충전부의 접속, 절단 및 점검, 보수 등의 작업 시 (다) 습기가 많은 장소에서의 개폐기 개방, 투입의 경우 (라) 정전 작업 시 역 송전이 우려되는 선로나 기기에 단락접지를 하는 경우 (마) 도체에 임시로 보호접지를 실시하거나 이동시 또는 활선공구 사용 시 (바) 기타 감전이 우려되는 경우",
      "guideContext": "절연 고무장갑의 사용범위",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(4)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-005",
      "text": "B종 및 C종의 절연 고무장갑을 사용할 때는 고무장갑을 보호하기 위한 가죽장갑을 바깥쪽에 착용하여야 한다",
      "guideContext": "절연 고무장갑 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-006",
      "text": "규정된 전기적 시험에 통과하더라도 물리적 특성이 나쁘면 사용하지 못하므로 검사를 자주해야 한다",
      "guideContext": "절연 고무장갑 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-007",
      "text": "절연 고무장갑의 일상점검은 책임자의 감독 하에 실시한다",
      "guideContext": "절연 고무장갑 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-008",
      "text": "활선작업자가 승주하기 전에 공기테스트를 하는 것이 좋다",
      "guideContext": "절연 고무장갑 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-E115-009",
      "text": "절연 고무장갑은 절대로 안팎을 뒤집은 채 사용하면 안 된다",
      "guideContext": "절연 고무장갑 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-010",
      "text": "절연 고무장갑이 젖어 있거나 더러워진 상태로 방치해서는 안 된다. 불가피해서 이런 상태로 임시로 두더라도 반드시 깨끗이 닦고 건조시켜야 하며, 기름이나 그리스가 묻어 있으면 즉시 닦아낸다",
      "guideContext": "절연 고무장갑 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-011",
      "text": "열, 햇빛, 기름, 변형 등은 고무재질에는 치명적이므로 이러한 요인이 영향을 주지 않도록 최대한 보호해야 한다",
      "guideContext": "절연 고무장갑 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(5)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-012",
      "text": "창고에 보관하는 고무장갑은 열, 햇빛, 습도 등에 의해 절연열화 현상이 발생하므로, 보관 시 다음과 같이 주의하여야 한다. ① 가능한 서늘하고 어두운 장소에 한 켤레씩 박스에 넣어 보관한다 ② 햇빛이 직사되는 장소(창 가까운 곳)는 피해야 한다 ③ 열이나 더운 공기가 직접 닿는 증기 배관이나 라디에이터 근처 등에 보관하지 않아야 한다 ④ 코로나 방전이나 불꽃방전을 일으키는 전기실험실에 보관해서는 안 된다 ⑤ 안팎이 뒤집힌 채로 보관해서는 안 된다 ⑥ 보관 시 습기나 땀 등으로 인해 고무가 끈적거리는 것을 방지하기 위하여 절연고무장갑 안쪽에 탤크(Talc)분을 발라둔다",
      "guideContext": "절연 고무장갑 보관 시 주의사항 - 창고 보관 (법령 근거 미확인)",
      "additionalDetail": "오존 발생 장소 보관 금지는 산화 촉진 방지 목적",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(6)",
      "basedOn": null
    },
    {
      "identifier": "CI-E115-013",
      "text": "트럭에 보관되는 고무장갑은 다음과 같이 주의하여야 한다. ① 절연 고무장갑은 장갑백에 보관하고 가급적 걸어놓는다 ② 공구백이나 박스 안에 보관할 때는 그 위에 다른 것을 쌓아 찌그러지게 해서는 안 된다 ③ 고온은 장갑표면을 끈적거리게 하고 서로 달라붙게 하므로 열이 발생하는 장소의 근처에 두어서는 안 된다 ④ 고무는 변압기 기름이나 석유화학 제품, 억제제 등과 접촉되면 팽창되어 내구성이 감소하므로 이들과 접촉되지 않도록 한다 ⑤ 절연 고무장갑을 밟거나, 접거나 또는 묶지 말아야 한다",
      "guideContext": "절연 고무장갑 보관 시 주의사항 - 트럭 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.(6)",
      "basedOn": null
    },
    {
      "identifier": "CI-E115-014",
      "text": "절연 고무장갑은 사용하기 전에 육안검사와 공기 주입검사를 해야 한다",
      "guideContext": "절연 고무장갑 사용 중 검사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(7)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-015",
      "text": "절연 고무장갑의 검사는 최소 6개월에 1회 이상 정기적으로 수행해야 한다",
      "guideContext": "절연 고무장갑 현장검사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(8)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-016",
      "text": "현장에서의 검사는 절연 고무장갑을 깨끗하고 건조한 곳으로 옮겨 시행한 후, 결함이 있는 것은 \"결함\"의 꼬리표를 붙이거나 적당히 표기하여 더 이상 사용하지 못하게 한다",
      "guideContext": "절연 고무장갑 현장검사",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.(8)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-017",
      "text": "직류 750 V, 교류 600 V 이하의 저압전기를 취급하는 작업자는 감전방지를 위하여 절연화를 착용하여야 한다",
      "guideContext": "절연화의 사용범위 및 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1.(4)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-018",
      "text": "절연화는 발가락을 보호하기 위한 선심을 제외하고는 절연화 어느 부분에도 도전성 재료가 사용되어서는 안 된다",
      "guideContext": "절연화의 사용범위 및 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1.(4)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-019",
      "text": "절연화는 표면에 절연성능을 저하시킬 수 있는 기포나 흠, 눈에 보이지 않는 구멍, 이물질의 혼입 및 기타 사용상 결함이 없어야 한다",
      "guideContext": "절연화의 사용범위 및 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1.(4)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-020",
      "text": "직류 750 V 또는 교류 600 V를 넘고 7,000 V 이하인 고압전기를 취급하는 작업자는 감전방지를 위하여 절연장화를 착용하여야 한다",
      "guideContext": "절연장화의 사용범위 및 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2.(3)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-021",
      "text": "절연장화에는 금속이나 도전성이 뛰어난 재료를 사용해서는 안 된다",
      "guideContext": "절연장화의 사용범위 및 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.(3)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-022",
      "text": "절연장화의 모든 접합부분은 접착이 완전하고 물이 새지 않는 구조이어야 하며 내면에 면 등을 부착해서는 안 된다",
      "guideContext": "절연장화의 사용범위 및 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.(3)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E115-023",
      "text": "절연복은 표면 및 내면에 갈라짐, 구멍, 찢어짐 등 유해한 부분이 없어야 한다",
      "guideContext": "절연복의 사용 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.(3)",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E115-001",
      "term": "활선작업",
      "definition": "노출된 도체나 기기 등을 작업자의 보호구 착용 여부와 관계없이 손·발 또는 신체의 기타 부분으로 만지거나 시험기기로 접촉하는 작업을 말한다",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E115-002",
      "term": "활선근접작업",
      "definition": "전기적으로 안전하지 않은 노출된 충전도체 또는 기기 등의 접근한계 내에서 수행하는 작업을 말한다",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E115-003",
      "term": "절연 보호구",
      "definition": "활선작업 또는 활선근접작업에서 감전을 방지하기 위하여 작업자가 신체에 착용하는 절연 안전모, 절연 고무장갑, 절연화, 절연장화, 절연복 등을 말한다",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E115-01",
      "processOrder": 1,
      "processName": "절연 고무장갑 육안검사",
      "safetyMeasures": "검사를 하기 전에 먼지 등을 깨끗이 씻어야 한다. ① 절연 고무장갑의 손목 윗부분(커프)을 잡은 후 한쪽 손을 장갑 안쪽으로 넣어 뒤집는다 ② 절연 고무장갑을 아래로 향하게 하여 커프를 잡은 후 몸 쪽으로 회전시킨다 ③ 말아 올린 커프를 U자 모양으로 눌러 장갑 안쪽으로 들어간 공기가 빠져 나오지 못하게 하고, 팽창된 장갑의 손가락 부분이 뒤어나오게 한 후 손상 유무를 검사한다",
      "requiredPPE": [],
      "sourceSection": "5.(7)",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "WP-E115-02",
      "processOrder": 2,
      "processName": "절연 고무장갑 공기주입검사",
