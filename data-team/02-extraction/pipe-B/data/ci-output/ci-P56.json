  "checklistItems": [
    {
      "identifier": "CI-P56-001",
      "text": "발포플라스틱 및 발포플라스틱을 사용한 제품은 그 생산 및 사용 장소와 보관 장소를 따로 분리해서 설치해야 한다.",
      "guideContext": "발포플라스틱 보관 화재 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 장소 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-002",
      "text": "별도의 보관용 건물은 작업장으로부터의 대피 및 피난을 방해하지 않는 장소에 배치되어야 한다.",
      "guideContext": "발포플라스틱 보관 화재 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 장소 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-003",
      "text": "발포플라스틱은 화재 발생 시, 열기 및 연기가 작업장에 영향을 가장 덜 미치는 장소에 보관해야 한다.",
      "guideContext": "발포플라스틱 보관 화재 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 장소 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-004",
      "text": "발포플라스틱을 솔벤트나 접착제와 같은 인화성 물질과 함께 보관해서는 안 된다. 이는 보관 장소의 내화구조와 관계없이 적용되어야 한다.",
      "guideContext": "발포플라스틱 보관 화재 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-005",
      "text": "발포플라스틱의 부스러기, 천 조각, 포장재 자투리 등과 같이 포장되지 않은 채 널려 있는 재료들은 화재의 위험성이 특히 높으므로 자루나 용기에 밀폐시켜 보관해야 한다.",
      "guideContext": "발포플라스틱 보관 화재 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-006",
      "text": "건물의 방화구획이 유지될 수 있도록 발포플라스틱을 운반하는 승강기는 연기를 차단하는 장치가 설치되어 있어야 한다.",
      "guideContext": "발포플라스틱 보관시설 신축 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-007",
      "text": "컨베이어나 활송장치(chute)로 발포플라스틱을 운반하는 경우, 각 층의 개구부는 연기를 차단하는 셔터가 설치되어야 한다.",
      "guideContext": "발포플라스틱 보관시설 신축 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-008",
      "text": "통행을 위한 칸막이벽의 개구부는 방화문으로 설치되어야 한다.",
      "guideContext": "발포플라스틱 보관시설 신축 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-009",
      "text": "내화구조의 벽체는 벽돌이나 콘크리트블록을 사용하는 것이 바람직하다. 공장의 경우, 벽돌이나 콘크리트블록은 내화성능을 지하시킬 수 있는 손상에 강하며 비교적 저렴한 비용으로 우수한 내화성능을 갖출 수 있다.",
      "guideContext": "발포플라스틱 보관시설 신축",
      "additionalDetail": null,
      "workProcessPhase": "보관시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-010",
      "text": "건설 현장과 같이 사용할 발포플라스틱을 임시로 보관하는 경우, 아외에 보관하는 것이 바람직하며 건물의 출입구나 화기로부터 멀리 위치시켜야 한다.",
      "guideContext": "발포플라스틱 임시저장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임시저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-011",
      "text": "상부 뚜껑이 없는 보관함은 고의적인 방화의 위험을 고려해야 한다.",
      "guideContext": "발포플라스틱 임시저장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임시저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-012",
      "text": "화물용 컨테이너와 같이 완전히 밀폐할 수 있는 별도의 금속 용기가 임시지장을 위해 가장 바람직하다.",
      "guideContext": "발포플라스틱 임시저장",
      "additionalDetail": null,
      "workProcessPhase": "임시저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-013",
      "text": "대량의 발포플라스틱을 임시로 건물 내부에 보관해야 할 경우, 이를 위해 별도의 방이 있어야 하며 발포플라스틱을 운반할 때를 제외하고는 항시 잠금 상태를 유지해야 한다.",
      "guideContext": "발포플라스틱 임시저장 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "임시저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-014",
      "text": "발포플라스틱의 보관 장소가 다른 용도의 공간으로 가기 위한 통로로 사용되어서는 안 된다.",
      "guideContext": "발포플라스틱 보관 장소 접근 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-015",
      "text": "발포플라스틱의 보관 장소가 피난이나 대피를 위한 통로로 사용되어서는 안 된다.",
      "guideContext": "발포플라스틱 보관 장소 접근 통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-016",
      "text": "발포플라스틱의 보관 장소에 출입하는 인원이 최소한도로 유지되는 것이 바람직하다.",
      "guideContext": "발포플라스틱 보관 장소 접근 통제",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-017",
      "text": "포장하지 않은 발포플라스틱을 쌓아 올려 보관할 경우, 안정적으로 적재해야 한다. 작은 조각은 선반에 보관할 수 있다.",
      "guideContext": "발포플라스틱 보관시설 내 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-018",
      "text": "보관시설 내 통로는 80 cm 이상이어야 한다.",
      "guideContext": "발포플라스틱 보관시설 내 관리 (법령 근거 미확인)",
      "additionalDetail": "수치는 Safe use and storage of cellular plastics, HSE, 1996에서 인용",
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-019",
      "text": "통로의 확보를 위해 바닥에 통로표시를 해 두는 것이 바람직하다.",
      "guideContext": "발포플라스틱 보관시설 내 관리",
      "additionalDetail": null,
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-020",
      "text": "통로에 막다른 골목이 생기지 않도록 보관 위치를 정해야 한다. 끝이 막힌 통로는 한 방향으로만 대피가 가능하기 때문에 위험성이 증가한다.",
      "guideContext": "발포플라스틱 보관시설 내 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-021",
      "text": "발포플라스틱을 쌓아 올린 맨 윗부분과 천장, 연기감지기 또는 조명과는 최소 1 m의 간격을 유지해야 한다. 특히, 스프링클러가 설치된 지점에서는 반드시 이 간격을 유지해야 한다.",
      "guideContext": "발포플라스틱 보관시설 내 관리 (법령 근거 미확인)",
      "additionalDetail": "수치는 Safe use and storage of cellular plastics, HSE, 1996에서 인용",
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-022",
      "text": "백열등에 보호덮개가 설치되어 있지 않으면, 발포플라스틱을 쌓아 올린 더미가 백열등의 아래에 위치해서는 안 된다.",
      "guideContext": "발포플라스틱 보관시설 내 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-023",
      "text": "발포플라스틱을 쌓아 올린 더미가 증기난방용 배관이나 전기 배선을 보호하기 위한 벽이나 기둥을 막도록 해서는 안 된다.",
      "guideContext": "발포플라스틱 보관시설 내 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-024",
      "text": "보관시설로 반입한 발포플라스틱의 자투리는 통 또는 자루에 넣어 별도의 장소에 보관하는 것이 바람직하다.",
      "guideContext": "발포플라스틱 보관시설 내 관리",
      "additionalDetail": null,
      "workProcessPhase": "적재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-025",
      "text": "다른 시설이 있는 건물에 발포플라스틱의 보관시설을 설치할 경우, 내화구조의 칸막이벽으로 다른 시설과 분리되어야 한다.",
      "guideContext": "타 시설 건물 내 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-026",
      "text": "보관시설의 출입문은 최소 30분 이상의 방화 성능을 갖추어야 하며, 자동으로 닫혀야 한다.",
      "guideContext": "타 시설 건물 내 보관 (법령 근거 미확인)",
      "additionalDetail": "수치는 Safe use and storage of cellular plastics, HSE, 1996에서 인용",
      "workProcessPhase": "보관시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-027",
      "text": "발포플라스틱의 보관시설이 숙박이나 주거시설을 포함하는 건물 또는 여러 회사가 입주한 건물에 위치하는 것은 바람직하지 않다.",
      "guideContext": "타 시설 건물 내 보관",
      "additionalDetail": null,
      "workProcessPhase": "보관 장소 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-028",
      "text": "발포플라스틱의 보관시설이 다층 건물에 위치할 경우, 최상층부에 위치하는 것이 바람직하다.",
      "guideContext": "타 시설 건물 내 보관",
      "additionalDetail": null,
      "workProcessPhase": "보관 장소 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-029",
      "text": "불가피하게 발포플라스틱의 보관시설이 다층 건물에서 어떤 층의 아래에 위치할 경우, 화재경보기와 연결된 자동 화재탐지설비 및 스프링클러의 설치를 고려해야 한다.",
      "guideContext": "타 시설 건물 내 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-030",
      "text": "발포플라스틱의 보관시설이 지하실에 위치하는 것은 반드시 피해야 한다.",
      "guideContext": "타 시설 건물 내 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 장소 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-031",
      "text": "노출된 불씨는 발화의 잠재적 원인이며 따라서 보관시설에서 불씨가 생겨나지 않도록 해야 한다.",
      "guideContext": "발화 원인 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-032",
      "text": "발포플라스틱의 생산, 사용, 보관을 하는 장소에서의 흡연은 엄격히 통제되어야 한다.",
      "guideContext": "흡연 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-033",
      "text": "흡연금지가 불가능할 경우, 발포플라스틱의 작업장 및 보관시설에서는 흡연을 금지하고 지정된 안전한 장소에서만 흡연을 해야 한다. 이 경우, 흡연장소에는 적절한 재떨이와 소화기를 비치한다.",
      "guideContext": "흡연 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-034",
      "text": "흡연이 금지된 장소에는 \"흡연금지\"라는 경고표지를 부착한다.",
      "guideContext": "흡연 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-035",
      "text": "고체연료, 가스, 기름을 연소하는 가열기 부분은 안전한 장소에 위치해야 한다.",
      "guideContext": "난방 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-036",
      "text": "가스나 기름을 연료로 사용하는 휴대형 또는 이동 가능한 전열기구는 사용할 수 없다.",
      "guideContext": "난방 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-037",
      "text": "모든 전기 기구에는 과전류 차단장치가 부착되어야 한다.",
      "guideContext": "전기기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-038",
      "text": "가능한 한 전기기구는 완전히 밀폐되어 있어야 하며, 분진 또는 부스러기에 열이 전달되지 않도록 항상 청결한 상태를 유지해야 한다.",
      "guideContext": "전기기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-039",
      "text": "백열전구는 적절한 보호덮개가 씌워져 있어야 한다.",
      "guideContext": "전기기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-040",
      "text": "전기 기구의 내부 또는 표면의 온도가 150 ℃를 넘는 경우, 분진 또는 부스러기가 이곳에 접촉하지 않도록 해야 한다.",
      "guideContext": "전기기구 관리 (법령 근거 미확인)",
      "additionalDetail": "수치는 Safe use and storage of cellular plastics, HSE, 1996에서 인용",
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-041",
      "text": "대부분의 발포플라스틱은 단열성능이 뛰어나므로 전기기구에 밀착되면 발화의 가능성이 높으므로 이에 유의해야 한다.",
      "guideContext": "전기기구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-042",
      "text": "정전기로 인해 발생할 수 있는 스파크는 발화의 원인이 되므로 적절한 접지를 통해 스파크의 발생을 예방해야 한다.",
      "guideContext": "전기기구 관리 - 정전기 방지",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P56-043",
      "text": "효과적인 접지가 불가능할 경우, 정전기 제거장치를 사용해야 한다.",
      "guideContext": "전기기구 관리 - 정전기 방지",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-P56-044",
      "text": "발포플라스틱의 보관시설에서는 전용 운송기기를 사용해야 한다.",
      "guideContext": "운송기기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운송 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-045",
      "text": "다른 지점으로 가기 위해 운송기기가 발포플라스틱의 보관시설을 통과해서는 안 된다.",
      "guideContext": "운송기기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운송 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-046",
      "text": "내연기관에 의해 작동되는 운송기기는 특별한 처리가 없는 경우, 엔진의 고온 부위나 배기가스에 의해 발포플라스틱이 발화될 수 있으므로 운행을 하지 않도록 하고 전기로 작동하는 운송기기를 사용하거나 또는 인력작업에 의하는 것이 바람직하다.",
      "guideContext": "운송기기 관리",
      "additionalDetail": null,
      "workProcessPhase": "운송 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-047",
      "text": "배터리를 동력으로 사용하는 운송기기의 경우, 배터리의 충전이 발포플라스틱의 보관시설에서 이루어져서는 안 된다.",
      "guideContext": "운송기기 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운송 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-048",
      "text": "인화성 물질은 필요시를 제외하고는 발포플라스틱으로부터 분리하여 보관되어야 한다.",
      "guideContext": "인화성 물질 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P56-049",
      "text": "인화성 물질을 사용하거나 보관하는 장소에서의 흡연은 엄격히 금지되어야 한다.",
      "guideContext": "인화성 물질 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "화재 예방 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P56-001",
      "term": "발포플라스틱",
      "definition": "발포제를 혼합한 후, 발포시켜 세밀한 기포상태의 구조를 지니게 되는 플라스틱을 말한다. 발포플라스틱의 예로는 스펀지, 스티로폼, 우레탄폼 등이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P56-002",
      "term": "발포제",
      "definition": "단독 또는 다른 물질과 조합으로 플라스틱 및 고무 내 다공질 구조(Cellular)를 유도하는 첨가제를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P56-003",
      "term": "인화성 물질",
      "definition": "대기압 하에서 인화점이 섭씨 65도 이하인 가연성 액체를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P56-004",
      "term": "내화구조",
      "definition": "벽, 기둥, 마루, 지붕 등의 구조부재가 불연성 또는 준불연성 재료로 시공되고 NFPA(National Fire Protection Association) 220: Standard on Types of Building Construction에 규정된 등급 이상의 내화성능을 갖춘 구조를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P56-005",
      "term": "방화문",
      "definition": "화염의 확산을 막을 수 있는 성능을 가진 문을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
