  "checklistItems": [
    {
      "identifier": "CI-CC71-001",
      "text": "사고조사는 가능한 한 빠른 시간 내에 착수한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-002",
      "text": "사고현장에 도착 후 사고 장소에 대한 기록, 측정, 그림, 사진 및 영상촬영 증거물과 관련자와의 면담 등을 통하여 사고와 관련된 기인물을 규명한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-003",
      "text": "사고와 설비의 관련이 있을 경우 해당설비의 규격 및 특성등에 관한 자료를 수집하고 결함이 발생하게된 설계상의 문제, 유지관리상의 문제등을 규명한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-004",
      "text": "사고의 내용이 화학물질과 관련이 있을 경우 해당물질에 대한 MSDS를 확보하고 유해위험성을 검토하고 취급조건과 공정조건을 파악하여 사고로 이르게 된 과정을 규명한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-005",
      "text": "사고와 관련된 공정, 작업에 대한 내부 운전절차(SOP) 또는 기준이 있을 경우 이를 확보하고 절차내용의 적정성, 실행내용의 적성성을 검토한다. 관련 절차나 기준이 없을 경우 해당 절차 제정의 필요성을 검토한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-006",
      "text": "사고와 관련하여 수집된 증거 및 면담결과를 토대로 사건의 발생시간부터 종결시간까지의 관련된 모든 기인물 및 시간대별 상황변화에 따른 사고의 발생과정 등을 파악한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-007",
      "text": "사고조사 전반에 걸쳐 '무엇이', '어떻게', '왜' 발생하였는지를 계속 파악하고 규명한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-008",
      "text": "조사내용은 책임소재의 규명보다는 사고의 재발방지를 위한 기능 및 관리적 결함의 규명에 초점을 맞추어 진행한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-009",
      "text": "기술적인 원인과 인적 원인에 대하여 충분히 파악한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-010",
      "text": "사고내용이 충분히 파악되었거나 추가적인 자료수집이 불가능하다고 판단될 때까지 자료를 수집한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자료수집 및 사고개요 파악",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-011",
      "text": "사고와 관련된 기인물 및 시간별 진행상황을 순차적으로 기록한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 진행내용 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-012",
      "text": "기인물별 진행상황을 보다 세부적으로 조사하여 기인물별 연관성을 체계적으로 파악할 필요가 있을 경우 다음 <표 1>의 양식에 따라 사고 흐름도를 작성한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 진행내용 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-013",
      "text": "기인물의 상태를 파악함에 있어 기인물이 시작하여 종료되는 과정에서 중간에 내용이 단절되거나 모호한 상태로 방치되지 않도록 충분히 현장상황이 파악되어야 한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 진행내용 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-014",
      "text": "기인물 또는 사건의 내용이 각각의 사상이 발생할 수 있는 충분한 사유가 되는지 확인하여 타당성이 부족한 경우 다른 기인물이나 사건을 파악하여야 한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 진행내용 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-015",
      "text": "사고흐름도를 검토하여 내용상 기인물간의 연결이 타당하지 않거나 기인물의 시간대별 상태파악에 있어 단절 및 의문점이 발생할 경우 사건 전개내용을 재검토하거나 추가 조사를 통하여 내용을 정정하거나 정정하기 어려울 경우 사유를 보고서에 명시한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 진행내용 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-016",
      "text": "사고흐름도로 각 시간대별로 관련된 기인물간의 관계 및 각각의 사건별 원인을 파악한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 진행내용 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-017",
      "text": "사고발생 공정이나 작업에 대한 위험과 운전분석(HAZOP), 결함수 분석(FTA), 작업자 신뢰성 분석(HRA) 등의 위험성 평가자료가 있을 경우 이를 참조하여 사고원인인을 분석한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 진행내용 기록",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-018",
      "text": "계속해서 각 사건에 대하여 더 이상 분석할 수 없는 세부적이고 구체적인 마지막 하위 단계의 근본적인 사고원인을 규명한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고원인 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-019",
      "text": "작업자 실수로 인한 사고발생시 왜 그러한 실수가 발생하였는지 구체적인 관리적, 인간공학적 결함사항이 파악되어야 한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": "작업절차 복잡성, 밸브 표시 명확성, 교육 충분성 등을 확인",
      "workProcessPhase": "사고원인 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-020",
      "text": "한 사건에 대하여 여러 가지의 원인이 발생하는 경우 이를 모두 규명하여야 한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고원인 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-021",
      "text": "사고원인 흐름도를 응용할 경우 사고근본원인의 항목은 왜 사고가 발생하는지에 따라 관리적으로 개선 가능한 것을 추적하여야 하며 '작업자 부주의'와 같은 구체적으로 개선하기 어렵거나 책임 전가성 항목은 사고의 근본원인으로 채택하지 않는다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고원인 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-022",
      "text": "사고조사 후 도출된 각각의 사고원인들에 대해 사고 가능성 및 예상 피해를 감소시키기 위하여 개선이 필요한 사항들을 파악하고 이를 검토한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개선조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-023",
      "text": "개선조치사항은 구체적이고 명료해야 한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개선조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-024",
      "text": "개선조치사항들에 대한 효율적인 수행 방법을 검토한 후 담당부서를 지정하여 개선조치들이 시행되도록 한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개선조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC71-025",
      "text": "개선조치사항은 사고발생설비 뿐만 아니라 동일한 사고원인이 잠재한 유사 공정 및 작업에도 반영하여야 한다.",
      "guideContext": "사고의 근본원인 분석(RCA) (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개선조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC71-001",
      "term": "사고(Accident)",
      "definition": "사망, 질병, 상해, 기타 손실을 야기하는 예상치 못한 사건과 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC71-002",
      "term": "사건(Incident)",
      "definition": "사고로 이어질 가능성이 있는 원하지 않는 사상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC71-003",
      "term": "사고원인(Cause)",
      "definition": "직접 혹은 간접적으로 사고를 유발한 사건, 상황 또는 조건을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC71-004",
      "term": "사고의 근본원인(Root cause)",
      "definition": "부적절한 설계, 훈련 또는 설비변경 등에 의하여 사고로 이어지는 단서를 제공하는 가장 기초적인 조건이나 요인을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC71-005",
      "term": "기인물(Agent)",
      "definition": "사고와 관련된 물건 또는 사람을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC71-006",
      "term": "사상(Event)",
      "definition": "계획된 작업 또는 공정에 있어 기인물의 작용에 의하여 원하지 않는 동작 및 상황이 발생하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-CC71-01",
      "processOrder": 1,
      "processName": "기인물 파악 및 자료수집",
      "safetyMeasures": "사고조사는 가능한 한 빠른 시간 내에 착수하며, 사고 장소에 대한 기록, 측정, 그림, 사진 및 영상촬영 증거물과 관련자와의 면담 등을 통하여 기인물을 규명한다. 설비 관련 시 규격·특성 자료 수집, 화학물질 관련 시 MSDS 확보, 관련 SOP 확보 및 적정성 검토를 실시한다.",
