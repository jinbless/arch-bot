  "checklistItems": [
    {
      "identifier": "CI-P39-001",
      "text": "원료, 생산품 및 운전과 관련된 정보를 인식하고, 대응할 수 있도록 하여야 한다.",
      "guideContext": "비상대응 계획 기본 원리",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P39-002",
      "text": "환경, 직원 및 공공의 보건 및 안전을 보호하는 방법으로 원료와 제품을 처리하고, 공장과 설비를 운전할 수 있도록 하여야 한다.",
      "guideContext": "비상대응 계획 기본 원리",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-003",
      "text": "새로운 제품 및 공정의 계획과 개발에서는 안전, 보건 및 환경을 고려하여 우선순위를 확립할 수 있도록 하여야 한다.",
      "guideContext": "비상대응 계획 기본 원리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-004",
      "text": "관련 임원, 직원, 고객 및 대중에게 안전, 보건 및 환경 위험성의 정보를 즉시 알리고, 보호방법을 권장하도록 하여야 한다.",
      "guideContext": "비상대응 계획 기본 원리",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 계획 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P39-005",
      "text": "위험물질의 처리 및 제거과정에서 일어날 수 있는 문제를 해결할 수 있는 사람과 작업하도록 하여야 한다.",
      "guideContext": "비상대응 계획 기본 원리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-006",
      "text": "누출된 물질은 다른 곳에 저장하여야 하고, 본래의 지장용기는 교체하거나 수리하여야 하고, 물질이 누출되지 않았을 경우에는 응력지점에 대해 추후 결합이 발생될 지 여부를 검사하여야 한다.",
      "guideContext": "위험물질 운송사고 대응",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 절차",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-007",
      "text": "위험물질을 운송하여 공급하는 기업은 24시간 연결이 가능한 비상대응 전화번호를 제공하여야 한다.",
      "guideContext": "비상대응 의사소통 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-008",
      "text": "비상대응 전화는 운송된 위험물질의 특성을 잘 알고 있는 사람, 물질에 대한 포괄적 비상대응과 사고완화에 대한 정보를 가지고 있는 사람 또는 그 정보를 알고 있는 사람과 즉각적인 접근이 가능한 사람들에 의해 항상 모니터링 되어야 한다.",
      "guideContext": "비상대응 의사소통 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-009",
      "text": "24시간 연결이 가능한 전화번호는 선적 서류에도 나타나 있어야 한다.",
      "guideContext": "비상대응 의사소통 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-010",
      "text": "위험물질의 특성과 사고 시 비상대응 절차 등 비상대응에 관한 정보는 운송 중에 있는 운송차량과 위험물질을 선적 및 저장하는 설비 등에 비치하여야 한다.",
      "guideContext": "비상대응 의사소통",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P39-011",
      "text": "비상대응 계획을 수립하는 기업은 직원들에게 기업의 생산품을 다루는데 필요한 적절한 기술과 안전절차를 교육시킬 책임이 있다.",
      "guideContext": "비상대응 직원 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-012",
      "text": "협력업체의 운전기사를 포함하여 위험물질을 운송하는 차량의 운전기사는 위험물질의 특성과 물질의 비상대응 절차에 대해 능숙해야 하며, 최소한 3년에 한 번의 반복적인 교육을 받아야 한다.",
      "guideContext": "비상대응 직원 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-013",
      "text": "운전기사는 새로운 위험물질을 운반하기 전에 위험인식 교육을 받아야 한다.",
      "guideContext": "비상대응 직원 교육",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-P39-014",
      "text": "비상대응 교육자는 학문적인 자격이나 전문적인 자격증을 갖추고, 훈련이나 경험을 통해 교육자격이 충분한 자이어야 한다.",
      "guideContext": "비상대응 직원 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-015",
      "text": "비상대응 교육자는 탱크로리, 운반용기의 설계, 내용물 제거방법, 저장방법, 개인보호구, 위험물질의 다양한 성질, 위험물질 및 유출과 관련된 법과 규칙 등을 잘 알고 있어야 한다.",
      "guideContext": "비상대응 직원 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-016",
      "text": "비상대응 활동에 참가하여 추가적인 교육을 받거나 선정된 직원은 기술적 절차에 따라 적절하게 교육을 받아야 될 뿐만 아니라 비상사태에 대한 기업의 방침과 절차에 완전하게 익숙해져 있어야 한다.",
      "guideContext": "비상대응 직원 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-017",
      "text": "협력업체의 운송직원은 비상 대응자의 요구사항을 만족시킬 수 있는 서류와 자격사항이 있어야 한다.",
      "guideContext": "비상대응 협력업체 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-018",
      "text": "협력업체는 운송 비상 초기대응자 역할로 간주할 수 있는 입증된 기록을 구비하여야 하며, 고객이 만족하는 보상을 할 수 있어야 한다.",
      "guideContext": "비상대응 협력업체 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-019",
      "text": "협력업체의 활동은 잘 훈련되고 지식이 풍부한 직원에 의해 감시되어야 한다.",
      "guideContext": "비상대응 협력업체 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-020",
      "text": "연락처와 예비 대응자는 정확도와 대응 능력에 대해 주기적으로 확인하여야 한다.",
      "guideContext": "비상대응 협력업체 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-021",
      "text": "비상 설비와 서비스의 유용성과 준비는 지체를 최소화하여야 한다.",
      "guideContext": "비상대응 설비 일반사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-022",
      "text": "모든 장비는 설계와 기능면에서 조화를 이루어야 하고, 위험물질의 화학적 성질에 대한 저항력이 있어야 한다.",
      "guideContext": "비상대응 설비 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-023",
      "text": "장비와 직원에 대한 오염물질을 제거하는 계획이 수립되어야 하고, 물질에 따라 사고현장을 떠나기에 앞서 오염물질을 제거하여야 한다.",
      "guideContext": "비상대응 설비 일반사항",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P39-024",
      "text": "비상계획은 보호장비와 복장의 착용 및 개인보호구를 사용할 직원에 대한 교육 프로그램에 대해 명확하게 작성된 방침을 포함하고 있어야 한다.",
      "guideContext": "비상대응 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-P39-025",
      "text": "보호장비와 복장은 위험물질의 특정 성질이 잘 알려지지 않았을 때 특히 중요하며, 머리와 몸을 보호하는 보호장비와 복장, 호흡을 보호하는 장비, 불침투성의 신발과 장갑 등은 기체, 액체 및 고체가 피부와 접촉하거나 호흡기를 통과하는 것을 막을 수 있어야 한다.",
      "guideContext": "비상대응 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P39-026",
      "text": "보호복은 위험하다고 예상되는 물질에 대한 저항력을 가지고 있어야 하고, 위험성으로부터 신체의 민감한 부분을 보호해야 한다.",
      "guideContext": "비상대응 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P39-027",
      "text": "보호복과 장비의 선택 및 사용은 어떤 위험물질에 대응자가 노출되는 것과 위험물질 정체의 불확실성에 따라 다르므로, 물질의 모든 위험성을 파악할 때까지는 최악의 상황이 발생할 가능성을 고려하여야 한다.",
      "guideContext": "비상대응 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P39-028",
      "text": "대응 초기상태 동안을 제외하고, 존재하는 불확실성에 대한 빠른 조치가 요구될 때에는 비상상황의 잠재적 위험성에 맞추어 보호복과 장비를 사용하여야 한다.",
      "guideContext": "비상대응 개인보호구",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-P39-029",
      "text": "고속도로 비상대응팀과 함께 운송업체와 운송인은 비상대응에 전적으로 사용할 수 있고, 제품운송에 적합한 도구와 장비에 접근할 수 있어야 한다.",
      "guideContext": "비상대응 특수설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-030",
      "text": "외부 협력업체를 활용하는 경우에는 협력업체 직원과 장비의 능력, 대응시간 및 대응경험을 미리 평가하여야 한다.",
      "guideContext": "비상대응 특수설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-031",
      "text": "현장에는 수송수단과 설비를 구비하여야 하고, 잘 설계되고 적절하게 구성된 대응차량이 모든 장비에 빠르고 쉽게 접근이 가능하도록 하여야 한다. 또한 대응차량은 24시간 이용이 가능하여야 하며, 비상대응 중에 기계적인 문제로 지연될 가능성을 최소화하도록 정기적으로 점검하여야 한다.",
      "guideContext": "비상대응 특수설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-032",
      "text": "비상장비는 특정 독성물질의 위험을 확인하는데 사용되는 계기 또는 기기를 포함하고 있어야 한다.",
      "guideContext": "비상대응 위험식별 설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-033",
      "text": "비상 대응자는 장비의 측정 능력과 제한에 대해 이해하고 있어야 한다.",
      "guideContext": "비상대응 위험식별 설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-034",
      "text": "모든 기구는 사용을 위해 유지, 교정 및 준비되어 있어야 한다.",
      "guideContext": "비상대응 위험식별 설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 설비 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-035",
      "text": "모든 위험물질의 운전자는 5.3항에 따라 사고시 보호단계의 초기에 대한 훈련을 받아야 한다.",
      "guideContext": "위험물질 운전자 준비사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-036",
      "text": "모든 차량은 적은 누출(Leak)이나 유출(Spill)에 대비한 스필킷(Spill kit)과 위험정보 및 비상대응 전화번호를 포함하는 선적서류를 구비하여야 한다.",
      "guideContext": "위험물질 운전자 준비사항",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-P39-037",
      "text": "물리적으로 가능하다면 차에서 빠져나오기 전에 운전자는 차량의 엔진과 라이트를 꺼야 하며, 고용주에 의해 확인된 특정 사전 주의사항을 취해야 할 책임이 있다.",
      "guideContext": "위험물질 운전자 준비사항",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-038",
      "text": "운전자는 본인 또는 누군가에게 차량의 화물, 상황 및 위치에 관한 정보를 알리기 위해 지역경찰, 소방서 등에 전화하고, 사고현장으로부터 멀리 떨어진 지역으로 사람을 안내하여야 한다.",
      "guideContext": "위험물질 운전자 준비사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-039",
      "text": "사고장소에 가연성 또는 유독성 증기가 존재하면 허가되지 않은 사람들이 위험지역에 들어가는 것을 막도록 조치를 취하여야 한다.",
      "guideContext": "위험물질 운전자 준비사항",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-040",
      "text": "작동중이거나 뜨거운 배기시스템을 갖는 차량, 불꽃, 담배, 플래쉬 카메라와 같은 모든 발화원은 인접지역 밖으로 내보내야 한다.",
      "guideContext": "위험물질 운전자 준비사항",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-041",
      "text": "운전자는 위험상황을 평가하기 위해 그 지역을 검사하고, 상황을 평가한 후 현장에 도착하는 최초 공공 대응기관에게 상황을 보고하여야 한다.",
      "guideContext": "위험물질 운전자 준비사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-042",
      "text": "운전자는 운전자의 고용주로부터 제품의 회수, 현장 정리 및 차량 이동의 비상대응 권한을 부여받은 현장 지휘자에게 정보를 알려야 한다.",
      "guideContext": "위험물질 운전자 준비사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-043",
      "text": "비상대응 계획은 현장통제를 확립하고, 대응이나 정리에 직접적으로 관계되지 않은 사람들의 출입을 규제하는 단계를 포함해야 하며, 이 단계는 현장에서 관련 기관의 안전 담당자와 협동으로 이루어져야 한다.",
      "guideContext": "비상대응 개인 보호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-044",
      "text": "비상대응 계획은 필요시 현장대피요령을 제공하여야 하고, 위험물질과 관련된 위험을 다른 방법으로는 인식하지 못하는 사람들에게는 경계선을 설치하여 경고하여야 한다.",
      "guideContext": "비상대응 개인 보호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-045",
      "text": "청소를 위해 배정된 사람들은 그 지역의 위험이 최소화되었다고 결정될 때까지 위험지역에 들어가서는 안 된다.",
      "guideContext": "비상대응 개인 보호",
      "additionalDetail": null,
      "workProcessPhase": "사고 후 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-046",
      "text": "대응계획은 대응자에게 위험물질의 비의도적인 누출을 처리하는 정보에 대한 적절한 방향을 제공하고, 적절한 지휘권을 알려주는 만일의 사태에 대한 계획을 포함하여야 한다.",
      "guideContext": "비상대응 환경 보호",
      "additionalDetail": null,
      "workProcessPhase": "환경 보호 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-047",
      "text": "누출물질을 씻어내는 것보다 더 적절한 과정은 방류 독(Retaining dike)이나 봉쇄 분지(Containment basin)를 만들어 물질을 함유하는 것이다. 흙을 사용한 경우에는 침투가 발생하였는지 여부를 결정하기 위해 자주 검사하여야 한다.",
      "guideContext": "비상대응 환경 보호",
      "additionalDetail": null,
      "workProcessPhase": "환경 보호 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-048",
      "text": "대응자가 탄화수소를 땅에 배출하기로 결정하였다면 잠재적인 화재나 폭발위험을 고려하여야 한다.",
      "guideContext": "비상대응 환경 보호",
      "additionalDetail": null,
      "workProcessPhase": "환경 보호 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-001"
      ]
    },
    {
      "identifier": "CI-P39-049",
      "text": "정부기관에 의해 승인되지 않으면 화학물질, 생물적 분해물질과 분산제는 사용되어서는 안 된다.",
      "guideContext": "비상대응 사고 후 청소 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 후 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-050",
      "text": "대응팀의 한 사람은 언론매체 접촉자로 임명하여야 하며, 언론매체 접촉은 인터뷰 통제, 사고 및 대응 상태의 정확한 제공, 부상과 상해에 대한 정보 제공 등을 할 수 있어야 한다.",
      "guideContext": "비상대응 언론매체 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-051",
      "text": "사고 후에 기록은 대응 관리자를 돕기 위해 조사하여야 한다.",
      "guideContext": "비상대응 후 활동 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사고 후 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-052",
      "text": "비상발생 시 제3자가 대응하도록 하기 위해 내부의 법적 정책을 마련하여야 한다.",
      "guideContext": "제3자 비상대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.6",
      "basedOn": null
    },
    {
      "identifier": "CI-P39-053",
      "text": "효과적으로 대응할 수 있는 충분한 지식이나 능력이 없는 제3자 개입은 피해야 한다.",
      "guideContext": "제3자 비상대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상사태 초기 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.6",
      "basedOn": null
    }
  ],
