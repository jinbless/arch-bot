  "checklistItems": [
    {
      "identifier": "CI-T28-001",
      "text": "일반적으로 사용되는 실험용 동물종의 건강하고 젊은 성체를 사용한다.",
      "guideContext": "급성흡입독성시험 실험동물 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실험동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-002",
      "text": "암컷을 사용하는 경우에는 새끼를 낳은 적이 없고 현재 임신 중이지 않은 개체를 사용한다.",
      "guideContext": "급성흡입독성시험 실험동물 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실험동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-003",
      "text": "시험 시작 시 각 동물은 8 ~ 12 주령이어야 하며, 체중은 평균체중의 ± 20% 범위 내에 있어야 한다.",
      "guideContext": "급성흡입독성시험 실험동물 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실험동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-004",
      "text": "사육실은 온도가 22℃ ± 3℃, 습도가 30% ~ 70%가 유지되도록 한다.",
      "guideContext": "급성흡입독성시험 사육조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사육 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-005",
      "text": "사육은 암수를 구별하여 농도에 따라 실시하며 각 개체의 상태 관찰이 용이하고 밀도가 높지 않도록 한다.",
      "guideContext": "급성흡입독성시험 사육조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사육 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-006",
      "text": "조명은 인공적으로 12시간 간격으로 명암을 조절한다.",
      "guideContext": "급성흡입독성시험 사육조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사육 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-007",
      "text": "노출기간을 제외하고는 사료와 음용수를 자유롭게 먹을 수 있도록 공급한다.",
      "guideContext": "급성흡입독성시험 사육조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사육 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-008",
      "text": "실험동물은 노출이 시작되기 적어도 5일 전에 실험실 조건에 순응시키고, 무작위로 실험동물을 선정하여 시험에 사용한다.",
      "guideContext": "급성흡입독성시험 동물 준비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실험동물 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-009",
      "text": "비부노출튜브는 동물에게 과도한 스트레스를 주지 않아야하며 동물에게 고열 응력을 피할 수 있는 방법으로 만들어지고 동물이 흡입 노출을 피할 수 없게 하여야 한다.",
      "guideContext": "급성흡입독성시험 비부노출 기술 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-010",
      "text": "흡입챔버는 통풍이 잘되는 후드에서 작동되어야 한다.",
      "guideContext": "급성흡입독성시험 노출장비 환기",
      "additionalDetail": "시험자의 유해물질 노출 방지를 위한 환기 요건",
      "workProcessPhase": "노출 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-T28-011",
      "text": "동물은 흡입 장치의 모든 동물의 호흡 환기량의 최소 두 배를 초과하는 동적 공기 흐름을 유지하도록 설계된 흡입 장비로 시험하여야 한다.",
      "guideContext": "급성흡입독성시험 비부노출 기술 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-012",
      "text": "각 노출 포트에서 유사한 노출 조건을 가진 적어도 19%의 적절한 산소 함량과 1% 이하의 이산화탄소 농도가 보장되어야 한다.",
      "guideContext": "급성흡입독성시험 챔버 내 산소·이산화탄소 농도 관리",
      "additionalDetail": "밀폐 챔버 내 산소농도 및 유해가스 농도 모니터링 요건",
      "workProcessPhase": "노출 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-T28-013",
      "text": "시험물질을 채취하는 동안, 기류의 심각한 장애는 피해야 한다.",
      "guideContext": "급성흡입독성시험 비부노출 기술 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-014",
      "text": "전신 노출 기술은 시간당 약 12 ~ 15 회의 공기 변화의 동적 공기 흐름을 유지하도록 설계된 흡입 장비를 사용하여 시험해야 한다.",
      "guideContext": "급성흡입독성시험 전신노출 기술 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-015",
      "text": "흡입챔버는 적어도 19%의 적절한 산소 함량, 1%를 초과하지 않는 이산화탄소 농도 및 균일하게 분포된 노출환경이 보장되어야 한다.",
      "guideContext": "급성흡입독성시험 전신노출 챔버 산소·이산화탄소 관리",
      "additionalDetail": "전신노출 챔버 내 적정공기 유지 요건",
      "workProcessPhase": "노출 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-T28-016",
      "text": "시험 동물의 총 부피는 흡입챔버 부피의 5%를 초과해서는 안 된다.",
      "guideContext": "급성흡입독성시험 전신노출 기술 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-017",
      "text": "노출은 평형시간을 제외하고 4시간 동안 고정된 노출 시간이 권장된다.",
      "guideContext": "급성흡입독성시험 노출조건",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-018",
      "text": "흡입챔버의 농도는 가스 및 증기의 경우 평균 챔버 농도의 ± 10% 이상, 액체 또는 고체 에어로졸은 ± 20% 이상 벗어나서는 안 된다.",
      "guideContext": "급성흡입독성시험 노출조건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-019",
      "text": "잠재적으로 폭발성 시험물질은, 폭발에 유리한 조건을 피하기 위해 주의하여야 한다.",
      "guideContext": "급성흡입독성시험 폭발성 물질 취급 안전",
      "additionalDetail": "폭발 위험이 있는 화학물질 시험 시 안전 조치",
      "workProcessPhase": "노출 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "CI-T28-020",
      "text": "노출되는 입자를 일정크기로 유지하는 작업이 수행되어야 한다.",
      "guideContext": "급성흡입독성시험 입자크기분포 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 발생",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-021",
      "text": "부형제를 사용할 경우 부형제의 급성흡입독성을 알아야한다.",
      "guideContext": "급성흡입독성시험 시험물질 발생",
      "additionalDetail": "유해물질 유해성 사전 파악 요건",
      "workProcessPhase": "시험물질 발생",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-T28-022",
      "text": "시험물질을 분해하거나 변형하지 않도록 주의해야 한다.",
      "guideContext": "급성흡입독성시험 시험물질 발생 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험물질 발생",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-023",
      "text": "챔버를 통한 공기의 흐름은 주의 깊게 조절하고 지속적으로 모니터링하고 각 노출기간 동안 적어도 3회 기록하여야 한다.",
      "guideContext": "급성흡입독성시험 챔버 공기 흐름 모니터링 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출조건 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-024",
      "text": "온도는 실험동물의 호흡 영역에서의 지속적으로 모니터링하고 노출기간 동안 최소 3회 기록하여야 한다.",
      "guideContext": "급성흡입독성시험 챔버 온도 모니터링 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출조건 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-025",
      "text": "챔버 내 온도는 22 ± 3℃로 유지되어야한다.",
      "guideContext": "급성흡입독성시험 챔버 온도 유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출조건 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-026",
      "text": "상대습도는 동물의 호흡영역에서 지속적으로 모니터링하고 노출기간 동안 최소 3회 기록하여야 한다.",
      "guideContext": "급성흡입독성시험 챔버 습도 모니터링 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출조건 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-027",
      "text": "상대습도는 30 ~ 70%의 범위에서 유지되어야한다.",
      "guideContext": "급성흡입독성시험 챔버 습도 유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출조건 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-028",
      "text": "에어로졸의 경우 노출시간 동안 최소 2회 이상 다단입경측정장치(Cascade impactor) 또는 대체 장비인 입자계측기(Aerodynamic particle sizer) 등을 이용하여 입자크기분포를 측정한다.",
      "guideContext": "급성흡입독성시험 입자크기분포 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출조건 모니터링",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-029",
      "text": "시험책임자는 시험물질의 물성 등 자료를 확보하고 시험을 시험지침에 따라 시험계획서를 작성한다.",
      "guideContext": "급성흡입독성시험 계획 수립 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-030",
      "text": "시험계획서가 작성되면 실험동물윤리위원회의 심의를 거쳐 시험이 실험동물윤리에 적합하게 수행되도록 조치한다.",
      "guideContext": "급성흡입독성시험 윤리위원회 심의 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험 계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-031",
      "text": "조합된 각 동물시험 사이의 간격은 최소 24 시간 허용된다.",
      "guideContext": "급성흡입독성시험 용량설정시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량설정시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-032",
      "text": "모든 동물은 보통 적어도 일주일 동안 관찰되어야 한다.",
      "guideContext": "급성흡입독성시험 용량설정시험 관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용량설정시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-033",
      "text": "내림차순으로 시험하고 2 ~ 3 마리의 사망이 관찰 될 때 동물 복지를 위해 시험은 중단되어야 하고 시험물질은 다음 농도의 결과에 따라 분류되어야 한다.",
      "guideContext": "급성흡입독성시험 본시험 중단 기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-034",
      "text": "이전에 시험한 동물의 생존에 대한 확신이 있을 때까지 다음 농도의 동물에 대한 노출을 지연시켜야 한다.",
      "guideContext": "급성흡입독성시험 본시험 노출 간격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "본시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-035",
      "text": "노출기간동안 실험동물은 자주 관찰되어야 한다.",
      "guideContext": "급성흡입독성시험 관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-036",
      "text": "노출 후에는 노출당일에 최소한 두 번 실시하여야 한다.",
      "guideContext": "급성흡입독성시험 노출 후 관찰 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-037",
      "text": "임상관찰은 최소 14일 동안 매일 적어도 1 회 실시하여야 한다.",
      "guideContext": "급성흡입독성시험 임상관찰 기간 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-038",
      "text": "모든 관찰은 체계적으로 기록되어야하며 각 동물에 대한 개별 기록이 유지되어야 한다.",
      "guideContext": "급성흡입독성시험 관찰 기록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-039",
      "text": "심한 통증 또는 고통의 지속적인 징후를 보이는 동물은 즉시 인도적으로 처리하여야 한다.",
      "guideContext": "급성흡입독성시험 동물복지 인도적 처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-040",
      "text": "개별 동물의 체중은 순화기간 동안 최소 1회 이상, 노출일과 노출 후 1, 3, 7일과 그 이후에는 주단위로 기록되어야 한다.",
      "guideContext": "급성흡입독성시험 체중 측정 기록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체중 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-041",
      "text": "시험에 사용한 모든 동물은 부검하여야 한다.",
      "guideContext": "급성흡입독성시험 병리검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "병리검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-042",
      "text": "독성징후가 있는 장기의 모든 육안적 병리 변화를 기록하여야 한다.",
      "guideContext": "급성흡입독성시험 병리검사 기록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "병리검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-043",
      "text": "부검은 사망 개체의 발견 즉시 하는 것이 좋으며, 가능한 하루나 이틀 이내로 바로 수행하여야 한다.",
      "guideContext": "급성흡입독성시험 부검 시기",
      "additionalDetail": null,
      "workProcessPhase": "병리검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-044",
      "text": "시험결과는 체중, 부검결과, 실험동물 수, 독성증상을 보이는 실험동물 수, 시험기간 중 사망동물 수, 인도적 이유로 안락사 시킨 동물의 수, 사망시간, 독성발현 및 회복시간 등을 표로 요약하여 기록한다.",
      "guideContext": "급성흡입독성시험 결과 기록 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시험결과 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-045",
      "text": "빈사동물 또는 명백하게 통증이 있거나 가혹하고 지속적인 고통의 징조를 보이는 동물은 인도적으로 희생되어야하며, 결과해석에서 사망한 동물과 동일한 방식으로 간주한다.",
      "guideContext": "급성흡입독성시험 빈사동물 처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-046",
      "text": "적절한 노출 농도를 설정하기 위해서는 동물이 없는 상태에서의 기술적 시험이 필수적이다.",
      "guideContext": "급성흡입독성시험 노출농도 사전 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "노출 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T28-047",
      "text": "부검 전에 사망한 동물이 발생되면 냉장상태로 (냉동이 아닌) 보관한다.",
      "guideContext": "급성흡입독성시험 사망동물 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "병리검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-T28-001",
      "term": "급성흡입독성",
      "definition": "흡입 가능한 물질을 단기간(24시간이내)에 1회 흡입노출 시켰을 때 시험 물질에 의해 나타나는 악영향(adverse effects)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T28-002",
      "term": "화학물질 분류 및 표지에 관한 세계조화시스템(GHS)",
      "definition": "화학물질의 분류·표시에 대한 세계조화시스템으로 동일한 화학물질에 대해 국제적으로 동일한 유해·위험성 분류·표시를 위한 규정이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T28-003",
      "term": "주령",
      "definition": "실험동물의 모체로부터 태어난 날을 기준으로 하여 1주일이 경과되는 날을 1주령이라 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T28-004",
      "term": "순화",
      "definition": "실험동물은 사육환경 변화 시 생체에도 영향을 받으므로 동물의 이동이나 환경조건 변화 시 해당 시험장소에서 충분히 적응되어 안정을 찾을 수 있도록 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T28-005",
      "term": "빈사동물",
      "definition": "실험동물에 의하여 죽어가는 상태 또는 생존할 가능성이 없는 시험동물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-T28-01",
      "processOrder": 1,
      "processName": "시험 계획 수립",
      "safetyMeasures": "시험책임자는 시험물질의 물성 등 자료를 확보하고 시험지침에 따라 시험계획서를 작성한다. 시험계획서에는 시험의 개요, 시험세부계획이 포함되도록 작성하며, 실험동물윤리위원회의 심의를 거쳐 시험이 실험동물윤리에 적합하게 수행되도록 조치한다.",
      "requiredPPE": [],
      "sourceSection": "7.1",
      "relatedSR": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "WP-T28-02",
      "processOrder": 2,
      "processName": "실험동물 준비 및 순화",
      "safetyMeasures": "실험동물은 노출이 시작되기 적어도 5일 전에 실험실 조건에 순응시킨다. 사육실은 온도 22℃ ± 3℃, 습도 30~70%를 유지하고, 조명은 12시간 간격으로 명암을 조절한다. 무작위로 실험동물을 선정하여 시험에 사용한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-T28-03",
      "processOrder": 3,
      "processName": "용량설정시험",
      "safetyMeasures": "시작 농도에서 수컷 1마리, 암컷 1마리에 동시에 적어도 4시간 노출한다. 각 동물시험 사이의 간격은 최소 24시간 허용하며, 모든 동물은 적어도 일주일 동안 관찰한다. 폭발성 시험물질은 폭발에 유리한 조건을 피하기 위해 주의한다.",
      "requiredPPE": [],
      "sourceSection": "7.2",
      "relatedSR": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "WP-T28-04",
      "processOrder": 4,
      "processName": "본시험 실시",
      "safetyMeasures": "용량설정시험에서 사망을 초래한 농도 수준은 본시험에서 실시하지 않는다. 내림차순으로 시험하고 2~3마리의 사망이 관찰될 때 시험을 중단한다. 이전에 시험한 동물의 생존에 대한 확신이 있을 때까지 다음 농도의 동물에 대한 노출을 지연시킨다.",
      "requiredPPE": [],
      "sourceSection": "7.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-T28-05",
      "processOrder": 5,
      "processName": "노출조건 모니터링",
      "safetyMeasures": "챔버 공기 흐름은 지속적으로 모니터링하고 각 노출기간 동안 적어도 3회 기록한다. 온도(22 ± 3℃)와 상대습도(30~70%)를 호흡영역에서 지속 모니터링하고 최소 3회 기록한다. 산소함량 19% 이상, 이산화탄소 1% 이하를 보장한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-T28-06",
      "processOrder": 6,
      "processName": "관찰 및 임상검사",
      "safetyMeasures": "노출기간 동안 실험동물을 자주 관찰하고, 노출 후 당일 최소 2회, 이후 최소 14일간 매일 1회 이상 임상관찰을 실시한다. 심한 통증 또는 고통의 지속적 징후를 보이는 동물은 즉시 인도적으로 처리한다. 모든 관찰은 체계적으로 기록하며 각 동물에 대한 개별 기록을 유지한다.",
      "requiredPPE": [],
      "sourceSection": "7.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-T28-07",
      "processOrder": 7,
      "processName": "체중 측정",
      "safetyMeasures": "순화기간 동안 최소 1회 이상, 노출일과 노출 후 1, 3, 7일과 그 이후에는 주단위로 체중을 기록한다. 노출일 대비 10%를 초과하여 감소하는 동물은 명백한 독성에 도달했음을 나타낸다.",
      "requiredPPE": [],
      "sourceSection": "7.6",
      "relatedSR": null
    },
    {
      "identifier": "WP-T28-08",
      "processOrder": 8,
      "processName": "병리검사",
      "safetyMeasures": "시험에 사용한 모든 동물은 부검하며, 독성징후가 있는 장기의 모든 육안적 병리 변화를 기록한다. 부검 전 사망한 동물은 냉장상태로 보관하고, 부검은 사망 개체 발견 즉시 또는 가능한 하루나 이틀 이내로 수행한다.",
      "requiredPPE": [],
      "sourceSection": "7.7",
      "relatedSR": null
    },
    {
      "identifier": "WP-T28-09",
      "processOrder": 9,
      "processName": "시험결과 처리 및 보고",
      "safetyMeasures": "체중, 부검결과, 실험동물 수, 독성증상 동물 수, 사망동물 수, 안락사 동물 수, 사망시간, 독성발현 및 회복시간 등을 표로 요약하여 기록한다. 시험보고서에는 시험기관, 시험책임자, 실험동물 정보, 시험물질 정보, 노출조건, 시험결과, 결과 해석 항목을 포함한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
  ],
