  "checklistItems": [
    {
      "identifier": "CI-H175-001",
      "text": "세척공간은 세면(목욕), 세탁, 탈의가 가능해야 하며, 가급적 동일 공간 내에 구성하는 것을 원칙으로 한다.",
      "guideContext": "환경미화원 세척시설 공간구성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-002",
      "text": "각종 장구 수납공간을 별도로 마련하여 세척공간이 작업도구 보관함으로 사용되는 것을 방지한다.",
      "guideContext": "환경미화원 세척시설 공간구성",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-003",
      "text": "환경미화원이 사용 가능한 세면·샤워시설을 구비해야 한다.",
      "guideContext": "세면·목욕시설 설치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-004",
      "text": "성별에 따라 사용공간을 구분하여 설치한다.",
      "guideContext": "세면·목욕시설 성별 구분 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-005",
      "text": "동시 사용 근로자 수를 고려해 적절한 사워꼭지 및 세면대 개수를 확보한다.",
      "guideContext": "세면·목욕시설 수량 확보 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-006",
      "text": "환기를 위한 창이나 환풍 시설을 갖추도록 한다.",
      "guideContext": "세면·목욕시설 환기",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-007",
      "text": "실내조명은 200Lux가 적절하다.",
      "guideContext": "세면·목욕시설 조도 기준",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-008",
      "text": "물 빠짐이 용이하도록 설계하며 주기적인 청소를 통해 청결하게 관리하도록 한다.",
      "guideContext": "세면·목욕시설 배수 및 청결 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-009",
      "text": "세면·목욕시설 내 임시 수납장을 구비하여 이용 편의성을 높인다.",
      "guideContext": "세면·목욕시설 수납",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-010",
      "text": "비누나 세정제를 비치하고 목욕시설에는 수건(개인별)을 비치, 세면대에는 1회용 핸드타월 또는 건조기의 비치를 권장하며 정기적으로 물품을 교체하는 등 관리토록 한다.",
      "guideContext": "세면·목욕시설 비품 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-011",
      "text": "작업복을 세탁할 수 있는 별도의 세탁실을 설치하도록 권장한다.",
      "guideContext": "세탁시설 설치",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-012",
      "text": "동시 사용 근로자수에 따라 적정한 세탁기 수를 설치한다.",
      "guideContext": "세탁시설 세탁기 수량 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-013",
      "text": "빨래를 건조시킬 수 있는 공간을 확보한다.",
      "guideContext": "세탁시설 건조공간 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-014",
      "text": "물 빠짐이 용이하도록 설계하며, 주기적인 청소를 통해 청결하게 관리하도록 한다.",
      "guideContext": "세탁시설 배수 및 청결 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-015",
      "text": "세탁에 필요한 세제 및 기타 비품을 구비하도록 하며, 세제 등이 떨어지지 않게 주기적으로 점검한다.",
      "guideContext": "세탁시설 비품 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-016",
      "text": "세탁실의 실내조명은 세탁기준으로 200Lux가 적절하다.",
      "guideContext": "세탁시설 조도 기준",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-017",
      "text": "작업의 특성상 필요한 경우, 샤워시설이 딸린 세탁시설을 설치한다.",
      "guideContext": "세탁시설 부속 샤워시설",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-018",
      "text": "시설은 항상 깨끗하고 정돈된 상태를 유지해야 한다.",
      "guideContext": "세탁시설 청결 유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-019",
      "text": "세탁 시설은 고온 및 저온 또는 따뜻한 물이 잘 공급되어야 한다.",
      "guideContext": "세탁시설 급수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-020",
      "text": "청결하고 정돈된 상태를 유지해야 한다.",
      "guideContext": "탈의시설 청결 유지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-021",
      "text": "잠금장치를 설정할 수 있는 개인 사물함을 권장한다.",
      "guideContext": "탈의시설 개인 사물함",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-022",
      "text": "성별에 따라 사용공간이 구분되어 있어야 한다.",
      "guideContext": "탈의시설 성별 구분 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-023",
      "text": "탈의실내 적정 조도는 200Lux가 적절하다.",
      "guideContext": "탈의시설 조도 기준",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-024",
      "text": "실내 적정온도를 준수해야 한다. (여름철 : 26~28˚C, 겨울철 : 18~22˚C)",
      "guideContext": "탈의시설 실내 적정온도 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H175-025",
      "text": "환기를 위한 창이나 기계식 환기설비를 갖추고 있어야 한다.",
      "guideContext": "탈의시설 환기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    }
  ],
