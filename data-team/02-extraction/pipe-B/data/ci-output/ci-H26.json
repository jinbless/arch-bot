  "domainTerms": [
    {
      "identifier": "DT-H26-001",
      "term": "근골격계질환",
      "definition": "반복적인 동작, 부적절한 작업자세, 무리한 힘의 사용, 날카로운 면과의 신체 접촉, 진동 및 온도 등의 요인에 의하여 발생하는 건강장해로서 목, 어깨, 허리, 상·하지의 신경근육 및 그 주변 신체 조직 등에 나타나는 질환을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H26-002",
      "term": "인간공학적 위험요인",
      "definition": "사용자를 고려하지 않고 작업대, 작업장공구, 기계기구 등을 디자인함으로써 상해를 유발시킬 수 있는 무리한 힘, 반복작업, 부적절한 작업 자세, 정적인 자세, 접촉스트레스 등의 요소들을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H26-003",
      "term": "열피로(Heat Stress)",
      "definition": "고열환경에 노출되어 신체 온도조절 중추 이상으로 나타나는 피로감, 집중력 감소, 두통, 소화불량 등 제반 증상들을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "DT-H26-004",
      "term": "애벌세척",
      "definition": "본세척을 하기 전 이물질 등을 제거하기 위하여 실시하는 1차 세척을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
