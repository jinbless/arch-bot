  "checklistItems": [
    {
      "identifier": "CI-M96-001",
      "text": "공작물 파지장치는 회전중에 작업자가 접촉되지 않도록 항상 방호되어 있어야 한다.",
      "guideContext": "수동선반 공작물 파지장치 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 공작물 파지장치 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-002",
      "text": "가드는 선반의 주축대에 견고하게 부착되는 형태이어야 한다.",
      "guideContext": "수동선반 공작물 파지장치 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 공작물 파지장치 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-003",
      "text": "공작영역의 가드는 파손된 공구가 통과하지 못하도록 충분한 강도를 지닌 것이어야 한다.",
      "guideContext": "수동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-004",
      "text": "선반의 뒷부분에는 칩 등의 비산이나 공작물과의 접촉을 방지할 수 있는 충분한 길이와 높이의 고정식 또는 탈착식의 가드가 제공되어야 한다.",
      "guideContext": "수동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-005",
      "text": "선반의 절삭점 앞면 및 윗면을 방호할 수 있도록 왕복대 등에 부착시키거나, 작업자가 설치할 수 있는 고정가드 또는 유지가드가 설치되어야 한다. 이를 설계할 때는 작업자가 작업점을 볼 수 있고 기계의 조작이 쉽도록 한다.",
      "guideContext": "수동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-006",
      "text": "공작물이 너무 크거나, 센터 사이의 거리가 너무 멀거나 하여 위의 방법이 적합치 않을 때에는 방책형 가드 등과 같은 방호조치를 한다.",
      "guideContext": "수동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-007",
      "text": "냉각제나 절삭유를 사용할 때에는 공작영역 방호가드와 일체로 되어 있거나 방호영역 내에 설치될 수 있는 기름받이 판으로 냉각제 등이 근로자에게 튀지 않도록 방호한다. 이 경우 기름받이 판은 기계나 가드를 쉽게 청소 할 수 있고 냉각제나 절삭유가 기계 측으로 들어가도록 한다.",
      "guideContext": "수동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-008",
      "text": "리드 스크루나 이송축이 베드나 새들 또는 칩 받이에 의하여 방호되는 경우를 제외하고는 이들을 방호하여야 한다.",
      "guideContext": "리드 스크루 및 이송축 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리드 스크루 및 이송축 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-009",
      "text": "슬라이딩 베드 선반의 이송축이 노출된 경우에는 방호한다.",
      "guideContext": "리드 스크루 및 이송축 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "리드 스크루 및 이송축 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-010",
      "text": "심압대 센터를 동력으로 작동시키는 경우 유압장치의 고장 등의 동력 이상이 있을 경우 센터가 후진하지 않고 계속 유지되는 기능을 가져야 한다.",
      "guideContext": "심압대 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "심압대 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-011",
      "text": "심압대를 페달식으로 조정하는 경우 페달은 낙하물이나 기타 운동물 등으로 또는 부주의에 의하여 작동이 되지 않도록 방호되어야 한다.",
      "guideContext": "심압대 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "심압대 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-012",
      "text": "트립 도그나 엔드스톱과 같은 조정용 기구가 그 성질상 위험을 내포하고 있을 경우 고정가드나 유지가드를 설치하여야 한다.",
      "guideContext": "조정용 기구 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수동선반 조정용 기구 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-013",
      "text": "터릿선반 공구나 공구를 고정하기 위한 장치 등이 선반의 기초평면 밖으로 튀어나올 경우에는 방호한다.",
      "guideContext": "툴링이 제공되는 수동선반 방호 (법령 근거 미확인)",
      "additionalDetail": "다만, 수동으로 이송 및 분할하거나 동력으로 분할하고 이송을 하며 공구가 풀렸을 경우에는 움직이지 않도록 되어 있는 터릿선반은 선반의 뒷부분만 방호하여도 좋다.",
      "workProcessPhase": "수동선반 툴링 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-014",
      "text": "공작물 파지장치의 회전부 외측에 근로자가 접촉지 않도록 고정가드나 유지가드를 설치하여야 한다.",
      "guideContext": "자동선반 공작물 파지장치 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 공작물 파지장치 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-015",
      "text": "자동모드로 운전되는 동안에 선반의 운동과 공작이 위험을 미칠 수 있으므로 방호되어야 한다.",
      "guideContext": "자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-016",
      "text": "가능하면 공작영역 전부를 방호하는 것이 좋다.",
      "guideContext": "자동선반 공작영역 방호",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-017",
      "text": "공작영역 전부를 방호하며 자동모드에서 공작물을 탈착하기 위하여 유지가드가 열려야 하는 경우에 유지가드는 선반의 운전과 연동되어야 한다.",
      "guideContext": "자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-018",
      "text": "공작영역 전부를 방호하는 것이 불가능한 대용량의 선반 등에는 고정가드나 유지가드가 제공되어야 하며, 이때 유지가드는 왕복대에 고정되어 왕복대와 같이 움직이거나 기계에 고정되어 자체의 슬라이드를 통하여 작업자가 조정하여 공작물을 방호할 수 있거나, 자유롭게 서 있는 형태로 할 수 있다.",
      "guideContext": "자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-019",
      "text": "선반을 조정하기 위하여 가드를 제거하고 선반을 동작시켜야 하는 경우 가능한 방법에 의하여 조정작업자를 방호한다.",
      "guideContext": "자동선반 조정시 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 조정시 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-020",
      "text": "조정작업은 어떤 특정한 가드를 제거하거나 무효화시키고 작업하여야 하기 때문에 조정작업자는 충분한 자격을 가진 훈련된 사람이거나 이런 사람의 감독하에 행하여야 한다.",
      "guideContext": "자동선반 조정시 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 조정시 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-021",
      "text": "키 스위치를 설치하여 이 스위치가 공작영역의 연동 가드의 인터록을 해제 할 수 있도록 하는 것이 좋다.",
      "guideContext": "자동선반 조정시 방호",
      "additionalDetail": null,
      "workProcessPhase": "자동선반 조정시 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-022",
      "text": "수동으로 공작물 파지장치에 공작물을 넣어 주는 다축자동선반은 미닫이 또는 여닫이의 공작영역 전체를 방호하는 가드를 제어시스템과 연동시켜 가드가 닫히지 않고는 공작물 탈착부위에서 주축의 분할이나 계속적인 회전이 불가능하도록 한다.",
      "guideContext": "다축자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": "또한 주가드가 열려 있을 때 공작영역내 다른 작업부위로부터 작업자를 방호하기 위하여 별개의 가드가 필요하다. 주축의 분할시 가드는 닫힌 상태이어야 한다.",
      "workProcessPhase": "다축자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-023",
      "text": "공작영역 전체를 방호하는 선반 제어시스템과 연동시킨 가드를 설치하여 선반이 자동으로 작동할 때에는 가드를 열 수 없도록 한다.",
      "guideContext": "다축자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": "이때 공작영역 내부의 공작물 탈착부위 가까이에는 미닫이나 여닫이식으로 문을 설치할 수 있으며 이 때 문이 닫히기 전에는 주축의 분할이나 회전이 불가능하도록 연동되어 있어야 한다.",
      "workProcessPhase": "다축자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-024",
      "text": "위 호의 어떤 방법을 택하더라도 일반적으로 공작영역내의 다른 작업부위로부터의 방호를 위하여 부가적으로 필요한 조치를 하여야 한다.",
      "guideContext": "다축자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "다축자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-025",
      "text": "공작영역 내에 작업자가 공작물 탈착부위를 볼 수 있도록 감시창이나 미닫이 또는 여닫이 문이 있을때 투명창에는 비산방지용 재질을 사용한다.",
      "guideContext": "다축자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "다축자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-026",
      "text": "선반이 공작물의 수동 탈착모드에 있을 때에는 선반이 한 사이클만 작동가능하게 하여 작업자가 이를 매번 개시하도록 하여야 한다.",
      "guideContext": "다축자동선반 공작영역 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "다축자동선반 공작영역 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-027",
      "text": "칩처리 컨베이어, 유압장치, 심압대 이송장치 등 기타 선반의 부속장치가 위험을 발생시킬 우려가 있고 기존의 가드에 의하여 방호되지 않을 때에는 별도로 방호하여야 한다.",
      "guideContext": "선반 부속장치 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부속장치 방호",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M96-028",
      "text": "공작물을 지니고 있는 장치는 공작물의 비산을 막을 수 있는 충분한 강도를 지녀야 한다.",
      "guideContext": "선반 부속장치 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부속장치 방호",
