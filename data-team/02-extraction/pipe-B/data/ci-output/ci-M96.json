  "domainTerms": [
    {
      "identifier": "DT-M96-001",
      "term": "자동선반",
      "definition": "정상적인 작업상태에서 주어진 순서에 따라 운동 및 기능이 자동적으로 행하여지는 선반을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M96-002",
      "term": "수동선반",
      "definition": "공구이송 및 공작물 파지장치가 수동으로 조작되는 선반을 말하며 여기에는 수동으로 조작되는 모방장치 등을 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M96-003",
      "term": "공작영역",
      "definition": "공구가 절삭작업을 하면서 움직일 수 있는 공간을 말한다. 여기에는 공구가 공작물과 접촉해 있거나 절삭을 하기 위하여 공작물로 접근하는 점을 포함하며 터릿선반에서와 같이 작업이 이루어지지 않는 공구가 있는 부위는 제외된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M96-004",
      "term": "고정가드",
      "definition": "기계에 견고하게 고정되어 공구를 사용치 않고는 제거 또는 개방할 수 없으며 운동부위가 없는 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M96-005",
      "term": "유지가드",
      "definition": "미닫이 또는 여닫이 형태로 중력이나 수동조작으로 확실하게 잠거지며, 기계에 견고하게 고정되어 공구를 사용치 않고는 제거할 수 없는 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M96-006",
      "term": "탈착가드",
      "definition": "작업장 바닥이나 기계 위에 자유롭게 세워둘 수 있는 가드를 말하며 부주의에 의하여 쉽게 제거될 수 없도록 되어 있어야 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M96-007",
      "term": "방책형가드",
      "definition": "위험지역에 정상적인 접근을 방지하기 위하여 설치하는 충분한 높이의 담장형 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M96-01",
      "processOrder": 1,
      "processName": "수동선반 공작물 파지장치 방호",
      "safetyMeasures": "공작물 파지장치는 회전중에 작업자가 접촉되지 않도록 방호하고, 가드는 선반의 주축대에 견고하게 부착되는 형태로 설치한다. 연동 가드가 있는 경우 별도의 파지장치 방호조치를 하지 않아도 된다.",
      "requiredPPE": [],
      "sourceSection": "4.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-02",
      "processOrder": 2,
      "processName": "수동선반 공작영역 방호",
      "safetyMeasures": "공작영역 가드는 파손된 공구가 통과하지 못하도록 충분한 강도를 확보한다. 선반 뒷부분에 칩 비산 방지용 고정식 또는 탈착식 가드를 설치하고, 절삭점 앞면 및 윗면에 고정가드 또는 유지가드를 설치한다. 냉각제 사용 시 기름받이 판으로 비산을 방지한다.",
      "requiredPPE": [],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-03",
      "processOrder": 3,
      "processName": "리드 스크루 및 이송축 방호",
      "safetyMeasures": "리드 스크루나 이송축이 베드나 새들 또는 칩 받이에 의하여 방호되지 않는 경우 별도로 방호한다. 슬라이딩 베드 선반의 이송축이 노출된 경우에도 방호한다.",
      "requiredPPE": [],
      "sourceSection": "4.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-04",
      "processOrder": 4,
      "processName": "심압대 방호",
      "safetyMeasures": "심압대 센터를 동력으로 작동시키는 경우 동력 이상 시 센터가 후진하지 않고 유지되는 기능을 확보한다. 페달식 심압대의 경우 낙하물이나 부주의에 의한 오작동을 방지하도록 방호한다.",
      "requiredPPE": [],
      "sourceSection": "4.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-05",
      "processOrder": 5,
      "processName": "자동선반 공작물 파지장치 방호",
      "safetyMeasures": "공작물 파지장치의 회전부 외측에 근로자가 접촉하지 않도록 고정가드나 유지가드를 설치한다. 연동가드가 있는 경우 별도의 방호조치를 하지 않아도 된다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-06",
      "processOrder": 6,
      "processName": "자동선반 공작영역 방호",
      "safetyMeasures": "자동모드 운전 중 공작영역을 방호하되, 가능하면 전부를 방호한다. 유지가드가 열려야 하는 경우 선반 운전과 연동시킨다. 대용량 선반은 고정가드나 유지가드를 왕복대에 고정하거나 자유롭게 서 있는 형태로 설치한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-07",
      "processOrder": 7,
      "processName": "자동선반 조정시 방호",
      "safetyMeasures": "가드를 제거하고 선반을 동작시켜야 하는 경우 가능한 방법으로 조정작업자를 방호한다. 조정작업자는 충분한 자격을 가진 훈련된 사람이거나 그의 감독하에 작업한다. 키 스위치를 설치하여 연동 가드의 인터록을 해제할 수 있도록 한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-08",
      "processOrder": 8,
      "processName": "다축자동선반 공작영역 방호",
      "safetyMeasures": "공작영역 전체를 방호하는 가드를 제어시스템과 연동시켜 가드가 닫히지 않으면 주축의 분할이나 회전이 불가능하도록 한다. 투명창에는 비산방지용 재질을 사용하고, 수동 탈착모드에서는 한 사이클만 작동가능하게 한다.",
      "requiredPPE": [],
      "sourceSection": "5.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-M96-09",
      "processOrder": 9,
      "processName": "부속장치 방호",
      "safetyMeasures": "칩처리 컨베이어, 유압장치, 심압대 이송장치 등 부속장치가 기존 가드로 방호되지 않을 때 별도로 방호한다. 공작물을 지닌 장치는 비산 방지 강도를 확보하고, 연속 작업 장치에는 연동장치를 설치한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    }
  ],
