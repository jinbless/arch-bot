  "checklistItems": [
    {
      "identifier": "CI-M136-001",
      "text": "이 기준에 사용하는 표준시험편은 KS B 0831에서 규정하는 A1형, A2형 및 A3형으로 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탐상시험 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-002",
      "text": "접촉매질은 농도 75% 이상의 글리세린 수용액, 글리세린 페이스트 또는 음향 결합이 이와 동등 이상인 것을 사용한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탐상시험 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-003",
      "text": "수직 탐촉자의 진동자는 원형으로 하고 탐촉자의 공칭지름은 원칙적으로 <표 1>에 따른다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": "공칭주파수 2 또는 2.25 MHz, 공칭지름 10mm (10~20mm 범위)",
      "workProcessPhase": "탐상시험 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-004",
      "text": "피니언이 조립되는 축 끝단에서 탐상하는 것을 원칙으로 하며 시험체의 표면은 녹, 페인트, 그리스 등의 이물질이 없어야 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탐상조건 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-005",
      "text": "시험체를 빠짐없이 시험할 수 있도록 20% 이상 중첩 주사 하여야 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탐상조건 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-006",
      "text": "탐상감도는 결함의 누락을 방지하기 위해 5.2(3)항의 평가감도보다 6 dB 이상 높게 설정하여 탐상하고, 지시발견 시 평가는 5.2(3)항의 평가감도에 따른다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "탐상조건 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-007",
      "text": "시간축은 표준시험편을 사용하여 교정하고 측정범위(시간 축)는 500 ㎜로 설정한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수직탐상",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-008",
      "text": "기준감도 설정은 대비시험편이나 새로 제작된 피니언 축을 사용하여 <표 2>와 같이 제1회 밑면 에코 높이를 탐상기 화면 높이의 80%로 조정하고 이때의 게인값(dB)을 기준감도로 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수직탐상",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-009",
      "text": "피니언이 분해된 축 중 축단부 곡률이 있는 축의 경우 <표 2>에 따라 설정된 기준감도에서 18 dB를 올려 이를 평가감도로 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수직탐상",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-010",
      "text": "피니언이 분해된 축 중 축단부 가공 노치가 있는 축의 경우 <표 2>에 따라 설정된 기준감도에서 12 dB를 올려 이를 평가감도로 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수직탐상",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-011",
      "text": "피니언이 조립된 축의 경우 <표 2>에 따라 설정된 기준감도에서 12 dB를 올려 이를 평가감도로 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수직탐상",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-012",
      "text": "피니언이 조립된 축을 초음파 탐상시험 할 경우에는 유사결함지시가 나타날 수 있으므로 유사결함지시와 결함지시는 <부록>을 참조하여 구별하고 모든 지시는 평가감도에서 평가되어야 한다.",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "지시 평가 및 판정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-013",
      "text": "피니언 축 재료의 건전성 여부를 검사하기 위해 밑면 에코소실을 확인하며 <표4>와 같이 제1회 밑면 에코높이가 탐상기 화면 높이의 20% 이상일 것",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": "판정기준: 평가감도에서 탐상기 화면 높이의 20% 이상",
      "workProcessPhase": "지시 평가 및 판정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M136-014",
      "text": "결함지시는 <표 4>와 같이 탐상기 화면 높이의 20% 이하일 것",
      "guideContext": "리프트 피니언축 초음파탐상시험 (법령 근거 미확인)",
      "additionalDetail": "판정기준: 평가감도에서 탐상기 화면 높이의 20% 이하",
      "workProcessPhase": "지시 평가 및 판정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M136-001",
      "term": "건설용 리프트",
      "definition": "동력을 사용하여 가이드레일을 따라 상하로 움직이는 운반구를 매달아 화물을 운반할 수 있는 설비 또는 이와 유사한 구조 및 성능을 가진 것으로써 건설현장에서 사용하는 것을 말하며 형식에 따라 와이어로프 식 건설용 리프트와 랙 및 피니언식 건설용 리프트로 구분하고 용도에 따라 화물용과 인화공용으로 구분한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-002",
      "term": "초음파 탐상시험",
      "definition": "초음파를 시험체에 전달했을 때 시험체가 나타내는 음향적 성질을 이용해서 시험체의 내부 흠이나 재질 등을 조사하여 평가하는 시험방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-003",
      "term": "표준시험편",
      "definition": "규정된 재질, 모양, 치수로 제작되어 검정된 시험편을 말하며 탐상기의 성능 시험 또는 감도 조정 등에 사용한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-004",
      "term": "대비시험편",
      "definition": "특정 시험재를 위한 시험편으로서 탐상기의 감도조정, 거리-진폭 곡선의 작성 또는 음속 측정 등을 목적으로 제작되는 시험편을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-005",
      "term": "기준감도",
      "definition": "대비시험편의 일정 거리에 탐촉자를 위치시켜 인공적으로 만든 흠에서 에코레벨로 조정했을 때의 감도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-006",
      "term": "탐상감도",
      "definition": "시험체를 탐상하기 위해 펄스폭과 게인 등을 적절하게 조정한 감도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-007",
      "term": "평가감도",
      "definition": "흠의 에코 높이를 평가할 때 기준이 되는 감도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-008",
      "term": "게인",
      "definition": "수신기의 입력전압을 증폭하는 정도로 증폭기의 출력전압과 입력전압 비로 평가하며, 통상적으로 데시벨(dB)로 나타낸다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-009",
      "term": "시간 축",
      "definition": "초음파 탐상기 화면의 횡축을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-010",
      "term": "에코",
      "definition": "시험체의 흠, 바닥 면, 경계 면 등에서 반사되어 수신된 신호가 탐상기의 화면에 나타난 지시를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-011",
      "term": "지시",
      "definition": "비파괴 시험에서 장치에 표시된 도형이나 수치 또는 시험체에 나타난 모양을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-012",
      "term": "진동자",
      "definition": "전기적 진동과 기계적 진동(초음파)을 변갈아 발생시키는 장치를 말하며 주로 수정, 압전 세라믹 등이 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-013",
      "term": "탐촉자",
      "definition": "초음파를 송신, 수신 또는 송·수신하기 위한 진동자를 케이스 등에 넣어 놓은 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M136-014",
      "term": "판정기준",
      "definition": "흠의 치수, 위치 또는 종류 등을 고려하여 시험체의 사용가능 여부를 판정하는 기준을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
