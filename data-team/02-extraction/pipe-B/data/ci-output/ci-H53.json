  "checklistItems": [
    {
      "identifier": "CI-H53-001",
      "text": "사용하고 남은 미량의 마취가스 노출을 최소화하기 위해 정확하게 탐지, 측정하고 농도를 제한하여야 한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "잉여 마취가스 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H53-002",
      "text": "누출마취가스를 제거하기 위해 수술실에 마취가스 제거 시스템을 설치한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H53-003",
      "text": "수술실에 공기를 순환하고 보충하는 환기 시스템을 설치한다. 가동주기는 시간당 3회의 신선공기 환기를 포함하여 시간당 15회 정도 환기를 하도록 한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H53-004",
      "text": "환자의 호기에서 발생하는 마취가스 노출에 대한 예방을 위하여 회복실 공기를 순환하고 보충하는 환기시스템을 설치한다. 환기주기는 시간당 2번의 신선공기 환기를 포함하여 시간당 6회 실시하는 것이 좋다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": "회복실 환기 기준",
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H53-005",
      "text": "수술실에서 마취 가스의 누출을 최소화하기 위해 마취기, 호흡 회로, 누출 마취가스 제거 시스템을 항상 적절하게 유지한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H53-006",
      "text": "위해성 전달(Hazard communication) 프로그램을 수립한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "유해성 주지 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H53-007",
      "text": "노출 위해성과 이를 제어하는 정보가 포함된 안전과 보건 계획을 작성한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "유해성 주지 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H53-008",
      "text": "마취제 실린더에 라벨을 부착한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "유해성 주지 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H53-009",
      "text": "물질안전보건자료를 비치한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "유해성 주지 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H53-010",
      "text": "누출마취가스 노출의 위해성 인식, 예방 및 제어에 대해 근로자를 교육한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "유해성 주지 및 교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H53-011",
      "text": "누출가스제어 시스템의 정량적 평가와 마취가스 사용지역의 반복적인 기준 농도 측정이 필요하다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H53-012",
      "text": "공기 중 마취가스 농도에 대한 기록은 5년간 유지한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "의학적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H53-013",
      "text": "퇴직 후에도 노출 근로자에 대한 의료기록들도 유지한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "의학적 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-014",
      "text": "수술실 근로자들에 대하여 배치 전 및 실시주기에 따라 간기능 및 신기능 검사를 실시한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "의학적 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-015",
      "text": "환자의 호흡 경로(Breathing circuit)를 일일 기계 점검표로 확인한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-016",
      "text": "수술실 환기 또는 지역 환기 시스템을 작동시킨다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H53-017",
      "text": "가스 배출 시스템과 마취 장비와의 연결을 확인한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H53-018",
      "text": "후두 마스크 또는 기관 내 삽관 조작이 완벽히 끝난 후에 마취가스를 투입한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-019",
      "text": "능동적 제거 시스템이 있는 천장부착형 후드 하에서 기화기(Vaporizer)를 채운다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H53-020",
      "text": "수술 중에 기화기에 마취액을 채우지 말고 마취 전 또는 후에 채운다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-021",
      "text": "기관내 튜브가 완전히 밀폐되었는지 확인한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-022",
      "text": "마취시스템의 적절한 기능과 환자의 안전을 위해 최저 마취가스 유량을 사용한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-023",
      "text": "누출을 방지하기 위해 마취 가스 투입속도를 천천히 가동시킨다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-024",
      "text": "액체 마취제는 거즈에 묻혀 마취시킨다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-025",
      "text": "마스크를 사용하는 경우에 환자에 밀폐되었는지 확인한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H53-026",
      "text": "환자로부터 마취 호흡기를 분리하기 전에 마취가스 제거 시스템을 통해 최대한 잔류 가스를 제거한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H53-027",
      "text": "마취 시스템의 전원을 끄기 전에 마취가스를 차단한다.",
      "guideContext": "병원 근로자의 마취가스 노출관리",
      "additionalDetail": null,
      "workProcessPhase": "수술 중 장비 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H53-001",
      "term": "마취가스",
      "definition": "호흡기로 흡입하여 마취작용을 나타내는 가스 즉 흡입마취제를 말하며, 아산화질소(N₂O), 크세논(Xenon), 할로탄(Halothane), 엔플루란(Enflurane), 이소플루란(Isoflurane), 세보플루란(Sevoflurane), 데스플루란(Desflurane) 등이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H53-01",
      "processOrder": 1,
      "processName": "작업환경관리 - 환기 및 가스 제거 시스템 설치·운영",
      "safetyMeasures": "누출마취가스를 제거하기 위해 수술실에 마취가스 제거 시스템을 설치한다. 수술실에 시간당 3회의 신선공기 환기를 포함하여 시간당 15회 정도 환기를 하도록 한다. 회복실에는 시간당 2번의 신선공기 환기를 포함하여 시간당 6회 환기를 실시한다. 마취기, 호흡 회로, 누출 마취가스 제거 시스템을 항상 적절하게 유지한다.",
      "requiredPPE": [],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "WP-H53-02",
      "processOrder": 2,
      "processName": "수술 전 마취장비 점검",
      "safetyMeasures": "환자의 호흡 경로(Breathing circuit)를 일일 기계 점검표로 확인한다. 수술실 환기 또는 지역 환기 시스템을 작동시킨다. 가스 배출 시스템과 마취 장비와의 연결을 확인한다. 능동적 제거 시스템이 있는 천장부착형 후드 하에서 기화기(Vaporizer)를 채운다.",
      "requiredPPE": [],
      "sourceSection": "6.2",
      "relatedSR": [
