  "checklistItems": [
    {
      "identifier": "CI-M168-001",
      "text": "헤드 박스 내에서의 작업은 제한된 공간에서의 작업이므로 적절한 환기에 주의하고 필요한 경우 방독면 등을 착용하여야 한다.",
      "guideContext": "헤드 박스 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "헤드 박스 유지관리 및 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-002",
      "text": "노출된 구동축, 교반기(Agitator), 배플 롤(Baffle roll) 등은 가드로 보호하여야 한다. 가드에는 조정을 위하여 공구를 넣을 수 있는 홈을 마련하여야 한다. 홈은 손이 들어갈 수 있을 정도로 커서는 안 된다.",
      "guideContext": "헤드 박스 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "헤드 박스 유지관리 및 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-003",
      "text": "헤드 박스 뚜껑이 열려 있을 때 뚜껑을 안전하게 유지하는 수단을 제공하여야 한다.",
      "guideContext": "헤드 박스 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "헤드 박스 유지관리 및 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-004",
      "text": "접촉에 의한 상해를 방지하기 위하여 작업자에게는 적절하고 잘 맞는 작업복을 제공하여야 한다.",
      "guideContext": "헤드 박스 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "헤드 박스 유지관리 및 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-005",
      "text": "청소나 조정을 위하여 접근할 수 있는 작업대와 통로를 구비하여야 한다.",
      "guideContext": "헤드 박스 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "헤드 박스 유지관리 및 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M168-006",
      "text": "유지관리나 청소를 위하여 박스 내에 들어갈 때에는 모든 동력(전력, 유압, 공압 등)이 차단되고, 모든 저장밸브가 차단된 것을 확실하게 하기 위하여 작업허가제를 실시할 필요가 있다. 또한 관련자들에게 작업허가와 차단 과정에 대하여 교육시켜야 한다.",
      "guideContext": "헤드 박스 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "헤드 박스 유지관리 및 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-007",
      "text": "헤드 박스 근처를 우선적으로 청소하여야 한다.",
      "guideContext": "헤드 박스 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "헤드 박스 유지관리 및 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-008",
      "text": "카우치 롤의 구멍의 패턴을 변경하거나 실(Seal)을 정기적으로 유지관리 하는 경우 소음을 상당히 낮출 수 있다.",
      "guideContext": "철망부 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M168-009",
      "text": "소음을 줄이기 위하여 진공 시스템을 적절히 유지관리 하여야 한다.",
      "guideContext": "철망부 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M168-010",
      "text": "철망교환을 위한 안전 작업절차를 마련하여야 한다. 절차에는 철망의 인력운반에 관련된 사항도 포함하여야 한다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망 교환",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-011",
      "text": "철망 교환을 위하여 안전하게 접근할 수단과 작업대를 제공하여야 한다.",
      "guideContext": "철망부 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "철망 교환",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M168-012",
      "text": "작업자가 철망 모서리에 접촉되는 것을 방지하기 위하여 방호조치를 하여야 한다. 경고문만으로는 충분하지 않다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-013",
      "text": "작업을 쉽고 안전하게 하기 위하여 철망교환 작업에 참여하는 작업자들 사이에 무선 통화를 할 수 있게 하여야 한다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망 교환",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-014",
      "text": "철망과 철망 롤 사이, 철망과 카우치(Couch) 사이의 닙(Nip)에 대하여 방호조치를 하여야 한다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-015",
      "text": "철망 요동장치, 카우치 또는 다른 롤에 대한 구동장치는 고정식 가드로 전체를 방호하여야 한다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-016",
      "text": "고압 사워기에 대한 접근이 가능한 경우 접근을 방지하기 위하여 고정식 가드를 설치하여야 한다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-017",
      "text": "유지관리를 하기 위하여 사워기를 격리시키고 차단하는 수단을 제공하여야 한다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망부 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-018",
      "text": "철망 아래의 피트에 빠질 위험이 있는 경우는 이를 방지하기 위하여 철망 둘레에 울타리를 설치하여야 한다. 특히 피트가 깊거나 오거가 설치되어 있는 경우는 울타리를 설치하여야 한다. 울타리는 호스를 이용한 청소는 가능하게 하여야 하나 작업자가 위험 부위에 닿는 것은 막을 수 있어야 한다.",
      "guideContext": "철망부 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M168-019",
      "text": "작업자는 안전대 사용 방법 등을 교육받아야 한다.",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-020",
      "text": "철망을 가로지르는 작업대에는 난간, 중간 가로대 및 발판을 설치하여야 한다.",
      "guideContext": "철망부 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "철망부 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M168-021",
      "text": "화학적 세척을 위해서는 안전 작업절차를 마련하여야 한다. 작업절차에는 다음 사항이 포함되어야 한다. (가) 적절한 울타리와 경고사인을 사용하여 관련자에게만 한정하는 영역 (나) 개인 보호복 (다) 교육 (라) 환기 (마) 안전 접근 방법 및 기계적 또는 전기적 동력에 대한 차단 방법 등 다른 위험성에 대한 고려. 꼭 필요한 경우에만 기계를 최저의 속도로 가동시키면서 청소를 하여야 한다. (바) 화학물질을 엎지른 경우의 대응책",
      "guideContext": "철망부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철망부 화학적 세척",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-022",
      "text": "기계의 전방과 후방의 프레스 롤 사이의 닙에 방호조치를 하여야 한다. 방호조치는 작업자가 닙에 닿는 것을 방지할 수 있도록 하여야 한다.",
      "guideContext": "프레스부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프레스부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-023",
      "text": "스트레치 롤과 펠트 운반 롤이 접근가능하다면 방호조치를 하여야 한다.",
      "guideContext": "프레스부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프레스부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-024",
      "text": "접촉되거나 옷이 말려드는 것을 방지하기 위해서 롤의 끝부분의 돌출된 부분을 부드러운 표면을 가진 가드로 보호해야 한다.",
      "guideContext": "프레스부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프레스부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-025",
      "text": "프레스 롤을 교체를 위한 안전 작업 절차서를 제공하여야 한다. 절차서에는 격리, 안전한 들어올리기, 기계 해당 부위에 대한 접근, 안전장치의 교체와 세척에 관한 절차를 다루어야 한다.",
      "guideContext": "프레스부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프레스 롤 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-026",
      "text": "프레스 주변에는 미끄럼 방지 조치를 하고, 우선적으로 청소를 하여야 한다.",
      "guideContext": "프레스부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프레스부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-027",
      "text": "고압의 샤워에 대한 접근을 방지하여야 한다.",
      "guideContext": "프레스부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프레스부 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-028",
      "text": "세척과 닥터 블레이드의 교체를 쉽게 하기 위해 기계를 가로지르는 작업대(Working platform)를 제공한다.",
      "guideContext": "프레스부 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "프레스부 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-029",
      "text": "펠트와 롤을 교체하기 위하여 통로를 제거한 경우는 임시 울타리를 설치하여야 하며, 체인만 설치하는 것은 충분하지 않다.",
      "guideContext": "프레스부 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "프레스 롤 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-030",
      "text": "건조기 실린더에서의 작업은 제한된 공간에서의 작업이므로 환기에 유의하여야 한다.",
      "guideContext": "건조기 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "건조기 내부 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    },
    {
      "identifier": "CI-M168-031",
      "text": "건조 실린더에 연동 가드를 설치하여 기계가 정지하여야 기계 내에 들어 갈 수 있게 할 수 있다.",
      "guideContext": "건조기 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "건조기 내부 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-032",
      "text": "팔이 딸려 들어가는 것을 방지하기 위하여 실린더와 펠트 롤 사이의 간격이 적어도 120 mm이상이 되어야 하고, 닙에 몸 전체가 닿을 수 있는 거리이면 롤 사이의 간격이 500 mm이상 되어야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-033",
      "text": "롤과 고정된 부품 사이에도 (2)의 간격 이상이 되어야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": "실린더와 펠트 롤 사이 간격 120mm 또는 500mm 기준 적용",
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-034",
      "text": "(2) 혹은 (3)에 기술된 간격을 유지할 수 없는 경우는 고정 가드를 설치하여 기계의 전방이나 후방에서 닙에 접근하는 것을 방지하여야 한다. 이때 가드는 파지의 제거와 청소 및 닥터 블레이드의 교환이 가능하게 설계되어야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-035",
      "text": "어떤 설비의 경우 파지의 제거 등을 위하여 느린 속도로 작동할 수 있게 되어 있다. 이렇게 작동하는 경우 한 개의 가드만 열려야 하고 작업자는 위험 영역 내에 다른 사람이 있는지 볼 수 있어야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-036",
      "text": "기계의 전방과 후방으로부터 접근 가능한 펠트와 펠트 롤 사이의 닙은 고정 가드로 보호되어야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-037",
      "text": "통로로부터 기계의 피트 또는 지하실로 떨어질 위험이 있다면 난간을 설치하여야 한다. 난간에서 위험한 부분에 닿을 수 있는 경우 울타리를 설치하여야 한다.",
      "guideContext": "건조기 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M168-038",
      "text": "기계 하부의 펄퍼 위의 통로에 울타리가 설치되어야 한다.",
      "guideContext": "건조기 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M168-039",
      "text": "기계가 피트 위에 설치된 경우 피트에 대한 접근은 기계 내부에 위치하는 계단 또는 사다리로 가능하다. 이런 경우 피트 개개에 대한 가드는 적절하지 않고 연동되는 게이트를 설치하거나 적어도 잠금장치를 설치하여야 한다. 만약 잠금장치가 사용된다면, 열쇠는 책임자가 통제하여야 하고 엄격한 격리 절차를 거쳐 잠금장치를 열어야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 피트 접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-040",
      "text": "기계 후드 승강장치의 고장으로 후드가 낙하하여서는 안 되며, 낙하를 제한하는 장치를 설치하여야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-041",
      "text": "후드를 내릴 때에는 사전 경고음을 울려야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-042",
      "text": "적어도 틈이 500 mm이상이 되도록 하는 등, 후드와 최초 롤 사이에 좁은 틈이 발생되지 않게 하여야 한다.",
      "guideContext": "건조기 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건조기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-043",
      "text": "후드 내에서의 작업은 열 스트레스를 받을 수 있으므로 주의하여야 한다.",
      "guideContext": "건조기 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "건조기 내부 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "CI-M168-044",
      "text": "세척과 닥터 블레이드의 교체를 쉽게 하기 위해 작업대를 설치한다.",
      "guideContext": "건조기 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "건조기 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-045",
      "text": "접근 가능한 코팅 롤들 사이의 닙에는 방호조치를 하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-046",
      "text": "사이즈 프레스에서 기계의 전방이나 후방에서 닙에 작업자가 닿는 것을 방지하기 위하여 방호조치를 하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-047",
      "text": "기계를 가로지르는 통로에서 작업자가 닙에 닿는 경우 기계의 전체 폭에 대하여 방호조치를 하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-048",
      "text": "고정식 닙 바는 적절하지만 연동식 닙 바는 지필의 이송을 방해하므로 적절하지 않다.",
      "guideContext": "사이징과 코팅 기계 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-049",
      "text": "고정식 닙 바가 적절하지 않은 경우 연동식 게이트를 설치하여 기계가 멈춘 경우에만 접근할 수 있도록 할 수 있다.",
      "guideContext": "사이징과 코팅 기계 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-050",
      "text": "지필 이송이 중단된 경우 열리도록 설계된 롤이 열리면 새로운 닙이 발생될 수 있다는 점을 유의하여야 한다. 닙 바는 롤이 열리거나 닫힌 경우 발생되는 닙을 보호할 수 있도록 설계되어야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-051",
      "text": "롤이 열린 경우, 롤 사이 또는 롤과 고정된 부품 사이의 간격이 120 mm보다 작게 되지 않도록 하여야 하고, 작게 되는 경우 방호조치를 하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-052",
      "text": "프레스 부근 영역은 우선적으로 청소를 하여야 하는 영역이다. 청소 시 작동하고 있는 롤에 접근할 필요성을 줄이기 위하여 롤을 정지시킨 후 청소를 하거나 또는 자동 청소장치를 사용하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-053",
      "text": "청소를 위하여 롤을 정지시킨 경우 롤을 손으로 움직여야 하는 등 새로운 위험요인이나 문제를 일으킬 수 있다. 이러한 경우 자동 청소장치나 워터제트 등 원거리에서 청소할 수 있는 방법을 사용할 수 있는지 검토하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-054",
      "text": "롤을 정지시킬 수 없거나 자동 청소장치를 사용할 수 없는 경우 동작 상태의 롤에 대하여 청소를 하게 되는데 이 경우 롤의 속도를 가능한 최저로 유지하여야 하며, 위험성을 감소시킬 수 있는 방안들을 모색하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-055",
      "text": "적절한 도구를 사용하여 닥터 블레이드를 제거하거나 교환하여야 한다. 베임을 방지하기 위하여 적절한 장갑을 사용하여야 하고, 닥터 블레이드를 제거하는 대로 커버를 씌우거나 상자에 보관하여야 하며, 통로에 방치해서는 안 된다.",
      "guideContext": "사이징과 코팅 기계 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "닥터 블레이드 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-056",
      "text": "유해물질의 튀김에 의한 위험성을 감소시키기 위하여 적절한 방호복을 제공하여야 하고, 보안경이나 안면 보호구도 필요한 경우 제공하여야 한다.",
      "guideContext": "사이징과 코팅 기계 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "사이징·코팅 운전",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-M168-057",
      "text": "닙에 대한 접근을 막는 가드를 설치하여야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-058",
      "text": "닙바(Nip bar)가 변형되었거나 고정 볼트가 진동에 의하여 느슨해지지 않았는지 정기적으로 점검하여야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-059",
      "text": "기계의 폭이 3 m가 넘는 경우 닙바는 과도한 변형으로 인하여 유효하지 않을 수 있으므로 위험한 부위에 대한 접근을 방지하기 위하여 가드를 설치하여야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-060",
      "text": "지필 이송의 중단으로 롤을 들어 올린 경우 또 다른 닙이 발생될 수 있음에 유의하여야 한다. 롤 사이에 간격을 최소 120 mm 이상이 되도록 하거나 방호조치를 하여야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-061",
      "text": "테일 피딩(Tail feeding) 시스템을 설치하여야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-062",
      "text": "적절한 도구를 사용하여 닥터 블레이드를 제거하거나 교환하여야 한다. 베임을 방지하기 위하여 적절한 장갑을 사용하여야 하고, 닥터 블레이드를 제거하는 대로 커버를 씌우거나 상자에 보관하여야 하며, 통로에 방치해서는 안 된다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "닥터 블레이드 교체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-063",
      "text": "청소할 때에는 원거리에서 할 수 있는 장비를 사용하여 정지된 기계에 대해서 하여야 하고, 가연성 액체를 사용하지 말아야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-064",
      "text": "정전기를 방지하기 위하여 적절히 접지하고 방전 시스템을 구비하여야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-065",
      "text": "파지를 보내기 위하여 설치하는 바닥의 개구부는 300 mm를 넘지 않도록 가능한 좁게 유지하여야 한다.",
      "guideContext": "캘린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "캘린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-066",
      "text": "적절한 시간 간격으로 틈새부식에 의한 균열이 없는지 검사한다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": "헤드와 셸 사이의 틈새부식(Crevice corrosion) 검사",
      "workProcessPhase": "양키 실린더 정기검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-067",
      "text": "오래된 실린더에 대하여 비파괴검사를 하여 헤드 볼트의 구조 건전성을 확인한다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 정기검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-068",
      "text": "정기적으로 증기의 누설이 없는지 확인하고 누설이 발견되면 가능한 빨리 보수한다. 보수가 늦어질 경우 헤드와 셸 사이가 갈라지거나 국부적으로 응력이 걸릴 수 있다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-069",
      "text": "증기 시스템에 있는 압력분출 밸브는 적절한 안전 마진을 가지게 설정되어야 하며, 적어도 일 년에 한 번씩은 분해검사를 하고 교정을 하여야 한다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-070",
      "text": "프레스 롤에 의하여 양키 실린더에 가해지는 하중을 모니터할 필요가 있다. 로드셀(Load cell)을 사용하면 실시간으로 측정할 수 있다.",
      "guideContext": "양키 실린더 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-071",
      "text": "양키 실린더를 냉각 상태에서 작동시키거나 가열된 상태에서 냉각시키는 작업에 대한 안전 작업 절차서를 구비하고 이를 작업자들에게 훈련시켜야 한다. 경험이 많은 작업자에 대해서도 작업절차를 잘 따르고 있는지 점검하여야 한다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 가열·냉각",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-072",
      "text": "열충격(Thermal shock)에 의하여 갑작스러운 파손이 발생될 수 있으므로 뜨거운 실린더에 차가운 물을 분사하지 말아야 한다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 가열·냉각",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-073",
      "text": "후드에 사용되는 가열시스템은 건조기의 작동과 연동되어야 한다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-074",
      "text": "어떤 양키 실린더의 경우 증기와 응축수가 다시 실린더 내로 들어오는 것이 있다. 이런 실린더 내에서 작업하는 경우 증기와 응축수가 다시 실린더 내로 들어오는 라인을 차단하여야 한다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 내부 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-075",
      "text": "양키 실린더 내에서 작업할 경우 작업자의 체중에 의하여 실린더가 움직일 수 있으므로 적절히 설계된 쐐기를 사용하여 움직임을 방지하여야 한다. 움직임을 방지하기 위하여 닥터에만 의지하여서는 안 된다.",
      "guideContext": "양키 실린더 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 내부 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "10.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M168-076",
      "text": "작업을 위하여 양키 실린더 내에 들아 가는 경우 제한된 공간에서의 작업이 되므로 환기 등에 대하여 주의하여야 한다.",
      "guideContext": "양키 실린더 안전조치",
      "additionalDetail": null,
      "workProcessPhase": "양키 실린더 내부 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "10.2",
      "basedOn": [
        "SR-HEAT-002"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M168-001",
      "term": "헤드 박스(Head box)",
      "definition": "스크린에서 나온 지료를 정류하고, 잘 분산하여 필요한 두께와 속도로 철망 상에서 유출시키는 장치이며 지합(Sheet formation)을 좌우하는데 중요한 역할을 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-002",
      "term": "스크린(Screen)",
      "definition": "종이와 펄프의 제조에서 원질 속에 섞여 있는 결속섬유, 티, 이물 등을 제거하는 체와 같은 역할을 하는 장치이며, 사용 목적 순서에 따라 거친 스크린 또는 1차 스크린, 정선스크린 또는 2차, 3차 스크린 등이 있고, 구조와 원리에 따라 평관식, 회전식, 가압식 등 여러 가지가 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-003",
      "term": "철망(Wire)",
      "definition": "종이나 펄프를 뜨는 데나 지필을 형성하고 탈수하는데 사용하는 철망을 말하며, 재료로는 인청동과 황동을 보통 사용하나 때로는 스테인리스강이나 합성섬유도 사용하며, 지종에 따라서 발의 굵기나 짜는 방식이 달라진다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-004",
      "term": "카우치 롤(Couch roll)",
      "definition": "장망부의 말단이나 환망부의 위에 놓여 있는 롤로, 습지의 물을 짜면서 모포에 습지가 올라붙기 쉽도록 작용하는 롤을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-005",
      "term": "장망초지기(Fourdrinier machine)",
      "definition": "지필 형성부가 무단(Endless)의 긴 철망부로 된 초지기로, 철망부의 망은 플라스틱 제품도 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-006",
      "term": "환망(Cylinder mould)",
      "definition": "원통형의 틀에 철망을 씌운 것으로서 습지필의 형성 및 탈수에 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-007",
      "term": "지필(Web)",
      "definition": "초지기 위에 있는 습지(이를 특히 습지필이라고도 함)나 두루마리에 감은 건조된 종이로서 미완성 또는 재단하지 않은 상태의 종이를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-008",
      "term": "닙(Nip)",
      "definition": "롤과 롤 사이의 선상의 접촉면을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-009",
      "term": "댄디 롤(Dandy roll)",
      "definition": "장망 초지기 철망부의 석션 박스 중간쯤에 설치된 철망을 씌운 청동 롤로, 지면을 평활하게 하고, 탈수에 도움을 주며, 또한 철망에 무늬를 넣음으로써 종이에 무늬 또는 투문(Water-mark)을 넣을 수 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-010",
      "term": "릴(Reel)",
      "definition": "초지기에서 나오는 종이를 두루마리식으로 감아내는 장치로 회전형과 표면마찰형이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-011",
      "term": "초지기(Paper machine)",
      "definition": "종이를 뜨는 기계로, 습지를 형성하는 철망부와 프레스부, 건조부로 구성되며, 환망초지기, 단망초지기, 장망초지기, 콤비네이션 초지기 및 각종 포머(Former) 등이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-012",
      "term": "닥터 블레이드(Doctor blade)",
      "definition": "제지공장에서 각종 롤러 및 드라이어에 붙은 습지, 지분 등을 제거하거나 종이에 주름을 넣거나 또는 코팅에서의 과잉의 코팅재를 제거하는 데 사용하는 긴 금속칼날 또는 베이크라이트 관을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-013",
      "term": "양키머신(Yankee machine)",
      "definition": "건조부에 지름이 큰 드라이어 하나로 종이를 말리도록 되어 있는 초지기이며 지필은 양키드라이어 면에서 강한 평면 광택을 낸다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-014",
      "term": "양키 실린더(Yankee cylinder)",
      "definition": "양키 머신의 건조부에 사용되는 지름이 큰 실린더를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-015",
      "term": "캘린더(Calender)",
      "definition": "여러 개의 강철 롤을 포개어 회전시키면서, 그 포갠 사이사이에 종이를 통과시켜서 표면을 평활하고 광택 있게 하는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-016",
      "term": "사이징(Sizing)",
      "definition": "종이의 흡수성을 감소시키고 잉크의 번짐을 방지하며 종이 표면의 평활성을 향상시키기 위하여 하는 작업을 말하며 종이 표면에 사이즈를 도포하는 표면 사이징과 지료 중에 사이즈를 포함시키는 엔진(Engine) 사이징의 두 가지가 있으며, 표면 사이징에는 젤라틴, 카제인 등이, 엔진 사이징에는 로진, 기타 합성수지 등이 일반적으로 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-017",
      "term": "펄퍼(Pulper)",
      "definition": "펄프, 고지, 파지 등을 물에 풀어서 다시 분산시키는 기계로, 통 속의 바닥이나 얼면에 있는 고속으로 회전하는 날개에서 발생되는 와류를 이용하며, 직립형과 수평형이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-018",
      "term": "페이퍼 롤(Paper roll)",
      "definition": "종이를 여러 겹 겹쳐서 고압을 가해서 만든 롤로 수퍼 캘린더에 사용하는 롤이나, 초지기에서 습지나 종이를 유도하여 주행을 순조롭게 하는 롤을 뜻한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-019",
      "term": "프레스 롤(Press roll)",
      "definition": "초지기에서 수분을 압착 제거하는 상하 1조로 된 롤을 뜻한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M168-020",
      "term": "파지(Broke paper)",
      "definition": "초지기에서 초지과정과 완정과정에서 발생하는 불량한 종이를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M168-01",
      "processOrder": 1,
      "processName": "헤드 박스 유지관리 및 청소",
      "safetyMeasures": "제한된 공간 작업으로 적절한 환기 실시, 방독면 착용, 모든 동력(전력·유압·공압) 차단 후 작업허가제 실시, 노출 구동축·교반기에 가드 설치, 작업대와 통로 구비",
      "requiredPPE": [
        "방독면",
        "작업복"
      ],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-M168-02",
