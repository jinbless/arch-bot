  "checklistItems": [
    {
      "identifier": "CI-C78-001",
      "text": "옹벽 기초형식을 결정시에는 지형 및 지반조건을 충분히 검토하고 구조형식과 시공조건을 고려하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-002",
      "text": "옹벽공사 작업계획은 작업장소의 여건과 설계도서(도면 및 시방서)등을 검토하여 안전한 작업계획을 수립하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-003",
      "text": "모든 단위공정은 사전 위험성평가를 실시하여 잠재 위험요인에 대한 안전대책을 수립하여 관리하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-004",
      "text": "작업장의 지형, 지반 및 지층상태 등에 대한 사전조사를 실시하여 작업계획서를 작성하고, 근로자에게 주지시켜야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-005",
      "text": "작업계획서 작성시 비계, 거푸집, 백호, 카고크레인, 펌프카, 다짐기계 등의 사용시 안전성 검토후 작업계획을 수립하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-006",
      "text": "작업계획서는 옹벽(콘크리트 옹벽)공사의 공법에 대한 이해와 경험이 풍부한 작업지휘자가 작업사항을 검토하여 실제 안전작업이 이루어지는지 확인하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-007",
      "text": "차량계 건설기계 사용시 작업반경 내에는 근로자 출입금지 조치 및 신호수 배치 등 접촉 및 충돌방지 조치를 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-008",
      "text": "차량통행이 많은 도로 등의 장소에서 작업시에는 교통처리계획을 수립하여 안전 시설물의 설치 및 신호수를 배치하고 작업을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-009",
      "text": "순간 풍속이 초속 10미터를 초과하여 근로자에게 위험을 미칠 우려가 있는 경우에는 즉시 작업을 중지하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 안전사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-010",
      "text": "원지반 굴착시 연약지반인 경우 지반 보강 및 치환작업을 실시하여 지지력을 확보하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-011",
      "text": "터파기 작업전 근로자에게 작업계획서의 내용 및 사용하는 기계기구 확인 작업방법 및 작업순서 등 안전관리사항을 교육을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-012",
      "text": "터파기 작업중 용수, 지하수 등 발생시에는 배수시설을 설치하고 굴착면 및 배면에 우수 등이 유입되지 않도록 관리하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-013",
      "text": "장비를 이용한 터파기 작업시 차량계 건설기계의 장비 진입로와 작업장 주행로를 확보하고 다짐도, 노폭, 경사도 등의 상태를 점검하고 신호수를 배치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-014",
      "text": "장비 사용전 브레이크, 후진경보기 등 안전장치 설치상태 및 운전원의 유자격 여부를 확인하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-015",
      "text": "옹벽 기초 터파기의 완성면이 토사 또는 풍화암인 경우 굴착 지반면의 흐트러짐이 최소화 되도록 하여야 하며 굴착 후 버림 콘크리트를 타설하도록 사전준비 및 계획을 수립하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-016",
      "text": "터파기 작업구간은 접근방지시설, 조명, 경고표지 등과 필요시 보행자 통행로를 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C78-017",
      "text": "작업 중 긴급 상황 발생시에는 관리감독자에게 통보하고 안전조치 완료시까지 해당 작업을 실시해서는 안된다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-018",
      "text": "굴착 공사시 지반의 종류에 따라서 굴착면의 안전구배 기준을 준수 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-019",
      "text": "굴착토나 자재 등을 굴착부 배면에 쌓아 두어서는 안 된다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-020",
      "text": "터파기 구간 주변에 맞음 및 무너짐 위험이 있는 경우에는 작업을 금지하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-021",
      "text": "불안전한 경사면 작업시에는 사면 보호 및 보강 조치후 작업을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "기초 터파기",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-022",
      "text": "철근 절단 작업시 철근이 튀어 근로자가 상해를 입지 않도록 절단기 안전 덮개 부착 여부를 확인하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-023",
      "text": "철근 절곡 작업시 근로자는 철근사이에 장갑이 끼지 않도록 하며, 타인에 의한 작동을 방지하기 위하여 조작 페달에 안전덮개를 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-024",
      "text": "철근을 장비로 인양할 때에는 인양로프를 2지점 이상 결속하고 별도의 유도로프를 설치후 운반하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-025",
      "text": "사용하는 기계기구는 외함 접지를 실시하고 가설전기는 반드시 누전차단기를 설치하여 사용하도록 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-026",
      "text": "장비를 이용하여 철근을 달아 올리거나 내릴 때에는 인양로프의 안전율을 검토하여 작업을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-027",
      "text": "긴 철근을 운반할 때에는 근로자 2인1조가 되어 운반하도록 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-028",
      "text": "철근 1회 운반중량은 남자근로자 20~30kgf, 여자근로자 10~15kgf를 기준으로 운반하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-029",
      "text": "인력운반은 최소화하고 가능한 운반구나 장비를 사용하여 운반하도록 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 가공·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-3-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-030",
      "text": "철근조립시 철근 이음위치에 대하여 충분히 검토하고 철근의 도괴방지를 위하여 강관파이프, 와이어로프, 각재, 조립철근 등으로 버팀재를 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "철근 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-3-2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-031",
      "text": "옹벽 전면의 철근피복두께는 5센티미터 이상으로 하고, 문양거푸집을 사용하는 경우에는 문양홈 깊이를 제외한 두께가 5센티미터 이상이어야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 조립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-3-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-032",
      "text": "작업발판 상부에 문양거푸집 및 자재 보관시에는 하부로 떨어지지 않도록 별도 고정 조치를 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "철근 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-3-2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-033",
      "text": "2미터 이상 고소작업시에는 비계를 조립 설치하거나 별도 작업대를 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "철근 조립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-3-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-034",
      "text": "장철근 설치시 철근지지대를 사용하여 먼저 설치한 철근이 넘어가지 않도록 조치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "철근 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-3-2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-035",
      "text": "옹벽 뒷면부에서의 철근조립 작업시 충분한 작업공간을 확보하여야 하며, 굴착사면 안전성 확보하여 확인후 작업을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "철근 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-3-2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-036",
      "text": "옹벽 상부에서의 철근조립 작업시 작업발판을 설치하기위한 비계를 설치하고 작업발판 단부는 떨어짐 방지용 안전난간대를 설치하여 작업을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "철근 조립",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-3-2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C78-037",
      "text": "거푸집 설치할 경우 콘크리트 타설시 수평력에 충분히 견딜 수 있도록 구조검토 후 조립도를 작성하고 조립도에 의거하여 거푸집을 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5-4-1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-038",
      "text": "거푸집의 운반 및 설치 작업에 필요한 작업장내의 통로가 충분한가를 확인하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-4-1",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C78-039",
      "text": "거푸집 설치에 필요한 재료 및 기구, 공구를 올리거나 내릴 때에는 달줄 및 달포대 등을 사용하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-4-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-040",
      "text": "옹벽작업장 주위에는 작업원 이외의 통행을 제한하고 작업하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-4-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-041",
      "text": "옹벽 거푸집 상부에는 근로자의 떨어짐 방지를 위하여 비계의 작업발판에 안전난간을 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-4-1",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C78-042",
      "text": "거푸집은 옹벽 뒤채움 완료시까지 유지하고 그 후에 해체하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-4-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-043",
      "text": "옹벽 거푸집 하부에는 깔판 또는 깔목을 설치하여 침하방지 조치를 해야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-4-1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-044",
      "text": "거푸집을 사용한 콘크리트면에서 이물질 제거시 부착물 등이 근로자의 안면에 튀어 손상을 입지 않도록 보안경 또는 보안면을 착용하고 작업을 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5-4-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-045",
      "text": "거푸집동바리는 콘크리트 자중 및 시공중에 가해지는 기타 하중에 충분히 견딜만한 강도를 확보 후 해체 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 해체",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-4-2",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-046",
      "text": "해체장소 및 주변지역은 출입금지 구역으로 설정하여 관계자 이외의 출입을 금지시키고, 상하 동시작업은 금지하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-4-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-047",
      "text": "관리감독자는 거푸집 동바리의 해체시기, 해체순서, 해체방법 등을 결정하고 근로자에게 주지시켜야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5-4-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-048",
      "text": "해체작업 근로자는 떨어짐위험이 있는 장소의 작업 시에는 반드시 안전대를 착용하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5-4-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-049",
      "text": "거푸집 해체작업 시에는 관리감독자를 배치하여 관리하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "거푸집 해체",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5-4-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-050",
      "text": "콘크리트를 타설중 거푸집 및 거푸집동바리의 이상 유무를 확인하고 감시자를 배치하여 이상이 발생한 때에는 신속히 안전조치를 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-051",
      "text": "콘크리트는 표면이 수평이 되도록 처야 하며 타설 계획 및 순서에 따라 균형있게 타설하며 1회 타설 높이는 40~50센티미터 이하로 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-052",
      "text": "콘크리트를 한 곳에만 집중적으로 타설시 편심 하중에 의한 거푸집의 변형 및 동바리의 탈락이 발생하지 않도록 균형있게 타설 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-053",
      "text": "타설작업시 콘크리트 치기는 최대 50센티미터로 하고 다짐봉을 아래층 콘크리트 속에 10~15센티미터 넣어서 다짐을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-054",
      "text": "진동기 사용시 지나친 진동으로 인한 도괴에 주의하고 반드시 2인 1조로 작업을 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-055",
      "text": "콘크리트 타설시 콘크리트 분배용 슈트를 사용 할 경우 콘크리트가 작업장 내에 튀지 않도록 주의하여 타설 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-056",
      "text": "연약지반구간 타설작업 시에는 치환 및 다짐작업으로 지반 보강조치를 실시 하여 작업을 진행하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-1",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-057",
      "text": "진동기는 외합접지를 실시하고 가설전기는 반드시 누전차단기를 거쳐 인출토록 배선하고 다짐시 횡방향으로 이동시키지 않아야 하며, 수직으로 고른 간격으로 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-5-1",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-058",
      "text": "펌프카를 사용할 때에는 콘크리트가 비산하는 경우가 있으므로 주의하여 타설하고 작업구간 하부에는 근로자의 출입을 통제하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-059",
      "text": "펌프카는 사용 전 배관상태를 확인하여야 하며, 레미콘트럭과 펌프카와 호스선단의 연결작업을 확인하고 호스길이 4미터를 초과 하여서는 안된다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-060",
      "text": "펌프카 호스선단이 요동되지 않도록 보조로프를 사용하여 확실히 붙잡고 타설을 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-061",
      "text": "펌프카의 붐대를 조정할 때에는 주변 전선 등 지장물을 확인하고 이격 거리(특고압 : 300센티미터 이상)를 준수하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-062",
      "text": "펌프카의 정차시에는 반드시 수평을 유지하여 장비 안전성을 확보 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-063",
      "text": "펌프카 설치시 아웃트리거를 사용할 때 지반의 부등침하로 펌프카가 전도되지 않도록 받침목을 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-064",
      "text": "콘크리트 펌프카와 믹서트럭 작업시 차량유도원을 배치하여 부딪힘 및 깔림을 예방하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-065",
      "text": "경사면 작업시 건설장비의 불시 구름을 방지하기위해 바퀴에 고임목을 설치하고 정지선을 설정하여 후진시 충돌을 예방하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-066",
      "text": "콘크리트의 운반 및 타설장비는 작업전 장비의 성능을 확인하여야 하고 사용전,후 반드시 점검을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "콘크리트 타설",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5-5-2",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-067",
      "text": "배수공 선정시에는 물구멍, 배수 파이프, 브랭킷 배수, 필터 등 효과적인 방법을 선정, 검토하여 적용하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-068",
      "text": "배수파이프 등을 설치할 때에는 자재 운반시 통로 주변 정리정돈을 실시하여 근로자가 걸려 넘어지거나 부딪힘 사고가 발생하지 않도록 조치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-069",
      "text": "배수파이프를 옹벽 전면 되메움 선보다 높게 설치하여 옹벽 배면의 배수처리에 주의하여 원활한 배수가 되도록 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-070",
      "text": "드레인보드 설치시 콘크리트용 타카를 이용하여 고정작업시 타카가 튀어 손상을 입지 않도록 개인보호구를 착용하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-071",
      "text": "배수관 및 파이프 운반, 설치 시에는 반드시 2개소이상 고정하여 자재의 탈락을 방지하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-072",
      "text": "배수관이 콘크리트 타설 후 막힌 경우 이물질을 즉시 제거하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-073",
      "text": "배수파이프 설치 시에는 지하수 수위 및 강우와 침투수에 따른 충분한 사전 안전성 검토하여 배수시설을 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배수작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-074",
      "text": "뒤채움은 콘크리트가 충분히 양생된 후 빠른 시일 내에 실시하되, 배수가 잘 되는 자갈 등 양질의 재료를 사용하고 충분한 다짐을 실시하여 침하 및 지지력 저하를 방지하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-075",
      "text": "뒤채움 작업시 컴팩터 및 래머, 롤러 등 장비 작업 시에는 장비 운행경로, 작업순서, 신호수 배치 등을 포함한 장비작업계획서를 작성하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-076",
      "text": "장비를 이용한 뒷채움 작업시 작업반경내에는 근로자의 출입을 통제하고 유도원을 배치하여 신호를 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-077",
      "text": "옹벽 뒷면으로부터 최소 1미터 이내에는 중장비 불러나 포크레인을 사용해서는 아니되며, 소형 콤팩터나 소형 진동롤러를 사용하고 작업 중 근로자의 부딪힘, 깔림을 예방하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-078",
      "text": "이동식 진동 콤팩터 또는 래머 등을 사용하여 다짐 작업시에는 유경험자를 배치하고 속도준수, 주변통제 등을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-079",
      "text": "뒤채움은 기준이상의 재료를 사용하여 주변지반 및 구조물에 영향을 미치지 않도록 컴팩터 또는 래머 등으로 충분히 다져야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "CI-C78-080",
      "text": "뒤채움 장비 작업시에는 급정지, 급선회를 피하고 운행시 전도에 주의하여 작업을 실시하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-081",
      "text": "강우가 예상될 경우 임시 배수로 설치 및 다짐면에 방수막을 깔아 우수가 침투하는 것을 방지하고 근로자가 이동 중 미끄러지거나 넘어지지 않도록 주의하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-C78-082",
      "text": "옹벽단부 등 근로자의 떨어짐 위험이 있는 장소에서는 안전난간대 및 추락방지망 등을 설치하여야 한다.",
      "guideContext": "콘크리트 옹벽공사",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-C78-083",
      "text": "옹벽 다짐작업시 단부에는 안전거리를 확보하고 근로자의 안전대 부착설비 및 안전대 착용 등에 대한 안전조치를 하여야 한다.",
      "guideContext": "콘크리트 옹벽공사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뒤채움 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-C78-001",
      "term": "옹벽",
      "definition": "토압에 지항하는 가장 일반적인 구조물로 용지의 제한에 따른 토지의 최적 이용을 목적으로 설치하는 구조물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C78-002",
      "term": "콘크리트 옹벽",
      "definition": "절토 또는 성토 비탈면이 흙의 압력으로 인해 붕괴되는 것을 방지할 목적으로 설치한 콘크리트 벽체 구조물을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-COLLAPSE-001"
      ]
    },
    {
      "identifier": "DT-C78-003",
      "term": "시공이음",
      "definition": "이미 시공된 콘크리트에 새로운 콘크리트를 처서 잇기 위해 만든 이음을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C78-004",
      "term": "뒤채움",
      "definition": "구조물 뒷면에 잡석·자갈·콘크리트 등을 채우는 것으로 구조물의 안정을 도모하는 동시에 배면의 배수를 용이하게 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C78-005",
      "term": "배수공",
      "definition": "옹벽의 배면에 모인 우수 및 침투수를 배출시키기 위한 배수구조물을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C78-006",
      "term": "래머(Rammer)",
      "definition": "동력에 의해 다짐판을 진동시켜 자중과 충격에 의해 지반을 다지는 기계이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C78-007",
      "term": "콤팩터(compactor)",
      "definition": "뒤채움 토사에 하중을 가하여 진동, 충격을 줌으로써 보다 무거운 하중에 견딜 수 있도록 지반을 다지기 위한 기계이다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
