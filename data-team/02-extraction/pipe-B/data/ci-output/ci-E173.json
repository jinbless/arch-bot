  "checklistItems": [
    {
      "identifier": "CI-E173-001",
      "text": "인체에 대전된 정전기에 의한 화재 또는 폭발 위험이 있는 경우에는 정전기 대전 방지용 안전화 착용, 제전복 착용, 정전기 제전용구 사용 등의 조치를 하여야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제325조(정전기로 인한 화재 폭발 등 방지) 제2항에 따른 의무사항",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "1",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E173-002",
      "text": "평가시험에서 손목 스트랩의 연속성 및 저항값은 5 MΩ 미만 또는 구매자 지정치를 충족하여야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "평가시험(세부 조항 5.2) 및 수입시험(세부 조항 5.11) 공통 요구사항",
      "workProcessPhase": "전기적 연속성 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E173-003",
      "text": "손목 밴드의 저항값 - 내측은 100 kΩ 이하 또는 구매자 지정치를 충족하여야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "평가시험 전기적 특성 요구사항(세부 조항 5.3)",
      "workProcessPhase": "저항값 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E173-004",
      "text": "손목 밴드의 저항값 - 외측은 10 MΩ 초과이어야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "평가시험 전기적 특성 요구사항(세부 조항 5.3)",
      "workProcessPhase": "저항값 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E173-005",
      "text": "정기 시험에서 손목 스트랩 시스템의 연속성(장착상태) 저항값은 35 MΩ 이하 또는 구매자 지정치를 충족하여야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "구매자가 하한 저항값을 지정하는 경우에는 안전성 등에 대한 고려가 필요하다",
      "workProcessPhase": "손목 스트랩 시스템 연속성 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E173-006",
      "text": "손목 스트랩의 이탈력은 4.4 N를 초과하고 22.6 N 미만의 범위이어야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "손목 스트랩의 접지 코드는 인체의 안전성을 고려하여 장착 중 긴급상황 발생 시 손목밴드에서 분리되는 기능을 가진다",
      "workProcessPhase": "이탈력 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E173-007",
      "text": "접지 코드의 파단강도는 22.6 N을 초과하여야 하며, 접속부 강도는 코드 강도의 66 %를 초과하여야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험 (법령 근거 미확인)",
      "additionalDetail": "접지 접속용 단자 및 손목밴드 접속용 단자와 와이어 간의 기계적 결합 강도 시험",
      "workProcessPhase": "접속의 완전성 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E173-008",
      "text": "접지 코드는 전기적 연속성을 유지할 수 있는 범위에서 제조업체 지정 길이까지 연장 가능하여야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "신축성이 있는 접지 코드(코일 모양의 코드)는 일반적으로 1.5 m~3.0 m의 범위까지 신장 가능",
      "workProcessPhase": "접지 코드의 신장성 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "CI-E173-009",
      "text": "각각의 접지 코드의 수명(문제 발생)은 8000 사이클 이상 또한 전체 시료의 평균 수명은 16000 사이클 이상으로 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험 (법령 근거 미확인)",
      "additionalDetail": "회로 전체의 저항값이 구매자 지정값을 초과하는 경우와 코드의 피복재, 스트레인 릴리프 등의 외관상 문제가 발생한 경우에는 접지 코드에 문제가 발생했다고 간주한다",
      "workProcessPhase": "굴곡수명시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.8.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E173-010",
      "text": "손목 스트랩에는 잘 보이는 위치에 제조업체 명 또는 로고를 엠보싱 가공, 몰드 가공 또는 그 밖에 내구성이 있는 인쇄방법으로 표시한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-E173-011",
      "text": "표준에서 제시하는 한도치 이외의 저항값(5 MΩ 이상의 저항값)을 가진 손목 스트랩은 시인 가능한 특징 또는 저항값을 접지 코드 위 또는 저항을 포함하는 손목 스트랩에 표시한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험 (법령 근거 미확인)",
      "additionalDetail": "통상적으로 저항은 접지 코드에 포함된다",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.10",
      "basedOn": null
    },
    {
      "identifier": "CI-E173-012",
      "text": "시험은 실사용 환경에서 실시하며, 시험 시 온도 및 습도를 기록하여 보고서에 기재한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험 (법령 근거 미확인)",
      "additionalDetail": "시험 결과에 의구심이 있는 경우는 전처리 및 시험을 실온 (23±2) ℃, 상대습도 (12±3) % 하에서 실시한다",
      "workProcessPhase": "시험 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E173-013",
      "text": "이 기준에서 규정하는 순서에 따르는 경우에도 피시험자가 감전될 위험이 있으므로 감전 예방 교육을 실시하는 것이 바람직하다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E173-014",
      "text": "시험을 하는 경우에는 시험장치의 접지 시방서에 따르는 것이 바람직하다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E173-015",
      "text": "저항계 또는 그 밖의 측정기는 직류 7V~100V의 개방회로의 시험전압에서 50 kΩ~100 MΩ의 측정 범위를 가져야 한다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험 (법령 근거 미확인)",
      "additionalDetail": "전기적 연속성 시험 및 저항값 시험에 사용되는 시험장치 요구사항",
      "workProcessPhase": "전기적 연속성 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E173-016",
      "text": "저항계 또는 손목 스트랩 체커를 개방회로에서 7V~100V가 되는 직류 시험전압을 인가하여 50 kΩ~100 MΩ의 저항값을 계측할 수 있고 0.05 mA 전류의 제한이 가능하도록 할 것.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": "손목 스트랩 시스템 연속성 시험 시 피시험자의 감전 방지를 위한 전류 제한",
      "workProcessPhase": "손목 스트랩 시스템 연속성 시험",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.12.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E173-017",
      "text": "각각의 전류제한 저항은 접지 코드와 손목밴드의 접속부 근방에 배치하는 것이 바람직하다.",
      "guideContext": "정전기 대전 방지용 손목스트랩 시험",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.11.4",
      "basedOn": [
        "SR-ELECTRIC-024"
      ]
    }
  ],
