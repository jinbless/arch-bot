      ]
    },
    {
      "identifier": "CI-C85-021",
      "text": "트럭 탑재형 크레인의 아웃트리거 설치 시 아웃트리거를 최대로 확장하고, 지지력을 확보한 견고한 곳에 받침판을 깔고 설치하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 설치",
      "additionalDetail": null,
      "workProcessPhase": "트럭 탑재형 크레인 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-022",
      "text": "절토 및 성토 선단부에 트럭 탑재형 크레인의 거치를 금지하고, 다만 선단부에 거치 시에는 지반의 상태에 따라 충분하게 이격하여 설치하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 설치",
      "additionalDetail": null,
      "workProcessPhase": "트럭 탑재형 크레인 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-023",
      "text": "트럭 탑재형 크레인의 수직 및 수평 균형을 확인하여 맞추어야 한다.",
      "guideContext": "트럭 탑재형 크레인 설치",
      "additionalDetail": null,
      "workProcessPhase": "트럭 탑재형 크레인 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-024",
      "text": "작업 시작 전에 관리감독자는 다음 필요한 사항을 점검하도록 하여야 한다. (가) 권과방지장치나 그 밖의 경보장치의 기능 (나) 브레이크·클러치 및 조정장치의 기능 (다) 와이어로프가 통하고 있는 곳 및 작업장소의 지반상태 (라) 와이어로프 등의 이상 유무 (마) 하역장치, 유압장치 및 턴테이블등 주요부위에 대한 상태",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-025",
      "text": "트럭 탑재형 크레인 이동시 이동경로를 사전에 근로자에게 교육하고, 운전원에게 중량물 취급의 작업계획서에 의한 작업방법, 신호수와 신호방법의 사전협의, 인양 줄걸이 작업 시 주의사항 등을 교육하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-026",
      "text": "인양작업 시 신호수를 배치 여부를 확인해야 하며, 운전원과 신호수의 신호방법을 확인하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-027",
      "text": "작업하는 운전자 또는 작업자가 보기 쉬운 곳에 정격하중, 운전속도, 경고표시 등의 부착상태 및 달기구 정격하중의 표시를 확인하여야 하며, 인양물의 중량을 확인하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-007"
      ]
    },
    {
      "identifier": "CI-C85-028",
      "text": "트럭 탑재형 크레인의 회전반경내에 안전 휀스, 출입금지 표지판 설치 등 관계자이외 근로자 출입을 금지하는 조치여부를 점검하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-029",
      "text": "트럭 탑재형 크레인의 수평도를 확인하고, 아웃트리거의 받침 및 지반의 침하 여부를 점검하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 설치 상태 확인",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-030",
      "text": "트럭 탑재형 크레인을 사용하여 하물을 운반하는 경우에 훅의 해지장치의 설치 상태를 확인하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "CI-C85-031",
      "text": "트럭 탑재형 크레인 명세서에 적혀 있는 지브의 경사각의 범위를 확인하여야 하며, 길이가 긴 인양물을 수평에서 수직으로 세울 필요가 있는 경우에는 인양 반경 증가에 따른 트럭 탑재형 크레인 인양 능력을 사전에 검토하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CRANE-003"
      ]
    },
    {
      "identifier": "CI-C85-032",
      "text": "작업 전에 주변의 고압선, 지상 장애물 등 및 지하매설물 여부를 점검하여야 하며, 고압선은 절연용 방호구의 설치여부를 확인하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-C85-033",
      "text": "강풍 시 사고 위험성이 있으므로 풍속의 크기를 측정하여 확인하고, 순간풍속이 초당 10미터를 초과하는 경우에는 작업을 중지하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-C85-034",
      "text": "근로자가 5킬로그램 이상의 중량물을 들어올리는 작업을 하는 경우에 주로 취급하는 물품에 대하여 근로자가 쉽게 알 수 있도록 물품의 중량과 무게중심에 대하여 작업장 주변에 안내표시를 하며, 취급하기 곤란한 물품은 손잡이를 붙이거나 갈고리, 진공빨판 등 적절한 보조도구를 활용하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 확인",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-C85-035",
      "text": "트럭 탑재형 크레인을 사용하는 경우에 구조 부분을 구성하는 강재 등이 변형되거나 부러지는 일 등을 방지하기 위하여 해당 크레인의 제조자가 제공하는 사용설명서를 준수하여야 한다. 또한 명세서에 적혀 있는 지브의 경사각의 범위에서 사용하도록 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CRANE-003"
      ]
    },
    {
      "identifier": "CI-C85-036",
      "text": "탑승설비를 훅에 매달거나 붐에 부착하는 등의 탑승작업은 절대 금지해야 하고, 인양 작업 시 인양물 위에 근로자가 탑승한 채로 이동을 금지해야 하며, 근로자에게 교육을 시켜야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-037",
      "text": "인양 작업 시 인양물의 무게 중심, 고압선 등 주변 장애물 등을 점검하여야 하며, 슬링벨트의 체결을 견고하게 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-C85-038",
      "text": "긴 자재는 경사지게 인양하지 않고 수평을 유지하여 인양토록 해야 하며, 부딪힘 등을 방지하기 위하여 인양을 유도하기 위한 보조 로프를 사용하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-C85-039",
      "text": "인양작업 시 자재 맞음의 위험구역에 관계 근로자이외의 사람을 출입금지시키고, 자재에 와이어로프 체결이후 자재의 맞음의 위험구역에서 이탈하도록 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-C85-040",
      "text": "트럭 탑재형 크레인의 인양작업 중에 정격하중을 초과하는 하중을 걸어서 사용해서는 아니 되며, 턴테이블 볼트 등 주요 구조부 부속품의 결합상태를 수시로 확인하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-007"
      ]
    },
    {
      "identifier": "CI-C85-041",
      "text": "인양작업을 할 때 트럭 탑재형 크레인의 넘어짐을 방지하기 위하여 아웃트리거의 수평 상태 및 지반의 침하 여부 등 설치 상태를 수시로 점검하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-042",
      "text": "인양용 공구를 이용한 인양작업 중에 와이어로프, 슬링벨트, 훅 안전고리, 훅 해지장치, 샤클의 손상 등을 수시로 점검하여 변형 또는 균열이 있는 사용을 금지해야 하며, 주기적으로 와이어로프, 슬링벨트 등을 교체하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "CI-C85-043",
      "text": "권과방지장치, 비상정지장치 및 과부하방지장치의 불량 및 임의 해지 등 작동상태를 수시점검 하여야 하며, 아웃트리거 용접부의 균열유무 및 침하 유무를 점검하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-044",
      "text": "충전전로의 인근에서 작업 시에는 충전부로부터 300센티미터 이상 이격하거나 신호수를 배치하여 고압선에 접촉하지 않도록 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-C85-045",
      "text": "인양물의 형상, 무게, 특성에 따른 안전조치와 줄걸이 와이어로프의 매단 각도는 60° 이내로 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-C85-046",
      "text": "부재를 인양하여 수평이동시 전선 등 장해물에 접촉할 우려는 없는지 확인하여야 하며, 유도 로프를 끌거나 누르지 않도록 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-047",
      "text": "클램프로 부재 인양 및 철골부재 여러 개를 동시 인양할 경우는 떨어짐의 사고를 방지하기 위하여 KOSHA Guide C-44-2012 (철골공사 안전보건작업 지침)을 따른다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-C85-048",
      "text": "트럭 탑재형 크레인의 턴테이블 볼트 등 부속품의 결합상태를 점검하고, 주요 구조부 용접부의 균열 상태를 수시로 점검하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-049",
      "text": "부재를 인양하여 내려야 할 지점에서 일단 붐대를 정지시켜 흔들림을 멈추게 하고, 인양물을 서서히 내리도록 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-050",
      "text": "아웃트리거는 수평을 유지하여 최대로 확장하고, 받침목은 2단의 초과사용을 금지하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-051",
      "text": "인양작업 중에 감전재해 예방을 위하여 주변에 고압선과 인양물의 간섭상태를 점검하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-C85-052",
      "text": "트럭 탑재형 크레인 적재함에 승·하강 시 뛰어 내리거나 하는 행위를 금지하고, 차에 부착된 발판을 딛고 천천히 이동하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-053",
      "text": "작업 중 운전석 이탈을 금지하여야 한다. 다만, 운전원이 장비를 떠나야 할 경우는 인양물을 지면에 내려놓아야 하고, 구동 엔진 정지 및 브레이크는 고정 상태로 하여 잠금장치를 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-054",
      "text": "인양상태에서 갑작스런 스윙은 작업반경이 증가하게 되어 넘어짐의 위험이 있으므로 천천히 스윙하여야 하며, 갑작스러운 정지를 금하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-055",
      "text": "트럭 탑재형 크레인의 전방으로 양중물 인양작업 시 넘어짐의 위험이 높으므로 전방으로는 작업을 금지하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-056",
      "text": "트럭 탑재형 크레인에 작용하는 충격하중은 슬링 등에 전달되어 붐의 파괴나 넘어짐 사고가 발생 할 수 있으므로 충격하중을 최소화 할 수 있도록 급 가속하는 작업은 피해야 하며, 스윙 시 인양물이 출렁거리지 않게 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    },
    {
      "identifier": "CI-C85-057",
      "text": "인양작업을 할 때에는 신호수와 일정한 신호방법을 정하여 신호하도록 하고, 운전자는 그 신호에 따르도록 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-058",
      "text": "트럭 탑재형 크레인의 안전장치의 이상 및 운전 이상 시에는 운전을 정지하고, 관리감독자에게 통보하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-059",
      "text": "운전원은 차량 후진 시 사각지대에 근로자의 작업여부를 먼저 확인하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양작업 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-060",
      "text": "작업 종료 후 근로자의 넘어짐 사고를 방지하기 위하여 정리정돈을 하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 종료",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C85-061",
      "text": "경사면에 주차를 금지하여야 하며, 붐의 상태를 안전한 위치에 내려 두고, 운전실은 항상 시건장치를 확인하여야 한다.",
      "guideContext": "트럭 탑재형 크레인 인양작업",
      "additionalDetail": null,
      "workProcessPhase": "작업 종료",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-005"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-C85-001",
      "term": "트럭 탑재형(Cargo Crane)",
      "definition": "이동식 크레인의 한 종류로서 불특정 장소에 스스로 이동할 수 있는 크레인으로 동력을 사용하여 중량물을 매달아 상하 및 좌우(수평 또는 선회를 말한다)로 운반하는 설비로서 「자동차관리법」제3조에 따른 화물·특수자동차의 작업부에 탑재하여 화물을 적재, 하역 등에 사용하는 크레인을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C85-002",
      "term": "정격하중",
      "definition": "최대하중에서 훅, 슬링 등의 달기기구의 중량을 제외한 것으로 실제로 인양 가능한 중량이며, 최대하중은 슬링 등의 달기기구의 중량을 포함하여 최대 인양할 수 있는 중량을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CONSTRUCTION_EQUIP-007"
      ]
    },
    {
      "identifier": "DT-C85-003",
      "term": "지브(붐)",
      "definition": "차대에 연결되어 훅을 필요한 위치로 이동할 수 있게 하는 기둥모양의 구조물을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CRANE-003"
      ]
    },
    {
      "identifier": "DT-C85-004",
      "term": "훅",
      "definition": "물건을 걸거나, 끌어당기기 위한 갈고리로 인양 와이어로프를 거는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C85-005",
      "term": "권상, 권하",
      "definition": "권상이란 화물을 달아 올리는 것을 말하고, 권하란 화물을 내리는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C85-006",
      "term": "권과방지장치",
      "definition": "인양용 와이어로프의 일정한계 이상 감기게 되면 자동적으로 동력을 차단하고 작동을 정지시킴으로서 훅이 상부에 부딪히는 것을 방지하는 장치이다.",
      "sourceSection": "5",
      "relatedSR": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "DT-C85-007",
      "term": "과부하방지장치",
      "definition": "정격하중 1.1배 이상의 권상하중이 부하 되었을 때 경보와 함께 자동으로 상승이 정지되는 장치이다.",
      "sourceSection": "5",
      "relatedSR": [
        "SR-CONSTRUCTION_EQUIP-007"
      ]
    },
    {
      "identifier": "DT-C85-008",
      "term": "비상정지장치",
      "definition": "비상시 동력을 차단하여 크레인을 정지시키는 장치이다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C85-009",
      "term": "훅해지장치",
      "definition": "훅으로 부터 줄걸이 로프의 이탈을 방지하기 위해 훅에 설치된 개폐 장치이다.",
      "sourceSection": "5",
      "relatedSR": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "DT-C85-010",
      "term": "하중지시계",
      "definition": "붐의 최 하단에 부착된 경사지시계로 붐의 인출 길이와 각도에 따라 허용하중을 확인할 수 있는 지시장치이다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C85-011",
      "term": "붐 회전방지장치",
      "definition": "주행 시 크레인 상부 회전체를 회전하지 못하도록 고정하는 장치이다.",
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "DT-C85-012",
      "term": "아웃트리거",
      "definition": "전도 사고를 방지하기 위하여 장비의 좌우에 부착하여 전도 모멘트를 효과적으로 지탱할 수 있도록 하는 장치이다.",
      "sourceSection": "5",
      "relatedSR": [
        "SR-CONSTRUCTION_EQUIP-003"
      ]
    }
  ],
