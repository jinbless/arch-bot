  "checklistItems": [
    {
      "identifier": "CI-G41-001",
      "text": "훈증작업구역과 근로자가 미리 지정되어 비인가자의 접근을 차단해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G41-002",
      "text": "훈증작업 후에는 다음 근로자가 유해가스 혹은 훈증 잔여물에 노출되지 않도록 작업구역을 검사하고, 다음 근로자에게 작업내용을 인계하여야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 후 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-G41-003",
      "text": "기술적 관리방법에 대한 정기적인 검사와 결과 검토를 실시하여야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증 평가 검토",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CONFINED-020"
      ]
    },
    {
      "identifier": "CI-G41-004",
      "text": "균열 혹은 파손으로 인해 훈증제가 방출되어 긴급 상황이 발생될 경우에 안전한 훈증제 처리 및 사업장 폐쇄 등 적절한 응급절차가 신속히 이루어져야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "비상 대응",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-G41-005",
      "text": "관련 규정에 따라 흡입량의 한계를 정해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "노출 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-G41-006",
      "text": "발생 가능한 여러 유형의 노출을 생각하여 사업장을 세척하거나 개인보호구 착용 등의 예방조치를 취한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": "다른 경로의 노출에 대한 예방조치",
      "workProcessPhase": "노출 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-G41-007",
      "text": "노출에 대한 예방책으로 보호의를 선택할 때는 훈증가스 침투 방지력과 착용에 대한 안전성 및 편리성을 고려해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-G41-008",
      "text": "훈증작업 구역에 출입하는 근로자는 모두 호흡용 보호구를 착용해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G41-009",
      "text": "이 장비는 가스차단능력이 우수해야 하며, 얼굴 전체를 가릴 수 있어야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": "호흡용 보호구 성능 요건",
      "workProcessPhase": "보호구 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G41-010",
      "text": "사업주는 근로자가 훈증제, 훈증제 생성물질 혹은 그 잔여물에 노출되어 위험상황에 놓이지 않도록 적절한 지침을 마련해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "지침 수립",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-G41-011",
      "text": "근로자 또는 훈증작업의 책임자가 안전한 작업절차와 훈증제 노출 예방방법 그리고 훈증작업 후 사업장 내 환풍 절차를 숙지하여야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "지침 숙지",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-G41-012",
      "text": "근로자 또는 훈증작업의 책임자가 응급상황 시 대응절차를 숙지하여야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "지침 숙지",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-G41-013",
      "text": "근로자에 대한 적절한 훈련은 노출예방에 있어서 매우 중요하다.",
      "guideContext": "훈증작업 시 유해물질 관리 (법령 근거 미확인)",
      "additionalDetail": "훈증제 유해 정도, 작업통제, 보호구 사용·관리, 응급처치 등 훈련 포함",
      "workProcessPhase": "교육·훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G41-014",
      "text": "개인적으로 훈증작업을 하는 경우에도 다른 작업장에서와 마찬가지로 지침 숙지와 적절한 훈련이 수행되어야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "교육·훈련",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-G41-015",
      "text": "훈증제는 반드시 훈증 작업장 내에 보관하고, 인가된 사람만이 훈증제를 다루어야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증제 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-G41-016",
      "text": "위험지역에는 이를 경고하는 안전보건표지를 설치해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-G41-017",
      "text": "훈증제 사용 전에 반드시 노출위험 지역을 정하여야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G41-018",
      "text": "훈증작업 후에는 철저한 환풍과 훈증 및 위험지역에 대한 모니터링을 실행한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 후 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G41-019",
      "text": "사용 후 남은 훈증제 생성물질은 안전하게 모아 처리해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증제 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-G41-020",
      "text": "모든 관리조치가 적절히 사용·적용되기 위해서는 정기적인 검사가 필요하다.",
      "guideContext": "훈증작업 시 유해물질 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G41-021",
      "text": "개인 보호구를 착용한 채로 음식물 섭취나 흡연을 금한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G41-022",
      "text": "훈증작업 종료 후에는 환풍을 철저히 하고, 개인 보호구의 세척도 철저히 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "훈증작업 후 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-G41-023",
      "text": "사업장 내 공기를 채취하여 정기적으로 작업환경을 측정한다. 이 작업은 자격을 갖춘 사람이 수행한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G41-024",
      "text": "훈증작업 중 사업장 내 공기의 훈증제 농도를 검사한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G41-025",
      "text": "사업장 내 공기의 훈증제 농도가 정해진 허용 한계치를 초과했는지 검사한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-G41-026",
      "text": "만일 기준치를 초과했을 경우 작업 종료 후 사업장에 대한 추가조치를 취한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업환경측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.1",
      "basedOn": [
        "SR-CONFINED-020"
      ]
    },
    {
      "identifier": "CI-G41-027",
      "text": "개인 보호구가 사용된 사업장에서는 장비의 기능이 계속 유지되고, 개인 보호구 자체가 오염원이 되지 않도록 각별한 주의를 해야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": "작업 종료 후 개인 보호구를 철저히 세척하여 훈증제가 남아있지 않도록 하고 이를 확인해야 한다",
      "workProcessPhase": "보호구 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G41-028",
      "text": "개인 보호구에 대한 검사는 정기적으로 시행되어야 하고, 상황에 따라서는 횟수를 늘려야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": "사용 전 검사도 필수적이며, 호흡용 보호구는 보다 세밀한 주의가 요구된다",
      "workProcessPhase": "보호구 검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G41-029",
      "text": "만일 결함이 확인되면 즉각적인 개선조치가 필요하다.",
      "guideContext": "훈증작업 시 유해물질 관리",
      "additionalDetail": "개인 보호구 검사 시 결함 발견에 대한 조치",
      "workProcessPhase": "보호구 검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G41-030",
      "text": "안전보건관리에는 개인의 건강기록이 유지되어야 하고, 근로자 자신이 진술하는 건강 이상 징후에 대한 보건 전문가의 질문서가 포함되어야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리 (법령 근거 미확인)",
      "additionalDetail": "보건 전문가는 사업주에 의해 임명된 자격을 갖춘 자를 말한다",
      "workProcessPhase": "안전보건관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G41-031",
      "text": "모든 훈증작업에 종사하는 자에 관한 건강상의 기록정보는 정해진 기간 동안 유지되어야 하며, 노출 및 치료와 관련한 사항이 기재되어 있어야 한다.",
      "guideContext": "훈증작업 시 유해물질 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전보건관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "10.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G41-001",
      "term": "훈증",
      "definition": "식료, 사료, 목재 등을 수입할 때 외국의 동식물이 들어오는 것을 방지하거나 곡물을 장기간 저장할 때 병충해를 방지하기 위하여 약제를 투입하여 유해한 동식물을 구제하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-G41-01",
