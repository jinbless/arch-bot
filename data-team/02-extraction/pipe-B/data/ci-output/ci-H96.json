  "checklistItems": [
    {
      "identifier": "CI-H96-001",
      "text": "지침증례의 진단명, 증상 및 객관적 검사 결과, 질병 발생 시기, 직업력 및 작업 내용 등의 특성을 관찰 및 기록한다.",
      "guideContext": "질병 집단발생 기초조사 - 1단계 지침증례 관찰",
      "additionalDetail": null,
      "workProcessPhase": "지침증례 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-002",
      "text": "환례 정의는 조직학적 검사결과, 실험실 검사결과, 증상 및 이학적 검사소견 등을 포함할 수 있다.",
      "guideContext": "질병 집단발생 기초조사 - 2단계 환례 정의",
      "additionalDetail": null,
      "workProcessPhase": "환례 정의 및 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-003",
      "text": "조사의 원인이 되었던 환자군이 모두 환례 정의에 맞는지 확인하여 맞지 않는 경우를 환례에서 제외시킨다.",
      "guideContext": "질병 집단발생 기초조사 - 2단계 환례 정의",
      "additionalDetail": null,
      "workProcessPhase": "환례 정의 및 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-004",
      "text": "기초 조사에서는 정해진 환례정의를 일관되게 유지하는 것이 중요하다.",
      "guideContext": "질병 집단발생 기초조사 - 2단계 환례 정의",
      "additionalDetail": null,
      "workProcessPhase": "환례 정의 및 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-005",
      "text": "관심집단 내, 주로 한 사업장 내에서 2단계에서 정한 환례 정의에 따라 지침증례 이외의 환례를 추가로 찾아낸다.",
      "guideContext": "질병 집단발생 기초조사 - 3단계 추가 환례 탐색",
      "additionalDetail": null,
      "workProcessPhase": "추가 환례 탐색",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-006",
      "text": "분모에 해당하는 위험집단을 정의한다. 위험집단은 보통 일정 기간 내의 같은 사업장의 근로자들 또는 같은 공정의 근로자들로 정하게 된다. 이때 분모를 지침증례 주변으로 과도하게 제한하여 인위적으로 발생수준이 높게 계산되지 않도록 주의가 필요하다. 근로자마다 관찰된 시간(일정 기간 내에 포함된 시간)을 곱하여 인년을 계산하여 분모로 이용한다.",
      "guideContext": "질병 집단발생 기초조사 - 4단계 초과발생 여부 확인",
      "additionalDetail": null,
      "workProcessPhase": "초과발생 여부 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-007",
      "text": "분모와 분자를 이용하여 평가된 발생수준을 전체 국민에서의 발생수준 또는 기존의 역학적 연구에서 보고된 발생수준과 비교한다.",
      "guideContext": "질병 집단발생 기초조사 - 4단계 초과발생 여부 확인",
      "additionalDetail": null,
      "workProcessPhase": "초과발생 여부 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-008",
      "text": "환례 정의에 맞는 환자들을 모두 정하였을 때 더 이상 초과발생이 의심되지 않는다면 관련된 근로자, 사업주 및 지역사회와 조사결과를 공유한다.",
      "guideContext": "질병 집단발생 기초조사 - 4단계 초과발생 여부 확인",
      "additionalDetail": null,
      "workProcessPhase": "초과발생 여부 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-009",
      "text": "정의된 모든 환자군에서 상세한 직업력을 파악하고 소속 공정, 작업장 내 위치와 이미 알고 있는 유해요인 노출에 대한 정보를 조사한다.",
      "guideContext": "관련성 조사 - 5단계 작업장 노출 조사",
      "additionalDetail": null,
      "workProcessPhase": "작업장 노출 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-010",
      "text": "인사자료, 작업환경측정자료 등 이용 가능한 자료를 통해 노출기간, 총 노출량, 최대노출수준을 파악한다.",
      "guideContext": "관련성 조사 - 5단계 작업장 노출 조사",
      "additionalDetail": null,
      "workProcessPhase": "작업장 노출 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-011",
      "text": "이용 가능한 자료가 없거나 추가적인 정보가 필요한 경우 산업위생학적 평가를 통해 필요한 노출에 대한 정보를 얻는다.",
      "guideContext": "관련성 조사 - 5단계 작업장 노출 조사",
      "additionalDetail": null,
      "workProcessPhase": "작업장 노출 조사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-012",
      "text": "정의된 환자군들이 공유하는 노출환경을 찾아 노출과 질병의 관련성에 대한 가설을 설정한다.",
      "guideContext": "관련성 조사 - 6단계 가설의 설정",
      "additionalDetail": null,
      "workProcessPhase": "가설의 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-013",
      "text": "가설을 검증하기 위해 비노출군을 포함한 연구를 수행하며 이 단계에서의 연구설계으로는 비교적 손쉽게 시행할 수 있는 단면연구 또는 환자대조군연구가 적당하다.",
      "guideContext": "관련성 조사 - 7단계 역학적 방법을 통한 가설의 검증",
      "additionalDetail": null,
      "workProcessPhase": "역학적 방법을 통한 가설의 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-014",
      "text": "직업과 노출에 대한 정보 뿐 아니라 성별, 연령, 흡연 등 생활습관, 가족력, 사회경제적 위치 등 관심 질병에서 혼란변수로 작용할 수 있는 정보에 대해서도 수집하고 통계분석에서 고려되어야 한다.",
      "guideContext": "관련성 조사 - 7단계 역학적 방법을 통한 가설의 검증 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "역학적 방법을 통한 가설의 검증",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-015",
      "text": "집단발생에 대한 조사의 모든 단계에서 효율적인 리스크 커뮤니케이션이 이루어질 수 있도록 체계를 갖추어야 한다.",
      "guideContext": "집단발생 조사 시 고려사항 - 리스크 커뮤니케이션 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-016",
      "text": "매 단계의 진행 또는 조사 종료 시에 조사의 과정과 결과가 관련된 이해관계자들에게 투명하게 공개되어야 한다. 또한 요청이 있을 시는 이해관계자의 참여하에 조사가 진행되게 한다",
      "guideContext": "집단발생 조사 시 고려사항 - 리스크 커뮤니케이션 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H96-017",
      "text": "조사를 진행하는 중에 질병의 원인으로 의심되는 위험요인이 드러나는 경우 인과성에 대한 완전한 규명 이전에 먼저 근로자의 추가적인 노출이 없도록 조치를 취하도록 한다.",
      "guideContext": "집단발생 조사 시 고려사항 - 추가 노출로부터의 근로자 보호",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H96-001",
      "term": "집단발생",
      "definition": "일정한 시간적, 공간적 경계 내의 집단에서 어떤 건강 문제가 평상시와 달리 많이 발생하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H96-002",
      "term": "지침증례",
      "definition": "집단발생 조사군에서 처음 나타난 환자로 조사를 시작하게 되는 계기가 된 환자(들)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H96-003",
      "term": "환례 정의",
      "definition": "집단발생 조사 시에 환자군(환례)으로 포함시킬 일정한 조건에 대한 정의를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H96-004",
      "term": "위험집단",
      "definition": "집단발생을 평가하기 위한 질병 발생 수준을 계산할 때 사용되는 분모로서 일정한 시간적, 공간적 경계 내에서 해당 질병이 발생할 가능성을 가진 집단을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H96-005",
      "term": "초과발생",
      "definition": "관심집단에서의 질병수준이 평상시의 발생 수준 즉, 전체 인구에서의 발생수준과 같은 참고치보다 많이 발생하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H96-006",
      "term": "리스크 커뮤니케이션",
      "definition": "위험의 평가자와 관리자 및 관련된 이해집단 간에 정보와 의견을 공유하는 상호소통의 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
