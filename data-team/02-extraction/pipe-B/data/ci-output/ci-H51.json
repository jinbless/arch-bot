  "checklistItems": [
    {
      "identifier": "CI-H51-001",
      "text": "근로자들에게 질환별 특징, 고위험군을 교육하여 자가 보호에 도움이 되도록 한다.",
      "guideContext": "피부감작물질 노출 근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-002",
      "text": "노출되는 부위에 대한 세척 방법을 기본적으로 숙지하도록 한다.",
      "guideContext": "개인 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-003",
      "text": "노출되는 물질 또는 공정에 따른 피부 보호구를 착용한다.",
      "guideContext": "개인 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-004",
      "text": "피부의 감작을 일으킬 수 있는 물질을 사용하는 업무나 광노출 작업에 새로 배치되거나 종사하는 도중 또는 업무 후 휴식 중 다음의 증상이 있는지 확인한다.",
      "guideContext": "개인 관리 (법령 근거 미확인)",
      "additionalDetail": "피부 가려움 또는 통증, 피부의 발적, 물집, 급작스러운 입술의 부종 또는 피부 두드러기, 작업 중 또는 작업 후 가슴답답함 또는 어지러움",
      "workProcessPhase": "개인 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-005",
      "text": "만약 이런 증상이 발생하는 경우 해당 사업장 또는 사업장 보건관리자에게 알리고 의사의 진단을 받도록 한다.",
      "guideContext": "개인 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개인 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-006",
      "text": "기본적으로 개인위생을 철저히 하는 것을 교육하는 것이 우선되어야 한다. 노출되는 부위에 대한 세척 방법을 교육한다. 특히 자주 세척을 하는 장소에 근로자의 노출 물질에 따라 세척방법을 고지한다.",
      "guideContext": "사업장 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-007",
      "text": "근로자들이 노출되는 물질 또는 공정에 따라 피부 보호구에 대한 선택을 한다.",
      "guideContext": "사업장 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-008",
      "text": "자주 마찰 또는 마밀되는 경우 가죽 장갑을 제공하고, 경도의 작업에는 면장갑으로 충분하다.",
      "guideContext": "사업장 관리 - 보호구 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-009",
      "text": "네오프렌(Neoprene), 니트릴 부타디엔(Butadiene nitrile), 비닐(Vinyl)이 코팅된 장갑은 물리적 손상, 화학물, 유기용제, 분진 등에 노출될 때 유용하다.",
      "guideContext": "사업장 관리 - 보호구 선택",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-010",
      "text": "강한 화학용제에 노출되는 경우 장갑으로는 불충분하며 이런 물질에 노출되지 않도록 보호막을 설치하는 등 환경 개선을 하는 것이 중요하다.",
      "guideContext": "사업장 관리 - 보호구 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-011",
      "text": "보호 의복 이외에도 보호 크림들을 이용할 수 있다(예: 자외선 노출자에 대한 자외선 방지 크림, 외부 작업을 하는 경우 동물 및 벌레 손상에 대한 방지 크림 등). 하지만 보호 크림을 사용하다가 보호크림에 의해 발생되는 자극성 접촉피부염과 같은 의인성 손상에 대한 주의가 필요하다.",
      "guideContext": "사업장 관리 - 보호구 선택",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-012",
      "text": "만약 자주 습윤 환경에 노출되는 직업(간호사 등)의 경우 손위생을 위해 비누를 이용하는 것 보다는 알코올이 포함된 소독제를 사용하는 것이 추천된다.",
      "guideContext": "사업장 관리 - 보호구 선택",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-013",
      "text": "6.1.1의 (3)항의 피부감작증상을 보이는 근로자의 보고를 받은 경우 작업환경 및 근로자의 노출 물질의 물질안전보건자료를 제공한다.",
      "guideContext": "사업장 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-014",
      "text": "6.1.1의 (3)항의 피부감작증상을 보이는 근로자의 보고를 받은 경우 지체없이 의사의 진단을 받도록 조치한다.",
      "guideContext": "사업장 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-015",
      "text": "피부 감작물질 노출 작업 및 업종의 보건관리자는 근로자의 위생 및 발생가능한 피부질환에 대한 교육, 피부 보호구의 선택과 피부 증상자의 관리를 담당한다.",
      "guideContext": "보건관리자 조치사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리자 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-016",
      "text": "피부질환의 진단방법을 숙지하여 근로자가 조기 진단과 치료를 받을 수 있도록 돕는다.",
      "guideContext": "보건관리자 조치사항 (법령 근거 미확인)",
      "additionalDetail": "피부감작물질 노출 근로자에 대한 진단은 산업의학적인 병력, 발진의 관찰, 질병의 경과, 보조적 임상검사 등을 통하여 이루어진다.",
      "workProcessPhase": "보건관리자 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-017",
      "text": "직업성 피부염의 진단에서 가장 중요한 것은 철저하고 상세한 임상적인 병력을 청취하는 것이다. 피부질환을 진단하고 그 피부질환이 작업과 관련성이 있다는 것을 증명하여야 최종 진단을 내릴 수 있다.",
      "guideContext": "보건관리자 조치사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리자 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-018",
      "text": "보건 관리자는 피부질환이 발생한 근로자의 근로자가 취급하는 모든 화학물질과 물질안전보건자료를 평가하며, 또한 피부염이 발생된 시기나 장소, 근무 행태를 확인한다. 또한 취급물질 및 공정, 제조 및 사용방법, 온도, 습도 등의 물리적 환경, 보호구 착용 상태 등도 확인할 필요가 있다.",
      "guideContext": "보건관리자 조치사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리자 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-019",
      "text": "6.1.1의 (3)항의 피부감작증상을 보이는 근로자의 보고를 받은 경우 지체없이 의사의 진단을 받도록 조치한다.",
      "guideContext": "보건관리자 조치사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건관리자 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-020",
      "text": "첫째로, 세균 및 바이러스에 의한 감염, 종양, 아토피성 피부염 등을 진단에서 배제한다. 둘째로 시간적 선후 관계를 확인하고 감작물질을 찾기 위한 검사를 시행한다. 마지막으로 감작물질을 제거하거나 노출시키지 않은 후에 피부 증상이 좋아지는 것을 확인한다.",
      "guideContext": "작업관련성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관련성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-021",
      "text": "피부감작물질 노출 근로자에 대하여 배치 전 건강장해 예방을 위해 예방조치에 대한 교육 및 지도를 실시한다.",
      "guideContext": "업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-022",
      "text": "피부감작물질 배치 후 작업 개시 1주일 내에 근로자의 눈, 점막, 피부 등의 외부 징후와 가려움, 화끈거림 등의 증상을 확인하며 증상자의 경우 의사의 상담을 받도록 한다.",
      "guideContext": "업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-023",
      "text": "피부감작물질이 추가되거나 공정이 변화한 경우 작업 개시 1주일 이내에 상기 징후를 확인하되 이후에도 상기 증상 및 징후가 있는 근로자는 수시건강진단을 통해 의사의 상담을 실시한다.",
      "guideContext": "업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-024",
      "text": "아토피습진의 과거력이 있는 근로자에게 접촉 피부염의 예방을 위한 업무 제한을 추천하지는 않는다. 단, 광알레르기성 피부질환의 과거력이 있거나 백반증이 있는 경우 햇빛에 노출되는 외부 작업을 하는 데 있어 업무 제한이 필요하다.",
      "guideContext": "업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-025",
      "text": "피부 감작물질에 노출되어 알레르기성 피부질환이 있는 근로자는 피부 질환을 일으켰던 피부 감작물질에 노출되는 동일한 작업을 회피하는 것이 원칙이다. 따라서 근로자의 동의하에 업무 전환을 실시한다.",
      "guideContext": "작업복귀 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업복귀",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-026",
      "text": "동일 피부 감작물질이어도 공정이 변화된 경우 또는 적합한 작업이 없는 경우 동일 직종에 종사하도록 한다. 단, 작업 복귀 후 사업장 건강 관리 의사에 의해 작업 복귀 후 1주일 내에 초기 건강진단을 실시하며, 의사에 의한 차후 추적 검사 기간을 정한 경우 동일 작업에 복귀시킬 수 있다.",
      "guideContext": "작업복귀 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업복귀",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H51-027",
      "text": "1항에 의해 추적 검사를 실시한 경우에도 지속적인 피부 증상을 호소한 경우 근로자와 협의 하에 업무 전환을 실시한다.",
      "guideContext": "작업복귀 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업복귀",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H51-001",
      "term": "피부감작물질",
      "definition": "인체의 과민 반응(또는 민감성 면역 반응)을 일으킬 수 있는 물질을 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
