    {
      "identifier": "ES-CC11-043",
      "equipmentName": "가스/증기용 안전밸브 오리피스 (임계흐름 계산식)",
      "specifications": {
        "formula_MKS_식1": "A = 131.6W√(TZ) / (CKdP1KbKc√M)",
        "formula_FPS_식1": "A = W√(TZ) / (CKdP1KbKc√M)",
        "applicableCondition": "PB ≤ Pcf = P1×[2/(k+1)]^(k/(k-1))",
        "Kd": "0.975",
        "areaUnit_MKS": "mm²",
        "areaUnit_FPS": "in²"
      },
      "sourceSection": "8.2.1",
      "relatedSR": null
    },
    {
      "identifier": "ES-CC11-044",
      "equipmentName": "가스/증기용 안전밸브 오리피스 (비임계흐름 계산식, 일반형/파일롯트형)",
      "specifications": {
        "formula_MKS_식1": "A = 0.179×W/(F2KdKc) × √(ZT/(MP1(P1-P2)))",
        "formula_FPS_식1": "A = W/(735F2KdKc) × √(ZT/(MP1(P1-P2)))",
        "F2": "√((k/(k-1))×r^(2/k)×[(1-r^((k-1)/k))/(1-r)])",
        "applicableCondition": "PB > Pcf, 일반형 및 파일롯트 운전형",
        "Kd": "0.975"
      },
      "sourceSection": "8.2.1",
      "relatedSR": null
    },
    {
      "identifier": "ES-CC11-045",
      "equipmentName": "액체용 안전밸브 오리피스 계산식",
      "specifications": {
        "formula_MKS": "A = 1.178Q√G / (KdKwKcKv√(P1-PB))",
        "formula_FPS": "A = Q√G / (38KdKwKcKv√(P1-PB))",
        "Kd": "0.65",
        "Kw_conventional": "1",
        "pressureUnit_MKS": "barg",
        "pressureUnit_FPS": "psig"
      },
      "sourceSection": "8.2.2",
      "relatedSR": null
    },
    {
      "identifier": "ES-CC11-046",
