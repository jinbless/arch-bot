    },
    {
      "identifier": "DT-CC11-002",
      "term": "설정압력",
      "definition": "운전중에 안전밸브가 열리도록 설정한 안전밸브 입구측에서의 압력을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC11-003",
      "term": "호칭압력",
      "definition": "플랜지의 압력등급을 나타내기 위하여 사용하는 수치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC11-004",
      "term": "일반형 안전밸브",
      "definition": "밸브의 토출측 배압의 변화에 의하여 직접적으로 성능특성에 영향을 받도록 만들어진 스프링 직동식 안전밸브를 말한다.",
      "sourceSection": "3",
