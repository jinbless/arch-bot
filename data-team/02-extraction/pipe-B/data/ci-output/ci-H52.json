  "checklistItems": [
    {
      "identifier": "CI-H52-001",
      "text": "요추불안정증의 진단은 병력 청취, 요통 설문지, 이학적 검사 및 영상의학적 검사를 통해 종합적으로 판단한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": "화이트-관자비 기준(White-Panjabi critieria)을 영상의학적 검사의 주요 기준으로 적용",
      "workProcessPhase": "진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-002",
      "text": "요통의 과거력 등을 포함한 병력 청취를 실시한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "병력 청취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-003",
      "text": "허리통증의 정도를 확인하기 위해 실시한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 - 요통설문지 작성 (법령 근거 미확인)",
      "additionalDetail": "설문 내용은 10개의 문항으로 구성되어 있고 각 문항당 6개 항목으로 이루어져 있다.",
      "workProcessPhase": "요통설문지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-004",
      "text": "평가방법은 항목당 0점에서 5점까지 부여한 뒤 각 항목의 점수를 합한 뒤 50점 만점에 대한 100분율로 점수를 계산한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 - 요통설문지 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "요통설문지 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-005",
      "text": "요추불안정증의 진단을 위한 이학적 검사를 실시한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": "쇼바 검사, 한 발 기립시 요추 신전 검사, 퍼전트 검사, 척추분절 불안정성 검사를 포함",
      "workProcessPhase": "이학적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-006",
      "text": "화이트-관자비 기준(White-Panjabi critieria)는 요추의 안정 시 촬영과 굴곡-신전 운동 시 촬영 모두에서 적용 가능하며, 이에 대한 평가는 <표 2>를 참고하여 총 점수가 5점 이상인 경우 요추불안정증으로 진단한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": "전방구조물 손상(2점), 후방구조물 손상(2점), 영상의학적 기준(4점), 마미손상(3점), 직업상 여건(1점) 항목으로 구성",
      "workProcessPhase": "영상의학적 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-007",
      "text": "업무 평가와 요부근력을 측정할 수 있는 경우에는 이를 측정하여 업무적합성 평가에 활용한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "요부근력평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-008",
      "text": "업무평가를 통해 작업에 요구되는 요부근력을 평가할 수 있는 경우에는 동적 인양 능력평가(Dynamic lifting task)와 같이 해당 작업자의 작업 방식과 유사한 요부근력을 우선적으로 평가하는 것이 바람직하다.",
      "guideContext": "요추불안정증의 업무적합성 평가",
      "additionalDetail": null,
      "workProcessPhase": "요부근력평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-009",
      "text": "동적 인양 능력평가를 하기 어려운 경우에는 단순배근력을 측정하여 요부근력을 평가할 수 있다.",
      "guideContext": "요추불안정증의 업무적합성 평가",
      "additionalDetail": null,
      "workProcessPhase": "요부근력평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-010",
      "text": "요부근력 평가시 허리 통증의 악화 등에 주의해서 실시하여야 한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "요부근력평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-011",
      "text": "요추불안정증의 업무적합성은 다음의 결과를 바탕으로 종합적으로 판단되고 평가되어야 한다. 올바른 평가가 이루어지기 위해서는 의학적 지식, 업무평가능력, 요부근력평가 등의 능력을 갖춘 전문가에 의해 업무적합성 평가가 실행되어야 한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-012",
      "text": "요추불안정증으로 진단받은 경우에도 구체적인 업무평가를 통해서 업무에서 요구되는 요부근력을 파악할 수 있다면, 작업자의 요부근력을 측정하여 일정 수준 이상이 되면 일시적인 작업배치는 가능할 것으로 판단된다.",
      "guideContext": "요추불안정증의 업무적합성 평가",
      "additionalDetail": "여기서 '일시적'이라 함은 6개월 또는 12개월 간격으로 요부 근력강화운동 후 업무적합 여부에 대한 재평가가 필요함을 말한다.",
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H52-013",
      "text": "업무적합성평가의 결과는 산업안전보건법 시행규칙 별지 제85호서식에서 규정하는 근로자 건강진단 사후관리소견서의 업무수행 적합 여부 및 근로자건강진단실시기준(고용노동부고시) 별표 4에서 규정하는 업무수행 적합여부 관정에서 제시한 4가지 관정구분 및 관정내용을 활용하여 작성한다.",
      "guideContext": "요추불안정증의 업무적합성 평가 (법령 근거 미확인)",
      "additionalDetail": "4가지 판정: (가) 현재 조건 작업 가능, (나) 일정 조건 하 작업 가능, (다) 한시적 작업 불가, (라) 현재 작업 금지",
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H52-001",
      "term": "요추불안정증",
      "definition": "척추뼈 중에서 특정 척추뼈가 비정상적인 흔들림이 있는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H52-002",
      "term": "전방구조물의 손상 및 기능부전",
      "definition": "후종인대와 그 앞쪽에 있는 구조물인 척추체, 추간판 등의 손상 및 기능 부전을 말하며 추간판의 퇴행성 변화, 추간판탈출증, 척추 압박골절, 척추체 전방전위증, 추간판 협착증 등이 이에 속한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H52-003",
      "term": "후방구조물의 손상 및 기능부전",
      "definition": "후종인대 뒤쪽에 있는 구조물인 극돌기, 횡돌기, 척추궁 등의 손상 및 기능부전을 말하며 척추분리증 등이 이에 속한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H52-004",
      "term": "시상면 변위(sagittal plane displacement)",
      "definition": "측면상에서 불안정증이 있는 척추체가 하방의 정상 척추체와 비교했을 때 앞/뒤로 밀려 있는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H52-005",
      "term": "시상면 회전각도(Sagittal plane rotation)",
      "definition": "측면 신전-굴절 촬영상에서 굴절과 신전시에 불안정증이 있는 척추체의 상연과 정상 척추체의 상연을 연결하여 형성된 각도의 차이를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H52-006",
      "term": "시상면 굴곡도(Relative sagittal plane angulation)",
      "definition": "측면상에서 불안정증이 있는 추체를 중심으로 인접한 상하 각 요추체와 이루는 각을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H52-007",
      "term": "마미손상(Cauda equina damage)",
      "definition": "하지 마비, 성기능 장애, 방광기능 장애 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
