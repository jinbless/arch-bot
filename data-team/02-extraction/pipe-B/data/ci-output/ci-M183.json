  "checklistItems": [
    {
      "identifier": "CI-M183-001",
      "text": "절단날 및 동력전달부 등 구동부에는 덮개를 설치하고 연동회로를 구성해야 한다.",
      "guideContext": "골절기 톱날 영역 1영역 안전조치 (법령 근거 미확인)",
      "additionalDetail": "자르는 범위 밖의 톱날에 의한 손가락 베임·절단 위험 방지",
      "workProcessPhase": "골절기 설치 및 방호장치 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-002",
      "text": "톱바퀴, 및 띠톱에 들러붙는 고기, 뼈 조각 등을 제거할 수 있는 부착물 제거판을 구비해야 한다.",
      "guideContext": "골절기 톱날 영역 2영역 안전조치 (법령 근거 미확인)",
      "additionalDetail": "자르는 범위에서 톱날에 의한 손가락 베임·절단 위험 방지",
      "workProcessPhase": "골절기 설치 및 방호장치 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-003",
      "text": "손가락 끼임위험을 피하기 위해 덮개를 설치한다.",
      "guideContext": "골절기 톱날 영역 3영역 안전조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "골절기 설치 및 방호장치 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-004",
      "text": "톱바퀴의 위험으로부터 벗어나기 위해 덮개를 설치한다.",
      "guideContext": "골절기 톱날 영역 4영역 안전조치 (법령 근거 미확인)",
      "additionalDetail": "하부와 상부 톱바퀴의 바퀴살에 의한 손 충격위험 방지",
      "workProcessPhase": "골절기 설치 및 방호장치 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-005",
      "text": "톱바퀴 덮개의 재료는 두께 1 mm 이상의 강관 또는 이와 동등 이상의 강도일 것",
      "guideContext": "골절기 톱바퀴 덮개 규격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-006",
      "text": "톱바퀴의 윗면 및 전·후·좌·우의 면을 덮는 구조일 것",
      "guideContext": "골절기 톱바퀴 덮개 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-007",
      "text": "상부의 톱바퀴 덮개는 톱바퀴를 하한 위치까지 낮추었을 경우에도 톱바퀴의 아래 끝까지 덮히는 구조일 것",
      "guideContext": "골절기 상부 톱바퀴 덮개 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-008",
      "text": "피트의 덮개를 겸하는 하부 톱바퀴 덮개의 재료는 두께 3 mm 이상의 강관 또는 이와 동등 이상의 강도일 것",
      "guideContext": "골절기 하부 톱바퀴 덮개 규격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-009",
      "text": "상부 톱바퀴의 덮개에는 띠톱의 파단에 의한 띠톱 및 파편의 비산을 방지하기 위하여 유효한 완충재로 라이닝할 것",
      "guideContext": "골절기 상부 톱바퀴 덮개 라이닝 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-010",
      "text": "상부 톱바퀴의 상부와 덮개의 라이닝 표면과의 간격이 100 mm 이상일 것",
      "guideContext": "골절기 상부 톱바퀴 덮개 간격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-011",
      "text": "상부 톱바퀴의 덮개에는 내면 톱니쪽의 적당한 장소에 톱바퀴로 부터 이탈된 띠톱을 받아 멈추게 하기 위한 톱 받이를 설치할 것",
      "guideContext": "골절기 상부 톱바퀴 덮개 톱 받이 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-012",
      "text": "상부 톱바퀴의 덮개에는 톱바퀴와 띠톱의 위치 관계를 확인하는 투시창을 설치할 수 있다. 다만, 이 경우 투시창은 충분한 강도를 유지해야 한다.",
      "guideContext": "골절기 상부 톱바퀴 투시창",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-013",
      "text": "제품을 톱날까지 밀어 넣을 수 있는 안전밀대를 설치한다.",
      "guideContext": "골절기 톱날 영역 5영역 안전조치 (법령 근거 미확인)",
      "additionalDetail": "미끄러지는 공급대에 의한 손·발 충격 및 끼임위험 방지",
      "workProcessPhase": "골절기 설치 및 방호장치 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-014",
      "text": "상부 톱바퀴 경사장치를 두어 톱바퀴의 경사가 변화되지 않는 구조로 한다.",
      "guideContext": "골절기 구동장치 6영역 안전조치 (법령 근거 미확인)",
      "additionalDetail": "상부와 하부 톱바퀴의 구동장치에 의한 손가락 또는 손의 끼임위험 방지",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-015",
      "text": "바닥면이 평평하도록 고르기를 하며 장애물이 없도록 한다.",
      "guideContext": "골절기 안전성 상실 방지 7영역 안전조치 (법령 근거 미확인)",
      "additionalDetail": "바퀴가 고정된 골절기 또는 탁자 위 기계의 전도 시 신체 충격·끼임위험 방지",
      "workProcessPhase": "골절기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-016",
      "text": "절단위험이 존재하는 절삭공구(예. 톱날 등)를 취급하거나 또는 청소, 운반할 때는 날카로운 부위와 손 접촉을 예방하기 위하여 날카로운 부위를 둘러싼 박스나 방호울을 부착한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "톱날 취급·청소·운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-017",
      "text": "비위생적인 작업바닥의 미끄러움과 장애물에 의한 위험에 주의를 해야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": "피, 고기 잔여물, 기름 잔여물, 장점막 및 장내용물, 물웅덩이 및 얼음에 의한 미끄러움",
      "workProcessPhase": "골절기 작업 전반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-018",
      "text": "골절기는 습한 환경에 노출되어 있어 습식방식의 청소는 전기 감전의 위험을 증가시키므로 주의해야 한다.",
      "guideContext": "골절기 청소 시 감전 예방",
      "additionalDetail": null,
      "workProcessPhase": "골절기 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-M183-019",
      "text": "자르는 영역 밖에서 톱날에 접근하는 것은 방지 하여야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "골절기 절단 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-020",
      "text": "개폐기(Door) 또는 공급대가 10 mm 이상 열렸으면 날은 정지되어야 하고 정지 시간은 4초를 초과하지 않아야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-021",
      "text": "방호 덮개는 톱날의 덮이지 않는 가장 낮은 위치가 최대 105 mm이다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-022",
      "text": "슬라이딩 이송 테이블은 손가락 보호대를 가진 테이블 후방 벽과 함께 제공되어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-023",
      "text": "높이 60 mm 이상의 수형의 조절 가능한 분할관(Portioning Plate)이 준비되어야 하며 분할관은 기울어지거나 뗄 수 있어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-024",
      "text": "높이 150 mm 이상의 최종 절단장치가 장착되어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-025",
      "text": "떼어낼 수 있는 안전밀대가 제공되어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-026",
      "text": "슬라이딩 이송 테이블은 슬라이드나 가이드 레일로부터 튀어나가거나 미끄러져 나가는 것을 방지하기 위해서 설계되어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-027",
      "text": "하부와 상부 톱바퀴날의 물림점에 접근하는 것은 예방되어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-028",
      "text": "하부와 상부 톱바퀴날에 접근하는 것은 예방되어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-029",
      "text": "골절기에 설치된 전기조작부품은 덮개를 덮여야 한다.",
      "guideContext": "골절기 전기 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-M183-030",
      "text": "골절기는 제조자에 의해서 전자기의 방해로부터 충분한 보호력을 가져야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-031",
      "text": "바퀴가 장착된 골절기는 사용설명서를 구체적으로 명시하여야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-032",
      "text": "바퀴가 장착된 골절기는 이동하기 전에 전원을 차단하고 주요 플러그는 뽑아야 한다.",
      "guideContext": "골절기 이동 시 전기 안전",
      "additionalDetail": null,
      "workProcessPhase": "골절기 이동",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-M183-033",
      "text": "전기 공급 케이블은 골절기가 움직일 때 손상되지 않아야 한다.",
      "guideContext": "골절기 이동 시 전기 안전",
      "additionalDetail": null,
      "workProcessPhase": "골절기 이동",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-M183-034",
      "text": "바퀴가 장착된 골절기는 이동시 적절한 위치에 확고히 고정하는 장치가 있어야 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "골절기 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-035",
      "text": "골절기는 소음원의 통제 정보와 기계적 조치가 고려되어야 한다.",
      "guideContext": "골절기 소음 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M183-036",
      "text": "방호울(Casing)에는 개방하지 않으면 톱날에 손가락을 접근할 수 없는 덮개를 설치하고 인터록(Interlock) 한다.",
      "guideContext": "골절기 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-037",
      "text": "인터록을 설치하는 경우 인터록의 안전 관련부의 요구 성능레벨 PL은 KS C IEC 60204-1:2015에 규정된 요구사항을 만족하는 것으로 한다.",
      "guideContext": "골절기 인터록 성능 기준",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-M183-038",
      "text": "골절기는 뼈를 깊숙이 넣기 위한 작업자가 톱날과 접촉하는 위험이 발생하고 이에 대한 방호조치로 이송 손잡이가 날과 직각으로 장착되어 고기가 붙은 뼈를 자를 때 더욱 깊숙이 그리고 안전하게 작업을 할 수 있도록 만들어 준다.",
      "guideContext": "골절기 개선된 방호장치",
      "additionalDetail": null,
      "workProcessPhase": "골절기 절단 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M183-039",
      "text": "골절기의 톱날이 위에서 아래로 움직이면서 자르는 과정에서 뼈에 붙어 있는 살이 물고 내려가면서 절단 제품을 당기게 되어 작업물체에 따라 움직이는 방호덮개가 필요하다.",
      "guideContext": "골절기 개선된 방호장치",
      "additionalDetail": null,
      "workProcessPhase": "골절기 절단 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    }
  ],
