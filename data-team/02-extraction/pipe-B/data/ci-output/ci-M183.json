  "workProcesses": [
    {
      "identifier": "WP-M183-01",
      "processOrder": 1,
      "processName": "골절기 설치 및 방호장치 점검",
      "safetyMeasures": "바닥면이 평평하도록 고르기를 하며 장애물이 없도록 한다. 절단날 및 동력전달부 등 구동부에 덮개가 설치되고 연동회로가 구성되어 있는지 확인한다. 톱바퀴 덮개, 방호울, 안전밀대, 손가락 보호대 등 방호장치의 정상 작동을 확인한다.",
      "requiredPPE": [
        "안전화",
        "보호장갑"
      ],
      "sourceSection": "5.1.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-M183-02",
      "processOrder": 2,
      "processName": "골절기 절단 작업",
      "safetyMeasures": "안전밀대를 사용하여 제품을 톱날까지 밀어 넣는다. 자르는 영역 밖에서 톱날에 접근하는 것을 방지한다. 이송 손잡이가 날과 직각으로 장착된 개선된 방호장치를 사용하여 안전하게 작업한다. 작업물체에 따라 움직이는 방호덮개를 활용한다.",
      "requiredPPE": [
        "보호장갑",
        "안전화"
      ],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-M183-03",
      "processOrder": 3,
      "processName": "골절기 청소",
      "safetyMeasures": "습식방식의 청소는 전기 감전의 위험을 증가시키므로 주의한다. 절삭공구(톱날 등)를 취급하거나 청소할 때는 날카로운 부위를 둘러싼 박스나 방호울을 부착한다. 작업바닥의 미끄러움(피, 고기 잔여물, 기름 잔여물, 물웅덩이, 얼음 등)에 주의한다.",
      "requiredPPE": [
        "보호장갑",
        "안전화"
      ],
      "sourceSection": "6",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "WP-M183-04",
      "processOrder": 4,
      "processName": "바퀴 장착 골절기 이동",
      "safetyMeasures": "이동하기 전에 전원을 차단하고 주요 플러그를 뽑는다. 전기 공급 케이블이 이동 시 손상되지 않도록 한다. 이동 후 적절한 위치에 확고히 고정하는 장치를 사용하여 고정한다.",
      "requiredPPE": [
        "안전화"
      ],
      "sourceSection": "6",
      "relatedSR": [
        "SR-ELECTRIC-001",
        "SR-ELECTRIC-013"
      ]
    }
  ],
