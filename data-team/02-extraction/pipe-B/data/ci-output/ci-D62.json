  "checklistItems": [
    {
      "identifier": "CI-D62-001",
      "text": "디스크는 쉽게 열려야 하고, 상대적으로 낮은 유속에서도 디스크가 정지위치에 견고히 유지되어야 한다.",
      "guideContext": "체크밸브 기능 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-002",
      "text": "체크밸브 전후단의 압력강하는 허용범위 내에 있어야 한다.",
      "guideContext": "체크밸브 기능 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-003",
      "text": "디스크는 감소된 유속 및 부분 개방상태에서도 상대적으로 안정해야 한다.",
      "guideContext": "체크밸브 기능 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-004",
      "text": "디스크는 역류속도가 높은 전이압력을 유발시킬 정도로 충분히 크기 전에 닫혀야 한다.",
      "guideContext": "체크밸브 기능 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-005",
      "text": "디스크는 가능한 한 누설이 발생되지 않도록 기밀성이 좋아야 한다.",
      "guideContext": "체크밸브 기능 요건 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-006",
      "text": "체크밸브의 몸체에는 유체의 흐름방향이 표시되어야 한다.",
      "guideContext": "체크밸브 설치 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-007",
      "text": "스윙 체크밸브를 수직배관에 설치할 때 유량이 위쪽으로 흐르는 지점에 설치하여야 한다. 만약 아래로 흐르는 지점에 설치할 경우 완전히 닫히지 않을 수 있다.",
      "guideContext": "체크밸브 설치 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-008",
      "text": "체크밸브는 차단밸브 대신 기밀의 목적으로 사용되지 않아야 한다.",
      "guideContext": "체크밸브 설치 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-009",
      "text": "웨이퍼 체크밸브 및 스윙 체크밸브는 왕복동 펌프 및 왕복동 압축기의 인입측과 토출측 또는 이와 유사한 맥동이 발생되는 곳에는 적절하지 않다.",
      "guideContext": "체크밸브 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-010",
      "text": "스윙 체크밸브는 병렬로 설치된 펌프 또는 압축기 시스템의 토출측에는 적절하지 않다.",
      "guideContext": "체크밸브 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-011",
      "text": "수직배관에 설치된 체크밸브는 유체가 위로 흐르도록 설치되어야 하며, 체크밸브 위에는 내부유체를 드레인할 수 있는 드레인밸브 또는 드레인 홀(Hole)을 설치할 필요가 있다.",
      "guideContext": "체크밸브 설치 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-012",
      "text": "저압의 유체가 고압의 시스템으로 흐르도록 의도된 경우, 저압측에 체크밸브가 설치되어야 하며, 이 체크밸브의 압력등급(Pressure rating)은 고압측의 등급을 따라야 한다.",
      "guideContext": "체크밸브 설치 시 고려사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-013",
      "text": "고압시스템의 갑작스런 압력강하로 인해 저압측의 유체가 의도되지 않게 고압시스템으로 유입될 수 있으면, 고압시스템에도 체크밸브가 설치할 수 있다.",
      "guideContext": "체크밸브 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-014",
      "text": "펌프 등의 토출측에 압력계기, 체크밸브 및 차단밸브가 필요한 경우에는 펌프 등에서 압력계기, 체크밸브 및 차단밸브의 순으로 설치하는 것이 좋다.",
      "guideContext": "체크밸브 설치 시 고려사항",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-015",
      "text": "간헐적인 서비스용 체크밸브 또는 일체형 시스템(Skid-mounted system)에 설치된 체크밸브를 제외하곤, 호칭경 80A(NPS 3) 이상인 모든 체크밸브의 상류측과 하류측에는 난류영향 배제(Turbulance-free)를 위한 아래와 같은 최소거리 이내에는 배관 피팅류(엘보우, 레듀서, 티 등) 또는 유량제한장치(오리피스, 콘트롤밸브 등)를 설치하지 않는 것이 좋다.",
      "guideContext": "체크밸브 설치 시 고려사항",
      "additionalDetail": "상류측: 배관지름의 5배 거리, 하류측: 배관지름의 2배 거리. 이 거리는 체크밸브 종류 및 제작업체에 따라 다를 수 있다.",
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-016",
      "text": "역류 가능성이 있는 펌프의 토출측에 체크밸브를 설치를 검토할 필요가 있다.",
      "guideContext": "일반적인 체크밸브 설치대상",
      "additionalDetail": "펌프에 최소유량배관(Minimum flow line)이 설치된 경우에는 최소유량배관의 설치지점 후단에 설치하여 펌프 가동정지 시에 최소유량배관을 통한 역류도 함께 방지하는 것이 좋다.",
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-017",
      "text": "압축기 토출측에 체크밸브를 설치를 검토할 필요가 있다.",
      "guideContext": "일반적인 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-018",
      "text": "공정배관 또는 공정설비에 연결된 모든 유틸리티(스팀, 질소, 공기 등) 배관의 연결부에 체크밸브를 설치를 검토할 필요가 있다.",
      "guideContext": "일반적인 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-019",
      "text": "가열로(Fired-heater) 등의 튜브 파열 시에 역류 방지가 필요한 경우 체크밸브를 설치를 검토할 필요가 있다.",
      "guideContext": "일반적인 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-020",
      "text": "반응기 등의 설비에 2개 이상의 배관을 통해 서로 다른 물질이 공급될 때 각 공급물질의 오염(또는 역류)을 방지할 필요가 있는 경우 체크밸브를 설치를 검토할 필요가 있다.",
      "guideContext": "일반적인 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-021",
      "text": "플레어 헤더라인의 연결부 중 역류방지가 필요한 경우 체크밸브를 설치를 검토할 필요가 있다.",
      "guideContext": "일반적인 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-022",
      "text": "왕복동 펌프 및 왕복동 압축기의 토출측에 체크밸브가 필요하며, 일반적으로 설비 제조자에 의해 일체형(Built-in) 체크밸브가 설치되어 제공된다.",
      "guideContext": "왕복동 펌프·압축기·진공펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-023",
      "text": "진공펌프의 인입측에 체크밸브가 필요하며, 일반적으로 설비 제조자에 의해 일체형 체크밸브가 설치되어 제공된다.",
      "guideContext": "왕복동 펌프·압축기·진공펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-024",
      "text": "유체(액체 또는 기체)가 역류될 수 있는 시스템 내로 이송할 경우에는 로타리 펌프, 수직형 원심펌프, 수평형 다단 원심펌프의 개별 토출측 배관에는 체크밸브가 각각 필요하다.",
      "guideContext": "원심펌프·로타리펌프·기어펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-025",
      "text": "토출측의 압력 또는 유량이 펌프의 역회전 손상을 일으킬 수 있는 곳에는 수평형 원심펌프 또는 예비펌프의 공통배관에도 체크밸브가 필요하다.",
      "guideContext": "원심펌프·로타리펌프·기어펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-026",
      "text": "병렬로 운전되는 펌프에는 개별적인 체크밸브가 필요하다.",
      "guideContext": "원심펌프·로타리펌프·기어펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-027",
      "text": "펌프의 최소유량배관(Minimum flow line)이 없는 비중 0.6 (15 ℃) 이하인 가벼운 탄화수소를 이송하는 다단펌프의 토출측에는 각 단마다 체크밸브가 필요하다.",
      "guideContext": "원심펌프·로타리펌프·기어펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-028",
      "text": "펌프 인입측 압력보다 높은 곳으로 연결된 공통 토출배관에는 체크밸브가 필요하다.",
      "guideContext": "원심펌프·로타리펌프·기어펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-029",
      "text": "용량 50 %로 2대 또는 3대의 펌프를 운전하는 시스템에는 개별 펌프의 토출측마다 체크밸브가 필요하다.",
      "guideContext": "원심펌프·로타리펌프·기어펌프 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-030",
      "text": "역회전으로 인해 압축기 또는 구동기의 손상을 초래할 우려가 있는 경우에는 토출측에 체크밸브가 필요하다.",
      "guideContext": "원심압축기·로타리 압축기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-031",
      "text": "압축기 토출측에서 유체가 오염될 때 압축기의 손상을 초래하거나, 압축기 인입측 또는 압축기 지단 토출측의 유체를 오염시킬 우려가 있을 경우에는 토출측에 체크밸브가 필요하다.",
      "guideContext": "원심압축기·로타리 압축기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-032",
      "text": "압축기 후단에서 유체의 온도(고온 또는 저온)가 압축기 설계온도를 초과할 수 있는 경우에는 체크밸브가 필요하다.",
      "guideContext": "원심압축기·로타리 압축기 (법령 근거 미확인)",
      "additionalDetail": "고온은 압축기 토출측 용기의 최대운전온도로 가정하고, 저온은 토출온도 및 토출압력에서 인입압력으로 등엔탈피과정으로 교축(Throttled)되는 것으로 가정하여 계산될 수 있다.",
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-033",
      "text": "압축기 토출측의 역류로 인해 압축기 인입측 또는 저단측에 과압이 발생될 수 있는 경우에는 체크밸브가 필요하다.",
      "guideContext": "원심압축기·로타리 압축기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-034",
      "text": "병렬로 설치된 압축기에는 개별 압축기의 토출측에는 체크밸브가 필요하다.",
      "guideContext": "원심압축기·로타리 압축기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-035",
      "text": "역류가 발생되면 공정 또는 운전상의 문제가 일어날 수 있는 배관에는 역류방지를 위해 체크밸브 설치를 검토할 필요가 있다.",
      "guideContext": "배관 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-036",
      "text": "공정설비 또는 공정배관과 연결된 스팀, 질소, 공기 등의 유틸리티 배관에는 역류방지를 위해 체크밸브 설치를 검토할 필요가 있다.",
      "guideContext": "배관 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-037",
      "text": "스팀트랩의 2차측이 집합관으로 연결되어 있을 때 다른 트랩에서 배출된 응축수가 역류될 가능성이 있는 경우 체크밸브 설치를 검토할 필요가 있다.",
      "guideContext": "배관 체크밸브 설치대상",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치위치 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-038",
      "text": "유틸리티 배관에 체크밸브를 설치할 경우 체크밸브 전단에는 내부물질을 배출하기 위한 드레인밸브를 설치할 필요가 있다.",
      "guideContext": "유틸리티 배관 체크밸브 설치위치",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-039",
      "text": "차단밸브를 1개만 설치할 경우에는 차단밸브 후단에 체크밸브를 설치하는 것이 좋다.",
      "guideContext": "유틸리티 배관 체크밸브 설치위치",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-040",
      "text": "차단밸브를 2개 설치할 경우에는 차단밸브 사이에 체크밸브를 설치하는 것이 좋다.",
      "guideContext": "유틸리티 배관 체크밸브 설치위치",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-041",
      "text": "공정배관에 유틸리티 배관을 연결할 경우 배관의 등급은 체크밸브 또는 체크밸브 후단의 차단밸브까지 공정측 배관의 등급으로 설치하여야 한다.",
      "guideContext": "배관 등급 요건 (법령 근거 미확인)",
      "additionalDetail": "유틸리티 배관의 등급이 공정측 배관의 등급보다 높을 경우에는 공정측 배관에 접속되는 최종 밸브까지 유틸리티 배관의 등급으로 설치하여야 한다.",
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-042",
      "text": "치환 등의 목적으로 유틸리티 배관을 설치하여 특정 시기에만 사용하고 평상 시에 사용하지 않을 경우에는 체크밸브 전단에 스펙터클 블라인드를 설치하여 체크밸브를 통한 누설을 방지할 수 있다.",
      "guideContext": "유틸리티 배관 누설방지",
      "additionalDetail": "드레인밸브의 위치는 필요에 따라 스펙터클 블라인드 전단 또는 후단에 설치할 수 있다.",
      "workProcessPhase": "체크밸브 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-043",
      "text": "수직배관에 설치할 경우 해머링 현상이 발생되기 쉬우므로 가급적 사용하지 않는 것이 좋다.",
      "guideContext": "스윙 체크밸브 적용 시 유의사항",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "부록 1",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-044",
      "text": "밸브 몸체와 디스크의 안내면이 원활하지 않으면 밸브가 닫히지 않는 고착(Cock 또는 Stick)현상이 발생될 수 있으므로 이러한 현상을 완화시키기 위해서는 스프링을 채택한 체크밸브(Spring loaded check valve)로 변경하는 것이 좋다.",
      "guideContext": "리프트 체크밸브 고착현상 방지",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "부록 2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-045",
      "text": "유체가 디스크 및 시트를 통과할 때 생기는 와류에 의해 디스크가 제자리 회전하는 스피닝(Spinning)이 생길 수 있는 경우에는 디스크 상부의 챔버와 밸브 출구 사이를 연결하는 바이패스 배관을 설치하여 디스크가 열릴 때 디스크 상부 챔버의 잔류 유체가 빠져 나가는 구조의 리프트 체크밸브를 선정할 필요가 있다.",
      "guideContext": "리프트 체크밸브 스피닝 방지",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "부록 2",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-046",
      "text": "틸팅 디스크 체크밸브는 균일한 흐름이 예상되는 곳에 사용하도록 권장된다.",
      "guideContext": "틸팅 디스크 체크밸브 적용 조건",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "부록 3",
      "basedOn": null
    },
    {
      "identifier": "CI-D62-047",
      "text": "유체의 흐름이 불균일한 경우에는 계통 운전 중 계속 스프링에 피로응력이 축적되므로 맥동이 예상되는 배관계통에는 신중하게 적용할 필요가 있다.",
      "guideContext": "웨이퍼 디스크 체크밸브 적용 시 유의사항",
      "additionalDetail": null,
      "workProcessPhase": "체크밸브 종류 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "부록 4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-D62-001",
      "term": "체크밸브 (Check valve)",
      "definition": "배관 상에서 오직 한 방향으로 흐름을 유지해야 할 필요가 있는 경우에 역류를 방지하기 위하여 사용하는 밸브를 말하며, 역지밸브 또는 넌리턴밸브(Non-Return valve)라고도 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D62-002",
      "term": "수격현상 (Water hammer)",
      "definition": "유체의 움직임을 갑자기 멈추게 하거나 유체의 방향이 갑자기 바뀌게 될 때 순간적으로 높은 압력이 발생하는 현상을 말하며, 이 때 발생되는 압력은 배관계통에 소음과 진동을 일으켜 문제를 발생시킬 수 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
