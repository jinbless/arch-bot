  "checklistItems": [
    {
      "identifier": "CI-E4-001",
      "text": "장갑, 장화, 바지, 앞치마는 감전이나 화상으로부터 작업자를 보호할 수 있기 때문에 보호 장비는 위험에 적합하게 선택되어야 한다.",
      "guideContext": "아크용접장치 보호장비 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E4-002",
      "text": "용접작업지역에서는 작업자의 눈을 보호하기 위해 보안경을 착용해야 한다.",
      "guideContext": "아크용접 작업 시 눈 보호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E4-003",
      "text": "야외에서 용접을 하려고 할 때, 장치가 물에 대한 적절한 보호기능을 갖도록 한다. 그리고 집중 호우에서의 용접은 피 용접물과 용접기에 덮개를 이용해야 한다.",
      "guideContext": "야외 아크용접 시 장비 보호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E4-004",
      "text": "전극을 제외한 절연된 용접 홀더가 사용되어야 한다. 즉, 노출된 금속이 없어야 하며, 전극홀더를 사용할 경우 굴곡의 영향으로 케이블의 절연 손상이 발생하지 않는 적절한 구조이어야 한다.",
      "guideContext": "아크용접 전극홀더 절연 기준",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-E4-005",
      "text": "용접 도선과 귀로 도선은 용접 전류를 안전하게 흐르도록 충분히 강한 구조와 두께로 절연되어야 한다.",
      "guideContext": "아크용접 도선 절연 기준",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-E4-006",
      "text": "용접 변압기의 내부 절연 고장에 대한 보호를 하기 위하여 피 용접재를 접지해야 한다.",
      "guideContext": "아크용접 피 용접재 접지",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E4-007",
      "text": "피 용접재와 연결되는 접지도체는 기계적 손상을 충분히 견딜 수 있도록 하여야 하고, 볼트나 나사 클램프에 의해 피 용접재와 안전하게 접지단자에 연결되어야 한다.",
      "guideContext": "아크용접 접지도체 기준",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E4-008",
      "text": "피 용접재에 연결된 다른 장비는 안전한 동작을 위해 접지되어야 한다.",
      "guideContext": "아크용접 관련 장비 접지",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E4-009",
      "text": "새로운 장소에서 단상의 용접장치를 사용할 때 올바른 공급전압에 연결되었는지 확인해야 한다.",
      "guideContext": "아크용접장치 전압 확인",
      "additionalDetail": "대부분의 AC 전압 415V 용접 장치는 3상 전원으로부터 2상이 연결된 단상의 장치",
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E4-010",
      "text": "용접설비는 전원공급 장치의 스위치를 효율적이고 편리하게 동작시킬 수 있어야 한다.",
      "guideContext": "아크용접 전원 스위치 조작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E4-011",
      "text": "사용 환경이나 작업 시스템이 구형 용접 변압기 또는 주 정류기를 접지할 수 없다면 추가적인 보호장치를 설치해야 한다. 가장 간단한 것은 주 전원에 설치된 누전차단기이다.",
      "guideContext": "아크용접 접지 불가 시 누전차단기 설치",
      "additionalDetail": null,
      "workProcessPhase": "아크용접장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-004"
      ]
    },
    {
      "identifier": "CI-E4-012",
      "text": "용접 작업자는 일을 시작하기 전에 반지, 팔찌, 시계 등 금속류를 제거해야 한다.",
      "guideContext": "아크용접 작업 전 감전 예방",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E4-013",
      "text": "피 용접재에 접지된 곳에서 전극 홀더를 먼저 분리시키지 않고 전극을 교체할 경우 작업자는 전극과 대지 사이에 적어도 80V 이상의 전격을 받을 우려가 있어 용접용 장갑, 코팅된 전극, 그리고 신발 등의 절연물로 제작된 안전용구를 착용해야 한다. 그리고 작업을 하기 전에 용접자의 감전위험이 있는지 점검해야 한다.",
      "guideContext": "아크용접 전극 교체 시 감전 방지",
      "additionalDetail": null,
      "workProcessPhase": "아크용접 작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-E4-014",
      "text": "짧은 시간 동안 용접을 정지할 경우 의도하지 않은 단락을 예방하기 위하여 전극홀더를 내려놓는 곳을 주의해야 한다.",
      "guideContext": "아크용접 일시 정지 시 전극홀더 관리",
      "additionalDetail": null,
      "workProcessPhase": "아크용접 작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-E4-015",
      "text": "만약 주 전원의 각상으로부터 유도된 3상 용접회로나 단상 용접회로가 사용된다면, 다른 상이나 변압기에 연결된 용접위치는 어디서든지 합리적으로 사용할 수 있도록 구획이나 간격을 두고 분리되어야 한다.",
      "guideContext": "다상 아크용접 회로 용접위치 분리",
      "additionalDetail": null,
      "workProcessPhase": "아크용접 작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E4-016",
      "text": "밀폐된 도전성 장소에서 용접을 할 경우, 가스 질식과 같은 추가적인 위험에 대한 검토와 평가를 해야 한다. 특히, 공기 공급, 가스 배출 그리고 안전로프가 필요하다.",
      "guideContext": "밀폐 도전성 장소 아크용접 위험 검토",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "CI-E4-017",
      "text": "환기에 제한이 없는 곳에서는 전기적인 안전을 위해 절연 안전화를 포함한 보호장비를 착용하여야 한다.",
      "guideContext": "밀폐 도전성 장소 아크용접 보호장비",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "CI-E4-018",
      "text": "건조상태를 유지해야 하는 절연물질로 만든 매트나 칸막이를 사용하여야 한다.",
      "guideContext": "밀폐 도전성 장소 아크용접 절연 방호",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E4-019",
      "text": "감전으로부터 보호받기 위하여 완전히 절연된 홀더를 사용하여야 한다.",
      "guideContext": "밀폐 도전성 장소 아크용접 절연 홀더",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-E4-020",
      "text": "작업장소 외부에 용접 변압기를 배치하여야 한다.",
      "guideContext": "밀폐 도전성 장소 아크용접 변압기 배치",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E4-021",
      "text": "감전을 받은 작업자를 위해 인공호흡을 포함한 응급구조에 숙달된 사람이나 전원을 차단하고 필요한 조치를 취할 수 있는 사람을 작업장 밖에 확보하여야 한다.",
      "guideContext": "밀폐 도전성 장소 아크용접 응급구조 인력",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-021"
      ]
    },
    {
      "identifier": "CI-E4-022",
      "text": "밀폐된 도전성 공간에서는 감전의 위험이 크기 때문에 기기는 적합하게 설계되어야 한다. 교류용접을 사용하는 경우 개방회로의 무부하 전압은 전압 조정장치에 의해 합리적인 제어가 되도록 하여야 한다. 이러한 장비는 전극이 용접면에 접속될 때 약 40V의 개방회로 무부하 전압으로 제한해야 한다.",
      "guideContext": "밀폐 도전성 공간 아크용접 무부하 전압 제한",
      "additionalDetail": null,
      "workProcessPhase": "밀폐공간 용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-E4-023",
      "text": "용접되는 동안 롤러나 동종의 장치를 조작하여 지탱되는 대형구조물이나 선박의 용접에서는 용접 귀로 전류 연결부의 무결성을 확보하기 위해 특별한 주의가 필요하다. 용접 귀로 전류는 유동 바퀴를 통하여 흘러서는 안 된다.",
      "guideContext": "대형구조물 아크용접 귀로 전류 관리",
      "additionalDetail": null,
      "workProcessPhase": "아크용접 작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E4-024",
      "text": "선박을 조립하거나 수리할 경우 선박의 금속 외피는 조선소의 주 접지시스템에 연결되어야 한다. 만약 용접 귀로 연결부가 용접지점으로부터 가까운 거리에 있다면 선박을 통해 흐르는 귀로 전류는 선박 내의 전자제어 시스템이나 컴퓨터의 장애를 일으킬 수 있어 귀로 전선로에 대한 사전 점검이 필요하다.",
      "guideContext": "선박 아크용접 접지 및 귀로 전선로 점검",
      "additionalDetail": null,
      "workProcessPhase": "아크용접 작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-E4-025",
      "text": "작업구역에 존재하는 주변의 가연성 물질을 제거하고 용접이 끝난 후 1시간 이상은 작업장소의 점검이 필요하다.",
      "guideContext": "아크용접 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "용접 후 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-E4-026",
      "text": "비상사태가 발생할 경우 사용할 수 있는 소화기를 구비해야 한다.",
      "guideContext": "아크용접 화재예방 소화기 비치",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-E4-027",
      "text": "검사(유자격)자는 설치기간 중에 장치가 정확히 확인되고 이에 대한 안전조치가 이루어졌는지를 점검하여야 한다.",
      "guideContext": "아크용접장치 설치기간 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 검사 및 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E4-028",
      "text": "작업자는 일일점검을 수행하고, 장비를 안전하고 양호한 상태로 유지 및 확보하기 위하여 사용기간 내내 정기적으로 점검하여야 한다.",
      "guideContext": "아크용접장치 일일·정기 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 검사 및 유지보수",
