  "checklistItems": [
    {
      "identifier": "CI-EG22-001",
      "text": "사업주는 고열작업에 근로자를 종사하도록 하는 때에는 열경련·열탈진 등의 건강 장해를 예방하기 위하여 고열의 위해성을 평가하여야 하며, 평가 시 고열작업의 종류 및 발생원, 고열작업의 성질, 온열특성, 근로자의 작업 활동 및 착용한 의복 형태, 고열관련 상해 및 질병발생 실태, 산업환기설비 등의 설치와 적절성, 근로자의 열순응 정도, 기타 고열환경 개선에 필요한 사항을 고려한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-002",
      "text": "고열의 측정은 기온, 기습 및 흑구온도 인자들을 고려한 습구흑구온도지수(WBGT)로 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-003",
      "text": "사업주는 고열작업에 근로자를 종사하도록 하는 때에는 법 제125조의 규정에 따라 6개 월에 1회 이상 정기적으로 습구흑구온도지수를 측정한다. 다만, 근로자가 열경련·열 탈진 등의 증상을 호소하거나 고열작업으로 인해 건강장해가 우려되는 경우에는 필요에 따라 수시로 측정을 실시할 수 있다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-004",
      "text": "고열은 습구흑구온도지수(WBGT)를 측정할 수 있는 기기 또는 이와 동등 이상의 성능을 가진 기기를 사용한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-005",
      "text": "고열을 측정하는 경우에는 측정기 제조자가 지정한 방법과 시간을 준수하며, 일원마다 측정하되 작업장소에서 일원에 가장 가까운 위치에 있는 근로자 또는 단위작업 장소에서 측정대상이 되는 근로자의 주 작업 위치에서 측정한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-006",
      "text": "측정기의 위치는 바닥 면으로부터 50센티미터 이상, 150센티미터 이하의 위치로 하여야 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-007",
      "text": "측정기기를 설치한 후 일정시간 안정화시킨 후 측정을 실시하고, 고열작업에 대해 측정하고자 할 경우에는 1일 작업시간 중 최대로 높은 고열에 노출되고 있는 1시간을 10분 간격으로 연속하여 측정한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-008",
      "text": "착용복장의 종류에 따라 WBGT 노출기준의 보정을 실시해야한다. 이때 순응된 작업자의 기준은 최소 1주일 이상 노출된 사람을 의미하며, 착용복장에 따른 WBGT 보정값(WBGT eff)은 WBGT + CAF로 산출한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고열 측정 및 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-009",
      "text": "고열작업이 실내인 경우에는 고열을 감소시키기 위하여 환기장치를 설치하거나 열원과의 격리, 복사열의 차단 등 필요한 조치를 한다. 고열작업이 옥외에서 행해지는 경우에는 가능한 한 직사광선을 차단하고 쉬운 간단하고 쉬운 지붕이나 천막 등을 설치하며 작업 중에는 적당히 살수 등을 실시할 수 있도록 한다",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-010",
      "text": "고열작업이 실내인 경우에는 냉방 또는 통풍 등을 위하여 적절한 온·습도 조절 장치를 설치한다. 냉방장치를 설치하는 때에는 외부의 대기온도보다 현히 낮게 하지 않는다. 다만, 작업의 성질상 냉방장치를 하여 일정한 온도를 유지하여야 하는 장소로서 근로자에게 보온을 위하여 필요한 조치를 하는 때에는 예외로 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-011",
      "text": "갱내에서 고열이 발생하는 경우에는 갱내의 기온이 섭씨 37도 이하가 되도록 유지한다. 다만, 인명구조작업 또는 유해·위험방지작업을 함에 있어서 고열로 인한 근로자의 건강장해를 방지하기 위하여 필요한 조치를 한 때에는 예외로 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "환경관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-012",
      "text": "근로자를 새로이 배치할 경우에는 고열에 순응할 때까지 고열작업시간을 매일 단계적으로 증가시키는 등 필요한 조치한다. 이 경우 고열에 순응하지 않는 근로자란 고열작업 전주에 매일 일에 노출되지 않았던 근로자를 말한다. 고열에의 순응은 하루 중 오전에는 시원한 곳에서 일하게 하고 오후에만 고열작업을 시키는 방법 등으로 실시한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-013",
      "text": "근로자가 온도·습도를 쉽게 알 수 있도록 온도계 등의 기기를 상시 작업장소에 비치한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-014",
      "text": "인력에 의한 굴착작업 등 에너지 소비량이 많은 작업이나 연속작업은 가능한 한 줄인다.",
      "guideContext": "고열작업환경 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-015",
      "text": "작업의 강도와 습구흑구온도지수에 따라 결정된 작업휴식시간비를 초과하여 근로자를 작업시켜서는 안 된다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-016",
      "text": "근로자들이 휴식시간에 이용할 수 있는 휴게시설을 갖춘다. 휴게시설을 설치하는 때에는 고열작업과 격리된 장소에 설치하고 잠자리를 가질 수 있는 넓이를 확보 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-017",
      "text": "고열물체를 취급하는 장소 또는 현히 뜨거운 장소에는 관계근로자외의 자의 출입을 금지시키고 그 뜻을 보기 쉬운 장소에 게시하여야 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-018",
      "text": "작업복이 심하게 젖게 되는 작업장에 대하여는 탈의시설, 목욕시설, 세탁시설 및 작업복을 건조시킬 수 있는 시설을 설치·운영한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-019",
      "text": "근로자가 작업 중 땀을 많이 흘리게 되는 장소에는 소금과 깨끗하고 차가운 음료수 등을 충분히 섭취할 수 있도록 비치한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-020",
      "text": "다량의 고열물체를 취급하거나 현히 더운 장소에서 작업하는 근로자에게는 방열장갑 및 방열복을 개인전용의 것으로 지급한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-021",
      "text": "작업복은 열을 잘 흡수하는 복장을 피하고 흡습성, 환기성의 좋은 복장을 착용시 킨다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-022",
      "text": "직사광선하에서는 환기성이 좋은 모자 등을 쓰게 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-023",
      "text": "근로자로 하여금 지급한 보호구는 상시 점검하도록 하고 보호구에 이상이 있다고 판단한 경우 사업주는 이상유무를 확인하여 이를 보수하거나 다른 것으로 교환하여 준다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-024",
      "text": "건강진단 결과에 따라 적절한 건강관리 및 적정배치 등을 실시한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-025",
      "text": "근로자의 수면시간, 영양지도 등 일상의 건강관리지도를 실시하고 필요시 건강상담을 실시한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-026",
      "text": "작업개시 전 근로자의 건강상태를 확인하고 작업 중에는 주기적으로 순회하여 상담하는 등 근로자의 건강상태를 확인하고 필요한 조치를 조언한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-027",
      "text": "작업근로자에게 수분이나 염분의 보급 등 필요한 보건지도를 실시한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-028",
      "text": "휴게시설에 체온계를 비치하여 휴식시간 등에 측정할 수 있도록 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-029",
      "text": "사업주는 비만자, 심장혈관계에 이상이 있는 자, 피부질환을 앓고 있거나 감수성이 높은 자, 발열성 질환을 앓고 있거나 회복기에 있는 자, 고령자에 대하여는 고열작업의 내용과 건강상태의 정도를 고려하여야 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-030",
      "text": "사업주는 고열작업에 근로자를 종사하도록 하는 때에는 작업을 지휘·감독하는 자와 해당 작업근로자에 대해서 고열이 인체에 미치는 영향, 고열에 의한 건강장해 예방법, 응급 시의 조치사항에 대한 안전보건교육을 실시하고 고열작업으로 인한 건강장해가 발생되었거나 발생한 것으로 의심되는 경우에는 지체 없이 보고하도록 하는 신고 의무를 명확히 부여하고, 이 의무가 정확히 이행되도록 교육하여야 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전보건교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-031",
      "text": "근로자의 고열작업으로 인하여 열사병 등 건강장해가 발생되었거나 발생한 것으로 의심되는 경우에는 지체 없이 사업장 소재지를 관할하는 소방관서(「119구조·구급에 관한 법률」 제2조에 따른 119구급대를 포함한다)에 직접 신고하거나 근로자로 하여금 신고하게 하는 등 고열작업으로 인한 건강장해를 해소하기 위하여 필요한 적절한 조치를 해야 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-032",
      "text": "열사병의 증상이 있는 경우 즉시 모든 활동을 중단하고 서늘한 곳으로 이동시킨 후 의복을 느슨하게 하거나 최대한 의복을 많이 벗겨서 구급차가 도착하기 전까지 냉각 처치를 하여 체온을 최대한 떨어뜨려야 한다. 의식이 저하되어 있는 경우에는 입으로 물 또는 약을 먹이면 안 된다. 구토할 때 기도가 막히거나 흡인되어 더 위험할 수 있다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-033",
      "text": "열경련·열탈진 등의 증상이 있는 경우 지체 없이 서늘한 곳에 이동시켜 체온을 떨어뜨리고 증상에 따라 수분 및 염분 등을 보충시킨다. 필요한 경우 즉시 의사의 진찰을 받도록 한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-034",
      "text": "긴급 연락망을 미리 작성하여 고열작업 근로자에게 주지시킨다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-035",
      "text": "가까운 병원이나 의원 등의 소재지와 연락처를 파악해 둔다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-EG22-036",
      "text": "사업주는 고열작업에 대해 평가 및 관리를 행한 때에는 그 결과를 기록하고 5년간 보존한다.",
      "guideContext": "고열작업환경 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록보존",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-EG22-001",
      "term": "고열",
      "definition": "열에 의하여 근로자에게 열경련·열탈진 또는 열사병 등의 건강장해를 유발할 수 있는 높은 온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG22-002",
      "term": "습구흑구온도지수(Wet-Bulb Globe Temperature: WBGT)",
      "definition": "근로자가 고열환경에 종사함으로써 받는 열스트레스 또는 위해를 평가하기 위한 도구(단위 : ℃)로써 기온, 기습 및 복사열을 종합적으로 고려한 지표를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG22-003",
      "term": "열사병(Heat stroke)",
      "definition": "체온을 조절하는 신경계(체온조절 중추)가 열 자극을 견디지 못해 그 기능을 상실한 질환으로 열사병으로 다발성 장기손상 및 기능장애와 같은 합병증을 동반할 수 있고 치사율이 높아 온열질환 중 가장 위험한 질환이다.",
      "sourceSection": "부록 1",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG22-004",
      "term": "열탈진(Heat exhaustion)",
      "definition": "땀을 많이 흘려 수분과 염분손실이 많을 때 발생하며 두통, 구역감, 현기증, 무기력증, 갈증 등의 증상이 나타난다. 심한 고열환경에서 중등도 이상의 작업으로 발한량이 증가할 때 주로 발생한다.",
      "sourceSection": "부록 1",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG22-005",
      "term": "열경련(Heat cramps)",
      "definition": "고온환경 하에서 심한 육체적 노동을 함으로써 수의근에 통증이 있는 경련을 일으키는 고열장해를 말한다. 다량의 발한에 의해 염분이 상실되었음에도 이를 보충해 주지 못했을 때 일어난다.",
      "sourceSection": "부록 1",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG22-006",
      "term": "열허탈(Heat collapse)",
      "definition": "고온 노출이 계속되어 심박수 증가가 일정 한도를 넘었을 때 일어나는 순환장해를 말한다. 전신권태, 탈진, 현기증으로 의식이 혼탁해 졸도하기도 한다.",
      "sourceSection": "부록 1",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG22-007",
      "term": "열피로(Heat fatigue)",
      "definition": "고열에 순화되지 않은 작업자가 장시간 고열환경에서 정적인 작업을 할 경우 발생하며 대량의 발한으로 혈액이 농축되어 심장에 부담이 증가하거나 혈류분포의 이상이 일어나기 때문에 발생한다.",
      "sourceSection": "부록 1",
      "relatedSR": null
    },
    {
      "identifier": "DT-EG22-008",
      "term": "열발진(Heat rashes)",
      "definition": "작업환경에서 가장 흔히 발생하는 피부장해로서 땀띠(prickly heat)라고도 말한다. 땀에 젖은 피부 각질층이 떨어져 땀구멍을 막아 한선 내에 땀의 압력으로 염증성 반응을 일으켜 붉은 구진(papules)형태로 나타난다.",
      "sourceSection": "부록 1",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-EG22-01",
      "processOrder": 1,
      "processName": "고열의 측정 및 평가",
      "safetyMeasures": "습구흑구온도지수(WBGT) 측정기기 사용, 바닥 면으로부터 50~150cm 위치에 측정기 설치, 안정화 후 1일 작업시간 중 최대 고열 노출 1시간을 10분 간격 연속 측정, 6개월 1회 이상 정기 측정",
      "requiredPPE": [],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-EG22-02",
      "processOrder": 2,
      "processName": "WBGT 평가 및 노출기준 판정",
      "safetyMeasures": "옥외(태양광선) WBGT = 0.7×자연습구온도 + 0.2×흑구온도 + 0.1×건구온도, 옥내 WBGT = 0.7×자연습구온도 + 0.3×흑구온도로 산출, 착용복장 CAF 보정값 적용, 작업대사율 결정 후 노출기준 초과여부 판정 및 작업휴식시간비 선정",
      "requiredPPE": [],
      "sourceSection": "4.2.5",
      "relatedSR": null
    },
    {
      "identifier": "WP-EG22-03",
      "processOrder": 3,
      "processName": "환경관리 조치",
      "safetyMeasures": "실내: 환기장치 설치, 열원 격리, 복사열 차단, 온·습도 조절장치 설치. 옥외: 직사광선 차단, 지붕·천막 설치, 살수 실시. 갱내: 기온 섭씨 37도 이하 유지",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-EG22-04",
      "processOrder": 4,
      "processName": "작업관리 조치",
      "safetyMeasures": "신규 배치 시 고열 순응까지 작업시간 단계적 증가, 온도계 상시 비치, 에너지 소비 큰 작업·연속작업 축소, 작업휴식시간비 준수, 휴게시설(고열작업 격리 장소) 설치, 관계자 외 출입금지 게시, 탈의·목욕·세탁·건조 시설 설치, 소금·음료수 비치",
      "requiredPPE": [
        "방열장갑",
        "방열복",
        "환기성 모자"
      ],
      "sourceSection": "5.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-EG22-05",
      "processOrder": 5,
      "processName": "응급 시 조치",
      "safetyMeasures": "열사병 발생 시 119 즉시 신고, 서늘한 곳 이동, 의복 벗기고 냉각 처치, 의식 저하 시 음료 금지. 열경련·열탈진 시 서늘한 곳 이동, 수분·염분 보충, 필요시 의사 진찰. 긴급 연락망 사전 작성·주지, 가까운 병원 소재지·연락처 파악",
      "requiredPPE": [],
      "sourceSection": "5.6",
