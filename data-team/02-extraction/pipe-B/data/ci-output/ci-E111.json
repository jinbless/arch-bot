  "checklistItems": [
    {
      "identifier": "CI-E111-001",
      "text": "전기 불꽃 또는 아크에 의한 화상 우려가 높은 600 V 이상의 충전전로 또는 그 인근에서 작업하는 근로자는 안전보건규칙 제310조에 따라 방염 처리된 작업복 또는 난연 성능을 가진 작업복을 착용하여야 한다.",
      "guideContext": "난연성 전기작업복 착용",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E111-002",
      "text": "사업주는 전기 작업을 하는 경우에는 작업종류에 따라 그 위험을 등급별로 분류하고 이를 난연성 작업복 선정 시에 활용하여야 한다.",
      "guideContext": "난연성 전기작업복 선정 (법령 근거 미확인)",
      "additionalDetail": "작업종류에 따른 위험등급의 선정 예는 <부록>과 같다.",
      "workProcessPhase": "위험등급 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-003",
      "text": "작업자를 보호하기 위하여 난연성 작업복을 착용시키는 경우, 모든 인화성 옷을 덮을 수 있어야 하며 시야확보는 물론 작업자의 동작에도 불편이 없도록 하여야 한다.",
      "guideContext": "난연성 전기작업복 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-004",
      "text": "2도 화상의 발생에너지 문턱수준(5 J/㎠(1.2 cal/㎠)) 이상의 전기아크섬광 노출의 우려가 있는 경우, 작업자는 전기화염에 견딜 수 있는 난연성 작업복을 착용하여야 한다.",
      "guideContext": "난연성 전기작업복 착용",
      "additionalDetail": "노출에너지가 8.36 J/㎠(2.0 cal/㎠) 이하의 경우, 작업자는 위험등급 0에 규정되어 있는 화염에 녹지 않는(Non-melting) 작업복을 착용할 수도 있다.",
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E111-005",
      "text": "전기 작업을 하고자 하는 경우에는 <부록>에 따라 위험등급을 결정하여, 작업에 요구되는 난연성 작업복을 선정하는데 사용한다.",
      "guideContext": "난연성 전기작업복 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "위험등급 분류",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-006",
      "text": "위험등급 0 에서 4까지를 기초로 한 난연성 작업복의 요구사항은 <표 1>에 따른다.",
      "guideContext": "난연성 전기작업복 선정 (법령 근거 미확인)",
      "additionalDetail": "이 난연성 작업복은 섬광보호한계내의 충전전로에서의 활선작업 또는 활선근접작업을 할 때에 사용한다.",
      "workProcessPhase": "난연성 작업복 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-007",
      "text": "만약 난연성 의류가 요구되는 경우에는, 그 의류는 이동성과 가시성이 좋을 뿐만 아니라 모든 인화성 의류와 몸 전체를 덮을 수 있어야 한다.",
      "guideContext": "난연성 전기작업복 선정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-008",
      "text": "모든 작업복은 위생적이고 기능적으로 유효한 상태를 유지하여야 한다.",
      "guideContext": "난연성 전기작업복 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-009",
      "text": "비용해성의 인화성 섬유는 추가적인 보호를 위하여 여러 겹 중에서 난연성 옷의 내복으로만 사용한다.",
      "guideContext": "난연성 전기작업복 착용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-010",
      "text": "비용해성 인화성 섬유의류를 내복으로 착용 한다면 복장의 아크정격은 인화성 내복의 인화를 방지하기 위하여 예측되는 아크노출에너지수준에서 가장 안쪽의 난연성 층에 블레이크오픈이 발생하는 것을 방지하기에 충분하여야 한다.",
      "guideContext": "난연성 전기작업복 착용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-011",
      "text": "재킷이나 비옷 등과 같이 난연성 의류 위에 입는 겉옷도 난연성 재료로 만들어야 한다.",
      "guideContext": "난연성 전기작업복 착용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-012",
      "text": "아세테이트, 나일론, 폴리프로필렌 및 스판덱스와 같은 아크열에 녹아내리는 용해성 재질은 피부와 접촉하는 속옷으로 착용하여서는 아니 된다.",
      "guideContext": "난연성 전기작업복 착용 (법령 근거 미확인)",
      "additionalDetail": "비용해 섬유내의 또는 양말 위에 신축섬유의 일시적인 사용은 허용된다.",
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-013",
      "text": "의류는 가능한 한 노출되는 모든 부분을 덮을 수 있어야 한다.",
      "guideContext": "난연성 전기작업복 착용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-014",
      "text": "셔츠 소매는 손목에서 묶고 셔츠와 재킷은 목에서 잠그도록 하여야 한다.",
      "guideContext": "난연성 전기작업복 착용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-015",
      "text": "꼭 끼는 옷차림은 피하는 것이 바람직하다.",
      "guideContext": "난연성 전기작업복 착용",
      "additionalDetail": "느슨한 옷차림은 공간을 통한 열전달을 차단해 준다.",
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-016",
      "text": "난연성 의류는 작업에 방해가 되지 않도록 적당히 맞아야 한다.",
      "guideContext": "난연성 전기작업복 착용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-017",
      "text": "난연성 작업복은 안전하고 신뢰성 있는 상태로 관리되어야 하며, 이를 위하여 사용하기 전에 육안검사를 실시한다.",
      "guideContext": "난연성 전기작업복 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-018",
      "text": "난연성 작업복은 착용 전에 검사하여 오염되었거나 보호성능이 저하되었을 때에는 착용해서는 아니 된다.",
      "guideContext": "난연성 전기작업복 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-019",
      "text": "보호부분이 그리스, 기름, 인화성 물질 등으로 오염되었을 때에는 착용해서는 아니 된다.",
      "guideContext": "난연성 전기작업복 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-E111-020",
      "text": "난연성 작업복의 보관이나 손질은 제조자의 지침에 따른다.",
      "guideContext": "난연성 전기작업복 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "난연성 작업복 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E111-001",
      "term": "난연성(Flame-resistant; FR)",
      "definition": "점화 중 또는 점화 후에 일련의 화염이 진행되는 것을 막거나 종결 또는 억제하는 물질 특성을 말한다. 물질 본래의 특성이 난연성이거나 특수 처리한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-002",
      "term": "아크 정격(Arc rating)",
      "definition": "어떠한 물질(또는 물질의 여러 층)에 브레이크오픈(Break-open)이 발생하기 직전 또는 2도 화상을 일으키기 직전 값, 즉 이를 막을 수 있는 최대 입사 에너지를 말하며, 그 단위는 cal/㎠로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-003",
      "term": "아크 에너지(Arc energy)",
      "definition": "아크 전압과 아크 전류를 일정 시간 동안 적분하여 얻은 에너지 값을 말하며, 그 단위는 J 또는 ㎾·s로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-004",
      "term": "아크 열적 성능값(Arc thermal performance value; ATPV)",
      "definition": "아크 시험에 있어 직물 또는 재료를 통하여 스톨곡선(단위 ; ㎾·s/㎡)에 근거한 2도 화상을 일으키기에 충분한 열전달을 하는 입사 에너지를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-005",
      "term": "브레이크 오픈(Break-open)",
      "definition": "전기아크시험에서, 화염이 재료를 통과하였다는 사실이 하나 또는 그 이상의 구멍으로 확인되는 재료 반응을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-006",
      "term": "브레이크 오픈 문턱 에너지(Break-open threshold energy; EBT)",
      "definition": "시료가 브레이크 오픈을 나타내지 않는 스톨곡선 바로 아래의 값으로서 직물 또는 재료에 노출되는 최대 입사 에너지를 말하며, 그 단위는 ㎾·s/㎡로 표시한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-007",
      "term": "인화성(Ignitablity, Ignitable)",
      "definition": "전기아크 노출에서, 열 또는 빛에 의한 발화와 관련한 재료의 성질로서 시편 노출면적의 최소 25% 이상이 지속적으로 연소되는 특성을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-008",
      "term": "발화(Ignition)",
      "definition": "연소의 시작을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-009",
      "term": "스톨 곡선(Stoll curve)",
      "definition": "열에 대한 피부조직이 견디는 한계를 표시하는 데이터(열속 또는 총열량)로부터 만들어진 곡선으로서 이를 이용하여 2도 화상을 추정하는데 사용한다. 열속은 열을 받고 있는 물질에서 단위시간당 입사 또는 통과하는 열을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E111-010",
      "term": "섬광보호한계(Flash protection boundary)",
      "definition": "아크 섬광에 의한 재해위험으로부터 작업자를 보호하기 위한 한계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E111-01",
      "processOrder": 1,
      "processName": "작업종류별 위험등급 분류",
      "safetyMeasures": "사업주는 전기 작업 시 작업종류에 따라 위험을 등급별(0~4등급)로 분류하고, <부록>의 위험등급 분류표를 활용하여 해당 작업의 위험등급을 결정한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-E111-02",
      "processOrder": 2,
      "processName": "난연성 작업복 선정",
      "safetyMeasures": "결정된 위험등급에 따라 <표 1>의 선정기준 및 <표 2>의 최소아크정격을 기준으로 적합한 난연성 작업복을 선정한다. 위험등급 1은 최소아크정격 16.74 J/㎠(4 cal/㎠), 위험등급 2는 33.47 J/㎠(8 cal/㎠), 위험등급 3은 104.6 J/㎠(25 cal/㎠), 위험등급 4는 167.36 J/㎠(40 cal/㎠)이다.",
      "requiredPPE": [
        "난연성 작업복"
      ],
      "sourceSection": "6.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-E111-03",
