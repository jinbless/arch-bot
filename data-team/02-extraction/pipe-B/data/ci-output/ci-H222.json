  "checklistItems": [
    {
      "identifier": "CI-H222-001",
      "text": "질병 치료를 위한 충분한 시간의 보장이 업무적합성평가 전에 시행하여야 한다. 또한 질병의 상태가 업무 수행을 통해 악화될 가능성이 있다면 아직 업무 복귀를 고려할 시점은 아니다.",
      "guideContext": "운전직 근로자의 업무적합성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "질병 상태 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-002",
      "text": "증상 혹은 발작이 발생하지 않은 기간(the duration of the symptom free period)을 업무적합 여부를 판단하기 위한 고려 요인으로 삼을 수 있다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "질병 상태 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-003",
      "text": "복귀해야 하는 업무가 고정적인 야간 운전 업무이거나, 야간 운전의 비율이 높은 업무일 경우, 야간 작업을 통해 악화될 수 있는 질병을 가지고 있는 근로자라면 업무전환을 고려한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "업무 수행 내용 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-004",
      "text": "극도의 장시간 운전을 하거나, 휴일 없이 연속 근무하는 경우는 질병이 없는 정상인도 뇌심혈관질환 등의 위험을 높일 수 있으므로 운전 업무시간 조정을 고려한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "업무 수행 내용 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-005",
      "text": "대부분의 만성 질환은 완치보다는 관리하는 질병이라는 점에서 근무 중에 치료를 위한 시간이 필요하다. 이러한 치료를 위해 근무시간을 조정한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "근무환경 조정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-006",
      "text": "단독 운전의 어려움이 있는 경우, 2인 승무나 동반 승무와 같은 방법으로 작업환경개선을 고려한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "근무환경 조정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-007",
      "text": "업무수행에 대한 근로자의 의지는 업무복귀에 있어서 매우 중요한 요소이다. 작업 복귀 전에 근로자에 대한 심리적 지지 프로그램이 도움이 된다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "심리적 상태 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-008",
      "text": "근로자는 자신의 건강상태에 대한 투명한 의사소통을 통해 자신의 건강상태가 업무를 통해 악화되지 않도록 주의한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "심리적 상태 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-009",
      "text": "사업주는 해당 근로자에 대하여 고용 안정에 대한 지원을 통해 근로자가 심리적으로 적극적인 치료를 할 수 있도록 돕고, 업무 복귀를 할 수 있도록 지원한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "사업주 지지환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-010",
      "text": "업무 복귀시 단계적 적응 과정에서 발생할 수 있는 동료들의 불편이 있을 수 있다. 단기간이라면 동료들의 배려가 무엇보다 필요하지만, 장기화 가능성이 있는 경우 추가 인력 충원을 통해 업무가 동료 근로자에게 지속적으로 전가되지 않도록 관리한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "사업주 지지환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-011",
      "text": "Group 1 운전자의 경우, 뇌심혈관질환을 충분히 회복한 후 업무 복귀를 고려할 수 있다. 복귀 시기에 대해서는 환자의 상태, 업무의 내용, 조정 가능한 작업환경 등을 고려하여 결정한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "뇌심혈관질환 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-012",
      "text": "Group 2 운전자의 경우, 뇌심혈관질환의 충분한 회복후 운동부하 심전도 검사 등의 기능 검사를 실시하고 뇌심혈관질환 발병위험도평가 등을 통해 재발 가능성을 평가해서 업무 적합 여부를 판단한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": "KOSHA Guide H-43-2021 및 KOSHA Guide H-200-2018 활용 가능",
      "workProcessPhase": "뇌심혈관질환 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-013",
      "text": "인공 심장박동기를 삽입한 환자의 경우 Group 2 운전은 제한할 수 있다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "뇌심혈관질환 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-014",
      "text": "이유 없는 발작, 설명할 수 없는 의식 상실, 개두술 직후, 심각한 외상성 뇌손상 또는 급성 뇌졸중 등은 운전 업무를 제한해야한다.",
      "guideContext": "운전직 근로자의 업무적합성평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뇌심혈관질환 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-015",
      "text": "약물 복용 순응도 등의 개인적 요인과 발작을 유발하거나 악화시키는 작업환경 요인 등을 함께 고려해야 한다.",
      "guideContext": "운전직 근로자의 업무적합성평가 - 뇌전증 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "뇌전증 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-016",
      "text": "인슐린 치료를 하는 운전직 근로자의 경우 건강한 식이교육과 정기적인 검사가 필요하며, 저혈당 증상 발현시 행동 교육 등을 통해 저혈당 쇼크에 빠지지 않도록 주의한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "당뇨병 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-017",
      "text": "당뇨병이 있다는 것만으로 운전 업무를 제한할 수는 없으며, 작업 내용과 작업 환경, 당뇨병의 상태 등을 고려하여 근로자별로 업무적합 여부를 개별 평가한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "당뇨병 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-018",
      "text": "고혈압성 위기의 경우(수축기 혈압 180 mmHg 이상 또는 이완기 혈압 110 mmHg 이상) 혈압 조절이 양호하게 조절될 때까지 한시적으로 운전 업무를 제한할 수 있다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "고혈압 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-019",
      "text": "Group 2 운전자의 수축기 혈압 160 mmHg 이상 또는 이완기 혈압 100 mmHg 이상이면서 뇌심혈관계질환 발병위험도 평가 결과 최고위험군에 해당될 경우 혈압 조절이 양호하게 조절될 때까지 한시적으로 운전 업무를 제한할 수 있다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": "KOSHA Guide H-200-2018 발병위험도 평가 결과 활용",
      "workProcessPhase": "고혈압 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-020",
      "text": "뇌졸중, 녹내장, 망망병증과 관련된 시야 손실이 있는 경우 치료를 통해 완치된다면 업무적합을 고려한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "안 질환 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-021",
      "text": "장시간 노동과 야간 운전으로 인한 수면 장애의 경우 근무조건 등의 작업환경개선이 필요하다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "수면 장애 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-022",
      "text": "조현병 등과 같이 증상이 심각한 정신병은 일반적으로 운전 업무를 제한한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "정신 질환 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-023",
      "text": "경미한 우울증이나 불안장애, 신경증 등은 약물치료를 통해 증상이 잘 조절된다면 운전 업무를 특별히 제한할 필요는 없다. 다만, 약물 치료에 따른 부작용에 유의한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": "환자의 증상에 따른 규제가 아니라, 약물의 부작용에 의한 증상이 업무를 제한해야 하는 상황을 유발할 수 있다",
      "workProcessPhase": "정신 질환 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-024",
      "text": "사지마비, 뇌성마비, 척추마비, 절단상태 등 고정 장애가 있는 경우, 이러한 기능 장애를 고려하여 설계된 차량에서 운전을 수행할 수 있도록 근로자가 훈련이 되어 있다면, 운전 업무수행이 가능할 수 있다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "고정 장애 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.8",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-025",
      "text": "65세 이상 고령 운수 종사자의 운전업무 적합성을 평가하기위해 한국교통안전공단에서 자격유지검사를 실시하고 있다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": "검사항목: 시야각·신호등 검사, 화살표·추적검사, 도로찾기·표지관검사 등",
      "workProcessPhase": "노화 관련 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-026",
      "text": "화물 또는 택시운송사업에 종사하는 65세 이상 고령 운전자는 지정의료기관에서 의료적성검사 수검 후 결과를 제출하면 한국교통안전공단의 자격유지검사를 대체할 수 있다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "노화 관련 업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.9",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-027",
      "text": "의학적 건강상태뿐만 아니라 작업 및 작업환경을 고려하여 운전직 근로자의 업무적합여부를 결정한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 조건 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.10",
      "basedOn": null
    },
    {
      "identifier": "CI-H222-028",
      "text": "특정 작업 및 작업환경에 대한 조정을 통해 업무수행이 가능할 수 있기 때문에, 업무적합성평가에서는 작업환경에 대한 조정을 중요하게 고려한다.",
      "guideContext": "운전직 근로자의 업무적합성평가",
      "additionalDetail": "조정 가능한 요소: 운전시간 조정, 야간 운전 제한, 단독 승무 제한, 적정 휴식시간 보장, 단계적 업무 복귀, 비혼잡 노선 배치",
      "workProcessPhase": "작업환경 조건 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
