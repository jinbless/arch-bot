  "checklistItems": [
    {
      "identifier": "CI-G106-001",
      "text": "실리카 분진을 가압된 물 분사기 등으로 세척한다. 가능하면 호스나 휴대용 가압 물통을 이용한다. 이때 분사기의 분출 유량은 최소 0.5 l/min으로 하는 것이 추천되고 있다.",
      "guideContext": "실리카 분진 작업장 관리",
      "additionalDetail": "절삭 톱을 사용하는 작업에서는 물 분사기 세척보다는 환기장치를 이용한 실리카 분진 배출이 바람직하다.",
      "workProcessPhase": "작업장 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-DUST-003"
      ]
    },
    {
      "identifier": "CI-G106-002",
      "text": "적합한 방진 마스크를 착용한다.",
      "guideContext": "실리카 분진 작업장 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업장 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-G106-003",
      "text": "물 분사기를 이용하여 실리카 분진이 묻어 있는 기계의 세척, 특히 절삭 톱의 교환 시는 물 세척을 항상 실행한다.",
      "guideContext": "실리카 분진 기계류 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "기계류 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-G106-004",
      "text": "마모된 절삭 날을 교체하여 절삭시간을 감소시킨다.",
      "guideContext": "실리카 분진 기계류 유지관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기계류 유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G106-005",
      "text": "호흡용 보호구의 검사 및 교환을 실시한다.",
      "guideContext": "실리카 분진 기계류 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "기계류 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-G106-006",
      "text": "작업장 근처에 있는 사람들의 숫자를 제한한다.",
      "guideContext": "분진 발생 작업 외 사항 관리 (법령 근거 미확인)",
      "additionalDetail": "분진 발생되는 작업에 직접 참여하는 근로자 이외의 작업자에게 피해가 미치는 것을 방지하기 위한 조치",
      "workProcessPhase": "작업 외 사항 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G106-007",
      "text": "작업자들이 순환 작업하도록 한다.",
      "guideContext": "분진 발생 작업 외 사항 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 외 사항 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G106-008",
      "text": "분진 확산을 막기 위해 차단막을 친다.",
      "guideContext": "분진 발생 작업 외 사항 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 외 사항 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-G106-009",
      "text": "실리카 분진을 배출할 수 있는 환기장치를 설치한다.",
      "guideContext": "분진 발생 작업 외 사항 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 외 사항 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
