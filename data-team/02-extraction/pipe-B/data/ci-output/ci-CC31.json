  "checklistItems": [
    {
      "identifier": "CI-CC31-001",
      "text": "취급하는 물질의 반응성과 혼합위험에 대한 사전조사를 실시한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-002",
      "text": "공기 및 물에 대한 미량 오염 위험성이 있는 공정에서는 정기적으로 미량 성분분석을 실시한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-003",
      "text": "배관의 누설이 발생하여도 위험이 최소화되도록 배관과 열교환기 본체의 유체압력의 균형을 검토한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": "예를 들면 물(H₂O)과 황산(H₂SO₄)을 취급하는 열교환기라면, 황산측의 압력을 물 측의 압력보다 크게 해야 한다. 또한 이 경우에는 물 측의 출구를 대기 중에 개방하고 배압을 작게 하도록 한다.",
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-004",
      "text": "화학물질의 누설 여부를 조기에 발견하기 위하여 열교환기의 배관 측과 본체 측의 압력, 온도, 유량을 가능한 한 상시 감시한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-005",
      "text": "열교환기 출구의 냉각 또는 가열 유체 분위기의 가스농도를 연속분석계를 사용하거나 정기적 분석을 통하여 확인한다. 또한 열교환기 출구의 피 냉각 또는 피 가열 유체 분위기의 가스농도에 대해서도 동일한 분석을 통하여 확인한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-006",
      "text": "열교환기의 개방 시에 비파괴 검사법을 사용하여 균열 등을 체크한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-007",
      "text": "누설을 인지하였을 때에는 폭발성혼합물의 생성에 주의하고 고온 물체, 강산화제와의 접촉이 되지 않도록 한다.",
      "guideContext": "화학공정 열교환기 누설 대응",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 누설 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-008",
      "text": "누설이 발견되면 우선적으로 누설 지점에서 가장 가까운 밸브를 닫아 화학물질의 유출량을 적게 한다.",
      "guideContext": "화학공정 열교환기 누설 대응",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 누설 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-009",
      "text": "열교환기를 개방하였을 때에는 충분한 퍼지를 통하여 잔유물이 없도록 한다.",
      "guideContext": "화학공정 열교환기 정비",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-010",
      "text": "배관에 균열이 발생하면 고압 측의 유체가 지압 측 또는 다른 시스템으로 유입하게 되는데 이러한 과정에서 이상 반응이나 폭주반응 위험성이 없는지를 사전에 검토해두어야 한다.",
      "guideContext": "화학공정 열교환기 조작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-011",
      "text": "냉매로서 해수(Seawater)를 사용하는 경우에는 해수에 의한 부식성을 고려하여 열교환기의 재질을 특수합금 등을 사용해야 하며, 누전 등의 전기 흐름이 발생할 수 있는 상황을 고려하여 전기 부식(Electrolytic corrosion)에 대한 대책을 마련한다.",
      "guideContext": "화학공정 열교환기 조작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 설계·재질 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-012",
      "text": "응측기에서 응축이 갑자기 일어나는 경우에는 강한 진동이나 음향이 발생할 수 있으며 이로 인한 열교환기와 배관의 진동에 주의한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-013",
      "text": "열교환기 배관의 오염은 2가지 유체의 온도분포 및 유량에서 총괄전열계수 (Overall heat transfer coefficient)를 구하고 경향 관리를 통하여 판단한다.",
      "guideContext": "화학공정 열교환기 조작",
      "additionalDetail": null,
      "workProcessPhase": "열교환기 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-014",
      "text": "혼합 위험이 있는 물질을 직접 접속하지 않도록 배관을 별도의 계통으로 하고 구조를 단순화하도록 한다.",
      "guideContext": "화학공정 배관 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 설계·관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-015",
      "text": "혼합 위험이 있는 물질의 배관을 별도의 계통으로 하는 것이 어려운 경우에는 역류 방지를 위한 차단밸브(Shut-off valve)나 억지밸브(Check valve)를 설치한다. 또한 밸브의 오 조작을 방지하기 위하여 배관 계통을 나타내는 도표나 조작상의 주의사항을 기재한 주의 안내관을 설치 한다.",
      "guideContext": "화학공정 배관 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 설계·관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-016",
      "text": "배관의 접속 오조작을 방지하기 위해서는 배관의 표시와 색상을 구분하고 접속구와 배관 구경, 그리고 접속방식을 종류별로 다르게 변경하도록 한다.",
      "guideContext": "화학공정 배관 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 설계·관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-017",
      "text": "억지밸브(Check valve)는 기밀성이 좋지 않기 때문에 미량의 역류물질이 문제가 되는 경우에는 차단밸브(Shut-off valve)를 사용하도록 한다.",
      "guideContext": "화학공정 배관 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 설계·관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-018",
      "text": "중합물이 생성되는 배관에서는 억지밸브(Check valve)의 스윙 및 리프트가 고착되기 쉬우므로 정기적인 개방 점검이 필요하다.",
      "guideContext": "화학공정 배관 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 정비·점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-019",
      "text": "용매회수장치에서 용매회수 조작은 먼저 용매회수 온도를 정하고 설정 온도 이하에서만 조작해야 한다.",
      "guideContext": "화학공정 용매회수 조작 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "용매회수 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-020",
      "text": "용매회수 조작에서는 잔유물이 과도로 농축이 되어 이상반응을 일으키는 경우가 있으므로 용매가 완전히 제거될 때까지 회수작업을 하지 않도록 한다.",
      "guideContext": "화학공정 용매회수 조작",
      "additionalDetail": null,
      "workProcessPhase": "용매회수 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-021",
      "text": "증류 잔유물의 열적위험성 및 산화반응성에 대해서는 사전조사를 충분히 실시한다.",
      "guideContext": "화학공정 용매회수 조작",
      "additionalDetail": null,
      "workProcessPhase": "용매회수 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-022",
      "text": "증류조 내의 온도감시를 위하여 적정한 위치에 경보기가 부착된 온도계를 설치한다.",
      "guideContext": "화학공정 용매회수 조작",
      "additionalDetail": null,
      "workProcessPhase": "용매회수 설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-023",
      "text": "용매회수온도 및 회수조작 종료 시의 잔존 용매량의 설정값을 작업표준서에 명기하여 작업자에 의한 기기조작 오류가 발생하지 않도록 한다.",
      "guideContext": "화학공정 용매회수 조작",
      "additionalDetail": null,
      "workProcessPhase": "용매회수 조작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-024",
      "text": "윤활유에 가연성가스가 미량 혼입하는 정도라고 하여 윤활유 탱크의 위험성이 없다고 판단해서는 않 된다.",
      "guideContext": "화학공정 윤활유 탱크 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 탱크 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-025",
      "text": "가연성가스 압축기의 윤활유 탱크는 항상 질소 충전을 하여 폭발방지를 예방하도록 한다.",
      "guideContext": "화학공정 윤활유 탱크 관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 탱크 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-026",
      "text": "안전대책을 위해 질소 충전용 설비를 설치하여도 항상 사용하지 않으면 효과를 기대할 수 없으며, 압축기의 유지 보수 등으로 충전용 질소 공급을 중단해야 하는 경우에는 가스 검지기로 가연성 가스가 남아있지 않는 것을 확인하고 작업을 실시한다.",
      "guideContext": "화학공정 윤활유 탱크 관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 탱크 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-027",
      "text": "실링용 오일이 포함되어 있는 시스템을 운전하는 경우에는 가열설비를 사용하여 윤활유 탱크의 온도를 실링용 오일의 물리적 특성에 맞추어 안전하게 관리한다.",
      "guideContext": "화학공정 윤활유 탱크 관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 탱크 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-028",
      "text": "가연성가스의 발생이 없을 것으로 예상되는 탱크에 대해서도 정기적인 가스 분석을 실시하여 폭발성혼합기가 생성되는지를 확인한다.",
      "guideContext": "화학공정 윤활유 탱크 관리",
      "additionalDetail": null,
      "workProcessPhase": "윤활유 탱크 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-029",
      "text": "감압증류의 진공도가 낮아지면 증류온도가 상승하기 때문에 관리한계 온도 및 관리 한계 진공도를 정하여 그 설정값 이하에서만 운전해야 한다.",
      "guideContext": "화학공정 감압증류 운전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "감압증류 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-030",
      "text": "감압증류 시에는 정전에 의해 제어기기 및 진공펌프가 정지하지 않도록 비상용 발전기를 설치한다. 만일 진공펌프가 정지한 경우에는 원료 공급을 정지시키고 일원의 공급을 차단하는 등의 온도 상승을 방지하기 위한 대책을 강구한다.",
      "guideContext": "화학공정 감압증류 운전",
      "additionalDetail": null,
      "workProcessPhase": "감압증류 설비 설치·운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-CC31-031",
      "text": "감압증류 공정에서 소량의 공기유입을 방지하고 유입 부분을 용이하게 발견하기 위한 방법으로서 플랜지 주변에 덕트 테이프(Duct tape)를 사용할 수 있다.",
      "guideContext": "화학공정 감압증류 운전",
      "additionalDetail": null,
      "workProcessPhase": "감압증류 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-032",
      "text": "반응기 내의 반응물 온도가 정상이라 하더라도 오조작에 의해 예상하지 못한 물질이 혼입하게 되면 급격한 발열반응을 일으킬 위험이 있으므로 이러한 원인이 되는 물질을 사전에 조사하여 혼입을 방지하는 것이 중요하다.",
      "guideContext": "화학공정 반응기 운전",
      "additionalDetail": null,
      "workProcessPhase": "반응기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-033",
      "text": "생산설비로의 스케일 업을 계획하는 경우에는 불순물의 존재와 그에 따른 위험성 등을 충분히 검토해야 한다.",
      "guideContext": "화학공정 반응기 운전 (법령 근거 미확인)",
      "additionalDetail": "연구개발 단계에서는 순도가 높은 시약을 사용하기 때문에 불순물의 존재는 큰 문제가 되지 않지만, 생산 설비에서는 순도가 낮은 공업제품을 사용하며 또한 미반응 모노마 및 용제 등을 재사용하는 경우가 많기 때문에 불순물의 혼입 가능성이 높아진다.",
      "workProcessPhase": "반응기 설계·스케일업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-034",
      "text": "반응기에 혼입될 우려가 있는 불순물의 종류와 이러한 분순물의 혼입에 따른 위험성을 사전에 조사하여 둔다.",
      "guideContext": "화학공정 반응기 운전",
      "additionalDetail": null,
      "workProcessPhase": "반응기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-035",
      "text": "원료 및 용제 속에 있는 미량 성분의 종류와 양을 파악하기 위하여 정기적인 분석을 실시한다.",
      "guideContext": "화학공정 반응기 운전",
      "additionalDetail": null,
      "workProcessPhase": "반응기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-036",
      "text": "회분식공정의 반응기에서는 원료 투입 전에 잔사 및 세정 시의 수분 그리고 세정제의 혼입을 방지하기 위하여 반응 개시 전에 반응기 내부의 점검을 실시한다.",
      "guideContext": "화학공정 반응기 운전",
      "additionalDetail": null,
      "workProcessPhase": "반응기 운전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-037",
      "text": "장치 재료로부터 부식된 철, 열매유, 냉각수 등의 혼입을 방지하기 위하여 정기적으로 반응기 내부 및 냉각용 열교환기 등의 검사를 실시한다.",
      "guideContext": "화학공정 반응기 운전",
      "additionalDetail": null,
      "workProcessPhase": "반응기 정비·점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-038",
      "text": "활성탄 설비를 선정할 때는 각 장치에서 배출되는 가스의 물성 및 상태를 먼저 조사한 다음에 실시해야 하며, 활성탄 설비는 자동, 수동에 관계없이 흡착-재생이 가능한 것을 우선적으로 고려한다.",
      "guideContext": "화학공정 활성탄 설비 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "활성탄 설비 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-039",
      "text": "활성탄설비의 각 장치에서 나오는 배출 가스는 정기적으로 농도를 측정해 둔다.",
      "guideContext": "화학공정 활성탄 설비 관리",
      "additionalDetail": null,
      "workProcessPhase": "활성탄 설비 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-040",
      "text": "활성탄설비 필터실의 차압(ΔP)은 정기적으로 점검하고 차압이 허용치에 이르면 필터를 교환하도록 한다.",
      "guideContext": "화학공정 활성탄 설비 관리",
      "additionalDetail": null,
      "workProcessPhase": "활성탄 설비 정비·점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-041",
      "text": "흡착탑 내에 온도 감시장치와 경보 장치를 설치한다.",
      "guideContext": "화학공정 활성탄 설비 관리",
      "additionalDetail": null,
      "workProcessPhase": "활성탄 설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-042",
      "text": "흡착탑 내에서의 화재 발생 가능성을 고려하여 소화용 배관을 설치한다.",
      "guideContext": "화학공정 활성탄 설비 관리",
      "additionalDetail": null,
      "workProcessPhase": "활성탄 설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-043",
      "text": "공기압축기 토출배관에서의 킨막이 밸브의 개폐조작은 단열압축에 의한 온도상승을 방지하기 위하여 서서히 실시한다.",
      "guideContext": "화학공정 공기압축기 운전",
      "additionalDetail": null,
      "workProcessPhase": "공기압축기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-044",
      "text": "토출배관, 공기 지장조, 오일분리기 등은 정기적으로 점검하고 윤활유 및 카본의 퇴적이 없는 것을 확인한다.",
      "guideContext": "화학공정 공기압축기 운전",
      "additionalDetail": null,
      "workProcessPhase": "공기압축기 정비·점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-045",
      "text": "윤활유의 적정한 소비량을 파악하고, 만일 소비량의 증가가 현저하게 나타나는 경우에는 공기압축기의 운전을 정지하고 점검 및 정비를 실시한다.",
      "guideContext": "화학공정 공기압축기 운전",
      "additionalDetail": null,
      "workProcessPhase": "공기압축기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-046",
      "text": "압축기의 윤활유는 인화점이 높고 열안정성, 산화안정성이 양호한 것을 사용해야 하며, 또한 윤활유는 정기적으로 열화도 분석을 실시한다.",
      "guideContext": "화학공정 공기압축기 운전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기압축기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-047",
      "text": "윤활유는 미분무 상태에서 쉽게 인화되고 열화하면 발화온도가 낮아지는 성질이 있으므로 윤활유 관리에는 항상 주의해야 한다.",
      "guideContext": "화학공정 공기압축기 운전 (법령 근거 미확인)",
      "additionalDetail": "공기 압축기의 피스톤 고무링이 일부 탄화가 일어나 마찰열이 발생하며 부착된 카본과 열화된 윤활유가 발화하여 유막 폭기이 발생하면서 폭발로 이어진 사례가 있다.",
      "workProcessPhase": "공기압축기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-048",
      "text": "공기압축기의 안전밸브는 최고사용압력 이하에서 작동하도록 유지, 관리해야 한다.",
      "guideContext": "화학공정 공기압축기 운전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공기압축기 정비·점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-049",
      "text": "고압 공기가 반드시 필요하지 않은 설비에서는 가급적 질소 등을 사용한다.",
      "guideContext": "화학공정 공기압축기 운전",
      "additionalDetail": null,
      "workProcessPhase": "공기압축기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-050",
      "text": "고압 공기압축기는 가능하다면 무 급유형의 제품을 사용하는 것이 안전하다.",
      "guideContext": "화학공정 공기압축기 운전",
      "additionalDetail": null,
      "workProcessPhase": "공기압축기 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-051",
      "text": "공정설비의 운전담당자는 항상 온도, 압력, 유량, 액면 등의 운전관리범위를 파악하고 계기류의 지시값이 정상인가를 확인해야 한다. 또한 현장 지시값과 계기실의 지시 값이 일치하고 있는지를 정기적으로 체크해야 한다.",
      "guideContext": "화학공정 계기류 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계기류 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-052",
      "text": "현장 계기류에는 일상적으로 사용하는 운전 지시값과 최대 및 최소값을 표시해 두고 지시값이 정상인지를 명확하게 알 수 있도록 한다. 또한 압력계 등의 지시값을 기록하는 경우에는 단위(CGS 또는 SI)를 혼동하지 않도록 확인해야 한다.",
      "guideContext": "화학공정 계기류 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계기류 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-053",
      "text": "액면계는 액면계 취출 노즐의 막힘에 의하여 그 지시값이 정상이 아닌 경우가 있으므로 주의해야 한다.",
      "guideContext": "화학공정 계기류 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계기류 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-054",
      "text": "중요한 현장계측은 매일 확인해야 한다.",
      "guideContext": "화학공정 계기류 관리 (법령 근거 미확인)",
      "additionalDetail": "계기류의 고장이나 지시값 단위의 착오로 인한 조작으로 인하여 폭발이나 이상반응을 초래하는 위험이 있으므로 운전 담당자는 항상 주의해야 한다.",
      "workProcessPhase": "계기류 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-055",
      "text": "계기류의 지시값이 정상이 아닌 것을 알게 되었을 때에는 확인자가 혼자서 처리하지 말고 즉시 정비담당책임자에게 연락한다.",
      "guideContext": "화학공정 계기류 고장 대응",
      "additionalDetail": null,
      "workProcessPhase": "계기류 고장 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-056",
      "text": "계기류의 수치 확인을 전달하는 경우에는 반드시 단위를 함께 기입하도록 한다.",
      "guideContext": "화학공정 계기류 관리",
      "additionalDetail": null,
      "workProcessPhase": "계기류 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-057",
      "text": "계기류의 교환작업은 계측기담당자가 직접 실시해야 하지만, 단순한 현장압력계의 교환 등은 운전담당자가 직접 할 수 있다.",
      "guideContext": "화학공정 계기류 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계기류 정비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-058",
      "text": "고온 배관의 보온재에 윤활유나 인화성 액체를 흘리지 않도록 하고, 만일 윤활유 등이 침투한 경우에는 보온재를 교환하도록 한다.",
      "guideContext": "화학공정 배관 보온재 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 보온재 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-059",
      "text": "고온 배관 내 유체를 고려하여 보온재는 내부로 유체가 스며들어도 위험성이 없는 것을 사용한다. 또한 보온재는 외부 표면에서 침투한 액체와 반응하지 않아야 한다.",
      "guideContext": "화학공정 배관 보온재 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 보온재 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-060",
      "text": "알카리성 물질의 보온재는 알루미늄 용기의 보온재로 사용하지 않도록 한다.",
      "guideContext": "화학공정 배관 보온재 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 보온재 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-061",
      "text": "경질 우레탄폼의 보온재는 화재 시에 유독가스가 발생하므로 건물 내부에서는 사용하지 않는다. 또한 옥외에서 사용하는 경우라도 불연재나 내화성을 가지는 재료로 외장을 피복하는 등의 화재 예방 조치를 한다.",
      "guideContext": "화학공정 배관 보온재 관리",
      "additionalDetail": null,
      "workProcessPhase": "배관 보온재 선정·설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-062",
      "text": "보온재의 재질은 그 표면으로부터 침투하는 액체와 반응하지 않은 것을 사용한다.",
      "guideContext": "화학공정 배관 보온재 관리",
      "additionalDetail": "스팀 터빈 운전 중에 스팀 배관의 보온재에서 발화가 일어나는 경우가 있는데 대부분의 원인은 보온재에 윤활유가 침투하여 발생하고 있다.",
      "workProcessPhase": "배관 보온재 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-063",
      "text": "반응기의 배관을 통하여 이송중인 유기과산화물이 고착되거나 얼어서 막히는 경우에는 유기과산화물이 열적으로 매우 불안정하여 충격과 열에 민감하게 분해하며 폭발하기 때문에 용해시키고자 고온 열풍이나 스팀 등으로 가열해서는 않 된다.",
      "guideContext": "화학공정 유기과산화물 배관작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유기과산화물 배관작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-064",
      "text": "유기과산화물의 위험성을 취급 또는 작업자에게 교육을 통하여 충분히 인지시킨다.",
      "guideContext": "화학공정 유기과산화물 배관작업",
      "additionalDetail": null,
      "workProcessPhase": "유기과산화물 취급 교육",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-065",
      "text": "지온 환경의 배관 속에 있는 유기과산화물이 응고된 경우에는 필요 이상으로 유기과산화물을 가열하지 않도록 하며 보온재를 사용하거나 온수와 같이 완만하게 가온하여 융해시킨다.",
      "guideContext": "화학공정 유기과산화물 배관작업",
      "additionalDetail": null,
      "workProcessPhase": "유기과산화물 배관작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-066",
      "text": "가능하다면 지 농도의 유기과산화물을 사용하도록 한다.",
      "guideContext": "화학공정 유기과산화물 취급",
      "additionalDetail": null,
      "workProcessPhase": "유기과산화물 취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-067",
      "text": "건조 상태의 유기과산화물이 가장 위험하므로 안전을 위해 페이스트 상태로 하거나 용제로 희석하여 보관하거나 사용한다.",
      "guideContext": "화학공정 유기과산화물 취급",
      "additionalDetail": null,
      "workProcessPhase": "유기과산화물 보관·취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-068",
      "text": "유기과산화물은 매우 작은 에너지로도 분해폭발을 일으키기 때문에 보관하는 용기는 전도방지조치를 해야 하며 취급에 사용하는 도구는 목재 및 대나무 등의 안전한 재질이어야 한다.",
      "guideContext": "화학공정 유기과산화물 취급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유기과산화물 보관·취급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-069",
      "text": "영하의 기온에서 유기과산화물이 들어 있는 배관 내가 동결된 경우에는 급격히 고온스팀 등으로 가열해서는 않 되며, 보온재를 설치하거나 온수를 사용하여 완만한 조건으로 가온하도록 한다.",
      "guideContext": "화학공정 유기과산화물 배관작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유기과산화물 배관작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-070",
      "text": "설비 내에 탄화물이나 산화물과 같은 부생성물과 잔유물의 유무를 확인한다.",
      "guideContext": "화학공정 반응기 잔유물 제거",
      "additionalDetail": null,
      "workProcessPhase": "반응기 잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-071",
      "text": "잔존 물질이 취급물질에 대한 촉매작용이 있는지를 확인하고 촉매물질로 될 수 있는 것은 이상반응 위험성이 있으므로 제거한다.",
      "guideContext": "화학공정 반응기 잔유물 제거",
      "additionalDetail": null,
      "workProcessPhase": "반응기 잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-072",
      "text": "잔유물을 확인한 경우에는 스팀 세정과 화학세정의 실시, 그리고 각 첨가제를 투입하여 물질의 변성 및 물질 치환을 통하여 제거하도록 한다. 이러한 방법을 사용할 수 없는 경우에는 에어펌프를 사용하고 가급적 탱크 내에 들어가지 않도록 한다.",
      "guideContext": "화학공정 반응기 잔유물 제거",
      "additionalDetail": null,
      "workProcessPhase": "반응기 잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-CC31-073",
      "text": "중합물은 산소와 접촉하면 발화할 수 있으므로 시스템 외부로부터 산소혼입을 방지하고 중합금지제를 사용하여 중합반응을 정지시키도록 하며 녹(Corrosion)과 데드 스페이스를 제거한다.",
      "guideContext": "화학공정 반응기 잔유물 제거",
      "additionalDetail": null,
      "workProcessPhase": "반응기 잔유물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-CC31-001",
      "term": "이상반응 (Abnormal reaction)",
      "definition": "정상적인 반응조건에서 벗어나 목적 이외의 예기치 못한 반응이 일어나거나 설계개발단계에서 예측하지 못한 물질이 생성, 축적, 혼입하여 원인불명의 반응을 일으키는 경우를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC31-002",
      "term": "총괄열전달계수 (Overall heat transfer coefficient)",
      "definition": "직렬 고체층을 통과하는 열유속(Heat flux)은 총괄 온도차(ΔT)에 비례하는데, 열통과에서 벽을 통과한 고온측의 유체 온도를 Th, 저온측의 유체 온도를 Tc로 하고 벽면을 수직으로 통과하는 열의 열유속(heat flux)을 q, 총괄열전달계수를 K라고 하였을때 K=q / (Th－Tc)의 관계를 갖는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC31-003",
      "term": "연화점 (Softening point)",
      "definition": "유리, 내화물, 플라스틱, 아스팔트, 타르 등의 고형물질이 열이나 화학반응을 통하여 분자량이 증가되어 변형이 일어나면서 연화가 시작하는 온도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC31-004",
      "term": "감압증류 (Vacuum Distillation)",
      "definition": "온도를 높이면 분해·중합이 일어나는 물질을 증류할 때 사용하는 증류법으로서 장치 내부를 지압으로 하여 끓는점을 낮추어 증류하는데 일반적으로 200㎜Hg 이상의 압력에서 행하는 증류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-CC31-005",
      "term": "착화온도 (Ignition temperature)",
      "definition": "불꽃과 같은 화원(Energy source)을 사용하지 않아도 물질이 연소를 개시하는 최저온도로서 발화온도 또는 발화점이라고도 한다. 착화온도는 물질이 착화에 이르는 유도시간과 시험장치의 영향을 받기 때문에 측정조건에 따라 달라질 수 있다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
