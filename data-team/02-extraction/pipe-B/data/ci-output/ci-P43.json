  "domainTerms": [
    {
      "identifier": "DT-P43-001",
      "term": "주펌프(Main pump)",
      "definition": "화재시에 가동하여 화재진압을 목적으로 하는 펌프를 말한다.",
      "sourceSection": "3.1",
      "relatedSR": null
    },
    {
      "identifier": "DT-P43-002",
      "term": "충압펌프(Jockey pump)",
      "definition": "소방 주배관의 압력을 상시 일정수준 이상으로 유지하는 펌프를 말한다.",
      "sourceSection": "3.1",
      "relatedSR": null
    },
    {
      "identifier": "DT-P43-003",
      "term": "주배관(Main line)",
      "definition": "화재시 화재진압에 필요한 소방용수를 이송하는 배관을 말한다.",
      "sourceSection": "3.1",
      "relatedSR": null
    },
    {
      "identifier": "DT-P43-004",
      "term": "발단압력",
      "definition": "주펌프로 부터 가장 먼 위치에 있거나 마찰손실이 가장 큰 위치에 있는 소방설비의 배출구에서의 압력을 말한다.",
      "sourceSection": "3.1",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P43-01",
      "processOrder": 1,
      "processName": "소방용수 확보 및 산출",
      "safetyMeasures": "공장지역을 화재위험단위지역으로 구분하고, 각 단위지역의 화재진압에 필요한 총 소방용수량을 산출하여 최대 총 소방용수량을 공장지역 필요 소방용수량으로 정한다. 소방용수는 부식, 스케일, 미생물의 성장, 고체물질, 오염 및 독성 등이 없어야 한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-P43-02",
      "processOrder": 2,
      "processName": "소방펌프 선정 및 구성",
      "safetyMeasures": "소방펌프의 총 용량은 최대 총 소방용수량의 150%를 공급할 수 있어야 하며, 적어도 2대 이상 설치한다. 원심펌프를 원칙으로 하고 5～12㎏f/㎠의 정격압력을 갖는 펌프를 사용한다. 소방펌프는 소방전용으로만 사용한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-P43-03",
      "processOrder": 3,
      "processName": "소방펌프 설치",
      "safetyMeasures": "화재 및 침수 피해 우려가 없고 동결우려가 없는 장소에 설치한다. 흡입배관은 공기고임이 생기지 않는 구조로 하고, 흡입측에 여과기를 설치한다. 토출측에 압력계 및 체크밸브를 설치하고, 성능시험배관을 설치한다. 펌프실에는 비상조명장치와 통신시설을 구비한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "WP-P43-04",
      "processOrder": 4,
      "processName": "소방 주배관 구성",
      "safetyMeasures": "주배관은 격자형태로 구성하여 여러 방향에서 동시에 소방수가 공급되도록 한다. 배관내 유속은 3m/sec 이하로 하고, 배관표면 색상은 적색으로 표시한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-P43-05",
      "processOrder": 5,
      "processName": "모터펌프 가동전 점검",
      "safetyMeasures": "볼트·너트 조임상태, 압력계 및 토출밸브 개폐여부, 윤활유 적정수준을 확인한다.",
      "requiredPPE": [],
      "sourceSection": "9.1.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-P43-06",
      "processOrder": 6,
      "processName": "모터펌프 가동중 점검",
      "safetyMeasures": "규정압력 확인, 이상음·진동 확인, 패킹·플랜지 누수 확인, 기어박스·베어링박스 온도 상승 확인, 콘트롤판넬 및 축전지 충전판넬 확인을 실시한다.",
      "requiredPPE": [],
