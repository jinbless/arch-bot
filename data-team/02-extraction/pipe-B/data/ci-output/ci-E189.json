  "checklistItems": [
    {
      "identifier": "CI-E189-001",
      "text": "사업주는 근로자가 충전전로를 취급하거나 그 인근에서 작업하는 경우 근로자에게 그 작업에 적합한 절연용 보호구를 착용시켜야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "전기작업 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-002",
      "text": "절연용 보호구는 최대사용전압에 따라 6개 등급(장갑 6등급, 소매 5등급)으로 구분하며, 최대 사용 전압에 맞는 등급의 보호구를 선정해야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-003",
      "text": "보호구는 보기 쉬운 측면 등에 압인 또는 기타 지워지지 않는 방법으로 다음 사항을 표시하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": "절연장갑: 기호, 관련 표준 번호, 제조사 정보, 범주, 크기, 등급, 제조연월. 절연소매: 기호, 관련 표준 번호, 제조사 정보, 치수, 등급, 좌우 구분, 제조연월",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-004",
      "text": "각 쌍의 장갑은 제조사 지침에 따라 운반, 취급 및 보관 시 장갑이 손상되지 않도록 적절하게 보호할 수 있는 충분한 강도를 지닌 개별 용기나 포장물에 담아 포장하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 포장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-005",
      "text": "용기나 포장물 외부에는 제조사나 공급자 이름, 등급문류, 범주, 크기, 길이 및 소매 끝단의 형태를 규정한 표시가 있어야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 포장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-006",
      "text": "운송에 적합한 포장 유형은 제조사가 규정하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 포장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-007",
      "text": "양손사이에 장갑과 슬리브의 내·외부 표면을 굴리는 방법으로 장갑과 슬리브 표면을 점검한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "육안점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-008",
      "text": "장갑이나 슬리브는 안쪽이 뒤집혀 놓은 상태로 계속두면 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "육안점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-009",
      "text": "엄지와 손가락사이를 벌려 당기면서 인접한 엄지와 손가락 사이의 갈라진 홈 부분에 대하여 이상 여부를 점검한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "육안점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-010",
      "text": "고무절연 장갑에서 천공이나 조그만 구멍들은 압력 공기로 장갑을 부풀게 하여 점검한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "부풀리기 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-011",
      "text": "장갑과 슬리브의 물리적 특성상 너무 부풀릴 경우 불량의 소지가 될 수 있으므로 과하게 부풀리지 않도록 주의한다. 장갑과 슬리브는 제품 정상 크기의 1.25배 ~ 2배 이상 늘리거나 부풀려서는 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "부풀리기 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-012",
      "text": "장갑의 내부 및 외부 표면에서는 유해한 물리적 불규칙성이 없어야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-013",
      "text": "장갑은 모든 형식시험을 합격하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E189-014",
      "text": "절연용 장갑은 \"보호구 안전인증 고시(고용노동부 고시)\" 및 \"활선작업-전기 절연 장갑(KS C IEC 60903)\"에 적합하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E189-015",
      "text": "장갑은 제조사의 지침에 따라 보관하되 압축하거나, 접거나 혹은 스팀 파이프, 라디에이터 등의 인공적인 열원 근처에서 보관하거나 직사 광선, 인공광 등의 오존원에 노출시키지 않도록 주의를 기울인다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": "10℃ ~ 35℃ 주변의 온도가 바람직하다.",
      "workProcessPhase": "보호구 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-016",
      "text": "사용 전 한 쌍의 장갑을 육안 검사하고 공기 시험을 한다. 장갑 한 개가 불안전하다고 판단되면 그 쌍을 사용하지 않는다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 사용 전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-017",
      "text": "육안 검사 시, 손상으로는 핀홀, 관통, 균열, 절단, 화학물 흔적, 이물질 합입, 딱딱한 지점 등이 있으며, 이러한 손상 발견 시에는 사용해서는 아니 되며 검사 및 전기 보증시험(Proof Test)를 위한 시설로 보내야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 사용 전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-018",
      "text": "장갑을 열이나 빛에 불필요하게 노출시키거나 그 완전성에 영향 미칠 수 있는 어떤 물질(오일, 그리스, 강산, 화합물 용제 등)과도 접촉해서는 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-019",
      "text": "장갑 위에 가죽 보호 장갑을 착용하는 경우, 그 보호 장갑은 자연적인 형상으로 인해 내부 장갑이 변형되지 않도록 하는 크기와 형상을 지녀야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-020",
      "text": "장갑 위에 가죽 보호 장갑을 착용하는 경우, 가죽 보호 장갑은 내부 절연 장갑보다 짧아야 하며, 가죽 보호 장갑의 소매 끝단과 내부 장갑의 소매 끝단 상부 간의 최소 거리는 <표 5>에서 권고한 것 또는 작동 전압에 따라 권고되는 것 이상이어야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": "등급별 최소거리: 00,0등급 13mm / 1등급 25mm / 2등급 51mm / 3등급 76mm / 4등급 102mm",
      "workProcessPhase": "장갑 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-021",
      "text": "다른 목적으로 사용했던 보호 장갑을 장갑 보호 용도로 사용해서는 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-022",
      "text": "보호 장갑에 구멍, 젖어짐 또는 기계적 보호 능력에 영향을 미치는 기타 결함이 있는 경우, 그 장갑을 사용해서는 안 된다. 또한 보호 장갑에 손상을 일으킬 수 있는 오염물이 없도록 주의를 기울인다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-023",
      "text": "보호 장갑 내부면에 예리하거나 뾰족한 물체가 있는지 검사한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 사용 전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-024",
      "text": "오일, 그리스 또는 기타 유해한 물질과 접촉한 장갑은 작업 완료 후 신속하게 세척한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-025",
      "text": "사용 중에 젖거나 세척으로 인해 젖은 장갑은 장갑 온도가 65℃를 초과하지 않도록 주의하면서 완벽하게 건조시켜야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "장갑 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-026",
      "text": "시험은 전문 시험 기관에서 실시하여야 하며, 공식적으로 교육 받고 자격을 갖춘 자만이 정기 검사와 전기를 이용한 재시험을 수행할 수 있다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": "절연용 장갑 정기검사 및 전기 재시험",
      "workProcessPhase": "정기검사",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.4.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-027",
      "text": "최근 12개월 이내에 재시험을 거치지 않은 장갑을 사용하도록 출고해서는 안되며, 사용을 위해 출고한 이후 최대 6개월 이내에 시험을 거치지 않은 장갑을 사용해서는 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "정기검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-028",
      "text": "시험은 공기 누출이 있는지 점검하기 위한 공기 팽창, 가압하는 동안 육안 검사, <표 6> 규정된 기준에 따른 절연시험을 실시하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": "절연용 장갑 정기검사 시험 항목",
      "workProcessPhase": "정기검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-029",
      "text": "소매에는 유해한 물리적 결함이 내부 및 외부 표면에 있어서는 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-030",
      "text": "소매는 탄성중합체로 제조되고 이음이 없도록 매끄럽게 가공하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-031",
      "text": "끈 또는 벨트 부착용 소매 구멍은 비금속 보강을 하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-032",
      "text": "구멍은 소매 벨트의 고정 장치로 적합해야 하고 지름은 8mm로 하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-033",
      "text": "절연용 소매는 \"활선작업-전기 절연 소매(KS C IEC 60984)\"에 적합하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.2",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-E189-034",
      "text": "소매는 제조사의 지침에 따라 보관하되 스팀배관, 라디에이터 또는 다른 인공 열원으로부터 멀리 떨어진 컨테이너 또는 상자에 보관되어야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": "주위 온도 10℃ ~ 35℃ 권장",
      "workProcessPhase": "보호구 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-035",
      "text": "소매가 눌려지거나 접히지 않도록 주의해야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-036",
      "text": "소매는 직사광선, 인공 조명 또는 다른 오존원에 노출되어서는 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-E189-037",
      "text": "각각의 소매는 사용하기 전 내·외부 확인을 위해 뒤집어 놓아야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "소매 사용 전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-038",
      "text": "사용 전 소매 한 쌍 중 한 개가 불안전하다고 판단되면 그 쌍을 사용하지 않는다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": "손상: 핀홀, 관통, 균열, 절단, 화학물 흔적, 이물질 합입, 딱딱한 지점 등",
      "workProcessPhase": "소매 사용 전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.1",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-039",
      "text": "소매는 열이나 빛에 불필요하게 노출시키거나 그 완전성에 영향 미칠 수 있는 어떤 물질(오일, 그리스, 강산, 화합물 용제 등)과도 접촉해서는 안 된다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "소매 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-040",
      "text": "오일, 그리스 또는 기타 유해한 물질과 접촉한 소매는 작업 완료 후 신속하게 세척한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "소매 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-041",
      "text": "사용 중에 젖거나 세척으로 인해 젖은 소매는 소매의 온도가 65℃를 초과하지 않도록 주의하면서 완벽하게 건조시켜야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "소매 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-042",
      "text": "시험은 전문 시험 기관에서 실시하여야 하며, 공식적으로 교육 받고 자격을 갖춘 자만이 정기 검사와 전기를 이용한 재시험을 수행할 수 있다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": "절연용 소매 정기검사 및 전기 재시험",
      "workProcessPhase": "정기검사",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.4.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-043",
      "text": "최근 20개월 이내에 재시험을 거치지 않은 소매는 사용할 수 없으며, 공급 후 최대 20개월 이내에 시험을 거치지 않는 소매는 사용할 수 없다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "정기검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-E189-044",
      "text": "시험은 공기 누출이 있는지 점검하기 위한 공기 팽창, 가압하는 동안 육안 검사, <표 7> 규정된 기준에 따른 절연시험을 실시하여야 한다.",
      "guideContext": "절연용 (고무)보호구의 선정, 사용 및 관리",
      "additionalDetail": "절연용 소매 정기검사 시험 항목",
      "workProcessPhase": "정기검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4.3",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-E189-001",
      "term": "절연용 보호구",
      "definition": "노출된 충전부, 충전전로를 취급하는 작업 또는 그 인접한 곳에서 작업하는 경우, 감전으로부터 작업자를 보호하는 용도로 사용하는 절연용 장갑, 소매, 안전화 등과 같은 개인장비를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-E189-002",
      "term": "전기 절연 장갑",
      "definition": "감전으로부터 작업자를 보호하는 용도로 사용할 수 있는 것으로서 탄성중합체(Elastomer)로 만들어진 장갑을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-E189-003",
      "term": "전기 절연 소매",
      "definition": "상완(팔꿈치부터 어깨까지)을 전기 충격으로부터 보호하기 위해 전기 절연 장갑과 함께 사용되는 탄성중합체로 만들어진 소매를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-E189-004",
      "term": "탄성중합체",
      "definition": "약한 응력과 응력 방출에 의한 실질적인 변형이후, 최초의 치수와 모양으로 급격히 되돌아오는 고분자 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-005",
      "term": "보증 시험 전압",
      "definition": "절연의 전기 강도가 규정값 이상이라는 것을 확인하기 위해 규정된 조건 하에서 규정된 시간 동안 장갑에 가해지는 특정 전압을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-006",
      "term": "내전압 시험 전압",
      "definition": "규정된 조건 하에서 전압을 인가할 때 장갑이 파열 방전 없이 견디는 전압을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-007",
      "term": "최대 사용 전압(교류)",
      "definition": "보호계통(=시스템)의 실효값(rms) 전압 정격으로서 계통(=시스템)이 활성 상태일 때 안전하게 작업할 수 있는 최대 공칭 전압을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-008",
      "term": "최대 사용 전압(직류)",
      "definition": "안전하게 작업할 수 있는 활선 계통(=시스템)의 최대 공칭 전압을 규정하는 보호 장비의 직류 전압 정격을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-009",
      "term": "시스템 공칭 전압",
      "definition": "설계 또는 규정된 계통(=시스템)에 적용되는 적정한 값의 전압 또는 계통(=시스템)을 지정하거나 구분하는데 사용되는 전압의 개략적인 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-010",
      "term": "유해한 물리적 결함 또는 불규칙성",
      "definition": "균일하고 매끄러운 표면 윤곽을 저해하는 어떤 특징을 말한다. 예를 들면 핀홀, 균열, 기포, 절단, 전도성 합입 이물질, 주름, 집힌 자국, 공극, 눈에 띄는 물결 및 눈에 띄는 주형 자국 등이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-011",
      "term": "무해한 물리적 결함 또는 불규칙성",
      "definition": "제조 공정에서 내재된 어려움과 주형 결함으로 인해 내부 및 외부의 표면에 생기는 결함 또는 불규칙성을 말한다. 이러한 결함은 물질의 돌출부, 압입 자국, 돌기, 합입된 이물질 또는 색상 변집 등으로 나타날 수 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-012",
      "term": "오존무늬",
      "definition": "기계적 응력이 가해지고 있는 물질에 오존으로 생성된 균열(Crack)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-E189-013",
      "term": "오존",
      "definition": "매우 활동적인 산소의 형상으로 코로나와 아크 또는 자외선에 의해 만들어진 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-E189-01",
      "processOrder": 1,
      "processName": "절연용 보호구 등급 선정",
      "safetyMeasures": "최대사용전압에 따라 6개 등급(00~4등급)으로 구분하여 작업 전압에 맞는 등급의 보호구를 선정한다. 특수 성능(내산성, 내유성, 내오존성, 초저온 등)이 필요한 경우 해당 분류(A, H, Z, R, S, C, F)의 보호구를 선정한다.",
      "requiredPPE": [
        "절연용 장갑",
        "절연용 소매"
      ],
      "sourceSection": "4.1",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "WP-E189-02",
      "processOrder": 2,
      "processName": "육안점검 - 말기 방법",
      "safetyMeasures": "양손사이에 장갑과 슬리브의 내·외부 표면을 굴리는 방법으로 표면을 점검한다. 내부 표면을 살짝 꼬집어 바깥표면이 굽어지면서 갈라진 틈이나 잘림 또는 다른 결함을 확인한다. 바깥 부분 점검 완료 후 안쪽을 뒤집어 동일 방법으로 안쪽을 점검한다. 의심 부분은 손가락으로 부드럽게 꼬집거나 굴려 세밀히 조사한다.",
      "requiredPPE": [],
      "sourceSection": "4.5.1",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "WP-E189-03",
      "processOrder": 3,
      "processName": "육안점검 - 부풀리기 방법",
      "safetyMeasures": "양손으로 장갑 입구 모서리를 잡고 밀봉한 후, 목 부분을 바닥 쪽으로 말아 공기를 가둔다. 부풀어 오른 장갑을 귀에 대고 한 손으로 눌러 공기압을 상승시키면서 구멍에서 새는 소리를 듣는다. 제품 정상 크기의 1.25배 ~ 2배 이상 늘리거나 부풀려서는 안 된다.",
      "requiredPPE": [],
      "sourceSection": "4.5.2",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "WP-E189-04",
      "processOrder": 4,
      "processName": "절연용 장갑 사용 전 점검",
      "safetyMeasures": "사용 전 한 쌍의 장갑을 육안 검사하고 공기 시험을 실시한다. 핀홀, 관통, 균열, 절단, 화학물 흔적, 이물질 합입, 딱딱한 지점 등의 손상 발견 시 사용하지 않고 검사 및 전기 보증시험 시설로 보낸다. 장갑 한 개가 불안전하면 그 쌍을 사용하지 않는다.",
      "requiredPPE": [
        "절연용 장갑",
        "가죽 보호 장갑"
      ],
      "sourceSection": "5.4.1",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "WP-E189-05",
      "processOrder": 5,
      "processName": "절연용 장갑 사용 및 관리",
      "safetyMeasures": "열이나 빛에 불필요하게 노출하거나 오일, 그리스, 강산, 화합물 용제 등과 접촉하지 않는다. 가죽 보호 장갑은 내부 장갑 변형 방지를 위해 적절한 크기·형상이어야 하며, 내부 장갑보다 짧아야 한다. 다른 목적으로 사용했던 보호 장갑을 장갑 보호 용도로 사용하지 않는다. 유해 물질 접촉 시 신속히 세척하고, 젖은 장갑은 65℃ 이하로 건조한다.",
