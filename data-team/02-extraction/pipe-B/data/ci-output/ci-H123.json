  "checklistItems": [
    {
      "identifier": "CI-H123-001",
      "text": "통증의 완화는 치료 효과를 나타내는 유일한 지표이다. 그러므로 국소 진통제 또는 마취제는 사용을 금한다.",
      "guideContext": "불산·불화수소 피부 노출 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-002",
      "text": "모든 피복은 반드시 탈의해야 하며, 즉시 많은 양의 흐르는 물로 최소 30분 이상 씻어낸다. 조직에 흡수되는 시간 이전인 5분 이내로 최대한 빨리 씻어 내도록 한다.",
      "guideContext": "불산 피부 화상 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "피부 화상 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-003",
      "text": "2.5% 칼슘 글루코네이트 젤을 15분마다 발라주고, 통증이 사라질 때까지 지속해서 환부를 마사지한다. 환자를 만질 때에는 반드시 고무 또는 라텍스 장갑을 착용하여야 한다.",
      "guideContext": "불산 피부 화상 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "피부 화상 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-004",
      "text": "노출범위가 4평방인치(=25.864 cm2) 이상인 경우 즉시 입원하여 집중치료실로 보낸다. 최소 24~48시간동안 집중적으로 관리한다.",
      "guideContext": "불산 피부 화상 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "피부 화상 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-005",
      "text": "많은 양의 흐르는 물로 최소 30분 이상 씻어낸다.",
      "guideContext": "불산 눈 접촉 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "눈 접촉 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-006",
      "text": "오염원을 제거하는 동안에도 쉬지 말고 계속 씻어 내야하며 콘택트렌즈를 착용한 경우 제거 가능하다면 제거하고 씻어 낸다.",
      "guideContext": "불산 눈 접촉 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "눈 접촉 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-007",
      "text": "기름, 연고, 기타 불산 피부화상 치료제를 사용하지 않는다.",
      "guideContext": "불산 눈 접촉 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "눈 접촉 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-008",
      "text": "즉각 안과 전문의의 치료를 받도록 한다.",
      "guideContext": "불산 눈 접촉 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "눈 접촉 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-009",
      "text": "주의 깊게 관찰하며, 즉각 전문 병원으로 후송한다. 집중 관리를 위해 전문 의료진의 치료를 받도록 한다.",
      "guideContext": "불화수소 흡입 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불화수소 흡입 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-010",
      "text": "불산 누출 구역에서 즉각 피해자를 멀리 이송하여 추가적인 흡인을 방지한다.",
      "guideContext": "불화수소 흡입 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불화수소 흡입 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-011",
      "text": "마스크로 100%의 산소를 공급한다.",
      "guideContext": "불화수소 흡입 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불화수소 흡입 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-012",
      "text": "강제로 구토를 유발시키거나 베이킹소다 또는 구토제를 먹이지 않는다.",
      "guideContext": "불산 섭취 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산 섭취 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-013",
      "text": "1~3컵 정도의 우유 또는 물을 마시게 하거나 마그네슘이나 칼슘을 함유한 10% 농도의 제산제를 먹인다.",
      "guideContext": "불산 섭취 응급처치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산 섭취 응급처치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-014",
      "text": "누출 시 근로자 및 인근주민에 대한 비상경보를 내린다",
      "guideContext": "비상대응조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-015",
      "text": "대피경보 시스템, 원격조정 긴급차단 밸브, 살수 설비, 신속한 제품 이송, 인근 주민 고지 등 비상대응 시스템을 갖춘다.",
      "guideContext": "비상대응조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-016",
      "text": "사고 시 임시로 대피할 수 있는 피난처를 갖추고 피난처에 개인보호구를 구비해 둔다.",
      "guideContext": "비상대응조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-017",
      "text": "노출 피해자 발생 시 즉각 응급조치를 할 수 있는 자를 현장에 상주시킨다.",
      "guideContext": "비상대응조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-018",
      "text": "응급조치 키트를 갖추고 이를 보관할 냉장설비를 구비한다.",
      "guideContext": "비상대응조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-019",
      "text": "후송 시스템을 갖추어, 사고발생 시 전문병원에 즉각 후송 후 바로 전문 의료진의 처치를 받을 수 있도록 한다.",
      "guideContext": "비상대응조치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.7",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-020",
      "text": "단독으로 불산/불화수소를 다루는 모든 작업은 반드시 사전 훈련 및 고지를 거쳐야 한다.",
      "guideContext": "불산·불화수소 취급자 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육·훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-021",
      "text": "단독으로 불산/불화수소를 다루는 모든 작업자는 반드시 근무 장소에 비치된 표준작업지침서에 대한 내용을 숙지하고 있어야 한다.",
      "guideContext": "불산·불화수소 취급자 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육·훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-022",
      "text": "취급공정에 배치할 근로자에게는 불산/불화수소의 물리·화학적 특성, 개인 보호구, 안전한 취급방법, 응급조치 요령 등에 대한 정기적인 교육 및 훈련을 실시하여야 한다.",
      "guideContext": "불산·불화수소 취급자 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육·훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-023",
      "text": "불산/불화수소 취급설비를 점검·정비하는 작업자의 경우에도 불산/불화수소의 물리·화학적 특성, 개인보호구, 안전한 취급방법, 응급조치 요령 및 기계 장치의 특성, 사용금지 재질, 안전 정비 절차 등을 반드시 사전에 확인토록 하여야 한다.",
      "guideContext": "불산·불화수소 취급자 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육·훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-024",
      "text": "불산/불화수소를 취급하는 근로자 및 해당 업무에 종사하게 될 근로자에 대해서는 다음 내용이 포함된 특별안전보건 교육을 16시간 이상 실시한다.",
      "guideContext": "불산·불화수소 취급자 교육 (법령 근거 미확인)",
      "additionalDetail": "교육 내용: 물질안전보건자료, 중독과 건강장해 예방대책, 직업병 예방 조치 사항 및 유지·관리 요령, 국소배기장치 및 안전설비, 기타 안전·보건상의 조치",
      "workProcessPhase": "교육·훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-025",
      "text": "절대 혼자 떨어져서 근무하지 않는다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-026",
      "text": "누출감지 경보설비를 설치하고 기능을 유지하도록 관리한다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-027",
      "text": "응급상황에서 바로 쓸 수 있는 도구를 구비해 놓는다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-028",
      "text": "누출시 중화시킬 수 있는 수산화칼슘(Ca(OH)2), 산화칼슘(CaO) 혹은 염화칼슘(CaCl2)을 준비해둔다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-029",
      "text": "개인보호구(내산성 보호복, 호흡용보호구, 내산성 안전장갑, 내산성 보호 장화 등)를 철저하게 착용한다. 불산을 다룰 때는 피부 전체는 물론 보호 안경까지 착용을 해야 사고로 인한 피해를 막을 수 있다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-030",
      "text": "불산/불화수소 관련 모든 컨테이너 및 파이프, 오염물 및 부산물에 라벨링을 한다. 이때 물과 쉽게 구별할 수 있도록 한다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-031",
      "text": "작업구역 표시를 철저히 한다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-032",
      "text": "사전에 누출을 대비한 누출시의 위험성 평가를 실시하여 위험성을 인식하고, 누출상황별 비상조치를 계획을 수립하도록 한다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-033",
      "text": "불산 취급설비의 뚜껑, 플랜지, 밸브 및 콕 등의 접합부에서 누출을 방지하기 위한 밸브교체주기 준수 및 적정가스켓을 사용하고, 예방정비를 실시한다.",
      "guideContext": "불산·불화수소 누출 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 설비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-034",
      "text": "탱크 컨테이너와 화학설비를 안전하게 연결하는 순서를 준수한다.",
      "guideContext": "불산·불화수소 누출 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 설비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-035",
      "text": "불산 공급탱크 등 화학설비를 개조하거나 수리할 때에는 작업책임자를 지정하여 해당 작업을 지휘하도록 한다.",
      "guideContext": "불산·불화수소 누출 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 설비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-036",
      "text": "불산 탱크 수리 시 탱크내부 잔류 불산 제거를 한 후에 실시한다.",
      "guideContext": "불산·불화수소 누출 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 설비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-037",
      "text": "밸브교체작업 후 재사용하기 전에 배관과 밸브의 이상 유무를 확인하기 위한 누설시험을 실시한다.",
      "guideContext": "불산·불화수소 누출 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 설비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-038",
      "text": "불산의 누출 및 실내농도증가 시에는 신속하게 작업중단조치를 한다.",
      "guideContext": "불산·불화수소 사고 시 확산 최소화 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-039",
      "text": "작업절차를 준수하고 작업절차를 주기적으로 검토하여 보완하고 근로자들을 교육한다.",
      "guideContext": "불산·불화수소 작업 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-040",
      "text": "작업환경 및 취급조건을 고려하여 적절한 등급의 보호구를 선정하여야 한다. 보호구는 A~D의 4등급으로 구분한다.",
      "guideContext": "불산·불화수소 개인보호구 등급 선정 (법령 근거 미확인)",
      "additionalDetail": "A등급: 완전 밀폐형 내산 양압 자가호흡장치(SCBA), B등급: 송기마스크+내산성 장비, C등급: 전면 보안면+내산성 장비, D등급: 전면보안면 또는 고글+내산성 장비",
      "workProcessPhase": "보호구 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-041",
      "text": "A, B 등급에 해당하는 작업장소에서 작업 시, 반드시 주 작업자와 함께 적절한 보호장구를 갖춘 보조작업자가 같이 동행해야 한다.",
      "guideContext": "불산·불화수소 보조작업자 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "불산·불화수소 취급 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-042",
      "text": "응급상황 시 사용할 수 있는 개인보호구는 1개 이상의 장소에 보관해 두어야 한다.",
      "guideContext": "불산·불화수소 보호구 비치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-043",
      "text": "사용 후에는 개인보호구를 즉시 중화하고 세척해야 한다.",
      "guideContext": "불산·불화수소 보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-044",
      "text": "보호구의 중화 및 세척 장비를 갖추어야 한다.",
      "guideContext": "불산·불화수소 보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H123-045",
      "text": "중화 및 세척과정 시 노출될 위험성을 고려하고 이에 대한 안전장치를 마련한다.",
      "guideContext": "불산·불화수소 보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "9.3",
      "basedOn": null
    }
