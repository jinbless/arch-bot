  "domainTerms": [
    {
      "identifier": "DT-BM3-001",
      "term": "조크러서형 파쇄기",
      "definition": "직경 150 cm이하의 고형건조 재료인 원석을 압력, 충격 또는 마찰 등에 의해서 직경 5 cm 내지 15 ㎝의 크기로 분쇄하기 위해서 사용되는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM3-002",
      "term": "방책형 가드",
      "definition": "위험지역에 정상적인 접근을 방지하기 위하여 설치하는 충분한 높이의 담장형 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM3-003",
      "term": "고정가드",
      "definition": "기계에 견고하게 고정되어 공구를 사용치 않고는 제거 또는 개방할 수 없으며 운동부위가 없는 가드를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM3-004",
      "term": "연동장치",
      "definition": "기계의 각 작동부분 상호간을 전기적, 기계적 또는 유공압을 연결하여 기계의 각 작동부분이 정상으로 작동하기 위한 조건이 만족되지 않는 경우 자동적으로 그 기계를 작동할 수 없도록 하는 기구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM3-005",
      "term": "감응형 방호장치",
      "definition": "어떠한 대상이 있음을 감지하거나, 방호차단을 위하여 감지소자, 제어·감시장치, 출력신호 개폐장치 등의 부품으로 구성된 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM3-006",
      "term": "쐐기형 수공구",
      "definition": "파쇄기의 고정판과 진동판 사이에 원석이 걸렸을 때 파쇄기를 정지시키지 않고 걸린 원석을 공급·제거하기 위한 수공구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
