  "checklistItems": [
    {
      "identifier": "CI-H223-001",
      "text": "편안한 의자와 책상을 갖춘 조용하고 격리된 방이 필요하다.",
      "guideContext": "특수건강진단 신경행동검사 검사실 환경 (법령 근거 미확인)",
      "additionalDetail": "컴퓨터 신경행동검사의 경우 한 개의 검사실에서 검사자 한명이 최대 5명의 피검자들을 동시에 검사할 수 있다.",
      "workProcessPhase": "검사 환경 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-002",
      "text": "모니터를 보는데 조명이 방해가 되지 않아야 한다.",
      "guideContext": "특수건강진단 신경행동검사 검사실 환경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검사 환경 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-003",
      "text": "검사를 방해할 수 있는 외부 소음을 차단하고 검사중 전화의 사용을 제한하여야 한다.",
      "guideContext": "특수건강진단 신경행동검사 검사실 환경 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검사 환경 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-004",
      "text": "출장건강진단에서 신경행동검사를 수행할 필요가 발생하였을 경우 부호숫자짝짓기(연습수행 3회 포함하여 총 7회)를 수행하고 정답수, 정답률, 반응시간, 반응시간의 표준편차, 총 4개의 측정값(parameters) 중 1개라도 30% 이하인 경우 추가 검사 대상자로 선별한다.",
      "guideContext": "특수건강진단 출장건강진단 이상자 선별",
      "additionalDetail": null,
      "workProcessPhase": "이상자 선별",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-005",
      "text": "원내에서 신경행동검사를 2차 검사항목으로 수행하는 경우 선택반응검사(연습수행 1회 포함하여 3회), 색단어선택(연습수행 1회 포함하여 2회), 숫자구분(연습수행 1회 포함하여 1회), 숫자더하기(연습수행 1회 포함하여 3회), 부호숫자짝짓기(연습수행 3회 포함하여 7회), 정방향 숫자외우기(연습수행 1회 포함하여 2회), 총 6개의 검사로 구성된 신경행동검사 꾸러미를 실시한다.",
      "guideContext": "특수건강진단 원내 정밀검사",
      "additionalDetail": null,
      "workProcessPhase": "신경행동검사 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-006",
      "text": "6개 검사의 정답수, 정답률, 평균반응시간, 반응시간의 표준편차 중 2개 검사 이상에서 백분위가 10% 이하인 피검자와 6개 검사에서 산출된 20개 측정값(parameters)의 백분위의 평균이 30% 이하인 경우 유소건자로 판단한다.",
      "guideContext": "특수건강진단 원내 정밀검사 유소건자 판정",
      "additionalDetail": null,
      "workProcessPhase": "이상자 선별",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-007",
      "text": "특수검진 관정의사는 신경행동검사 측정값의 표준편차가 매우 크거나, 정답률이 낮은 경우 실제로 신경행동기능이 저하된 것인지 아니면 피검자가 검사자체를 잘 이해하지 못하였는지 피검자가 진지하게 검사에 임하지 않은 것인지를 확인한다.",
      "guideContext": "특수건강진단 가병검사",
      "additionalDetail": null,
      "workProcessPhase": "가병검사 및 감별진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-008",
      "text": "신경행동기능이 감소한 경우 비타민 결핍(B₁ 및 B₁₂), 갑상선 기능저하, 수면 무호흡증후군, 다발성 경화증, 당뇨병, 뇌혈관성 치매 등을 감별해야 하고, 알코올 및 약물 남용 및 약물의 부작용, 주요 우울장애 등 학습 및 주의력 능력에 영향을 줄 수 있는 문제들도 감별한다.",
      "guideContext": "특수건강진단 감별진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "가병검사 및 감별진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-009",
      "text": "근로자가 보상에 관심이 있거나 보상절차를 진행 중인 경우 검사결과에 부정적인 영향을 미칠 수 있으므로 보상과 관련된 상황도 살핀다.",
      "guideContext": "특수건강진단 감별진단",
      "additionalDetail": null,
      "workProcessPhase": "가병검사 및 감별진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-010",
      "text": "특수검진 결과 직업병 유소건자나 요관찰자로 관정받은 근로자는 2차 검사항목을 1차 건강진단에 실시할 수 있으므로 6개월 후 반복검사를 하는 경우 2차 검사항목 6개 꾸러미를 수행한 후 6개 검사항목에서 모두 정상범주로 나타나면 정상으로 관정한다.",
      "guideContext": "특수건강진단 추적검사",
      "additionalDetail": null,
      "workProcessPhase": "추적검사 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-011",
      "text": "감소된 신경행동기능이 회복되더라도 유기용제 등 신경독성물질에 노출이 없는 부서에서 근무하도록 권고한다.",
      "guideContext": "특수건강진단 추적검사 사후관리",
      "additionalDetail": null,
      "workProcessPhase": "추적검사 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-012",
      "text": "감소된 신경행동기능이 회복되지 않는 경우 신경독성물질에 계속 노출되고 있는지는 않는지, 음주량의 증가 등 다른 개인적 요인은 없는지 확인한다.",
      "guideContext": "특수건강진단 추적검사 사후관리",
      "additionalDetail": null,
      "workProcessPhase": "추적검사 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-013",
      "text": "유소건 의심자에서 6개월 간격으로 추적검사를 2회 실시한 후 신경행동기능에서 의미있는 변화(감소)가 없다면 일반적 요관찰자(C₁)로 관정하고 6개월 간격으로 검사를 반복하면서 계속 관찰한다.",
      "guideContext": "특수건강진단 추적검사 판정",
      "additionalDetail": null,
      "workProcessPhase": "추적검사 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-014",
      "text": "추적검사에서 유소건 의심자의 신경행동기능이 의미있게 감소하는 경우, 감별진단과 가병검사를 거쳐 독성뇌병증 유소건자(D₁)로 관정하고 노출중단을 권고한다.",
      "guideContext": "특수건강진단 추적검사 판정",
      "additionalDetail": null,
      "workProcessPhase": "추적검사 및 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-015",
      "text": "연령과 교육수준은 신경행동검사의 소항목의 선택과 결과의 해석에 반드시 고려되어야 한다.",
      "guideContext": "특수건강진단 신경행동검사 결과해석 (법령 근거 미확인)",
      "additionalDetail": "WHO-NCTB는 12년 이상의 교육기간을 가지는 성인 대상자에서 적절하게 사용될 수 있으나 8-10년 사이의 교육기간을 가진 대상자에서는 타당성이 다소 감소하며 8년 미만의 대상자에서는 타당성을 인정하기 어려운 것으로 보고되고 있다",
      "workProcessPhase": "결과 해석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-016",
      "text": "음주습관은 신경행동검사에 영향을 크게 미치는 개인적 특성이므로 대상자의 음주력을 정확히 평가한다.",
      "guideContext": "특수건강진단 신경행동검사 결과해석",
      "additionalDetail": null,
      "workProcessPhase": "결과 해석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-H223-017",
      "text": "각 검사의 표준점수가 30점 이상인 경우는 정상으로, 20점 미만인 경우 신경행동기능이 매우 저하(poor)된 것으로 해석한다.",
      "guideContext": "특수건강진단 WHO-NCTB 이상자 선별기준",
      "additionalDetail": "표준점수 공식은 [(원점수-평균)/표준편차]*10+50 이다.",
      "workProcessPhase": "이상자 선별",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    }
  ],
