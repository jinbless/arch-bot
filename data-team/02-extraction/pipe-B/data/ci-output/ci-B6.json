      ]
    },
    {
      "identifier": "CI-B6-012",
      "text": "파랑으로 인한 선체의 요동으로 적재물의 전도, 탈락 등 예방조치 확인",
      "guideContext": "부선 운반시 적재물 점검",
      "additionalDetail": null,
      "workProcessPhase": "부선 운반 전 점검",
