  "checklistItems": [
    {
      "identifier": "CI-W23-001",
      "text": "소음 노출의 위험성을 식별 및 평가하기 위해서는 소음측정을 시행하여야 한다. 이는 신중히 계획하여 전문가들이 적합한 시간 간격을 두고 시행하여야 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소음측정 사전계획",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-002",
      "text": "소음 측정은 건물 보수나 새로운 기계 또는 기술(작업 공정)의 도입으로 인하여 음향 환경에 변경사항이 발생할 때마다 시행하여야 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-003",
      "text": "사용할 측정장비는 적합하고 신뢰할 수 있어야 하며, 소음계는 사용할 때마다 매번 교정해야 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "소음기기 교정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-004",
      "text": "측정자는 필요한 전문지식 및 경험을 갖추어야 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-005",
      "text": "마이크로폰은 음압변동을 전기적 신호로 변환시키며, 기기의 본체와 분리가 가능하여야 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-006",
      "text": "측정위치 작업자의 청각영역에서 측정한다. 청각영역이란 귀를 중심으로 반경 30cm 반구로 정의하며, 만약 양쪽 귀의 소음수준이 다를 땐 높은 쪽에서 측정한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "적분형 소음계(누적소음노출량 측정기) 사용 시 측정 위치 기준",
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-007",
      "text": "보정은 소음을 정확하게 측정하기 위해 측정 전과 측정 후에 실시한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": null,
      "workProcessPhase": "소음기기 교정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-008",
      "text": "보관은 충격, 진동을 주지 않고 고온, 다습한 장소에서의 보관은 피하도록 한다. 쓰레기, 먼지가 마이크의 진동관에 붙어 감도에 영향을 주므로 사용하지 않을 때는 케이스에 보관한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": null,
      "workProcessPhase": "소음기기 교정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-009",
      "text": "1일 작업시간 동안 1시간 간격으로 6회 이상 소음수준을 측정한 경우에는 이를 평균하여 8시간 작업 시의 평균 소음수준을 나타낸다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "지시소음계에 의한 평가 방법",
      "workProcessPhase": "소음측정 결과 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-010",
      "text": "소음 발생 특성이 연속음으로서 측정치 변동이 없다고 판단하여 1시간 동안 등간격으로 3회 이상 측정한 경우에는 이를 평균 하여 8시간 작업 시의 평균 소음 수준을 나타낸다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "지시소음계에 의한 평가 - 연속음인 경우",
      "workProcessPhase": "소음측정 결과 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-011",
      "text": "소음 발생시간이 6시간 이내인 경우나 소음원에서 발생하는 시간이 간헐적인 경우에는 발생시간 동안 연속 측정하거나 등간격으로 4회 이상 측정한 경우에는 이를 평균하여 그 기간의 평균 소음수준으로 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "지시소음계에 의한 평가 - 간헐적 소음인 경우",
      "workProcessPhase": "소음측정 결과 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-012",
      "text": "방향음에 대한 영향을 배제하기 위하여 측정시 실내소음도는 실내에 고르게 분포하는 4개 이상의 측정점을 선정하여 동시에 측정하되, 마이크로폰 높이는 바다으로부터 1.2~1.5미터, 벽면 등(높이가 0.5미터 이상인 가구 등이 있는 경우에는 그 면으로부터)으로부터는 0.5미터, 마이크로폰 사이는 0.7미터 이상 이격하여 측정한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "지시소음계에 의한 실내소음 측정 시 마이크로폰 배치 기준",
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-013",
      "text": "누적소음노출량 측정기(Noise Dosimeter)는 ANSI S1-25-1978 규격에 적합한 것을 사용하며 작업자의 이동성이 크거나 소음의 강도가 불규칙으로 변동하는 소음의 측정에 이용한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": null,
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-014",
      "text": "1일 작업시간 동안 6시간 이상 연속 측정하거나 소음발생시간이 6시간 이내인 경우나 발생시간이 간헐적인 경우에는 발생시간동안 연속 측정한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "누적소음노출량 측정기에 의한 측정 시간 기준",
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-015",
      "text": "측정위치 마이크로폰을 작업자의 청각영역내의 옷깃에 부착시키며 마이크로폰을 보호구나 의복 등으로 차단시키지 않도록 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "누적소음노출량 측정기 마이크로폰 부착 위치",
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-016",
      "text": "부착시 작업자에게 소음기를 떼어낼 시간과 장소를 알려주며 임의로 떼거나 조작해서는 안된다는 것을 사전에 충분히 주지시킨다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": "누적소음노출량 측정기 부착 시 작업자 안내사항",
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-017",
      "text": "소음계의 청감보정회로는 A특성으로 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": null,
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-018",
      "text": "소음계의 지시침의 동작은 느린(Slow)상태로 한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": null,
      "workProcessPhase": "소음측정 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-019",
      "text": "노출기준은 8시간 시간가중치를 의미하므로 90dB를 설정한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "누적소음노출량 측정기의 노출기준 설정값",
      "workProcessPhase": "소음측정 결과 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-020",
      "text": "115dB(A)를 초과하는 소음 수준에 노출되어서는 안됨",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": "소음의 노출기준(충격소음 제외)",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "부록 1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-021",
      "text": "최대 음압수준이 140dB(A)를 초과하는 충격소음에 노출되어서는 안됨",
      "guideContext": "작업장에서의 소음측정 및 평가방법 (법령 근거 미확인)",
      "additionalDetail": "충격소음의 노출기준",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "부록 1",
      "basedOn": null
    },
    {
      "identifier": "CI-W23-022",
      "text": "평가방법 6시간 이상 연속 등가 소음도를 측정하거나 1시간 간격으로 6회 이상 측정해 시간가중 평균하여 노출기준과 비교한다.",
      "guideContext": "작업장에서의 소음측정 및 평가방법",
      "additionalDetail": "적분형 소음계(누적소음노출량 측정기)에 의한 평가방법",
      "workProcessPhase": "소음측정 결과 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-W23-001",
      "term": "소음작업",
      "definition": "1일 8시간 작업을 기준으로 85데시벨 이상의 소음이 발생하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W23-002",
      "term": "지시소음계",
      "definition": "소음계의 일종으로서, 마이크로폰으로 수용한 소음을 증폭(增幅)하여 계기에 직접 폰 또는 데시벨 눈금으로 지시하는 소음계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W23-003",
      "term": "누적소음 노출량 측정기",
      "definition": "작업자가 여러 작업장소를 이동하면서 작업하는 경우, 근로자에게 직접 부착하여 작업시간(8시간) 동안 작업자가 노출되는 소음 노출량을 측정하는 기계를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W23-004",
      "term": "등가소음레벨",
      "definition": "소음레벨이 시간과 더불어 변화할 때 측정시간 내에 발생된 변동소음의 총에너지를 연속된 정상소음의 에너지로 등가하여 얻어진 소음레벨을 의미한다.",
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
      "identifier": "DT-W23-005",
      "term": "역치",
      "definition": "누적소음노출량 측정기가 측정치를 적분하기 시작하는 A특성 소음치의 하한치를 의미한다.",
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "DT-W23-006",
      "term": "교환율",
      "definition": "소음수준이 어느 정도 증가할 때마다 노출 시간을 절반으로 감소시킬 것인가를 의미한다.",
      "sourceSection": "6.2",
      "relatedSR": null
    },
    {
      "identifier": "DT-W23-007",
      "term": "청각영역",
      "definition": "귀를 중심으로 반경 30cm 반구로 정의하며, 만약 양쪽 귀의 소음수준이 다를 땐 높은 쪽에서 측정한다.",
      "sourceSection": "5.1",
      "relatedSR": null
    }
  ],
