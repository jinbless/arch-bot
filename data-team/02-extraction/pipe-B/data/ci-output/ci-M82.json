  "checklistItems": [
    {
      "identifier": "CI-M82-001",
      "text": "작업순서를 정하고 그 순서에 의하여 작업을 실시한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "일반 준수사항",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-011"
      ]
    },
    {
      "identifier": "CI-M82-002",
      "text": "비·눈 그 밖의 기상상태(천둥, 번개, 돌풍 등)의 불안정으로 인하여 날씨가 몹시 나쁠 때에도 그 작업을 중지시킨다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "일반 준수사항",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M82-003",
      "text": "작업장소는 안전한 작업이 이루어 질 수 있도록 충분한 공간을 확보하고 장애물이 없도록 한다.",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 준수사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-004",
      "text": "들어 올리거나 내리는 기자재는 균형을 유지하면서 작업을 실시한다.",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반 준수사항",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-005",
      "text": "크레인의 능력과 사용조건에 따라 충분한 응력을 갖는 구조로 기초를 설치하고 침하 등이 일어나지 않도록 한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "기초 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M82-006",
      "text": "규격품인 조립용 볼트를 사용하고 대칭되는 곳을 순차적으로 결합하고 분해한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "일반 준수사항",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-011"
      ]
    },
    {
      "identifier": "CI-M82-007",
      "text": "타워크레인의 설치·조립·해체작업을 하는 때에는 다음 각호의 사항이 모두 포함된 작업계획서를 작성하고 이를 준수하여야 한다. (가) 타워크레인의 종류 및 형식 (나) 설치·조립 및 해체순서 (다) 작업도구·장비·가설설비 및 방호설비 (라) 작업인원의 구성 및 작업근로자의 역할범위 (마) 산업안전보건기준에관한규칙 제142조(타워크레인의 지지)의 규정에 의한 지지방법",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": "안전보건규칙 제38조(사전조사 및 작업계획서의 작성 등) 근거",
      "workProcessPhase": "작업계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-008",
      "text": "작업계획서를 작성한 때에는 그 내용을 작업근로자에게 주지시켜야 한다.",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업계획서 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-009",
      "text": "작업책임자는 작업인원의 구성 및 작업근로자의 역할범위에 따른 작업을 지휘 감독하며, 이때 작업책임자는 <별표 1>에 따른 작업근로자의 자격여부를 확인하고 안전교육을 실시해야한다.",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전대책",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-010",
      "text": "타워크레인의 설치·조립·해체작업은 대부분이 고소작업으로 추락재해방지를 위한 조치를 해야 한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "안전대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-M82-011",
      "text": "볼트, 너트 등을 풀거나 체결 시 또는 공구 등의 사용 시 낙하방지 조치를 해야 한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "안전대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-FALL-002"
      ]
    },
    {
      "identifier": "CI-M82-012",
      "text": "타워크레인의 설치·조립·해체작업은 해당 작업 위치에서 순간풍속이 10 m/s를 초과하는 경우에는 작업을 중지한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "안전대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CRANE-005"
      ]
    },
    {
      "identifier": "CI-M82-013",
      "text": "긴 부재의 권상 시는 안전하게 사용을 위한 보조로프를 사용한다.",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전대책",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-014",
      "text": "부재의 중량에 적합한 줄걸이 용구를 선택하여 사용한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": null,
      "workProcessPhase": "안전대책",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CARGO-002"
      ]
    },
    {
      "identifier": "CI-M82-015",
      "text": "작업계획서에 의하여 작업방법과 작업근로자를 배치하고 당해 작업을 지휘 감독한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": "작업책임자의 직무",
      "workProcessPhase": "작업 지휘 감독",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-011"
      ]
    },
    {
      "identifier": "CI-M82-016",
      "text": "재료의 결함 유무 또는 기구 및 공구의 기능을 점검하고 불량품을 제거한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": "작업책임자의 직무",
      "workProcessPhase": "작업 전 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CARGO-002"
      ]
    },
    {
      "identifier": "CI-M82-017",
      "text": "작업 중 안전대 및 안전모의 착용상태를 감시한다.",
      "guideContext": "타워크레인 설치·조립·해체작업",
      "additionalDetail": "작업책임자의 직무",
      "workProcessPhase": "작업 중 감시",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-FALL-003"
      ]
    },
    {
      "identifier": "CI-M82-018",
      "text": "설치·조립·해체작업 범위내의 위험구역에 작업자의 출입을 금지한다.",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": "작업책임자의 직무",
      "workProcessPhase": "작업 중 감시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-019",
      "text": "설치·조립·해체하여야 할 타워크레인의 크기 및 종류에 따라 이동식 크레인을 선정하여야 하며, 이때 최대 권상높이, 가장 무거운 부재의 중량, 이동식 크레인의 작업반경을 반드시 검토해야한다.",
      "guideContext": "타워크레인 설치·조립·해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "이동식 크레인 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-020",
      "text": "크레인이 설치될 지면은 견고하며 하중을 충분히 지지할 수 있어야 한다. 보통 지내력은 2 kgf/㎠이상 이어야 하며, 그렇지 않을 경우는 콘크리트 파일 등을 항타한 후 재하시험(載荷試驗 loading test)을 하고 그 위에 콘크리트 블록을 설치한다.",
      "guideContext": "타워크레인 설치작업",
      "additionalDetail": null,
      "workProcessPhase": "기초 앵커 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M82-021",
      "text": "기초 앵커는 기초앵커전용의 템플리트를 사용하여 정확하게 위치를 잡는다.",
      "guideContext": "타워크레인 설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 앵커 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-022",
      "text": "레벨게이지로 수평을 확인 한 후에, 기초앵커의 철 배근을 설치하고 콘크리트를 타설 및 다짐작업을 한다.",
      "guideContext": "타워크레인 설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 앵커 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-023",
      "text": "콘크리트가 완전하게 양생한 후 다음 작업에 임한다.",
      "guideContext": "타워크레인 설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기초 앵커 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-024",
      "text": "기초 앵커 설치는 도면에 의해 철근을 설치하고 콘크리트를 타설 해야 하며 <별표2>의 타워크레인 설치확인서에 작업사진을 첨부하여 작업과정을 확인 할 수 있도록 한다.",
      "guideContext": "타워크레인 설치작업",
      "additionalDetail": null,
      "workProcessPhase": "기초 앵커 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-COLLAPSE-002"
      ]
    },
    {
      "identifier": "CI-M82-025",
      "text": "플랫폼이 떨어지지 않도록 견고히 조립한다.",
      "guideContext": "타워크레인 설치작업 (법령 근거 미확인)",
      "additionalDetail": "텔레스코픽 케이지 설치 유의사항",
      "workProcessPhase": "텔레스코픽 케이지 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-026",
      "text": "텔레스코픽 케이지의 롤러가 자유롭게 구동하는지 점검하고 장애물이 있을 경우에 재거한다.",
      "guideContext": "타워크레인 설치작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "텔레스코픽 케이지 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-027",
      "text": "과부하방지용 리밋스위치(Limit switch)가 자유롭게 움직이는지 점검하고 장애물이 있는 경우에는 장애물을 제거한다.",
      "guideContext": "타워크레인 설치작업",
      "additionalDetail": "캣(타워) 헤드 설치",
      "workProcessPhase": "캣(타워) 헤드 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.5",
      "basedOn": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "CI-M82-028",
      "text": "카운터 웨이트는 반드시 메인지브 설치 후 부착한다. 카운터 웨이트의 콘크리트 비중은 2.4를 기준으로 제작하며, 양생이 완료된 후에 중량을 확인하고 합격된 제품만을 사용한다.",
      "guideContext": "타워크레인 설치작업",
      "additionalDetail": "카운터 지브 설치",
      "workProcessPhase": "카운터 지브 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.6",
      "basedOn": [
        "SR-CONSTRUCTION_EQUIP-011"
      ]
    },
    {
      "identifier": "CI-M82-029",
      "text": "지브 거리별 정격하중 표를 참조하여 하중표지관을 설치한다.",
      "guideContext": "타워크레인 설치작업 (법령 근거 미확인)",
      "additionalDetail": "메인 지브 설치",
      "workProcessPhase": "메인 지브 및 권상장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.7",
      "basedOn": null
    },
    {
      "identifier": "CI-M82-030",
      "text": "모든 리밋스위치를 조절하고 접검한다.",
      "guideContext": "타워크레인 설치작업",
      "additionalDetail": "메인 지브 및 권상장치 설치 완료 후",
      "workProcessPhase": "메인 지브 및 권상장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.7",
      "basedOn": [
        "SR-CRANE-002"
      ]
    },
    {
      "identifier": "CI-M82-031",
