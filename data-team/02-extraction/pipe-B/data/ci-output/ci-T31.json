  "checklistItems": [
    {
      "identifier": "CI-T31-001",
      "text": "부유기 물 위에 먼지 등 이물질이 떠다니지 않도록 주의한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "박절 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-T31-002",
      "text": "박절기에 사용되는 칼날 등에 상처를 입지 않도록 주의하고 박절 작업 시 적절한 보호구(안전장갑 등)를 사용하도록 한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침",
      "additionalDetail": null,
      "workProcessPhase": "박절 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-T31-003",
      "text": "염색기 사용 전 각 시약의 상태를 확인한 후 필요시 시약교체주기에 맞춰 시약을 교체한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침 (법령 근거 미확인)",
      "additionalDetail": "시약 교체주기는 표 1 및 사용하는 염색기의 설명서를 참고한다.",
      "workProcessPhase": "염색 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T31-004",
      "text": "염색이 완료되면 랙에서 슬라이드를 빼내어 현미경의 저배율로 슬라이드의 품질을 확인하고 검경에 적합하지 않은 경우(검경에 적합한 단면이 아니거나 조직에 인위적인 불량이 있거나 불완전한 염색 등) 슬라이드를 다시 제작한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "염색 작업(기기)",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T31-005",
      "text": "품질 확인이 완료된 슬라이드는 적절한 보관함에 넣어 보관한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "염색 작업(기기)",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-T31-006",
      "text": "사용 완료한 시약(크실렌, 헤마톡실린, 에오신, 크실렌 대체제 등)은 지정된 폐액통에 회수한 후 적합한 방법으로 폐기하도록 한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침",
      "additionalDetail": null,
      "workProcessPhase": "염색 작업(기기)",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-T31-007",
      "text": "염색이 완료되면 랙에서 슬라이드를 빼내어 현미경의 저배율로 슬라이드의 품질을 확인하고 검경에 적합하지 않은 경우(검경에 적합한 단면이 아니거나 조직에 인위적인 불량이 있거나 불완전한 염색 등) 슬라이드를 다시 제작한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침 (법령 근거 미확인)",
      "additionalDetail": "수동 염색 시 품질 확인",
      "workProcessPhase": "염색 작업(수동)",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T31-008",
      "text": "품질 확인이 완료된 슬라이드는 적절한 보관함에 넣어 보관한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침 (법령 근거 미확인)",
      "additionalDetail": "수동 염색 후 보관",
      "workProcessPhase": "염색 작업(수동)",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-T31-009",
      "text": "사용 완료한 시약(크실렌, 헤마톡실린, 에오신 등)은 지정된 폐액통에 회수한 후 적합한 방법으로 폐기하도록 한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침",
      "additionalDetail": "수동 염색 후 폐시약 처리",
      "workProcessPhase": "염색 작업(수동)",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.6",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-T31-010",
      "text": "에탄올, 크실렌 및 크실렌 대체제는 인화성 및 유독성 물질이므로 사용 시에는 전용 보호구(보안경, 방독마스크, 안전장갑 등) 또는 배기장치가 설치된 장소에서 사용하며, 전용 보관함에 보관한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침",
      "additionalDetail": null,
      "workProcessPhase": "염색 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-T31-011",
      "text": "에탄올 및 크실렌, 크실렌 대체제 등이 눈이나 피부에 묻었을 경우에는 속히 다량의 물 또는 생리식염수로 충분히 세정한다.",
      "guideContext": "시험동물 조직의 박절 및 염색 지침",
      "additionalDetail": null,
      "workProcessPhase": "염색 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-T31-001",
      "term": "박절(Cutting)",
      "definition": "조직 내부의 구조를 현미경으로 관찰할 수 있도록 일정한 두께로 얇게 자르는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T31-002",
      "term": "염색(Staining)",
      "definition": "세포 등에 특수한 염료를 이용하여 색상을 입혀 현미경 관찰을 용이하도록 하는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T31-003",
      "term": "함수(Rehydration)",
      "definition": "조직 내 손실된 수분을 보충하는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T31-004",
      "term": "분별(Differentiation)",
      "definition": "비특이적 배경 염색을 제거하고 대비를 향상시키는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T31-005",
      "term": "봉입(Mounting)",
      "definition": "염색이 완료된 조직이 손상되지 않도록 특수한 시약으로 처리하는 과정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T31-006",
      "term": "크실렌 대체제(Xylene substitute)",
      "definition": "크실렌을 대체하여 사용할 수 있는 제품으로서, 이용 시 병리조직학적 검사용 염색 시약으로 시판되는 제품(예: Histoclear Ⅱ, S3 Histo 등) 중 염색기에서 사용 가능한 제품으로 선택한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
