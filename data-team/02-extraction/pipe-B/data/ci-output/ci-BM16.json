  "domainTerms": [
    {
      "identifier": "DT-BM16-001",
      "term": "기계식 주차장",
      "definition": "기계식 주차장치를 사용하는 모든 노외주차장(자동차의 주차를 위해 사용하는 부분의 면적이 500 m² 이상인 것에 한정한다)을 말하며 일반적으로 차로, 전면 공터, 관리실 등도 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM16-002",
      "term": "기계식 주차설비",
      "definition": "기계식주차장치와 그 장치를 안전하게 이용할 수 있도록 설치한 방향전환장치 등 부대설비를 포함하는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM16-003",
      "term": "기계식 주차장치",
      "definition": "주차장에 설치하는 주차장치(특수장치 포함)로서 자동차를 주차하거나 주차 위치까지 운반하기 위해 사용하는 모든 기계장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM16-004",
      "term": "운반기",
      "definition": "기계식 주차장치에서 자동차를 주차하거나 주차 위치까지 운반하기 위해 자동차를 탑재하는 기기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM16-005",
      "term": "주차구획",
      "definition": "기계식주차장 또는 기계식주차장치에서 자동차를 수용하는 장소(위치)를 말하며, 주차실로도 불리는 말이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM16-006",
      "term": "중형기계식주차장",
      "definition": "길이 5.05 m 이하, 너비 1.85 m 이하, 높이 1.55 m 이하, 무게 1,600 kg 이하인 자동차를 주차할 수 있는 기계식주차장을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM16-007",
      "term": "대형기계식주차장",
      "definition": "길이 5.75 m 이하, 너비 2.05 m 이하, 높이 1.55 m 이하, 무게 2,200 kg 이하인 자동차를 주차할 수 있는 기계식주차장을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
