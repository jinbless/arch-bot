  "checklistItems": [
    {
      "identifier": "CI-EG7-001",
      "text": "사업주는 소각재등 취급작업, 보수·점검작업 및 해체작업(이하 \"소각시설작업\"이라 한다) 중 허가 또는 관리대상유해물질을 취급하게 될 경우 법 제29조(근로자에 대한 안전보건교육)제3항의 규정에 따라 근로자에게 특별안전·보건교육을 실시한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CONFINED-023"
      ]
    },
    {
      "identifier": "CI-EG7-002",
      "text": "사업주는 소각시설작업을 행하는 경우 법 제16조(관리감독자)의 규정에 따라 화학물질에 대한 지식을 가진 자를 소각시설작업에 대한 관리감독자로 지정하고 관련 작업을 지휘하도록 한다.",
      "guideContext": "폐기물 소각시설 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-003",
      "text": "관리감독자는 작업에 종사하는 근로자의 보호구 착용상태를 점검하고 유해물질의 발산을 억제하기위하여 시행된 습윤화를 확인하는 등 필요한 조치를 강구한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-EG7-004",
      "text": "사업주는 소각시설작업에 근로자를 종사하도록 하는 경우(단, 보수·점검작업은 제외한다) 유해물질을 함유한 분진 등이 비산하지 않도록 발산원을 습윤화 한다. 다만 습윤화 하는 것이 현지히 곤란한 경우에는 예외로 한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "소각재등 취급작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-DUST-003"
      ]
    },
    {
      "identifier": "CI-EG7-005",
      "text": "사업주는 법 제130조(특수건강진단 등)에 따라 소각시설작업에 종사하는 근로자에 대하여 작업 중 특수건강검진 대상 유해인자에 노출될 경우 특수건강진단을 받도록 한다.",
      "guideContext": "폐기물 소각시설 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-006",
      "text": "다이옥신류의 노출에 따른 건강상의 불안을 호소하는 근로자에 대하여는 산업의학전문가의 의견을 바탕으로 필요에 따라 건강진단 등 적절한 조치를 강구한다.",
      "guideContext": "폐기물 소각시설 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-007",
      "text": "사업주는 소각시설작업 중, 사고 또는 보호구의 파손 등에 의해 근로자가 유해물질에 심각하게 오염되었거나 이를 다량으로 흡입했을 우려가 있는 경우에는 해당 근로자가 신속하게 의학적 진단 및 조치를 받도록 한다.",
      "guideContext": "폐기물 소각시설 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "비상 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-008",
      "text": "사업주는 소각시설작업에 여성을 종사하도록 하는 경우에는 모성보호 차원에서 작업강도 및 작업내용을 배려하도록 하고 해당 근로자의 건강관리에 특별히 유의한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-009",
      "text": "사업주는 소각시설작업에 근로자를 종사하도록 하는 경우에는 호흡용보호구 등 필요한 보호구를 지급하고 다음의 조치를 강구한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-EG7-010",
      "text": "보호구의 착용 상황에 대한 관리",
      "guideContext": "폐기물 소각시설 보호구 관리 (법령 근거 미확인)",
      "additionalDetail": "소각시설작업 시 보호구 조치사항의 일환",
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-011",
      "text": "작업 후 보호구의 분리 등",
      "guideContext": "폐기물 소각시설 보호구 관리 (법령 근거 미확인)",
      "additionalDetail": "소각시설작업 시 보호구 조치사항의 일환",
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-012",
      "text": "보호구에 대하여는 오염의 정도 확인 등 일상적인 보수와 점검을 실시한다.",
      "guideContext": "폐기물 소각시설 보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-013",
      "text": "유해물질에 오염되었을 우려가 있는 보호구는 일회용과 보호구와 제조회사가 별도의 방법을 정한 여과재와 정화통을 제외하고는 깨끗한 온수, 중성 세제 및 헥산으로 세정한다.",
      "guideContext": "폐기물 소각시설 보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-EG7-014",
      "text": "유해물질에 표면이 오염된 지구와 공구 등의 기자재는 일회용을 제외하고는 깨끗한 온수 및 중성세제로 세정한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-EG7-015",
      "text": "헥산 등으로 보호구를 세정하는 경우에는 용해된 다이옥신류에 노출되지 않도록 주의한다.",
      "guideContext": "폐기물 소각시설 보호구 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-016",
      "text": "송기마스크를 사용하는 경우에는 유해물질, 오일 미스트 및 분진 등을 함유하지 않은 깨끗한 공기를 공급한다",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-EG7-017",
      "text": "사업주는 소각시설작업의 내용과 발생오염원의 특성에 따라 적합한 보호구를 선택하여 근로자가 착용할 수 있도록 한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-EG7-018",
      "text": "고소작업에서 송기호스가 작업에 방해를 주는 경우 또는 송기호스를 해당 장소까지 연장시키기 어려운 경우에는 해당 작업 장소 부근에 충분한 성능을 가진 송기라인 접속장소를 설치한다.",
      "guideContext": "폐기물 소각시설 고소작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "고소작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-019",
      "text": "송기라인 접속장소를 설치하기 어려운 경우에는 호흡용보호구를 사용하도록 하고 추락방지를 위해 안전한 작업발관을 설치한다. 단, 안전한 작업발관 설치가 어려운 경우에는 안전대를 사용하는 등 추락방지 조치를 강구한다.",
      "guideContext": "폐기물 소각시설 고소작업",
      "additionalDetail": null,
      "workProcessPhase": "고소작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FALL-001",
        "SR-FALL-003",
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-EG7-020",
      "text": "작업 개시 전에 바닥 면을 청소한다.",
      "guideContext": "폐기물 소각시설 임시작업",
      "additionalDetail": "고농도 유해물질 환경에서 송기마스크 사용이 곤란한 임시작업 시 방진/방독겸용 호흡용 보호구 사용 전 조치",
      "workProcessPhase": "임시작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-EG7-021",
      "text": "작업을 실시하는 동안 분진 및 가스형태의 다이옥신류가 발산될 우려가 있는 경우에는 작업을 중단한다.",
      "guideContext": "폐기물 소각시설 임시작업 (법령 근거 미확인)",
      "additionalDetail": "방진/방독겸용 호흡용 보호구 사용 임시작업 시 안전 조치",
      "workProcessPhase": "임시작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-022",
      "text": "사업주는 근로자의 작업복에 부착된 소각재 등에 의해 휴게실이 오염되지 않도록 청결을 유지하고 관리한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 후 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-EG7-023",
      "text": "사업주는 작업이 이루어지는 작업장 내에서 근로자가 흡연이나 음식물의 섭취하지 않도록 한다",
      "guideContext": "폐기물 소각시설 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-024",
      "text": "사업주는 소각재등 취급작업 및 보수·점검작업 시 측정 대상 유해인자에 근로자가 노출될 경우 법 제125조에 따른 작업환경측정을 실시한다",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 중 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-EG7-025",
      "text": "소각재등 취급작업 및 보수·점검작업 참여하는 근로자, 위탁사업주, 위탁사업주의 근로자에게 해당 작업에 참여함으로써 발생할 수 있는 노출 수준, 성격 등의 정보를 알려야 한다. 현장 근로가 아닌 외부 환경에서 근로하는 근로자는 해당 조치에서 제외한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "사전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-EG7-026",
      "text": "사업주가 소각재등 취급작업 및 보수·점검작업을 타 사업주에게 위탁하는 경우 사업주는 위탁사업주의 근로자가 유해물질에 노출되는 것을 방지하기 위하여 협의체를 구성하고 주기적으로 업무를 협의한 후 실시한다. 이 경우 업무를 위탁한 사업주가 2개소 이상인 경우 모든 사업주를 협의체에 포함시켜야 한다.",
      "guideContext": "폐기물 소각시설 작업관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-027",
      "text": "소각재등 취급작업 및 보수·점검작업 업무를 위탁받은 사업주는 사업주가 구성한 협의체에 가입하고 소각시설 작업에 종사하는 모든 근로자가 유해물질에 노출되는 것을 방지하기 위하여 공동으로 노력한다.",
      "guideContext": "폐기물 소각시설 작업관리",
      "additionalDetail": null,
      "workProcessPhase": "사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-028",
      "text": "사업주는 해체작업을 실시하는 경우, 해체대상 시설의 도면을 사전에 해체작업 실시 사업주(이하 \"해체사업주\"라 한다)에게 제공한다.",
      "guideContext": "폐기물 소각시설 해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "해체작업 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-029",
      "text": "사업주는 해체작업을 실시하는 경우, 해체작업 근로자가 유해물질에 노출되는 것을 방지하기 위하여 해체사업주와 협의체를 구성한다. 이 경우 2개소 이상의 사업주가 해체작업에 참여하는 경우 또는 재하청의 형태로 해체작업이 진행되는 경우 모든 사업주가 협의체에 가입하도록 한다.",
      "guideContext": "폐기물 소각시설 해체작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "해체작업 사전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-030",
      "text": "사업주는 해체사업주로 하여금 해체작업을 실시하기 전에 설비 내부에 부착된 유해물질이나 비산이 쉬운 분진 등의 유해물질을 충분히 제거하도록 한다.",
      "guideContext": "폐기물 소각시설 해체작업",
      "additionalDetail": null,
      "workProcessPhase": "해체작업 전 부착물 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-EG7-031",
      "text": "가설구조물(벽 등) 또는 비닐시트를 이용하여 작업장소를 다른 작업장소와 격리한다.",
      "guideContext": "폐기물 소각시설 해체작업 부착물 제거",
      "additionalDetail": null,
      "workProcessPhase": "해체작업 전 부착물 제거",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-003"
      ]
    },
    {
      "identifier": "CI-EG7-032",
      "text": "휘발물질이나 비산 또는 퇴적 분진이 많은 경우에는 가능한 한 원격조작을 통해 작업을 실시한다.",
      "guideContext": "폐기물 소각시설 해체작업 부착물 제거",
      "additionalDetail": null,
      "workProcessPhase": "해체작업 전 부착물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-033",
      "text": "연도(燃突) 등 협소한 장소에서는 고입수 세정 등의 방법을 통해 부착물을 제거하는 등 적절한 조치를 강구한다.",
      "guideContext": "폐기물 소각시설 해체작업 부착물 제거 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "해체작업 전 부착물 제거",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-034",
      "text": "사업주는 소각로 해체 작업 시 유해물질에 의한 오염 및 확산을 방지하기 위하여 해체사업주로 하여금 구역별로 가설벽체 등을 이용한 분리 혹은 비닐시트를 이용하여 덮는 방법 등 분진의 비산을 최소화하도록 한다.",
      "guideContext": "폐기물 소각시설 해체작업",
      "additionalDetail": null,
      "workProcessPhase": "해체작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-EG7-035",
      "text": "해체 작업 시 샤워 시설 및 탈의실을 제공하여야 하며 해당 작업을 도급을 준 경우 관계수급인이 샤워 및 탈의실을 사용할 수 있도록 하여야 한다.",
      "guideContext": "폐기물 소각시설 해체작업",
      "additionalDetail": null,
      "workProcessPhase": "해체작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-EG7-036",
      "text": "발생되는 배기가스 및 비산분진 등은 흡착제, 집진기 또는 세정설비를 사용하여 충분히 정화 후 배출한다.",
      "guideContext": "폐기물 소각시설 해체작업 주변 환경 대응",
      "additionalDetail": null,
      "workProcessPhase": "해체 후 환경처리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-EG7-037",
      "text": "해체작업에 의해 발생된 오염 폐수는 응집침전법 등의 처리설비를 사용하여 고형물질을 분리 처리한 후 배수한다.",
      "guideContext": "폐기물 소각시설 해체작업 주변 환경 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "해체 후 환경처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-038",
      "text": "유해물질에 오염된 폐기물은 비산을 방지하기 위하여 밀폐용기를 사용하여 분리하고 폐기물관리법에 따라 처리하기 전까지 작업에 방해가 되지 않는 장소에 보관한다",
      "guideContext": "폐기물 소각시설 해체작업 주변 환경 대응",
      "additionalDetail": null,
      "workProcessPhase": "해체 후 환경처리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-019"
      ]
    },
    {
      "identifier": "CI-EG7-039",
      "text": "소각재와 부착물 등의 유해물질에 오염된 해체 폐기물에 대해서는 폐기물 처리법에 따라 폐기물의 종류에 맞게 분류하여 배출·처분한다.",
      "guideContext": "폐기물 소각시설 해체작업 주변 환경 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "해체 후 환경처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-EG7-040",
      "text": "유해물질을 제거하였거나 유해물질이 없는 해체 폐기물의 경우에는 폐기물관리법에 따라 폐기물의 종류에 맞게 분류하여 배출·처분한다.",
      "guideContext": "폐기물 소각시설 해체작업 주변 환경 대응 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "해체 후 환경처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3",
      "basedOn": null
    }
  ],
