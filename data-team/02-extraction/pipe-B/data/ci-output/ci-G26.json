  "checklistItems": [
    {
      "identifier": "CI-G26-001",
      "text": "<부록>에 예시한 \"1. 조도기준\"을 참조하여 작업공간의 밝고 어두운 정도를 판단한다.",
      "guideContext": "사업장의 조명 (법령 근거 미확인)",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제8조의 조도기준과 KS A 3011 조도기준을 참조",
      "workProcessPhase": "조명 진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-002",
      "text": "전등과 조명기기를 청소한다.",
      "guideContext": "작업공간이 어두운 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": "조명 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-003",
      "text": "수명이 다 된 조명기구를 교체한다.",
      "guideContext": "작업공간이 어두운 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": "조명 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-004",
      "text": "실내마감재의 색상을 밝게 해 반사율을 높인다.",
      "guideContext": "작업공간이 어두운 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-005",
      "text": "광원을 가리는 장애물을 제거한다.",
      "guideContext": "작업공간이 어두운 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-006",
      "text": "조명간의 거리를 가깝게 하거나 추가로 설치한다.",
      "guideContext": "작업공간이 어두운 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-007",
      "text": "광원이 직접 보이는 경우에는 빛을 분산시키는 조명기기로 교체하거나 광원이 직접 보이지 않는 곳으로 이동한다.",
      "guideContext": "눈부심이 발생하는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-008",
      "text": "일자형 형광등과 같은 선형 광원이 사용된 경우에는 전극이 있는 면이 보이도록 회전한다.",
      "guideContext": "눈부심이 발생하는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-009",
      "text": "창문에 가리개를 설치한다.",
      "guideContext": "밝은 자연채광에 의한 눈부심 해결책",
      "additionalDetail": "천장은 백색도료를 칠해 빛을 차단한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-010",
      "text": "창문이나 천장 주변의 벽이나 천장 표면이 높은 반사율을 갖도록 한다.",
      "guideContext": "밝은 자연채광에 의한 눈부심 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-011",
      "text": "창문이나 천장을 바라보지 않도록 가구배치를 바꾼다.",
      "guideContext": "밝은 자연채광에 의한 눈부심 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-012",
      "text": "작업대의 표면을 반사율이 낮은 재료로 교체한다.",
      "guideContext": "작업면에 반사광이 생기는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-013",
      "text": "자연광에 가까운 광원을 사용하며 적절한 조도를 유지한다.",
      "guideContext": "색효과(Color effect)가 발생하는 경우 해결책",
      "additionalDetail": "저압 나트륨 조명 등 단색광 아래에서 색 구분 불가능하며 위험 간과 가능",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-014",
      "text": "수명이 다 된 광원을 교체한다.",
      "guideContext": "깜빡거림(Flickering)이 발생하는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": "조명 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-015",
      "text": "전원공급에 문제점이 있는지 점검한다.",
      "guideContext": "깜빡거림(Flickering)이 발생하는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": "조명 진단",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-016",
      "text": "고주파 조절장치를 사용한다.",
      "guideContext": "깜빡거림(Flickering)이 발생하는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-017",
      "text": "전원공급방식이 다른 광원을 추가로 설치한다.",
      "guideContext": "깜빡거림(Flickering)이 발생하는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-018",
      "text": "밝기가 균일하게 되도록 광원을 교체하거나 그 간격을 조정한다.",
      "guideContext": "작업부위에 강하게 음영이 생기는 경우 해결책",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-G26-019",
      "text": "작업공간에서 어두운 부위의 조도를 개선한다.",
      "guideContext": "작업공간에서 밝기의 차가 클 경우 해결책 (법령 근거 미확인)",
      "additionalDetail": "작업공간과 그 주변의 밝기의 차가 클 경우 시각적 불쾌감 유발 및 빠른 이동 시 안전상의 위험 초래 가능",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.7",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-G26-001",
      "term": "조도(Intensity of illumination)",
      "definition": "빛이 비춰지는 단위면적의 밝기에 대한 척도로, 1룩스(lux)란 1 m²의 단위면적에 1 루멘(lm)의 광속이 평균적으로 조사되고 있을 때의 조도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G26-002",
      "term": "광도(Luminous intensity)",
      "definition": "광원의 밝기를 나타내는 양이다. 단위를 칸델라(cd)를 사용하는데 광원으로부터 임의의 방향으로 방사되는 단위 입체각 당 광밀도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G26-003",
      "term": "눈부심(Glare)",
      "definition": "시야 내(視野內)의 어떤 광도(光度)로 인하여 불쾌감, 고통, 눈의 피로 또는 시력의 일시적인 감퇴를 초래하는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G26-004",
      "term": "전반조명(General lighting)",
      "definition": "실 내부 전체를 고르게 밝혀 주는 조명을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G26-005",
      "term": "국부조명(Local lighting)",
      "definition": "보통 전반조명과 더불어 사용되며 실제 작업영역에 근접한 조명을 말한다. 국부조명은 좁은 영역에 높은 조도가 필요할 때, 개별적으로 조절 가능한 조명이 필요할 때, 작업공간의 특성으로 전반조명이 불필요하거나 불가능할 때 사용된다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
