  "domainTerms": [
    {
      "identifier": "DT-D24-001",
      "term": "근원적 (Inherent) 방법",
      "definition": "위험하지 않은 화학물질 또는 공정 조건을 사용하여 위험요인(Hazard)를 없애는 방법을 말하며 테레프탈산(TPA)제조공정에서 용제를 물로 바꾸는 것 또는 알킬벤젠 제조공정에서 촉매를 불화수소에서 지글러 촉매로 교체하는 것 등을 예로 들 수 있다.",
      "sourceSection": "2",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-002",
      "term": "수동적 (Passive) 방법",
      "definition": "위험성을 제거하지 않고 사고의 빈도나 사고의 크기를 줄이기 위하여 공정 또는 설비의 설계 특성을 이용하여 위험성을 없애거나 최소화하는 방법을 말하며 설비의 설계압력을 높이는 방법 등을 예로 들 수 있다.",
      "sourceSection": "2",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-003",
      "term": "능동적 (Active) 방법",
      "definition": "제어장치, 안전을 위한 인터록 설비, 비상정지시스템 등을 사용하여 위험성이 있는 공정의 이탈을 감지하고 이에 대한 적절한 조치를 할 수 있도록 하는 방법을 말한다.",
      "sourceSection": "2",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-004",
      "term": "절차적(Procedural) 방법",
      "definition": "사고를 예방하고 사고의 결과를 최소화하기 위하여 안전운전절차, 비상조치계획 기타 관리 절차를 이용하는 방법을 말한다.",
      "sourceSection": "2",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-005",
      "term": "효율화(Intensification)",
      "definition": "유해·위험성이 있는 물질의 양을 줄임.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-006",
      "term": "대체(Substitution)",
      "definition": "유해·위험성이 적은 물질로 바꿈.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-007",
      "term": "완화(Attenuation)",
      "definition": "취급조건 또는 형태를 유해·위험성이 적은 조건 또는 형태로 변경함.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-008",
      "term": "영향의 제한(Limitation of effects)",
      "definition": "유해·위험한 물질 또는 에너지의 누출에 의한 결과가 최소화 되도록 설비를 설계함.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-D24-009",
      "term": "단순화(Simplification)",
      "definition": "운전상의 실수 또는 오류가 최소화 될 수 있도록 설비를 설계함.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
