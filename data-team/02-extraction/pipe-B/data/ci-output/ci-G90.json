  "checklistItems": [
    {
      "identifier": "CI-G90-001",
      "text": "사업주는 운반구 작업자에게 작업 전에 운반구 작업의 특성과 위험요인, 안전작업 방법 등에 대한 안전교육을 실시하여야 한다.",
      "guideContext": "운반구 작업 안전교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-002",
      "text": "사업주는 정해진 운반구 작업 구역을 근로자들이 볼 수 있도록 게시하여야 한다.",
      "guideContext": "운반구 작업 구역 게시 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-003",
      "text": "사업주는 작업장 내의 운반구 작업 구역이 식별이 용이하도록 표시하여야 하고 또한 운반구가 통과하기에 충분한 여유 공간과 평탄한 통로가 확보되어야 한다.",
      "guideContext": "운반구 이동통로 확보 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-004",
      "text": "사업주는 운반구의 미끄럼 방지와 정지 시 고정을 위하여 운반구의 바퀴에 고정 장치를 설치하여야 한다.",
      "guideContext": "운반구 바퀴 고정 장치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-005",
      "text": "사업주는 운반구 안전 작업 체크리스트를 이용하여 운반구 이용 작업과 관련된 위험요인을 주기적으로 확인하고, 당해 작업 관련 재해예방 대책을 수립하여 추진해야 한다.",
      "guideContext": "운반구 위험요인 점검 (법령 근거 미확인)",
      "additionalDetail": "부록의 체크리스트 참조",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-006",
      "text": "운반구 작업에 적절한 자재나 물품을 미리 정하여 작업계획에 반영하여야 한다.",
      "guideContext": "운반구 작업계획 수립 (법령 근거 미확인)",
      "additionalDetail": "지게차 사용이 비효율적이고 직접 운반하기에는 양·부피·무게가 큰 물품 대상",
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-007",
      "text": "사용한 운반구는 항상 일정한 장소에 보관되도록 하고 유지보수를 철저히 하여야 한다.",
      "guideContext": "운반구 보관 및 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 후 정리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-008",
      "text": "운반구를 운반할 때에는 작업자의 가슴 높이 이상의 자재를 적재하여 운반하여서는 안 된다.",
      "guideContext": "운반구 적재 높이 제한 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자재 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-009",
      "text": "운반구의 바퀴에 고정 장치가 설치되지 않은 운반구를 이용하여 자재, 물품 등을 상·하차시킬 때는 2인1조로 작업을 실시하며, 운반구를 고정시킨 상태에서 한 근로자는 운반구를 지지하고 다른 근로자가 상·하차 작업을 수행하도록 한다.",
      "guideContext": "운반구 상·하차 안전",
      "additionalDetail": null,
      "workProcessPhase": "자재 상·하차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-010",
      "text": "운반구를 이용하여 자재를 운반하는 근로자는 주의가 흐트러질 수 있는 다른 행위를 삼가고, 표시된 이동통로를 통해서만 이동해야 한다.",
      "guideContext": "운반구 이동 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운반구 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-011",
      "text": "운반구에 사람이 올라가지 않도록 한다.",
      "guideContext": "운반구 이용 금지사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-012",
      "text": "작업 중 음주 혹은 작업에 지장을 주는 약물을 복용하지 않도록 한다.",
      "guideContext": "운반구 이용 금지사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-013",
      "text": "고령자는 운반구 이용 작업을 실시하지 않도록 한다.",
      "guideContext": "운반구 이용 제한사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-014",
      "text": "위험물이나 부적절한 화물을 적재하거나 이동하지 않도록 한다.",
      "guideContext": "운반구 이용 금지사항",
      "additionalDetail": null,
      "workProcessPhase": "자재 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-015",
      "text": "물품이나 자재의 적재 시 반드시 중앙부를 중심으로 적재하도록 하며, 운반구의 적재 바닥면의 공간을 넘어서는 큰 자재나 물품은 싣지 않도록 한다.",
      "guideContext": "넘어짐/깔림 예방",
      "additionalDetail": null,
      "workProcessPhase": "자재 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-016",
      "text": "여러 자재 및 물품을 높이 쌓아서 적재하여 운반할 경우 불균형을 초래할 수 있으므로 과도하게 물품을 높이 쌓지 말고 안정되게 적재하여야 한다.",
      "guideContext": "넘어짐/깔림 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "자재 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-017",
      "text": "비포장 통로나 바닥면이 울퉁불퉁한 타일 등으로 이루어진 통로는 넘어짐 위험이 있으므로 작업자를 추가하여 작업하도록 하여야 한다.",
      "guideContext": "넘어짐/깔림 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운반구 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-018",
      "text": "이동통로는 최대한 직선의 형태로 구성하도록 하며, 직선 이동이 곤란한 작업장에서는 회전각을 크게 하여 여유 있게 회전할 수 있도록 한다.",
      "guideContext": "넘어짐/깔림 예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-019",
      "text": "문턱 등의 장애물이 있을 경우, 경사판을 설치하여 안전하게 이동할 수 있도록 한다.",
      "guideContext": "넘어짐/깔림 예방",
      "additionalDetail": null,
      "workProcessPhase": "운반구 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-020",
      "text": "물품이나 자재를 적재하고 운반할 때, 운반구의 차체 및 자재의 최대 높이가 근로자의 가슴 높이를 넘어서지 않도록 한다.",
      "guideContext": "부딪힘 예방",
      "additionalDetail": null,
      "workProcessPhase": "자재 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-021",
      "text": "운반구의 이동통로는 다른 근로자들이 식별이 용이하도록 구간 표시를 하여야 하며, 운전자는 정해진 통로 및 동선을 따라 이동하도록 한다.",
      "guideContext": "부딪힘 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운반구 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-022",
      "text": "운반구 이동통로는 차체 및 자재가 통과하기에 충분히 여유가 있도록 구성하며, 이동통로 내에 불필요한 물품 등을 적재하지 말아야 한다.",
      "guideContext": "부딪힘 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-023",
      "text": "운반구의 조작과 이동은 본 기기의 조작에 대해 경험이 많고 필요한 교육을 이수한 근로자가 주도적으로 하여야 한다.",
      "guideContext": "부딪힘 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "운반구 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-024",
      "text": "과도한 양의 물품 적재를 삼가고, 양쪽 면에 칸막이가 설치된 운반구에는 탈부착이 가능한 보조끈을 부착하여 이동 시 적재물이 이탈되지 않도록 한다.",
      "guideContext": "넘어짐 및 맞음 예방",
      "additionalDetail": null,
      "workProcessPhase": "자재 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-025",
      "text": "운반구의 미끄럼 방지와 정지 시 고정을 위하여 운반구의 바퀴에 고정 장치를 설치한다.",
      "guideContext": "넘어짐 및 맞음 예방",
      "additionalDetail": null,
      "workProcessPhase": "자재 상·하차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-026",
      "text": "조리작업장 내에서 운반구의 청소 및 소독 책임자를 지정하고, 작업 전과 후에 청소 및 위생관리를 실시하도록 한다.",
      "guideContext": "조리작업장 위생관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 후 정리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-027",
      "text": "조리작업장에서 운반구를 이동 용도가 아닌 식자재의 보관 용도로 사용하지 않도록 한다. 부득이 식자재의 보관 용도로 사용할 때는 보호덮개를 설치하고 냉장 보관하는 등의 조치를 취하여야 한다.",
      "guideContext": "조리작업장 위생관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-028",
      "text": "운반구에 최대 적재 중량이 표기되어 있으며, 이를 준수하였는가?",
      "guideContext": "운반구 작업자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "자재 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-029",
      "text": "좌·우 구동 및 회전을 위한 바퀴의 움직임은 양호한가?",
      "guideContext": "운반구 작업자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-030",
      "text": "넘어짐이나 자재에 맞는 사고를 예방할 수 있는 보조끈이나 기타 보조장치의 결합은 바르게 이루어져 있는가?",
      "guideContext": "운반구 작업자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-031",
      "text": "운반구 사용 위험 요인에 대한 평가를 정기적으로 실시하고 있는가?",
      "guideContext": "운반구 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "부록1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-032",
      "text": "운반과 관련하여 교육을 받은 작업자만이 운반구를 이용하고 있는가?",
      "guideContext": "운반구 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "부록1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-033",
      "text": "운반구 사용 시 발생한 사고에 대해 파악 및 기록하고 있는가?",
      "guideContext": "운반구 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "부록1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-034",
      "text": "운반구이용 시 가능한 근로자의 신체 쪽으로 기구를 당겨서 이동하기보다 밀어서 이동하는 방법을 사용하고 있는가?",
      "guideContext": "운반구 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "운반구 이동",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "부록1",
      "basedOn": null
    },
    {
      "identifier": "CI-G90-035",
      "text": "1인의 근로자가 한 번에 1개의 운반구를 운반하는가?",
      "guideContext": "운반구 관리자 체크리스트",
      "additionalDetail": null,
