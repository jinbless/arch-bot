  "domainTerms": [
    {
      "identifier": "DT-G90-001",
      "term": "운반구",
      "definition": "작업장 내에서 물품, 도구, 자재 등의 운반을 목적으로 이용하는 무동력 운반기구의 일종이다. 구조는 받침대 하부에 방향전환이 가능한 4개의 바퀴가 부착되어 있고 상부에 철망 형태의 사각 프레임(이하 \"프레임\"이라 한다)으로 둘러싸여 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G90-002",
      "term": "견인끈",
      "definition": "운반구에 탈착할 수 있도록 만들어진 직물이나 가죽 재질의 끈이다. 이는 운반구를 당겨서 구동시킬 때, 운반구의 프레임에 부착하여 보다 쉽고 안정적으로 운반구를 끌어서 움직일 수 있도록 도와주는 도구이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G90-003",
      "term": "보조끈",
      "definition": "칸막이 착탈식 운반구에서 이동 시 적재물이 이탈되지 않도록 운반구 양쪽 면에 설치하는 탈부착이 가능한 끈을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-G90-01",
      "processOrder": 1,
      "processName": "작업 전 준비 및 안전교육",
      "safetyMeasures": "운반구 작업 특성과 위험요인, 안전작업 방법에 대한 안전교육 실시. 운반구 작업 구역 게시 및 이동통로 표시. 이동통로를 직선 형태로 구성하고 충분한 여유 공간 확보.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-G90-02",
      "processOrder": 2,
      "processName": "운반구 작업 전 점검",
      "safetyMeasures": "바퀴의 좌·우 구동 및 회전 움직임 확인. 바퀴 고정 장치 작동 확인. 보조끈 및 보조장치 결합 상태 확인. 최대 적재 중량 표기 확인.",
      "requiredPPE": [],
      "sourceSection": "부록1",
      "relatedSR": null
    },
    {
      "identifier": "WP-G90-03",
      "processOrder": 3,
      "processName": "자재 적재",
      "safetyMeasures": "중앙부를 중심으로 균형 있게 적재. 적재 높이는 작업자 가슴 높이 이하. 적재 바닥면을 넘는 큰 자재는 적재 금지. 과도한 양의 물품 적재 금지. 칸막이 운반구에는 보조끈 부착.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-G90-04",
      "processOrder": 4,
      "processName": "운반구 이동 및 운반",
      "safetyMeasures": "표시된 이동통로를 통해서만 이동. 주의를 흐트러뜨리는 다른 행위 금지. 1인 1대 운반 원칙. 울퉁불퉁한 통로에서는 작업자 추가. 문턱 등 장애물 시 경사판 설치. 급커브 구간에서는 여유 있게 회전.",
      "requiredPPE": [],
      "sourceSection": "7.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-G90-05",
      "processOrder": 5,
      "processName": "자재 상·하차",
      "safetyMeasures": "바퀴 고정 장치가 없는 운반구는 2인1조로 작업. 한 근로자가 운반구를 지지하고 다른 근로자가 상·하차 수행. 물품 상·하차 시 적절한 운반도구 사용.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-G90-06",
      "processOrder": 6,
      "processName": "운반구 보관 및 유지보수",
      "safetyMeasures": "사용 후 항상 일정한 장소에 보관. 유지보수 철저히 수행. 사용하지 않는 운반구는 결합하여 보관. 미사용 운반구 이동 시 1회 최대 3~5개 제한.",
