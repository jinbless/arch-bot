  "domainTerms": [
    {
      "identifier": "DT-G101-001",
      "term": "운송용 차량",
      "definition": "구내 운반차, 화물자동차, 지게차처럼 작업장에서 운반을 위해 사용되는 차량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G101-002",
      "term": "트레일러(Trailer)",
      "definition": "트레일러용 트랙터에 연결하는 운송차량을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G101-003",
      "term": "캣워크(Catwalk)",
      "definition": "작업자가 걸어다닐 수 있는 차량 좌우 측면에 설치된 좁은 통로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G101-004",
      "term": "운전석 발판(Cap step)",
      "definition": "운전석에서 오르내릴 때 발을 딛는 디딤대를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G101-005",
      "term": "전향륜(Fifth wheel)",
      "definition": "트레일러 트럭의 트랙터 차축에 붙어서 트레일러의 방향 전환을 쉽게 하기 위한 수평 차륜을 말한다. 오륜이라고도 부른다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-G101-006",
      "term": "커플링 호스(Coupling hose)",
      "definition": "또 다른 호스와 연결하기 위해서 호스 끝에 부착하는 컨넥터를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
