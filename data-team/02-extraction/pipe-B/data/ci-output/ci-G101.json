  "checklistItems": [
    {
      "identifier": "CI-G101-001",
      "text": "가능한 한 차량에 승차하여 적재 및 하역 작업을 피할 수 있도록 작업계획을 짠다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-002",
      "text": "차량 구입 시 승·하차시의 안전설계가 고려된 차량을 구입한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-003",
      "text": "필요 시 차량에서의 떨어짐 방지책이 고려된 개선된 장치로 교체한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-004",
      "text": "미끄럼 방지용 안전화 등의 개인보호구를 지급한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-005",
      "text": "차량으로부터의 떨어짐 방지를 위한 다양한 방안을 강구한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-006",
      "text": "감독자로 하여금 작업자의 승·하차 방법을 점검하여 떨어짐에 관한 대책을 마련하도록 한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-007",
      "text": "적재 및 하역작업을 할 때는 차량이 움직이지 않도록 안전한 곳에 세우고 브레이크를 채워야 한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재 및 하역",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-008",
      "text": "차량 작업 시에는 발에 잘 맞는 미끄럼 방지용 안전화를 착용한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "차량 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-009",
      "text": "안전화 바닥에 붙은 이물질은 즉시 제거하여 미끄러짐을 방지한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "차량 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-010",
      "text": "차량의 적재 및 하역 시 작업안전지침에 따른다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재 및 하역",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-011",
      "text": "차량에서의 안전작업을 위해 정기적인 안전교육훈련을 받아야 하며, 탱크로리 차량이나 테일 리프트차량(Tail-lift)와 크레인 탑재차량(Lorry loader crane) 등의 특수 차량에서의 작업은 사업주가 정한 안전작업지침에 따라야 한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-012",
      "text": "사다리 혹은 발판을 이용하여 적재칸의 화물을 하역할 때, 차량으로부터 미끄러지지 않도록 주의한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "적재 및 하역",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-013",
      "text": "작업자가 적재 및 하역 작업을 하는 과정을 검토",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-014",
      "text": "작업자가 차량의 각 부분에 접근할 필요성과 작업시간을 검토",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-015",
      "text": "작업자의 작업 숙련도 및 훈련 여부를 점검",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-016",
      "text": "차량 각 부분의 위험요소를 점검",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-017",
      "text": "작업자의 피로도를 점검",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-018",
      "text": "보호구를 점검",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-019",
      "text": "응급상황 시 대응절차의 적절성을 점검",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-020",
      "text": "작업 장소, 날씨 등 작업환경을 점검",
      "guideContext": "운송용 차량에서의 떨어짐에 대한 위험성 평가",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-021",
      "text": "하차 시 무릎에 손상을 줄뿐만 아니라 넘어질 수 있으므로 차량에서 뛰어 내리지 않도록 해야 한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "차량 승·하차",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-022",
      "text": "발판과 손잡이를 항상 잡도록 한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "차량 승·하차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-023",
      "text": "운전석에서 내려오기 전에 잠간의 여유를 가지고 차량과 접하고 있는 하역장이나 캣워크를 확인한 뒤 손잡이를 잡고 내려오는 것이 바람직하다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "차량 승·하차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-024",
      "text": "차량으로부터 하차 시 넘어짐을 야기할 수 있는 구덩이나 연석 등의 편평하지 않는 바닥이 있는지 확인한다.",
      "guideContext": "운송용 차량에서의 떨어짐 방지",
      "additionalDetail": null,
      "workProcessPhase": "차량 승·하차",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-025",
      "text": "송진 혹은 인조잔디 등 미끄럼 방지 바닥재를 사용하거나, 코팅제를 사용한다.",
      "guideContext": "운송용 차량 적재칸 바닥관리",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 바닥관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-026",
      "text": "바닥 표면을 거칠게 하는 마감재를 사용한다.",
      "guideContext": "운송용 차량 적재칸 바닥관리",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 바닥관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-027",
      "text": "떨어짐 위험구역을 색상으로 표시하거나 조명이 구별되게 한다.",
      "guideContext": "운송용 차량 적재칸 바닥관리",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 바닥관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-028",
      "text": "적재 및 하역 작업 시 운송차량이 움직이지 않도록 안전한 곳에 세우고 브레이크를 채운다.",
      "guideContext": "운송용 차량 안전관리 점검",
      "additionalDetail": null,
      "workProcessPhase": "차량 안전관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-029",
      "text": "발판이나 손잡이 등의 상태가 양호한지 사용 전 검사를 수행한다.",
      "guideContext": "운송용 차량 안전관리 점검",
      "additionalDetail": null,
      "workProcessPhase": "차량 안전관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-030",
      "text": "떨어짐을 야기할 수 있는 손상된 발판 등의 부속물들을 즉시 수리한다.",
      "guideContext": "운송용 차량 안전관리 점검",
      "additionalDetail": null,
      "workProcessPhase": "차량 안전관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-031",
      "text": "적재칸은 로프 혹은 포장 등이 바닥에 방치되어 있지 않도록 정리한다. 특히, 로프는 양 측면에 잘 보관되도록 하여 작업자의 발이 걸려 넘어지지 않도록 한다.",
      "guideContext": "운송용 차량 안전관리 점검",
      "additionalDetail": null,
      "workProcessPhase": "차량 안전관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-032",
      "text": "캣워크나 및 적재칸 바닥의 기름 혹은 진흙 등은 넘어짐을 유발할 수 있으므로 즉시 제거한다.",
      "guideContext": "운송용 차량 안전관리 점검",
      "additionalDetail": null,
      "workProcessPhase": "차량 안전관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-033",
      "text": "냉동 차량의 경우 바닥에 물이나 얼음이 있지 않도록 수시로 점검한다.",
      "guideContext": "운송용 차량 안전관리 점검",
      "additionalDetail": null,
      "workProcessPhase": "차량 안전관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-034",
      "text": "테일 리프트 바닥면과 승강대 바닥은 미끄럼 방지 표면처리가 되어 있어야 하며, 테일 리프트의 상승 시 떨어짐을 방지하기 위해 난간이 설치되어 있어야 한다.",
      "guideContext": "운송용 차량 테일 리프트 안전",
      "additionalDetail": "화물의 적재와 하역을 위해 차량 후면에 설치되는 테일 리프트는 비교적 낮은 높이 특히, 이동 중에 작업자의 떨어짐 재해가 빈번하게 일어난다.",
      "workProcessPhase": "테일 리프트 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(1)",
      "basedOn": [
        "SR-FALL-001",
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-035",
      "text": "화물이 떨어지지 않도록 모서리 보호대를 설치해야 한다.",
      "guideContext": "운송용 차량 테일 리프트 안전",
      "additionalDetail": null,
      "workProcessPhase": "테일 리프트 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(1)",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-036",
      "text": "적절하게 부착된 손잡이나 난간을 이용한다.",
      "guideContext": "운송용 차량 테일 리프트 안전",
      "additionalDetail": null,
      "workProcessPhase": "테일 리프트 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(1)",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-037",
      "text": "운송차량에 설치되어 있는 물품보관대와 배터리 보호대 덮개는 작업자가 발을 딛고 설 수가 있는데 이때 표면이 미끄러우면 떨어짐 사고를 유발할 수 있다. 따라서 이들 덮개는 미끄럼 방지 처리가 된 재료를 사용하여야 한다.",
      "guideContext": "운송용 차량 배터리 보호대 및 물품보관대 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-038",
      "text": "운전자가 이용하게 되는 운전석 발판의 표면은 미끄럼 방지가 되어 있어야 하고 특히, 젖어 있는 상태에서 운전자는 반드시 미끄럼 방지 안전화를 착용해야 한다.",
      "guideContext": "운송용 차량 운전석 발판 안전",
      "additionalDetail": null,
      "workProcessPhase": "차량 승·하차",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.4.(3)",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-039",
      "text": "냉동 탑차 적재칸의 바닥은 항상 얼음조각으로 미끄러울 수 있다. 따라서, 수시로 바닥을 점검하여 물기나 얼음 등을 제거한다. 적재칸에 제습기를 설치하는 것이 바람직하다.",
      "guideContext": "운송용 차량 냉동 탑차 안전",
      "additionalDetail": null,
      "workProcessPhase": "냉동 탑차 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4.(4)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-040",
      "text": "처음 발을 딛는 발판의 높이는 무릎에 무리가 가지 않으면서 구부릴 수 있는 높이여야 한다. 일반적으로 지상으로부터 400 mm가 적절하며, 700 mm가 넘지 않도록 한다.",
      "guideContext": "운송용 차량 냉동 탑차 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "냉동 탑차 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4.(4)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-041",
      "text": "미끄럼 방지를 위한 발판의 깊이는 200 mm 정도가 적합하다.",
      "guideContext": "운송용 차량 냉동 탑차 안전",
      "additionalDetail": null,
      "workProcessPhase": "냉동 탑차 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4.(4)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-042",
      "text": "발판의 높이와 깊이는 동일하게 하는 것이 가장 바람직하다.",
      "guideContext": "운송용 차량 냉동 탑차 안전",
      "additionalDetail": null,
      "workProcessPhase": "냉동 탑차 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4.(4)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-043",
      "text": "작업자가 발을 딛는 차량 표면은 일정 시간 사용하면 마모가 되어 미끄럼 방지 기능이 떨어지므로 정기적인 점검을 통해 교체하거나 수리를 하도록 한다.",
      "guideContext": "운송용 차량 표면 관리",
      "additionalDetail": null,
      "workProcessPhase": "차량 안전관리 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4.(5)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-044",
      "text": "난간은 강제 등의 단단한 재료로 고정되어 있어야 하고, 손으로 잡는 부분인 손잡이는 미끄럼 방지 재질로 되어 있어야 한다.",
      "guideContext": "운송용 차량 손잡이 및 난간 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(6)",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-045",
      "text": "손잡이나 난간은 승·하차 시 손에 꼭 맞게 쥘 수 있어야 한다. 손잡이와 난간은 사람들의 손 크기나 몸 크기에 관계없이 모두 쉽게 쥘 수 있게 만들어야 한다.",
      "guideContext": "운송용 차량 손잡이 및 난간 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(6)",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-046",
      "text": "전향륜 위의 발판 표면은 미끄럼을 방지하기 위해 체크 무늬 모양의 재질로 한다. 특히, 습기, 비, 기타 오염물질로 인해 넘어짐이 발생되지 않도록 한다.",
      "guideContext": "운송용 차량 전향륜 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(7)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-047",
      "text": "발판 특히, 연료탱크 위의 발판의 높이는 적절해야 한다.",
      "guideContext": "운송용 차량 전향륜 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4.(7)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-048",
      "text": "발판들의 간격은 일정해야 한다.",
      "guideContext": "운송용 차량 전향륜 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4.(7)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-049",
      "text": "발판의 재질은 휘어지지 않는 재질로 만들어야 한다.",
      "guideContext": "운송용 차량 전향륜 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.4.(7)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-050",
      "text": "난간은 작업자의 접근이 용이해야 한다.",
      "guideContext": "운송용 차량 전향륜 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(7)",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-051",
      "text": "연료가 발판 위로 떨어지지 않도록 한다.",
      "guideContext": "운송용 차량 전향륜 안전",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4.(7)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-052",
      "text": "접이식 발판은 차량에서 떨어지지 않도록 장착해야 한다.",
      "guideContext": "운송용 차량 적재칸 접근 안전 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(8)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-053",
      "text": "손잡이는 적절한 간격으로 작업자가 쉽게 잡을 수 있는 위치에 있어야 한다.",
      "guideContext": "운송용 차량 적재칸 접근 안전",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(8)",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-054",
      "text": "안전성 측면에서는 사다리 보다는 차량에 고정 장착된 발판이 더 낫다.",
      "guideContext": "운송용 차량 적재칸 접근 안전",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(8)",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-055",
      "text": "발판은 다른 장비 사용에 지장이 없도록 측면 혹은 후면의 적절한 곳에 위치시킨다.",
      "guideContext": "운송용 차량 적재칸 접근 안전",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(8)",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-056",
      "text": "적절한 손잡이와 가드레일을 사용하도록 한다.",
      "guideContext": "운송용 차량 적재칸 접근 안전",
      "additionalDetail": null,
      "workProcessPhase": "적재칸 접근",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(8)",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-057",
      "text": "작업자가 화물 위로 올라가서 적재 및 하역작업 시 화물의 넘어짐과 화물에 의한 근로자의 넘어짐 재해가 발생하지 않도록 가능한 방안을 강구한다.",
      "guideContext": "운송용 차량 적재칸 접근 안전",
      "additionalDetail": null,
      "workProcessPhase": "적재 및 하역",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4.(8)",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-058",
      "text": "물체의 떨어짐에 의한 상해를 방지할 수 있도록 신발 앞 부분이 선심(Safety toe cap)으로 덧대어 있어야 하고, 바닥이 미끄럼 방지 재질로 되어 있어야 한다. 특히, 미끄럼 방지 처리가 된 바닥면이 일정 마모상태가 되면 즉시 교체해야 한다.",
      "guideContext": "운송용 차량 안전화 선택 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전화 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-059",
      "text": "안전화는 작업자의 발에 맞게 조임줄로 묶은 뒤 착용한다.",
      "guideContext": "운송용 차량 안전화 착용",
      "additionalDetail": null,
      "workProcessPhase": "안전화 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-060",
      "text": "작업 종료 후에는 흙, 먼지, 기름 등 오염물질들을 제거하고 세척 후 건조한 곳에 보관한다.",
      "guideContext": "운송용 차량 안전화 보관",
      "additionalDetail": null,
      "workProcessPhase": "안전화 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.5",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-061",
      "text": "작업자가 차량 적재 공간에서 보내야만 하는 시간을 최소화 하도록 안전한 적재 및 하역 방법을 계획한다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-062",
      "text": "발판과 캣워크와 같은 차량부품의 차량부품상태에 대한 정기점검을 수행한다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-063",
      "text": "차량 위의 진입장비와 관련하여 보고된 결함계통을 운전자에게 알려 점검하게 한다. 확실하게 판명된 결함은 바로 수리한다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-064",
      "text": "작업이 이루어지는 장소나 차량 위에는 적절한 조명이 있어야 한다. 열악한 조명은 미끄럼과 넘어짐의 위험요소를 볼 수 없게 한다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-065",
      "text": "미끄러짐과 넘어짐을 방지하는데 도움이 되도록 차량의 화물칸과 캣워크는 깨끗하게 정리한다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-066",
      "text": "안전한 세차 시설을 마련하고 사용하게 한다. 디젤류, 윤활류(Grease), 흙 등은 캣워크 발판 혹은 화물칸에서 넘어짐의 가능성을 높일 수 있다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-067",
      "text": "적재 및 하역 혹은 정비와 세차 작업이 높은 곳에서 할 수 밖에 없다면 사다리나 승강대(Platform) 혹은 정비탑(Gantry)을 마련해 준다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "8",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-068",
      "text": "작업자에게 미끄러짐 방지에 적절한 안전화를 제공한다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-069",
      "text": "운전자에게 떨어짐 방지를 위한 지침서를 제공하고, 정기적으로 휴식기간을 준다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-070",
      "text": "떨어짐에 대한 예방책이 실제로 잘 실행되고 있는지 점검한다.",
      "guideContext": "운송용 차량 관리자 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "관리·감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-071",
      "text": "적재공간에 발판과 사다리 그리고 적절한 손잡이 설치를 요구한다. 이때 사다리 보다 안정적인 착지가 가능한 발판이 더 좋으며, 가죽손잡이나 줄 보다는 딱딱한 손잡이가 더 낫다.",
      "guideContext": "운송용 차량 구매 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "차량 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-FALL-001",
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-072",
      "text": "작업자가 다니는 바닥면은 미끄럼 방지물질이나 코팅을 하도록 요구한다. 체크무늬 관과 같은 바닥면보다는 미세한 바닥 거칠기를 갖는 재료로 만들어 줄 것을 요청한다.",
      "guideContext": "운송용 차량 구매 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "차량 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-073",
      "text": "운전석에 발판을 포함한 모든 발판은 안전화로 디딜 수 있는 적합한 높이와 깊이를 가져야 한다.",
      "guideContext": "운송용 차량 구매 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "차량 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-074",
      "text": "트레일러 구매 시 전향륜 캣워크 위로 올라가야 하는 수고를 없애기 위해 전향륜 커플링 호스(Coupling hose)가 슬라이딩 컨넥터 블록(Sliding connector block)에 딱 맞도록 조정해 줄 것을 요청한다.",
      "guideContext": "운송용 차량 구매 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "차량 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": null
    },
    {
      "identifier": "CI-G101-075",
      "text": "캣워크는 발 디딤이 좋도록 수평이 맞게 하고 미끄럼 방지 재료로 만들되 그 크기는 충분히 크게 하는 것이 바람직하다.",
      "guideContext": "운송용 차량 구매 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "차량 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-G101-076",
      "text": "지상에서 냉동설비, 테일 리프트(Tail lift) 그리고 로리 크레인(Lorry crane) 같은 장비들에 대한 운전이 가능하도록 올라가서 작업해야 할 필요성이 없게 해 줄 것을 요청한다.",
      "guideContext": "운송용 차량 구매 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "차량 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "9",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-G101-077",
      "text": "냉동플란트는 넘어짐에 위험이 없도록 적재칸에서 물이나 얼음의 생성을 줄일 수 있게 하여야 한다.",
      "guideContext": "운송용 차량 구매 체크리스트 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "차량 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9",
      "basedOn": null
    }
