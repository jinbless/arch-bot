  "checklistItems": [
    {
      "identifier": "CI-X47-001",
      "text": "팀 리더는 리스크 평가의 목적과 범위를 정한 후 평가에 필요한 자료를 수집한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": null,
      "workProcessPhase": "분석 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-002",
      "text": "설계도 등 공정안전 자료는 현장과 일치하여야 한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분석 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-003",
      "text": "팀 리더는 전문적 지식과 경험을 갖춘 팀을 구성한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": null,
      "workProcessPhase": "분석 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-004",
      "text": "팀 리더는 분석 대상의 물리적 범위를 결정하는데, 공정이 큰 경우 기능적, 물리적 영역 또는 업무로 나누어 분석 순서를 정한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": null,
      "workProcessPhase": "분석 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-005",
      "text": "팀 리더는 팀이 사용하기에 적합한 체크리스트를 수집하거나 작성해야 한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법 (법령 근거 미확인)",
      "additionalDetail": "체크리스트는 공정이나 운전의 일반적인 위험한 특징에 초점을 맞추어야 한다.",
      "workProcessPhase": "분석 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-006",
      "text": "잠재적인 사고 상황과 관련된 사고예상질문을 작성한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": null,
      "workProcessPhase": "사고예상질문 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-007",
      "text": "팀이 공정이나 활동의 특정 영역 또는 단계와 관련된 모든 사고예상질문이 확인되면, 팀 리더는 미리 수집 또는 작성했던 체크리스트를 사용한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": "팀은 이 체크리스트를 이용하여 다른 잠재적인 사고 상황을 파악할 수 있다.",
      "workProcessPhase": "체크리스트 보완",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-008",
      "text": "팀은 잠재적인 사고 상황과 관련된 질문을 개발한 후, 각 사고 상황에 대해 검토하고, 그 상황에 의한 사고의 결과를 정성적으로 결정한 다음, 사고의 결과를 예방, 완화 또는 억제할 수 있는 기존의 안전조치를 열거한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": null,
      "workProcessPhase": "질문 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-009",
      "text": "각 사고 상황의 리스크 수준을 평가한 후, 특정한 개선권고 사항의 추천 여부를 결정한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": null,
      "workProcessPhase": "질문 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-X47-010",
      "text": "회의가 끝나면 분석 팀의 리더와 서기는 사고예상질문 분석에서와 마찬가지로 [별지서식1]에 각 질문의 평가결과를 요약하고, [별지서식2]에 개선권고 사항의 조치계획을 요약한다.",
      "guideContext": "사고예상질문/체크리스트 결합기법",
      "additionalDetail": "필요한 경우 분석의 완성도를 나타내기 위해 체크리스트도 문서화 할 수 있다.",
      "workProcessPhase": "결과 문서화",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-X47-001",
      "term": "사고예상질문 분석(What-if) 기법",
      "definition": "공정에 잠재하고 있는 위험요소에 의해 야기될 수 있는 사고를 사전에 예상질문을 통하여 확인·예측하여 공정의 리스크 및 사고의 영향을 최소화하기 위한 대책을 제시하는 방법",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X47-002",
      "term": "체크리스트(Checklist) 기법",
      "definition": "리스크 확인의 간단한 형식으로 공정 및 설비의 오류 결합상태, 위험상황 등을 목록화한 형태로 작성하여 경험적으로 비교함으로써 리스크를 확인하는 방법",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
