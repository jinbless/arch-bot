      ]
    },
    {
      "identifier": "CI-H160-032",
      "text": "근로자에게 청력보호구를 지급하는 때에는 올바른 선택과 착용 및 관리 방법에 대한 교육을 실시한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "교육",
