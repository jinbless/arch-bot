  "domainTerms": [
    {
      "identifier": "DT-H160-001",
      "term": "청력보호구",
      "definition": "청력을 보호하기 위하여 사용하는 귀마개와 귀덮개를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "DT-H160-002",
      "term": "귀마개",
      "definition": "외이도에 삽입 또는 외이 내부·외이도 입구에 반 삽입함으로서 차음효과를 나타내는 일회용 또는 재사용 가능한 청려보호용 귀마개를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "DT-H160-003",
      "term": "귀덮개",
      "definition": "간단한 착용교육으로 사용 가능하며 소음에 대해 우수하게 보호 받을 수 있는 양쪽 귀 전체를 완전히 감싸는 형태의 덮개형 청력보호구를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "DT-H160-004",
      "term": "밀착도검사(fit test)",
      "definition": "청력보호구가 착용할 개인에게 얼마나 적절하게 밀착되는 지를 검사하여 개인에게 가장 잘 맞는 청력보호구를 올바르게 지정할 수 있도록 평가하는 검사를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H160-005",
      "term": "소음작업",
      "definition": "1일 8시간 작업을 기준으로 85 dB(A) 이상의 소음이 발생하는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H160-01",
      "processOrder": 1,
      "processName": "청력보호구 선택",
      "safetyMeasures": "근로자 마다 귀의 모양이 다양하므로 가장 잘 밀착되는 청력보호구를 선택할 수 있도록 다양한 청력보호구를 제공한다. 소음의 정도에 따라 착용해야 할 보호구가 각각 다르며, 소음수준이 85~115 dB일 때는 귀마개 또는 귀덮개를 각각 착용하고, 110~120 dB이 넘을 때는 귀마개와 귀덮개를 동시에 착용한다.",
      "requiredPPE": [
        "귀마개",
        "귀덮개"
      ],
      "sourceSection": "6.1",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "WP-H160-02",
      "processOrder": 2,
      "processName": "청력보호구 지급",
      "safetyMeasures": "85dB을 초과하는 작업장에는 청력보호구 착용에 관한 안전·보건표지를 설치하거나 부착한다. 근로자가 자신의 귀에 가장 밀착이 잘되는 것을 선택할 수 있도록 다양하게 지급하며, 근로자 개인 전용의 것으로 지급한다.",
      "requiredPPE": [
        "귀마개",
        "귀덮개"
      ],
      "sourceSection": "6.2",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "WP-H160-03",
      "processOrder": 3,
      "processName": "폼형 또는 실리콘형 귀마개 착용",
      "safetyMeasures": "오른쪽 귀에 넣을 때는 오른 손으로 귀마개를 말아서 가는 원기둥 모양으로 만든 다음, 왼손을 머리 위로 오른쪽 귀를 올려 후상방으로 당긴다. 귀마개를 오른쪽 귀에 집어넣되 끝이 귓구멍 입구까지 올 때까지 밀어 넣고 약 30초 정도 끝을 눌러준다. 깨끗한 손으로 외이도의 형태에 맞게 삽입하여야 한다.",
      "requiredPPE": [
        "귀마개"
      ],
      "sourceSection": "6.3",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "WP-H160-04",
      "processOrder": 4,
      "processName": "플러그형 귀마개 착용",
      "safetyMeasures": "귀마개가 귓구멍에 잘 맞는가를 제일 먼저 확인한다. 너무 작거나 크면 맞는 크기를 고른다. 귀마개의 축 끝을 잡고 귓구멍을 똑바르게 한 뒤 가볍게 위아래로 흔들면서 비트는 기분으로 가능한 한 깊게 집어넣는다.",
      "requiredPPE": [
        "귀마개"
      ],
      "sourceSection": "6.3",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "WP-H160-05",
      "processOrder": 5,
      "processName": "밀착도 검사(Fit test)",
      "safetyMeasures": "청력보호구를 착용한 후에 소리가 새지는 않는가, 착용감이 좋은가를 확인한다. 밀착도 검사방법으로는 착용 전후 순음청력검사 비교, 귀마개 내부 마이크로폰 삽입 측정, 한쪽 귀 착용 후 양쪽 귀 균형 비교 방법이 있다.",
      "requiredPPE": [
        "귀마개",
        "귀덮개"
      ],
      "sourceSection": "6.4",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "WP-H160-06",
      "processOrder": 6,
      "processName": "청력보호구 관리 및 세척",
      "safetyMeasures": "오염되지 않도록 보관 및 사용하고, 사용 후에는 반드시 보관 캡에 보관하여 청결한 상태를 유지한다. 세척은 미지근한 물에서 중성세제를 사용하며, 귀마개가 원형으로 복귀되지 않거나 딱딱해지거나 찢어진 경우 새것으로 교체한다. 서늘하고 건조하고 직사광선이 비치지 않는 장소에 보관한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "WP-H160-07",
      "processOrder": 7,
      "processName": "청력보호구 관련 교육 실시",
      "safetyMeasures": "근로자에게 청력보호구를 지급하는 때에는 올바른 선택과 착용 및 관리 방법에 대한 교육을 실시한다. 교육 내용에는 착용 시기, 상태 파악 및 관리, 착용·탈착 방법, 보호구의 한계, 안전한 폐기 방법을 포함한다. 훈련 및 교육에 대한 기록지를 작성하여 관리한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": [
        "SR-NOISE-005"
      ]
    }
  ],
