  "checklistItems": [
    {
      "identifier": "CI-H160-001",
      "text": "사업주는 8시간 TWA가 85 dBA 이상에 노출되는 모든 근로자에게 청력보호구를 지급하고, 필요 시 새 것으로 교체하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-002",
      "text": "사업주는 근로자들의 청력보호구 착용하도록 지켜줘야 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-003",
      "text": "사업주는 근로자에게 여러 개의 적합한 청력보호구 중에서 선택할 기회를 제공하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-004",
      "text": "사업주는 청력보호구의 사용 및 관리에 대한 교육과 훈련을 제공하여야 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-H160-005",
      "text": "사업주는 청력보호구를 밀착시켜서 올바르게 착용하는 지 확인하고 모든 청력보호구를 바르게 사용하는 지 지휘 감독하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-006",
      "text": "사업주는 청력보호구 지급 기준을 마련하여야 하고, 청력보호구 사용에 관한 지침들은 다음 사항들을 포함하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": "(가) 사용하기 전 보호구 적절성을 확인하는 방법 및 적절한 배분에 대한 사항 (나) 적절한 유지 관리 및 보관방법 (다) 안전하게 사용할 수 있는 방법에 대한 사용설명서 제공에 관한 사항",
      "workProcessPhase": "청력보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-007",
      "text": "청력보호구를 사용하도록 되어 있는 작업에서는 반드시 사용한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-008",
      "text": "청력보호구는 완전품을 바르고 확실하게 사용한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-009",
      "text": "보호구 기능이 상실되거나 좋지 않으면 상사에게 보고하여 교체하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-010",
      "text": "보호구는 항상 깨끗하게 하고, 남의 것을 사용해서는 안된다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-011",
      "text": "근로자 마다 귀의 모양이 다양하므로 가장 잘 밀착되는 청력보호구를 선택할 수 있도록 다양한 청력보호구를 제공하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-012",
      "text": "소음의 정도에 따라 착용해야 할 보호구가 각각 다르다. 즉, 소음수준이 85~115 dB일 때는 귀마개 또는 귀덮개를 각각 착용하고, 110~120 dB이 넘을 때는 귀마개와 귀덮개를 동시에 착용한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-013",
      "text": "청력보호구는 보호구의 착용으로 8시간 시간가중평균 90 dB(A) 이하의 소음노출수준이 되도록 차음효과가 있어야 한다. 단, 소음성 난청 유소견자나 유의한 역치 변동이 있는 근로자에 대해서는 청력보호구의 착용 효과로 소음노출 수준이 최소한 8시간 시간가중평균 85 dB(A) 이하가 되어야 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-014",
      "text": "소음측정 평가 결과 85dB을 초과하는 작업장에는 청력보호구 착용에 관한 안전·보건표지를 설치하거나 부착한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-002"
      ]
    },
    {
      "identifier": "CI-H160-015",
      "text": "청력보호구는 근로자가 자신의 귀에 가장 밀착이 잘되는 것을 선택할 수 있도록 다양하게 지급한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-016",
      "text": "청력보호구는 근로자 개인 전용의 것으로 지급한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-017",
      "text": "지급한 청력보호구에 대하여는 상시 점검하여 이상이 있는 경우 이를 보수하거나 다른 것으로 교환하여 준다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-018",
      "text": "귀마개는 개인의 외이도에 맞는 것을 사용해야 하며 깨끗한 손으로 외이도의 형태에 맞게 형태를 갖추어 삽입하여야 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "귀마개 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-019",
      "text": "귀덮개는 귀 전체가 완전히 덮일 수 있도록 높낮이 조절을 적당히 한 후 착용해야 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "귀덮개 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-020",
      "text": "115 dB 이상의 고소음 작업장에서는 귀마개와 귀덮개를 동시에 착용해서 차음효과를 높여 주어야 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-021",
      "text": "작업 도중 주위의 경고음이나 신호음 등을 들어야 하는 곳에서는 사고의 위험이 있을 수 있으므로 귀덮개 착용에 주의해야 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 착용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H160-022",
      "text": "청력보호구(귀덮개)의 수시점검은 작업자 개인이 수시로 할 수 있도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H160-023",
      "text": "청력보호구는 항상 서늘하고 건조하고 독립되고 직사광선이 비치지 않는 장소에 보관하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H160-024",
      "text": "소음 작업장에 있을 때는 그 지역을 벗어날 때까지 계속 착용한다. 소음작업장에서 항상 착용하지 않으면 소음감소 효과가 현저하게 떨어지기 때문이다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-025",
      "text": "귀마개를 재빨리 빼면 고막에 통증과 손상을 줄 수 있다. 따라서 귀마개를 뺄 때에는 끈을 잡아 당기지 말고 귀에서 끝을 잡고 완만하게 비틀어서 빼낸다.",
      "guideContext": "청력보호구의 착용방법 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "귀마개 탈착",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H160-026",
      "text": "작업자는 청력보호구를 착용한 후에 소리가 새지는 않는가, 착용감이 좋은가를 확인한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "밀착도 검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-027",
      "text": "오염되지 않도록 보관 및 사용, 특히 귀마개 착용시는 더러운 손으로 만지거나 이물질이 귀에 들어가지 않도록 주의 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-028",
      "text": "귀마개는 소모성 재료로 필요하면 누구나 언제든지 교체 사용할 수 있도록 작업장 내에 비치한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-H160-029",
      "text": "사용 후에는 반드시 보관 캡에 보관하고 청결한 상태를 유지한다.",
      "guideContext": "청력보호구의 착용방법 및 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H160-030",
      "text": "세척은 미지근한 물에서 중성세제를 사용하여 깨끗이 씻어준다. 밴드형 귀마개의 경우 귀마개와 밴드의 연결부위가 손상되지 않도록 주의하면서 세척한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-H160-031",
      "text": "귀마개가 찌그러져 원형으로 복귀되지 않거나 너무 딱딱해진 경우, 찢어진 경우에는 새것으로 교체한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": "세척 후에는 건조시킨 작은 박스나 보관함에 담아 깨끗이 보관한다.",
      "workProcessPhase": "청력보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7",
