      ]
    },
    {
      "identifier": "CI-H160-033",
      "text": "훈련 및 교육에 대한 기록지를 작성하여 관리하도록 한다.",
      "guideContext": "청력보호구의 착용방법 및 관리",
      "additionalDetail": null,
      "workProcessPhase": "교육",
