  "checklistItems": [
    {
      "identifier": "CI-X73-001",
      "text": "이 기법을 사용하기 위해서는 공정안전 전문가, 관리 감독자, 운전원, 공정 엔지니어, 인간공학 전문가 등으로 별도의 팀을 구성한다.",
      "guideContext": "휴먼에러 HAZOP 팀 구성",
      "additionalDetail": null,
      "workProcessPhase": "팀 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-002",
      "text": "팀의 리더는 위험과 운전분석 기법에 대한 충분한 경험을 보유해야 한다.",
      "guideContext": "휴먼에러 HAZOP 팀 운영 (법령 근거 미확인)",
      "additionalDetail": "리더는 가이드워드를 사용해 팀이 시스템 설계를 분석할 수 있도록 안내하는 역할을 수행한다.",
      "workProcessPhase": "팀 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-003",
      "text": "효율적인 분석을 위해 팀의 리더는 HAZOP 형태의 분석에 충분한 경험을 가지고 있어야 하고, 팀을 효과적으로 이끌 수 있어야 한다.",
      "guideContext": "휴먼에러 HAZOP 팀 리더 자격 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팀 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-004",
      "text": "휴먼에러에 대한 위험 및 운전분석을 위해서는 다음과 같은 인원으로 팀을 구성하는 것이 바람직하다.",
      "guideContext": "휴먼에러 HAZOP 팀 구성 권고",
      "additionalDetail": "위험과 운전분석 팀 리더, 현장 공정 안전 전문가, 대상 작업에 대한 관리 감독자, 작업 경험이 있는 운전원 또는 작업자, 공정 엔지니어, 인간 신뢰도 분석에 대한 지식이 있는 인간공학 전문가, 데이터 기록원",
      "workProcessPhase": "팀 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-005",
      "text": "작업을 목표에 따라 여러 개의 세부 작업들로 구분하고, 필요한 경우 세부 작업들을 다시 더 작은 작업들로 나누는 과정을 반복한다.",
      "guideContext": "계층적 작업분석 수행",
      "additionalDetail": null,
      "workProcessPhase": "계층적 작업분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-006",
      "text": "가이드워드가 작업 단계에 영향을 미칠 수 있는지 없는지 뿐만 아니라 어떠한 형태의 에러가 발생할지에 대해서도 토론한다.",
      "guideContext": "가이드워드 검토 과정",
      "additionalDetail": null,
      "workProcessPhase": "가이드워드 검토",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-007",
      "text": "에러에 대한 설명은 명확하고 간결해야 한다.",
      "guideContext": "에러 이탈 설명 작성 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "에러(이탈) 설명",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-008",
      "text": "에러의 결과는 명확하게 기술되어야 한다.",
      "guideContext": "결과 분석 기술 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "결과 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-009",
      "text": "확인된 에러와 관련된 모든 원인을 명확하게 기술하여야 한다.",
      "guideContext": "원인 분석 기술 (법령 근거 미확인)",
      "additionalDetail": "원인은 하나 이상일 수 있다.",
      "workProcessPhase": "원인 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-010",
      "text": "해당 에러에 대한 현재안전조치를 확인할 수 없는 경우, '없음'을 명시한다.",
      "guideContext": "현재안전조치 분석 기록",
      "additionalDetail": null,
      "workProcessPhase": "현재안전조치 분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.7",
      "basedOn": null
    },
    {
      "identifier": "CI-X73-011",
      "text": "분석 결과는 미리 정한 양식에 따라 기록지(부록 1 참조)에 기록한다.",
      "guideContext": "HAZOP 분석 결과 기록",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-X73-001",
      "term": "휴먼에러(Human error)",
      "definition": "의도치 않게 시스템의 효율, 안전, 성능 등을 저해할 수 있는 부적절하거나 바람직하지 않은 인간의 행동 또는 의사결정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-002",
      "term": "인간공학(Human factors / Ergonomics)",
      "definition": "인간의 행위, 능력, 한계, 특성을 파악하여 인간이 편리하고, 안전하고, 생산적이고, 효율적으로 사용할 수 있도록 도구, 기계, 시스템, 작업, 환경의 설계에 응용하는 학문을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-003",
      "term": "인간 신뢰도(Human reliability)",
      "definition": "신뢰할 수 있거나 사용할 수 있는 시스템에 대하여 인간의 행동이 성공적으로 이루어질 확률을 말한다. 즉, 시스템의 신뢰도나 가용도를 훼손할만한 외적인 직무나 행동이 실행되지 않을 뿐만 아니라, 요구되는 시간 내에 시스템이 요구하는 인간행동, 직무, 또는 작업이 성공적으로 완수될 확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-004",
      "term": "인간 신뢰도 분석(Human reliability analysis)",
      "definition": "인간 신뢰도가 추정되는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-005",
      "term": "작업(Task)",
      "definition": "시스템의 목적이나 기능을 달성하기 위한 인간 행동의 단위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-006",
      "term": "계층적 작업분석(Hierarchical task analysis)",
      "definition": "작업을 목표에 따라 여러 개의 세부 작업들로 나누고 이 세부 작업들을 다시 더 작은 작업들로 나누는 과정을 반복함으로써 작업의 구조를 계층의 형태로 상세하게 표현하는 분석 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-007",
      "term": "위험과 운전분석(Hazard and operability(HAZOP) study)",
      "definition": "공정에 존재하는 위험요인과 공정의 효율을 저하시킬 수 있는 운전상의 문제점을 찾아내어 그 원인을 제거하는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-008",
      "term": "컨트롤 시스템의 위험과 운전분석(Control systems hazard and operability study, CHAZOP)",
      "definition": "컨트롤 및 컴퓨터 시스템에서 잠재적인 위험요인과 운용 상의 문제점을 찾아내는 체계적 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-009",
      "term": "안전 문화의 위험과 운전분석(Safety culture hazard and operability study, SCHAZOP)",
      "definition": "안전 경영 시스템의 취약점을 찾아내는 체계적 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-010",
      "term": "위험요인(Hazard)",
      "definition": "인적·물적 손실 및 환경피해를 일으키는 요인(요소) 또는 이들이 혼재된 요인으로서, 기계적 고장, 시스템의 상태, 작업자의 실수 등 물리·화학적, 생물학적, 심리적, 행동적 원인이 자극으로 작용하여 실제 사고(손실)로 전환될 수 있는 잠재적 가능성을 가진 요인을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-011",
      "term": "운전성(Operability)",
      "definition": "운전원이 공장을 안전하게 운전할 수 있는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-012",
      "term": "가이드워드(Guide word)",
      "definition": "작업 단계에 대해 질, 양 또는 상황을 표현하는 간단한 수식어를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-013",
      "term": "이탈(Deviation)",
      "definition": "가이드워드와 작업 단계가 조합되어, 설계의도로부터 벗어난 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-014",
      "term": "원인(Cause)",
      "definition": "이탈을 발생시킨 요인을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X73-015",
      "term": "결과(Consequence)",
      "definition": "이탈이 일어남으로써 야기되는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-X73-01",
      "processOrder": 1,
      "processName": "팀 구성",
      "safetyMeasures": "HAZOP 형태의 분석에 충분한 경험을 가진 팀 리더를 선정하고, 공정안전 전문가, 관리 감독자, 운전원, 공정 엔지니어, 인간공학 전문가, 데이터 기록원으로 팀을 구성한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
