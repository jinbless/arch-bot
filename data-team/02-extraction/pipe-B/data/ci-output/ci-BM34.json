  "checklistItems": [
    {
      "identifier": "CI-BM34-001",
      "text": "모든 크레인 작업은 작업 관리자에 의해 수립된 모든 위험을 고려한 작업 계획 하에서 이루어져야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-002",
      "text": "인양할 하물(荷物)을 바닥에서 끌어당기거나 밀어 작업하지 않는다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-003",
      "text": "유류드럼이나 가스통 등 운반 도중에 떨어져 폭발하거나 누출될 가능성이 있는 위험물 용기는 보관함(또는 보관고)에 담아 안전하게 매달아 운반할 것",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-004",
      "text": "고정된 물체를 직접 분리·제거하는 작업을 하지 아니할 것",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-005",
      "text": "미리 근로자의 출입을 통제하여 인양 중인 하물이 작업자의 머리 위로 통과하지 않도록 할 것",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-006",
      "text": "인양할 하물이 보이지 않는 경우에는 어떠한 동작도 하지 아니할 것(신호하는 사람에 의하여 작업을 하는 경우는 제외한다)",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-007",
      "text": "동일한 주행로에 병렬 설치되어 있는 주행크레인의 수리, 조정, 점검 등의 작업을 하는 때에는 감시인을 두고 주행크레인끼리 충돌하거나 주행크레인이 근로자에 접촉함으로써 발생하는 근로자의 위험을 방지하기 위하여 충돌방지조치를 하여야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-008",
      "text": "크레인 조종사는 정지 신호를 제외하고는 지정된 한 명의 줄걸이 작업자 또는 신호수의 신호에 의해서만 작업을 해야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-009",
      "text": "검사, 정비 또는 다른 작업을 위해 크레인에서 작업을 할 때는 크레인 작동을 멈춰야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-010",
      "text": "크레인 조종사의 허가 없이는 아무도 크레인의 작동 영역에 들어오거나 크레인에 승하차할 수 없다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-011",
      "text": "줄걸이 작업자와 신호수는 적절한 접근 통로와 비상 탈출구민을 사용하여야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-012",
      "text": "크레인 조종사에게 쉽게 식별할 수 있도록 눈에 잘 보이는 옷을 착용하고, 상황에 맞는 안전 장비를 사용하여야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": "줄걸이 작업자와 신호수에 대한 요구사항",
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-013",
      "text": "크레인에 인양물이 매달려 있는 상태에서는 크레인 조종사는 항상 탑승해 있어야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-014",
      "text": "원격 조종되는 크레인의 조종사는 작업 중에 송신기를 항상 소지하고, 오동작 방지를 위해 주의한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-015",
      "text": "부하가 걸리지 않은 달기구가 빠지는 것을 방지하기 위한 조치를 취해야 한다.",
      "guideContext": "크레인 안전작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-016",
      "text": "정격하중, 성능 및 안전장치 기능을 완전히 이해하고 「유해·위험작업의 취업제한에 관한 규칙」에 의한 자격을 갖춘 자가 운전한다.",
      "guideContext": "조종실-조종 천장주행크레인 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "크레인 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-017",
      "text": "작업내용과 일정 등을 해당 크레인 운전자가 알 수 있도록 반드시 사전에 협의 또는 통보하고 작업 시작 직전에 재확인한다.",
      "guideContext": "크레인 점검·보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-018",
      "text": "해당 크레인의 동력전원을 차단한 후 시건장치를 하고 \"점검 중 조작금지\" 등의 표지를 게시한다.",
      "guideContext": "크레인 점검·보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-019",
      "text": "공사범위 내의 지상구역에는 위험구역임을 표시하여 관계자외 출입을 금지시킨다.",
      "guideContext": "크레인 점검·보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-020",
      "text": "승강용 계단이나 사다리의 출입문 열쇠는 크레인 운전자가 소지하고 있으므로 개방을 의뢰한다.",
      "guideContext": "크레인 점검·보수",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-021",
      "text": "통로(크레인과 건설물 또는 설비와의 사이) 또는 주행궤도 상에서 정비·보수·점검 등의 작업을 하는 때에는 인접 크레인의 접근을 방지하기 위하여 작업구역 경계선에서 5~10m 바깥 지역에 전기식 리미트 스위치용 터치바를 설치한 후 작업에 임한다.",
      "guideContext": "크레인 점검·보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-022",
      "text": "고소에서의 추락재해를 예방하기 위하여 안전그네식 안전대를 착용하고 로프, 훅, 피봇클램프 등을 이용, 걸이대에 체결 후 작업한다.",
      "guideContext": "크레인 점검·보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-023",
      "text": "주행, 횡행, 권상장치 내 감속기와 모터의 장기 가동 및 동적 운전으로 인한 체결부품(볼트, 너트 등)의 체결 상태를 확인한다.",
      "guideContext": "크레인 점검·보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "점검·보수 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-024",
      "text": "매달린 하중과 안전 거리를 유지한 상태에서 인양물을 유도, 정렬, 제어할 필요가 있을 경우에는 인양물 조정봉(Push-Pull pole)이나 고정줄(Tagline)을 사용한다.",
      "guideContext": "인양물 조정봉 사용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.6",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-025",
      "text": "회전 부, 돌출 된 축의 끝 부분, 휠, 벨트 구동 부, 체인, 커플링, 기어, 차륜 및 풀리 등 일상적인 운전·정비·조정 중에도 위험성이 있는 동력전달부에는 덮개 또는 울을 설치하여야 하며, 회전축, 기어, 풀리 등에 부속하는 키, 핀 등의 기계요소가 있는 경우에는 문힘형으로 하거나 해당 부위에 덮개를 설치한다.",
      "guideContext": "크레인 구동부 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-026",
      "text": "방호조치는 운전, 정비 중 사람이 표면을 딛고 서 있거나 돌아다니는 것이 특별히 금지된 경우가 아니라면 영구변형이 없이 900 N(90 kgf)의 체중을 지탱할 수 있어야 한다.",
      "guideContext": "크레인 구동부 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-027",
      "text": "기어, 풀리, 차륜, 덮개 및 제어상자 등 크레인의 부품은 정상적인 동작 중에도 이탈의 위험성이 있으므로 이를 방지할 수 있도록 설치하여야 한다.",
      "guideContext": "이탈물 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-028",
      "text": "덮개, 가드, 접근차단 장치는 힌지 또는 그 밖의 방법을 사용하여 탈락이 되지 않도록 부착하여야 한다.",
      "guideContext": "이탈물 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-029",
      "text": "경첩을 사용한 경우에는 열리거나 닫힌 위치 등 모든 상태에서 지탱할 수 있도록 빗장, 잠금장치, 추 등 필요한 기능을 갖추어 두어야 한다.",
      "guideContext": "이탈물 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-030",
      "text": "지상에서 크레인 또는 주행레일로 올라가기 위한 계단 또는 사다리 입구에 시건장치가 있는 출입문을 설치하되, 출입문을 닫으면 자동으로 잠기며, 내부에서는 임의로 개방할 수 있으나 외부에서는 당해 출입문용 열쇠로만 열 수 있는 구조가 좋다.",
      "guideContext": "방호설비",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-031",
      "text": "출입구 상부 또는 잘 볼 수 있는 가까운 위치에 문 개방 1차 경고용 경보등을 설치한다.",
      "guideContext": "방호설비 (법령 근거 미확인)",
      "additionalDetail": "계단 또는 사다리 입구의 출입문 및 경보장치",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-032",
      "text": "운전식 전면의 공장 기둥에 출입문 개방 경고용 경보등과 사이렌을 설치한다.",
      "guideContext": "방호설비 (법령 근거 미확인)",
      "additionalDetail": "계단 또는 사다리 입구의 출입문 및 경보장치",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-033",
      "text": "크레인 본체 위 통로 끝단부에 출입문을 설치한다.",
      "guideContext": "방호설비 (법령 근거 미확인)",
      "additionalDetail": "크레인 본체 출입문 및 경보장치",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-034",
      "text": "출입문을 열면 운전실 내부에서 경보가 작동되도록 한다.",
      "guideContext": "방호설비 (법령 근거 미확인)",
      "additionalDetail": "크레인 본체 출입문 및 경보장치",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-035",
      "text": "전기적 스토퍼는 전기식 리미트 스위치와 이동용 자석식 터치바로 구성한다.",
      "guideContext": "접근 방지용 스토퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-036",
      "text": "전기식 리미트 스위치는 크레인 새들부 좌우, 전후단에 각각 1개씩 설치한다.",
      "guideContext": "접근 방지용 스토퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-037",
      "text": "자석식 터치바는 평철 종류와 자석을 사용하여(규격: 폭 5cm, 길이 50cm 정도) 크레인 레일 측면에 부착할 수 있도록 제작한다.",
      "guideContext": "접근 방지용 스토퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-038",
      "text": "전기식 리미트 스위치가 자석식 터치바에 접촉되면 운전실 내부의 경보장치가 작동하며 크레인의 주행 운전이 정지되도록 연동시킨다.",
      "guideContext": "접근 방지용 스토퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-039",
      "text": "자석식 터치바는 크레인의 주행 브레이크 동작후 멈춤거리를 고려하여 설치 한다.",
      "guideContext": "접근 방지용 스토퍼 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-040",
      "text": "빔 센서는 새들부 좌우, 전후 단에 각각 1개씩 설치되어야 한다.",
      "guideContext": "충돌·협착 예방용 빔 센서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-041",
      "text": "최대 감지거리가 4m 이상이 되는 빔 센서를 설치하여야 한다.",
      "guideContext": "충돌·협착 예방용 빔 센서 (법령 근거 미확인)",
      "additionalDetail": "빔 폭은 공장 기둥 등과 간섭되지 않도록 최소한으로 축소 조정",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-042",
      "text": "빔 센서에 장애물이 감지되면 운전실 내부의 경보장치가 작동하면서 크레인 주행운전이 정지되도록 연동시킨다.",
      "guideContext": "충돌·협착 예방용 빔 센서 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-043",
      "text": "종합경보 수신반은 크레인 운전실 내부에 설치한다.",
      "guideContext": "종합경보 수신반 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-044",
      "text": "크레인 본체 출입문 개방경보, 전기식 스토퍼 작동경보, 빔 센서 감지 경보의 세 가지 경보를 동시에 처리한다.",
      "guideContext": "종합경보 수신반 (법령 근거 미확인)",
      "additionalDetail": "경보등이 켜지며 경보음이 동시에 울리도록 하고 경보등은 녹, 청, 적색의 세 가지로 구분하여 각각의 경보 내용을 알 수 있도록 용도를 표기한다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-045",
      "text": "착용자의 추락강도에 견딜 수 있는 견고한 안전대 걸이를 공장 기둥과 기둥 사이에 설치하여 안전그네식 안전대를 쉽게 걸 수 있도록 한다.",
      "guideContext": "추락방지용 안전대 걸이 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-046",
      "text": "와이어로프는 직경 5mm 이상, 섬유로프는 직경 20mm 이상을 사용한다.",
      "guideContext": "추락방지용 안전대 걸이 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-047",
      "text": "턴버클을 사용하여 와이어로프의 장력이 유지되도록 조정한다.",
      "guideContext": "추락방지용 안전대 걸이 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-048",
      "text": "크레인 주행레일과 병행하여 작업자 또는 크레인 운전자의 보행통로를 설치하는 경우에는 주행크레인과의 충돌 및 협착위험을 방지하기 위하여 주행크레인과 건축물 또는 설비와의 사이의 간격을 600 mm 이상으로 하여야 한다.",
      "guideContext": "정비 등의 보행통로 (법령 근거 미확인)",
      "additionalDetail": "보행 통로에 기둥 등 돌출물이 있는 경우에는 400 mm 이상으로 할 수 있다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-049",
      "text": "화물의 운반·이동시에는 화물특성에 맞는 적정 인양물 조정봉을 사용한다.",
      "guideContext": "인양물 조정봉 사용 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-050",
      "text": "인양물 조정봉은 사용 전 점검을 하여 파손 등에 이상이 없을시 사용한다.",
      "guideContext": "인양물 조정봉 사용 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-051",
      "text": "사용방법을 숙지하고 허용범위 내 에서만 사용한다.",
      "guideContext": "인양물 조정봉 사용 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-052",
      "text": "화물취급 외의 타용도로 사용해서는 안된다.(고정된 물체 이동작업금지)",
      "guideContext": "인양물 조정봉 사용 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-053",
      "text": "사용방법에 대한 사전교육을 철저히 실시한다.",
      "guideContext": "인양물 조정봉 사용 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-054",
      "text": "감전재해의 우려가 있는 곳에는 사용에 주의한다.",
      "guideContext": "인양물 조정봉 사용 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-055",
      "text": "가능하면 2인 1조로 각각의 인양물 조정봉을 사용하여 작업을 수행한다.",
      "guideContext": "인양물 조정봉 사용 안전수칙",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-056",
      "text": "인양물 조정봉의 이상이 발견된 때는 즉시 알려 교체 사용한다.",
      "guideContext": "인양물 조정봉 사용 안전수칙 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인양 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "별표 1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-057",
      "text": "크레인 사용 작업과 설치·수리·조정 및 점검 작업 시에 안전 조치 사항을 이행하여야 한다.",
      "guideContext": "크레인 안전작업 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": "안전보건규칙 제139조, 제141조, 제146조에 따른 의무",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM34-058",
      "text": "크레인은 산업안전보건법에 따라 안전인증대상기계에 포함되므로, 법에서 규정되어있는 정의 및 적용범위에 해당할 경우 안전인증과 안전검사를 받은 기계와 방호장치를 사용하여야 한다.",
      "guideContext": "크레인 안전작업 법적 필수사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BM34-001",
      "term": "천장형 크레인(Overhead type crane)",
      "definition": "호이스트 또는 크래브에 매달린 인양물 취급 장치를 가진 크레인 또는 브리지를 따라 이동할 수 있는 지브 크레인을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-002",
      "term": "천장주행크레인(Overhead travelling crane)",
      "definition": "주행 왕복대에 의해 레일(rail)또는 트랙(track) 위에 직접 지지되는 브리지 거더(bridge girder)를 가진 크레인",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-003",
      "term": "갠트리 크레인(Gantry crane)",
      "definition": "주행레일 위에 설치된 교각(leg)에 의해 지지되는 거더가 있는 크레인으로서, 주행레일 대신 원동기 및 타이어를 부착하고 불특정 장소에 스스로 이동이 가능한 형식을 포함",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-004",
      "term": "조종실-조종 크레인(Cab-operated crane)",
      "definition": "크레인에 부착된 조종실에서, 설치된 조종장치로 조종사가 제어하는 크레인",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-005",
      "term": "펜던트로 조종하는 크레인(Pendant-operated crane)",
      "definition": "호이스트 트롤리 또는 별도의 현수 케이블로 연결된 펜던트로 제어하는 크레인",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-006",
      "term": "원격 조종 크레인(Remote operated crane)",
      "definition": "크레인과 떨어진 곳에서 제어되는 크레인",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-007",
      "term": "무선 원격 조종 크레인(Cableless remote operated crane)",
      "definition": "제어반과 크레인 사이에 어떠한 물리적 연결 없이 조종사의 명령 전송으로 제어되는 크레인",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-008",
      "term": "작업 관리자(Appointed person)",
      "definition": "인양 작업을 하고자 하는 기관을 대신하여 크레인의 작동 및 조종을 전체적으로 관리, 조절하는 한 명의 법적 자격이 있는 자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-009",
      "term": "접근로(Access way)",
      "definition": "크레인에 설치된 사다리, 계단, 경사로, 통로, 작업발판 등 작업자가 이동·접근·체류할 수 있는 모든 부분을 통틀어 지칭하는 것이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-010",
      "term": "접근방지용 스토퍼",
      "definition": "크레인 주행레일 구간 내에서 작업 시 주위의 크레인이 작업구역 내로 접근하지 못하도록 설치하는 전기식의 스토퍼(Stopper)를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-011",
      "term": "충돌·협착 예방용 빔 센서",
      "definition": "크레인 주행시 광선을 쏘아 주행레일 상부에 인체 등이 감지되면 경보음을 울리면서 주행모터 전원을 차단시켜 크레인을 정지시키는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-012",
      "term": "계단 또는 사다리 입구의 출입문 및 경보장치",
      "definition": "크레인 운전자 등 관계자 이외의 사람이 크레인 주행레일에 임의 접근하지 못하도록 크레인 승강용 계단이나 사다리의 입구에 설치하는 출입문과 문을 일정시간 내에 닫지 않으면 경보가 발하는 경보장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-013",
      "term": "크레인 본체 출입문 경보장치",
      "definition": "크레인 본체 상부에 정비·보수 근로자 등 당해 크레인 운전자 외의 근로자가 무단 출입 시, 크레인 운전자가 즉시 알 수 있도록 알려주는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-014",
      "term": "종합경보 수신반",
      "definition": "전기식 스토퍼, 빔 센서의 경보와 크레인 본체 상부 출입문 개방 경보를 종합적으로 수신할 수 있도록 운전실 내에 설치되는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-015",
      "term": "인양물 조정봉(Push-Pull pole)",
      "definition": "모든 형태의 크레인과 이에 준하는 권상 및 권하가 가능한 운반용 기계·기구를 사용하여 중량물 운반 시 와이어로프 등의 걸이줄에 걸어 운반물을 조정할 수 있게 하며, 안전거리를 유지하여 작업자의 안전을 확보하는 개인용 보조공구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-016",
      "term": "컨테이너용 조정봉",
      "definition": "컨테이너 작업 시 추락, 협착, 비래 등의 재해를 예방하기 위하여 작업자를 위험점으로부터 이격시키기 위하여 사용하는 보조공구",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-017",
      "term": "원목용 조정봉",
      "definition": "원목 및 각재를 취급하는 야적장, 부두, 원목하역장 등에서 작업자를 위험점으로부터 이격시키기 위하여 사용하는 보조공구",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM34-018",
      "term": "다용도용 조정봉",
      "definition": "조선소, 그밖의 양중장치를 사용하는 모든 장소에서 작업자를 위험점으로부터 이격시키기 위하여 사용하는 보조공구",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
