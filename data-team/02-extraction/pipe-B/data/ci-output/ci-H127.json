  "checklistItems": [
    {
      "identifier": "CI-H127-001",
      "text": "라돈은 자연적으로 발생하는 것이므로 어쩔 수 없다거나 누가 책임질 수 있는 것이 아니라고 하여 방치해 둘 수 있는 것은 아니라 사업장의 실내 공기 중 라돈으로 근로자들이 피폭하는 것은 직업피폭이므로 사업주는 작업공간에서 라돈의 농도를 가능하면 낮추는 노력을 해야 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "일반적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-H127-002",
      "text": "흙, 시멘트, 지반의 균열 등에서 방출되는 라돈 기체가 환기가 잘되지 않는 사업장 건물, 특히 지하작업장이나 밀폐공간에 농축되는 경우가 생기지 않도록 해야 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "일반적 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-001"
      ]
    },
    {
      "identifier": "CI-H127-003",
      "text": "광부, 지하철 종사자 등과 같은 일부 특정 직업군과 지역 및 사업장의 건물 상태에 따라서 비교적 높은 농도의 라돈에 노출될 수 있다. 직업피폭으로 주목받는 곳은 광산이나 지하공간이지만 지상 건물에도 라돈 농도가 높을 수 있으므로 먼지 상황을 파악해야 하기 위해서는 작업장의 라돈 농도를 측정하도록 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈농도 측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H127-004",
      "text": "사업장에서 라돈 피폭도 직업피폭이므로 다른 방사선원으로 인한 직업피폭과 일체로 관리되어야 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "일반적 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-005",
      "text": "사업주는 근로자가 선량제한치를 초과하여 피폭하지 않도록 관리해야 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방 (법령 근거 미확인)",
      "additionalDetail": "국제방사선방호위원회(ICRP 103, 2007)에서는 사업장 안전표준으로 1,000 Bq/㎥를 권고",
      "workProcessPhase": "라돈노출기준 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-006",
      "text": "라돈농도 측정은 비교적 수행하기 간단하지만, 정확하고 일관성 있는 측정을 보장하기 위한 표준화된 프로토콜에 기반하도록 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈농도 측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H127-007",
      "text": "실내 라돈 농도는 건물의 구조와 환기의 습관에 따라 변동하고, 계절에 따라 크게 변동 할뿐만 아니라, 매일 또는 매시간도 변화한다. 이러한 변화 때문에, 작업장의실내 공기의 라돈 농도의 연간 평균치의 추정은 적어도 3개월 이상 하도록 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈농도 측정",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-H127-008",
      "text": "실내에 사용되는 건축자재 중의 라돈 방출 수준을 평가하여, 가능하면 라돈 발생량이 적은 자재를 사용하도록 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-009",
      "text": "토양과 건축물 사이에 물리적 장벽을 설치하여 토양과 건물의 기초가 직접 접촉하는 것을 방지하거나 토양 중 라듐의 농도가 낮은 곳을 건축지로 선택한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-010",
      "text": "발생원을 조절하는 방법에는 라돈의 유입 경로(배수구, 속이 빈 콘크리트 벽, 벽과 바닥의 교차 부분과 바닥재의 이음새, 열에 의한 팽창과 재료들의 수축에 의한 틈, 지하실 바닥의 틈, 건물의 갈라진 틈 등)를 차단한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-H127-011",
      "text": "배출파이프를 지하실 슬라브(slab) 밑에 넣어 환기를 시켜 준다. 이것은 가장 효과적인 라돈 경감 대책 중의 하나이다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-012",
      "text": "실내 공기를 순환시킬 때는 반드시 실내분진의 농도를 낮추어 가능한 한 라돈의 자핵종들이 부착되지 않도록 한다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H127-013",
      "text": "가장 효과적이고, 손쉬운 라돈 저감방법은 '환기'이다. 주기적인 환기를 통해 농도를 크게 낮출 수 있다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-H127-014",
      "text": "라돈농도 측정 결과 만약 기준치를 초과했다면, 먼저 바닥이나 벽 등에 갈라진 틈이 나 확인해 본다. 건물의 바닥틈새 등을 메우는 것도 좋은 방법이다. 보강재 등을 이용해 갈라진 틈새만 잘 막아도 실내 농도저감에 큰 효과를 볼 수 있다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-015",
      "text": "만약 이러한 조치로도 충분한 저감효과를 거두지 못했다면, 건물 밑 토양에 라돈 배출관을 설치한다. 배출관은 토양 중의 라돈가스를 모아서 실내를 거치지 않고 바로 건물 외부로 배출시킨다. 배출관 중간에 환기팬을 설치하면 효과를 더욱 높일 수 있다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-016",
      "text": "외부공기 유입장치도 유용한 수단이다. 공기유입용 장치를 통해 실내공기의 압력을 건물 하부보다 인위적으로 높이면 압력차 때문에 라돈가스가 작업장의 실내로 들어오지 못하게 된다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-017",
      "text": "토양 중 라돈 농도가 높은 지역은 건축물을 지을 때부터 건물 하부에 차단막을 깔면 예방할 수 있다. 신축 건물의 경우, 처음부터 라돈 저감 시공법을 활용하면 비용 대비 최고의 저감효과를 얻을 수 있다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "신축 건물 라돈 저감 시공",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-018",
      "text": "라돈 농도가 높은 사업장에서는 \"전리방사선 노출 근로자 건강관리지침(KOSHA GUIDE H-62-2012)\"에 따른 노출 근로자에 대하여 배치전 및 주기적 건강진단을 실시한다.",
      "guideContext": "라돈 노출 근로자의 암 예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-019",
      "text": "발생원을 제거하기 위해, 토양 내의 라듐의 농도가 높을 경우 건물 아래의 토양을 교환하는 것을 고려할 수 있다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H127-020",
      "text": "지하실에서 지상으로 라돈이 유입되는 것을 방지하기 위해 지하실 쪽으로 약 3~4 Pa 정도의 약한 압력을 걸어주어 지상 실내의 라돈 농도를 4 pCi/L 이하로 감소시킬 수 있다.",
      "guideContext": "라돈 노출 근로자의 암 예방",
      "additionalDetail": null,
      "workProcessPhase": "라돈 저감",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.4",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H127-001",
      "term": "발암물질",
      "definition": "암을 일으키거나 그 발생을 증가시키는 물질이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H127-002",
      "term": "베크렐(Bq)",
      "definition": "방사선 양의 국제단위(SI)로, 1 Bq은 1초 동안 하나의 방사성 붕괴가 일어나는 양이며, \"퀴리(Ci)\"란 방사능을 나타내는 단위로 1Ci는 1g의 라듐(226Ra, t1/2=1600년)이 1초 동안 붕괴할 때 나오는 방사선 양으로 3.7 X 10¹⁰개/초의 원자가 붕괴할 때 나오는 방사선 양과 같다. 따라서 1 Ci = 3.7x10¹⁰Bq이다. 공기 중의 라돈 농도는 Bq/㎥나 pCi/L로 표시하며, 1 pCi/L는 37 Bq/㎥ 에 해당한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H127-003",
      "term": "작업수준월(working level month)",
      "definition": "라돈의 피폭량을 나타내는 단위이다. 1 WL은 라돈-222와 그 자핵종이 평형을 이루는 상태의 방사선 양인 200 pCi/L에 해당되며, 누적 노출량으로서 1WL의 농도에서 170시간 노출된 경우를 1WLM (working level month)이라 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H127-004",
      "term": "시버트(Sv)",
      "definition": "방사선이 살아있는 조직에 대한 영향이 방사선의 종류에 따라 다른 것을 참작하기 위하여 그레이(Gy)로 표시하는 방사선의 흡수선량에 방사선의 종류에 따른 가중계수를 곱한 방사선의 단위로 등가성량이라고 하며, 1 Sv는 1000 mSv와 같다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H127-01",
      "processOrder": 1,
      "processName": "라돈농도 측정",
      "safetyMeasures": "표준화된 프로토콜에 기반하여 측정하며, 연간 평균치 추정을 위해 적어도 3개월 이상 측정한다. 수동형 라돈 측정장치(알파 비적검출기) 또는 능동형 라돈 측정장치를 사용한다.",
      "requiredPPE": [],
      "sourceSection": "7.3",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "WP-H127-02",
      "processOrder": 2,
      "processName": "라돈 저감 조치 (기존 건물)",
      "safetyMeasures": "라돈 유입 경로(배수구, 벽과 바닥의 이음새, 건물의 갈라진 틈 등)를 차단하고, 배출파이프를 지하실 슬라브 밑에 설치하며, 주기적 환기를 실시한다. 실내 공기 순환 시 실내분진 농도를 낮추어 라돈 자핵종 부착을 방지한다.",
      "requiredPPE": [],
      "sourceSection": "7.4",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "WP-H127-03",
      "processOrder": 3,
      "processName": "신축 건물 라돈 저감 시공",
      "safetyMeasures": "토양에 자갈을 깔고 토양라돈 배출관을 설치하며, 플라스틱 시트를 깔고 틈새가 없도록 밀봉한다. 라돈 배출관을 건물 지붕 위로 올라가게 설비하고, 환기팬을 설치한다.",
      "requiredPPE": [],
      "sourceSection": "7.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H127-04",
      "processOrder": 4,
      "processName": "근로자 건강관리",
      "safetyMeasures": "전리방사선 노출 근로자 건강관리지침(KOSHA GUIDE H-62-2012)에 따라 배치전 및 주기적 건강진단을 실시한다. 눈, 피부, 조혈기 장해와 관련된 증상, 징후 및 검사소견을 관찰한다.",
      "requiredPPE": [],
      "sourceSection": "7.4",
      "relatedSR": null
