  "checklistItems": [
    {
      "identifier": "CI-A166-001",
      "text": "페닐글리시딜에테르와 이황화탄소는 독성물질이다. 또한 이황화탄소는 화재 및 폭발위험이 높다(인화점 -30℃). 이 물질들은 흄후드 안에서 사용하여야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "시료채취 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "I",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-A166-002",
      "text": "시료 채취 시와 동일한 연결상태에서 각 시료채취펌프를 보정한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-003",
      "text": "시료채취 바로 전에 흡착관의 양끝을 절단한 후 유연성 튜브를 이용하여 펌프에 연결한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-004",
      "text": "0.01 ~ 1 L/분에서 정확한 유량으로 80 ~ 150 L 정도 시료를 채취한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-005",
      "text": "시료채취가 끝나면 흡착관을 플라스틱 마개(고무마개는 피한다)로 밀봉하여 운반한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "I",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-006",
      "text": "시료의 시험, 바탕시험 및 표준액에 대한 일련의 동일시험을 행할 때 사용하는 시약 또는 시액은 동일 롯트(LOT)로 조제된 것을 사용한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-007",
      "text": "분석에 사용되는 시약은 따로 규정이 없는 한 화학용 시약에 규정된 일급 이상의 것을 사용하여야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-008",
      "text": "광도법, 전기화학적분석법, 크로마토그래피법, 고성능액체크로마토그래피법에 쓰이는 시약은 특히 순도에 주의하고, 분석에 영향을 미치는 불순물을 함유할 염려가 있을 때는 미리 검정하여야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-009",
      "text": "계량기구 중 측정값을 분석결과의 계산에 사용할 목적으로 사용되는 것은 모두 보정하는 것을 원칙으로 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-010",
      "text": "중량분석 용 지울은 적어도 10⁻⁵ g(0.01 mg)까지 달수 있어야 하며, 화학분석 용 지울은 적어도 10⁻⁴ g(0.1 mg)까지 달 수 있어야 하며, 국가검정을 필한 제품 또는 이에 준하는 검정을 필한 제품이어야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-011",
      "text": "이 시험법에서 사용하는 모든 유리 기구는 KS L 2302(이화학용 유리기구의 모양 및 치수)에 적합한 것 또는 이와 동등 이상의 규격에 적합한 것으로 국가에서 지정한 기관에서 검정을 필한 것을 사용하여야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료채취 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-012",
      "text": "노출기준과 비교 시는 작업환경 측정 시의 온도와 압력을 실측하여 정상상태의 농도로 환산하여야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "정상상태(NTP): 25℃, 1기압",
      "workProcessPhase": "계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-013",
      "text": "일반적으로 분석하고자 하는 농도를 포함한 최소한 5개 수준의 표준용액을 제조한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-014",
      "text": "검량선은 시료 분석조건과 주입방법에 따라 작성하고 검량선이 적정하다고 판정하면 시료를 분석한다. 검량선은 분석할 시료의 농도를 포함해야 하며 외삽법은 피한다. 검량선의 적정성은 제시된 분석기기의 매뉴얼을 참조하거나 상관계수가 0.99이상의 것을 사용하도록 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-015",
      "text": "탈착효율은 최소한 0.75 이상이 되어야 하나 0.90 이상이면 좋다. 탈착효율에 대한 평가는 분석자가 해야 한다. 즉 12개의 탈착효율 실험결과를 근거로 판단해야 할 사항은 탈착효율간의 일정성이다. 만일 탈착효율간의 차이가 크고 변이가 심하여 일정성이 없으면 정확한 보정이 될 수가 없다. 따라서 그 원인을 찾아 교정하고 다시 실험을 실시해야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-016",
      "text": "0.01 ~ 6 mg/시료 농도범위에서 6개의 표준용액으로 검량선을 작성한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-017",
      "text": "각 시료군 배치 당 최소한 한번 씩은 행하여야 하며 3개 농도 수준에서 각각 3개씩과 공시료 3개를 준비한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": "탈착율 검정 시료 제조 요건",
      "workProcessPhase": "검량선 작성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "III",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-018",
      "text": "만일 뒤 층에서 검출된 양이 앞 층에서 검출된 양의 10%를 초과하면(Wb > Wf/10), 시료 파과가 일어난 것이므로 이 자료는 사용할 수 없다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "IV",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-019",
      "text": "페닐글리시딜에테르는 피부 및 눈 접촉을 방지하여야 하며, 오염되었을 경우에는 물과 비누로 씻어야 한다. 삼켰을 경우에는 즉시 의학적 조치를 취해야 한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "V",
      "basedOn": null
    },
    {
      "identifier": "CI-A166-020",
      "text": "실험에 사용되는 모든 화학물질은 흄후드 안에서 사용하여야 하며, 필요시 보안경, 보호장갑 및 보호복을 착용한다.",
      "guideContext": "페닐글리시딜에테르 작업환경측정·분석",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "V",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    }
  ],
