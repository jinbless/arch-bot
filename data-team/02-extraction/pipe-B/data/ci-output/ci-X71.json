  "checklistItems": [
    {
      "identifier": "CI-X71-001",
      "text": "분석 대상 직무에 대한 직무분석(Task Analysis)을 통해 직무수행에 필요한 절차를 정리한다. 절차서가 있는 경우에는 절차서에 기술된 것을, 만일 절차서가 없다면 운전자 면담 등을 통하여 직무수행에 필요한 행위들을 기존 비상운전절차서와 비슷한 수준으로 정리한다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용",
      "additionalDetail": null,
      "workProcessPhase": "사상연쇄의 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2(1)",
      "basedOn": null
    },
    {
      "identifier": "CI-X71-002",
      "text": "상황과 직무를 분석하는 것이 가장 중요하며, 통상 계층적 직무분석(Hierarchical Task Analysis; HTA)의 형태를 취하도록 권장된다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용",
      "additionalDetail": null,
      "workProcessPhase": "사상연쇄의 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2(1)",
      "basedOn": null
    },
    {
      "identifier": "CI-X71-003",
      "text": "분석자는 운전자와 통제 직무만 볼 것이 아니라, 조직과 기술적 시스템도 고려하여야 한다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용 (법령 근거 미확인)",
      "additionalDetail": "직무분석 시 인간 요소뿐 아니라 조직적·기술적 시스템 전체를 포괄적으로 분석해야 함",
      "workProcessPhase": "사상연쇄의 구성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2(1)",
      "basedOn": null
    },
    {
      "identifier": "CI-X71-004",
      "text": "상황특성을 파악할 때에는 공통행동조건(Common Performance Conditions; CPCs)을 참조하여 해당되는 항목의 행동형성요인 수준을 확인한다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용",
      "additionalDetail": null,
      "workProcessPhase": "상황요인분석",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2(2)",
      "basedOn": null
    },
    {
      "identifier": "CI-X71-005",
      "text": "상황요인분석을 통하여 파악된 공통행동조건 해당 항목의 행동형성요인들이 운전원의 행동신뢰도에 미치는 영향을 정성적으로 추정한다. 이 때에는 '개선' 항목의 개수와 '저감' 항목의 개수를 파악한다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용",
      "additionalDetail": null,
      "workProcessPhase": "개연적 제어모드 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2(3)",
      "basedOn": null
    },
    {
      "identifier": "CI-X71-006",
      "text": "'개선'된 항목의 개수와 '저감'된 항목의 개수를 제어모드 판정도에 적용하여 해당 작업을 수행하는 도중에 발생할 수 있으리라 예상되는 개연적 제어모드(probable control mode)를 도출한다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용",
      "additionalDetail": "제어모드: 전술적(Strategic), 전략적(Tactical), 우발적(Opportunistic), 긴급(Scrambled)",
      "workProcessPhase": "개연적 제어모드 결정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2(3)",
      "basedOn": null
    },
    {
      "identifier": "CI-X71-007",
      "text": "작업 수행 상황에서 운전원이 당면해야 하는 인지기능과 구체적인 인지직무유형을 파악한다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용",
      "additionalDetail": "인지기능: 관찰, 해석, 계획, 실행의 4단계",
      "workProcessPhase": "인지직무유형의 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2(4)",
      "basedOn": null
    },
    {
      "identifier": "CI-X71-008",
      "text": "각 직무 수행 절차에 해당하는 인지직무유형(cognitive task type)을 결정한다. 인지직무유형은 비상운전절차서를 근거로 개발되어 총 15가지로 정의되어 있다.",
      "guideContext": "인지신뢰도 및 휴먼에러분석기법(CREAM) 적용",
      "additionalDetail": "15가지 인지직무유형: 협조, 의사소통, 비교, 진단, 평가, 시행, 식별, 유지, 감시, 관찰, 계획, 기록, 조정, 검색, 입증",
      "workProcessPhase": "인지직무유형의 설정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2(4)",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-X71-001",
      "term": "인간-기계 시스템",
      "definition": "인간과 도구, 기계, 설비 등으로 이루어진 모든 시스템을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-002",
      "term": "휴먼에러",
      "definition": "인간이 수행하는 일련의 행동이나 행동군 중에서 수용 한계를 벗어난 행동, 즉 시스템의 정상적 기능을 위하여 정의된 인간의 행동 한계를 넘은, 감내할 수 없는 행동을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-003",
      "term": "행동 에러",
      "definition": "자신이 의도한 대로 동작이나 행위가 이루어지지 않아 발생한 휴먼에러를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-004",
      "term": "기억검색 에러",
      "definition": "자신의 기억 속에서 특정 정보를 끄집어내지 못하여 발생한 휴먼에러를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-005",
      "term": "의사결정 에러",
      "definition": "상황에 맞는 판단을 하지 못하여 발생한 휴먼에러를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-006",
      "term": "공통행동조건",
      "definition": "운전원이 수행하는 일련의 행동에 영향을 미치는 영향요인들을 말한다. 행동형성요인과 비슷한 개념이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-007",
      "term": "인지기능",
      "definition": "인간이 자극을 감지하면서부터 대응행동을 할 때까지의 정보처리과정으로서 관찰, 해석, 계획, 실행의 4단계 기능을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-008",
      "term": "제어모드",
      "definition": "인간이 어떻게 행동을 구성하는가를 말하며, 긴급, 기회적, 전략적, 전술적으로 분류한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-009",
      "term": "인지에러",
      "definition": "인지과정 중에 발생한 휴먼에러를 말하며, 각각의 인지기능에는 몇 가지 잠재적인 유형을 가지고 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-010",
      "term": "휴먼에러확률",
      "definition": "주어진 직무나 행동이 수행되었을 때 휴먼에러가 발생할 확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-011",
      "term": "기본휴먼에러확률",
      "definition": "독립된 직무를 수행할 때의 휴먼에러확률, 즉 선행직무의 영향을 받지 않을 경우의 휴먼에러확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-012",
      "term": "인간행동의 성공확률",
      "definition": "휴먼에러확률의 보수, 즉 1 - HEP를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-013",
      "term": "인간신뢰도",
      "definition": "신뢰할 수 있거나 사용할 수 있는 시스템에 대하여 인간의 행동이 성공적으로 이루어질 확률을 말한다. 바꾸어 말하자면, 시스템의 신뢰도나 가용도를 훼손할만한 외적인 직무나 행동이 실행되지 않을 뿐만 아니라, 요구되는 시간 내에 시스템이 요구하는 인간행동, 직무, 또는 작업이 성공적으로 완수될 확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-014",
      "term": "인간신뢰도분석",
      "definition": "인간신뢰도가 추정되는 방법을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-015",
      "term": "행동형성요인",
      "definition": "인간 행동에 영향을 미치는 모든 요인들을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-016",
      "term": "직무",
      "definition": "시스템의 목적이나 기능을 달성하는 데 기여하는 행동의 단위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-X71-017",
      "term": "직무분석",
      "definition": "시스템 내에서 인적 구성요소에게 요구되는 구체적 행동을 결정하는 분석 과정, 인간과 장비에게 요구되는 상세한 행동, 환경적 조건의 영향이나 기능장애 또는 양쪽 모두에 영향을 미치는 예상치 못한 사건들의 영향을 결정하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
