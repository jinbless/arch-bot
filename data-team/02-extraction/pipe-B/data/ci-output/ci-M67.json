      ]
    },
    {
      "identifier": "CI-M67-045",
      "text": "누설, 마멸 그리고 파손된 부분이 있는지 살핀다.",
      "guideContext": "아크 용접 안전 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
