  "domainTerms": [
    {
      "identifier": "DT-M67-001",
      "term": "호흡용 보호구(Respirator)",
      "definition": "작업환경 중에 존재하는 가스, 증기, 미스트, 분진 등의 유해물질이 근로자의 체내에 들어가는 것을 방지하기 위해 사용되는 보호구의 총칭이다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "DT-M67-002",
      "term": "흄(Fume)",
      "definition": "고체물질의 증기가 응고되거나 또는 기체물질의 화학반응으로 생긴 미소한 고체입자로, 공기 중에 부유하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "DT-M67-003",
      "term": "전체환기(General ventilation)",
      "definition": "오염물질 발생지점 근처에서 바로 흡인해주는 국소배기방식과는 달리 작업장 전체를 대상으로 환기시키는 방식을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-006"
      ]
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M67-01",
      "processOrder": 1,
      "processName": "용접 전 준비",
      "safetyMeasures": "그리스와 표면 코팅을 제거한다. 작업자의 머리가 흄에 노출되지 않도록 작업 위치를 준비한다. 이동식 용접 후드를 용접점에서 덕트 지름 거리 내에 배치한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "용접 헬멧",
        "화염보호 작업복",
        "장갑"
      ],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "WP-M67-02",
      "processOrder": 2,
      "processName": "용접 작업 수행",
      "safetyMeasures": "작업 중 배기가 원활하게 이루어지는지 확인한다. 작업자는 공기 흐름 안에 서 있지 말고 부스의 옆쪽에 서 있어야 한다. 필요한 경우 호흡용 보호구를 사용하여야 한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "용접 헬멧",
        "화염보호 작업복",
        "장갑"
      ],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-CHEMICAL-025",
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "WP-M67-03",
      "processOrder": 3,
      "processName": "배기장치 일상 점검 및 유지보수",
      "safetyMeasures": "매일 덕트, 팬, 공기 필터에 손상 여부를 확인한다. 일주일에 한번 배기 시스템과 게이지 작동을 확인한다. 결함 장비는 즉시 보수한다. 14개월마다(비철금속은 6개월) 자격 있는 환기 기술자에게 철저하게 검사 및 성능 시험을 받는다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-CHEMICAL-016",
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "WP-M67-04",
      "processOrder": 4,
      "processName": "보호구 관리 및 점검",
      "safetyMeasures": "사용 전 호흡용 보호구의 작동상태를 점검한다. 공급업자 권장에 따라 필터를 교체하고 일회용은 1회 사용 후 폐기한다. 호흡용 보호구는 3개월마다 시험한다. 깨끗한 보호구와 오염된 보호구를 분리 보관한다. 옷의 분진 제거를 위해 압축 공기 사용은 절대 금지한다.",
      "requiredPPE": [
        "호흡용 보호구",
        "용접 헬멧",
        "화염보호 작업복",
        "장갑"
      ],
      "sourceSection": "5.3",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "WP-M67-05",
      "processOrder": 5,
      "processName": "작업장 청소 및 정리",
      "safetyMeasures": "작업장을 청결하게 하고 연소물질이 없도록 한다. 일주일에 한번 전체 작업장을 청소한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": [
        "SR-CHEMICAL-020"
      ]
    }
  ],
