  "checklistItems": [
    {
      "identifier": "CI-M67-001",
      "text": "관통 통풍(Through draught)을 통하여 시간당 5-10 회 공기를 바꾸는 전체환기를 실시하여야 한다.",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-M67-002",
      "text": "배기식 용접부스(Extracted welding booth), 배기식 작업대(Extracted workbench) 또는 이동식 포집후드(Movable capture hood)를 설치한다(그림 1-3 참조).",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-M67-003",
      "text": "용접부스 안으로 유입되는 공기의 유속은 1 ㎧에서 1.5 ㎧ 사이가 되어야 한다.",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-M67-004",
      "text": "배기식 용접 작업대 안으로의 공기 유입속도는 적어도 2 ㎧는 되어야 한다.",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-M67-005",
      "text": "흄을 제거하기 위해 적어도 1 ㎧의 공기 유속이 필요하고, 이동식 후드 덕트 안으로는 5 ㎧에서 10 ㎧ 사이의 공기 유속이 필요하다.",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-M67-006",
      "text": "배기가 되는 것을 확인하기 위해 마노미터, 압력계 또는 자동표시기(Telltale)를 사용한다.",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-M67-007",
      "text": "배출된 공기는 문과 창문에서 멀리 떨어진 건물 외부의 안전한 장소로 배출되어야 한다.",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-M67-008",
      "text": "배출된 공기를 대신하여 깨끗한 공기가 작업실로 공급되도록 하여야 한다.",
      "guideContext": "수동 금속 아크 용접 배기장치",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 설치·운영",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "CI-M67-009",
      "text": "먼저 그리스와 표면 코팅을 제거한다.",
      "guideContext": "수동 금속 아크 용접 작업절차",
      "additionalDetail": null,
      "workProcessPhase": "용접 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M67-010",
      "text": "작업자의 머리가 흄에 노출되지 않도록 작업을 준비한다.",
      "guideContext": "수동 금속 아크 용접 작업절차",
      "additionalDetail": null,
      "workProcessPhase": "용접 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-M67-011",
      "text": "작업 중에도 배기가 원활하게 이루어지는지 확인한다.",
      "guideContext": "수동 금속 아크 용접 작업절차",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 중",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-M67-012",
      "text": "이동식 용접 후드를 조정하여 상승하는 뜨거운 흄을 포집할 수 있도록 한다. 후드는 용접점에서부터 덕트 지름 거리 내에 있어야 한다.",
      "guideContext": "수동 금속 아크 용접 작업절차",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 중",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-M67-013",
      "text": "작업자는 공기 흐름 안에 서 있지 말고 부스의 옆쪽에 서 있어야 한다.",
      "guideContext": "수동 금속 아크 용접 작업절차",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 중",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M67-014",
      "text": "필요한 경우 작업자는 호흡용 보호구를 사용하여야 한다.",
      "guideContext": "수동 금속 아크 용접 작업절차",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 중",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M67-015",
      "text": "매뉴얼의 지시사항을 따른다. 장비는 효과적이고 효율적인 작업 순서에 따라 보관한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M67-016",
      "text": "결함이 있는 장비가 있으면 즉시 보수한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-M67-017",
      "text": "매일 덕트, 팬 그리고 공기 필터에 손상이 있는지 확인한다. 소음이나 진동이 있는 팬은 손상이 있을 가능성이 있다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-M67-018",
      "text": "적어도 일주일에 한번은 배기 시스템과 게이지가 올바르게 작동하는지 확인한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-M67-019",
      "text": "배기 장치의 성능이 제작자 사양에 명시된 만큼 발휘되는지 확인한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-M67-020",
      "text": "만약 성능에 관한 정보가 없으면 자격이 있는 환기 기술자를 고용하여 효과적인 배기에 요구되는 성능을 결정한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M67-021",
      "text": "기술자의 보고서는 반드시 목표 공기 배출률을 보여주어야 한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M67-022",
      "text": "시험 일지에 이 정보를 기록하고 유지한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-M67-023",
      "text": "적어도 14 개월마다 한 번씩, 비철금속인 경우 6 개월에 한 번씩 자격 있는 환기 기술자에게 배기 장치를 철저하게 검사하게 하고 그 성능을 시험하게 하여야 한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-M67-024",
      "text": "모든 검사와 시험기록들은 최소 5 년 동안 보관한다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-M67-025",
      "text": "기록을 검토한다. 파손의 유형은 어느 곳이 예방보전이 필요한지를 알려준다.",
      "guideContext": "수동 금속 아크 용접 배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "배기장치 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M67-026",
      "text": "깨끗한 보호구와 오염된 보호구를 위한 저장함을 제공한다.",
      "guideContext": "수동 금속 아크 용접 보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M67-027",
      "text": "필요하다면 관련 규정 및 지침에 따라 공기 라인 헬멧을 사용하거나 전동 필터 헬멧을 사용한다.",
      "guideContext": "수동 금속 아크 용접 호흡용 보호구",
      "additionalDetail": null,
      "workProcessPhase": "용접 작업 중",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M67-028",
      "text": "사용하기 전에 작업자가 호흡용 보호구의 적절한 작동상태를 점검하였는지 확인하여야 한다.",
      "guideContext": "수동 금속 아크 용접 호흡용 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M67-029",
      "text": "공급업자에게 추천받은 대로 호흡용 보호구 필터를 교체한다. 일회용은 한번 사용 후 폐기한다.",
      "guideContext": "수동 금속 아크 용접 호흡용 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M67-030",
      "text": "호흡용 보호구를 깨끗하게 유지하고, 분진이 없는 곳에 보관한다.",
      "guideContext": "수동 금속 아크 용접 호흡용 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M67-031",
      "text": "호흡용 보호구는 적어도 3 개월마다 한번은 시험한다.",
      "guideContext": "수동 금속 아크 용접 호흡용 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M67-032",
      "text": "작업자에게 용접 헬멧, 화염보호 작업복과 장갑을 제공하고, 사용하는지 확인한다.",
      "guideContext": "수동 금속 아크 용접 기타 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-M67-033",
      "text": "작업복의 세탁은 적절한 설비를 갖춘 계약 세탁소나 유사한 적절한 곳을 이용한다.",
      "guideContext": "수동 금속 아크 용접 기타 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-M67-034",
      "text": "주의 사항으로 옷의 분진을 제거하기 위하여 압축 공기를 사용하는 것은 절대 허용하지 않는다.",
      "guideContext": "수동 금속 아크 용접 기타 보호구",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-M67-035",
      "text": "건강 모니터링을 고려하여야 한다.",
      "guideContext": "수동 금속 아크 용접 기타 사항",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
