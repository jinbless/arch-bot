  "checklistItems": [
    {
      "identifier": "CI-H98-001",
      "text": "당뇨병을 진단받은 근로자에서 대형화물 및 여객 운송 업무, 항공 및 교통 관제업무, 경찰·소방관·응급환자 수송 업무, 교대근무·야간근무·일 12시간 이상의 장시간 근무, 고소작업·잠수작업, 고열작업, 장시간 연속 운전·장기 외항 선원, 광업 등 갱 내 작업 등은 업무적합성 평가 수행을 고려해야 한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리 (법령 근거 미확인)",
      "additionalDetail": "그 외 직업환경의학 전문의에 의해 업무적합성 평가가 필요하다고 인정되는 업무도 포함된다.",
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-002",
      "text": "당뇨병 치료전문가와의 상담을 통해 1일 섭취할 음식열량을 결정한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-003",
      "text": "단순당질보다는 복합당질을 섭취한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-004",
      "text": "채소, 통곡물 등을 통해 충분한 섬유소를 섭취한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-005",
      "text": "고혈압 예방을 위한 저염분 식사를 한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-006",
      "text": "주당 150분 이상의 유산소운동을 실시한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-007",
      "text": "운동은 주 4일 이상 실시하며 연속해서 이틀이상 중단하지 않는다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-008",
      "text": "인슐린이나 설폰요소제 등의 인슐린분비 촉진제를 사용하는 경우 운동전후 혈당을 측정하여 운동으로 인한 저혈당이 유발되지 않도록 주의한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-009",
      "text": "관상동맥질환, 망막병증 등 고강도 운동으로 인한 부작용이 우려되는 합병증을 동반한 경우 당뇨병 전문의에 운동처방을 의뢰한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-010",
      "text": "전문의 상담을 통해 자신이 사용하는 약물의 저혈당 유발 가능성을 확인하도록 한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-011",
      "text": "처방으로 결정된 용량을 사용하며 임의로 투여량을 늘리거나 줄이지 않는다. 약물용량 조절이 필요하다고 판단되는 경우는 당뇨병 전문의에 의뢰한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-012",
      "text": "투여일정을 최대한 지키도록 노력한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-013",
      "text": "항당뇨병 약물 외에 다른 약물을 병용해야 할 경우 약물상호작용의 문제에 대해 전문의에 상담을 의뢰한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-014",
      "text": "고혈압, 고지혈증은 당뇨병의 혈관합병증 발생 위험을 증가시키기 때문에 동반 관리가 필요하다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-015",
      "text": "흡연은 당뇨병 발생증가와 관련이 있으며 관상동맥질환 등 대혈관합병증을 현저히 증가시키므로 금연이 바람직하다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-016",
      "text": "장기간 영양섭취 부족 상태에서의 음주는 저혈당을 유발할 수 있으므로, 과도한 음주는 피하는 것이 좋다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-017",
      "text": "비만은 당뇨병 발생, 악화 및 치료지연 등과 밀접한 관련이 있기 때문에, 적절한 식사요법 및 운동 등을 통한 체중관리가 병행되어야 한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "근로자 자가 건강관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-018",
      "text": "근로자가 혈당을 측정하고, 저혈당 발생 시 음식을 섭취하며, 치료약물을 투여하는 등의 자가 관리를 할 수 있는 적절한 시간 및 공간을 제공한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": "특히 교대근무, 장시간 근무, 및 야간근무 등을 수행하는 근로자에게 해당한다.",
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-019",
      "text": "인슐린 치료를 받는 근로자는 병형 및 경과에 따라, 정해진 시각에 1일 4회 이상 약물을 투여해야하는 경우도 있기 때문에, 해당 근로자의 치료일정을 감안하여 작업일정을 조정한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-020",
      "text": "치료 및 음식섭취에 소요되는 시간을 고려하여 작업 중 휴식시간을 충분히 배정한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-021",
      "text": "근로자가 급성합병증의 증상을 보이는 경우에는 즉시 작업을 중단하고 필요한 치료를 시행할 수 있도록 돕는다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-022",
      "text": "치료에 필요한 장소는 사내 의무실 등을 활용할 수 있으며, 해당 장소에 약물, 관련 기구 및 음식물 등의 보관함, 냉장고, 치료 및 응급상황에 사용할 테이블, 침대 등을 비치한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-023",
      "text": "저혈당 등 응급상황에 대처할 수 있도록 혈당측정계 및 포도당 정제, 설탕, 초콜릿 등 당분이 포함된 음식, 음료 등을 비치한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-024",
      "text": "합병증에 의한 응급상황에 즉각적으로 대응하기 위해, 가능한 한 근로자를 2인 이상 배치하는 것이 좋다. 단독작업이 불가피할 경우, 정기적으로 근로자 확인이 가능한 환경을 제공한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-025",
      "text": "근로자를 대상으로 한 안전보건교육에 당뇨병 발병예방, 합병증예방, 응급상황대처 등에 관한 교육을 포함시킬 수 있다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "사업장 건강관리 환경 조성",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-026",
      "text": "당뇨병을 진단받은 근로자의 업무배치 및 업무전환은, 당뇨병의 유형, 치료방법, 합병증 유무, 업무특성 등을 고려한 근로자 개별평가가 먼저 이루어져야 하므로, 사업주 및 근로자가 임의로 결정하여서는 안 되며, 필요한 경우 직업환경의학 전문의에게 업무적합성 평가를 의뢰한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "업무적합성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-027",
      "text": "당뇨병을 진단받은 근로자에 발한, 창백, 불안, 정신혼란, 횡설수설, 전신쇠약, 시야곤란 등의 저혈당 증상이 나타나고 의식이 남아있어 음식을 삼킬 수 있는 경우에는, 당분이 포함된 음식(쥬스, 초콜릿 등)을 섭취하게 한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": null,
      "workProcessPhase": "응급상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-028",
      "text": "제1형 당뇨병 환자가 인슐린 치료를 수차례 거른 상태에서 갈증, 심한 전신 쇠약감, 구토, 복통, 빈맥, 과호흡, 과일 냄새나는 호흡 등을 동반하는 경우, 즉시 응급의료기관으로의 이송을 요청하고, 기다리는 동안 물을 충분히 마시게 하며 몸을 따뜻하게 한다.",
      "guideContext": "당뇨병을 진단받은 근로자에 대한 건강관리",
      "additionalDetail": "당뇨병케톤산증 의심 상황에 해당한다.",
      "workProcessPhase": "응급상황 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H98-029",
