  "domainTerms": [
    {
      "identifier": "DT-C98-001",
      "term": "가공 송전선로",
      "definition": "발전소에서 생산된 전기를 배전사업자에게 송전하는 선로로서 공중에 설치된 송전선로를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C98-002",
      "term": "철탑",
      "definition": "각철(Angle)이나 철주(지지가 1개인 강관주 포함)를 소재로 하여 높이 세운 구조물을 말한다. 주로 송전선의 지지물로 사용되는데, 그 형태는 선로의 송전전력·전압·지형 등에 따라 다르다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C98-003",
      "term": "헬기장(Heliport)",
      "definition": "회전익항공기(헬기)의 도착, 출발 또는 이동을 위해 사용되는 비행장 또는 구조물 위에 지정된 지역을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C98-004",
      "term": "하강장",
      "definition": "회전항공기가 지면 또는 구조물의 표면에 접지 또는 부양할 수 있는 구역인 헬기 전용 이·착류장을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C98-005",
      "term": "키락(Key Lock)방식 안전로프",
      "definition": "안전대에 부착한 Key-Lock본체에 미리 철탑위에 설치한 안전로프를 차례로 연결하여 이동 및 작업을 하는 방식으로, 이동 작업 간에 심리적인 실수에 의해 오 조작이 일어나더라도 항상 1개 이상의 안전로프로 근로자를 보호·지지 할 수 있는 떨어짐 재해방지용구를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-FALL-003"
      ]
    },
    {
      "identifier": "DT-C98-006",
      "term": "각입",
      "definition": "철탑의 기초작업에서 굴착 다음공정으로 네 곳의 기초에 콘크리트를 타설하기 전에 철탑의 앵커재 및 주각재 또는 주주재를 설치하는 공정을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
