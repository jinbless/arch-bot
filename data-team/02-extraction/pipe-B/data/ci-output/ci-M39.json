  "domainTerms": [
    {
      "identifier": "DT-M39-001",
      "term": "인간공학",
      "definition": "사람과 작업간의 \"적합성\"에 관한 과학을 말한다. 이는 사람을 최우선으로 놓고, 사람의 능력과 한계를 고려한다. 또한, 인간공학은 작업, 장비, 정보 및 환경이 각 작업자에 적합하도록 만드는 것을 추구한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M39-002",
      "term": "작업자",
      "definition": "기계의 설치, 운전, 조정, 보수, 청소, 수리 또는 운반 등의 주어진 업무를 수행하는 자를 총칭하여 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M39-003",
      "term": "작업장",
      "definition": "주어진 작업자에 대하여 작업 환경으로 둘러싸인 작업공간내의 작업장비들의 조합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M39-004",
      "term": "작업환경",
      "definition": "작업자의 작업 공간을 둘러싸고 있는 물리적, 화학적, 생물학적, 조직적, 사회적, 문화적 요인을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M39-005",
      "term": "장비",
      "definition": "조작을 하기 위해 사용되는 특정 장비, 장치, 공정 모듈을 말하며, '장비'라는 용어는 장비의 고장에 의해 손상된 제품(예. 기판, 반도체)에는 적용되지 않는다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M39-01",
      "processOrder": 1,
      "processName": "인간공학적 문제 파악",
      "safetyMeasures": "작업자들과 대화하고 그들의 견해를 구한다. 작업 시스템을 평가하여 자세, 불편함, 장비 적합성, 업무 환경 만족도, 에러 발생 빈도 등을 점검한다. 사고 보고서를 사용하여 사고의 세부 경위와 원인을 파악하고, 병가 및 작업자 이직률을 기록하고 검토한다.",
      "requiredPPE": [],
      "sourceSection": "5.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-M39-02",
      "processOrder": 2,
      "processName": "원인 파악 및 해결책 모색",
      "safetyMeasures": "가능한 원인을 파악하고 해결책을 모색한다. 높이 조절 의자 제공, 작업 공간 정리, 선반 배치 최적화, 제어 장치 접근성 개선, 교대 근무 패턴 조정, 순환 근무 도입 등의 방안을 검토한다. 작업자들을 프로세스 초기부터 참여시켜 아이디어를 구하고 가능한 해결책을 논의한다.",
      "requiredPPE": [],
      "sourceSection": "5.4",
      "relatedSR": null
    },
    {
      "identifier": "WP-M39-03",
      "processOrder": 3,
      "processName": "변경사항 평가 및 시행",
      "safetyMeasures": "변경 사항은 해당 업무를 하는 작업자의 평가를 거치도록 한다. 한 문제를 해결하기 위해 시행하는 변화가 다른 곳에서 문제를 야기하지 않도록 주의를 기울인다. 간단한 해결책을 구하지 못하거나 문제가 복잡하면 인간공학 전문가에게 자문을 구한다.",
