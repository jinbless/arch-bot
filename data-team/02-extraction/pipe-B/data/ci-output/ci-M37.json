  "checklistItems": [
    {
      "identifier": "CI-M37-001",
      "text": "소음 수준이 85 dB(A)을 넘어서는 경우 담당 인력에 의해 소음 평가가 행해져야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": "소음 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-002",
      "text": "합당하고 가능한 경우 소음을 줄이기 위한 조치가 취해져야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": "소음 노출 감소",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M37-003",
      "text": "작업자에게 청력 손상 위험에 대한 정보를 제공해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-002"
      ]
    },
    {
      "identifier": "CI-M37-004",
      "text": "특정 상황에서는 귀 보호 장비를 제공해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M37-005",
      "text": "작업자는 제공된 귀 보호장비를 사용하고, 결함이 있을시 보고해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M37-006",
      "text": "작업자의 일일 개인 노출 소음량이 85 dB(A) (최초 권장레벨) 이상, 또는 200 Pa 또는 그 이상의 음압(최고 권장레벨)에 이르는 경우 사업주는 소음 평가를 실시해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": "단기간 소음 노출이 매우 높은 수준일 경우 최고 권장레벨을 넘어설 가능성이 있으며, 일일 개인 노출 소음량이 85 dB(A)에 미치지 못하더라도 최고 권장 레벨을 초과할 수 있다.",
      "workProcessPhase": "소음 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-007",
      "text": "소음 평가에 대한 검토 및 수정보완이 평가가 더 이상 유효하지 않다고 의심되는 사유가 있거나 평가가 관련된 작업에 상당한 변동이 행해진 경우 필요하다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": "소음 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-008",
      "text": "소음 평가 담당자는 작업소음규정의 요건 및 세부 평가 지침을 숙지해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": "소음 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-009",
      "text": "외부 용역 업체를 사용하는 경우, 평가가 작업소음규정에 따라 행해져야 함을 서면으로 명시하는 것이 좋다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": "소음 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M37-010",
      "text": "소음 평가는 어떤 작업자가 과도한 소음에 노출되는지를 파악해야 하며, 소음 노출의 감소, 귀 보호, 귀 보호 구역의 표시, 작업자들에게 정보 제공 등 작업소음규정의 기타 요건에 따른 업체의 의무를 준수할 수 있도록 정보를 제공해 주어야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": "소음 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-001",
        "SR-NOISE-002"
      ]
    },
    {
      "identifier": "CI-M37-011",
      "text": "업체들은 소음 위험에 노출될 가능성이 높은 각 작업자들에게 적절한 정보와 지시 및 교육을 제공해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": "가능하면 소음 평가 내용을 해당 작업자들이 쉽게 이해할 수 있는 양식으로 제공하는 것이 바람직하다.",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-002"
      ]
    },
    {
      "identifier": "CI-M37-012",
      "text": "업체는 평가 자료를 기록으로 남겨서 보관해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": "평가 보고서에 평가 범위 및 실시 일자, 제정자를 명시해야 한다.",
      "workProcessPhase": "기록 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.6",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-013",
      "text": "담당 인력이 전체적인 평가를 제공할 수 없다면, 보고서에 이런 사실을 명시해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": "평가 당시에 어떤 기기 또는 프로세스가 작동하지 않아서, 소음 레벨이 더 높아질 가능성을 예상할 수 있다면 이런 사실도 기술한다.",
      "workProcessPhase": "기록 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.7",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-014",
      "text": "일일 개인 소음 노출이 90 dB(A) 이상인 모든 작업자들을 대상으로 정기적인 청력 검사를 실시하는 것이 바람직하다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": null,
      "workProcessPhase": "보건 감독",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.9",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-015",
      "text": "소음이 95 dB(A) 이상이라면 소음노출이 연간 수주에 그치는 등 일시적이지 않는 한, 업체는 작업자들에게 청력 검사를 실시해야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": "소음 노출이 90 dB(A)을 넘어서면 청력 손상 위험이 급격히 높아진다.",
      "workProcessPhase": "보건 감독",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.9",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M37-016",
      "text": "적절하다고 판단되는 경우, 업체는 보호 장비 제공 이외의 다른 수단으로 소음 노출을 줄여야 한다.",
      "guideContext": "작업장내 기계 소음평가",
      "additionalDetail": "소음 감소가 기술적으로 복잡하며, 잘못된 조치를 취할 경우 돈을 허비할 여지가 많기 때문에 전문가의 조언을 구하는 것이 필요하다.",
      "workProcessPhase": "소음 노출 감소",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.9",
      "basedOn": [
        "SR-NOISE-001"
      ]
    }
  ],
