  "checklistItems": [
    {
      "identifier": "CI-BE22-001",
      "text": "전선은 그 종류가 대단히 많을 뿐 아니라 종류에 따라 특성 차이가 있으므로, 설계나 사용 과정에서는 사용 목적에 적합한 것을 잘 선정하여야 한다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-ELECTRIC-003"
      ]
    },
    {
      "identifier": "CI-BE22-002",
      "text": "각각의 도체는 설계 자료와 일치하게 식별되어야 한다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE22-003",
      "text": "도체를 식별하기 위한 방법으로 색상을 사용할 때는 절연체에 색상이나 표시를 도체 전체에 입혀 주는 것이 바람직하다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정",
      "additionalDetail": "선택된 장소에 추가로 식별표시를 사용하는 것도 한 방법이다.",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BE22-004",
      "text": "녹색과 노린색은 녹색-노린색 조합선으로 혼동할 우려가 있는 곳에서는 안전상 사용해서는 안 된다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정",
      "additionalDetail": "보호접지도체(PE)의 녹색-노란색 조합선과의 혼동 방지 목적",
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-BE22-005",
      "text": "보호접지도체는 형태나 위치, 부호, 색을 통해 쉽게 구별할 수 있어야 하며, 색상만으로 식별해야 하는 경우, 녹색-노란색 조합선을 전체에 사용해야 한다. 이 색상은 접지도체에만 사용된다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-BE22-006",
      "text": "절연도체에 녹색-노란색 조합선을 할 경우 한 색상의 길이는 최소 15 ㎜로 그 비율은 30~70 %이어야 하며, 그 나머지 부분은 다른 색으로 하여야 한다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-BE22-007",
      "text": "형태나 위치, 구조만으로도 보호접지도체를 쉽게 식별할 수 있거나 절연도체에 쉽게 접속할 수 없는 경우, 도체 전체에 식별 목적으로 색을 표기하지 않을 수 있다. 단, 도체의 끝이나 접근 가능한 위치에 그래픽 기호 또는 녹색-노란색 조합선을 사용해서 분명하게 다른 도체들과 식별되도록 해야 한다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-BE22-008",
      "text": "기타 도체의 식별은 색이나 숫자, 문자와 숫자의 조합, 색과 숫자 또는 문자와 숫자를 조합하여 구별되도록 한다. 숫자를 사용하는 경우에는 아라비아 숫자, 문자를 사용할 경우에는 로마체를 사용하여야 한다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE22-009",
      "text": "각각의 전원도체에서 접지용 단자에는 보호접지(PE) 또는 ⊕로 표시하여야 한다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-BE22-010",
      "text": "3상4선식 전로의 2차측에서 전등 또는 이와 유사한 부하에 공급하는 1상의 중성점을 접지한 경우에 중성도체와의 사이에 부하를 접속하는 곳에는 그 상의 선도체를 다른 도체와 구별할 수 있도록 색별 배선을 하거나 색테이프를 감는 등의 방법을 사용하여야 한다.",
      "guideContext": "전선의 종류, 식별 등에 관한 기술지원규정 (법령 근거 미확인)",
      "additionalDetail": "선도체 전원의 색별표시: L1 갈색, L2 흑색, L3 회색, N 청색",
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-BE22-001",
      "term": "도체(Conductor)",
      "definition": "정해진 전류를 이송하기 위한 도전성 부분을 말하며, 절연성능에 따라 나도체, 절연도체 등으로 구분한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE22-002",
      "term": "중성도체(Neutral conductor)",
      "definition": "전기에너지를 배분하기 위하여 중성점에 전기적으로 접속된 도체(대표문자를 \"N\"이라고 하고 통상 중성선이라고 함)를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE22-003",
      "term": "선도체(Line conductor)",
      "definition": "전기에너지를 송전 또는 배전하기 위하여 정상적으로 공급되는 선로 중에 충전되는 중성도체 또는 중간도체가 아닌 도체(대표문자로 \"H\"로 표시하고 통상 전압선이라고 함)를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE22-004",
      "term": "접지(Ground)",
      "definition": "전기회로나 설비를 대지 또는 지중 도전성 물체 등과 전기적으로 접속한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-BE22-005",
      "term": "접지측 도체(Grounded conductor)",
      "definition": "의도적으로 접지시킨 설비나 전로의 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-BE22-006",
      "term": "접지도체(Grounding conductor)",
      "definition": "접지전극에 설비나 접지측 도체를 접속시키기 위한 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-BE22-007",
      "term": "보호 접지도체(Protective conductor, PE)",
      "definition": "노출된 도전성부분이나 주 접지 단자에 접속함으로 감전을 방지하기 위한 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-BE22-008",
      "term": "접지전극(Grounding electrode)",
      "definition": "피접지물을 대지와 전기적으로 접속하기 위하여 지중에 매설한 도체를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-BE22-009",
      "term": "등전위본딩(Equipotential bonding)",
      "definition": "등전위를 보증하기 위하여 인접부분 간을 전기적으로 접속한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "DT-BE22-010",
      "term": "노출 도전부(Exposed conductive part)",
      "definition": "접촉우려가 있는 전기기기의 도전성 부분으로 정상상태에서는 충전되지 않으나 기능절연이 고장 날 경우에 충전되는 부위를 말한다. 다만, 노출 도전부와의 접촉에 의해서 충전부가 되는 전기기기의 도전부는 그 자체를 노출 도전부로 보지 않는다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "DT-BE22-011",
      "term": "기타 도전부(Extraneous conductive part)",
      "definition": "국소대지의 전위를 갖기 쉬운 전기기기의 일부가 아닌 기타의 도전부를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
