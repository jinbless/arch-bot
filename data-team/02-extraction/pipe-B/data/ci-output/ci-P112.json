  "checklistItems": [
    {
      "identifier": "CI-P112-001",
      "text": "마그네슘을 보관하는 건물은 불연성 구조로써 누수가 없고, 환기와 통풍이 좋아야 하며, 건물 내부는 건조하고 기온이 비정상적으로 상승하지 아니 하는 조건이어야 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 저장",
      "additionalDetail": null,
      "workProcessPhase": "저장",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-002",
      "text": "보관 건물은 다른 가연물로부터 떨어져 있어야 하며, 인접물에 화재가 발생하는 경우에도 연소 확대가 일어나지 않도록 공간 통로를 확보하여 2차 재해를 예방할 수 있도록 하여야 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 저장",
      "additionalDetail": null,
      "workProcessPhase": "저장",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-003",
      "text": "재활용하기 위한 마그네슘 파편 등은 부식이나 손상이 없는 금속용기에 넣어 물과의 접촉을 방지하도록 한다. 또한, 금속용기 내에 기름이 묻은 천이나 수분 등이 혼입되어 자연발화가 일어나지 않도록 주의한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 저장",
      "additionalDetail": null,
      "workProcessPhase": "저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-004",
      "text": "재활용 예정인 마그네슘 파편은 가급적 빨리 재생 처리하고, 다량으로 보관하지 않도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 저장",
      "additionalDetail": null,
      "workProcessPhase": "저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-005",
      "text": "기계적 가공이나 연마 등으로 발생된 마그네슘은 매일 처리하는 것을 원칙으로 하되, 부득이 보관하여야 하는 경우에는 건조 상태에서 습기와의 접촉을 차단하고, 뚜껑이 달린 철재 용기를 사용하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 저장",
      "additionalDetail": null,
      "workProcessPhase": "저장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-006",
      "text": "용해 작업장은 불연 내화구조로 하고 통풍이 잘 되도록 하여야 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-P112-007",
      "text": "우천 시 누수가 없도록 안전점검을 통하여 확인하도록 한다. 공장 천장에 결로가 발생하면 용해 용기에 물이 낙하하여 폭발하는 경우가 있으므로 유의한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-008",
      "text": "마그네슘 파편 등을 이용하는 용해공장에서는 흡습성이 강한 염화마그네슘을 주성분으로 하고 있는 플럭스의 흄(Fume)에 의해 철골, 기계류, 전기 설비가 부식될 수 있기 때문에 일상 점검을 통하여 정기적으로 청소를 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-P112-009",
      "text": "용해 설비 주변에는 미끄럼 방지를 한 주철관이나 강판, 불연성 재료를 깔고 수분과 격리되도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": "용해로 주변에 일반 콘크리트를 사용하는 경우에는 콘크리트에 습기를 포함하는 경우가 있기 때문에 마그네슘 용탕이 콘크리트에 흘러 접촉되면 마그네슘의 연소열로 콘크리트 표면이 박리되면서 연소하고 있는 마그네슘과 함께 부유되어 주변 가연물로 인화될 수 있다.",
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-010",
      "text": "용해 작업장에는 불의의 재해에 대비하여 피난 통로를 확보하고, 소화대책을 위한 용해용 플럭스, 건조 모래, 철관 및 방화복 등을 상시 비치한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-011",
      "text": "용해 공장에서 사용되는 전기설비, 조명은 완전 밀폐된 내압 방폭구조의 제품이어야 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P112-012",
      "text": "전원 박스는 용해로에서 떨어진 곳에 설치하며, 내식성 재료인 스테인레스 강을 사용하고, 누전차단기 설치 보다는 가급적 접지를 하는 것이 좋다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-P112-013",
      "text": "용해 공장에서 사용하는 크레인은 정기점검을 통하여 체인, 후크 등이 부식되지 않도록 하여야 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업장",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-P112-014",
      "text": "용해로를 사용하는 경우, 도가니 로와 같은 반사로는 사용하지 않도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-015",
      "text": "용해로는 도가니에서 용탕이 누설된 경우에 대비하여 로가 설치된 바닥에 경사를 만들고 용탕 유출구로 흘러나오도록 한다. 유출구에서 흘러나온 용탕은 누출 받이 용기로 유입시켜 안전하게 응고시키도록 하며, 누출받이 용기는 반드시 설치하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P112-016",
      "text": "누출받이의 용량은, 초기 소화에 여유를 갖게 하고, 로 내의 용탕 누출에 의한 화재사고를 최소한으로 하기 위하여 가급적 큰 용량으로 한다. 만일 누출받이 용기 내에 습기나 수분이 있는 경우 수증기폭발에 의한 화재와 같이 큰 사고로 이어질 수 있으므로 상시 건조한 상태로 유지되도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-017",
      "text": "로의 하부 근방에는 도가니에서 결리된 산화철 스케일을 제거하기 위한 전용구를 설치하여 정기적으로 청소를 실시한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-018",
      "text": "용탕온도의 안전관리를 위하여 온도조절장치를 설치한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-P112-019",
      "text": "로의 연료, 공기 공급라인은 로의 근접 위치에서 조절할 수 있게 하고, 비상 사태를 대비하여 원격 조작이 가능하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-P112-020",
      "text": "로의 가열원(연료)이 가스 또는 중유인 경우에는 로의 국부 손상을 방지하기 위하여 화염이 직접 로에 접촉하지 않도록 하고, 화염을 가하는 부위가 고정되지 않도록 일정 주기로 로를 회전시켜 사용 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-021",
      "text": "용해용 도가니의 재질로는 주강재 또는 보일러용 압연강재를 용접하여 사용한다. 주철재 및 흑연 도가니는 크랙 발생으로 인한 재해 위험성이 있으므로 사용하지 않도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-P112-022",
      "text": "산화 스케일의 발생 방지를 위하여 내열 규격의 용융 알루미늄 피복을 하여야 하나, 결정 미세화에 지르코늄을 첨가하는 합금계의 용해 도가니의 내면은 용융 알루미늄 피복 후에 알루미늄 및 화합물층을 가성소다 수용액을 사용하여 제거한 다음에 사용 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-P112-023",
      "text": "용해로 내에서의 테르밋 반응에 의한 재해방지를 위하여 가급적 1일 1회 이상 로 내부의 산화 스케일을 제거하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-024",
      "text": "용접 도가니는 내압용기와 같은 용접기준으로 제작하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-025",
      "text": "마그네슘 용해작업 시의 중대재해를 방지하기 위하여 <표 1>과 같은 안전관리 기준을 설정하여 로의 관리를 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": "도가니 제작기준, 사용 및 검사 기준, 보수기준, 폐기기준 설정 포함",
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-026",
      "text": "습기가 강한 플럭스는 마그네슘 용해 공장에서 많이 사용하기 때문에 건물 기둥이나 벽에 부착한 플럭스가 습기를 흡수하여 도전성을 가지게 되고 전기 배선의 절연성이 저하하여 감전 위험성이 있다. 그러므로 용해정련용 교반기, 메탈 펌프 등의 동력은 에어 모터를 사용한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 설비",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    },
    {
      "identifier": "CI-P112-027",
      "text": "마그네슘이 대기 중에서 용해되면 공기 중의 수분, 산소와 반응하여 용탕 수면에서 산화 연소한다. 또한, 질소와 반응하여 질화마그네슘을 형성하므로 이를 방지하기 위한 플럭스나 불활성 분위기가스(이산화탄소 단독 또는 공기-이산화탄소 혼합가스 중에 불화유황가스 0.1~0.4 vol%를 혼합) 중에서 용해한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-028",
      "text": "육불화유황가스(SF6)의 이용 시에는 농도가 너무 높거나 희석가스와의 혼합상태가 나쁘면 조업온도 하에서 로 및 로의 뚜껑 등 강철재 장치의 침식이 촉진되므로 가스혼합기를 사용하여 항상 균일한 농도의 가스가 공급되도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-029",
      "text": "플럭스는 염화마그네슘이 주성분이므로 흡습성이 매우 높으므로 밀폐 보관한다. 흡습한 플럭스는 용탕 성상을 나쁘게 하며, 용탕과 접촉 시에 금속을 비산시키는 원인이 되므로 재해로 이어질 수 있다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-030",
      "text": "주괴(鑄塊, Ingot)를 용탕 중의 재료로 장입하는 경우에는 저장시의 습기를 제거하기 위하여 150 ℃ 이상으로 충분히 예열하여 건조상태로 한 후, 용탕에 넣어 서서히 용해시킨다. 건조 불충분한 상태에서 용탕 속에 장입하면 수분에 의한 큰 폭발로 이어질 수 있다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-031",
      "text": "부식이 생긴 주괴는 사용하기 전에 350 ℃ 이상의 가열을 통하여, 수산화마그네슘을 산화마그네슘과 물로 분해시켜 수분을 제거한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-032",
      "text": "용탕 속에 장입하기 위하여 사용하는 용해 기구에는 흡습성이 높은 플럭스가 남아있는 경우가 많기 때문에 보관 중에 수분을 포함할 수 있다. 이러한 수분은 용해 기구의 건조가 불충분하여 발생하며, 재해 빈도가 높기 때문에 수분 제거를 위해서는 용해 온도 정도의 가열이 필요하다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-033",
      "text": "용탕에 넣어 사용하는 치공구서 파이프 형상의 것은 내부에 물이 고일 수 있기 때문에 충분히 건조 후 사용함으로써 수증기 분출에 의한 화상 재해를 예방할 수 있다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P112-034",
      "text": "용해, 주조 작업장에서는 보안경, 면제품의 두꺼운 작업복, 안전화 및 안전모 등 보호구를 착용한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 용해 작업",
      "additionalDetail": null,
      "workProcessPhase": "용해 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P112-035",
      "text": "마그네슘 주조 작업장은 불연성의 건물로 하고, 바닥 면은 물이 고이거나 습한 상태가 되지 않도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 주조 작업장",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-036",
      "text": "작업장은 물 빠짐이 좋고, 완전히 건조한 상태가 되게 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 주조 작업장",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-037",
      "text": "주조 작업장에 가연물을 두어서는 아니 되며, 작업장 내에는 가스나 흄이 체류하기 쉬우므로 통기성이 좋도록 설계할 필요가 있다.",
      "guideContext": "마그네슘 분진폭발 예방 – 주조 작업장",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.3.1",
      "basedOn": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "CI-P112-038",
      "text": "작업자는 용탕의 비산에 대비하여 면제품의 작업복, 장갑, 안전화 등을 착용한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 주조 작업장",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P112-039",
      "text": "사형 주조 시에는 유황 및 붕산을 가하고, 용탕과 주형이 접촉하였을 때에 반응하여 연소가 일어나지 않도록 한다. 또한, 주형 내부에 수분이 많으면 연소하기 쉬우므로 토치 등을 사용하여 표면을 건조시켜 사용한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 사형 주조",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-040",
      "text": "도가니 로에서는 완전히 건조한 뜨개용 용기(ladle)로 용탕을 퍼내어 주조하며 용기로 용탕을 퍼내는 작업 및 주형에 주입 하는 경우에 위험성이 가장 높다. 이중 용탕 뜨개용 용기는 충분히 건조시켜도 수분이 남아 있는 경우가 많으므로, 처음 용탕을 퍼내는 경우에는 서서히 하여 용탕의 비산을 방지하고, 반드시 안전을 확인하여야 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 사형 주조",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P112-041",
      "text": "용탕 주입 시 도가니 및 뜨개용 용기(ladle)에서 유출하는 용탕은 공기와 접촉하여 산화과정을 일으키므로, 반드시 유황분의 비산, SO2가스 또는 SF6 + CO2 혼합 가스의 분위기에서 용탕 주입 작업을 실시하여 화재를 방지한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 사형 주조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-042",
      "text": "주조 시에 가장 많이 발생하는 재해는 용탕이 상하 주형 면의 맞닿는 면(분리면)에서 유출되어 바닥에 흐르고, 바닥 면이 습한 경우에 용탕이 비산하여 작업자가 재해를 입는 경우이다. 그러므로 바닥면의 건조를 유지하고, 주형 주변에 건조 모래를 깐 후 주형 작업을 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 사형 주조",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-043",
      "text": "금형주조는 지지 로에 용탕을 보온하여 두고, 뜨개용 용기로 용탕을 퍼내어 금형에 주입하는데, 수냉식을 이용한 금형의 냉각이 필요한 경우에는 주형 내의 물의 유출 및 주형의 플럭스 등에 충분히 유의한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 금형 주조",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-044",
      "text": "지지 로에서는 도가니 바닥에 Al-Mn-Fe-Mg 금속화합물이 쌓이면 열전도를 현저히 저하시켜 과열의 원인이 되므로, 도가니 바닥의 수명 저하 및 안전성을 고려하여 도가니 바닥의 정기적인 제거 작업이 필요하다.",
      "guideContext": "마그네슘 분진폭발 예방 – 금형 주조",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-045",
      "text": "금형주조 작업자가 대량의 용탕을 취급하는 경우, 입고 벗기 쉬운 방재복, 장갑, 발 보호구 등을 착용한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 금형 주조",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.3.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-030"
      ]
    },
    {
      "identifier": "CI-P112-046",
      "text": "이형제의 2차 분사에 의하여 공극 내에 남아있는 수분과 마그네슘이 공극 내에서 반응하여 폭발할 수 있으므로, 화염 분출방향에서 작업을 하지 않는다.",
      "guideContext": "마그네슘 분진폭발 예방 – 다이캐스팅",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-047",
      "text": "쇼트 슬리브 내의 결로 발생에 의한 수분과 마그네슘의 폭발 위험성을 예방하기 위하여 작업 전에 충분히 쇼트 슬리브를 가열해 줄 필요가 있다.",
      "guideContext": "마그네슘 분진폭발 예방 – 다이캐스팅",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-048",
      "text": "다이캐스트 장치의 비산 방지 벽에는 마그네슘 분진이 부착되기 쉽고, 발화 위험성이 있으므로 정기적 청소가 요구된다.",
      "guideContext": "마그네슘 분진폭발 예방 – 다이캐스팅",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3.4",
      "basedOn": [
        "SR-DUST-003"
      ]
    },
    {
      "identifier": "CI-P112-049",
      "text": "열간 챔버식 다이캐스트 장비의 익스텐션 노즐 하부는 항상 가스 화염으로 가열되기 때문에 주형 체결 시에 커다란 굽힘 응력이 반복되어 균열이 발생하기 쉽고, 마그네슘 용탕이 누설되는 경우가 자주 있으므로 주의가 필요하다. 이를 방지하기 위하여 용탕 비산 방지 벽을 설치하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 다이캐스팅",
      "additionalDetail": null,
      "workProcessPhase": "주조 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-050",
      "text": "마그네슘 합금은 절삭 시에 발화 위험성이 있으므로, 이를 방지하기 위하여 절삭유를 사용한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-051",
      "text": "마그네슘 합금 작업장의 건물은 불연성의 구조로 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-052",
      "text": "작업장 바닥은 콘크리트 또는 미끄럼 방지를 한 철판 재질을 사용하고, 미세분진이 바닥에 쌓이지 않도록 주기적인 청소를 실시한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-DUST-003"
      ]
    },
    {
      "identifier": "CI-P112-053",
      "text": "작업장 바닥은 항상 건조한 상태를 유지한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-054",
      "text": "예기치 못한 화재 시 피해를 최소화하기 위하여, 가공 기계는 격벽으로 1대씩 분리하는 것이 바람직하다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-055",
      "text": "작업장에는 발화원이 될 수 있는 요인을 제거하고, 화기 사용을 금지한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-P112-056",
      "text": "가연성 물질은 작업장에 놓아두지 않는다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-057",
      "text": "가공기계는 가급적 마그네슘 이외의 다른 재료와 병행하여 사용하지 않는다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-058",
      "text": "작업장에는 재해 발생 시를 대비하여, 건조 모래, 흑연 분말 및 폐기물을 담는 금속 용기 등을 항상 비치한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-059",
      "text": "절삭작업이 끝나면 공구를 재료에서 분리시킨다. 재료에 공구가 접촉되어 있으면 분진이 발생하여 마찰열도 증가하기 때문이다. 또한, 절삭 도중에 회전을 갑자기 정지시키지 않도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-060",
      "text": "절삭 가공은 건조 절삭이 일반적이지만 절삭유를 사용하는 경우에는 불수용성 절삭유를 사용한다. 수용성 절삭유를 사용한 미분 폐기물은 폭발위험성이 있다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-061",
      "text": "절삭 가공에서 발생한 분진은 강철재 용기에 넣어 작업장에서 멀리 떨어진 용기 창고 등에 보관한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-062",
      "text": "절삭 및 연마 가공 시 발생하는 미분말 폐기물을 모으기 위한 일반 진공 청소기 사용은 발화 위험성이 있으므로 사용하지 않도록 하며, 방폭형 진공 청소기로 바꾸도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-ELECTRIC-011"
      ]
    },
    {
      "identifier": "CI-P112-063",
      "text": "만일, 미분말 폐기물이 발화한 경우 건조 모래, 용해용 플럭스 및 흑연분말 등으로 신속하게 소화한다. 건조 모래 등으로 덮어 외관상 불이 꺼진 것처럼 보여도 그 내부는 계속 연소하고 있기 때문에 삽 등을 사용하여 조금씩 제거한 후, 안전한 장소에서 완전 연소 시킨다.",
      "guideContext": "마그네슘 분진폭발 예방 – 기계가공",
      "additionalDetail": "마그네슘 화재 시 물, 이산화탄소, 할론계 소화제 사용 금지",
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-064",
      "text": "미분말 폐기물을 보관하는 건물은 불연성 구조로 하고, 다른 가연물과 함께 보관하지 않는다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-065",
      "text": "보관 장소는 빗물이 스며들지 않도록 하고, 습기가 발생하지 않도록 통풍이 잘 되게 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-066",
      "text": "미분말 폐기물은 뚜껑이 달린 금속용기나 불연성 용기에 넣어 자연 발화하는 경우에도 건물이나 다른 가연물에 옮겨 붙지 않도록 안전한 장소에 보관한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-067",
      "text": "습식 가공에 사용되는 절삭유에는 불수용성 유(광물유)와 수용성 유(유화유)가 있으며, 모두 수분이나 기름을 포함하고 있기 때문에 건식 가공된 미분말 폐기물과 혼합하지 않도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-068",
      "text": "불수용성유 미분말 폐기물과 수용성유 미분말 폐기물은 혼합되지 않도록 하고, 별도의 용기에 저장한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-069",
      "text": "수용성 및 0.2 % 이상의 지방산을 함유하는 물이나 기름에 젖어 있는 미분말 폐기물은 수소가스를 발생시키기 때문에 신속하게 폐기처리 한다. 부득이 보관하여야 하는 경우에는 용기 뚜껑에 작은 구멍을 만들어 발생한 수소가스가 방출될 수 있도록 하고, 통풍이 잘 되는 장소에 보관한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-070",
      "text": "습식 집진기에서 회수된 미분말 폐기물은 적은 양의 수분을 포함하고 있기 때문에 보관 중 물과 반응하여 수소가스를 발생하고, 물 속에 침강되지 않은 경우에는 반응열로 자연발화 할 위험성이 높으므로 신속히 폐기 처리하거나 충분한 물을 보충하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-013"
      ]
    },
    {
      "identifier": "CI-P112-071",
      "text": "마그네슘 전용의 연삭기를 사용하며, 알루미늄 연삭기와 겸용하지 않는다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "기계가공 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P112-072",
      "text": "수분 또는 수용성유(유화유)가 부착된 미분말 폐기물이 착화되면 폭발적인 연소를 일으키므로 소화가 거의 불가능하기 때문에 신속히 대피하도록 한다.",
      "guideContext": "마그네슘 분진폭발 예방 – 폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6",
      "basedOn": [
        "SR-CHEMICAL-014"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P112-001",
      "term": "분진",
      "definition": "대기 중에 쉽게 퍼지거나 떠다니는 미세한 크기의 가연성 고체 입자 또는 섬유를 의미한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "DT-P112-002",
      "term": "분진운",
      "definition": "분진의 형성 조건에 따른 구분으로 대기 또는 기체 중에 퍼지거나 떠다니고 있는 분진-기체 혼합기를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "DT-P112-003",
      "term": "퇴적분진",
      "definition": "분진이 바닥에 퇴적되어 있는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-DUST-003"
      ]
    },
    {
      "identifier": "DT-P112-004",
      "term": "분진폭발",
      "definition": "폭발범위 내의 분진운에 일정 크기의 착화원이 가해져 분진이 공기 중의 산소와 반응하여 연소반응대를 형성하고, 분진운 속을 화염이 전파함으로써 압력이 발생하는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-DUST-001"
      ]
    },
    {
      "identifier": "DT-P112-005",
      "term": "최소산소농도",
      "definition": "분진운 또는 퇴적분위기의 공기 중에 불활성가스를 첨가하여 그 양을 증가시키면 산소농도가 감소됨에 따라 폭발화재가 일어나지 않는 한계가 존재하는데 이 상태에서의 산소농도를 의미한다. 최소산소농도는 이론적으로 구할 수 없기 때문에 실험에 의해 측정하고 있으며, 분진 및 불활성 기체의 종류에 의존하는 것으로 온도와 압력 상승에 따라 낮아진다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P112-006",
      "term": "착화원",
      "definition": "가연물을 착화시키기 위하여 외부로부터 가해지는 에너지원이 되는 물질이나 현상을 말하며, 분진운의 폭발이나 퇴적분체의 화재를 유발하는 요인이 된다. 착화원에는 화염, 고온 고체표면, 고온기체, 불꽃방전, 자연발화 및 정전기 등이 있다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-P112-007",
      "term": "화염전파속도",
      "definition": "분진운 내 공간 또는 퇴적분진의 상층부를 분진 화염이 이동하는 속도를 말한다. 일반적으로 화염전파속도는 분진화염이 전파하는 공간을 구성하는 구조물에 대한 화염의 이동속도를 의미하기 때문에 화염면의 전방에 존재하는 분진 입자군의 이동속도와 분진의 연소속도의 합이 화염전파속도가 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P112-008",
      "term": "폭굉",
      "definition": "연소가 매우 빠르게 진행하여 발생하는 화염전파속도가 미 반응 매질 속을 공기 중의 음속보다 큰 속도로 이동하는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
