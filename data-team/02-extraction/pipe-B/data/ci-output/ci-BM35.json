  "domainTerms": [
    {
      "identifier": "DT-BM35-001",
      "term": "팔레트(Pallet)",
      "definition": "팔레트 트럭, 지게차 및 관련 장비에 적합하도록 최소 높이를 갖는 건고한 수평대이며 상품, 화물의 집하, 겹쌓기, 보관, 하역, 수송을 위한 기초로서 사용되는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM35-002",
      "term": "팔레트 트럭(Pallet truck)",
      "definition": "포크암 말단 주변에 직럴 건인 바퀴를 장착한 차체 구조 외부로 확장되는 두 개의 포크암을 장착한 산업용 트럭을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM35-003",
      "term": "2방향 차입식 팔레트(Two-way pallet)",
      "definition": "마주하는 2방향에만 지게차, 팔레트 트럭의 포크암을 차입구에 넣을 수 있는 팔레트를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM35-004",
      "term": "4방향 차입식 팔레트(Four-way pallet)",
      "definition": "전체 4방향에서 지게차, 팔레트 트럭의 포크암을 차입구에 넣을 수 있는 팔레트를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM35-005",
      "term": "밑면 창문형 팔레트(Perimeter-base pallet)",
      "definition": "하부 날개 적재판 외곽의 4각 테두리 내에 하나 내지 두 개의 중앙관으로 구성된 팔레트를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM35-006",
      "term": "반침목(Stringer)",
      "definition": "상부 적재판과 밑면 판 또는 상부 적재판 밑에 위치한 세로 방향으로 연속된 판으로서 팔레트 트럭의 포크나 지게차의 포크가 차입될 수 있는 공간을 제공하는 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM35-007",
      "term": "반침판(Stringer board)",
      "definition": "적재판과 반침을 연결하는 수평적인 판을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM35-008",
      "term": "반침(Block)",
      "definition": "팔레트 트럭이나 지게차의 포크가 차입될 수 있는 공간을 제공하기 위해서 상부와 하부판 사이나 또는 상부 적재판의 밑부분에 접하여 있는 짧은 지주(주로, 직사각형이나 원형)를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BM35-01",
      "processOrder": 1,
      "processName": "팔레트 선정 및 설계 검토",
      "safetyMeasures": "적재물의 종류, 중량, 하중 분포 방식을 파악하고 사용 환경(고온, 저온, 다습, 화학공장)을 고려하여 적합한 팔레트를 선정해야 한다. 팔레트 이동 방식(팔레트 트럭, 지게차, 크레인, 컨베이어)과 2방향/4방향 차입 요구사항을 확인해야 한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM35-02",
      "processOrder": 2,
      "processName": "팔레트 적재 작업",
      "safetyMeasures": "정격하중 내에서 미리 정해진 방식으로 적재하고, 하중은 점차적으로 적용하여 팔레트 전체에 최대한 균일하게 분포시킨다. 적재물 높이는 팔레트 바닥 길이 중 가장 긴 변을 초과하지 않도록 한다. 블록 적재 시 옆면 및 후면에 적절한 간격을 확보한다. 최대 적재 높이는 하단 팔레트의 가장 짧은 변의 6배를 넘지 않아야 한다.",
      "requiredPPE": [
        "안전화"
      ],
      "sourceSection": "7",
      "relatedSR": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "WP-BM35-03",
      "processOrder": 3,
      "processName": "팔레트 운반 작업",
      "safetyMeasures": "취급 장비의 포크길이는 팔레트 길이의 최소 75%까지 연장되어야 한다. 마스트는 수직 상태를 유지하고, 포크는 팔레트에 정확히 직각으로 진입해야 한다. 포크 간격은 최대 지지력이 가해지도록 조절한다. 팔레트를 바닥에 끌거나 밀어서는 안 되며, 포크 리프트 트럭과 함께 작업 발판으로 사용해서는 절대 안 된다.",
      "requiredPPE": [
        "안전화",
        "안전모"
      ],
      "sourceSection": "8",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM35-04",
      "processOrder": 4,
      "processName": "팔레트 검사",
      "safetyMeasures": "모든 팔레트는 사용할 때마다 점검하여 안정성과 사용 적합성을 확인한다. 재질별(목재, 플라스틱, 압축 목재, 골판지, 금속) 검사 기준에 따라 균열, 변형, 부식, 손상 여부를 점검한다. 손상된 팔레트는 명확하게 표시하고 분리 보관한다.",
      "requiredPPE": [],
      "sourceSection": "9",
      "relatedSR": null
    },
    {
      "identifier": "WP-BM35-05",
      "processOrder": 5,
      "processName": "팔레트 수리 및 폐기",
      "safetyMeasures": "수리는 제조자, 지정된 대행인, 전문 팔레트 수리자 재활용자에 의해서만 이루어져야 한다. 이것이 불가능한 경우 제조자와 협의된 과정에 따라 수리한다. 수리 불가능한 팔레트는 폐기 처리한다.",
      "requiredPPE": [],
      "sourceSection": "8",
      "relatedSR": null
    }
  ],
