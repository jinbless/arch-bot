  "checklistItems": [
    {
      "identifier": "CI-BM35-001",
      "text": "사업주는 지게차에 의한 하역운반작업에 사용하는 팔레트(pallet) 또는 스키드(skid)는 적재하려는 화물의 중량에 따른 충분한 강도를 가질 것",
      "guideContext": "팔레트 안전",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제182조 제1호",
      "workProcessPhase": "팔레트 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-002",
      "text": "사업주는 지게차에 의한 하역운반작업에 사용하는 팔레트(pallet) 또는 스키드(skid)는 심한 손상변형 또는 부식이 없을 것",
      "guideContext": "팔레트 안전",
      "additionalDetail": "산업안전보건기준에 관한 규칙 제182조 제2호",
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-003",
      "text": "팔레트는 팔레트의 정격하중 내에서 최대 안정성(Stability)과 안전성(Safety)을 확보하도록 미리 정해진 방식으로 적재해야 하며, 반드시 허용 하중 내에서 사용하여야 한다.",
      "guideContext": "팔레트 적재물 안전성",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-004",
      "text": "적재물은 천천히 적재하여야 하며(하중은 점차적으로 적용해야 하며) 팔레트가 특정 하중을 적재하기 위해 특별히 설계되지 않았다면 가급적 팔레트 전체에 최대한 균일하게 하중을 분포시키도록 해야 한다.",
      "guideContext": "팔레트 적재물 안전성",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-005",
      "text": "일반적으로 적재물의 높이는 팔레트 바닥 길이 중 가장 긴 변을 초과해서는 안된다.",
      "guideContext": "팔레트 적재물 높이",
      "additionalDetail": "수축 포장(Shrink wrap)이나 스트레치 포장(Stretch wrap) 사용 시 가장 긴 변보다 높은 적재물도 안전하게 옮길 수 있다.",
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-006",
      "text": "플라스틱 팔레트는 표면이 매우 미끄럽기 때문에 운송 중 적재물이 미끄러지지 않게 추가적인 고정 장치를 사용해야 하며, 빈 플라스틱 팔레트들은 역시 단단히 쌓아서 안정성을 확보해야 한다.",
      "guideContext": "플라스틱 팔레트 운영 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-007",
      "text": "지게차로 플라스틱 팔레트를 운반할 때는 미끄러짐이나 지게차의 불안정성을 각별히 주의해야 한다.",
      "guideContext": "플라스틱 팔레트 운영 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-008",
      "text": "여러 층의 팔레트 적재물을 직접 쌓아 올릴 경우 바닥과 그 위에 놓인 직전 팔레트 적재물 상부가 모두 평탄해야 하고 건고한 반침대를 설치해야 한다.",
      "guideContext": "팔레트 적재물 안전성",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-009",
      "text": "적재물의 안정성은 적재물의 종류와 모양 그리고 습도 및 온도 조건에 따라 달라지므로 적재물은 정기적으로 점검해야 한다.",
      "guideContext": "안전한 적재 높이 결정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-010",
      "text": "제조업자와 사전에 충분히 협의하지 않은 상태에서는 지나치게 높게 적재해서는 안 되며, 최대 적재 높이는 하단 팔레트의 가장 짧은 변의 6배를 넘지 않아야 한다.",
      "guideContext": "안전한 적재 높이 결정",
      "additionalDetail": "블록 적재 방식과 적재물의 압축 특성을 충분히 평가하고 팔레트 자체가 필요한 적재 높이를 견딜 수 있도록 설계된 경우에 한함",
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-011",
      "text": "적재된 팔레트는 해당 랙 유형에 적합하게 설계되고 제작된 경우가 아니라면, 랙에 보관해서는 안 된다.",
      "guideContext": "압축 위험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-012",
      "text": "보관 및 회수 창고에서 사용하는 경우 높은 가속력 및 감속력으로 인해 팔레트 지지대에 발생할 수 있는 추가적인 동적 응력을 반드시 평가해야 한다.",
      "guideContext": "압축 위험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-013",
      "text": "취급 레이아웃(Layout)은 좁은 모서리, 부적절하게 배치된 문, 기둥 및 벽 그리고 고르지 않은 바닥, 경사도의 변화 등을 고려하여야 한다.",
      "guideContext": "취급 레이아웃",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM35-014",
      "text": "랙 구역에서는 일방통행 시스템과 보행자용 안전 가드레일을 설치하는 것을 고려해야 한다.",
      "guideContext": "취급 레이아웃",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 보관",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-BM35-015",
      "text": "팔레트를 블록 형태로 적재할 때는 각 적재물의 옆면 및 후면에 적절한 간격을 확보하여야 한다.",
      "guideContext": "취급 레이아웃",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-016",
      "text": "팔레트 손상검사 및 불량품 분리를 위한 선별 절차를 체계적으로 수립하여야 한다. 특히 팔레트의 구조적으로 중요한 부분들에 특별히 주의를 해야 한다.",
      "guideContext": "취급 레이아웃 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-017",
      "text": "작업자에게 안전한 작업 방법에 관한 교육을 실시하여야 한다.",
      "guideContext": "취급 레이아웃 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-018",
      "text": "팔레트는 사용자가 손상 여부를 검사해야 한다. 팔레트에 허용되지 않는 손상이 발견될 때, 즉 팔레트의 구조적 건전성에 영향을 주는 손상이 발견되면 그 팔레트는 사용해서는 안 된다.",
      "guideContext": "팔레트 사용과 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-BM35-019",
      "text": "손상된 팔레트는 명확하게 표시하고, 분리 보관 한 후 수리하거나 폐기하여야 한다. 수리가 가능한 경우는 제조자, 지정된 대행인, 전문 팔레트 수리자 재활용자에 의해서만 수리가 이루어져야 한다. 이것이 불가능한 경우 제조자와 협의된 과정에 따라 수리가 이뤄져야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 수리/폐기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-020",
      "text": "모든 팔레트는 사용할 때마다 점검하여 안정성과 사용 적합성을 확인해야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-021",
      "text": "운송 목적으로 제작된 일회용 팔레트(한 번만 사용하도록 설계된 팔레트)의 경우, 그 용도가 명확하게 표시되어야 하며 재사용 시에는 특별히 주의하여야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 선정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-022",
      "text": "빈 팔레트는 취급 시 조심스럽게 다루어야 하며 바닥에 끌거나 던지지 않아야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-023",
      "text": "상부와 하부 날개 적재판(Deck board) 사이에 손수레의 쐐기를 억지로 끼워 넣어 팔레트를 취급해서는 안 된다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-024",
      "text": "팔레트에 화물을 고정하기 위해 끈을 사용할 때는 과도한 장력을 주거나 끈의 위치가 올바르지 않으면 손상될 수 있으니 주의하여야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-025",
      "text": "팔레트 대치(Truck)를 사용하는 경우 소형 핑거 휠(Finger wheel)이 베이스 보드(Base board)를 손상시키지 않도록 주의하여야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-026",
      "text": "크레인을 이용해 팔레트를 취급할 경우 반드시 적합한 포크 부착장치(Fork attachments)를 사용하여 들어올려야 한다. 단 날개형 팔레트(Wing pallet)의 경우에는 스프레더(Spreader)가 장착된 바 슬링(Bar slings)을 사용해야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-027",
      "text": "팔레트를 컨베이어로 운반할 때는 컨베이어 롤리 간격이 팔레트 바닥지지대의 길이보다 짧아야 하고 걸림으로 인한 손상이 발생하지 않도록 하여야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-028",
      "text": "취급 장비의 포크길이는 포크 방향과 평행한 팔레트 길이의 최소 75%까지 연장되어야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-029",
      "text": "포크 트럭 운전자는 올바른 팔레트 취급 방법에 대한 교육을 받아야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-030",
      "text": "팔레트에 진입하거나 빠져나올 때 마스트는 수직 상태를 유지해야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-031",
      "text": "포크의 간격은 들어 올릴 때 팔레트에 최대 지지력이 가해지도록 조절해야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-032",
      "text": "팔레트는 포크의 뒷꿈치 부분에 넣도록 놓아야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-033",
      "text": "포크는 팔레트에 정확히 직각으로 진입해야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-034",
      "text": "팔레트를 바닥에 끌거나 밀면서 이동하거나 팔레트 한쪽 모서리를 밀어 직각으로 맞춰서는 안 된다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-035",
      "text": "화물을 팔레트 위에 적재할 때는 조심스럽게 놓아야 하고 아래 쌓인 물품을 손상시키지 않도록 하여야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 적재",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-036",
      "text": "팔레트는 포크 리프트 트럭과 함께 작업 발판으로 사용해서는 절대 안 된다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-037",
      "text": "보관 및 회수 기계 내에서 팔레트를 들어 올릴 때는 베이스 보드의 구조적 건전성에 특히 주의해야 한다. 포크나 플래튼으로 아래에서 팔레트를 들어 올릴 경우 포크와 평행한 길이 기준으로 팔레트 전체 길이(100%)를 지지해야 한다.",
      "guideContext": "팔레트 사용과 유지보수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 운반",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-038",
      "text": "4방향 밑면 창문형 팔레트(Four Way perimeter-base pallet)에서 모든 바닥판은 각 모서리 부분에 두 개 이상의 못으로 고정되어 있어야 하며, 이 못은 적절한 길이와 직경을 가지고 있고, 가장자리로부터 충분한 이격 거리를 확보하여야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-039",
      "text": "반침판(stringer board)은 건전한 목재로 제작되어야 하며, 옹이가 과도하게 많아서는 안된다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-040",
      "text": "반침판은 구매 사양서에 명시된 두께와 동일하여야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-041",
      "text": "날개 적재판, 반침판 그리고 바닥판이 구매 사양서의 요구사항에 따라 두께와 너비를 충족하여야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-042",
      "text": "날개 적재판이 건전한 목재로 제작되어야 하며, 옹이가 과도하게 많지 않아야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-043",
      "text": "바닥면이 고정된 끝부분에서 갈라짐이나 파손이 없어야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-044",
      "text": "손상된 반침목이나 반침이 없어야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-045",
      "text": "돌출된 못이나 바닥면을 관통하는 못이 없어야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-046",
      "text": "구성목재 중에 가장자리 균열(Edge split)이 없어야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-047",
      "text": "팔레트의 이음 부위가 느슨하여 들어짐이나 변형(Diamonding)이 발생해서는 안된다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-048",
      "text": "팔레트는 청결해야 하고 오염이 없어야 한다.",
      "guideContext": "목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.1",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-049",
      "text": "상관이 과도한 열, 냉기 또는 화학물질 누출로 인한 손상이 없어야 한다.",
      "guideContext": "플라스틱 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": "차가운 온도에서 사용하거나 거칠게 취급될 경우 취성 파괴(Brittle fracture)가 발생하기 쉬우므로 균열이나 기타 기계적 손상이 없는지 반드시 확인해야 한다.",
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-050",
      "text": "상관 또는 바닥에 결함이 없어야 한다.",
      "guideContext": "플라스틱 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-051",
      "text": "바닥 지지대가 마모, 균열 또는 영구적으로 변형되지 않아야 한다.",
      "guideContext": "플라스틱 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-052",
      "text": "만약 가운데 지지대가 비어 있는 경우, 손상이 없어야 한다.",
      "guideContext": "플라스틱 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-053",
      "text": "자외선(태양광)으로 인한 성능저하가 없어야 한다. 만약 팔레트가 변색된 경우, 사용 가능 여부를 제조업체에 문의해야 한다. 팔레트 표면에 흰색의 먼지같은 침전물이 나타나지 않아야 한다. 이러한 현상이 있으면 사용을 중단해야 한다.",
      "guideContext": "플라스틱 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-054",
      "text": "사용 중인 팔레트가 영구적으로 변형되지 않아야 한다.",
      "guideContext": "플라스틱 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.2",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-055",
      "text": "팔레트에는 균열, 박리 또는 마모가 없어야 한다.",
      "guideContext": "압축 목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-056",
      "text": "국부적인 부풀음(팽창)이나 수포의 형태로 보이는 수분 흡수 흔적이 없어야 한다.",
      "guideContext": "압축 목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-057",
      "text": "팔레트는 과도한 열, 냉기 또는 화학물질 누출로 인한 손상이 없어야 한다.",
      "guideContext": "압축 목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-058",
      "text": "만약 바닥 지지대가 비어 있는 경우 손상이 없어야 하고 배수구(있는 경우)가 막힘 없이 깨끗하게 유지되어야 한다.",
      "guideContext": "압축 목재 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.3",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-059",
      "text": "팔레트가 움푹 들어간 부분이 없어야 한다.",
      "guideContext": "골판지 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-060",
      "text": "상관이 과도한 열 또는 냉기 그리고 화학물질 누출로 인해 손상되지 않아야 한다.",
      "guideContext": "골판지 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-061",
      "text": "팔레트가 습기로 인한 손상이 없어야 한다.",
      "guideContext": "골판지 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-062",
      "text": "바닥 또는 상관에 결함이 없어야 한다.",
      "guideContext": "골판지 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-063",
      "text": "바닥 지지대가 마모, 찢어짐, 균열 또는 영구적인 변형이 없어야 한다.",
      "guideContext": "골판지 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-064",
      "text": "바닥 지지대가 비어 있는 경우 손상이 없어야 한다.",
      "guideContext": "골판지 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-065",
      "text": "팔레트의 강성이 손상되지 않아야 한다.",
      "guideContext": "골판지 팔레트 검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "팔레트 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "9.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BM35-066",
      "text": "느슨한 이음새가 보이지 않아야 한다.",
