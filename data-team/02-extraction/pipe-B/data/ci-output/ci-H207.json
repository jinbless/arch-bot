  "checklistItems": [
    {
      "identifier": "CI-H207-001",
      "text": "납에 노출되는 근로자에 대한 특수건강진단 주기는 1년에 1회 이상으로 한다.",
      "guideContext": "납 노출 근로자 건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-002",
      "text": "당해 건강진단 직전의 작업환경 측정결과 납 농도가 노출기준 이상인 경우, 납에 의한 직업병 유소견자가 발견된 경우, 또는 건강진단 결과 납에 대한 특수건강진단 실시주기를 단축하여야 한다는 의사의 관정을 받은 근로자가 있는 경우 당해 공정에서 노출되는 모든 근로자에 대하여 특수건강진단 기본주기를 그 다음 회에 한하여 1/2로 단축한다.",
      "guideContext": "납 노출 근로자 건강진단 주기 단축 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-003",
      "text": "배치전건강진단 후 첫 번째 특수건강진단은 6개월 이내에 해당 근로자에 대하여 실시하되, 배치전건강진단 실시 후 6개월 이내에 사업장의 특수건강진단이 실시될 예정이면 그것으로 대신할 수 있다.",
      "guideContext": "납 노출 근로자 건강진단 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "건강진단 실시",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-004",
      "text": "건강관리 구분의 C₁ 또는 D₁ 해당자를 대상으로 의사의 판단에 의한 추적 검사를 실시한다.",
      "guideContext": "납 노출 사후관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사후관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-005",
      "text": "건강관리 구분의 D₁ 해당자 중 직업병 확인이 필요한 경우에는 특수건강진단 기관의 의사가 산재요양신청서를 대신 작성할 수 있다.",
      "guideContext": "납 노출 사후관리",
      "additionalDetail": null,
      "workProcessPhase": "사후관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-006",
      "text": "혈중 납 농도가 30 μg/dL 이상일 때에는 연속하여 2회 이상 혈중 납 농도가 30 μg/dL 미만이 될 때까지 2개월 마다 추적검사를 실시한다.",
      "guideContext": "납 노출 사후관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사후관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-007",
      "text": "납 노출을 줄이기 위한 호흡기 보호구, 보호의, 보안경 지급 및 보관에 관한 관리수준을 평가한다.",
      "guideContext": "혈중 납 관리수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "관리수준 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.3",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H207-008",
      "text": "손 씻기 및 에어샤워, 샤워시설, 작업자 별로 분리된 2개의 개인사물함, 격리된 취식구역 등 세척 및 위생시설 수준을 평가한다.",
      "guideContext": "혈중 납 관리수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "관리수준 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.3",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H207-009",
      "text": "작업장, 휴게실, 식당 등의 청소 방법, 주기 등에 관한 위생관리 수준을 평가한다.",
      "guideContext": "혈중 납 관리수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "관리수준 평가",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H207-010",
      "text": "금연, 식이, 운동 등 혈중 납 배출을 촉진하는 생활습관의 실천 여부를 평가한다.",
      "guideContext": "혈중 납 관리수준 평가 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관리수준 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-011",
      "text": "혈중 납 관리수준 평가지표를 납 노출 사업장 근로자, 보건 관리자, 관리자, 사업주가 작성한다.",
      "guideContext": "혈중 납 관리수준 평가지표 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관리수준 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-012",
      "text": "평가점수를 계산하고 혈중 납 관리수준을 평가한다.",
      "guideContext": "혈중 납 관리수준 평가지표 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "관리수준 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-013",
      "text": "혈중 납 관리 실천계획서를 작성하게 한다.",
      "guideContext": "혈중 납 관리수준 평가지표 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개선계획 수립",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-014",
      "text": "1개월, 2개월, 3개월, 6개월, 1년 경과 후, 작성한 개선계획의 시행여부를 확인하고, 보호구 및 위생시설 지원수준, 개인위생, 식이관리 수준을 재평가 한다.",
      "guideContext": "혈중 납 관리수준 평가지표 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개선계획 이행 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-015",
      "text": "혈중 납 관리를 위해 작성된 개선계획의 수, 실천율, 특수건강검진 결과 혈중 납 농도 변화 등 가시적 변화를 확인하고 피드백을 실시한다.",
      "guideContext": "혈중 납 관리수준 평가지표 활용 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "개선계획 이행 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H207-016",
      "text": "납을 취급하는 근로자는 1급 방진 마스크를 사용하고, 사용한 방진 마스크는 지정된 밀폐된 장소에 보관하고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": "부적절한 보관으로 오염된 방진마스크의 사용은 납의 지속적인 호흡기 흡입을 유발한다.",
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H207-017",
      "text": "납을 취급하는 근로자는 작업복 또는 보호의를 착용해야 한다. 평상복과 구분되는 작업복 또는 보호의가 지급되고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H207-018",
      "text": "작업자 별로 분리된 개인 사물함을 2개 (작업복과 평상복 보관함) 제공하고, 하나는 출퇴근 시 입는 옷과 신발을 넣고, 다른 하나는 작업현장에서 입는 옷과 신발을 넣어, 납 오염을 방지하고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "위생시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H207-019",
      "text": "작업복은 회사에서 주 1회 이상 세탁해서 제공하고, 작업복을 집에 가져가지 못하게 하고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": "가정에서 납 노출 작업복과 평상복을 함께 세탁 시 가정 내 납 오염을 유발한다.",
      "workProcessPhase": "위생시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H207-020",
      "text": "납 분진, 흄이 흩날리는 업무가 있는 경우에는 보안경을 지급하고 착용해야 한다. 보안경이 지급되고 착용하고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H207-021",
      "text": "취식이 가능한 구역은 반드시 지정되어야 하고, 음식과 음료수를 보관하는 곳은 오염 없이 청결하게 유지되고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "위생시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H207-022",
      "text": "세면, 목욕, 세탁을 위한 시설을 설치하고 필요한 용품 및 용구를 비치하고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "위생시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H207-023",
      "text": "납을 취급하는 근로자가 작업을 종료한 경우에는 에어샤워 및 샤워시설 등을 이용하여 작업복에 퇴적된 납의 분진을 완전히 제거하고 손, 얼굴 및 신체를 씻거나 목욕을 반드시 시행하게 하는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "개인위생 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-H207-024",
      "text": "실내 작업장, 휴게실 또는 식당 등은 납 분진으로 인한 오염을 제거하기 위하여 매일 진공청소기로 청소하고, 물로 세척하고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": "바닥에 쌓인 납 분진이 날려서 호흡기로 흡입되지 않게 하는 것이 중요하다. 실내 공기 중의 분진 형태로 흡입 및 섭취를 통하여 인체 내로 흡수되며 호흡기(30~85%)나 소화기(10~15%)를 통한 흡수가 주요 경로이다.",
      "workProcessPhase": "위생관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-H207-025",
      "text": "납을 취급하는 작업장의 보기 쉬운 장소에 납이 인체에 미치는 영향, 납의 취급상 주의사항, 착용하여야 할 보호구, 응급조치 및 긴급 방재요령을 게시하고 있는가?",
      "guideContext": "보호구 및 위생시설 지원수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "유해물질 정보 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "예시 1",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-H207-026",
      "text": "작업 현장 내 취식과 흡연은 절대로 금지하고, 주의 표지판을 보기 쉬운 장소에 게시하고 있는가?",
      "guideContext": "개인위생 관리수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "개인위생 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "예시 2",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-H207-027",
      "text": "마스크 착용 전 상태를 확인하는가?",
      "guideContext": "개인위생 관리수준 평가",
      "additionalDetail": "파손, 밸브 유무 및 청결상태 등을 확인한다.",
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "예시 2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H207-028",
      "text": "마스크는 작업종료 후 매일 점검하고, 밀폐된 전용 보관함에 보관·관리 한다.",
      "guideContext": "개인위생 관리수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "예시 2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H207-029",
      "text": "휴식/ 흡연, 식사 이동시 매번 마스크를 필히 착용하고 이동하는가?",
      "guideContext": "개인위생 관리수준 평가",
      "additionalDetail": null,
      "workProcessPhase": "보호구 착용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "예시 2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-H207-030",
