  "domainTerms": [
    {
      "identifier": "DT-H207-001",
      "term": "생물학적 노출기준",
      "definition": "일주일에 40시간 작업하는 근로자가 고용노동부고시에서 제시하는 작업환경 노출기준에 노출될 때 혈액 및 소변 중에서 검출되는 생물학적 노출지표물질의 값이다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H207-01",
      "processOrder": 1,
      "processName": "특수건강진단 실시",
      "safetyMeasures": "납 노출 근로자에 대해 1년에 1회 이상 특수건강진단을 실시하고, 노출기준 초과 또는 유소견자 발견 시 주기를 1/2로 단축한다. 배치전건강진단 후 6개월 이내에 첫 번째 특수건강진단을 실시한다.",
      "requiredPPE": [],
      "sourceSection": "4.1",
      "relatedSR": null
    },
    {
      "identifier": "WP-H207-02",
      "processOrder": 2,
      "processName": "건강관리 구분 판정",
      "safetyMeasures": "C₁ 판정: 혈중 납 농도 30 μg/dL 이상이거나 임상검사 결과 이상 징후가 있고 납 노출에 의한 것으로 추정되는 경우. D₁ 판정: 혈중 납 농도 40 μg/dL 이상이거나 신경장해, 위장관장해, 빈혈, 신장장해 등이 있고 납 노출에 의한 것으로 추정되는 경우.",
      "requiredPPE": [],
      "sourceSection": "4.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-H207-03",
      "processOrder": 3,
      "processName": "사후관리 및 추적검사",
      "safetyMeasures": "C₁ 또는 D₁ 해당자를 대상으로 의사 판단에 의한 추적 검사를 실시한다. 혈중 납 농도 30 μg/dL 이상 시 연속 2회 이상 30 μg/dL 미만이 될 때까지 2개월마다 추적검사를 실시한다.",
      "requiredPPE": [],
      "sourceSection": "4.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-H207-04",
      "processOrder": 4,
      "processName": "혈중 납 관리수준 평가",
      "safetyMeasures": "보호구 및 위생시설 지원수준, 세척 및 위생시설 수준, 위생관리 수준, 생활습관 실천 여부를 평가한다. 평가지표를 근로자, 보건관리자, 관리자, 사업주가 작성하고 평가점수를 계산한다.",
      "requiredPPE": [
        "1급 방진 마스크",
        "보호의",
        "보안경"
      ],
      "sourceSection": "4.4.3",
      "relatedSR": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "WP-H207-05",
      "processOrder": 5,
      "processName": "개선계획 수립 및 이행 확인",
      "safetyMeasures": "혈중 납 관리 실천계획서를 작성하고, 1개월·2개월·3개월·6개월·1년 경과 후 개선계획 시행여부를 확인한다. 개선계획의 수, 실천율, 혈중 납 농도 변화 등 가시적 변화를 확인하고 피드백을 실시한다.",
      "requiredPPE": [],
      "sourceSection": "4.4.4",
      "relatedSR": null
    }
