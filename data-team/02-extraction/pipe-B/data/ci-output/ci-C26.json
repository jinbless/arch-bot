  "checklistItems": [
    {
      "identifier": "CI-C26-001",
      "text": "낙하물 방지망은 한국산업표준(KS F 8083) 또는 고용노동부고시 \"방호장치 안전인증 고시\"에서 정하는 기준에 적합한 것을 사용하여야 한다.",
      "guideContext": "낙하물 방지망 구조 및 재료",
      "additionalDetail": null,
      "workProcessPhase": "자재 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-002",
      "text": "그물코의 크기는 2cm 이하로 하여야 한다.",
      "guideContext": "낙하물 방지망 구조 및 재료",
      "additionalDetail": null,
      "workProcessPhase": "자재 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-003",
      "text": "방망사, 테두리 로프, 재봉사의 재료는 나일론, 폴리에스텔 등의 합성섬유를 사용한다. 다만, 그물코가 작아 합성섬유로 된 테두리로프를 사용하기 곤란한 경우에는 와이어로프로 할 수 있다.",
      "guideContext": "낙하물 방지망 구조 및 재료",
      "additionalDetail": null,
      "workProcessPhase": "자재 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-004",
      "text": "낙하물 방지망의 설치간격은 매 10 m 이내로 하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-005",
      "text": "첫 단의 설치 높이는 근로자를 낙하물에 의한 위험으로부터 방호할 수 있도록 가능한 낮은 위치에 설치하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": "설치간격 매 10m 이내 규정의 단서 조항",
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-006",
      "text": "낙하물 방지망이 수평면과 이루는 각도는 20°~30° 로 하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-007",
      "text": "낙하물 방지망의 내민 길이는 비계 외측으로부터 수평거리 2.0 m 이상으로 하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-008",
      "text": "방망의 가장자리는 테두리 로프를 그물코를 통과하는 방법으로 방망과 결합시키고 로프와 방망을 재봉사 등으로 묶어 고정하여야 한다. 단, 테두리 로프의 지름이 그물코보다 큰 경우 로프와 방망을 재봉사 등으로 묶어 고정하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-009",
      "text": "방망을 지지하는 긴결재의 강도는 15 kN 이상의 인장력에 견딜 수 있는 로프 등을 사용하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-010",
      "text": "낙하물 방지망과 구조물 사이의 간격은 낙하물에 위한 위험이 없는 간격으로 설치하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-011",
      "text": "방망의 겹침 폭은 30 cm 이상으로 테두리로프로 결속하여 방망과 방망 사이의 틈이 없도록 하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-012",
      "text": "근로자, 통행인 등의 왕래가 빈번한 장소인 경우 최하단의 방망은 크기가 작은 못· 볼트· 콘크리트 부스러기 등의 낙하물이 떨어지지 못하도록 방망의 그물코 크기가 0.3 cm 이하인 망을 설치하여야 한다. 다만, 낙하물 방호선반을 설치하였을 경우에는 그러하지 아니한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": "왕래 빈번 장소 최하단 방망 강화 기준",
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-013",
      "text": "매다는 지지재의 간격은 3 m 이상으로 하되 방망의 수평투영면의 폭이 전체 구간에 걸쳐 2 m 이상 유지되도록 조치하여야 한다.",
      "guideContext": "낙하물 방지망 설치",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-C26-014",
      "text": "낙하물 방지망은 설치 후 3 개월 이내마다 정기점검을 실시하여야 한다. 다만, 낙하물이 발생하였거나 유해환경에 노출되어 방망이 손상된 경우에는 즉시 교체 또는 보수하여야 한다.",
      "guideContext": "낙하물 방지망 관리기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정기점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-C26-015",
      "text": "낙하물 방지망 주변에서 용접이나 컷팅 작업을 할 때, 용접불티 비산방지덮개, 용접방화포 등 불꽃, 불티 등 비산방지조치를 실시하고 작업이 끝나면 방망의 손상여부를 점검하여야 한다.",
      "guideContext": "낙하물 방지망 관리기준",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C26-016",
      "text": "방망에 적치되어 있는 낙하물 등은 즉시 제거하여야 한다.",
      "guideContext": "낙하물 방지망 관리기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "유지관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-C26-017",
      "text": "건축물(비계) 바깥쪽에 방망을 설치 또는 해체하는 경우 가급적 건축물(비계) 안쪽에서만 작업이 이루어지도록 하여야 한다. 다만, 불가피하게 바깥쪽으로 나가서 설치 및 해체 작업을 해야 하는 특정구간의 경우에는 고소작업대 사용 또는 안전대 착용 등 적절한 추락 방지조치를 하여야 한다.",
      "guideContext": "낙하물 방지망 관리기준",
      "additionalDetail": null,
      "workProcessPhase": "방지망 설치·해체",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-FALL-003"
      ]
    },
    {
      "identifier": "CI-C26-018",
      "text": "낙하물 방지망을 설치하기 전에 다음의 표시 사항을 확인하여야 한다. (가) 제조자명 또는 그 약호 (나) 제조 연월 (다) 안전인증번호",
      "guideContext": "낙하물 방지망 관리기준 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "설치 전 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
