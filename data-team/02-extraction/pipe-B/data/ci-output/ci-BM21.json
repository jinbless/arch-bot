  "domainTerms": [
    {
      "identifier": "DT-BM21-001",
      "term": "가연성 분진",
      "definition": "지름 420 μm 이하(40 mesh 표준체 통과)의 미세한 분말상의 물질로 적절한 비율로 공기와 혼합될 때 점화원에 의해 발화될 수 있는 분진을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-BM21-002",
      "term": "분진폭발 압력방산구",
      "definition": "분진폭발로 인한 압력 상승시 분진 및 연소물을 설비외부로 분출시키기 위하여 설치하는 문, 창문, 패널 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "DT-BM21-003",
      "term": "저장설비",
      "definition": "분상·입상의 저장물을 저장할 수 있는 사일로(Silo), 호피(Hopper), 빈(Bins), 벙커(Bunker)를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM21-004",
      "term": "빈 게이트",
      "definition": "저장설비의 하단에 설치되어 저장물의 흐름을 제어하는, 즉, 저장물을 내보내거나 차단하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM21-005",
      "term": "공압 이송",
      "definition": "압축 공기를 사용해 저장물을 특정 장소로 이동시키는 시스템을 말한다. 트럭에서 사일로 등의 저장설비로 이송관로를 통해 운송하는 과정에 사용되며, 가압 이송 방식(Pressure conveying)과 진공 이송 방식(Vacuum conveying)의 방법이 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM21-006",
      "term": "가압이송",
      "definition": "압축 공기를 사용해 컴프레서 또는 블로어에 의해 물질을 파이프라인이나 호스의 경로를 따라 이동시키는 공압이송 시스템의 이송 방식을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BM21-007",
      "term": "진공이송",
      "definition": "압축 공기를 사용해 컴프레서 또는 블로어가 후단에 배치되어 물질을 빨아들여 이동시키는 공압이송 시스템의 이송 방식을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-BM21-01",
      "processOrder": 1,
      "processName": "설계 및 제작",
      "safetyMeasures": "하중조건(자중, 저장물, 과부하 운전 등), 기후, 지형조건을 고려한 안정도 확보. 차량-구조물 간 안전거리 유지 설계. 가연성 분진 화재·폭발 예방 안전조치. 폐쇄형 설비의 잠금장치·압력유지장치·공기정화장치·분진폭발 압력방산구 설치. 개방형 설비의 추락방지 설비 설치. 공압 이송 시스템의 내압·내진공 강도 확보.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": [
        "SR-ELECTRIC-024"
      ]
    },
    {
      "identifier": "WP-BM21-02",
      "processOrder": 2,
      "processName": "장치 및 설비 설치",
      "safetyMeasures": "자동 적재 정지 장치 설치. 가스·분진·위험혼합물에 대한 국소배기장치, 접근금지 조치, 보호구 지급. 폭발위험장소 설정 및 방폭형 전기기계기구 설치. 정전기 화재·폭발 예방 조치. 추락·매몰 방지를 위한 인터록 시건장치, 윈치 설치. 안전거리 확보를 위한 볼라드, 도로경계석 설치.",
      "requiredPPE": [
        "보호의",
        "호흡용보호구"
      ],
      "sourceSection": "6",
      "relatedSR": [
