  "checklistItems": [
    {
      "identifier": "CI-P116-001",
      "text": "해당 경보가 작동하였을 때의 대응절차를 문서로 명확하게 작성하고, 운전자를 훈련시켜야 한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": "안전계장시스템에 포함되는 경보시스템의 관리 요건",
      "workProcessPhase": "경보시스템 운영 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-002",
      "text": "해당 경보는 다른 경보와 구별이 가능하고, 우선순위를 가져야 하며, 경보가 작동되는 동안 계속 운전자가 관찰할 수 있어야 한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": "안전계장시스템에 포함되는 경보시스템의 관리 요건",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-003",
      "text": "정상 운전 중 근로자가 충분히 인지하고 조치할 수 있는 경보의 발생비율은 10분 동안 1개를 초과하지 않는 것이 바람직하다.",
      "guideContext": "경보시스템의 효율적 관리",
      "additionalDetail": "적정한 경보 발생비율 기준 (정상 운전 시)",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-004",
      "text": "비상상황인 경우, 근로자가 충분히 인지하고 조치할 수 있는 경보의 발생비율은 정상조건을 벗어난 처음 10분 동안 10개를 초과하지 않는 것이 바람직하다.",
      "guideContext": "경보시스템의 효율적 관리",
      "additionalDetail": "적정한 경보 발생비율 기준 (비상상황 시)",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-005",
      "text": "비상상황에서 오랫동안 울리는 경보나 오작동으로 인한 경보가 발생하지 않도록 설계한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": "경보의 선정 시 불필요한 경보 방지 설계 원칙",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-006",
      "text": "근로자가 상주하는 지역이 아닌 곳에 경보를 설치할 필요가 있을 경우, 근로자가 상주하는 인근 지역에 해당 경보를 반복할 수 있는 장치(Repeater)를 설치하는 것이 바람직하다.",
      "guideContext": "경보시스템의 효율적 관리",
      "additionalDetail": null,
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-007",
      "text": "반드시 필요한 경보를 선정하였다면 근로자가 후속조치를 하지 못할 경우 예측되는 사고피해결과를 토대로 하여 우선순위를 결정한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-008",
      "text": "경보의 우선순위는 대략 3단계로 구분하는 것이 바람직하며, 가장 중요한 경보는 전체 경보 중 약 5%, 중간 단계의 경보는 약 15%를 선정하는 것이 바람직하다.",
      "guideContext": "경보시스템의 효율적 관리",
      "additionalDetail": "경보 우선순위 3단계 구분 및 비율 기준",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-009",
      "text": "경보는 주변의 일상적인 소음보다 약 10 dB 정도 높은 소리를 갖도록 하고, 경보가 울린 후 근로자가 소리를 줄일 수 있도록 하는 것이 바람직하다.",
      "guideContext": "경보시스템의 효율적 관리",
      "additionalDetail": "경보 음량 설정 기준",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-010",
      "text": "경보의 밝기는 예상되는 모든 외부 조건을 고려하여 결정하되, 주변과 쉽게 구별할 수 있는 색상을 선정하는 것이 바람직하다.",
      "guideContext": "경보시스템의 효율적 관리",
      "additionalDetail": null,
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-011",
      "text": "경보의 우선순위가 다르다면 소리, 음파, 색상, 깜박임 등을 적용하여 서로 구별이 가능하도록 설계한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": "우선순위별 경보 구별을 위한 다감각 설계",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-012",
      "text": "경보가 발생한 후 근로자가 충분한 조치를 취할 수 있도록 경보 설정값을 확인하여야 한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": "필요한 경우 2단계로 경보를 구분할 수 있다 (예: High alarm 후 High-high alarm)",
      "workProcessPhase": "경보시스템 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-013",
      "text": "경보의 우선순위를 선정하는 기준과 절차를 명확히 하고 모든 시스템에 대해 동일하게 적용하여야 한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경보시스템 지속 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-014",
      "text": "새로운 경보를 설정하여야 하거나, 기존의 경보를 변경하여야 하는 경우에도 정해진 절차와 기준에 따라 경보의 우선순위를 결정하여야 한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경보시스템 지속 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-015",
      "text": "운전이 정지된 설비나 공정은 경보시스템의 작동을 중지하여 불필요한 경보가 발생하지 않도록 한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경보시스템 지속 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.5",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-016",
      "text": "경보가 발생하였을 때 문제점을 쉽게 파악하고 필요한 조치를 취할 수 있도록 근로자를 교육시킨다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-017",
      "text": "경보가 발생하였을 때의 역할과 책임을 정상상황과 비상상황 각각에 대해 명확히 구분한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "교육 훈련",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P116-018",
      "text": "경보를 바이패스(Bypass)할 필요가 있을 때에는 반드시 정해진 절차에 따라 승인받은 후 조치하도록 하여야 한다.",
      "guideContext": "경보시스템의 효율적 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "경보시스템 운영 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P116-001",
      "term": "계장시스템",
      "definition": "공정변수 및 상태를 감지하는 등의 역할을 수행하는 전기(Electrical), 전자(Electronic) 혹은 프로그래밍 전자시스템(Programmable electronic system) 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P116-002",
      "term": "안전계장시스템",
      "definition": "하나 이상의 안전계장기능(Safety instrumented function)을 이행하기 위해 사용하는 계장시스템을 말하며, 일반적으로 감지부(Sensor), 로직해결기(Logic solver), 최종요소(Final element)로 구성된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P116-003",
      "term": "로깅",
      "definition": "필요한 결과, 예를 들어 공정변수 등과 같은 값을 일정한 간격으로 일지에 기록하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P116-004",
      "term": "휴민인터페이스",
      "definition": "계장시스템과 운전자를 연결시켜 주는 것을 말하며, 흔히 모니터나 계기판 등의 시각적 접촉과 음성출력과 같은 청각적 접촉 및 근로자의 조작이 이루어질 수 있는 키보드, 마우스 및 터치화면 등을 포함한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P116-005",
      "term": "플랜트인터페이스",
      "definition": "센서를 통한 입력, 액츄에이터(Actuator)를 통한 출력, 전선 등을 통한 통신 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P116-006",
      "term": "안전무결성등급",
      "definition": "전기·전자·프로그램 가능형 전자장치로 구성된 안전관련 시스템이 정해진 시간에 모든 조건에서 특정안전기능을 만족스럽게 수행하는 확률의 범위를 4개의 불연속적인 수준으로 나타낸 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P116-007",
      "term": "작동요구 시 고장확률",
      "definition": "시스템이 특정한 기능을 작동하도록 요구받았을 때 실패할 확률을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P116-01",
      "processOrder": 1,
      "processName": "경보시스템 현황 파악 및 문제점 도출",
      "safetyMeasures": "경보 설치 수량, 필요성, 정상·비상 운전 중 경보 발생비율, 경보 지속시간 등을 파악하고, 과다 경보로 인한 혼란, 연속 사소한 경보 발생, 규칙적 경보 소리 끄기, 우선순위 유무, 후속조치 인지 여부, 제어실 화면을 통한 설비 식별 용이성 등의 문제점을 도출한다.",
      "requiredPPE": [],
      "sourceSection": "5.1",
      "relatedSR": null
    },
    {
