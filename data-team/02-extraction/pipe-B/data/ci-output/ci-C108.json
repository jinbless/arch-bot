  "checklistItems": [
    {
      "identifier": "CI-C108-001",
      "text": "용접·용단 작업 전 작업조건, 작업장소 주변에 인화성, 가연성 물질 여부 등을 조사하여 위험성 평가를 통한 작업 전 위험요인 제거, 방호조치 등을 하여야 한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-002",
      "text": "용접·용단 작업장소에 근접하여 다른 작업을 하거나 통행하는 근로자의 위험을 예방하기 위하여 작업구역 설정, 출입통제용 안전울 설치, 화기작업 경고표지 설치 등의 조치를 하여야 한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-003",
      "text": "용접·용단 불꽃, 충격마찰, 스파크, 정전기 등 점화원이 있는 장소에서는 인화성, 가연성 물질을 충분히 격리시키고, 같은 높이의 작업장소에서는 불티의 수평 비산 가능거리인 11m 이상 격리될 수 있도록 조치한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "화재예방 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-004",
      "text": "화재 발생 위험요인을 근원적으로 제거하거나 방호하기 어려운 다음과 같은 작업조건에서 용접·용단 작업을 하는 경우 화재 감시인을 배치하여 위급상황에 적시 대처할 수 있도록 조치하여야 한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": "(가) 인화성, 가연성 물질이 작업장소에서 반경 11m이상 떨어져 있지만 불티로 인하여 발화위험이 있는 경우 (다) 작업장소에서 반경 11m이내 측면 또는 바닥 개구부를 폐쇄 또는 방호 조치하기 어려운 경우 (라) 인화성, 가연성물질이 열전도성 칸막이, 벽, 바닥, 천정 또는 지붕의 반대쪽 면에 인접하여 열전도 또는 열복사에 의해 발화가능성이 있는 경우 (마) 기타 화재발생의 위험이 높은 장소의 화재 위험요인에 대한 충분한 예방 조치를 적용하기 어려운 경우",
      "workProcessPhase": "화재예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-005",
      "text": "용접·용단 작업 근로자에게는 내열성능이 있는 장갑, 보호복, 안전모, 보안경 등의 보호구를 지급, 착용하도록 관리한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C108-006",
      "text": "작업장소와 가까운 위치에 경보용 설비 또는 도구를 설치 또는 비치하여 위급 상황시 신속하게 경고하고 전파될 수 있도록 조치한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C108-007",
      "text": "화재·폭발 발생 위험이 높은 경우 즉시 작업을 중단하고 용접·용단 장비의 가스 차단 또는 전원 차단 후 대피한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "비상 대응",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-C108-008",
      "text": "질산염, 과산화수소, 과염소산, 산소, 불소 등 산화제는 가연성 물질과 혼합 시 폭발할 위험이 높으므로 내산성인 저장용기를 사용하고, 점화원 발생위험 장소로부터 안전한 거리 이상으로 격리시키고 관리하여야 한다.",
      "guideContext": "건설현장 용접용단 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "화재예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-009",
      "text": "작업장소의 조건을 고려하여 가능한 모든 인화성, 가연성 물질은 용접·용단 작업장소로부터 수평거리 11m이상 격리시켜야 한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "화재예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-010",
      "text": "가연성 물질 및 불티 비산거리 내 벽, 바닥, 덕트 등의 개구부 또는 틈새에 불티가 들어가지 않도록 방염시트 등으로 빈틈없이 방호하여야 한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "화재예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-011",
      "text": "배관 등의 보온재로 사용된 가연성 단열재는 가능한 한 제거한 후에 작업 하여야 한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-012",
      "text": "높은 위치에서 실시하는 강구조물, 배관 보수 작업 시 불티받이포를 설치하여 아래 또는 측면으로 떨어지는(퍼지는) 불티가 비산하지 않도록 조치하여야 한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "화재예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-013",
      "text": "폴리우레탄폼, 스티로폼, 샌드위치 패널 등이 적재 또는 시공되어 있는 경우 용접·용단 작업시 불꽃, 불티 등 고열물 등과 접촉되지 않도록 주의하여야 한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "화재예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-014",
      "text": "바람의 영향으로 용접·용단 불티가 운전 중인 설비근처로 비산할 가능성이 있을 때에는 작업을 중지하여야 한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-015",
      "text": "윤활유, 유류, 인화성 또는 가연성 물질이 덮여 있는 표면에서는 작업을 금지한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-016",
      "text": "가연성 벽, 칸막이, 천장 또는 지붕과 접하는 배관 또는 기타 금속에 대한 용접·용단작업을 계획한 경우 열전도에 의해 발화위험이 높으므로 방호조치를 취하거나 대체작업을 검토하여야 한다.",
      "guideContext": "건설현장 용접용단 인화성·가연성 물질 관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-017",
      "text": "다수의 용접기를 동시에 사용하는 경우 접지클램프를 한 곳에 접속시킨 상태에서 동시 작업을 금지한다.",
      "guideContext": "건설현장 전기용접 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "전기용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.3",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-C108-018",
      "text": "용접기의 전원개폐기는 작업의 종료·중단, 작업 위치변경 또는 사고 발생 시 전원을 신속하게 차단할 수 있도록 가까운 곳에 설치하며, 주변에는 인화성·가연성 물질이 없도록 조치한다.",
      "guideContext": "건설현장 전기용접 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "전기용접 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "CI-C108-019",
      "text": "가스 절단 시에는 불티가 광범위하게 비산하므로 차단막이나 방염시트 등으로 비산 방지 조치를 하여야 한다.",
      "guideContext": "건설현장 가스용접 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "가스용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.1.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-020",
      "text": "산소용기, 호스 및 밸브에 유지류가 묻어 있을 경우, 화재의 위험이 있으므로 취급 시 기름 등이 묻은 손이나 장갑으로 취급하지 않도록 유의하여야 한다.",
      "guideContext": "건설현장 가스용접 화재예방",
      "additionalDetail": null,
      "workProcessPhase": "가스용접 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-C108-021",
      "text": "용접·용단 작업 전 가스용기 연결부, 호스, 밸브 등의 손상, 풀림 등의 원인으로 인한 가스누출 여부를 항상 점검하고 잔류가스 유무를 확인한 후 작업을 시작하여야 한다.",
      "guideContext": "건설현장 용접용단 가스누출 예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-022",
      "text": "호스의 연결부는 조임물을 이용하여 견고하게 연결하고 호스상태를 수시 점검 하여 갈라진 부분이 있을 때는 즉시 교체하여 가스가 누출되지 않도록 관리 하여야 한다.",
      "guideContext": "건설현장 용접용단 가스누출 예방",
      "additionalDetail": null,
      "workProcessPhase": "장비 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-C108-023",
      "text": "가스 용접·용단 작업에 사용되는 장비의 각 구성품간 기밀유지를 위해 사용되는 고무재질 부품은 열화하기 때문에 작업 전 일상점검을 통해 반드시 가스누출 여부를 파악하여야 한다.",
      "guideContext": "건설현장 용접용단 가스누출 예방",
      "additionalDetail": null,
      "workProcessPhase": "장비 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-C108-024",
      "text": "가스누출감지기를 사용하여 점검하고 누출이 발견되면 점화원 발생 위험이 없는 개방된 장소로 옮겨 수리하거나 교체하여야 한다.",
      "guideContext": "건설현장 용접용단 가스누출 예방",
      "additionalDetail": null,
      "workProcessPhase": "장비 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-025",
      "text": "가스용기는 반드시 세워 보관하고 충격에 유의해야 하므로 굴리거나 어깨에 메고 운반 또는 이동하는 행위를 금지하고 반드시 전용 운반장비를 사용하여야 한다.",
      "guideContext": "건설현장 용접용단 가스누출 예방",
      "additionalDetail": null,
      "workProcessPhase": "가스용기 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-C108-026",
      "text": "가스용기를 지상에 설치하여 사용하는 경우 호스를 당기거나 요철부위 위에 설치하여 가스용기가 전도되는 일이 발생하지 않도록 용기의 전도방지 조치를 하여야 한다.",
      "guideContext": "건설현장 용접용단 가스누출 예방",
      "additionalDetail": null,
      "workProcessPhase": "가스용기 취급",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-010"
      ]
    },
    {
      "identifier": "CI-C108-027",
      "text": "작업 전 노즐, 취관, 압력조절기, 호스, 밸브, 가스용기 등 장비의 손상이나 결합을 반드시 확인하고 작업하여야 한다.",
      "guideContext": "건설현장 용접용단 역화 방지",
      "additionalDetail": null,
      "workProcessPhase": "장비 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-028",
      "text": "가스가 역화 되는 것을 효과적으로 차단할 수 있도록 압력조절기와 호스 사이에 역화방지용 안전기가 반드시 설치하고 상시 정상적으로 작동되는지 여부를 관리하여야 한다.",
      "guideContext": "건설현장 용접용단 역화 방지",
      "additionalDetail": null,
      "workProcessPhase": "장비 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2.2",
      "basedOn": [
        "SR-FIRE_EXPLOSION-009"
      ]
    },
    {
      "identifier": "CI-C108-029",
      "text": "전선, 전극용 홀더, 용접봉 등의 전기용접 관련 기구는 항상 건조 상태를 유지할 수 있도록 관리하여야 한다.",
      "guideContext": "건설현장 용접용단 감전재해 예방",
      "additionalDetail": null,
      "workProcessPhase": "감전예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-C108-030",
      "text": "용접봉에 접촉되거나 용접기의 2차측 배선이나 홀더의 절연의 불량으로 인한 감전을 방지하기 위해 용접기의 무부하 전압을 안전전압인 30V 이하로 저하시키는 자동전격방지기 설치하고 작동여부를 수시로 확인하여야 한다.",
      "guideContext": "건설현장 용접용단 감전재해 예방",
      "additionalDetail": null,
      "workProcessPhase": "감전예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-C108-031",
      "text": "훼손되거나 과전류(열손상)에 의하여 피복이 손상된 용접케이블은 신품으로 교체하거나 절연테이프로 보수하여 사용한다.",
      "guideContext": "건설현장 용접용단 감전재해 예방",
      "additionalDetail": null,
      "workProcessPhase": "감전예방 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-C108-032",
      "text": "절연용 홀더를 사용하고 홀더에 용접봉 끼운 채 방치하지 못하도록 관리 하여야 한다.",
      "guideContext": "건설현장 용접용단 감전재해 예방",
      "additionalDetail": null,
      "workProcessPhase": "감전예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-ELECTRIC-006"
      ]
    },
    {
      "identifier": "CI-C108-033",
      "text": "접지클램프는 용접대상물(모재)에 접지해야 하며, 모재가 아닌 주변 구조물(철재빔 등)에 접지하지 않도록 한다.",
      "guideContext": "건설현장 용접용단 감전재해 예방",
      "additionalDetail": null,
      "workProcessPhase": "감전예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-C108-034",
      "text": "용접봉과 접지클램프를 가능한 가깝게 하여 외부로 전류가 누설되는 것을 방지하여야 한다.",
      "guideContext": "건설현장 용접용단 감전재해 예방",
      "additionalDetail": null,
      "workProcessPhase": "감전예방 조치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-C108-035",
      "text": "작업 전 유해가스 체류농도, 산소농도를 측정하여 안전한 상태임을 확인 하여야 한다.",
      "guideContext": "건설현장 용접용단 유해가스 중독·산소결핍 예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-C108-036",
      "text": "유해가스 이송배관에 근접한 장소에서 작업하는 경우 유해가스 누출로 인한 중독, 산소결핍 등 위험이 높으므로 방독마스크, 송기마스크 등 호흡용 보호구를 비치하고 위급상황 발생시 즉시 사용 가능한 상태에서 작업하여야 한다.",
      "guideContext": "건설현장 용접용단 유해가스 중독·산소결핍 예방",
      "additionalDetail": null,
      "workProcessPhase": "유해가스 예방",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CONFINED-018"
      ]
    },
    {
      "identifier": "CI-C108-037",
      "text": "용접 흄(fume)이 발생하는 용접작업 시 부분 및 전체 환기시설을 설치하여 유해가스를 외부로 배출시키고, 근로자에게 호흡용 보호구를 지급·착용하도록 하여야 한다.",
      "guideContext": "건설현장 용접용단 유해가스 중독·산소결핍 예방",
      "additionalDetail": null,
      "workProcessPhase": "유해가스 예방",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-C108-038",
      "text": "작업 중 유해가스 등의 누출·유입·발생 가능성이 있는 경우는 주기적으로 가스 농도를 측정하여야 한다.",
      "guideContext": "건설현장 용접용단 유해가스 중독·산소결핍 예방",
      "additionalDetail": null,
      "workProcessPhase": "유해가스 예방",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "CI-C108-039",
      "text": "실내에서 작업 시 환기와 배기가 중단되지 않고 균일하게 환기되도록 필요한 전원 등 동력공급이 중단되지 않도록 하여야 한다.",
      "guideContext": "건설현장 용접용단 유해가스 중독·산소결핍 예방",
      "additionalDetail": null,
      "workProcessPhase": "유해가스 예방",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-C108-040",
      "text": "맨홀 및 피트 등 통풍이 불충분한 곳에서 작업 시 위급상황에 대처할 수 있도록 외부와의 연락장치, 비상용사다리, 로프 등을 준비하고 작업하여야 한다.",
      "guideContext": "건설현장 용접용단 유해가스 중독·산소결핍 예방",
      "additionalDetail": null,
      "workProcessPhase": "유해가스 예방",
      "bindingForce": "MANDATORY",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.4.1",
      "basedOn": [
        "SR-CONFINED-011"
      ]
    },
    {
      "identifier": "CI-C108-041",
      "text": "용접작업 근로자에게 안전장갑, 보안경, 보안면, 보호복 등 보호장구를 지급하고 착용하도록 하여야 한다.",
      "guideContext": "건설현장 용접용단 화상예방 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C108-042",
      "text": "용접근로자의 작업복은 가급적 난연성 재질의 복장을 착용하도록 한다.",
      "guideContext": "건설현장 용접용단 화상예방",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-C108-043",
      "text": "아크용접 시 강렬한 가시광선, 자외선 및 적외선을 포함한 아크광에 의한 안구와 피부 손상을 방호하기 위하여 근로자에게 안전인증을 받은 차광 및 비산물 위험방용 보안경을 지급하여 착용하도록 한다.",
      "guideContext": "건설현장 용접용단 유해광선·소음 방호",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C108-044",
      "text": "아크용접 작업장소에 인접한 작업을 하는 다른 근로자 보호를 위하여 아크광 차폐시설을 설치한다.",
      "guideContext": "건설현장 용접용단 유해광선·소음 방호",
      "additionalDetail": null,
      "workProcessPhase": "작업 전 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-C108-045",
      "text": "용접·용단 작업 방법에 따라 65~105dB 수준의 소음이 발생하며 이는 일시적 및 영구적 난청을 유발할 수 있으므로 소음이 85dB 이상인 경우 차음보호구(귀마개)를 착용하여야 한다.",
      "guideContext": "건설현장 용접용단 유해광선·소음 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "작업 수행",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.4.3",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-C108-001",
      "term": "용접·용단",
      "definition": "2개 이상의 고체금속을 하나로 접합시키는 금속 가공 기술수단과 전극봉과 모재금속 간에 아크열 등으로 용융시켜 금속을 자르거나 또는 제거하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C108-002",
      "term": "용접절차서(WPS : Welding Procedure Specification)",
      "definition": "용접이음부에서 설계대로 용접하기 위하여 요구되는 제반 용접조건을 상세히 제시하는 서류를 말한다. 통상 모재, 용접법, 이음형상, 용접자세, 용가재, 전류, 전압, 속도, 보호가스, 열처리 등에 대한 정보가 필요에 따라 포함된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C108-003",
      "term": "화기작업",
      "definition": "용접, 용단 등 화염 또는 스파크를 발생시키는 작업으로 또는 인화성·가연성 물질의 점화원이 될 수 있는 작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C108-004",
      "term": "밀폐공간",
      "definition": "환기가 불충분한 상태에서 산소결핍이나 유해가스로 인한 중독·화재·폭발 등의 위험이 있는 장소로서 산업안전보건기준에 관한 규칙 〈별표18〉에서 정한 장소를 말하며 <부록 1>을 참조한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CONFINED-001"
      ]
    },
    {
      "identifier": "DT-C108-005",
      "term": "역화",
      "definition": "노즐의 화염이 취관 쪽으로 되돌아오는 현상을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C108-006",
      "term": "유해가스",
      "definition": "탄산가스, 일산화탄소, 황화수소 등 기체로서 인체에 유해한 영향을 미치는 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-C108-007",
      "term": "용접 흄(Welding fume)",
      "definition": "용접작업시 발생하는 금속의 증기가 응축되거나 산화되는 등의 화학반응에 의하여 형성된 고체상 미립자를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
