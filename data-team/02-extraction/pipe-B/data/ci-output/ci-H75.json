  "domainTerms": [
    {
      "identifier": "DT-H75-001",
      "term": "깨끗한 작업환경",
      "definition": "사업장에서 환경·보건·위생 등 제반 시설의 설치·관리를 통하여 청결하고 적합한 작업장이 유지되는 상태를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H75-002",
      "term": "작업환경개선",
      "definition": "사업주가 기업경영상 직업병을 예방하기 위하여 작업환경시설 및 보건·위생시설 등을 사업장에 적절하게 설치하여 작업환경을 쾌적하게 조성하기 위하여 행하는 제반 활동을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H75-01",
      "processOrder": 1,
      "processName": "작업환경 평가",
      "safetyMeasures": "사업주 또는 사업주가 지정하는 자와 근로자 대표를 포함하는 평가팀을 구성하고, 일반관리·유해물질관리·작업환경관리·작업관리·근로자 건강관리·근로자 후생 복지·사무실 공기질·기타 등 8개 분야에 대하여 종합적으로 평가한다. 평가 결과는 양호·미흡·불량으로 구분하여 분류하고 관리한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": null
    },
    {
      "identifier": "WP-H75-02",
      "processOrder": 2,
      "processName": "작업환경 개선 계획 수립",
      "safetyMeasures": "개선 대상 공정의 우선 순위를 정하여 순차적으로 개선 계획을 수립한다. 불량 항목부터 개선하고, 직업병 유소견자 발생 장소 및 노출기준 초과 작업 장소를 우선 개선한다. 개선 계획서에는 세부 개선방법, 목표, 추진 일정, 소요 예산, 개선책임자 등을 명기하고 근로자의 의견을 반영한다.",
      "requiredPPE": [],
      "sourceSection": "5",
      "relatedSR": null
    },
    {
      "identifier": "WP-H75-03",
      "processOrder": 3,
      "processName": "작업환경 개선 후 평가",
      "safetyMeasures": "개선이 완료된 시점에서 이전의 평가를 실시한 평가자가 동일한 항목에 대하여 재평가를 실시한다. 미흡 또는 불량 항목은 양호 등급이 되도록 반복 개선하고, 시설·설비 유지관리 매뉴얼을 작성하여 관리한다.",
      "requiredPPE": [],
      "sourceSection": "6",
      "relatedSR": null
    },
    {
      "identifier": "WP-H75-04",
      "processOrder": 4,
      "processName": "작업환경 사후관리",
      "safetyMeasures": "양호로 평가된 항목도 현재 상태를 유지하도록 관리하고, 개선 완료 후에도 6개월에 1회씩 평가를 실시한다. 불량이나 미흡 등급 항목은 양호 등급이 되도록 지속적으로 관리한다.",
      "requiredPPE": [],
      "sourceSection": "7",
      "relatedSR": null
    }
  ],
  "equipmentSpecs": [
