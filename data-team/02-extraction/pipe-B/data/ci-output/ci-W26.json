  "checklistItems": [
    {
      "identifier": "CI-W26-001",
      "text": "조리 부산물이 발생하는 조리기구에는 조리 부산물을 배출하기 위해 후드, 덕트, 배풍기 및 배기구로 구성된 국소배기장치를 설치하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "국소배기장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W26-002",
      "text": "조리 부산물과 냄새에 의해 민원 발생 우려가 있는 곳에는 조리 부산물과 유해가스(냄새)를 제거할 수 있는 공기정화장치를 설치하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "공기정화장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W26-003",
      "text": "후드는 조리 부산물을 충분히 제어할 수 있는 구조와 크기로 하여야 하며, 조리 기구별 후드 형식은 <표 1>과 같다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-004",
      "text": "후드는 조리 부산물의 포집효율을 높이기 위해서 60 cm 이상의 박스형 후드로 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-005",
      "text": "후드는 방해기류의 영향을 최소화하고 배기효율을 높이기 위해 후드 양 측면, 후면 등에 패널(Side Panel)을 부착하는 등 조리 부산물 발생구역을 가급적 밀폐한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-006",
      "text": "후드설치 위치는 작업에 방해가 되지 않도록 조리실 바닥으로부터 약 1.8 m 이상 높이로 설치하되, 환기성능이 저하되지 않도록 조리대 상단면으로부터 최대 1.2 m를 넘지 않아야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-007",
      "text": "후드 크기는 조리대보다 사방 15 cm 이상으로 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-008",
      "text": "후드의 흡입방향은 조리원의 호흡영역을 보호하기 위해 조리원과 반대 방향으로 하되, 후드 흡입구(기름필터)를 조리원 정면방향으로 최대한 먼 거리에 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-009",
      "text": "<표 1>의 양면 조리대(아일랜드 후드)는 조리원의 호흡영역을 보호할 수 없기 때문에 가능한 설치하지 않는 것을 원칙으로 한다. 다만, 조리실 구조에 의해 양면 조리대를 설치할 경우 <표 1>과 같이 기류 유도판을 반드시 설치해야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-010",
      "text": "후드와 부속품 등의 재질은 스테인리스 스틸 등 내구성, 내식성이 있는 재질로 하고, 후드 표면에 형성된 응축수, 기름 등의 이물질이 조리기구 내부로 떨어지지 않도록 후드의 몸체 및 테두리에 홈통을 만들어야 한다.",
      "guideContext": "단체급식시설 환기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-011",
      "text": "튀김, 부침 등 기름을 취급하는 조리대 상부의 후드는 청소가 용이한 구조로 하고, 기름받이나 기름입자 제거용 필터(데미스트 필터)를 설치한다. 필터는 막힘에 의한 압력손실이나 소음 발생 등을 최소화하기 위하여 후드 개구면적 대비 필터 설치면적 비율을 20~25% 이내로 하되 후드구조상 적정 면적으로 설치가 어려운 경우 필터의 청소, 교체 등 막힘 방지 조치와 재질두께 변경, 보강재 추가 설치 등 설비의 떨림이나 울림에 의한 소음을 방지할 수 있는 조치를 하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "후드 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-W26-012",
      "text": "덕트는 후드 폭 1.8 m 간격으로 1개 이상 설치하여 후드 끝 부분에서 환기효율이 저하되지 않도록 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "덕트 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-013",
      "text": "후드에 연결된 덕트는 유량 조절이 가능하도록 댐퍼를 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "덕트 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-014",
      "text": "덕트 재질은 녹이 슬지 않도록 스테인리스 스틸 재질 등 내구성, 내식성이 있는 재질로 설치하고, 덕트 내 유증기가 응축될 우려가 있는 경우에는 응축액 배출 밸브를 설치하여야 한다.",
      "guideContext": "단체급식시설 환기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "덕트 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-015",
      "text": "장방향 덕트에서 발생되는 진동 소음을 최소화하기 위해 덕트 종횡비(가로 길이와 세로 높이의 비)는 1.5 이하로 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "덕트 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-W26-016",
      "text": "배풍기와 연결된 덕트는 진동 전달을 방지하기 위한 캔버스 등 진동 방지 시설을 설치해야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "덕트 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-W26-017",
      "text": "덕트 내 분진이 퇴적하지 않도록 덕트 반송속도를 결정하지만, 조리 부산물은 퇴적될 우려가 낮아 과도한 반송속도에 의한 소음이 발생하지 않도록 적절하게 관리하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "덕트 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-W26-018",
      "text": "반송속도는 후드 하부에서 작업하는 조리실 후드 특성을 고려하여 후드와 연결된 덕트는 5 m/sec 전후, 주 덕트는 10 m/sec 이하로 설계한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "덕트 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-019",
      "text": "소음과 진동을 최소화하기 위해 배풍기는 조리실 외부에 설치해야 하고, 주변 민원 발생이 우려될 경우 차음 및 흡음 설비를 설치하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "배풍기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-W26-020",
      "text": "배풍기 전후에 진동 전달을 방지하기 위해서는 캔버스 등을 설치하고, 파손 등이 발생하지 않도록 조치하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "배풍기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-W26-021",
      "text": "조리 부산물의 원활한 확산을 위해 배풍기의 배기구는 지붕면이나 벽면으로부터 1 m 이상 이격하여 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "배풍기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-022",
      "text": "배풍기는 가동시간을 고려하여 가급적 조리기구용과 세척기용으로 구분하여 설치한다. 또, 설비의 효율적 유지관리를 위해 조리기구용은 조리 부산물과 냄새 처리 등을 고려하여 유·수증 라인을 분리하고 각 라인에 풍량 조절이 가능한 인버터(Inverter)를 설치하는 것을 권장한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "배풍기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-023",
      "text": "배풍기의 유량은 연결된 후드의 배기량을 합한 것보다 용량을 크게 선정해야 한다.",
      "guideContext": "단체급식시설 환기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배풍기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-024",
      "text": "공기정화장치는 환경부의 음식점 냄새 관리 가이드북을 참조하여 조리 부산물과 냄새를 동시에 저감할 수 있는 조합형 공기정화장치를 설치하거나 이와 동등 이상 성능을 가진 장치를 설치하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": "공기정화장치는 가급적 배풍기 전단에 설치",
      "workProcessPhase": "공기정화장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-W26-025",
      "text": "후드가 미설치된 조리기구와 후드가 설치된 조리기구에서 발생된 후드에서 완전히 제거되지 않은 열과 수증기가 조리실 상부에 정체되지 않도록 전체환기설비를 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "전체환기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-W26-026",
      "text": "전체환기를 위한 배기구는 조리실에서 가장 높은 위치에 설치하여 효과적인 열배기가 가능하도록 해야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "전체환기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-W26-027",
      "text": "조리실 바닥면적 1 m² 당 약 0.2 m³/min 이상의 풍량을 확보한다.",
      "guideContext": "단체급식시설 환기 - 전체환기 성능기준",
      "additionalDetail": null,
      "workProcessPhase": "전체환기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-W26-028",
      "text": "국소배기장치를 설치할 때는 신선한 공기가 조리실 내부로 공급될 수 있도록 자연 급기구(공기 유입부) 또는 강제 급기시설을 반드시 설치하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "급기시설 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-W26-029",
      "text": "조리실 내부로 먼지, 오염된 공기 등이 유입되지 않도록 필터를 거쳐 급기가 되도록 하고, 급기 필터 청소 및 교체가 용이한 위치에 설치한다. 다만, 자연 급기구를 통해 외부공기가 유입되는 경우에는 필요 시 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "급기시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-030",
      "text": "외부와 연결된 흡기구에는 위생해충 및 쥐의 침입을 방지하기 위해 적절한 방충·방서 시설을 설치한다. 다만, 자연 급기구를 통해 외부공기가 유입되는 경우에는 필요 시 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "급기시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-W26-031",
      "text": "강제 급기시설로 급기하는 경우 조리실 상시 배기량의 80~90%의 범위에서 급기량을 결정하되, 급기되는 공기의 횡기류(Cross Draft)에 의해 후드 포집효율이 저하되지 않도록 급기구 위치나 급기방향을 적절히 조절하는 등의 조치를 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "급기시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-W26-032",
      "text": "자연 급기구를 통해 조리실 내부로 들어오는 기류의 속도는 개방면에서 2.5 m/sec를 초과하지 않도록 급기한다. 다만, 자연급기구와 후드와의 거리가 근접하여 외부 유입공기가 후드흡인성능을 저하시킬 우려가 있는 경우 기류속도는 개방면에서 가급적 1.5 m/sec 이하로 급기되도록 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "급기시설 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "CI-W26-033",
      "text": "강제 급기 또는 자연 급기 시 조리실 내 외부공기 유입에 의한 작업조건이 저하되지 않도록 더운 공기나 추운 공기의 직접 유입을 최소화 하거나 별도의 냉난방 기구를 설치하는 등 조리실 내부 적정 온도유지를 위한 조치를 함께 고려한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "급기시설 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-HEAT-001"
      ]
    },
    {
      "identifier": "CI-W26-034",
      "text": "연료가스의 누출이나 유해가스(일산화탄소 등)의 과도한 발생을 감지할 수 있는 감지기 및 경보기 등을 설치한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "유해가스 감지기 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-W26-035",
      "text": "신규 설치 또는 주요 구조부분을 변경한 경우 환기설비에 대한 도면 및 계통도를 작성하여 보존하여야 한다. 이때 작성된 도면 및 계통도는 실제 설치된 환기설비의 구조, 모양 등이 일치하여야 하며, 도면 등에는 후드 형태 및 크기, 배풍기 형식, 배풍량 등 자체 점검에 필요한 환기설비 정보가 기재되어야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-W26-036",
      "text": "환기설비를 신규 설치 또는 주요 구조부분 변경 후 처음으로 사용하기 전에 후드나 배풍기 등의 기류흐름 상태(스모크테스트 등), 배풍량 등이 동 지침을 충족하는지를 확인하고 개선이 필요한 경우에는 즉시 적정한 상태로 개선하여 사용하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-W26-037",
      "text": "사용 중에 후드나 배풍기 등 환기량에 변화를 줄 수 있는 주요 부분을 교체하거나 변경하는 경우 이를 기록해 두어야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-W26-038",
      "text": "후드, 배풍기 등의 성능이 적정하게 유지되고 있는지 연 1회 이상 주기로 정기 점검을 실시해야 하고, 평가결과, 포집성능이 저하된 것으로 판단되는 경우 후드 배풍량을 증가하거나 후드형식, 설치형태 등을 변경하는 등 적정한 상태로 유지·관리하여야 한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-016",
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-W26-039",
      "text": "근로자가 환기설비의 성능저하나 이상이 있다고 하는 경우 신속히 환기설비를 점검한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-W26-040",
      "text": "점검 결과, 후드나 배풍기 등의 성능이 현저히 저하된 것이 확인된 경우, 그 원인을 찾아 개선한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": "필터의 막힘, 이음매 누설이나 파손, V벨트 처짐, 이상소음 등",
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-DUST-004"
      ]
    },
    {
      "identifier": "CI-W26-041",
      "text": "급식 조리실의 환기설비 검사는 <별표>의 체크리스트 내용에 따라 점검한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-W26-042",
      "text": "점검은 연기발생기구 등을 이용하여 가열된 조리기구 상부에 연기 등을 분사한 후 분사된 연기가 조리원 호흡영역을 통과한 후 후드로 배출되는지 기류 흐름 상태를 확인하고 열선풍속계 등의 측정기구를 이용하여 후드 면풍속을 측정한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-016"
      ]
    },
    {
      "identifier": "CI-W26-043",
      "text": "환기설비 검사 결과, 후드 면풍속이 부족하거나 설치 상태가 부적정하여 조리대에서 발생된 연기 등이 후드로 적정하게 배출되지 않고 조리원 호흡영역을 통과하거나 조리실 내부로 확산되는 경우 후드 성능이 불량한 것으로 판정한다.",
      "guideContext": "단체급식시설 환기",
      "additionalDetail": null,
      "workProcessPhase": "환기시설 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-W26-001",
      "term": "단체급식시설",
      "definition": "직영 및 위탁의 형태로 가정 외의 장소에서 조직의 특정 구성원에게 지속적으로 음식을 제공하는 급식시설을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-002",
      "term": "조리 부산물",
      "definition": "고온의 조리기구에서 발생되는 유증기와 유증기에 포함된 유해물질과 미세입자 등을 통칭한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-003",
      "term": "조리기구",
      "definition": "조리 부산물이 발생하여 후드 설치가 필요한 조리기구를 말하며 튀김 솥, 국솥, 가스레인지(인덕션), 부침기, 오븐, 밥솥 및 식기 세척기 등을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-004",
      "term": "환기설비",
      "definition": "조리기구에서 발생되는 조리 부산물을 조리실 외부로 배출하기 위해 설치하는 국소배기장치와 전체환기 장치 등 일체의 환기설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-005",
      "term": "국소배기장치",
      "definition": "조리기구에서 발생되는 조리 부산물을 후드, 덕트, 공기정화장치, 배풍기 및 배기구를 설치하여 배출하거나 처리하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "DT-W26-006",
      "term": "전체환기장치",
      "definition": "자연적 또는 기계적인 방법에 의하여 조리실 상부에 정체된 열수증기 및 조리 부산물을 희석, 환기시키는 장치 또는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-006"
      ]
    },
    {
      "identifier": "DT-W26-007",
      "term": "후드",
      "definition": "조리기구에서 발생되는 유해물질을 포집·제거하기 위해 해당 조리기구의 근접한 위치에 설치하는 구조물로서 국소배기장치의 흡입구를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-008",
      "term": "후드 면풍속",
      "definition": "후드 개구면 풍속이라고도 하며 후드의 개방된 면에서 후드 내부로 유입되는 속도를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "DT-W26-009",
      "term": "후드 배풍량",
      "definition": "조리기구에서 발생된 조리 부산물을 포집하여 후드를 통해 급식실 외부로 배출하는 분당 공기량(m³/min)을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-010",
      "term": "필터 면풍속",
      "definition": "덕트로 유증기가 유입되지 않도록 후드 내부에 필터를 설치할 경우 필터를 통과하는 기류의 속도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-011",
      "term": "덕트",
      "definition": "후드에서 포집된 공기를 배풍기까지 이송하기 위하여 설치하는 사각형 또는 원형의 관을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-012",
      "term": "덕트 반송속도",
      "definition": "후드에서 포집된 공기가 덕트를 통하여 이동하는 속도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-013",
      "term": "배풍기",
      "definition": "배풍기에 연결된 후드의 배풍량을 확보하고, 후드로 유입된 조리 부산물을 포함한 공기가 배기구로 토출될 때까지 발생되는 압력손실(배풍기 정압)을 확보하는 장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-014",
      "term": "공기정화장치",
      "definition": "후드를 통해 포집된 조리 부산물의 유해물질과 냄새를 정화하는 장치로 제진, 집진, 흡수, 연소 등의 처리장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-015",
      "term": "급기 풍속",
      "definition": "급식실의 환기장치 가동에 의해 배출되는 공기량을 보충하기 위해 창문이나 출입문 등을 통해 급식실 외부에서 내부로 유입되는 공기의 속도를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-W26-016",
      "term": "급기 시설",
      "definition": "창문 및 출입문만으로 충분하지 않은 급식실에 배풍기를 이용하여 강제적으로 외부공기를 공급하는 설비를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-W26-01",
      "processOrder": 1,
      "processName": "국소배기장치 설치 (후드·덕트·배풍기·배기구)",
      "safetyMeasures": "후드는 60 cm 이상 박스형으로 설치하고, 조리대 상단면으로부터 최대 1.2 m를 넘지 않도록 설치한다. 후드 크기는 조리대보다 사방 15 cm 이상으로 하고, 흡입방향은 조리원 반대 방향으로 한다. 덕트 재질은 스테인리스 스틸 등 내식성 재질로 설치하고, 종횡비 1.5 이하로 한다. 배풍기는 조리실 외부에 설치하고 진동 방지 캔버스를 설치한다.",
      "requiredPPE": [],
      "sourceSection": "4",
      "relatedSR": [
        "SR-CHEMICAL-002",
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "WP-W26-02",
      "processOrder": 2,
      "processName": "공기정화장치 설치",
      "safetyMeasures": "민원 발생 우려 시 조합형 공기정화장치를 배풍기 전단에 설치한다. 전기집진기, 활성탄 흡착, 세정시설, 여과시설 등을 조합하여 조리 부산물과 냄새를 동시에 저감할 수 있도록 한다.",
