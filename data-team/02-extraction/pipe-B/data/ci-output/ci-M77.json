  "checklistItems": [
    {
      "identifier": "CI-M77-001",
      "text": "분무도장작업자는 호흡용 보호구(RPE)를 착용해야 한다.",
      "guideContext": "자동차 부분 분무도장 작업 개요",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-002",
      "text": "분무 미스트(Mist)로부터 다른 사람들을 가까이 하지 못하게 해야 한다.",
      "guideContext": "자동차 부분 분무도장 작업 개요 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-003",
      "text": "이소시아네이트가 합유된 제품을 사용할 때에는, 반드시 송기 마스크를 착용해야 한다.",
      "guideContext": "호흡용 보호구 선택",
      "additionalDetail": "적합한 송기 마스크란 방호계수(PF)가 20 이상인 것",
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-004",
      "text": "여과식 호흡용 보호구는 적합하지 않다.",
      "guideContext": "이소시아네이트 합유 제품 사용 시 호흡용 보호구 제한",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-005",
      "text": "압축기는 호흡용 보호구가 작업에 적절하게 기능을 발휘할 수 있도록 깨끗한 공기를 충분히 전달할 수 있어야 한다. 바람이 불어 들어오는 방향 또는 분무 제외 영역 및 기타유해물질이 없는 곳에 압축기를 설치하여 오염된 공기의 흡입을 중단시켜야 한다.",
      "guideContext": "송기 마스크 공기 공급 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-006",
      "text": "비반응성 제품으로 분무 작업을 할 때에도 같은 종류의 개인 보호구를 사용하는 것이 좋다. 그러나 송기 마스크 대신 방호계수가 10 이상인 반면형 여과식 호흡용 보호구와 같이 호흡용 보호구를 사용할 수 있다.",
      "guideContext": "비반응성 제품 분무 시 보호구",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-007",
      "text": "호흡용 보호구는 정확히 밀착되어야 하며, 마모될 때마다 적당히 교환해야 한다.",
      "guideContext": "호흡용 보호구 관리",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-008",
      "text": "호흡용 보호구 공급자 또는 교육자들은 사용 및 유지보수 시의 부착 시험 및 교육을 실시해야 한다.",
      "guideContext": "호흡용 보호구 교육 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "7.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-009",
      "text": "호흡용 보호구를 착용할 때마다 깨끗한 공기가 원활하게 흐르는 것을 점검해야 한다. 공기를 공급하는 호흡용 보호구는 최저 유량(Low-flow) 경보장치가 있어야 한다.",
      "guideContext": "호흡용 보호구 점검",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-010",
      "text": "최소 일주일에 한 번씩 압축기와 에어라인의 상태와 필터, 트랩의 청결 상태를 점검해야 한다. 이러한 점검사항과 교체된 부분의 사항을 상세하게 기록해야 한다.",
      "guideContext": "압축기 및 에어라인 정기 점검 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-011",
      "text": "반면형 송기 마스크를 사용하는 경우, 화학물질 차단 고글이 필요하다.",
      "guideContext": "기타 개인 보호구",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-M77-012",
      "text": "특정 물질을 다루는 경우에는 모자가 달린 전신용 작업복을 착용한다.",
      "guideContext": "기타 개인 보호구",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-M77-013",
      "text": "일회용 장갑을 사용한다. 니트릴 장갑이 적당하다. 만약 라텍스 장갑을 사용해야 한다면, 무단백질 장갑을 고르도록 한다. 일회용 장갑은 분무도장작업 후에는 버려야 한다.",
      "guideContext": "기타 개인 보호구",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.1.2",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-M77-014",
      "text": "보호구를 착용하지 않은 사람들이 분무에 노출되지 않도록 방지해야 한다.",
      "guideContext": "안전작업방법 일반",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-015",
      "text": "송기 마스크를 착용하지 않은 사람들은 모두 작업실 밖으로 내보내야 한다.",
      "guideContext": "실내 분무도장작업",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-016",
      "text": "작업실에는 어떠한 점화원도 없어야 한다.",
      "guideContext": "실내 분무도장작업",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "CI-M77-017",
      "text": "스프레이 건을 준비하고, 분무 및 청소를 하는 동안에는 모든 개인 보호구를 착용해야 한다.",
      "guideContext": "실내 분무도장작업",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-018",
      "text": "작업실을 나갈 때까지 호흡용 보호구를 착용하고 있어야 한다.",
      "guideContext": "실내 분무도장작업",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-019",
      "text": "분무 부스, 분무 실에서 작업할 때 또는 포집장치를 사용할 때에도, 분무도장작업자는 송기 마스크 및 개인 보호구를 착용해야 한다.",
      "guideContext": "실내 분무도장작업",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-020",
      "text": "이소시아네이트가 합유된 제품을 사용할 때에는 다른 사람을 작업실에 절대 들여서는 안 된다. 적은 양의 이소시아네이트라도 노출을 제어해야 한다.",
      "guideContext": "실내 분무도장작업 - 이소시아네이트 취급",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-003"
      ]
    },
    {
      "identifier": "CI-M77-021",
      "text": "분무도장작업이 끝나면, 분무도장작업자는 호흡용 보호구를 착용한 채로 분무 부스, 분무 실 또는 그 작업 공간을 떠나야 한다.",
      "guideContext": "실내 분무도장작업",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-022",
      "text": "이소시아네이트를 사용했을 경우에는 연기제거 시간(Clearance time) 전에 분무부스(Booth)나 분무실(Room)에 다시 들어가거나 30분이 경과하기 전에 작업장(Workshop)에 다시 들어갈 때에는 송기 마스크를 착용하여야 한다.",
      "guideContext": "실내 분무도장작업 - 이소시아네이트 재입실",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-023",
      "text": "분무부스 또는 분무실은 연기발생기로 연기를 채우고 다시 깨끗해지는데 걸리는 시간을 측정한다. 분무부스 또는 분무실의 문에 이 연기제거시간을 표시한다.",
      "guideContext": "실내 분무도장작업 - 연기제거시간 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-024",
      "text": "작업장에는 과도한 분무와 미스트를 포집하고 여과하는 국소배기장치를 사용해야 한다. 이 장치는 분무하는 표면과 가까운 곳에 부착해야 하며 연기발생기로 분무포집 효과를 확인해야 한다.",
      "guideContext": "실내 분무도장작업 - 국소배기장치",
      "additionalDetail": null,
      "workProcessPhase": "실내 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-002"
      ]
    },
    {
      "identifier": "CI-M77-025",
      "text": "미스트 포집 및 여과장치는 매년 철저하게 유지보수, 검사 및 점검을 해야 한다.",
      "guideContext": "실내 분무도장작업 - 국소배기장치 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "장비 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.1",
      "basedOn": [
        "SR-CHEMICAL-005"
      ]
    },
    {
      "identifier": "CI-M77-026",
      "text": "압축기 및 흡기가 분무작업과 맞바람인지, 그리고 기타 유해 물질이 제거되었는지를 확인해야 한다.",
      "guideContext": "옥외 분무도장작업 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "옥외 분무도장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-027",
      "text": "송기 마스크를 착용하지 않은 사람은 최소 5 m, 가급적이면 10 m 정도 떨어져 있어야 한다.",
      "guideContext": "옥외 분무도장작업 - 이격거리 (법령 근거 미확인)",
      "additionalDetail": "이 거리가 건강상 위험을 최소화한다.",
      "workProcessPhase": "옥외 분무도장",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-028",
      "text": "스프레이 건을 준비하고, 분무 및 청소작업을 하기 위해서는 모든 개인 보호구를 착용해야 한다. 건 청소가 끝날 때까지 호흡용 보호구를 착용하고 있어야 한다.",
      "guideContext": "옥외 분무도장작업",
      "additionalDetail": null,
      "workProcessPhase": "옥외 분무도장",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.2",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-029",
      "text": "버리기 전에 폐기물의 오염원을 제거하고 페인트 통을 비워야 한다.",
      "guideContext": "폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-M77-030",
      "text": "이소시아네이트가 합유된 제품은 물에 희석한 소다액(50 g/ℓ)으로 씻고, 며칠 동안 세워두어야 한다.",
      "guideContext": "폐기물 처리 - 이소시아네이트 오염제거",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-M77-031",
      "text": "폐기물인 용제, 오염이 제거된 잔류물 및 용기, 장갑 등 위험한 폐기물을 제거해야 한다. 이를 가정용 폐기물과 함께 버려서는 안 된다.",
      "guideContext": "폐기물 처리",
      "additionalDetail": null,
      "workProcessPhase": "폐기물 처리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.3",
      "basedOn": [
        "SR-CHEMICAL-020"
      ]
    },
    {
      "identifier": "CI-M77-032",
      "text": "시너로 분무 건을 세척하고 건조시키면, 페인트와 비슷한 위험을 발생시킨다. 분무도장작업에 관한 것과 같은 처리방법을 사용해야 한다.",
      "guideContext": "기타 위험 - 시너 세척",
      "additionalDetail": null,
      "workProcessPhase": "건 청소 및 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.4",
      "basedOn": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "CI-M77-033",
      "text": "시너로 손을 닦으면 피부염이 일어날 수 있다. 적합한 피부세척제를 사용해야 한다.",
      "guideContext": "기타 위험 - 피부보호",
      "additionalDetail": null,
      "workProcessPhase": "건 청소 및 정리",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2.4",
      "basedOn": [
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-M77-034",
      "text": "자외선램프는 눈과 피부에 유해한 방사능을 만든다. 자외선램프로부터 사람을 격리시키고, 조명이 반사되는 것을 막기 위해 스크린을 조정해야 한다.",
      "guideContext": "기타 위험 - 자외선 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-035",
      "text": "휴대용 전기기기는 정기적으로 검사해야 한다.",
      "guideContext": "기타 위험 - 전기기기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-036",
      "text": "압축기는 압력 용기이기 때문에 정기적으로 안전검사를 받아야 한다.",
      "guideContext": "기타 위험 - 압축기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장비 유지보수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-037",
      "text": "이산화탄소 또는 분말 소화기를 설치한다. 소화기가 유효기간에 가까워지면 교체해야 한다.",
      "guideContext": "기타 위험 - 소화기 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "7.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-038",
      "text": "분무도장작업 시에는 점화원(예, 흡연, 나화 또는 연삭숫돌)이 없어야 한다.",
      "guideContext": "기타 위험 - 점화원 제거",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2.4",
      "basedOn": [
        "SR-FIRE_EXPLOSION-007"
      ]
    },
    {
      "identifier": "CI-M77-039",
      "text": "분무도장작업은 차량의 이동경로를 벗어난 곳에서 실시하고, 주변에 자동차가 없어야 한다. 주차장이나 도로에서 작업할 경우에는 작업복 위에 눈에 잘 띄는 조끼를 착용해야 한다.",
      "guideContext": "기타 위험 - 작업 위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 작업",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-040",
      "text": "고소 작업을 할 때에는 안전한 접근방법을 확보해야 한다. 사다리보다 비계가 바람직하며, 절대로 트럭 위에서 작업해서는 안 된다.",
      "guideContext": "기타 위험 - 고소작업",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 작업",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7.2.4",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-M77-041",
      "text": "피부염, 그리고 이소시아네이트를 사용한 경우 천식의 증상이 나타나는지를 확인하기 위해서는 작업자들을 위한 보건관리 대책을 마련해야 한다.",
      "guideContext": "보건 감독 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-042",
      "text": "페인트는 최소 수량만 보관해야 한다.",
      "guideContext": "보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-043",
      "text": "기타 제품에 과산화수소로 표백된 것(예, 필러 또는 섬유유리와 함께 사용되는 폴리에스테르 수지를 활성화시킴)이 있다면, 밀폐된 금속 용기에 저장하여 격리시켜 보관한다.",
      "guideContext": "보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보관 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.3.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-044",
      "text": "다음의 기록 사항을 보관해야 한다. (1) 호흡용 보호구 검사 (2) 압축기 공기필터 검사 (3) 보건관리 (4) 위험한 폐기물의 처리",
      "guideContext": "기록 보관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "보건 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.3.4",
      "basedOn": null
    },
    {
      "identifier": "CI-M77-045",
      "text": "분무도장작업자들은 다음에 관한 교육을 받아야 한다. (1) 장비, 호흡용 보호구 및 제품의 안전한 사용방법 (2) 장비 및 호흡용 보호구의 유지보수 방법 (3) 위험요인, 위험의 이해 및 통제 방법 (4) 건강 악화 신호의 인지 및 대책 (5) 폐기물의 적절한 오염 제거 및 처리 방법",
      "guideContext": "분무도장작업 교육",
      "additionalDetail": null,
      "workProcessPhase": "교육",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "7.4",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    },
    {
      "identifier": "CI-M77-046",
      "text": "자동차 페인트는 위험한 물질이다. 물질안전보건자료(MSDS)를 참고해야 한다.",
      "guideContext": "이소시아네이트 유해성 정보",
      "additionalDetail": null,
      "workProcessPhase": "분무도장 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M77-001",
      "term": "호흡용 보호구(Respiratory Protective Equipment, RPE)",
      "definition": "산소결핍 공기 또는 유해물질로 오염된 공기 등을 흡입함으로써 발생할 수 있는 건강장해를 예방하기 위하여 사용하는 보호구를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "DT-M77-002",
      "term": "송기 마스크(Air-fed respirator)",
      "definition": "호흡용 보호구 중에서 공기호스 등으로 호흡용 공기를 공급할 수 있도록 만들어진 호흡용 보호구를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-025"
      ]
    },
    {
      "identifier": "DT-M77-003",
      "term": "분무도장(Spraying)",
      "definition": "도료를 유기용제에 조합해서 이것을 분무상태로 해서 내뿜어 대상물의 도장을 실시하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M77-004",
      "term": "개인 보호구(Personal Protective Equipment, PPE)",
      "definition": "근로자의 건강과 안전에 가해지는 위험으로부터 근로자를 보호하는 모든 장비를 말한다. 개인 보호구에는 안전모, 안전화, 보안경, 안전장갑 그리고 안전대 등이 포함된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M77-005",
      "term": "방호계수(Protection Factor, PF)",
      "definition": "호흡용 보호구의 방호 성능을 나타내는 계수로서 다음 식에 의해 계산한다. PF = 100 / L (이때, PF : 방호 계수, L : 전체 누설률 (%))",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M77-006",
      "term": "트랩(Trap)",
      "definition": "호흡용 보호구 내의 응축수를 고이게 하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M77-007",
      "term": "용제(Solvent)",
      "definition": "도료에 사용하는 휘발성 액체 도료의 유동성을 증가시키기 위해서 사용한다. 좁은 의미로는 도막 형성 요소의 용매를 말하고, 달리 조용제·희석제가 있다. 본래는 증발 속도의 대소에 의해서 구분하지만, 끓는점의 고저에 따라서 고끓는점 용제·중끓는점 용제·저끓는점 용제로 분류되는 수도 있다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M77-008",
      "term": "무단백질 장갑",
      "definition": "합성고무 라텍스 또는 플라스틱으로 제조되었으며, 추출용액이나 다른 시료로 전이될 수 있는 다른 물질이나 분말이 없는 장갑을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M77-009",
      "term": "미스트(Mist)",
      "definition": "가스(통상 공기) 중에 분산된 단일 물질 또는 혼합물의 액체 미립자를 의미한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
