      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-H215-001",
      "term": "라돈",
      "definition": "지각을 구성하는 암석이나 토양 중에 천연적으로 존재하는 우라늄(238U)과 토륨(232Th)의 방사성 붕괴에 의해서 만들어진 라듐(226Ra)이 붕괴했을 때에 생성되는 방사성의 가스상 물질이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H215-002",
      "term": "딸핵종",
      "definition": "방사성 붕괴에 있어서 방사성 핵종이 붕괴해서 다른 핵종으로 변환한 핵종을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H215-003",
      "term": "라돈 농도분포도",
      "definition": "작업 공간 도면에 동일한 라돈 농도라고 판단되는 지역을 '측정주기표'의 등급별 색상에 따라 표시한 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H215-004",
      "term": "라돈 농도단위",
      "definition": "세제곱 미터당 라돈의 방사선 양을 말하며, Bq/m³ 으로 표기한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H215-005",
      "term": "베크렐(Bq)",
      "definition": "방사능 양의 국제단위(SI)로, 1 Bq은 1초 동안 하나의 방사성 붕괴가 일어나는 양이며, 1 Ci = 3.7x10¹⁰ Bq이다. 공기 중의 라돈 농도는 Bq/m³나 pCi/L로 표시하며, 1 pCi/L는 37 Bq/m³ 에 해당한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H215-006",
      "term": "시버트(Sv)",
      "definition": "방사선이 살아있는 조직에 대한 영향이 방사선의 종류에 따라 다른 것을 참작하기 위하여 그레이(Gy)로 표시하는 방사선의 흡수선량에 방사선의 종류에 따른 가중계수를 곱한 방사선의 단위로 등가선량이라고 하며, 1 Sv는 1,000 mSv와 같다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
