  "checklistItems": [
    {
      "identifier": "CI-M153-001",
      "text": "가공목재 및 판재를 적재하는 장소는 고르고 평평하여야 하며 기울기는 2° 이내가 되도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 준비",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-002",
      "text": "가능하면 적재장소의 바닥은 콘크리트 또는 아스팔트 포설을 하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-003",
      "text": "적재장소는 적재하중과 운반차량 또는 기계의 무게를 견디도록 충분한 강도를 가지며 비 또는 눈 등 기후조건에 영향을 받지 않는 설비와 배수시설을 갖도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-004",
      "text": "적재장소에서 불안전한 적재를 야기하는 폐목재 또는 사용치 않는 받침대 등 장애물은 완전히 제거하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 준비",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-005",
      "text": "강풍에 의한 영향을 받을 수 있는 옥외 적재는 목재판 적재상자의 단면이 작은 부분이 주 풍향을 향하도록 배치하고 강풍 후에는 옥외적재상태를 점검하고 보호막을 견고히 고정하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.1",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-006",
      "text": "받침대(Bearer)는 적재상자를 지지하면서 지게차로 목재판 상자를 들어 올릴 수 있도록 지면과 충분한 공간을 가지고 있어야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "받침대 준비 및 배치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-007",
      "text": "받침대는 곧고 길이와 단면이 같은 것으로 이루어져야 하며 단면은 정사각형이 바람직하다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "받침대 준비 및 배치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-008",
      "text": "받침대 길이는 목재판 적재상자의 너비와 같도록 한다. 너무 길어 튀어나올 경우 적재물에 오르는데 사용할 위험이 있고 지나가는 차량과 부딪칠 위험도 있으며 또한 짧거나 단차가 있으면 상부의 적재상자를 충분히 지지하지 못한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "받침대 준비 및 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-009",
      "text": "받침대는 썩거나 갈라지는 등 결함이 있으면 제거하고 기후환경에 견딜 수 있도록 충분히 강한 재질로 만들도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "받침대 준비 및 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-010",
      "text": "받침대는 지지하는 적재상자의 관재를 기울게 하거나 처지는 것을 방지하도록 정확히 위치시키도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": "짧거나 정위치를 벗어나 단차가 진 받침대는 적재상자의 전도지선(Tipping line)이 상자단부로부터 안쪽으로 들어오게 되어 적재상자의 일부가 지지를 받지 못함",
      "workProcessPhase": "받침대 준비 및 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-011",
      "text": "묶기 전에 가공판재가 주위 저장조건에 따라 팽창할 것인지 수축할 것인지 고려하도록 한다. 수분을 많이 함유한 판재는 수축하여 묶음 띠(Band)가 느슨해져 다시 묶어야 할 경우가 있다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "띠묶기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-012",
      "text": "묶음 띠의 재료는 묶음 띠가 받게 될 부하조건에 맞도록 적절하게 선택하도록 한다. 예로서 12 mm폭 폴리에틸렌 묶음 띠는 단면이 0.5 ㎡이상이고 무게가 400 kg이상의 관재상자 묶음 띠로서 부적합하며 대신에 폴리에스테르 또는 강철 띠가 사용되어야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "띠묶기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-013",
      "text": "관재상자의 묶음 띠는 빈틈이 없이 단단히 묶어 고정하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "띠묶기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-014",
      "text": "띠묶기를 할 때 모서리의 막대 컬럼과 최대한 가까이서 상자 단면과 평행하게 묶도록 한다. 또한 묶음 띠의 꺾쇠(Fastener)는 띠재료에 적절한 것을 선택하여 사용한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "띠묶기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-015",
      "text": "묶음 띠를 제거할 때는 보안경을 착용하도록 한다. 탱탱하게 장력이 있는 강철띠를 자를 때에는 안전 절단기를 사용하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 내리기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-016",
      "text": "띠묶기 후 잘못된 묶음이 있는지 파악하여 느슨한 묶음이나 과도한 장력으로 묶여 포장상자 형태를 변형시키는지를 점검하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "띠묶기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-017",
      "text": "포장상자 내 목재는 가능한 한 동일단면적과 길이를 갖는 것들로 하고 목재가 상자 밖으로 튀어나오지 않도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-018",
      "text": "부분적 파손을 포함하여 파손된 포장상자는 적재하지 말고 재포장하도록 한다. 적재상태에서 파손된 경우에는 파손상자를 제거하고 안전작업절차에 따라 수행하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 검사",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-019",
      "text": "포장상자의 상부면은 수직적재가 되도록 레벨을 유지해야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-020",
      "text": "포장상자 상부면의 받침대는 평평하고 포장상자 단부에 위치시켜 안정적으로 위 상자를 지지하여야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.4",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-021",
      "text": "옥내에 포장상자를 적재하는 경우 적재 최대 높이는 포장상자의 짧은 폭의 4배 이하(비율 4:1)로 한다. 옥외적재의 경우 적재상자 높이는 바람의 영향을 받으므로 3:1 이하로 하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CARGO-005"
      ]
    },
    {
      "identifier": "CI-M153-022",
      "text": "실제 적재높이를 결정할 때는 위험성평가를 통하여 결정하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": "이동차량에 의해 적재물이 부딪힐 위험이 있는 장소, 적재기울기가 2° 이상인 경우 또는, 옥외에서 2:1 이내로 하도록 한다",
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-023",
      "text": "짧거나 정위치를 벗어난 받침대와 볼 형태 또는 롤 형태 포장물의 경우 지지되는 적재너비가 보이는 것과 달리 작으므로 적재 높이를 감소시켜야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.5",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-024",
      "text": "적재된 포장상자를 내리기 전에 불안정한 적재 여부, 묶음 띠의 파손여부, 받침대 상태, 포장상자가 불형태로 되는지 등을 점검하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 내리기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-025",
      "text": "적재된 포장상자는 하나씩 내려 동일한 레벨을 갖는 적재상태를 유지하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 내리기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-026",
      "text": "작업장소가 지상이고 안전한가를 확인하기 전에는 포장상자를 해체하여 개별 가공목재를 빼내지 않도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 내리기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-CARGO-003"
      ]
    },
    {
      "identifier": "CI-M153-027",
      "text": "적재의 최상부에 접근할 때에는 안전한 작업대를 가진 이동형 차량 또는 안전이 확보된 사다리, 안전작업대가 구비된 고소작업대를 이용하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 내리기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-M153-028",
      "text": "적재상부에서 포장의 해체 등 직접적 작업을 하지 않도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "포장상자 내리기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-FALL-001"
      ]
    },
    {
      "identifier": "CI-M153-029",
      "text": "적재하는 포장상자의 무게중심은 일직선상에 오게 하며 상자가 튀어나오지 않도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-030",
      "text": "적재 전에 포장상자의 형상과 크기를 고려하여 작고 가벼운 상자는 크고 무거운 상자 위에 적치하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-031",
      "text": "적재 시에는 다른 적재상자에 지지되거나 기대게 하여 적재하지 않도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "CI-M153-032",
      "text": "지게차의 포크가 화물의 폭보다 길면 들어 올릴 때 뒤에 있는 상자를 밀쳐 무너질 위험이 있으므로 작업 장소에 작업자 외의 출입을 막는 조치를 하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-033",
      "text": "창틀이나 문틀같이 평평한 판재의 목재품들은 평평한 표면에 뉘여서 적재하는 것이 좋으며 필요시 적절한 파레트(Pallet)를 사용하거나 전용 적재선반을 이용하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-034",
      "text": "관재의 목재품을 세울 때에는 넘어지지 않도록 끝에 적절한 지지대를 세워야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-035",
      "text": "흔히 지장장소로 운반하기 전에 임시 버팀목에 기대세울 경우 무너질 위험이 있으므로 주의를 표시하는 위험표지관을 설치하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "가공목재 및 판재 쌓기",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-036",
      "text": "적재선반은 바닥에 견고히 고정하고 최고적재중량을 표시하여 과적재를 하지 않도록 하고 주기적으로 손상여부를 점검하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "CI-M153-037",
      "text": "적재장소에 방문자의 출입이 예상될 때에는 출입 허가자 이외에는 접근하지 못하도록 울타리를 쳐야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M153-038",
      "text": "가급적 방문자들은 적재장소를 통과하지 않고 만남 장소로 가도록 안전통로의 안내 표시를 하여야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M153-039",
      "text": "위험성평가를 할 때에는 지게차와 차량 등이 적재장소 주위 및 안에서 어떻게 운행되고 있는지를 사전에 고려하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-040",
      "text": "적재장소는 보행자와 차량 등이 쉽게 볼 수 있는 장소로 정하고 필요 시 적재장소 주위에 반사거울을 설치하여 차량들의 사각지대가 없도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M153-041",
      "text": "보행자는 차량통행로와 분리된 지정된 통로를 사용하도록 하고 적절한 조도(75럭스 이상)의 조명을 설치해야 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "7",
      "basedOn": [
        "SR-CARGO-004"
      ]
    },
    {
      "identifier": "CI-M153-042",
      "text": "차량은 일방통행으로 하고 속도제한을 준수하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-043",
      "text": "차량 통행로는 적재된 차량무게를 충분히 견디도록 건설하고 운행 시 하중에 의해 파손된 경우는 바로 복구하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-044",
      "text": "차량후면의 제한된 시야를 보완하여 후진 시 경고음을 울리도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": "적재 장소 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-M153-045",
      "text": "작업자들은 안전모, 안전장갑, 및 안전화를 착용하고 차량통행이 빈번한 곳에서의 옥외작업에는 쉽게 눈에 띄도록 반사띠를 갖춘 복장을 하도록 한다.",
      "guideContext": "가공목재 및 판재의 적재",
      "additionalDetail": null,
      "workProcessPhase": null,
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M153-001",
      "term": "받침대(Bearer)",
      "definition": "적재상자를 지지하고 지게차 등으로 목재판 상자를 적재하거나 하적할 수 있도록 충분한 단면을 가진 목재로 된 막대기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M153-002",
      "term": "전도지점(Tipping point)",
      "definition": "받침대 바깥단부가 적재상자와 접촉하는 점을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M153-003",
      "term": "전도지선(Tipping line)",
      "definition": "받침대와 적재상자의 전도지점을 연결하는 선을 말하며 전도지선 너비(지지너비)가 클수록 적재상자는 안전하다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M153-01",
      "processOrder": 1,
      "processName": "적재 장소 준비",
      "safetyMeasures": "적재장소는 고르고 평평하여야 하며 기울기 2° 이내로 하고, 콘크리트 또는 아스팔트 포설을 하며, 적재하중과 운반차량 무게를 견디도록 충분한 강도를 확보하고, 배수시설을 갖추며, 폐목재 등 장애물을 완전히 제거한다.",
      "requiredPPE": [
        "안전모",
        "안전화"
      ],
      "sourceSection": "4.1",
      "relatedSR": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "WP-M153-02",
      "processOrder": 2,
      "processName": "받침대 준비 및 배치",
      "safetyMeasures": "받침대는 곧고 길이와 단면이 같은 것을 사용하며, 길이는 적재상자 너비와 동일하게 하고, 결함이 있는 받침대는 제거하며, 적재상자의 관재가 기울거나 처지지 않도록 정확히 위치시킨다.",
      "requiredPPE": [
        "안전장갑",
        "안전화"
      ],
      "sourceSection": "4.2",
      "relatedSR": [
        "SR-CARGO-007"
      ]
    },
    {
      "identifier": "WP-M153-03",
      "processOrder": 3,
      "processName": "포장상자 검사 및 띠묶기",
      "safetyMeasures": "포장상자 내 목재는 동일단면적과 길이로 하고, 파손된 상자는 재포장하며, 묶음 띠 재료는 부하조건에 맞게 선택하고 빈틈없이 단단히 묶어 고정한 후 느슨한 묶음이나 과도한 장력 여부를 점검한다.",
      "requiredPPE": [
        "보안경",
        "안전장갑"
      ],
      "sourceSection": "4.3",
      "relatedSR": [
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "WP-M153-04",
      "processOrder": 4,
      "processName": "가공목재 및 판재 쌓기(적재)",
      "safetyMeasures": "무게중심을 일직선상에 배치하고, 작고 가벼운 상자는 위에 적치하며, 다른 상자에 기대 적재하지 않고, 옥내 4:1 옥외 3:1 이하의 적재높이를 준수하며, 위험성평가를 통해 실제 높이를 결정한다. 지게차 포크가 화물 폭보다 길 경우 출입 통제 조치를 한다.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "안전장갑"
      ],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-CARGO-007",
        "SR-CARGO-005",
        "SR-CARGO-006"
      ]
    },
    {
      "identifier": "WP-M153-05",
      "processOrder": 5,
      "processName": "포장상자 내리기(하역)",
      "safetyMeasures": "내리기 전 불안정한 적재 여부·묶음 띠 파손여부·받침대 상태를 점검하고, 하나씩 내려 동일 레벨을 유지하며, 최상부 접근 시 이동형 차량·사다리·고소작업대를 이용하고, 적재상부에서 직접 작업을 하지 않는다.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "보안경"
      ],
      "sourceSection": "5.1",
      "relatedSR": [
        "SR-CARGO-006",
        "SR-FALL-001",
        "SR-CARGO-003"
      ]
    },
    {
      "identifier": "WP-M153-06",
      "processOrder": 6,
      "processName": "적재장소 관리 및 배치",
      "safetyMeasures": "보행자와 차량 통로를 분리하고 75럭스 이상 조명을 설치하며, 차량 일방통행 및 속도제한을 준수하고, 반사거울을 설치하여 사각지대를 제거하며, 출입 허가자 외 접근 금지 울타리와 안전통로 안내표시를 설치한다.",
      "requiredPPE": [
        "안전모",
        "안전화",
        "반사띠 복장"
      ],
      "sourceSection": "7",
      "relatedSR": [
        "SR-CARGO-004"
      ]
    }
  ],
