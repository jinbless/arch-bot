  "checklistItems": [
    {
      "identifier": "CI-P133-001",
      "text": "공정의 안전성 확보와 기기 및 설비의 보호를 위해 필요한 경우 해당되는 부분에 대하여만 실시한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 신설/수정/삭제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-002",
      "text": "단위공장의 운전책임자는 인터록의 신설, 수정 및 삭제가 필요한 경우에 변경관리절차에 따라 변경관리요청서를 작성하여 변경관리위원회에 상정한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 신설/수정/삭제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-003",
      "text": "변경관리 요청서에는 인터록의 신설, 수정 및 삭제 사유와 인터록의 변경이 표시된 공정배관계장도면(P&ID) 및 인터록 로직 도면(Interlock logic diagram) 등을 기록한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 신설/수정/삭제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-004",
      "text": "변경관리위원회는 인터록의 신설, 수정 및 삭제 시 발생될 수 있는 위험성, 인터록 변경이 실시되는 설비 및 장치의 설계치, 위험성 평가를 실시한 후 추가적인 보완장치의 필요성 등을 검토한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 신설/수정/삭제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-005",
      "text": "변경관리위원회는 인터록의 변경 시 관련 전문가의 의견을 청취한 후 기록하고, 위험성 평가를 통하여 도출된 추가적인 보완사항을 반영한 변경관리계획을 승인한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 신설/수정/삭제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-006",
      "text": "인터록의 변경작업은 가능한 정기보수 기간을 이용하여 실시하여야 하고, 공장운전 중에 작업하는 경우에는 작업 시 발생할 수 있는 위험에 대비한 유사한 인터록 확보와 인터록 우회작업을 통한 안전성 확보를 준수하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 신설/수정/삭제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-007",
      "text": "인터록이 변경된 경우에는 반드시 작동시험을 통하여 정상적인 작동 유무를 확인하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 신설/수정/삭제",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-008",
      "text": "단위공장 운전책임자는 인터록 설정값의 변경이 필요한 경우 변경관리요청서를 작성하여 변경관리위원회에 상정한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 설정값 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-009",
      "text": "변경관리 요청서에는 인터록 설정값 변경 사유와 인터록 설정값이 표기된 인터록 로직 도면 및 ESD 계기 데이터 등을 기록한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 설정값 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-010",
      "text": "변경관리위원회는 인터록 설정값 변경 시 발생될 수 있는 위험성, 인터록 설정값 변경이 실시되는 설비 및 장치의 설계치, 위험성 평가를 실시한 후 추가적인 보완장치의 필요성, 인터록 설정값과 알람값의 간격을 검토한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": "설정값은 반드시 알람값에 의하여 알람이 작동된 다음 값으로 결정하여야 한다",
      "workProcessPhase": "인터록 설정값 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-011",
      "text": "인터록 설정값은 반드시 알람값에 의하여 알람이 작동된 다음 값으로 결정하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 설정값 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-012",
      "text": "현장 스위치를 교체하는 경우에는 작업 시 설정값의 일치 여부를 확인한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 설정값 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-013",
      "text": "인터록 설정값 변경 시 발생될 수 있는 위험을 최소화하기 위하여 관련 인터록 항목(Item)을 우회시킨 다음에 실시한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 설정값 변경",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-014",
      "text": "인터록 로직 및 설정값 변경과 관련 변경관리위원회의 자료는 5년간 보관하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-015",
      "text": "인터록 로직 및 설정값 변경과 관련하여 공정배관계장도면(P&ID) 및 인터록 로직 도면, 인터록 시퀀스 도면, 운전절차서, 인터록 및 ESD 계기 데이터 등 추가적인 기술자료의 변경이 필요한 것은 그 결과를 확인하여 최신본으로 관리하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-016",
      "text": "상기 원인이 소멸되었을 경우에는 인터록 우회를 즉시 해지하여 정상화하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 및 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-017",
      "text": "공장의 정상운전 시 계기의 오작동 및 작업 등으로 인터록의 우회가 필요한 경우에는 인터록 우회가 안전에 영향이 없는지를 확인하고, 승인자의 승인을 얻은 다음에 작업부서에 작업허가서 형태로 요청한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상운전 시 우회",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-018",
      "text": "작업 요청부서는 작업의 안전한 진행을 위하여 입회자를 배치시킨다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상운전 시 우회",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-019",
      "text": "작업자는 입회자로부터 작업시작 허가를 얻은 후 작업을 수행하되, 한 가지 작업이 완료되면 작업결과에 대하여 이상 유무를 입회자에게 확인하고, 입회자의 다음 작업지시에 따라 다음 작업을 수행한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상운전 시 우회",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-020",
      "text": "작업이 완료되면 작업자는 작업승인자(또는 입회자)에게 작업이 완료되었음을 통보하고, 작업승인자(또는 입회자)는 이를 확인한 후 작업허가서에 완료 서명을 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상운전 시 우회",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-021",
      "text": "인터록 우회 공정의 안전운전을 위하여 우회 기기에 대한 설정값의 변경은 불가하며, 현장 점검활동을 강화하여 운전값이 설정값을 이탈하지 않도록 하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "정상운전 시 우회",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-022",
      "text": "인터록 우회 스위치가 있는 경우에 긴급상황의 발생으로, 공정의 연속적인 안전운전이 불가능하고, 재해의 발생 가능성이 높아서 우회작업을 요청하거나, 절차에 따를 시간적인 여유가 없는 경우에 단위공장 운전책임자는 즉시 인터록을 우회하여 공정의 안전화를 유도하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": "야간근무 시에 운전책임자의 결정이 어려운 경우에는 단위공장 교대조 책임자가 수행할 수 있다",
      "workProcessPhase": "긴급사항 발생 시 우회",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-023",
      "text": "인터록 스위치가 없는 경우에 점퍼작업에 의한 인터록 우회를 작업부서에 즉시 요청하여 조치하도록 하고, 그 결과를 승인자에게 사후에 보고하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "긴급사항 발생 시 우회",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-024",
      "text": "인터록 우회 해지를 위하여 단위공장 운전책임자는 우회된 모든 인터록의 원인 소멸과 공정의 정상화를 위하여 노력하고, 조속히 우회를 해지하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-025",
      "text": "오작동에 의한 이상 발생 시 오작동 발생요인이 완전 제거되면 즉시 해지한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-026",
      "text": "작업자는 우회할 항목에 대해 설정값이 정확한지를 우선적으로 점검하고, 이상이 없을 경우에 우회를 해지한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-027",
      "text": "인터록 우회가 신호전송 캐비닛에서 점퍼작업 형태로 진행된 경우 1주에 1회 이상 신호전송 캐비닛의 점퍼가 인터록 관리대장 내용과 일치하는지 확인하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-028",
      "text": "인터록 우회가 현장 스위치에 의하여 진행된 경우에는 해당 스위치에 식별표시를 하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-029",
      "text": "인터록 우회기간은 우회를 하더라도 공정 및 안전에 위험요인이 없는 경우, 동일한 목적의 다른 로직이 존재하는 경우, 장치 및 설비의 교체와 보수작업의 경우를 제외하고, 1일을 초과하지 않도록 하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-030",
      "text": "우회기간이 1일을 초과하는 경우에는 그 사유와 추가 안전조치 등의 방안을 기록하여 사업장 안전관리 총괄자의 승인을 얻어야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-031",
      "text": "인터록 우회 및 해지 사항은 교대근무 시에 발생한 경우 반드시 기록으로 다음 교대조에 인수인계를 하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-032",
      "text": "작업승인자는 작업 항목 결정 및 승인, 작업입회자 결정 및 승인, 작업 시 안전조치 사항 승인, 작업완료 최종 승인의 책임을 수행하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 및 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-033",
      "text": "작업입회자는 작업 전 안전조치 사항 확인, 작업개시 지시 및 불안전 요소 발견 시 작업중지 명령, 작업결과 현장 확인, 작업 후 안전조치 사항 및 작업 완료 확인의 책임을 수행하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 및 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-034",
      "text": "작업자는 작업허가서에 따른 안전사항 준수, 작업내용 숙지 및 절차 준수, 작업결과 확인 및 결과 보고의 의무를 수행하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 우회 및 해지",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-035",
      "text": "인터록 우회 관리를 위하여 인터록 우회관리대장을 작성하여 운영하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-036",
      "text": "인터록 우회를 실질적으로 실행하고 정상화하는 단위공장 교대조 책임자는 인터록 우회관리대장을 작성하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-037",
      "text": "인터록 우회관리대장에는 일련번호와 인터록 항목명, 사유, 우회 시 예상되는 영향(문제점), 대책 등, 우회 실시 날짜, 우회 실시 기록자와 책임자(단위공장 운전책임자)의 서명, 우회 해지 시 해지일자 및 기록자와 책임자의 서명과 서명일자를 기록하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-038",
      "text": "기록된 인터록 우회관리대장은 공장 조정실에 비치하여 교대조를 비롯한 모든 근무자가 알 수 있도록 인수인계를 하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "기록 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-039",
      "text": "인터록 설정값이 프로그램 및 계측기 입력값에 의한 작동으로 변경되는 경우에는 분산제어시스템(DCS) 등의 판넬에서 변경이 가능하므로, 열쇠(Key)를 사용하여 변경모드에 접근하는 경우에는 작업부서 책임자와 현장 단위공장 운전책임자가 열쇠를 관리하도록 하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 보안",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-040",
      "text": "암호형식으로 변경모드에 접근하는 경우에는 작업부서 책임자와 현장 단위공장 운전책임자만 인지할 수 있도록 암호를 관리하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 보안",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-P133-041",
      "text": "인터록 우회작업이 릴레이 판넬에서 점퍼작업 형태로 이루어지는 경우에는 릴레이 판넬의 잠금장치를 작업부서 책임자 및 단위공장 교대조 책임자가 관리하도록 하여야 한다.",
      "guideContext": "화학공장의 인터록 관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "인터록 보안",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-P133-001",
      "term": "인터록 (Interlock)",
      "definition": "기기장치, 설비 및 공정의 안전성 확보와 공정의 안전운전을 위하여 설치되는 하드웨어 및 소프트웨어적 제어장치를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-002",
      "term": "설정값 (Set value)",
      "definition": "운전변수가 변화하다가 운전값이 일정한 수준에 도달하면 인터록이 작동되어 장치 또는 공정을 안전한 방향으로 유도되도록 계기 또는 프로그램에 설치된 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-003",
      "term": "알람값 (Alarm value)",
      "definition": "운전변수가 변화하다가 그 값이 일정한 수준에 도달하면 설비의 안전한 운영을 위하여 경보형식 등으로 인지가 가능하도록 계기 또는 프로그램에 설치된 값을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-004",
      "term": "우회 (Bypass)",
      "definition": "인터록 장치를 정상적으로 작동되지 않도록 조작하는 행위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-005",
      "term": "해지 (Release)",
      "definition": "우회시켰던 인터록 장치를 설계의 개념에 준하여 인터록이 정상적으로 작동되도록 조치하는 행위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-006",
      "term": "점퍼 (Jumper) 작업",
      "definition": "인터록 우회 스위치가 설치되어 있지 않은 인터록의 변환에 필요한 제반작업을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-007",
      "term": "로직 (Logic)",
      "definition": "공정에 따라 순차적으로 처리되어야 할 일련의 흐름상태를 쉽게 파악할 수 있도록 공정조건과 실행순서에 따라 기호로 나타낸 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-008",
      "term": "시퀀스 (Sequence)",
      "definition": "로직을 기초로 하여 그 흐름도를 전기적인 기호로 나타낸 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-P133-009",
      "term": "ESD (Emergence shut down) 계기",
      "definition": "인터록에 의해 공정 및 개별 장치를 비상으로 중지시키는 계기를 총칭하여 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-P133-01",
      "processOrder": 1,
      "processName": "인터록 신설/수정/삭제 절차",
      "safetyMeasures": "변경관리요청서 작성 → 변경관리위원회 상정 → 위험성 검토 및 전문가 의견 청취 → 변경관리계획 승인 → 정기보수 기간 이용 시행(운전 중 시 유사 인터록 확보 및 우회작업 통한 안전성 확보) → 작동시험 확인",
      "requiredPPE": [],
