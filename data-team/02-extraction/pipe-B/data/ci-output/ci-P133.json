    {
      "identifier": "WP-P133-03",
      "processOrder": 3,
      "processName": "정상운전 시 인터록 우회 절차",
      "safetyMeasures": "안전 영향 확인 → 승인자 승인 → 작업허가서 형태로 요청 → 작업부서 책임자 작업승인 → 입회자 배치 → 작업시작 허가 후 작업 수행 → 작업결과 확인 → 작업완료 통보 및 서명 → 우회 기기 설정값 변경 불가, 현장 점검활동 강화",
      "requiredPPE": [],
      "sourceSection": "5.2.2",
      "relatedSR": null
    },
    {
      "identifier": "WP-P133-04",
      "processOrder": 4,
      "processName": "긴급사항 발생 시 인터록 우회 절차",
      "safetyMeasures": "우회 스위치 있는 경우: 단위공장 운전책임자가 즉시 우회하여 공정 안전화 유도(야간 시 교대조 책임자 수행 가능). 우회 스위치 없는 경우: 점퍼작업에 의한 우회를 작업부서에 즉시 요청, 결과를 승인자에게 사후 보고",
      "requiredPPE": [],
      "sourceSection": "5.2.3",
      "relatedSR": null
    },
    {
      "identifier": "WP-P133-05",
      "processOrder": 5,
      "processName": "인터록 우회 해지 절차",
      "safetyMeasures": "작업허가서 형태로 우회 해지 요청 → 입회자 배치 → 설정값 정확성 우선 점검 → 이상 없을 경우 해지 → 작업결과 확인 → 작업완료 통보 및 서명 → 점퍼작업 형태 시 1주 1회 이상 관리대장 일치 확인 → 현장 스위치 우회 시 식별표시 → 우회기간 1일 초과 시 안전관리 총괄자 승인",
      "requiredPPE": [],
      "sourceSection": "5.2.4",
      "relatedSR": null
    }
