  "checklistItems": [
    {
      "identifier": "CI-H177-001",
      "text": "공학적 관리는 진동의 특성, 흡수재의 특성, 사업장 여건 등을 고려하여 신중히 검토 한 후 적용하여야 한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "공학적 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-002",
      "text": "지그(Jig) 및 현가시스템(Suspension) 등을 사용하여 무거운 공구를 견고하게 잡아야 할 필요를 줄인다. 예를 들면, 반복적인 작업을 하기 위해 워크스테이션에 무거운 연삭기를 사용하는 경우, 카운터 밸런스(Counter balance) 시스템을 사용하여 이를 매달아 작업자에 미치는 작업부담이나 손에 힘을 주어 쥐어야 하는 필요성을 줄인다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "공학적 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-003",
      "text": "진동 수공구는 적절하게 유지보수하고 진동이 많이 발생되는 기구는 교체한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-004",
      "text": "제조사가 권장하는 사용기한을 준수하고 유지 보수 프로그램을 도입한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-005",
      "text": "작업시간은 매 1시간 연속 진동노출에 대하여 10분 휴식을 한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-006",
      "text": "지지대를 설치하는 등의 방법으로 작업자가 작업공구를 가능한 적게 접촉하게 한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-007",
      "text": "가능한 공구는 낮은 속력에서 작동될 수 있는 것을 선택한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-008",
      "text": "작업자가 진동에 노출되는 시간을 제한한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-009",
      "text": "작업자들이 장시간, 지속적으로 진동에 노출되는 것을 피하도록 작업 계획을 세운다. 단시간 여러번 노출되는 것이 더 유리하다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-010",
      "text": "순번을 정해 작업하여 노출 시간을 적절히 제한한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "작업 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-011",
      "text": "작업자가 적정한 체온을 유지할 수 있게 관리한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-012",
      "text": "손은 따뜻하고 건조한 상태를 유지한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-013",
      "text": "방진장갑 등 진동보호구를 착용하여 작업한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-006"
      ]
    },
    {
      "identifier": "CI-H177-014",
      "text": "손가락의 진통, 무감각, 창백화 현상이 발생되면 즉각 전문 의료인에게 상담한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-015",
      "text": "니코틴은 혈관을 수축시키기 때문에 진동공구를 조작하는 동안 금연한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-016",
      "text": "관리자와 작업자는 국소진동에 대하여 건강상 위험성을 충분히 알고 있어야 한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-007"
      ]
    },
    {
      "identifier": "CI-H177-017",
      "text": "작업자들에게 필요한 경우 보호 의류를 제공하여 따뜻하고 건조한 상태를 유지하도록 한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-006"
      ]
    },
    {
      "identifier": "CI-H177-018",
      "text": "손을 따뜻하게 보호하기 위해 장갑을 사용할 수 있다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "건강 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-019",
      "text": "진동장해 예방 프로그램을 수립한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "진동작업 예방 프로그램",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-H177-020",
      "text": "관리감독자, 작업자 및 노조의 안전 담당자 또는 작업자 대표와 국소장해 예방 프로그램에 대해 함께 논의하는 것이 중요하다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "진동작업 예방 프로그램",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-021",
      "text": "진동장해 예방 프로그램이 작업자들의 이익을 보호하기 위한 것임을 설명한다.",
      "guideContext": "국소진동공구 취급근로자 보건관리",
      "additionalDetail": null,
      "workProcessPhase": "진동작업 예방 프로그램",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.5",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-022",
      "text": "사용하는 공구의 형식, 모델명, 제조업자등을 알고 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "진동공구 특성 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-023",
      "text": "사용하는 공구의 구입일자와 발생되는 고유 주파수 및 진동 가속도를 알고 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": "공구의 구입일자는 사용연한과 관련하여 매우 중요합니다. 장기간 사용하여 내구성이 떨어진 공구는 더 많은 진동과 소음을 발생시킨다.",
      "workProcessPhase": "진동공구 특성 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-024",
      "text": "공구와 관련된 기록은 잘 보관되고 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": "미국 NIOSH에서는 진동측정과 관련된 자료는 30년, 작업자의 의학적인 기록에 대한 자료는 고용기간+30년 동안 자료를 보관할 것을 권장하고 있다.",
      "workProcessPhase": "진동공구 특성 확인",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-025",
      "text": "사용하는 공구의 무게는 적합합니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": "공구는 가벼울수록 좋다. 그러나 너무 가볍게 되면 사용 중 반발력이 커져 위험 할 수도 있고 오히려 진동 및 소음의 크기가 더 커질 수도 있으므로 선택 시 주의한다.",
      "workProcessPhase": "진동공구 적합성 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-026",
      "text": "사용하는 공구의 손잡이 두께는 적합합니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "진동공구 적합성 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-027",
      "text": "공구의 손잡이 재질은 진동을 흡수 할 수 있는 재질(고무 혹은 목재 등)로 되어있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "진동공구 적합성 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-028",
      "text": "공구의 손잡이 재질은 너무 차갑지 않은 재질로 되어 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "진동공구 적합성 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-029",
      "text": "진동공구는 주기적으로 수리(기름칠 등)되고 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "진동공구 적합성 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-030",
      "text": "공구의 손잡이 방향은 손목이 비틀어지거나 꺾이지 않는 방향으로 되어 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "진동공구 적합성 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-031",
      "text": "1시간 작업에 10분 이상의 휴식시간이 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 및 작업자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-032",
      "text": "작업장 온도는 14도 이상으로 유지되고 있습니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": "진동공구를 사용하는 작업장이 저온일 때는 혈액순환이 잘 이루어지지 않아 진동 장해의 위험성이 더 커진다.",
      "workProcessPhase": "작업환경 및 작업자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "점검 체크리스트",
      "basedOn": null
    },
    {
      "identifier": "CI-H177-033",
      "text": "진동공구 작업 시 진동을 흡수 할 수 있는 재질의 장갑(고무장갑 등)을 착용합니까?",
      "guideContext": "국소진동공구 점검 체크리스트",
      "additionalDetail": null,
      "workProcessPhase": "작업환경 및 작업자 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "점검 체크리스트",
      "basedOn": [
        "SR-NOISE-006"
      ]
    },
    {
      "identifier": "CI-H177-034",
      "text": "착용하는 장갑은 손에 잘 맞아 작업에 방해가 되지는 않습니까?",
