  "checklistItems": [
    {
      "identifier": "CI-M75-001",
      "text": "배출 소음기의 설계시 배압이 발생되지 않도록 해야 한다.",
      "guideContext": "공압 시스템 배출 소음기 적용",
      "additionalDetail": "배압의 증가는 공압 시스템의 오동작 위험이 있음",
      "workProcessPhase": "배출 소음기 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-002",
      "text": "소음기의 공기흐름 중에 막힘이 없도록 해야 한다.",
      "guideContext": "공압 시스템 배출 소음기 적용",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-003",
      "text": "소음기를 선택할 때에는 배압을 검토하여 선정해야 한다.",
      "guideContext": "공압 시스템 배출 소음기 적용",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-004",
      "text": "소음기의 막힘은 배압증가의 기본적인 원인이므로 올바른 설치와 유지보수를 해야 한다.",
      "guideContext": "공압 시스템 배출 소음기 적용",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-005",
      "text": "충전재의 투과성을 조절하여 배압과 소음감소정도의 균형을 조절해야 한다.",
      "guideContext": "배출 소음기 소음감소 기술",
      "additionalDetail": "소음기의 내부는 작은 구멍크기의 조밀한 소결 플라스틱으로 채워져 있음",
      "workProcessPhase": "배출 소음기 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-006",
      "text": "압축공기를 배출하는 공압 배기관이 오염되어 소음기가 막힐 가능성이 있는 경우에는 좀더 큰 용량의 소음기를 사용하거나, 오염된 공기가 흐르지 않도록 필터를 설치한다.",
      "guideContext": "배출 소음기 소음감소 기술",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-007",
      "text": "맴브레인으로 이루어진 소음기는 18 dB(A)의 소음감소를 제공하는 재료가 효과적이며, 구멍의 크기를 크게 하고 여러 겹의 금속그물로 구성되어 있어야 한다.",
      "guideContext": "배출 소음기 소음감소 기술",
      "additionalDetail": "오염물질에 강하며 적당한 용매에 행구어 쉽게 청소할 수 있음",
      "workProcessPhase": "배출 소음기 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-008",
      "text": "기계에 소음기를 설치할 때에는 배기가스를 청결하게 관리해야 한다.",
      "guideContext": "배출 소음기 설치와 유지",
      "additionalDetail": "생산과정에서 발생되는 먼지와 이물질이 섞인 배기가스는 소음기 내에 두꺼운 납유리 침전물을 형성하여 공압장비 손상 가능성이 있음",
      "workProcessPhase": "배출 소음기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-009",
      "text": "소음기를 설치할 때에는 수평 혹은 거꾸로 설치해야 한다.",
      "guideContext": "배출 소음기 설치와 유지",
      "additionalDetail": "수직으로 설치하면 응축된 오염물질이 공기의 흐름을 방해할 뿐만 아니라 배기관과 조절 밸브에 고장을 초래하여 오일플러그를 발생시킴",
      "workProcessPhase": "배출 소음기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-010",
      "text": "기계적인 충격으로 인한 소음기의 파손을 예방하기 위해 소음기는 최소한으로 돌출시켜야 하며 충돌로부터 안전한 곳에 위치시켜야 한다.",
      "guideContext": "배출 소음기 설치와 유지",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-011",
      "text": "플라스틱 본체로 된 소음기는 특히 충격에 의한 손상을 입지 않도록 설치한다.",
      "guideContext": "배출 소음기 설치와 유지",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-012",
      "text": "소음기의 막힘은 결과적으로 공압기계 본체의 생산 효율을 감소시키므로 주기적인 청소를 실시해야 하며, 청소가 불가능한 경우 즉시 교체해야 한다.",
      "guideContext": "배출 소음기 설치와 유지",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-013",
      "text": "모든 소음기는 외부에 붙어있는 이물질을 청소해야 하며, 큰 구멍의 맴브레인을 사용하는 소음기는 흡음물질 깊숙이 파묻힌 오염물질을 청소해야 한다.",
      "guideContext": "소음기의 청소방법",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 청소",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-014",
      "text": "다공성 플라스틱(특히 소결 폴리에틸렌)을 사용하는 소음기는 염소화 탄화수소로 된 용매로 청소할 수 없다.",
      "guideContext": "소음기의 청소방법 (법령 근거 미확인)",
      "additionalDetail": "금속 소음기는 통상적으로 구할 수 있는 용매로 청소 가능",
      "workProcessPhase": "배출 소음기 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M75-015",
      "text": "와이어 브러쉬는 소음기에 손상을 줄 수 있기 때문에 사용하지 않는다.",
      "guideContext": "소음기의 청소방법 (법령 근거 미확인)",
      "additionalDetail": "거친 솔이나 나일론 브러쉬를 사용하여 문지름",
      "workProcessPhase": "배출 소음기 청소",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": null
    },
    {
      "identifier": "CI-M75-016",
      "text": "흡음처리 된 배기구의 최고 소음 레벨은 적어도 흡음처리가 되지 않은 배기구 보다 18 dB(A) 가량 감소되는 것이 좋으며 공기흐름 조건에 맞는다면 더 큰 소음감소일수록 좋다.",
      "guideContext": "소음기의 선택시 고려사항",
      "additionalDetail": "대부분의 상황에서 25dB(A) 이상의 소음감소는 배경소음레벨 이하로 배출소음을 감소시킴",
      "workProcessPhase": "배출 소음기 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-017",
      "text": "항상 일정한 유속을 유지할 수 있도록 하여 밸브와 장치가 설계속도에서 작동되도록 하여야 한다.",
      "guideContext": "소음기의 선택시 고려사항",
      "additionalDetail": "오염된 공기배관 속에서는 유속이 점점 느려지게 됨",
      "workProcessPhase": "배출 소음기 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.6",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-018",
      "text": "적당한 소음기를 선택하기 위해서는 장비제조사의 설계 안내서에 명시되어있는 유속 자료를 확인하고 이에 적합한 소음기를 선택해야 한다.",
      "guideContext": "소음기의 선택 과정",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-019",
      "text": "소음기가 오염된 공기배관이나 마찰클러치 파워프레스나 프레스 브레이크의 공압제어에 설치되어 있는 경우는 배출되는 공기를 최소한으로 제한하고 오래 사용할 수 있으며 유지관리가 필요 없는 소음기를 선택해야 한다.",
      "guideContext": "소음기의 선택 과정",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 선택",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-020",
      "text": "압축공기 분출 노즐은 압축공기 내의 오염원을 수용할 수 있는 충분한 크기의 오리피스(Orifice)를 설치해야 한다.",
      "guideContext": "압축공기 분출기 설치와 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "압축공기 분출 노즐 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-021",
      "text": "정기적인 점검과 청소를 통해 막힘이 없도록 유지해야 한다.",
      "guideContext": "압축공기 분출기 설치와 유지관리",
      "additionalDetail": "압축공기 분출 노즐 관련",
      "workProcessPhase": "압축공기 분출 노즐 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-022",
      "text": "공기의 속도를 줄이기 위한 압력 강하 맴브레인을 사용한다면 오염된 공기배관에 사용되면 안되며, 막히지 않도록 정기적인 점검과 청소를 해야 한다.",
      "guideContext": "압축공기 분출기 설치와 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "압축공기 분출 노즐 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-023",
      "text": "코안다의 유입 원리를 사용하는 노즐은 노즐 말단 마개(Nozzle termination plug)가 있어야 하며, 이러한 마개는 충격으로 인해 헐거워질 수 있기 때문에 정기적인 검사를 해야 한다.",
      "guideContext": "압축공기 분출기 설치와 유지관리",
      "additionalDetail": "만일 헐거워진 노즐 말단 마개가 작업에 이용된다면 노즐의 끝은 발사체가 될 수 있음",
      "workProcessPhase": "압축공기 분출 노즐 유지관리",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-024",
      "text": "공기 분출구로부터 발생하는 소음을 줄이는 추가적인 방법은 에어젯이 필요한 주기 동안에만 작동되도록 작동주기를 변경하는 것이다.",
      "guideContext": "압축공기 분출기 설치와 유지관리",
      "additionalDetail": null,
      "workProcessPhase": "압축공기 분출기 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M75-025",
      "text": "만일 소음기를 설치해야 하는 기계에 배압이 문제가 되지 않는다면 소음감소의 효율이 좋고 저렴한 소음기를 선택하는 것이 좋다.",
      "guideContext": "소음기의 선택 과정",
      "additionalDetail": null,
      "workProcessPhase": "배출 소음기 선택",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.7",
      "basedOn": [
        "SR-NOISE-001"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M75-001",
      "term": "공압 시스템",
      "definition": "기계장치의 구동이 압축공기에 의해 작동되는 시스템을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M75-002",
      "term": "노즐",
      "definition": "액체 또는 기체를 고속으로 자유공간에 분출시키기 위해 유로 끝에 다는 가는 관을 말한다. 단면적이 흐름 방향으로 작아지도록 끝으로 갈수록 가늘어지며 유체의 높은 압력을 속도로 바꾸는 역할을 한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M75-003",
      "term": "제트",
      "definition": "증기나 액체, 기체 등이 좁은 구멍에서 고속으로 분출되는 상태를 말한다. 제트의 내부는 다른 곳보다 압력이 낮기 때문에 유체가 그 안으로 흘러 들어가게 된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M75-004",
      "term": "배경소음",
      "definition": "혼잡한 거리에서 들리는 차 소리나 사람 음성등의 소음처럼 배경의 소리에 혼합되어 구분하기 힘든 음향을 말한다. 어떠한 소리가 배경소음 이하로 낮아진다면 구분하기 힘들거나 잘 들리지 않게 된다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M75-01",
      "processOrder": 1,
      "processName": "배출 소음기 선택",
