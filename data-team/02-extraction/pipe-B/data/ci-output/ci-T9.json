  "checklistItems": [
    {
      "identifier": "CI-T9-001",
      "text": "석면노출수준을 평가하기 위하여 석면소체를 계수할 경우 종앙부를 제외한 일정량 이상의 폐실질 조직을 사용한다.",
      "guideContext": "생체시료 중 석면소체 및 석면섬유 분석 (법령 근거 미확인)",
      "additionalDetail": "폐실질 조직 이외의 종앙부, 림프절, 흉막(흉막반 포함)의 조직에 함유된 석면소체에 대해서는 폐실질조직과 같은 평가방법이 확립되어 있지 않기 때문에 노출평가에 부적합하다.",
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-002",
      "text": "포르말린 고정조직 : 폐조직을 중성완충포르말린에 고정한다.",
      "guideContext": "생체시료 중 석면소체 및 석면섬유 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 보존",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-003",
      "text": "파라핀 포매조직 : 폐조직을 파라핀에 고정한 것으로 0.2∼0.3 ㎝ 이상(건조중량 0.05 g 이상)의 조직이 필요하다.",
      "guideContext": "생체시료 중 석면소체 및 석면섬유 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 보존",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-004",
      "text": "폐의 좌우 각 엽에서 폐벽측에 가까운 부분의 실질조직을 약 5 부위 정도 채취하는 것이 좋다.",
      "guideContext": "부검 폐 시료 채취",
      "additionalDetail": "0.5∼1 g 정도로 같은 양을 1 개의 시료로 취급한다.",
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-005",
      "text": "1 부위를 채취할 경우 하부의 말단조직에서 2∼5 g 정도 채취한다.",
      "guideContext": "부검 폐 시료 채취 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-006",
      "text": "수술제거 폐 하부의 말단조직에서 2∼5 g 정도 채취한다.",
      "guideContext": "수술제거 폐 시료 채취 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 채취",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-007",
      "text": "포매한 조직절편을 수 ㎜로 잘라 크실렌에 24시간 이상 두어 탈파라핀을 한 후 에탄올로 세정한다.",
      "guideContext": "파라핀 포매 폐 시료 전처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 전처리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-008",
      "text": "채취한 조직은 기관지와 혈관부분을 피하여, 정상 폐실질조직을 메스를 이용하여 수 ㎜ 크기로 잘게 자른다.",
      "guideContext": "생체시료 중 석면소체 및 석면섬유 분석 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 세절",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-009",
      "text": "시료를 건조기로 110℃에서 2∼4시간 건조한 후 중량을 측정한다.",
      "guideContext": "시료 중량 측정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 중량 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-010",
      "text": "건조한 시료를 50 ㎖ 원심분리관에 넣어, 조직소화액 30 ㎖를 가한다. 시료의 양이 2 g이 넘으면 소화액의 양을 습중량 1 g에 15 ㎖을 기준으로 늘인다.",
      "guideContext": "조직 소화 처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-011",
      "text": "마개를 덮은 원심분리관을 60℃ 건조기에서 수 시간 정도 두어 조직덩어리가 완전히 없어질 때까지 소화한다.",
      "guideContext": "조직 소화 처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-012",
      "text": "소화한 시료를 3,000 rpm에서 30분간 원심분리한 후 피펫을 사용하여 상층액을 제거한다. 남은 침전물이 많을 경우 1∼2 회 소화처리를 반복한다.",
      "guideContext": "원심분리 및 세정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-013",
      "text": "원심분리관에 증류수 30 ㎖을 넣고 초음파분산기를 사용하여 1분 정도 분산하고 교반기로 교반하여 침전물을 골고루 분산한다. 다시 원심분리하여 상층액을 제거한 후 이러한 세정작업을 3회 반복한다.",
      "guideContext": "원심분리 및 세정 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-014",
      "text": "여과한 필터를 페트리디쉬로 옮겨 오염이 되지 않도록 실온에서 건조하거나 40℃ 전후의 건조기에서 2시간 이상 건조한 후 메스로 반으로 자른다.",
      "guideContext": "필터 여과 및 건조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "시료 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-015",
      "text": "깨끗한 슬라이드글라스 위에 시료포집면을 아래로 향하게 하여 필터를 덮고 아세톤 증기발생장치로 고정 및 투명화한다.",
      "guideContext": "현미경 관찰표본 제작 (법령 근거 미확인)",
      "additionalDetail": "트리아세틴을 2∼3 방울 떨어뜨리고, 커버글라스를 덮어 현미경 관찰표본을 만든다.",
      "workProcessPhase": "시료 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-016",
      "text": "위상차현미경(접안렌즈 10배, 대물렌즈 40배)을 이용하여 관찰표본 중의 석면소체를 계수한다. 필터의 전체면을 관찰하여 석면소체의 수를 기록한다.",
      "guideContext": "석면소체 계수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면 계수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-017",
      "text": "시야를 상하좌우로 분석자가 관찰하고자 하는 방향으로 연속적으로 이동하여 계수한다. 접안렌즈에 장착된 현미경계수자의 큰원을 기준으로 안쪽의 석면소체를 계수한다.",
      "guideContext": "석면소체 계수 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면 계수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-018",
      "text": "전면계수의 경우 시야상을 1/2 정도 겹치도록 하여 이웃한 시야로 이동한다. 시야수를 계수할 경우 시야상이 접하도록 하여 이웃한 시야로 이동하며 계수한다.",
      "guideContext": "석면소체 계수 시야 이동 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면 계수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.1",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-019",
      "text": "필터 전면을 계수하여 농도계산을 할 경우에는 필터 위에 포집된 시료면의 면적(유효필터면적)이 필요하다. 사용한 흡인여과기의 직경과 필터위에 포집된 시료면의 직경을 측정한 후 면적을 계산한다. 25 ㎜ 여과지인 경우 385 ㎟이다.",
      "guideContext": "석면농도 계산 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-020",
      "text": "검출하한값을 계산한다. 검출하한값은 계수한 결과 1개의 석면소체가 검출되었을 경우의 농도로 계산한다.",
      "guideContext": "석면농도 계산 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "석면농도 계산",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": null
    },
    {
      "identifier": "CI-T9-021",
      "text": "필요에 따라 석면소체 계수와 동시에 석면섬유를 계수하는 것이 좋다. 섬유농도의 계산법은 석면소체의 경우와 같다.",
      "guideContext": "석면섬유 동시 계수",
      "additionalDetail": null,
      "workProcessPhase": "석면 계수",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.2.2",
      "basedOn": null
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-T9-001",
      "term": "섬유(fiber)",
      "definition": "길이와 직경의 비가 3 : 1 이상인 입자상 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T9-002",
      "term": "석면(asbestos)",
      "definition": "길고, 얇고, 유연하며 강한 섬유로 쉽게 분리되는 석면형(asbestiform)으로 결정화한 사문석계 또는 각섬석계 규산염 광물로서 종류(CAS No.)는 백석면(chrysotile, 12001-29-5), 갈석면(amosite, 12001-28-4), 청석면(crocidolite, 12172-73-5), 트레모라이트석면(tremolite, 77536-68-6), 악티노라이트석면(actinolite, 77536-66-4), 안소필라이트석면(anthophyllite, 77536-67-5)이다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T9-003",
      "term": "석면섬유(asbestos fiber)",
      "definition": "길이와 직경의 비가 3:1 이상이며 길이가 5 ㎛이상인 섬유 모양을 가지고 있는 석면을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-T9-004",
      "term": "석면소체(asbestos body)",
      "definition": "폐내에 흡입된 석면섬유가 생체내 대식세포에 의해 탐식되어 오랜 기간 동안 단백성 물질을 흡착하여 형성된 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
