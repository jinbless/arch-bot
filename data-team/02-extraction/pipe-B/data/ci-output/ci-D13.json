  "checklistItems": [
    {
      "identifier": "CI-D13-001",
      "text": "저장탱크의 용량은 염소의 사용량 및 염소 운반차량 탱크의 용량을 고려하여 가능한 한 최소로 하여야 한다.",
      "guideContext": "염소저장설비 저장탱크 용량 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장탱크 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-002",
      "text": "저장탱크의 용량은 과충전 방지를 위하여 이용하고자 하는 염소 운반차량 탱크 최대 적재량의 120% 이상이어야 한다.",
      "guideContext": "염소저장설비 저장탱크 용량 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장탱크 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-003",
      "text": "저장탱크의 저장량은 액체염소의 열팽창으로 인한 체적증가를 수용할 수 있도록 저장탱크 용량의 85% 이하이어야 한다.",
      "guideContext": "염소저장설비 저장탱크 용량 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장탱크 운전",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-004",
      "text": "저장설비의 일반적인 설계온도 범위는 -35℃에서 +45℃까지로 할 수 있으나, 운전 가능한 최저온도를 고려하여 설계온도를 결정하여야 한다.",
      "guideContext": "염소저장설비 설계온도 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-005",
      "text": "저장설비의 재질로 탄소강을 사용하는 경우, 염소와 직접 접촉되는 부위의 부식여유는 3㎜ 이상으로 한다.",
      "guideContext": "염소저장설비 부식여유",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설계",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D13-006",
      "text": "저장설비의 용접 이음부위에 대하여 100% 비파괴(방사선 등)검사를 실시하여야 한다.",
      "guideContext": "염소저장설비 비파괴검사 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-007",
      "text": "비파괴검사에 합격된 후 맞대기 용접 이음부위는 후열처리를 실시하여야 한다.",
      "guideContext": "염소저장설비 후열처리 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.4",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-008",
      "text": "저장설비는 설계압력의 150%의 압력에서 수압시험을 실시하여야 한다.",
      "guideContext": "염소저장설비 수압시험 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.5",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-009",
      "text": "저장탱크의 모든 노즐은 플랜지식으로서, 특별한 경우를 제외하고는 맨홀뚜껑 또는 저장탱크의 최상부에 설치하여야 하며, 맨홀의 내부직경은 460㎜ 이상이어야 한다.",
      "guideContext": "염소저장탱크 개구부 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장탱크 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.6",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-010",
      "text": "배관은 지상에 설치하고 기계적인 손상, 부식 및 화재 등으로부터 보호될 수 있도록 설계하여야 하며, 배관 크기는 기계적인 강도를 고려하여 최소 3/4인치 미만을 사용하여서는 아니된다.",
      "guideContext": "염소저장설비 배관 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-011",
      "text": "모든 배관 등에는 염소임을 표시하고 색채로서 구분하여야 한다.",
      "guideContext": "염소저장설비 배관 표시",
      "additionalDetail": null,
      "workProcessPhase": "배관 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-D13-012",
      "text": "저장탱크내의 액체염소 인입배관 끝 부분의 위치는 인입배관의 파열 등으로 인한 액체염소의 역류를 방지할 수 있도록 저장설비내의 최대액면 높이보다 높아야 한다. 다만, 액체염소 인입배관 끝 부분의 위치를 저장설비의 정상액면 높이 이하로 할 경우에는 저장설비내의 액체염소 인입배관 상부에 구멍을 뚫어 역류를 방지하여야 한다.",
      "guideContext": "염소저장설비 배관 역류방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-013",
      "text": "액체염소의 인입 및 토출측 배관에는 배관파열 등으로 인한 염소의 누출을 방지할 수 있도록 원격조작이 가능한 긴급차단밸브를 설치하여야 한다.",
      "guideContext": "염소저장설비 긴급차단밸브",
      "additionalDetail": null,
      "workProcessPhase": "배관 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.7",
      "basedOn": [
        "SR-CHEMICAL-011"
      ]
    },
    {
      "identifier": "CI-D13-014",
      "text": "저장탱크에는 과압을 방지하기 위하여 안전밸브를 설치하여야 한다.",
      "guideContext": "염소저장설비 안전밸브 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-015",
      "text": "안전밸브는 복수방식으로 설치하여야 하며 이 경우 저장설비와 안전밸브사이의 차단밸브는 자물쇠형으로 하거나 또는 차단밸브를 기계적으로 연동하여 어느 한 쪽만이 열리도록 하여야 한다.",
      "guideContext": "염소저장설비 안전밸브 복수방식 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-016",
      "text": "복수방식으로 안전밸브를 설치하는 경우 각 안전밸브의 크기는 총 배출용량을 각각 방출할 수 있어야 한다.",
      "guideContext": "염소저장설비 안전밸브 용량 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "안전장치 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-017",
      "text": "안전밸브 전단에는 안전밸브의 부식을 방지하기 위한 안전판을 설치하여야 하며 안전밸브와 안전판 사이에는 안전판의 파열 및 누출을 감지할 수 있는 압력경보장치를 설치하여야 한다. 다만, 안전밸브의 재질이 염소에 대하여 내식성이 있는 경우에는 그러하지 아니하다.",
      "guideContext": "염소저장설비 안전판 및 압력경보",
      "additionalDetail": null,
      "workProcessPhase": "안전장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.8",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-D13-018",
      "text": "저장설비에 안전밸브를 설치하는 경우 안전밸브의 소요 분출량은 KOSHA GUIDE (안전밸브 등의 설정압력·배출용량 산출 및 설치 등에 관한 기술지침)에서 정하는 식에 의하여 계산하여야 한다.",
      "guideContext": "염소저장설비 안전밸브 분출량 (법령 근거 미확인)",
      "additionalDetail": "저장탱크에 단열하지 않는 경우 Qa = 3.24 A^0.82, 단열하는 경우 Qa = 0.275 UA^0.82",
      "workProcessPhase": "안전장치 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-019",
      "text": "액체염소 배관에는 염소의 열팽창에 의한 과압을 방지할 수 있도록 열팽창 안전밸브 또는 이와 동등 이상의 성능을 갖는 것을 설치하여야 한다.",
      "guideContext": "염소저장설비 열팽창 안전밸브 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "배관 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.8",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-020",
      "text": "밸브는 완전히 차단될 수 있는 구조로서 KOSHA GUIDE (배관 재질사양 작성지침)을 참고하여 취급하는 염소의 운전온도 및 운전압력에 적합한 재질의 것을 사용하여야 한다.",
      "guideContext": "염소저장설비 밸브 재질",
      "additionalDetail": null,
      "workProcessPhase": "밸브 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.9",
      "basedOn": [
        "SR-FIRE_EXPLOSION-035"
      ]
    },
    {
      "identifier": "CI-D13-021",
      "text": "저장탱크에는 액체염소의 저장용량을 계량할 수 있는 무게계량장치 또는 액면계측장치 등을 설치하여야 하며, 유리액면계를 설치하여서는 아니된다.",
      "guideContext": "염소저장설비 계측장치",
      "additionalDetail": null,
      "workProcessPhase": "계측장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.11",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-D13-022",
      "text": "저장탱크에는 저장탱크의 압력을 측정할 수 있도록 압력지시계를 설치하여야 한다.",
      "guideContext": "염소저장설비 압력계측",
      "additionalDetail": null,
      "workProcessPhase": "계측장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.11",
      "basedOn": [
        "SR-FIRE_EXPLOSION-049"
      ]
    },
    {
      "identifier": "CI-D13-023",
      "text": "무게계량장치, 액면계측장치 및 압력계측장치에는 경보장치를 설치하여야 한다.",
      "guideContext": "염소저장설비 경보장치",
      "additionalDetail": null,
      "workProcessPhase": "경보장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.11",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-D13-024",
      "text": "저장설비 주위에는 조명시설을 설치하여야 하며, 정전에 대비하여 비상전원에 연결하여야 한다.",
      "guideContext": "염소저장설비 조명 및 비상전원",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.12",
      "basedOn": [
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-D13-025",
      "text": "저장탱크 주위에는 누출·확산 방지용 방유제를 설치하여야 하며, 방유제 유효용량은 가장 큰 저장탱크의 용량 이상이어야 한다.",
      "guideContext": "염소저장설비 방유제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방유제 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-026",
      "text": "방유제 및 그 내부는 액체염소가 침투할 수 없는 구조이어야 하며, 방유제의 단면적은 누출된 염소의 기화를 억제할 수 있도록 가능한 한 최소화하여야 한다.",
      "guideContext": "염소저장설비 방유제 구조 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방유제 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-027",
      "text": "액체염소의 누출·확산에 대비하여 방유제 내부에 누출된 액체염소를 긴급 회수 또는 다른 장소로 이송할 수 있는 설비를 설치하여야 한다.",
      "guideContext": "염소저장설비 긴급회수 설비 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방유제 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EMERGENCY_RESPONSE",
      "sourceSection": "4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-028",
      "text": "방유제 내부에는 항상 우수 등이 고이지 않도록 배수설비를 설치하여야 한다.",
      "guideContext": "염소저장설비 방유제 배수 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "방유제 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.13",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-029",
      "text": "저장설비는 염소가 누출하는 경우 그 피해 범위를 최소화할 수 있도록 바람의 방향을 고려하여 설치하여야 한다.",
      "guideContext": "염소저장설비 설치 위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.14",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-030",
      "text": "저장설비는 점검 및 보수관리가 용이하고 운전원이 접근하기 쉬운 장소에 설치하여야 한다.",
      "guideContext": "염소저장설비 설치 위치 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.14",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-031",
      "text": "저장설비는 차량 또는 폭발·화재·부식성물질의 누출에 의한 손상 가능성을 최소화할 수 있도록 다른 공정설비와 충분히 이격 하거나 또는 저장설비 주위에 방호벽 등을 설치 보호하여야 한다.",
      "guideContext": "염소저장설비 이격 및 방호 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.14",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-032",
      "text": "저장탱크를 지하(반지하 포함)에 설치하는 경우에는 탱크를 흙 등으로 묻어서는 아니 된다.",
      "guideContext": "염소저장설비 지하설치 금지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.14",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-033",
      "text": "염소의 이송방법은 설비 및 공정의 특성을 충분히 고려하여 적절한 방법을 선정하여야 한다.",
      "guideContext": "염소 이송 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "염소 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "4.15",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-034",
      "text": "밀봉용 가스는 염소와 반응하지 않아야 하며 건조하고 유분이 함유되지 않은 것을 사용하여야 한다.",
      "guideContext": "염소 이송 가스밀봉 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "염소 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.15",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-035",
      "text": "밀봉용 가스 공급설비는 저장탱크로부터 밀봉용 가스 공급설비로 염소가 역류되는 것을 방지할 수 있도록 설계하여야 한다.",
      "guideContext": "염소 이송 역류방지 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "염소 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.15",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-036",
      "text": "저장설비 주위에는 염소의 누출을 조기에 감지할 수 있도록 가스누출감지경보기를 설치하여야 한다.",
      "guideContext": "염소저장설비 가스누출감지",
      "additionalDetail": null,
      "workProcessPhase": "경보장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.16",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-D13-037",
      "text": "저장설비 주위 및 근로자가 상주하는 곳에는 근로자에게 염소의 누출을 알리기 위한 경보기를 설치하여야 한다.",
      "guideContext": "염소저장설비 경보기",
      "additionalDetail": null,
      "workProcessPhase": "경보장치 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "4.16",
      "basedOn": [
        "SR-CHEMICAL-010"
      ]
    },
    {
      "identifier": "CI-D13-038",
      "text": "안전밸브의 토출측 배관 및 벤트 배관 등에서 배출되는 염소가 대기중으로 방출되지 않도록 염소에 적합한 세정설비를 설치하여야 한다. 또한 세정액을 순환시키는 펌프 및 세정설비 흡입휀에는 비상전원을 연결하여야 한다.",
      "guideContext": "염소저장설비 세정설비",
      "additionalDetail": null,
      "workProcessPhase": "세정설비 설치",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "4.17",
      "basedOn": [
        "SR-CHEMICAL-002",
        "SR-ELECTRIC-008"
      ]
    },
    {
      "identifier": "CI-D13-039",
      "text": "저장설비 주위에는 적절한 방호용 울타리를 설치하고 허가받지 않은 사람의 출입이나 접근을 금지시켜야 한다. 다만, 제조시설 내에 있는 저장설비는 그러하지 아니하다.",
      "guideContext": "염소저장설비 출입통제 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "4.18",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-040",
      "text": "운전온도 - 29℃ 이상의 염소저장탱크 설계압력은 최대 예상운전 압력의 120% 또는 15㎏f/㎠G 중 큰 수치를 적용하여야 한다.",
      "guideContext": "염소저장탱크 설계압력 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장탱크 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-041",
      "text": "운전온도 - 29℃ 미만의 염소저장탱크는 단일 또는 이중 벽으로 설계할 수 있으며 설계압력은 최대예상 운전압력에 1.8㎏f/㎠를 더한 수치 이상으로 하고 염소저장탱크 내부가 진공으로 운전될 수 있으므로 진공에 견딜 수 있도록 설계하여야 한다.",
      "guideContext": "저온 염소저장탱크 설계압력 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장탱크 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.1",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-042",
      "text": "운전온도 - 29℃ 이상의 염소저장설비 재질은 KS D 3521, KS D 3533 또는 이와 동등 이상의 재질을 사용하여야 한다.",
      "guideContext": "염소저장설비 재질 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-043",
      "text": "운전온도 - 29℃ 미만의 염소저장설비 재질은 KS D 3586, KS D 3521의 SPV급 또는 이와 동등 이상의 재질을 사용하여야 한다. 또한 모든 재질은 KS B 0809, KS B 0810 또는 이와 동등 이상의 규격에 의하여 저온충격시험에 합격된 재질이어야 한다.",
      "guideContext": "저온 염소저장설비 재질 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 설계",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-044",
      "text": "대기 또는 단열재와 접촉하는 저장설비 외벽은 습기 및 염소에 부식되지 않도록 습기와 염소에 견딜 수 있는 재료로 도장하여야 한다.",
      "guideContext": "염소저장설비 도장",
      "additionalDetail": "운전온도 -29℃ 이상 저장설비에서 단열하는 경우 적용",
      "workProcessPhase": "저장설비 제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D13-045",
      "text": "운전온도 - 29℃ 미만의 염소저장탱크는 이중벽 구조인 경우 내벽과 외벽 사이에 단열재를 충전하거나 그렇지 않은 경우에는 저장탱크 외부에 단열재를 시공하여야 한다.",
      "guideContext": "저온 염소저장탱크 단열 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-046",
      "text": "이중벽 구조의 저장탱크인 경우에는 내부 동체의 외면, 단일벽 저장탱크인 경우에는 동체의 외면이 습기 및 염소에 부식되지 않도록 습기 및 염소에 내식성이 있는 재료로 도장하여야 한다.",
      "guideContext": "염소저장탱크 동체 도장",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 제작",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-FIRE_EXPLOSION-032"
      ]
    },
    {
      "identifier": "CI-D13-047",
      "text": "단열재는 염소와 반응하지 않고 화염에 연소되지 않는 것이어야 한다. 또한 탱크 외부에 단열재를 시공하는 경우 그 단열재 외부를 염소에 부식되지 않는 재질로 보호하여야 한다.",
      "guideContext": "염소저장설비 단열재 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "저장설비 제작",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-048",
      "text": "펌프의 토출측 배관에는 염소가 저장탱크로 순환되도록 최소유량 배관을 설치한다.",
      "guideContext": "염소 이송 펌프",
      "additionalDetail": "펌프를 이용한 염소 이송 시 적용",
      "workProcessPhase": "염소 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.15",
      "basedOn": null
    },
    {
      "identifier": "CI-D13-049",
      "text": "저장설비의 액면이 낮거나 또는 펌프의 토출측 압력이 낮은 경우 펌프의 가동이 정지되도록 연동한다.",
      "guideContext": "염소 이송 펌프 연동",
      "additionalDetail": "펌프를 이용한 염소 이송 시 적용",
      "workProcessPhase": "염소 이송",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "4.15",
      "basedOn": null
    }
  ],
