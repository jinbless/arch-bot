  "workProcesses": [
    {
      "identifier": "WP-H212-01",
      "processOrder": 1,
      "processName": "업무공간 배치 및 칸막이 설치",
      "safetyMeasures": "상담원 개인 업무공간 최소 4.63m² 이상 확보, 사무실 내 기적 1인당 10m³ 이상 확보, 칸막이 높이 최소 1,500mm 이상 또는 책상면 기준 900mm 이상 설치, 칸막이 ㄷ자형 배치로 비말확산 방지",
      "requiredPPE": [],
      "sourceSection": "4.1",
      "relatedSR": null
