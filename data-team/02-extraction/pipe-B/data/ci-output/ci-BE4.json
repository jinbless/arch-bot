      ]
    },
    {
      "identifier": "CI-BE4-030",
      "text": "감전 사고를 방지하기 위한 녹색 절연 도체는 전기기기의 프레임을 접지 단자에 접속하는 용도로만 사용하여야 한다.",
      "guideContext": "코드 및 플러그 관리",
      "additionalDetail": null,
      "workProcessPhase": "접지 시공",
      "bindingForce": "MANDATORY",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-BE4-031",
      "text": "연장 코드는 사용하기 전에 플러그와 접속기의 극성을 점검하고 접지도체의 연속성과 완전성을 시험해야 한다.",
      "guideContext": "연장 코드",
      "additionalDetail": null,
      "workProcessPhase": "육안점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-002"
      ]
    },
    {
      "identifier": "CI-BE4-032",
      "text": "전기기기의 작동불량을 초래하거나 손상을 줄 수 있는 지나친 전압 강하를 억제하기 위해서는 적절한 도체 사이즈 연장 코드를 사용하여야 한다.",
      "guideContext": "연장 코드",
      "additionalDetail": "휴대형 전기기기의 연장코드 사이즈는 코드 길이 및 정격 전류에 따라 <표 4>를 참조한다.",
      "workProcessPhase": "유연 코드 선정",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "5.3",
      "basedOn": [
        "SR-ELECTRIC-013"
      ]
    },
    {
      "identifier": "CI-BE4-033",
      "text": "주요 분해점검 및 수리는 제조자가 실시하는 것을 원칙으로 한다.",
      "guideContext": "전기기기의 코드 접속기구",
      "additionalDetail": "자체 수리와 분해점검을 선호하는 사업장에서는 제조자로부터 필요한 부품, 구성도, 접속도, 윤활도면, 기타 기술적인 자료를 얻어야 한다.",
      "workProcessPhase": "분해점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.4",
      "basedOn": null
    },
    {
      "identifier": "CI-BE4-034",
      "text": "기기 및 코드 접속기는 감전 위험을 방지하기 위하여 정기적으로 절연저항 및 누설 전류를 측정할 필요가 있다.",
      "guideContext": "전기기기의 코드 접속기구",
      "additionalDetail": null,
      "workProcessPhase": "누설전류 시험",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.5",
      "basedOn": [
        "SR-ELECTRIC-001"
      ]
    }
