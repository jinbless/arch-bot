  "domainTerms": [
    {
      "identifier": "DT-BE4-001",
      "term": "휴대형 또는 이동형 전기기기",
      "definition": "물체를 자르거나 갈거나 뚫기 등의 작업을 할 경우, 취급이 편하고 휴대 및 이동이 용이한 전기기기를 말하며, 이러한 전기기기는 사용이 편리한 반면에 취급과 관리가 부실할 경우에는 감전 사고가 우려되므로 취급에 각별한 주의를 요한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE4-002",
      "term": "코드",
      "definition": "하나 이상의 전선으로 구성되며, 도체와 절연체로 이루어진 유연한 케이블을 말하며, 전기 장치와 전원 공급 장치를 연결하거나 연장하는데 사용되는 것을 말한다. 여기에는 전원 코드(Power Cord), 연장 코드(Extension Cord), 신호 코드(Signal Cord) 등이 포함된다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE4-003",
      "term": "콘센트",
      "definition": "플러그의 핀에 꽂도록 설계된 칼받이를 갖고 또 케이블 접속용 단자 또는 연구 고정용 단자를 갖고 있는 접속 기구류를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-BE4-004",
      "term": "플러그",
      "definition": "장비나 이동형 콘센트에 접속된 하나의 유연성 케이블과 일체형으로 되어 있거나 여기에 직접 부착하도록 만들어진 부분을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
