  "checklistItems": [
    {
      "identifier": "CI-T26-001",
      "text": "부검은 안전하고, 배기시설이 갖추어진 정해진 장소에서 실시한다.",
      "guideContext": "실험동물 부검 시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "MANDATORY",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-CONFINED-002"
      ]
    },
    {
      "identifier": "CI-T26-002",
      "text": "여러 마리를 부검할 때는 개체번호를 혼동하지 않도록 각 부검 절차마다 반복 확인한다.",
      "guideContext": "실험동물 부검 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-003",
      "text": "장기·조직의 기계적 손상, 건조, 자가용해 등을 피하도록 주의한다.",
      "guideContext": "실험동물 부검 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-004",
      "text": "작거나 취약한 장기의 취급(핀셋에 의한 압박, 가위에 의한 절단 등)에 주의한다.",
      "guideContext": "실험동물 부검 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-005",
      "text": "여러 개의 장기를 적출하는 경우, 누락되는 장기가 없도록 적출 순서를 정하여 지킨다.",
      "guideContext": "실험동물 부검 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-006",
      "text": "부검 시 관찰된 육안소건은 즉시 기록한다.",
      "guideContext": "실험동물 부검 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-007",
      "text": "투여 방법에 따라 적출 장기 및 적출 방법이 다를 수 있으므로, 사전에 숙지하여 누락되는 경우가 없도록 한다.",
      "guideContext": "실험동물 부검 시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "사전 부검회의",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-008",
      "text": "장기 적출 순서나 방법은 동일 기관내에서는 가능한 동일한 순서와 방법으로 수행한다.",
      "guideContext": "장기적출 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-009",
      "text": "가능한 진단보다는 사실을 객관적으로 기술할 수 있는 서술적 방식을 이용한다.",
      "guideContext": "육안소견의 기술",
      "additionalDetail": "예시: 뇌하수체 종양 → 뇌하수체, 덩어리(Mass), 색상, 크기, 액체 함유 여부",
      "workProcessPhase": "장기 적출 및 육안소견 관찰",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-010",
      "text": "장기의 누락여부를 확인한다.",
      "guideContext": "장기 중량 측정 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기중량 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-011",
      "text": "장기가 손상되지 않도록 취급한다.",
      "guideContext": "장기 중량 측정 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기중량 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-012",
      "text": "정확한 장기 중량 측정을 위하여, 지방조직 및 주변조직을 트리밍한다.",
      "guideContext": "장기 중량 측정 방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "장기중량 측정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-013",
      "text": "부검 전에 필요량만큼 고정병을 확보하여 고정액을 분주하고, 고정액명 등을 기록한 라벨을 부착하여 둔다.",
      "guideContext": "고정의 준비",
      "additionalDetail": null,
      "workProcessPhase": "부검준비",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": [
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "CI-T26-014",
      "text": "고정액을 조제하거나 취급할 때는 수술용 고무장갑, 보호안경, 마스크 등을 착용하고 배기시설이 설치된 장소에서 작업한다.",
      "guideContext": "고정의 준비 - 보호구 착용",
      "additionalDetail": null,
      "workProcessPhase": "적출 장기의 고정",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "8",
      "basedOn": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "CI-T26-015",
      "text": "장기의 특성에 따라 고정액을 다르게 사용하는 것이 좋다.",
      "guideContext": "고정시 주의사항",
      "additionalDetail": "통상적으로 고환, 안구 및 시신경은 다비슨 용액에 그 이외의 조직은 10% 중성완충포르말린 용액에 고정한다.",
      "workProcessPhase": "적출 장기의 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-016",
      "text": "채취한 조직을 고정병에 넣을 때는 고정병에 붙어 있는 개체번호를 반드시 확인하여 다른 개체의 고정병에 넣지 않도록 주의한다.",
      "guideContext": "고정시 주의사항 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적출 장기의 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-017",
      "text": "고정을 촉진하기 위하여 적절한 크기로 일정한 부위를 절개하여 고정하며 필요하다면 교반한다.",
      "guideContext": "고정시 주의사항",
      "additionalDetail": null,
      "workProcessPhase": "적출 장기의 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-018",
      "text": "고정장기를 취급하다가 잃어버린 것을 알았을 경우에는 즉시 부검 동물을 확인하여 분실된 장기가 있는지 확인해보고, 분실이 확인되면 그 조직명과 사유를 명기한다.",
      "guideContext": "고정장기 분실 또는 혼입시 처리방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적출 장기의 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-019",
      "text": "고정장기가 혼입된 경우에도 혼입된 개체번호를 기록하고, 조직명과 사유를 명기한다.",
      "guideContext": "고정장기 분실 또는 혼입시 처리방법 (법령 근거 미확인)",
      "additionalDetail": null,
      "workProcessPhase": "적출 장기의 고정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "8",
      "basedOn": null
    },
    {
      "identifier": "CI-T26-020",
      "text": "부검 전에 특이사항, 일반증상 등을 공유하고 숙지한다.",
      "guideContext": "사전 부검회의",
      "additionalDetail": null,
      "workProcessPhase": "사전 부검회의",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5",
      "basedOn": [
        "SR-CHEMICAL-024"
      ]
    }
  ],
