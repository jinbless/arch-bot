  "domainTerms": [
    {
      "identifier": "DT-H213-001",
      "term": "특별관리물질",
      "definition": "법 「시행규칙」 별표18제1호나목에 따른 발암성, 생식세포변이원성, 생식독성 물질(Carcinogenic, Mutagenic or Reproductive toxic agents, CMR) 등 근로자에게 중대한 건강장해를 일으킬 우려가 있는 물질로서 산업안전보건기준에 관한 규칙 별표12에서 특별관리물질로 표기된 물질을 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-CHEMICAL-003"
      ]
    },
    {
      "identifier": "DT-H213-002",
      "term": "증상",
      "definition": "질환 또는 환자 상태의 주관적 증거로 환자가 인식하여 직접 호소하는 상태나 모양을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H213-003",
      "term": "징후",
      "definition": "어떤 질환의 존재가 겉으로 나타내는 낌새로 환자가 의사에게 알려주거나 의사가 관찰 또는 조사하여 얻을 수 있는 질환의 객관적 증거를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-H213-004",
      "term": "검사소견",
      "definition": "의사가 검사 결과에 근거하여 판단하는 의학적 견해를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-H213-01",
      "processOrder": 1,
      "processName": "작업 전 준비 및 출입관리",
      "safetyMeasures": "작업 장소에는 관계자 외의 출입을 금지시키고, 출입하는 근로자에 대하여 안전보건 조치사항 등의 교육을 실시한다. 작업장의 보기 쉬운 장소에 1,2-디클로로프로판이 인체에 미치는 영향, 취급상 주의사항, 착용하여야 할 보호구, 응급조치 및 긴급 방재요령을 게시한다.",
      "requiredPPE": [
        "방독보호구",
        "보호 장갑(니트릴/네오프렌)",
        "고글형 보호안경",
        "내화학성 보호의"
      ],
      "sourceSection": "10.2.1",
      "relatedSR": [
        "SR-CHEMICAL-024",
        "SR-CHEMICAL-017"
      ]
    },
    {
      "identifier": "WP-H213-02",
      "processOrder": 2,
      "processName": "1,2-디클로로프로판 취급 작업 수행",
      "safetyMeasures": "전용의 작업복을 착용하고 작업복과 개인 의복은 분리하여 보관한다. 취급하는 장소에서는 음식물의 저장, 섭취, 흡연 등을 금지한다. 노출기준(10 ppm) 이하에서 가능한 한 노출을 최소화하고 노출 시 반드시 보호구를 착용한다.",
      "requiredPPE": [
        "방독보호구",
        "보호 장갑(니트릴/네오프렌)",
        "고글형 보호안경",
        "내화학성 보호의",
        "피부 보호용 도포제"
      ],
      "sourceSection": "10.2.1",
      "relatedSR": [
        "SR-CHEMICAL-025",
        "SR-CHEMICAL-026"
      ]
    },
    {
      "identifier": "WP-H213-03",
      "processOrder": 3,
      "processName": "작업 후 정리 및 세척",
      "safetyMeasures": "발생되는 폐기물 및 청소 걸레 등은 지정된 밀폐 장소에 보관하고 규정된 절차에 따라 처리한다. 손과 피부를 씻을 수 있는 세척설비를 이용하며 목욕 및 세탁설비를 사용한다. 오염된 개인보호구를 작업장 밖으로 반출할 경우에는 밀봉하여 특별관리물질이 근로자에게 노출되지 않도록 조치한다.",
      "requiredPPE": [
        "보호 장갑(니트릴/네오프렌)"
      ],
      "sourceSection": "10.2.1",
      "relatedSR": [
        "SR-CHEMICAL-020",
        "SR-CHEMICAL-003"
      ]
    },
    {
      "identifier": "WP-H213-04",
      "processOrder": 4,
      "processName": "응급조치 수행",
      "safetyMeasures": "눈 접촉 시 적어도 15분 동안 물로 씻는다. 피부 접촉 시 오염된 의복을 즉시 제거하고 적어도 15분 동안 물로 씻는다. 흡입 시 즉시 신선한 공기가 있는 지역으로 이동시킨다. 섭취 시 의식이 있으면 다량의 물을 먹여 토하게 하고 의식 불명 시에는 토하게 하지 않는다. 즉시 의사의 치료를 받게 한다.",
      "requiredPPE": [
