  "checklistItems": [
    {
      "identifier": "CI-M51-001",
      "text": "작업 시 소음이 발생한다면 작업장의 소음을 줄이거나 작업자들의 소음 노출 시간을 줄일 수 있도록 프로세스, 장비 및 작업 방식에 대안을 모색해야 한다. 또한 사업자는 산업 내 소음 제어 표준 또는 바람직한 관행에 따르도록 한다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "소음 위험 제어",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-002",
      "text": "소음을 줄이기 위해서 할 수 있는 다양한 해결책이 있으며, 적절하게 실행 가능한 해결책을 찾아 반드시 실행해야 한다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "소음 위험 제어",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-003",
      "text": "평가 결과 작업자들이 노출 수치의 상한값 (Upper exposure action value) 이상의 소음에 노출될 가능성이 높다면 체계적인 소음 제어 프로그램을 수립해야 한다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "소음 위험 제어",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.1",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M51-004",
      "text": "위험성 평가 결과를 바탕으로 위험성에 대한 정보 및 소음 제어를 위한 행동 계획을 수립한다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "CI-M51-005",
      "text": "청력 보호 장비 제공 등을 통해서 즉각적인 위험에 대처한다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-006",
      "text": "소음 제어를 위해 무엇이 가능하며, 어느 정도 줄일 수 있으며, 어떤 조치가 합당하게 실행가능한지 파악한다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-007",
      "text": "조치 및 일정에 대한 우선순위를 설정한다 (어디에 즉각적으로 효과가 있으며, 어떤 변화를 장기에 걸쳐서 단계적으로 실시해야 하며, 각 경우 소음에 노출되는 작업자 수가 몇 명인지 등을 고려한다).",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M51-008",
      "text": "실시된 조치들이 효과적인지 점검한다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "위험성 평가 후 조치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "5.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M51-009",
      "text": "기계 및 장비는 시간이 지남에 따라 노후화되고 소음이 심해지기 때문에 적절하고 정기적인 유지보수가 필수적이다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "소음 대책",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-010",
      "text": "소음 레벨의 변화를 주의깊게 관찰한다. 소음발생 기계가 노후화되었거나 결함이 있는 부품의 교체시기가 되었을 수 있다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "소음 대책",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.1",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-011",
      "text": "밴드나 댐퍼의 설치 위치는 팬으로부터 적어도 덕트 직경의 2 ~ 3배 이상 떨어진 위치에 설치하여 밴드 또는 댐퍼와 팬 사이에서 발생하는 난류를 억제하여야 한다.",
      "guideContext": "작업장의 소음제어 – 팬 최적 설치",
      "additionalDetail": "이렇게 하면 3 ~ 12 dB정도의 소음을 감소시킬 수 있다.",
      "workProcessPhase": "공학적 제어수단 적용",
      "bindingForce": "MANDATORY",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-012",
      "text": "자가 접착성 강판은 기존 설치되어 있는 설비의 내부나 외부에 간단히 붙일 수 있으며, 평평한 표면의 80% 정도를 설치하면 방사되는 소음의 5 ~ 25 dB를 감소시킬 수 있다.",
      "guideContext": "작업장의 소음제어 – 감쇠",
      "additionalDetail": "패널 두께의 40% ~ 100% 두께로 시공한다.",
      "workProcessPhase": "공학적 제어수단 적용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-013",
      "text": "소음기를 효과적으로 설치하면 공기배출소음을 10 ~ 30 dB 줄일 수 있다.",
      "guideContext": "작업장의 소음제어 – 소음기 설치",
      "additionalDetail": "소음기가 막히지 않게 한다. 다중 배출 즉, 분기관을 통하여 하나의 큰 지름을 가지는 파이프의 소음기로 공기가 배출되면 25 dB까지 소음이 감소된다.",
      "workProcessPhase": "공학적 제어수단 적용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.1.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-014",
      "text": "기계 주변에 울타리를 세워서 작업장 또는 주변으로 방출되는 소음량을 줄인다.",
      "guideContext": "작업장의 소음제어 – 소음 전달경로 수정",
      "additionalDetail": null,
      "workProcessPhase": "소음 전달경로 수정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-015",
      "text": "차단벽 또는 막을 사용하여 소음을 직접적으로 차단한다.",
      "guideContext": "작업장의 소음제어 – 소음 전달경로 수정",
      "additionalDetail": null,
      "workProcessPhase": "소음 전달경로 수정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PHYSICAL_PROTECTION",
      "sourceSection": "6.1.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-016",
      "text": "소음 원천을 작업자로부터 멀리 떨어진 곳에 위치하도록 한다.",
      "guideContext": "작업장의 소음제어 – 소음 전달경로 수정",
      "additionalDetail": null,
      "workProcessPhase": "소음 전달경로 수정",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-017",
      "text": "건물 내 흡수력이 강한 자재를 사용하여 반사되는 소음을 줄인다.",
      "guideContext": "작업장의 소음제어 – 작업장 설계·배치",
      "additionalDetail": null,
      "workProcessPhase": "작업장 설계 및 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-018",
      "text": "소음이 심한 기계 및 프로세스를 조용한 구역에서 떨어진 곳에 위치시킨다.",
      "guideContext": "작업장의 소음제어 – 작업장 설계·배치",
      "additionalDetail": null,
      "workProcessPhase": "작업장 설계 및 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-019",
      "text": "소음이 심한 기계를 상시근무 구역과 격리된 곳에 위치하도록 작업 흐름을 설계한다.",
      "guideContext": "작업장의 소음제어 – 작업장 설계·배치",
      "additionalDetail": null,
      "workProcessPhase": "작업장 설계 및 배치",
      "bindingForce": "RECOMMENDED",
      "requirementType": "ENVIRONMENTAL",
      "sourceSection": "6.1.4",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-020",
      "text": "소음이 심한 구역에서 보내는 시간을 제한한다. 소음이 심한 구역에서 보내는 시간을 반으로 줄인다면 소음 노출을 3 dB 줄일 수 있다.",
      "guideContext": "작업장의 소음제어",
      "additionalDetail": null,
      "workProcessPhase": "소음 노출 시간 관리",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.1.5",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-021",
      "text": "초기 단계에서 신규 또는 교체용 기계가 작업장의 소음을 어떻게 줄일 수 있는지 검토한다. 가능하다면 소음 레벨을 줄이기 위한 목표를 설정한다.",
      "guideContext": "작업장의 소음제어 – 저소음 제품 구매",
      "additionalDetail": null,
      "workProcessPhase": "저소음 제품 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-022",
      "text": "모든 신형 기계에 대해 현실적인 소음 배출 레벨을 명시하며, 입찰 참여자 및 공급업체가 그들의 법적 의무를 제대로 이해하는지 확인한다.",
      "guideContext": "작업장의 소음제어 – 저소음 제품 구매",
      "additionalDetail": null,
      "workProcessPhase": "저소음 제품 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M51-023",
      "text": "저소음 설계를 갖추고 있으며, 소음 제어기능을 값비싼 선택 사양이 아니라 기계의 일부분으로 설계한 공급업체로부터만 제품을 구입하거나 임대한다.",
      "guideContext": "작업장의 소음제어 – 저소음 제품 구매",
      "additionalDetail": null,
      "workProcessPhase": "저소음 제품 구매",
      "bindingForce": "RECOMMENDED",
      "requirementType": "EQUIPMENT_STANDARD",
      "sourceSection": "6.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M51-024",
      "text": "다음과 같은 경우 청력 보호구를 작업자들에게 지급해야 한다. 소음 제어를 사용하여 달성된 레벨보다 더 높은 수준에서 추가적인 보호가 필요한 경우, 다른 소음 제어 방식을 강구하는 동안 단기적인 조치로써 사용할 때.",
      "guideContext": "작업장의 소음제어 – 청력 보호",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-025",
      "text": "청력 보호구를 기술적 및 운영적 수단에 의한 소음 제어를 대체하는 방식으로 사용해서는 안 된다.",
      "guideContext": "작업장의 소음제어 – 청력 보호",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "CI-M51-026",
      "text": "작업자들이 청력 보호구를 요구하며 이들의 소음 노출이 노출 수치의 하한값 및 상한값 사이에 있으면, 이를 제공해야 한다.",
      "guideContext": "작업장의 소음제어 – 사업자 의무",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-027",
      "text": "작업자들의 소음 노출이 노출 수치의 상한값을 넘으면 작업자들에게 청력 보호구를 제공하며 이들이 장비를 제대로 사용하는지 확인해야 한다.",
      "guideContext": "작업장의 소음제어 – 사업자 의무",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-028",
      "text": "청력 보호구 사용이 의무적인 청력 보호역을 설정하며, 가능하다면 표지관으로 표시한다.",
      "guideContext": "작업장의 소음제어 – 사업자 의무",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-029",
      "text": "청력 보호구 사용 및 취급에 대해 작업자들에게 교육 및 훈련, 정보를 제공한다.",
      "guideContext": "작업장의 소음제어 – 사업자 의무",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 지급",
      "bindingForce": "MANDATORY",
      "requirementType": "TRAINING",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-002"
      ]
    },
    {
      "identifier": "CI-M51-030",
      "text": "청력 보호구가 제대로 사용되고 유지보수되도록 한다.",
      "guideContext": "작업장의 소음제어 – 사업자 의무",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "6.4",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-031",
      "text": "보호구는 안전인증을 필한 것을 사용한다. 보호구는 귀의 소음이 85 dB 이하가 되도록 한다.",
      "guideContext": "작업장의 소음제어 – 청력 보호구 효과적 사용",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-032",
      "text": "소음이 심한 작업 및 업무에 보호구를 착용하도록 한다.",
      "guideContext": "작업장의 소음제어 – 청력 보호구 효과적 사용",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-033",
      "text": "작업 환경에 알맞은 보호구를 선택한다. 편안함과 위생을 고려한다.",
      "guideContext": "작업장의 소음제어 – 청력 보호구 효과적 사용",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-034",
      "text": "다른 보호구 (예를 들면, 안전모, 먼지 마스크 및 눈 보호용 보안경 등)와 어떻게 같이 사용할 수 있는지를 생각한다.",
      "guideContext": "작업장의 소음제어 – 청력 보호구 효과적 사용",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-035",
      "text": "여러 종류의 보호구를 제공하여 작업자가 자신에게 맞는 것을 선택할 수 있도록 한다.",
      "guideContext": "작업장의 소음제어 – 청력 보호구 효과적 사용",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 사용",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-036",
      "text": "소음을 너무 많이 제거하는 장비를 제공해서는 안 된다. 이는 작업자의 고립을 초래하거나 작업자가 이런 장비의 착용을 꺼리게 된다.",
      "guideContext": "작업장의 소음제어 – 청력 보호구 사용 시 하지 말아야 할 사항",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 사용",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "6.5",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-037",
      "text": "청력 보호구가 효과적으로 작동되도록 하며 청결하면서 좋은 상태를 유지한다.",
      "guideContext": "작업장의 소음제어 – 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-038",
      "text": "귀마개의 밀폐부분(Earmuff seal)이 손상되지 않았는지 점검한다.",
      "guideContext": "작업장의 소음제어 – 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-039",
      "text": "헤드밴드의 강도가 줄어들지 않았는지 점검한다.",
      "guideContext": "작업장의 소음제어 – 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-040",
      "text": "허가없이 청력 보호구를 개조 및 수정을 하지 않는다.",
      "guideContext": "작업장의 소음제어 – 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-041",
      "text": "귀마개(Compressible earplug)가 부드럽고, 유연하며 깨끗한지 점검한다.",
      "guideContext": "작업장의 소음제어 – 유지보수",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 유지보수",
      "bindingForce": "MANDATORY",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.1",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-042",
      "text": "작업자들이 필요한 경우에는 반드시 청력 보호구를 사용하도록 해야 한다.",
      "guideContext": "작업장의 소음제어 – 점검",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 점검",
      "bindingForce": "MANDATORY",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-043",
      "text": "관리감독자에게 보호구의 구입 및 지급 등을 관장하도록 하며 교체용품이 즉시 입수가능하도록 한다.",
      "guideContext": "작업장의 소음제어 – 점검",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-044",
      "text": "규정이 준수되고 있으며 보호구가 제대로 사용되고 있는지를 확인하기 위해 현장 점검을 실시한다. 작업자들이 계속적으로 보호구를 제대로 착용하지 않는다면 회사의 징계 절차에 따라 조치를 취한다.",
      "guideContext": "작업장의 소음제어 – 점검",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PROCEDURAL",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-045",
      "text": "모든 관리감독자가 좋은 본보기를 보여서 보호구 착용 구역에 들어설 때는 항상 보호구를 착용하도록 한다.",
      "guideContext": "작업장의 소음제어 – 점검",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "PPE_REQUIREMENT",
      "sourceSection": "7.2",
      "basedOn": [
        "SR-NOISE-004"
      ]
    },
    {
      "identifier": "CI-M51-046",
      "text": "작업이 있는 사람들만 청력 보호가 필요한 구역에 들어갈 수 있도록 하며 필요한 시간 이상 머무르지 않도록 한다.",
      "guideContext": "작업장의 소음제어 – 점검",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 점검",
      "bindingForce": "RECOMMENDED",
      "requirementType": "MANAGEMENT_SYSTEM",
      "sourceSection": "7.2",
      "basedOn": null
    },
    {
      "identifier": "CI-M51-047",
      "text": "작업자들에게 청력 보호구의 착용을 상기시킨다.",
      "guideContext": "작업장의 소음제어 – 청력 보호",
      "additionalDetail": null,
      "workProcessPhase": "청력 보호구 지급",
      "bindingForce": "RECOMMENDED",
      "requirementType": "TRAINING",
      "sourceSection": "6.3",
      "basedOn": [
        "SR-NOISE-002"
      ]
    }
  ],
  "domainTerms": [
    {
      "identifier": "DT-M51-001",
      "term": "작업자",
      "definition": "기계의 설치, 운전, 조정, 보수, 청소, 수리 또는 운반 등의 주어진 업무를 수행하는 자를 총칭하는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M51-002",
      "term": "작업장(Work place)",
      "definition": "주어진 작업자에 대하여 작업환경으로 둘러싸인 작업공간내의 작업장비들의 조합을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M51-003",
      "term": "댐퍼(Damper)",
      "definition": "자유 진동 또는 과도 진동을 감쇠(수렴)시키거나, 공진 상태의 진폭을 감소시키거나, 자려진동을 방지하기 위하여 감쇠를 발생하는 장치. 감쇠기 또는 제진기를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M51-004",
      "term": "소음(Noise)",
      "definition": "바람직하지 않은 소리를 의미하며 음성, 음악 등의 전달을 방해하거나 생활에 장애, 고통을 주거나 하는 소리를 말한다.",
      "sourceSection": "3",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "DT-M51-005",
      "term": "펜 소음(Fan noise)",
      "definition": "팬의 회전에 의하여 야기되는 기류의 흐트러짐에 의하여 발생하는 소음을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M51-006",
      "term": "흡음(Sound absorption)",
      "definition": "소리의 에너지를 흡수 또는 투과시키는 것을 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    },
    {
      "identifier": "DT-M51-007",
      "term": "데시벨(dB)",
      "definition": "파워(전력, 음향출력 등), 음의 세기 또는 기타의 양을 비교하는데 사용되는 것으로 차원이 없는 단위를 말한다.",
      "sourceSection": "3",
      "relatedSR": null
    }
  ],
  "workProcesses": [
    {
      "identifier": "WP-M51-01",
      "processOrder": 1,
      "processName": "소음 문제 판단 및 측정",
      "safetyMeasures": "작업장 소음이 심한지 여부를 판단하기 위해 소음 수준을 dB(A) 및 dB(C)로 측정한다. 작업일 대부분 소음이 항상 있는지, 2m 떨어져 있는 상태에서 목소리를 높여야 하는지, 30분 이상 소리가 요란한 전동공구를 사용하는지 등을 확인한다.",
      "requiredPPE": [
        "청력보호구"
      ],
      "sourceSection": "4",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "WP-M51-02",
      "processOrder": 2,
      "processName": "위험성 평가 및 행동 계획 수립",
      "safetyMeasures": "위험성 평가 결과를 바탕으로 소음 제어를 위한 행동 계획을 수립한다. 청력 보호 장비 제공, 소음 제어 가능성 파악, 조치 우선순위 설정, 작업자 책임 할당, 효과성 점검을 포함한다.",
      "requiredPPE": [],
      "sourceSection": "5.2",
      "relatedSR": [
        "SR-NOISE-005"
      ]
    },
    {
      "identifier": "WP-M51-03",
      "processOrder": 3,
      "processName": "소음원 제거 또는 대체",
      "safetyMeasures": "소음을 덜 발생시키는 다른 프로세스 또는 장비로 교체할 수 있는지 검토한다. 보다 조용한 다른 방식으로 작업할 수 있는지 확인한다.",
      "requiredPPE": [],
      "sourceSection": "6.1.1",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "WP-M51-04",
      "processOrder": 4,
      "processName": "공학적 제어수단 적용",
      "safetyMeasures": "감쇠(Damping), 팬 최적 설치, 덕트 보완, 팬 속도 조정, 소음기 설치, 공기 노즐 개선, 진동 절연 패드 설치, 기계 가드 개선, 체인-타이밍 벨트 교체, 저소음 모터 재선정 등 10가지 공학적 소음억제 기술을 적용한다.",
      "requiredPPE": [
        "청력보호구"
      ],
      "sourceSection": "6.1.2",
      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "WP-M51-05",
      "processOrder": 5,
      "processName": "소음 전달경로 수정",
      "safetyMeasures": "기계 주변 울타리 설치, 차단벽 또는 막 사용, 소음 원천을 작업자로부터 격리 배치한다.",
      "requiredPPE": [],
