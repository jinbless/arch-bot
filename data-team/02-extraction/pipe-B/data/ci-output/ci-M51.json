      "relatedSR": [
        "SR-NOISE-001"
      ]
    },
    {
      "identifier": "WP-M51-06",
      "processOrder": 6,
      "processName": "작업장 설계 및 배치",
      "safetyMeasures": "건물 내 흡수력이 강한 자재를 사용하여 반사 소음을 줄이고, 소음이 심한 기계를 조용한 구역에서 떨어진 곳에 배치하며, 상시근무 구역과 격리된 곳에 위치하도록 작업 흐름을 설계한다.",
      "requiredPPE": [],
