# Dev environment template. Copy to `.env.dev` and fill secrets.
# `.env.dev` is gitignored. Loaded by `make dev-up` / dev.ps1.

# Backend FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001

# Frontend Vite
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# Where the frontend should call the backend (used by vite.config.ts proxy).
# Defaults to http://localhost:${BACKEND_PORT} when unset.
VITE_API_TARGET=http://127.0.0.1:8001

# PostgreSQL (external; managed outside dev-up unless `make dev-pg-up` is used).
# The default points to the kosha PG container the team already runs.
DATABASE_URL=postgresql://kosha:1229@localhost:5432/kosha

# Optional secrets — leave blank to run synthetic / mock paths only.
OPENAI_API_KEY=

# Fuseki SPARQL probe (backend startup logs; optional, no failure if down).
FUSEKI_ENDPOINT=http://localhost:3030/kosha/sparql
FUSEKI_ENABLED=true
